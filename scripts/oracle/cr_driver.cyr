# cr_driver.cyr — evaluates bijli's correctly rounded primitives on the arguments cr_verify.py writes.
#
# Input build/cr_in.txt, one call per line: `<fn> <word hex> …` (up to sixteen 16-digit words: an f64's bits, or an
# integer in two's complement). Output, one line per call: the result's bits in hex. Beside the primitives: kimiya's
# correctly rounded monomials, square roots of quotients and unbounded-exponent final operations (src/crmath_kx.cyr, M1
# part 5), bijli's √ of a monomial (src/crmath_mono.cyr), which cr_verify.py checks against exact values (Python's
# Fraction and integer square root), and bijli's transcendentals with an unbounded exponent (src/crmath_ux.cyr, M1 part
# 5c-2), checked against MPFR with its widest exponent range, and the exact Singularity threshold (src/crmath_cmp.cyr,
# M1 part 5d-1) and Clausius–Mossotti's ε_r (src/crmath_edge.cyr, M2 part 2c-2), against Fractions. Built from the math
# sources the bundle carries (src/constants.cyr … src/mathx.cyr, in the manifest's order and byte for byte what
# dist/bijli.cyr holds): the bundle is `private` and these entry points are bijli-internal, so a consumer of
# dist/bijli.cyr can't call them, but a file of internals only has no marker and can be included on its own.
# scripts/oracle/cr_verify.py builds it, runs it natively and under qemu-aarch64, and compares every result with MPFR.
# `tan_slow` calls tan's fixed-point path directly (finite |x| ≥ 2^-27 only), so the path the rounding test rarely
# reaches is checked on arguments of its own.
include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/str.cyr"
include "lib/fmt.cyr"
include "lib/io.cyr"
include "lib/math.cyr"
include "lib/ganita.cyr"
include "src/constants.cyr"
include "src/crmath_data.cyr"
include "src/crmath.cyr"
include "src/crmath_k_data.cyr"
include "src/crmath_k.cyr"
include "src/crmath_kx.cyr"
include "src/crmath_mono.cyr"
include "src/crmath_ux_data.cyr"
include "src/crmath_ux.cyr"
include "src/crmath_cmp.cyr"
include "src/mathx.cyr"
include "src/fmtf.cyr"
include "src/crmath_gamma.cyr"
include "src/crmath_edge.cyr"

# The value of hex digit byte c (lowercase).
fn _hexv(c): i64 {
    if (c >= 97) { return c - 87; }
    return c - 48;
}

# The word written as hex in [p, p + n).
fn _hexw(p, n): i64 {
    var v = 0;
    for (var k = 0; k < n; k = k + 1) { v = (v << 4) | _hexv(load8(p + k)); }
    return v;
}

# 1 when [p, p + n) is the C string s.
fn _is(p, n, s): i64 {
    if (n != strlen(s)) { return 0; }
    return memeq(p, s, n);
}

# Word k of the call as an f64.
#must_use
fn _wf(w, k): f64 {
    var x: f64 = load64(w + k * 8);
    return x;
}

# Set when a call names an unknown function (a result word may be any value, -1 among them).
var _unknown = 0;

# One call on the words at w: the result's bits (_unknown set, and 0, for an unknown function name).
fn _call(fp, fl, w): i64 {
    var x: f64 = _wf(w, 0);
    var y: f64 = _wf(w, 1);
    var r: f64 = 0.0;
    if (_is(fp, fl, "exp") == 1) { r = _bj_exp(x); }
    elif (_is(fp, fl, "sin") == 1) { r = _bj_sin(x); }
    elif (_is(fp, fl, "cos") == 1) { r = _bj_cos(x); }
    elif (_is(fp, fl, "atan") == 1) { r = _bj_atan(x); }
    elif (_is(fp, fl, "atan2") == 1) { r = _bj_atan2(x, y); }
    elif (_is(fp, fl, "hypot") == 1) { r = _bj_hypot(x, y); }
    elif (_is(fp, fl, "pow") == 1) { r = _bj_powf(x, y); }
    elif (_is(fp, fl, "acos") == 1) { r = _bj_acos(x); }
    elif (_is(fp, fl, "asin") == 1) { r = _bj_asin(x); }
    elif (_is(fp, fl, "log10") == 1) { r = _bj_log10(x); }
    elif (_is(fp, fl, "ln") == 1) { r = _bj_ln(x); }
    elif (_is(fp, fl, "expm1") == 1) { r = _bj_expm1(x); }
    elif (_is(fp, fl, "gamma") == 1 || _is(fp, fl, "gamma_slow") == 1 || _is(fp, fl, "gamma2") == 1
      || _is(fp, fl, "gamma2_slow") == 1) {
        # gamma n c v1 … vn: the correctly rounded γ (gamma) or γ² (gamma2), the slow path alone for *_slow; −1 (all
        # ones) when |v| ≥ c
        var gn = load64(w);
        var gc: f64 = _wf(w, 1);
        var gmode = 0;
        if (load8(fp + 5) == 50) { gmode = 1; }
        var gslow = 0;
        if (fl > 7) { gslow = 1; }
        var go: f64[1];
        if (_bj_cr_lorentz(w + 16, gn, gc, gmode, gslow, &go) == 1) { r = go[0]; } else { return 0 - 1; }
    }
    elif (_is(fp, fl, "gamma_ok") == 1) {
        # gamma_ok n c v1 … vn: the validity test alone, 1 or 0 as a word
        var on = load64(w);
        var oc: f64 = _wf(w, 1);
        return _bj_cr_lorentz_ok(w + 16, on, oc);
    }
    elif (_is(fp, fl, "cm") == 1 || _is(fp, fl, "cm_slow") == 1) {
        # cm alpha n: Clausius–Mossotti's correctly rounded ε_r (src/crmath_edge.cyr), the exact check alone for
        # cm_slow; −1 (all ones) when X ≥ 1
        var cslow = 0;
        if (fl > 2) { cslow = 1; }
        var co: f64[1];
        if (_bj_cr_clausius(x, y, cslow, &co) == 1) { return 0 - 1; }
        r = co[0];
    }
    elif (_is(fp, fl, "sinh") == 1) { r = _bj_sinh(x); }
    elif (_is(fp, fl, "cosh") == 1) { r = _bj_cosh(x); }
    elif (_is(fp, fl, "sinh_slow") == 1) { r = _bj_cr_sinh_slow(x); }
    elif (_is(fp, fl, "cosh_slow") == 1) { r = _bj_cr_cosh_slow(x); }
    elif (_is(fp, fl, "tan") == 1) { r = _bj_tan(x); }
    elif (_is(fp, fl, "tan_slow") == 1) { r = _bj_cr_tan_slow(x); }
    elif (_is(fp, fl, "mono") == 1) {
        # mono nn nd f1 … f(nn) d1 … d(nd): the factors from word 2 on
        var nn = load64(w);
        var nd = load64(w + 8);
        r = _bj_k_cr_mono(w + 16, nn, w + 16 + nn * 8, nd);
    }
    elif (_is(fp, fl, "mono_wide") == 1 || _is(fp, fl, "mono_wide_acc") == 1) {
        # mono_wide nn nd f1 … d…: RN(Π f / Π d) up to six a side, the full function or the exact path alone
        var wn = load64(w);
        var wdn = load64(w + 8);
        if (fl == 9) { r = _bj_cr_mono_wide(w + 16, wn, w + 16 + wn * 8, wdn); }
        else { r = _bj_cr_mono_wide_acc(w + 16, wn, w + 16 + wn * 8, wdn); }
    }
    elif (_is(fp, fl, "sqrt_mono") == 1 || _is(fp, fl, "sqrt_mono_acc") == 1) {
        # sqrt_mono nn nd f1 … d…: RN(√(Π f / Π d)), the full function or the exact path alone
        var sn = load64(w);
        var sdn = load64(w + 8);
        if (fl == 9) { r = _bj_cr_sqrt_mono(w + 16, sn, w + 16 + sn * 8, sdn); }
        else { r = _bj_cr_sqrt_mono_acc(w + 16, sn, w + 16 + sn * 8, sdn); }
    }
    elif (_is(fp, fl, "mul_div") == 1) { r = _bj_k_cr_mul_div(x, y, _wf(w, 2)); }
    elif (_is(fp, fl, "mul3") == 1) { r = _bj_k_cr_mul3(x, y, _wf(w, 2)); }
    elif (_is(fp, fl, "div2") == 1) { r = _bj_k_cr_div2(x, y, _wf(w, 2)); }
    elif (_is(fp, fl, "mul3_div") == 1) { r = _bj_k_cr_mul3_div(x, y, _wf(w, 2), _wf(w, 3)); }
    elif (_is(fp, fl, "mul5") == 1) { r = _bj_k_cr_mul5(x, y, _wf(w, 2), _wf(w, 3), _wf(w, 4)); }
    elif (_is(fp, fl, "prod5") == 1) { r = _bj_cr_mul5(x, y, _wf(w, 2), _wf(w, 3), _wf(w, 4)); }
    elif (_is(fp, fl, "prod5_acc") == 1) { r = _bj_cr_prod_acc(w, 5); }
    elif (_is(fp, fl, "mul2_div2") == 1) { r = _bj_k_cr_mul2_div2(x, y, _wf(w, 2), _wf(w, 3)); }
    elif (_is(fp, fl, "mul3_div2") == 1) { r = _bj_k_cr_mul3_div2(x, y, _wf(w, 2), _wf(w, 3), _wf(w, 4)); }
    elif (_is(fp, fl, "mul4") == 1) { r = _bj_k_cr_mul4(x, y, _wf(w, 2), _wf(w, 3)); }
    elif (_is(fp, fl, "div3") == 1) { r = _bj_k_cr_div3(x, y, _wf(w, 2), _wf(w, 3)); }
    elif (_is(fp, fl, "sqrt_div") == 1) { r = _bj_k_cr_sqrt_div(x, y); }
    elif (_is(fp, fl, "wsqrt") == 1) { r = _bj_k_cr_mul_sqrt_ratio(x, y, _wf(w, 2), load64(w + 24)); }
    elif (_is(fp, fl, "ux_mul") == 1) { r = _bj_k_ux_mul_f64(x, load64(w + 8), _wf(w, 2), load64(w + 24)); }
    elif (_is(fp, fl, "ux_div") == 1) { r = _bj_k_ux_div_f64(x, load64(w + 8), _wf(w, 2), load64(w + 24)); }
    elif (_is(fp, fl, "ux_add") == 1) { r = _bj_k_ux_add_f64(x, load64(w + 8), _wf(w, 2), load64(w + 24)); }
    elif (_is(fp, fl, "ux_sub") == 1) { r = _bj_k_ux_sub_f64(x, load64(w + 8), _wf(w, 2), load64(w + 24)); }
    elif (_is(fp, fl, "ux_sqrt") == 1) { r = _bj_k_ux_sqrt_f64(x, load64(w + 8)); }
    elif (_is(fp, fl, "ux_ln") == 1) { r = _bj_ux_ln(x, load64(w + 8)); }
    elif (_is(fp, fl, "ux_sin") == 1) { r = _bj_ux_sin_cos(x, load64(w + 8), 1); }
    elif (_is(fp, fl, "ux_cos") == 1) { r = _bj_ux_sin_cos(x, load64(w + 8), 0); }
    elif (_is(fp, fl, "ux_exp") == 1) {
        # ux_exp x part (and ux_cosh, ux_sinh): the 53-bit value's s (part 0) or e (part 1)
        var es, ee = _bj_ux_exp(x);
        if (load64(w + 8) == 1) { return ee; }
        r = es;
    }
    elif (_is(fp, fl, "ux_cosh") == 1) {
        var cs, ce = _bj_ux_cosh(x);
        if (load64(w + 8) == 1) { return ce; }
        r = cs;
    }
    elif (_is(fp, fl, "ux_sinh") == 1) {
        var ss, se = _bj_ux_sinh(x);
        if (load64(w + 8) == 1) { return se; }
        r = ss;
    }
    elif (_is(fp, fl, "below_prod") == 1 || _is(fp, fl, "below_quot") == 1 || _is(fp, fl, "below_sum") == 1) {
        # below_prod x y p (|x·y|), below_quot (|x/y|), below_sum (|x + y|): 1.0 when below 10^-p exactly, else 0.0
        var bp = load64(w + 16);
        var bb = 0;
        if (load8(fp + 6) == 112) { bb = _bj_x_prod_below(x, y, bp); }
        elif (load8(fp + 6) == 113) { bb = _bj_x_quot_below(x, y, bp); }
        else { bb = _bj_x_sum_below(x, y, bp); }
        if (bb == 1) { r = 1.0; }
    }
    elif (_is(fp, fl, "r2_below") == 1) {
        # r2_below a0 a1 a2 b0 b1 b2 p: 1.0 when the exact Σ (aᵢ − bᵢ)² < 10^-p (src/crmath_cmp.cyr), else 0.0
        if (_bj_x_r2_below(w, w + 24, load64(w + 48)) == 1) { r = 1.0; }
    }
    elif (_is(fp, fl, "ux_pow") == 1) {
        # ux_pow s e y part: (s·2^e)^y's s (part 0) or e (part 1)
        var ps, pe = _bj_ux_pow(x, load64(w + 8), _wf(w, 2));
        if (load64(w + 24) == 1) { return pe; }
        r = ps;
    }
    else {
        _unknown = 1;
        return 0;
    }
    var b = _bj_bits(r);
    return b;
}

fn main(): i64 {
    alloc_init();
    var lenw: i64[1];
    var buf = file_read_whole("build/cr_in.txt", &lenw);
    if (buf == 0) { println("cr_driver: cannot read build/cr_in.txt"); return 1; }
    var len = lenw[0];
    var at = 0;
    while (at < len) {
        var end = at;
        while (end < len && load8(buf + end) != 10) { end = end + 1; }
        var sp = at;
        while (sp < end && load8(buf + sp) != 32) { sp = sp + 1; }
        var words: i64[16];
        var nw = 0;
        var p = sp + 1;
        while (p + 16 <= end && nw < 16) {
            words[nw] = _hexw(buf + p, 16);
            nw = nw + 1;
            p = p + 17;
        }
        var w = _call(buf + at, sp - at, &words);
        if (_unknown == 1) { println("cr_driver: unknown function"); return 1; }
        fmt_hex(w);
        println("");
        at = end + 1;
    }
    return 0;
}
var r = main();
sys_exit_group(r);
