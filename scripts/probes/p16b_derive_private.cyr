# p16b — ⚠ `#derive(Serialize)` in two `private` files: the second fails to compile, because the derive's shared
# helper `_cy_json_skipval` is emitted once, into the first derive's file, where `private` hides it. bijli's
# BjComplex and BjFieldVector live in two private files (src/complex.cyr, src/field.cyr), so src/json.cyr writes
# its codecs by hand (port plan D5's amendment). Expected: the build FAILS with
# `'_cy_json_skipval' is private to its file`. With p16b_private_a.cyr's `private` line removed it builds.
include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/str.cyr"
include "lib/fmt.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/math.cyr"
include "lib/bayan.cyr"
include "scripts/probes/p16b_private_a.cyr"
include "scripts/probes/p16b_private_b.cyr"

fn main() {
    alloc_init();
    var v: P16B;
    v.x = 1.0;
    v.y = 2.0;
    v.z = 3.0;
    var sb = str_builder_new();
    P16B_to_json(&v, sb);
    var s = str_builder_build(sb);
    print(str_data(s), str_len(s));
    return 0;
}

var r = main();
syscall(60, 0);
