# p15 — a struct with `(f64, f64, f64)` tuple fields standing for Rust's `[f64; 3]` (PointCharge's position and
# velocity): typed element reads, a literal store, a copy, `&x + offset` as a `*f64`, by-value passing.
include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/io.cyr"

struct PC { charge: f64; mass: f64; position: (f64, f64, f64); velocity: (f64, f64, f64); }

fn as_f64p(p): *f64 { return p; }

fn sum3(p: *f64): f64 {
    var s: f64 = p[0] + p[1] + p[2];
    return s;
}

fn dist_sq(a: PC, b: PC): f64 {
    var dx: f64 = a.position.0 - b.position.0;
    var dy: f64 = a.position.1 - b.position.1;
    var dz: f64 = a.position.2 - b.position.2;
    var r: f64 = dx * dx + dy * dy + dz * dz;
    return r;
}

fn hx(x) { fmt_hex(x); syscall(1, 1, " ", 1); return 0; }

fn main() {
    alloc_init();
    var a: PC;
    a.charge = 1.5;
    a.mass = 2.0;
    a.position = (1.0, 2.0, 3.0);
    a.velocity = (0.5, 0.25, 0.125);
    var b: PC = a;
    b.position.0 = 4.0;
    var s: f64 = a.position.0 + a.position.1;     # typed: 3.0 = 0x4008000000000000
    hx(s);
    var d: f64 = dist_sq(a, b);                   # 9.0 = 0x4022000000000000
    hx(d);
    var pp: *f64 = as_f64p(&a + 16);              # position through a pointer: 6.0 = 0x4018000000000000
    var t: f64 = sum3(pp);
    hx(t);
    var pv: *f64 = as_f64p(&a + 40);              # velocity: 0.875 = 0x3fec000000000000
    var u: f64 = sum3(pv);
    hx(u);
    hx(sizeof(PC));                               # 64 = 0x40
    syscall(1, 1, "\n", 1);
    return 0;
}
var r = main();
sys_exit_group(r);
