# √(w0 + w1 + w2) for w > 0 as a triple-double at out[0..2]: two Newton corrections of √w0, each from the
# renormalised residual w − s² (2^-150).
fn _bj_k_td_sqrt(w0: f64, w1: f64, w2: f64, out) {
    var s0: f64 = f64_sqrt(w0);
    var p, pe = _bj_k_two_prod(s0, s0);
    var ra, rb, rc = _bj_k_td_add(w0, w1, w2, -p, -pe, 0.0);
    var r0, r1, r2 = _bj_k_td_norm(ra, rb, rc);     # the residual w − s0², renormalised
    var tw: f64 = 2.0 * s0;
    var c1: f64 = r0 / tw;
    var h, m = _bj_k_fast_two_sum(s0, c1);
    var q0, q1, q2 = _bj_k_td_mul(h, m, 0.0, h, m, 0.0);
    var ua, ub, uc = _bj_k_td_add(w0, w1, w2, -q0, -q1, -q2);
    var u0, u1, u2 = _bj_k_td_norm(ua, ub, uc);
    var c2: f64 = u0 / tw;
