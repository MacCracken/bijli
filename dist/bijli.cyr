# ── atan2 ───────────────────────────────────────────────────────────────────────────
# atan2(y, x), correctly rounded (impetus ADR 0011, amended for atan2). The specials follow C99 Annex F, as glibc's do:
# signed zeros and ±π for y = ±0, ±π/2 for x = ±0, ±π/4, ±3π/4 and ±π/2 for an infinite y, ±0 and ±π for an infinite
# x. Otherwise, with r = a/b ≤ 1 for a = min(|x|, |y|) and b = max, the result is ±z where z = atan(r), π/2 − atan(r)
# when |y| > |x|, and π − that when x < 0:
# - r < 2^-60 with z = atan(r) itself: atan(r) = r − r³/3 + …, and r³/3 is below 2^-107·r, closer than r can come to
#   a rounding midpoint without being one (r = num/den with two 53-bit odd parts). So the result is the IEEE quotient,
#   except at an exact midpoint, where atan(r) < r rounds toward zero. A midpoint needs 54 significant bits, so it
#   only occurs on the subnormal grid: num = A·2^α, den = B·2^β with A, B odd, B | A and α − β = −1075;
# - phase 1, in double-double: r exactly (the quotient of num and den scaled by the same power of two, and its
#   remainder by TwoProduct), c = i/64 nearest r, t = (r − c)/(1 + r·c) with |t| ≤ 2^-7, atan(r) = atan(c) + atan(t)
#   from the generated table and t + t·p(t²) through t^11; then the quadrant moves with π/2 and π in double-double.
#   Tested against 2^-63·|z| (the error is below about 2^-65.5·|z|): decides all but about 2^-10 of arguments;
# - the slow path: vectoring CORDIC in the 364-bit fixed point on (b, a), which needs no division: 364 rotations by
#   ±atan(2^-k) (each by its series in the fixed point as it is needed; 2^-k itself from k = 122), the angle then
#   moved to its quadrant and rounded once. Absolute error below about 2^-345, relative below 2^-285 since z ≥ 2^-60
#   there. atan2's hardest cases, like atan's, need about 2^-120, and there are no exact midpoints but the subnormal
#   ones above (Lindemann–Weierstrass: atan of a nonzero rational is transcendental).

var _bj_cr_atan2_slow_calls = 0;

# d = a·2^-k, truncated (d ≠ a), by whole limbs and a bit shift.
fn _bj_cr_shr(d, a, k) {
    var q = k / 28;
    var r = k % 28;
    for (var j = 0; j < _BJ_CR_L; j = j + 1) {
        var src = j - q;
        var v = 0;
        if (src >= 0) {
            v = load64(a + src * 8) >> r;
            if (src >= 1 && r > 0) { v = v | ((load64(a + (src - 1) * 8) << (28 - r)) & _BJ_CR_MASK); }
        }
        store64(d + j * 8, v);
    }
    return 0;
}

# T = atan(2^-k) for 0 ≤ k ≤ 364 in the fixed point: π/4 for k = 0 (π/2 halved), else Σ (−1)^n·2^(−k(2n + 1))/(2n + 1)
# while the term's bit is within the fixed point (each term truncated: error below 2^-356); 2^-k alone from k = 122,
# where the next term is below 2^-366. Computed as the slow path needs it, so crmath keeps no 14 KB table.
fn _bj_cr_atan_pow2(T, k) {
    if (k == 0) {
        _bj_cr_div_small(T, &_bj_cr_pio2, 2);
        return 0;
    }
    var t[112];
    _bj_cr_zero(T);
    var n = 0;
    while (k * (2 * n + 1) <= 364) {
        _bj_cr_zero(&t);
        var e = k * (2 * n + 1);
        var j = (e + 27) / 28;
        store64(&t + j * 8, 1 << (28 * j - e));
        if (n > 0) { _bj_cr_div_small(&t, &t, 2 * n + 1); }
        if ((n & 1) == 0) { _bj_cr_add(T, T, &t); } else { _bj_cr_sub(T, T, &t); }
        n = n + 1;
    }
    return 0;
}

# The slow path, for the scaled pair (0 ≤ num ≤ den, den in [1, 2)): z = atan(num/den) by vectoring CORDIC, moved to
# its quadrant (swap: π/2 − z; neg_x: π − that) and rounded, negated when neg_y is 1.
#must_use
fn _bj_cr_atan2_slow(num: f64, den: f64, swap, neg_x, neg_y): f64 {
    _bj_cr_load();
    _bj_cr_atan2_slow_calls = _bj_cr_atan2_slow_calls + 1;
    var X[112];
    var Y[112];
    var XS[112];
    var YS[112];
    var P[112];
    var N[112];
    var Z[112];
    var AT[112];
    _bj_cr_set(&X, den);
    _bj_cr_set(&Y, num);
    _bj_cr_zero(&P);
    _bj_cr_zero(&N);
    # Y is held as a magnitude and a sign (ys 1 for negative); X only grows.
    var ys = 0;
    var k = 0;
    while (k < 364 && _bj_cr_is_zero(&Y) == 0) {
        _bj_cr_shr(&XS, &X, k);
        _bj_cr_shr(&YS, &Y, k);
        _bj_cr_add(&X, &X, &YS);
        var acc = &P;
        if (ys == 1) { acc = &N; }
