            return inf;
        }
        if (odd == 1) { return x; }
        return 0.0;
    }
    if (ax == inf) {
        if (x < 0.0) {
            if (y < 0.0) {
                if (odd == 1) { return nzero; }
                return 0.0;
            }
            if (odd == 1) {
                var ninf: f64 = -inf;
                return ninf;
            }
            return inf;
        }
        if (y < 0.0) { return 0.0; }
        return inf;
    }
    var neg = 0;
    if (x < 0.0) {
        if (_bj_cr_is_int(y) == 0) {
            var zero: f64 = 0.0;
            var dom: f64 = zero / zero;
            return dom;
        }
        neg = odd;
    }
    if (ax == 1.0) {
        if (neg == 1) { return 0.0 - 1.0; }
        return 1.0;
    }
    var o[8];
    if (_bj_cr_pow_p1(ax, y, neg, &o, 0) == 1) {
        var r1: f64 = load64(&o);
        return r1;
    }
    _bj_cr_pow_phase2_calls = _bj_cr_pow_phase2_calls + 1;
    if (_bj_cr_pow_p1(ax, y, neg, &o, 1) == 1) {
        var r2: f64 = load64(&o);
        return r2;
    }
    _bj_cr_pow_slow_calls = _bj_cr_pow_slow_calls + 1;
    var rs: f64 = _bj_cr_pow_slow(ax, y, neg);
