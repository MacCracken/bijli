            return inf;
        }
        if (odd == 1) { return x; }
        return 0.0;
    }
    if (ax == inf) {
        if (x < 0.0) {
            if (y < 0.0) {
                if (odd == 1) { return nzero; }
                return 0.0;
            }
            if (odd == 1) {
                var ninf: f64 = -inf;
                return ninf;
