# ── asin: bijli's, on kimiya's atan core ────────────────────────────────────────────

# The special values of asin: (result, 1), or (0, 0) for 2^-26 ≤ |x| < 1. NaN for NaN; NaN for |x| > 1, ±∞ included;
# asin(±1) = ±π/2 rounded; |x| < 2^-26 gives x itself, ±0 and the subnormals included: asin x − x < x³/6·(1 + x²),
# which is below 2^-54.5·|x| there, while half an ulp of x is at least 2^-54·|x|, and asin x lies strictly between x
# and the next double away from zero, so no tie can occur.
#must_use
fn _bj_k_asin_special(x: f64): (f64, i64) {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax > 0x7FF0000000000000) { return (x, 1); }
    if (ax > 0x3FF0000000000000) {
        var nan: f64 = _bj_k_nan();
        return (nan, 1);
    }
    if (ax == 0x3FF0000000000000) {
        var p2: f64 = _BJ_K_CR_SC_PIO2H;
        if (x < 0.0) { p2 = -p2; }
        return (p2, 1);
    }
    if (ax < 0x3E50000000000000) { return (x, 1); }      # |x| < 2^-26
    return (0.0, 0);
