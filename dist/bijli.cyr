    _bj_k_td_sqrt(w0, w1, w2, &sb);
    if (ax <= sb[0]) {
        _bj_k_atan_acc_td(ax, 0.0, 0.0, sb[0], sb[1], sb[2], 0, out);
        return;
    }
    _bj_k_atan_acc_td(sb[0], sb[1], sb[2], ax, 0.0, 0.0, 2, out);
}

# asin x by the accurate path alone.
#must_use
fn _bj_k_cr_asin_acc(x: f64): f64 {
    var s, sp = _bj_k_asin_special(x);
    if (sp == 1) { return s; }
    var rb: f64[3];
    _bj_k_asin_acc_td(x, &rb);
    var r: f64 = _bj_k_rn3(rb[0], rb[1], rb[2]);
    if (x < 0.0) { r = -r; }
