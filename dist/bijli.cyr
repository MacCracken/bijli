# (−1)^k/(2k + 1) for k = 1 … 8 as triple-doubles (index 3·(k − 1)): the accurate atan series.
var _BJ_K_CR_ATAN_ACC: i64[24] = {
    0xBFD5555555555555, 0xBC75555555555555, 0xB915555555555555,
    0x3FC999999999999A, 0xBC6999999999999A, 0x390999999999999A,
    0xBFC2492492492492, 0xBC62492492492492, 0xB902492492492492,
    0x3FBC71C71C71C71C, 0x3C5C71C71C71C71C, 0x38FC71C71C71C71C,
    0xBFB745D1745D1746, 0x3C4745D1745D1746, 0xB8D745D1745D1746,
    0x3FB3B13B13B13B14, 0xBC53B13B13B13B14, 0x38F3B13B13B13B14,
    0xBFB1111111111111, 0xBC31111111111111, 0xB8B1111111111111,
    0x3FAE1E1E1E1E1E1E, 0x3C2E1E1E1E1E1E1E, 0x38AE1E1E1E1E1E1E
};

# --- crmath_k.cyr ---

# crmath_k.cyr — correctly rounded acos, asin, ln and log10 (bijli ADR 0001), on kimiya's correctly rounded cores.
#
# acos, ln and log10 are kimiya's (src/mathx.cyr, its ADR 0006), copied function for function with the prefixes
# renamed (_km_ → _bj_k_, _KM_ → _BJ_K_): the 27 functions their call closure reaches — the atan and ln cores (fast:
# double-double with a proven bound and a rounding test; accurate: triple-double) and the triple-double arithmetic
# under them. asin is bijli's, at the end of this file, on the same atan core as kimiya's acos. Tables:
# src/crmath_k_data.cyr, generated by scripts/oracle/crtables_k.py (kimiya's mathx_tables.py, its ln and atan
# tables), every value equal to kimiya's. src/crmath.cyr (impetus's) holds exp, sin, cos, hypot, pow and atan2;
# the two libraries share nothing but the IEEE primitives.

# +∞ (0x7FF0000000000000), a compile-time constant.
const _BJ_K_INF = 1.0 / 0.0;

# The quiet NaN Rust's f64::NAN is (0x7FF8000000000000). The parity rules match any NaN.
#must_use
fn _bj_k_nan(): f64 {
    var n: f64 = 0x7FF8000000000000;
    return n;
}

# a + b = s + e exactly (Knuth's TwoSum).
#must_use
fn _bj_k_two_sum(a: f64, b: f64): (f64, f64) {
    var s: f64 = a + b;
    var bb: f64 = s - a;
    var e: f64 = (a - (s - bb)) + (b - bb);
    return (s, e);
}

# a + b = s + e exactly, for |a| ≥ |b| or a = 0 (Dekker's FastTwoSum): s = RN(a + b).
#must_use
fn _bj_k_fast_two_sum(a: f64, b: f64): (f64, f64) {
    var s: f64 = a + b;
    var e: f64 = b - (s - a);
    return (s, e);
}

# a·b = p + e exactly (Dekker's TwoProduct with Veltkamp's 2²⁷ + 1 split), for |a|, |b| < 2⁹⁹⁶
# and no underflow in e.
#must_use
fn _bj_k_two_prod(a: f64, b: f64): (f64, f64) {
    var p: f64 = a * b;
    var split: f64 = 134217729.0;
    var ca: f64 = split * a;
    var ah: f64 = ca - (ca - a);
    var al: f64 = a - ah;
    var cb: f64 = split * b;
    var bh: f64 = cb - (cb - b);
    var bl: f64 = b - bh;
    var e: f64 = (al * bl) - (((p - (ah * bh)) - (al * bh)) - (ah * bl));
    return (p, e);
}

# RO(a + b): a + b rounded to odd (of the two doubles around an inexact sum, the one with an odd last
# bit; exact sums are returned as they are). TwoSum's error e gives the side of the exact sum; an inexact
# sum is never 0, so the bit step stays in range.
#must_use
fn _bj_k_ro_sum(a: f64, b: f64): f64 {
    var s, e = _bj_k_two_sum(a, b);
    if (e == 0.0) { return s; }
    var sb = load64(&s);
    if ((sb & 1) != 0) { return s; }
    var up = 0;
    if (e > 0.0) { up = 1; }
    var pos = 0;
    if (s > 0.0) { pos = 1; }
    if (up == pos) { sb = sb + 1; } else { sb = sb - 1; }   # away from zero is the larger magnitude word
    var r: f64 = sb;
    return r;
}

# RN(a + b + c) exactly, for any three doubles without underflow in the TwoSums: Boldo and Melquiond's
# rounding-to-odd algorithm ("Emulation of FMA and correctly rounded sums", IEEE TC 2008): b + c = uh + ul
# and a + uh = th + tl exactly, then RN(th + RO(tl + ul)). (300,000 adversarial triples — ties, near-ties,
# binade edges, cancellation — agree with exact rational rounding.)
#must_use
fn _bj_k_rn3(a: f64, b: f64, c: f64): f64 {
    var uh, ul = _bj_k_two_sum(b, c);
    var th, tl = _bj_k_two_sum(a, uh);
    var v: f64 = _bj_k_ro_sum(tl, ul);
    var z: f64 = th + v;
    return z;
}

# Triple-doubles (h, m, l), normalised (|m| ≲ ulp(h), |l| ≲ ulp(m)). Every step is TwoSum or TwoProduct
# (exact) except the rounded sums of the third-order terms and the dropped products below 2^-158 of the
# result, so each operation's error is below 2^-155·max(|a|, |b|) for a sum and 2^-153·|a·b| for a
# product. The renormalising TwoSums keep the sum exact whatever the magnitudes, so a cancellation costs
# only its relative factor.
#must_use
fn _bj_k_td_add(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64): (f64, f64, f64) {
    var s0, e0 = _bj_k_two_sum(a0, b0);
    var s1, e1 = _bj_k_two_sum(a1, b1);
    var s2: f64 = a2 + b2;
    var t1, f1 = _bj_k_two_sum(e0, s1);
    var t2: f64 = (f1 + e1) + s2;
    var h, u = _bj_k_two_sum(s0, t1);
    var m, l = _bj_k_two_sum(u, t2);
    return (h, m, l);
}

# (a0, a1, a2) + d.
#must_use
fn _bj_k_td_add_d(a0: f64, a1: f64, a2: f64, d: f64): (f64, f64, f64) {
    var s0, e0 = _bj_k_two_sum(a0, d);
    var t1, f1 = _bj_k_two_sum(e0, a1);
    var t2: f64 = f1 + a2;
    var h, u = _bj_k_two_sum(s0, t1);
    var m, l = _bj_k_two_sum(u, t2);
    return (h, m, l);
}

# (a0, a1, a2)·(b0, b1, b2): a0b0, a0b1, a1b0 exact (TwoProduct), the 2^-106 terms rounded, the 2^-159 ones
# (a1b2, a2b1, a2b2) dropped.
#must_use
fn _bj_k_td_mul(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64): (f64, f64, f64) {
    var p0, q0 = _bj_k_two_prod(a0, b0);
    var p1, q1 = _bj_k_two_prod(a0, b1);
    var p2, q2 = _bj_k_two_prod(a1, b0);
    var r: f64 = ((a0 * b2) + (a1 * b1)) + (a2 * b0);
    var s1, e1 = _bj_k_two_sum(p1, p2);
    var s2, e2 = _bj_k_two_sum(q0, s1);
    var t: f64 = (((e1 + e2) + q1) + q2) + r;
    var h, u = _bj_k_two_sum(p0, s2);
    var m, l = _bj_k_two_sum(u, t);
    return (h, m, l);
}

# (a0, a1, a2)·d for a double d.
#must_use
fn _bj_k_td_mul_d(a0: f64, a1: f64, a2: f64, d: f64): (f64, f64, f64) {
    var p0, q0 = _bj_k_two_prod(a0, d);
    var p1, q1 = _bj_k_two_prod(a1, d);
    var r: f64 = a2 * d;
    var s, e = _bj_k_two_sum(q0, p1);
    var t: f64 = (e + q1) + r;
    var h, u = _bj_k_two_sum(p0, s);
    var m, l = _bj_k_two_sum(u, t);
    return (h, m, l);
}

# The ln fast core for the bits ui of a positive normal x (ebias −54 for a subnormal pre-scaled by 2^54):
# (hi, lo, err) with |hi + lo − ln x| < err minus the test's own rounding (the bound above).
#must_use
fn _bj_k_ln_core(ui, ebias): (f64, f64, f64) {
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_BJ_K_CR_LN_T + ti);
    var lh: f64 = load64(&_BJ_K_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_BJ_K_CR_LN_T + ti + 16);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var cc: f64 = r * 134217729.0;
    var ra: f64 = cc - (cc - r);
    var rb: f64 = r - ra;
    var t1: f64 = -0.5 * (ra * ra);             # −ra²/2, exact
    var nrb: f64 = -rb;
    var t2: f64 = nrb * (ra + (0.5 * rb));
    var c3: f64 = _BJ_K_CR_LN_C3;
    var c4: f64 = _BJ_K_CR_LN_C4;
    var c5: f64 = _BJ_K_CR_LN_C5;
    var c6: f64 = _BJ_K_CR_LN_C6;
    var c7: f64 = _BJ_K_CR_LN_C7;
    var c8: f64 = _BJ_K_CR_LN_C8;
    var z: f64 = r * r;
    var pz: f64 = ((c3 + (r * c4)) + (z * (c5 + (r * c6)))) + ((z * z) * (c7 + (r * c8)));   # Estrin
    var p: f64 = (z * r) * pz;
    var e = e0 + ebias;
    var ef: f64 = f64_from(e);
    var ln2h: f64 = _BJ_K_CR_LN_LN2H;
    var ln2m: f64 = _BJ_K_CR_LN_LN2M;
    var a: f64 = ef * ln2h;                      # exact: LN2H has 42 bits, |E| < 2^11
    var s0: f64 = a + lh;
    var d0: f64 = lh - (s0 - a);
    var s1: f64 = s0 + r;
    var d1: f64 = r - (s1 - s0);
    var s2: f64 = s1 + t1;
    var d2: f64 = t1 - (s2 - s1);
    var lo: f64 = (((ef * ln2m) + lm) + (t2 + p)) + ((d0 + d1) + d2);   # short chains (latency)
    var ap: f64 = f64_abs(p);
    var ah: f64 = f64_abs(s2);
    var ae: f64 = f64_abs(ef);
    var k49: f64 = 0x3CE0000000000000;          # 2^-49
    var k83: f64 = 0x3AC0000000000000;          # 2^-83
    var k93: f64 = 0x3A20000000000000;          # 2^-93
    var err: f64 = ((ap * k49) + (ah * k83)) + (ae * k93);
    return (s2, lo, err);
}

# The accurate ln of a positive finite x ≠ 1 as a triple-double at out[0..2]: the fast path's E, j and the
# exact r; log1p(r) by Horner in triple-double on the exact r to r^16/16 (truncation 2^-144·|r|);
# E·ln 2 = E·LN2H (exact) + E·LN2M (TwoProduct) + E·LN2L (rounded, 2^-138); then E·ln2 + L_j + log1p(r)
# with at most 1.3 bits of cancellation. Measured relative error 2^-150.
fn _bj_k_ln_acc_td(x: f64, out) {
    var ui = load64(&x);
    var eb = 0;
    if (ui < 0x0010000000000000) {
        var p54: f64 = 0x4350000000000000;
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_BJ_K_CR_LN_T + ti);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var sh: f64 = load64(&_BJ_K_CR_LN_ACC + 336);     # −1/16 (index 3·(16 − 2))
    var sm: f64 = load64(&_BJ_K_CR_LN_ACC + 344);
    var sl: f64 = load64(&_BJ_K_CR_LN_ACC + 352);
    var n = 15;
    while (n >= 2) {
        var th, tm, tl = _bj_k_td_mul_d(sh, sm, sl, r);
        var off = (n - 2) * 24;
        var ch: f64 = load64(&_BJ_K_CR_LN_ACC + off);
        var cm: f64 = load64(&_BJ_K_CR_LN_ACC + off + 8);
        var cl: f64 = load64(&_BJ_K_CR_LN_ACC + off + 16);
        var uh, um, ul = _bj_k_td_add(ch, cm, cl, th, tm, tl);
        sh = uh;
        sm = um;
        sl = ul;
        n = n - 1;
    }
    var vh, vm, vl = _bj_k_td_mul_d(sh, sm, sl, r);
    var wh, wm, wl = _bj_k_td_add_d(vh, vm, vl, 1.0);
    var ph, pm, pl = _bj_k_td_mul_d(wh, wm, wl, r);       # log1p(r)
    var lh: f64 = load64(&_BJ_K_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_BJ_K_CR_LN_T + ti + 16);
    var ll: f64 = load64(&_BJ_K_CR_LN_T + ti + 24);
    var ef: f64 = f64_from(e0 + eb);
    var ln2h: f64 = _BJ_K_CR_LN_LN2H;
    var ln2m: f64 = _BJ_K_CR_LN_LN2M;
    var ln2l: f64 = _BJ_K_CR_LN_LN2L;
    var a0: f64 = ef * ln2h;
    var a1, a1e = _bj_k_two_prod(ef, ln2m);
    var a2: f64 = ef * ln2l;
    var h0, u0 = _bj_k_fast_two_sum(a0, a1);
    var a12: f64 = a1e + a2;
    var m0, l0 = _bj_k_two_sum(u0, a12);
    var bh, bm, bl = _bj_k_td_add(h0, m0, l0, lh, lm, ll);
    var zh, zm, zl = _bj_k_td_add(bh, bm, bl, ph, pm, pl);
    store64(out, zh);
    store64(out + 8, zm);
    store64(out + 16, zl);
}

# ln(x), correctly rounded. ln(1) = +0, ln(±0) = −∞, ln(+∞) = +∞, NaN for NaN and x < 0 (−∞ included).
#must_use
fn _bj_k_cr_ln(x: f64): f64 {
    var ui = load64(&x);
    # x ≤ 0 (the sign bit), subnormal, ∞ or NaN: ui − bits(DBL_MIN) is at least bits(∞) − bits(DBL_MIN) as an
    # unsigned word (the unsigned range test of kimiya's _km_cr_exp).
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {
        var w, okw = _bj_k_cr_ln_fast(x);
        if (okw == 1) { return w; }
        var zw: f64 = _bj_k_cr_ln_acc(x);
        return zw;
    }
    # _bj_k_ln_core's body, inline (a call and its three-value return cost about 4 ns here).
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_BJ_K_CR_LN_T + ti);
    var lh: f64 = load64(&_BJ_K_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_BJ_K_CR_LN_T + ti + 16);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var cc: f64 = r * 134217729.0;
    var ra: f64 = cc - (cc - r);
    var rb: f64 = r - ra;
    var t1: f64 = -0.5 * (ra * ra);             # −ra²/2, exact
    var nrb: f64 = -rb;
    var t2: f64 = nrb * (ra + (0.5 * rb));
    var c3: f64 = _BJ_K_CR_LN_C3;
    var c4: f64 = _BJ_K_CR_LN_C4;
    var c5: f64 = _BJ_K_CR_LN_C5;
    var c6: f64 = _BJ_K_CR_LN_C6;
    var c7: f64 = _BJ_K_CR_LN_C7;
    var c8: f64 = _BJ_K_CR_LN_C8;
    var z: f64 = r * r;
    var pz: f64 = ((c3 + (r * c4)) + (z * (c5 + (r * c6)))) + ((z * z) * (c7 + (r * c8)));   # Estrin
    var p: f64 = (z * r) * pz;
    var e = e0;
    var ef: f64 = f64_from(e);
    var ln2h: f64 = _BJ_K_CR_LN_LN2H;
    var ln2m: f64 = _BJ_K_CR_LN_LN2M;
    var a: f64 = ef * ln2h;                      # exact: LN2H has 42 bits, |E| < 2^11
    var s0: f64 = a + lh;
    var d0: f64 = lh - (s0 - a);
    var s1: f64 = s0 + r;
    var d1: f64 = r - (s1 - s0);
    var s2: f64 = s1 + t1;
    var d2: f64 = t1 - (s2 - s1);
    var lo: f64 = (((ef * ln2m) + lm) + (t2 + p)) + ((d0 + d1) + d2);   # short chains (latency)
    var ap: f64 = f64_abs(p);
    var ah: f64 = f64_abs(s2);
    var ae: f64 = f64_abs(ef);
    var k49: f64 = 0x3CE0000000000000;          # 2^-49
    var k83: f64 = 0x3AC0000000000000;          # 2^-83
    var k93: f64 = 0x3A20000000000000;          # 2^-93
    var err: f64 = ((ap * k49) + (ah * k83)) + (ae * k93);
    var u: f64 = s2 + (lo - err);
    var v: f64 = s2 + (lo + err);
    if (u == v) { return u; }
    var za: f64 = _bj_k_cr_ln_acc(x);
    return za;
}

# The fast path alone, for every x (as kimiya's _km_cr_exp_fast): the specials, a subnormal x scaled exactly by 2^54,
# then the core and its test, the operations of _bj_k_cr_ln's inline path.
#must_use
fn _bj_k_cr_ln_fast(x: f64): (f64, i64) {
    var ui = load64(&x);
    var eb = 0;
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {
        if (x != x) { return (x, 1); }
        if (x == 0.0) {
            var m1: f64 = -1.0;
            var ninf: f64 = m1 / 0.0;
            return (ninf, 1);
        }
        if (x < 0.0) {
            var nan: f64 = _bj_k_nan();           # the same quiet NaN on every target
            return (nan, 1);
        }
        if (x == _BJ_K_INF) { return (x, 1); }
        var p54: f64 = 0x4350000000000000;      # 2^54
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var hi, lo, err = _bj_k_ln_core(ui, eb);
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    if (u == v) { return (u, 1); }
    return (0.0, 0);
}

# ln by the accurate path alone, for every x.
#must_use
fn _bj_k_cr_ln_acc(x: f64): f64 {
    if (x != x) { return x; }
    if (x == 0.0) {
        var m1: f64 = -1.0;
        var ninf: f64 = m1 / 0.0;
        return ninf;
    }
    if (x < 0.0) {
        var nan: f64 = _bj_k_nan();               # the same quiet NaN on every target
        return nan;
    }
    if (x == _BJ_K_INF) { return x; }
    if (x == 1.0) { return 0.0; }
    var buf: f64[3];
    _bj_k_ln_acc_td(x, &buf);
    var r: f64 = _bj_k_rn3(buf[0], buf[1], buf[2]);
    return r;
}

# log10(x), correctly rounded. log10(10^k) = k (k = 0 … 22), log10(1) = +0, log10(±0) = −∞, log10(+∞) = +∞,
# NaN for NaN and x < 0. The ln core's (hi, lo, ε), then (hi + lo)·(IVH + IVM) (Dekker's product with IVH
# pre-split) and the rounding test, else the accurate path.
#must_use
fn _bj_k_cr_log10(x: f64): f64 {
    var ui = load64(&x);
    var eb = 0;
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {   # as in _bj_k_cr_ln
        if (x != x) { return x; }
        if (x == 0.0) {
            var m1: f64 = -1.0;
            var ninf: f64 = m1 / 0.0;
            return ninf;
        }
        if (x < 0.0) {
            var nan: f64 = _bj_k_nan();
            return nan;
        }
        if (x == _BJ_K_INF) { return x; }
        var p54: f64 = 0x4350000000000000;          # a subnormal x, scaled exactly by 2^54
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var hi, lo, eln = _bj_k_ln_core(ui, eb);
    var ivh: f64 = _BJ_K_CR_LN_IVH;
    var ivm: f64 = _BJ_K_CR_LN_IVM;
    var i1: f64 = _BJ_K_CR_LN_IVH1;
    var i2: f64 = _BJ_K_CR_LN_IVH2;
    var ph: f64 = hi * ivh;
    var c: f64 = 134217729.0 * hi;
    var h1: f64 = c - (c - hi);
    var h2: f64 = hi - h1;
    var pe: f64 = ((((h1 * i1) - ph) + (h1 * i2)) + (h2 * i1)) + (h2 * i2);
    var pl: f64 = pe + ((hi * ivm) + (lo * ivh));
    # The error: 0.4343·(ln's error) plus the product's roundings (hi·IVM, lo·IVH, pl's sum, the test's own:
    # below 2^-52.4·|lo| + 2^-101·|ph|, which eln's slack and 0.5 − 0.4343 cover) and IVL (2^-111·|ln x|):
    # err10 = eln/2 + 2^-100·|ph|.
    var ap: f64 = f64_abs(ph);
    var k100: f64 = 0x39B0000000000000;     # 2^-100
    var err: f64 = (eln * 0.5) + (ap * k100);
    var u: f64 = ph + (pl - err);
    var v: f64 = ph + (pl + err);
    if (u == v) { return u; }
    var z: f64 = _bj_k_cr_log10_acc(x);
    return z;
}

# log10 by the accurate path alone: the triple-double ln times 1/ln 10 = IVH + IVM + IVL.
#must_use
fn _bj_k_cr_log10_acc(x: f64): f64 {
    if (x != x) { return x; }
    if (x == 0.0) {
        var m1: f64 = -1.0;
        var ninf: f64 = m1 / 0.0;
        return ninf;
    }
    if (x < 0.0) {
        var nan: f64 = _bj_k_nan();               # the same quiet NaN on every target
        return nan;
    }
    if (x == _BJ_K_INF) { return x; }
    if (x == 1.0) { return 0.0; }
    var buf: f64[3];
    _bj_k_ln_acc_td(x, &buf);
    var ivh: f64 = _BJ_K_CR_LN_IVH;
    var ivm: f64 = _BJ_K_CR_LN_IVM;
    var ivl: f64 = _BJ_K_CR_LN_IVL;
    var zh, zm, zl = _bj_k_td_mul(buf[0], buf[1], buf[2], ivh, ivm, ivl);
    var r: f64 = _bj_k_rn3(zh, zm, zl);
    return r;
}

# The fast atan core for n = nh + nl, d = dh + dl with 0 < n ≤ d (1 + 2^-50), dh in [1/2, 2), nh ≥ 2^-62·dh:
# (hi, lo, err) for offset ± atan(n/d) by oct.
#must_use
fn _bj_k_atan_core(nh: f64, nl: f64, dh: f64, dl: f64, oct): (f64, f64, f64) {
    var zh: f64 = nh / dh;
    var cz: f64 = zh + 26388279066624.0;          # 1.5·2^44: rounds n/d to a multiple of 2^-8
    var c: f64 = cz - 26388279066624.0;
    var j = load64(&cz) - 0x42B8000000000000;
    var sh: f64 = nh;
    var sl: f64 = nl;
    var eh: f64 = dh;
    var el: f64 = dl;
    if (j != 0) {
        var d1: f64 = (dh + 384.0) - 384.0;       # 1.5·2^8: dh on the 2^-44 grid
        var d2: f64 = dh - d1;
        var n1: f64 = (nh + 384.0) - 384.0;
        var n2: f64 = nh - n1;
        var p1: f64 = c * d1;                     # exact
        var np1: f64 = -p1;
        var u: f64 = nh + np1;                    # TwoSum(nh, −c·d1)
        var ub: f64 = u - nh;
        var ue: f64 = (nh - (u - ub)) + (np1 - ub);
        sh = u;
        sl = ((ue - (c * d2)) + nl) - (c * dl);
        var q1: f64 = c * n1;                     # exact
        var v: f64 = dh + q1;                     # TwoSum(dh, c·n1)
        var vb: f64 = v - dh;
        var ve: f64 = (dh - (v - vb)) + (q1 - vb);
        eh = v;
        el = ((ve + (c * n2)) + dl) + (c * nl);
    }
    var qh: f64 = sh / eh;                        # δ = qh + ql: Dekker's division
    var cq: f64 = 134217729.0 * qh;
    var q1h: f64 = cq - (cq - qh);
    var q1l: f64 = qh - q1h;
    var ce: f64 = 134217729.0 * eh;
    var e1h: f64 = ce - (ce - eh);
    var e1l: f64 = eh - e1h;
    var pp: f64 = qh * eh;
    var pe: f64 = (((q1h * e1h) - pp) + (q1h * e1l) + (q1l * e1h)) + (q1l * e1l);
    var ql: f64 = ((((sh - pp) - pe) + sl) - (qh * el)) / eh;
    var a3: f64 = _BJ_K_CR_SC_A3;
    var a5: f64 = _BJ_K_CR_SC_A5;
    var a7: f64 = _BJ_K_CR_SC_A7;
    var a9: f64 = _BJ_K_CR_SC_A9;
    var z: f64 = qh * qh;
    var pz: f64 = ((qh * z) * (a3 + (z * (a5 + (z * (a7 + (z * a9))))))) - (ql * z);
    var ah: f64 = load64(&_BJ_K_CR_ATAN_T + 24 * j);
    var am: f64 = load64(&_BJ_K_CR_ATAN_T + 24 * j + 8);
    var oh: f64 = 0.0;
    var om: f64 = 0.0;
    var sg: f64 = 1.0;
    if (oct == 1) {
        oh = _BJ_K_CR_SC_PIH;
        om = _BJ_K_CR_SC_PIM;
        sg = -1.0;
    }
    if (oct >= 2) {
        oh = _BJ_K_CR_SC_PIO2H;
        om = _BJ_K_CR_SC_PIO2M;
        if (oct == 2) { sg = -1.0; }
    }
    var sah: f64 = sg * ah;
    var h1: f64 = oh + sah;                       # Fast2Sum: |oh| ≥ |ah| or oh = 0
    var f1: f64 = sah - (h1 - oh);
    var sqh: f64 = sg * qh;
    var hi: f64 = h1 + sqh;                       # Fast2Sum: |h1| ≥ |qh| or h1 = 0
    var f2: f64 = sqh - (hi - h1);
    var tl: f64 = (am + ql) + pz;
    var lo: f64 = ((f1 + f2) + om) + (sg * tl);
    var ahi: f64 = f64_abs(hi);
    var k68: f64 = 0x3BA6A09E667F3BCD;            # 2^-68.5 (√2·2^-69)
    var err: f64 = ahi * k68;
    return (hi, lo, err);
}

# A triple-double renormalised (two bottom-up TwoSum passes): after a cancellation _bj_k_td_add's leading word can
# be far from the sum (its last renormalisation does not see the rounded third-order term), and the corrections
# below need the leading word to be the sum to 2^-52. The sum is unchanged (every step is exact).
#must_use
fn _bj_k_td_norm(a0: f64, a1: f64, a2: f64): (f64, f64, f64) {
    var s, e = _bj_k_two_sum(a1, a2);
    var h, u = _bj_k_two_sum(a0, s);
    var m, l = _bj_k_two_sum(u, e);
    var h2, u2 = _bj_k_two_sum(h, m);
    var m2, l2 = _bj_k_two_sum(u2, l);
    return (h2, m2, l2);
}

# (a0, a1, a2)/(b0, b1, b2) as a triple-double at out[0..2], b ≠ 0 normalised: q0 = a0/b0 (a renormalised first),
# then two corrections from the remainder a − q·b, computed in triple-double (each below 2^-153 of a) and
# renormalised: relative error below 2^-151.
fn _bj_k_td_div(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64, out) {
    var n0, n1, n2 = _bj_k_td_norm(a0, a1, a2);
    var q0: f64 = n0 / b0;
    var t0, t1, t2 = _bj_k_td_mul_d(b0, b1, b2, q0);
    var ra, rb, rc = _bj_k_td_add(n0, n1, n2, -t0, -t1, -t2);
    var r0, r1, r2 = _bj_k_td_norm(ra, rb, rc);
    var q1: f64 = r0 / b0;
    var u0, u1, u2 = _bj_k_td_mul_d(b0, b1, b2, q1);
    var sa, sb, sc = _bj_k_td_add(r0, r1, r2, -u0, -u1, -u2);
    var s0, s1, s2 = _bj_k_td_norm(sa, sb, sc);
    var q2: f64 = s0 / b0;
    var h, m0 = _bj_k_fast_two_sum(q0, q1);
    var m, l = _bj_k_two_sum(m0, q2);
    store64(out, h);
    store64(out + 8, m);
    store64(out + 16, l);
}

# offset ± atan(n/d) as a triple-double at out[0..2] (the accurate atan core before its rounding).
fn _bj_k_atan_acc_td(n0: f64, n1: f64, n2: f64, d0: f64, d1: f64, d2: f64, oct, out) {
    var zh: f64 = n0 / d0;
    var cz: f64 = zh + 26388279066624.0;
    var c: f64 = cz - 26388279066624.0;
    var j = load64(&cz) - 0x42B8000000000000;
    var a0: f64 = n0;
    var a1: f64 = n1;
    var a2: f64 = n2;
    var b0: f64 = d0;
    var b1: f64 = d1;
    var b2: f64 = d2;
    if (j != 0) {                                 # num = n − c·d, den = d + c·n
        var cd0, cd1, cd2 = _bj_k_td_mul_d(d0, d1, d2, c);
        var x0, x1, x2 = _bj_k_td_add(n0, n1, n2, -cd0, -cd1, -cd2);
        var cn0, cn1, cn2 = _bj_k_td_mul_d(n0, n1, n2, c);
        var y0, y1, y2 = _bj_k_td_add(d0, d1, d2, cn0, cn1, cn2);
        a0 = x0;
        a1 = x1;
        a2 = x2;
        b0 = y0;
        b1 = y1;
        b2 = y2;
    }
    var db: f64[3];
    _bj_k_td_div(a0, a1, a2, b0, b1, b2, &db);
    var dh: f64 = db[0];
    var dm: f64 = db[1];
    var dl: f64 = db[2];
    var wh, wm, wl = _bj_k_td_mul(dh, dm, dl, dh, dm, dl);
    var ph: f64 = load64(&_BJ_K_CR_ATAN_ACC + 168);  # 1/17 (index 3·(8 − 1))
    var pm: f64 = load64(&_BJ_K_CR_ATAN_ACC + 176);
    var pl: f64 = load64(&_BJ_K_CR_ATAN_ACC + 184);
    var k = 7;
    while (k >= 1) {                              # (−1)^k/(2k + 1) + w·P
        var th, tm, tl = _bj_k_td_mul(ph, pm, pl, wh, wm, wl);
        var off = (k - 1) * 24;
        var ch: f64 = load64(&_BJ_K_CR_ATAN_ACC + off);
        var cm: f64 = load64(&_BJ_K_CR_ATAN_ACC + off + 8);
        var cl: f64 = load64(&_BJ_K_CR_ATAN_ACC + off + 16);
        var uh, um, ul = _bj_k_td_add(ch, cm, cl, th, tm, tl);
        ph = uh;
        pm = um;
        pl = ul;
        k = k - 1;
    }
    var vh, vm, vl = _bj_k_td_mul(wh, wm, wl, ph, pm, pl);
    var xh, xm, xl = _bj_k_td_mul(vh, vm, vl, dh, dm, dl);
    var th2, tm2, tl2 = _bj_k_td_add(dh, dm, dl, xh, xm, xl);          # atan δ
    var ah: f64 = load64(&_BJ_K_CR_ATAN_T + 24 * j);
    var am: f64 = load64(&_BJ_K_CR_ATAN_T + 24 * j + 8);
    var al: f64 = load64(&_BJ_K_CR_ATAN_T + 24 * j + 16);
    var gh, gm, gl = _bj_k_td_add(ah, am, al, th2, tm2, tl2);          # θ
    if (oct == 0) {
        store64(out, gh);
        store64(out + 8, gm);
        store64(out + 16, gl);
        return;
    }
    var oh: f64 = _BJ_K_CR_SC_PIO2H;
    var om: f64 = _BJ_K_CR_SC_PIO2M;
    var ol: f64 = _BJ_K_CR_SC_PIO2L;
    if (oct == 1) {
        oh = _BJ_K_CR_SC_PIH;
        om = _BJ_K_CR_SC_PIM;
        ol = _BJ_K_CR_SC_PIL;
    }
    if (oct != 3) {
        gh = -gh;
        gm = -gm;
        gl = -gl;
    }
    var rh, rm, rl = _bj_k_td_add(oh, om, ol, gh, gm, gl);
    store64(out, rh);
    store64(out + 8, rm);
    store64(out + 16, rl);
}

# acos x = atan2(s, x), s = √(1 − x²) ≥ 0: θ = atan(s/|x|) (s ≤ |x|, oct 0 or 1 by x's sign) or
# atan(|x|/s) (oct 2 or 3). Fast path: 1 − x² as a double-double, exact but for a rounding at 2^-106
# ((1 − |x|)·(1 + |x|) for |x| ≥ 1/2, 1 − |x| exact by Sterbenz; 1 − x² by TwoProduct below), s by one Newton
# step from √ (2^-104 relative); the atan core's 2^-69.44 bound absorbs it. Accurate path: 1 − x² as an exact
# sum of four doubles, s by two Newton steps in triple-double (2^-150), the accurate atan core. Special values:
# acos(1) = +0, acos(−1) = π and acos(±0) = π/2 rounded; |x| < 2^-56 gives π/2 (acos x = π/2 − x − …, and
# π/2 is 2^-54.15 inside its rounding interval); NaN for NaN and |x| > 1. Mirrors `f64::acos`.
#must_use
fn _bj_k_cr_acos(x: f64): f64 {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax >= 0x3C70000000000000 && ax < 0x3FF0000000000000) {   # 2^-56 ≤ |x| < 1: the fast core inline
        var hi, lo, err = _bj_k_acos_core(x);
        var u: f64 = hi + (lo - err);
        var v: f64 = hi + (lo + err);
        if (u == v) { return u; }
        var a: f64 = _bj_k_cr_acos_acc(x);
        return a;
    }
    var r, ok = _bj_k_acos_special(x);              # every other x is a special value
    return r;
}

# The special values of acos: (result, 1), or (0, 0) for 2^-56 ≤ |x| < 1.
#must_use
fn _bj_k_acos_special(x: f64): (f64, i64) {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax > 0x7FF0000000000000) { return (x, 1); }
    if (ax > 0x3FF0000000000000) {
        var nan: f64 = _bj_k_nan();
        return (nan, 1);
    }
    if (x == 1.0) { return (0.0, 1); }
    if (x == -1.0) {
        var pi: f64 = _BJ_K_CR_SC_PIH;
        return (pi, 1);
    }
    if (ax < 0x3C70000000000000) {                # |x| < 2^-56, ±0 included
        var p2: f64 = _BJ_K_CR_SC_PIO2H;
        return (p2, 1);
    }
    return (0.0, 0);
}

# The fast core of acos for 2^-56 ≤ |x| < 1: (hi, lo, err) from the atan core.
#must_use
fn _bj_k_acos_core(x: f64): (f64, f64, f64) {
    var ax: f64 = f64_abs(x);
    var wh: f64 = 0.0;
    var wl: f64 = 0.0;
    if (ax >= 0.5) {
        var a: f64 = 1.0 - ax;                    # exact (Sterbenz)
        var bh: f64 = 1.0 + ax;                   # Fast2Sum(1, |x|)
        var bl: f64 = ax - (bh - 1.0);
        var ca: f64 = 134217729.0 * a;            # (1 − |x|)·bh by Dekker's product
        var a1: f64 = ca - (ca - a);
        var a2: f64 = a - a1;
        var cb: f64 = 134217729.0 * bh;
        var b1: f64 = cb - (cb - bh);
        var b2: f64 = bh - b1;
        wh = a * bh;
        var we: f64 = (((a1 * b1) - wh) + (a1 * b2) + (a2 * b1)) + (a2 * b2);
        wl = we + (a * bl);
    } else {
        var cx: f64 = 134217729.0 * ax;           # x² = p + pe (Dekker)
        var x1: f64 = cx - (cx - ax);
        var x2: f64 = ax - x1;
        var p: f64 = ax * ax;
        var pe: f64 = (((x1 * x1) - p) + (2.0 * (x1 * x2))) + (x2 * x2);
        wh = 1.0 - p;                             # Fast2Sum(1, −p)
        var we2: f64 = (1.0 - wh) - p;
        wl = we2 - pe;
    }
    var sh: f64 = f64_sqrt(wh);                   # s = sh + sl, one Newton step
    var cs: f64 = 134217729.0 * sh;
    var s1: f64 = cs - (cs - sh);
    var s2: f64 = sh - s1;
    var sp2: f64 = sh * sh;
    var spe: f64 = (((s1 * s1) - sp2) + (2.0 * (s1 * s2))) + (s2 * s2);
    var sl: f64 = (((wh - sp2) - spe) + wl) / (2.0 * sh);
    var neg = 0;
    if (x < 0.0) { neg = 1; }
    if (sh <= ax) {
        var h1, l1, e1 = _bj_k_atan_core(sh, sl, ax, 0.0, neg);
        return (h1, l1, e1);
    }
    var h2, l2, e2 = _bj_k_atan_core(ax, 0.0, sh, sl, 2 + neg);
    return (h2, l2, e2);
}

# √(w0 + w1 + w2) for w > 0 as a triple-double at out[0..2]: two Newton corrections of √w0, each from the
# renormalised residual w − s² (2^-150).
fn _bj_k_td_sqrt(w0: f64, w1: f64, w2: f64, out) {
    var s0: f64 = f64_sqrt(w0);
    var p, pe = _bj_k_two_prod(s0, s0);
    var ra, rb, rc = _bj_k_td_add(w0, w1, w2, -p, -pe, 0.0);
    var r0, r1, r2 = _bj_k_td_norm(ra, rb, rc);     # the residual w − s0², renormalised
    var tw: f64 = 2.0 * s0;
    var c1: f64 = r0 / tw;
    var h, m = _bj_k_fast_two_sum(s0, c1);
    var q0, q1, q2 = _bj_k_td_mul(h, m, 0.0, h, m, 0.0);
    var ua, ub, uc = _bj_k_td_add(w0, w1, w2, -q0, -q1, -q2);
    var u0, u1, u2 = _bj_k_td_norm(ua, ub, uc);
    var c2: f64 = u0 / tw;
    var v0, v1, v2 = _bj_k_td_add_d(h, m, 0.0, c2);
    store64(out, v0);
    store64(out + 8, v1);
    store64(out + 16, v2);
}

# acos x by the accurate path alone.
#must_use
fn _bj_k_cr_acos_acc(x: f64): f64 {
    var s, sp = _bj_k_acos_special(x);
    if (sp == 1) { return s; }
    var rb: f64[3];
    _bj_k_acos_acc_td(x, &rb);
    var r: f64 = _bj_k_rn3(rb[0], rb[1], rb[2]);
    return r;
}

# acos x for 2^-56 ≤ |x| < 1 as a triple-double at out[0..2] (the accurate path before its rounding).
fn _bj_k_acos_acc_td(x: f64, out) {
    var ax: f64 = f64_abs(x);
    var w0: f64 = 0.0;
    var w1: f64 = 0.0;
    var w2: f64 = 0.0;
    if (ax >= 0.5) {                              # (1 − |x|)·(1 + |x|): four exact products
        var a: f64 = 1.0 - ax;
        var bh, bl = _bj_k_fast_two_sum(1.0, ax);
        var p0, e0 = _bj_k_two_prod(a, bh);
        var p1, e1 = _bj_k_two_prod(a, bl);
        var g0, g1, g2 = _bj_k_td_add_d(p0, e0, 0.0, p1);
        var h0, h1, h2 = _bj_k_td_add_d(g0, g1, g2, e1);
        w0 = h0;
        w1 = h1;
        w2 = h2;
    } else {
        var p, pe = _bj_k_two_prod(ax, ax);
        var k0, k1, k2 = _bj_k_td_add_d(1.0, 0.0, 0.0, -p);
        var m0, m1, m2 = _bj_k_td_add_d(k0, k1, k2, -pe);
        w0 = m0;
        w1 = m1;
        w2 = m2;
    }
    var sb: f64[3];
    _bj_k_td_sqrt(w0, w1, w2, &sb);
    var neg = 0;
    if (x < 0.0) { neg = 1; }
    if (sb[0] <= ax) {
        _bj_k_atan_acc_td(sb[0], sb[1], sb[2], ax, 0.0, 0.0, neg, out);
        return;
    }
    _bj_k_atan_acc_td(ax, 0.0, 0.0, sb[0], sb[1], sb[2], 2 + neg, out);
}

# ── asin: bijli's, on kimiya's atan core ────────────────────────────────────────────

# The special values of asin: (result, 1), or (0, 0) for 2^-26 ≤ |x| < 1. NaN for NaN; NaN for |x| > 1, ±∞ included;
# asin(±1) = ±π/2 rounded; |x| < 2^-26 gives x itself, ±0 and the subnormals included: asin x − x < x³/6·(1 + x²),
# which is below 2^-54.5·|x| there, while half an ulp of x is at least 2^-54·|x|, and asin x lies strictly between x
# and the next double away from zero, so no tie can occur.
#must_use
fn _bj_k_asin_special(x: f64): (f64, i64) {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax > 0x7FF0000000000000) { return (x, 1); }
    if (ax > 0x3FF0000000000000) {
        var nan: f64 = _bj_k_nan();
        return (nan, 1);
    }
    if (ax == 0x3FF0000000000000) {
        var p2: f64 = _BJ_K_CR_SC_PIO2H;
        if (x < 0.0) { p2 = -p2; }
        return (p2, 1);
    }
    if (ax < 0x3E50000000000000) { return (x, 1); }      # |x| < 2^-26
    return (0.0, 0);
}

# The fast core of asin |x| for 2^-26 ≤ |x| < 1: (hi, lo, err) from the atan core. asin |x| = atan2(|x|, s) with
# s = √(1 − x²): θ = atan(|x|/s) when |x| ≤ s (oct 0), else π/2 − atan(s/|x|) (oct 2). 1 − x² and s exactly as
# kimiya's acos core computes them (a double-double, s by one Newton step, 2^-104 relative); the denominator is
# max(|x|, s) ≥ 1/√2 and the numerator at least 2^-26.5, inside the core's domain, and its 2^-69.44 bound absorbs
# s's error as it does for acos.
#must_use
fn _bj_k_asin_core(x: f64): (f64, f64, f64) {
    var ax: f64 = f64_abs(x);
    var wh: f64 = 0.0;
    var wl: f64 = 0.0;
    if (ax >= 0.5) {
        var a: f64 = 1.0 - ax;                    # exact (Sterbenz)
        var bh: f64 = 1.0 + ax;                   # Fast2Sum(1, |x|)
        var bl: f64 = ax - (bh - 1.0);
        var ca: f64 = 134217729.0 * a;            # (1 − |x|)·bh by Dekker's product
        var a1: f64 = ca - (ca - a);
        var a2: f64 = a - a1;
        var cb: f64 = 134217729.0 * bh;
        var b1: f64 = cb - (cb - bh);
        var b2: f64 = bh - b1;
        wh = a * bh;
        var we: f64 = (((a1 * b1) - wh) + (a1 * b2) + (a2 * b1)) + (a2 * b2);
        wl = we + (a * bl);
    } else {
        var cx: f64 = 134217729.0 * ax;           # x² = p + pe (Dekker)
        var x1: f64 = cx - (cx - ax);
        var x2: f64 = ax - x1;
        var p: f64 = ax * ax;
        var pe: f64 = (((x1 * x1) - p) + (2.0 * (x1 * x2))) + (x2 * x2);
        wh = 1.0 - p;                             # Fast2Sum(1, −p)
        var we2: f64 = (1.0 - wh) - p;
        wl = we2 - pe;
    }
    var sh: f64 = f64_sqrt(wh);                   # s = sh + sl, one Newton step
    var cs: f64 = 134217729.0 * sh;
    var s1: f64 = cs - (cs - sh);
    var s2: f64 = sh - s1;
    var sp2: f64 = sh * sh;
    var spe: f64 = (((s1 * s1) - sp2) + (2.0 * (s1 * s2))) + (s2 * s2);
    var sl: f64 = (((wh - sp2) - spe) + wl) / (2.0 * sh);
    if (ax <= sh) {
        var h1, l1, e1 = _bj_k_atan_core(ax, 0.0, sh, sl, 0);
        return (h1, l1, e1);
    }
    var h2, l2, e2 = _bj_k_atan_core(sh, sl, ax, 0.0, 2);
    return (h2, l2, e2);
}

# asin |x| for 2^-26 ≤ |x| < 1 as a triple-double at out[0..2] (the accurate path before its rounding): 1 − x² as an
# exact sum of doubles and s by kimiya's triple-double square root, as in kimiya's accurate acos, then the accurate
# atan core in octant 0 or 2.
fn _bj_k_asin_acc_td(x: f64, out) {
    var ax: f64 = f64_abs(x);
    var w0: f64 = 0.0;
    var w1: f64 = 0.0;
    var w2: f64 = 0.0;
    if (ax >= 0.5) {                              # (1 − |x|)·(1 + |x|): four exact products
        var a: f64 = 1.0 - ax;
        var bh, bl = _bj_k_fast_two_sum(1.0, ax);
        var p0, e0 = _bj_k_two_prod(a, bh);
        var p1, e1 = _bj_k_two_prod(a, bl);
        var g0, g1, g2 = _bj_k_td_add_d(p0, e0, 0.0, p1);
        var h0, h1, h2 = _bj_k_td_add_d(g0, g1, g2, e1);
        w0 = h0;
        w1 = h1;
        w2 = h2;
    } else {
        var p, pe = _bj_k_two_prod(ax, ax);
        var k0, k1, k2 = _bj_k_td_add_d(1.0, 0.0, 0.0, -p);
        var m0, m1, m2 = _bj_k_td_add_d(k0, k1, k2, -pe);
        w0 = m0;
        w1 = m1;
        w2 = m2;
    }
    var sb: f64[3];
    _bj_k_td_sqrt(w0, w1, w2, &sb);
    if (ax <= sb[0]) {
        _bj_k_atan_acc_td(ax, 0.0, 0.0, sb[0], sb[1], sb[2], 0, out);
        return;
    }
    _bj_k_atan_acc_td(sb[0], sb[1], sb[2], ax, 0.0, 0.0, 2, out);
}

# asin x by the accurate path alone.
#must_use
fn _bj_k_cr_asin_acc(x: f64): f64 {
    var s, sp = _bj_k_asin_special(x);
    if (sp == 1) { return s; }
    var rb: f64[3];
    _bj_k_asin_acc_td(x, &rb);
    var r: f64 = _bj_k_rn3(rb[0], rb[1], rb[2]);
    if (x < 0.0) { r = -r; }
    return r;
}

# asin x, correctly rounded: the odd function's value at |x| from the fast core and its rounding test, else the
# accurate path, then x's sign (negation is exact, and round-to-nearest is symmetric). Mirrors `f64::asin`.
#must_use
fn _bj_k_cr_asin(x: f64): f64 {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax >= 0x3E50000000000000 && ax < 0x3FF0000000000000) {   # 2^-26 ≤ |x| < 1
        var hi, lo, err = _bj_k_asin_core(x);
        var u: f64 = hi + (lo - err);
        var v: f64 = hi + (lo + err);
        if (u == v) {
            if (x < 0.0) { u = -u; }
            return u;
        }
        var a: f64 = _bj_k_cr_asin_acc(x);
        return a;
    }
    var r, ok = _bj_k_asin_special(x);
    return r;
}

# --- crmath_kx.cyr ---

# crmath_kx.cyr — kimiya's correctly rounded monomials, square roots of quotients and binary64 with an
# unbounded exponent (kimiya ADR 0002 #20, #27–#32), for bijli's range-edge Part (M1 part 5).
#
# GENERATED by scripts/port/kimiya_closure.py from kimiya's src/mathx.cyr: the call closure of its _km_cr_mono
# family, _km_cr_sqrt_div, _km_cr_mul_sqrt_ratio and _km_ux_*, function for function, with the prefixes renamed
# (_km_ → _bj_k_, _KM_ → _BJ_K_) as src/crmath_k.cyr's copy was; what src/crmath_k.cyr already holds is used from
# there. Do not edit: re-run the script (port plan §10 G1: a shared module would replace both copies).

# The bit pattern of an f64, as an integer. The untyped parameter carries the word, and the
# `: i64` return types the caller's binding as an integer: a bare `var u = x;` copy of an f64
# is f64-typed, so its `<` would be a float compare.
#must_use
fn _bj_k_bits(x): i64 { return x; }

# 1 if x is NaN.
#must_use
fn _bj_k_is_nan(x: f64): i64 {
    if (x != x) { return 1; }
    return 0;
}

# The larger of x and y, ignoring a NaN operand (NaN only when both are). Equal operands,
# +0 and −0 included, give y: what rustc 1.99.1's `x.max(y)` returns (maxsd). Mirrors `f64::max`.
#must_use
fn _bj_k_max(x: f64, y: f64): f64 {
    if (x != x) { return y; }
    if (y != y) { return x; }
    if (x > y) { return x; }
    return y;
}

# ── error-free transformations (M2a) ───────────────────────────────────────────────────────────
# ── correctly rounded exp, expm1, exp10, ln and log10 (M3c-2a): ADR 0006 ────────────────────────

# 2^e as a double, for −1022 ≤ e ≤ 1023.
#must_use
fn _bj_k_cr_pow2(e): f64 {
    var b = (e + 1023) << 52;
    var r: f64 = b;
    return r;
}

# RN(2^e·(h + m + l)) for a normalised triple-double h + m + l in [0.99, 2.01], every result range: a normal
# result is RN3 then an exact scale (2^1024 in two steps; a significand that rounds up past DBL_MAX gives
# +∞, as IEEE overflow does). A result below 2^-1022 is rounded ONCE, at the subnormal grid: with
# y = 2^(e + 1022)·(h + m + l) < 1 (each part scaled exactly), RN(1 + y) has its ulp at 2^-52, which is
# 2^-1074 after the final scale, and (RN(1 + y) − 1)·2^-1022 is exact (glibc's specialcase technique). The
# sum 1 + yh + ym + yl is rounded exactly: 1 + yh = a + b (Fast2Sum), and RN(a + b + RO(ym + yl)) =
# RN(a + b + ym + yl) because every breakpoint minus a − b is a multiple of ulp(yh), an even multiple of
# ulp(RO(ym + yl)), and rounding to odd keeps the order against those.
#must_use
fn _bj_k_cr_finish(e, h: f64, m: f64, l: f64): f64 {
    if (e >= 0 - 1021) {
        var z: f64 = _bj_k_rn3(h, m, l);
        if (e > 1023) {
            var s1: f64 = _bj_k_cr_pow2(e - 1);
            var o: f64 = (z * s1) * 2.0;
            return o;
        }
        var s2: f64 = _bj_k_cr_pow2(e);
        var y: f64 = z * s2;
        return y;
    }
    var h1, m1a = _bj_k_fast_two_sum(h, m);    # renormalised, so the sign tests below decide y < 1
    var m1, l1 = _bj_k_two_sum(m1a, l);
    var s: f64 = _bj_k_cr_pow2(e + 1022);
    var yh: f64 = h1 * s;
    var ym: f64 = m1 * s;
    var yl: f64 = l1 * s;
    var normal = 0;
    if (yh > 1.0) { normal = 1; }
    if (yh == 1.0) {
        if (ym > 0.0) { normal = 1; }
        if (ym == 0.0 && yl >= 0.0) { normal = 1; }
    }
    if (normal == 1) {                       # y ≥ 1: the result is at least 2^-1022
        var z2: f64 = _bj_k_rn3(h, m, l);
        var s3: f64 = _bj_k_cr_pow2(e);
        var y2: f64 = z2 * s3;
        return y2;
    }
    var a, b = _bj_k_fast_two_sum(1.0, yh);
    var v: f64 = _bj_k_ro_sum(ym, yl);
    var w: f64 = _bj_k_rn3(a, b, v);
    var dmin: f64 = _bj_k_cr_pow2(0 - 1022);
    var r: f64 = (w - 1.0) * dmin;
    return r;
}

# ── exp ─────────────────────────────────────────────────────────────────────────────────────────

# The fast core for e^(xh + xl), |xh| ≤ 745.2 and |xl| ≤ 2^-42: (hi, lo, E) with hi + lo = e^x/2^E within
# 2^-70. exp passes xl = 0; exp10 passes x·ln 10 as xh + xl (xl folds into the K·L2 term).
#must_use
fn _bj_k_exp_core(xh: f64, xl: f64): (f64, f64, i64) {
    var inv: f64 = _BJ_K_CR_EXP_INVLN2N;
    var l1: f64 = _BJ_K_CR_EXP_L1;
    var l2: f64 = _BJ_K_CR_EXP_L2;
    var tt: f64 = (xh * inv) + 6755399441055744.0;   # 1.5·2^52: rounds x·512/ln 2 to an integer
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var ti = (k & 511) * 32;
    var e = k >>> 9;
    var rh: f64 = xh - (kd * l1);
    var s: f64 = (kd * l2) - xl;
    var r: f64 = rh - s;
    var rl: f64 = (rh - r) - s;
    var c: f64 = r + 49152.0;                         # 1.5·2^15: rounds r to a multiple of 2^-37
    var r1: f64 = c - 49152.0;
    var r2: f64 = r - r1;
    var p3: f64 = _BJ_K_CR_EXP_P3;
    var p4: f64 = _BJ_K_CR_EXP_P4;
    var p5: f64 = _BJ_K_CR_EXP_P5;
    var z: f64 = r * r;                       # Estrin: the code is latency-bound, so keep chains short
    var q: f64 = (z * (0.5 + (r * p3))) + ((z * z) * (p4 + (r * p5)));
    var a: f64 = load64(&_BJ_K_CR_EXP_T + ti);
    var b: f64 = load64(&_BJ_K_CR_EXP_T + ti + 8);
    var p1: f64 = a * r1;
    var hi: f64 = a + p1;
    var e1: f64 = p1 - (hi - a);
    var rlq: f64 = rl + q;
    var lo: f64 = (e1 + b) + ((a * (r2 + rlq)) + (b * (r + rlq)));
    return (hi, lo, e);
}

# The accurate core: e^(y0 + y1 + y2) = 2^E·(h + m + l), (h, m, l) stored at out[0..2], E returned. The same
# K as the fast path; r = y − K·(L1 + L2 + L3 + L4) as a triple-double (K·L1 exact, K·L2 and K·L3
# TwoProducts, K·L4 rounded: below 2^-186 of error); e^r − 1 by Horner in triple-double to r^11/11!
# (truncation 2^-152); T_j = A + B + C + D renormalised (2^-159); h + m + l = T_j + T_j·(e^r − 1). Measured
# relative error 2^-155 against 400-bit MPFR.
#must_use
fn _bj_k_exp_acc_core(y0: f64, y1: f64, y2: f64, out): i64 {
    var inv: f64 = _BJ_K_CR_EXP_INVLN2N;
    var l1: f64 = _BJ_K_CR_EXP_L1;
    var l2: f64 = _BJ_K_CR_EXP_L2;
    var l3: f64 = _BJ_K_CR_EXP_L3;
    var l4: f64 = _BJ_K_CR_EXP_L4;
    var tt: f64 = (y0 * inv) + 6755399441055744.0;
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var ti = (k & 511) * 32;
    var e = k >>> 9;
    var rh: f64 = y0 - (kd * l1);
    var a2, a2e = _bj_k_two_prod(kd, l2);
    var a3, a3e = _bj_k_two_prod(kd, l3);
    var a4: f64 = kd * l4;
    var ra0, ra1, ra2 = _bj_k_td_add_d(rh, 0.0, 0.0, -a2);
    var rb0, rb1, rb2 = _bj_k_td_add_d(ra0, ra1, ra2, y1);
    var rc0, rc1, rc2 = _bj_k_td_add_d(rb0, rb1, rb2, -a2e);
    var rd0, rd1, rd2 = _bj_k_td_add_d(rc0, rc1, rc2, -a3);
    var re0, re1, re2 = _bj_k_td_add_d(rd0, rd1, rd2, y2);
    var a34: f64 = a3e + a4;
    var r0, r1, r2 = _bj_k_td_add_d(re0, re1, re2, -a34);
    var sh: f64 = load64(&_BJ_K_CR_EXP_ACC + 216);    # 1/11! (index 3·(11 − 2))
    var sm: f64 = load64(&_BJ_K_CR_EXP_ACC + 224);
    var sl: f64 = load64(&_BJ_K_CR_EXP_ACC + 232);
    var n = 10;
    while (n >= 2) {
        var th, tm, tl = _bj_k_td_mul(r0, r1, r2, sh, sm, sl);
        var off = (n - 2) * 24;
        var ch: f64 = load64(&_BJ_K_CR_EXP_ACC + off);
        var cm: f64 = load64(&_BJ_K_CR_EXP_ACC + off + 8);
        var cl: f64 = load64(&_BJ_K_CR_EXP_ACC + off + 16);
        var uh, um, ul = _bj_k_td_add(ch, cm, cl, th, tm, tl);
        sh = uh;
        sm = um;
        sl = ul;
        n = n - 1;
    }
    var vh, vm, vl = _bj_k_td_mul(r0, r1, r2, sh, sm, sl);
    var wh, wm, wl = _bj_k_td_add_d(vh, vm, vl, 1.0);
    var ph, pm, pl = _bj_k_td_mul(r0, r1, r2, wh, wm, wl);     # e^r − 1
    var ta: f64 = load64(&_BJ_K_CR_EXP_T + ti);
    var tb: f64 = load64(&_BJ_K_CR_EXP_T + ti + 8);
    var tc: f64 = load64(&_BJ_K_CR_EXP_T + ti + 16);
    var td: f64 = load64(&_BJ_K_CR_EXP_T + ti + 24);
    var t0, t1a = _bj_k_fast_two_sum(ta, tb);
    var t1, t2a = _bj_k_fast_two_sum(t1a, tc);
    var t2: f64 = t2a + td;
    var qh, qm, ql = _bj_k_td_mul(t0, t1, t2, ph, pm, pl);
    var zh, zm, zl = _bj_k_td_add(t0, t1, t2, qh, qm, ql);
    store64(out, zh);
    store64(out + 8, zm);
    store64(out + 16, zl);
    return e;
}

# ── exp10 ───────────────────────────────────────────────────────────────────────────────────────
# ── expm1 ───────────────────────────────────────────────────────────────────────────────────────

# expm1(x) = e^x − 1, correctly rounded. ±0 → ±0 and |x| < 2^-53 → x (x²/2 is then below half an ulp of x,
# on the side that keeps x), +∞ → +∞, −∞ → −1, NaN for NaN; x above 709.782712893384 overflows, below
# −37.42994775023704 (e^x < 2^-54) rounds to −1.
#must_use
fn _bj_k_cr_expm1(x: f64): f64 {
    var y, ok = _bj_k_cr_expm1_fast(x);
    if (ok == 1) { return y; }
    var z: f64 = _bj_k_cr_expm1_acc(x);
    return z;
}

# The fast path alone: (its result, 1), or (0, 0) when its test fails or x > 708 (left to the accurate path).
#must_use
fn _bj_k_cr_expm1_fast(x: f64): (f64, i64) {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3F90000000000000) {               # |x| < 2^-6
        if (ax < 0x3CA0000000000000) { return (x, 1); }   # |x| < 2^-53, ±0, subnormals
        var p: f64 = x * x;                      # x² = p + pe exactly (Dekker, inline)
        var cx: f64 = 134217729.0 * x;
        var x1: f64 = cx - (cx - x);
        var x2: f64 = x - x1;
        var pe: f64 = (((x1 * x1) - p) + (2.0 * (x1 * x2))) + (x2 * x2);
        var k3: f64 = _BJ_K_CR_EXPM1_Q3;
        var k4: f64 = _BJ_K_CR_EXPM1_Q4;
        var k5: f64 = _BJ_K_CR_EXPM1_Q5;
        var k6: f64 = _BJ_K_CR_EXPM1_Q6;
        var k7: f64 = _BJ_K_CR_EXPM1_Q7;
        var k8: f64 = _BJ_K_CR_EXPM1_Q8;
        var k9: f64 = _BJ_K_CR_EXPM1_Q9;
        var s: f64 = ((k3 + (x * k4)) + (p * (k5 + (x * k6)))) + ((p * p) * ((k7 + (x * k8)) + (p * k9)));
        var x3: f64 = (x * p) * s;
        var hp: f64 = p * 0.5;
        var hs: f64 = x + hp;
        var ht: f64 = hp - (hs - x);
        var lo: f64 = (ht + (pe * 0.5)) + x3;
        var ex3: f64 = f64_abs(x3);
        var exa: f64 = f64_abs(x);
        var c49: f64 = 0x3CE0000000000000;      # 2^-49
        var c100: f64 = 0x39B0000000000000;     # 2^-100
        var err: f64 = (ex3 * c49) + (exa * c100);
        var u: f64 = hs + (lo - err);
        var v: f64 = hs + (lo + err);
        if (u == v) { return (u, 1); }
        return (0.0, 0);
    }
    var m1b = _BJ_K_CR_EXPM1_M1 & 0x7FFFFFFFFFFFFFFF;
    if (ax > m1b) {                              # |x| > 37.42994775023704
        if (x < 0.0) { return (-1.0, 1); }       # x < EXPM1_M1 (−∞ included): e^x < 2^-54
        if (ax > 0x4086200000000000) {           # x > 708, +∞, NaN: left to the accurate path (which returns
            return (0.0, 0);                     # the specials at once)
        }
    }
    var hi, lo2, e = _bj_k_exp_core(x, 0.0);
    var hh: f64 = 0.0;
    var ll: f64 = lo2;
    var sc: f64 = 1.0;
    if (e == 0) {
        hh = hi - 1.0;                           # exact: hi in [0.9993, 1.9987]
    } else {
        sc = _bj_k_cr_pow2(e);
        var hsc: f64 = hi * sc;
        if (e > 0) {
            hh = hsc - 1.0;
            var t1: f64 = -1.0 - (hh - hsc);
            ll = t1 + (lo2 * sc);
        } else {
            hh = -1.0 + hsc;
            var t2: f64 = hsc - (hh + 1.0);
            ll = t2 + (lo2 * sc);
        }
    }
    var err2: f64 = 0x3BA0000000000000;      # 2^-69
    var errs: f64 = err2 * sc;
    var u2: f64 = hh + (ll - errs);
    var v2: f64 = hh + (ll + errs);
    if (u2 == v2) { return (u2, 1); }
    return (0.0, 0);
}

# expm1 by the accurate path alone. |x| < 2^-6: x + x²/2 + … + x^17/17! by Horner in triple-double on the
# exact x (truncation below 2^-154 of x; measured 2^-155). Otherwise e^x from exp's accurate core, scaled,
# minus 1 in triple-double (|expm1(x)| ≥ 0.0155: at most 6.1 bits of cancellation; measured 2^-152); for
# E ≥ 120 the −1 is below 2^-114 of e^x, inside exp's own worst-case distance (Lefèvre–Muller: 2^-113 for
# |x| ≥ 2^-30), so it cannot move the rounding and expm1 rounds as exp does.
#must_use
fn _bj_k_cr_expm1_acc(x: f64): f64 {
    if (x != x) { return x; }
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3CA0000000000000) { return x; }
    var ovf: f64 = _BJ_K_CR_EXPM1_OVF;
    var m1: f64 = _BJ_K_CR_EXPM1_M1;
    if (x > ovf) { return _BJ_K_INF; }
    if (x < m1) { return -1.0; }
    if (ax < 0x3F90000000000000) {
        var sh: f64 = load64(&_BJ_K_CR_EXP_ACC + 360);   # 1/17! (index 3·(17 − 2))
        var sm: f64 = load64(&_BJ_K_CR_EXP_ACC + 368);
        var sl: f64 = load64(&_BJ_K_CR_EXP_ACC + 376);
        var n = 16;
        while (n >= 2) {
            var th, tm, tl = _bj_k_td_mul_d(sh, sm, sl, x);
            var off = (n - 2) * 24;
            var ch: f64 = load64(&_BJ_K_CR_EXP_ACC + off);
            var cm: f64 = load64(&_BJ_K_CR_EXP_ACC + off + 8);
            var cl: f64 = load64(&_BJ_K_CR_EXP_ACC + off + 16);
            var uh, um, ul = _bj_k_td_add(ch, cm, cl, th, tm, tl);
            sh = uh;
            sm = um;
            sl = ul;
            n = n - 1;
        }
        var vh, vm, vl = _bj_k_td_mul_d(sh, sm, sl, x);
        var wh, wm, wl = _bj_k_td_add_d(vh, vm, vl, 1.0);
        var ph, pm, pl = _bj_k_td_mul_d(wh, wm, wl, x);
        var r: f64 = _bj_k_rn3(ph, pm, pl);
        return r;
    }
    var buf: f64[3];
    var e = _bj_k_exp_acc_core(x, 0.0, 0.0, &buf);
    if (e >= 120) {
        var big: f64 = _bj_k_cr_finish(e, buf[0], buf[1], buf[2]);
        return big;
    }
    var sc: f64 = _bj_k_cr_pow2(e);
    var bh: f64 = buf[0] * sc;
    var bm: f64 = buf[1] * sc;
    var bl: f64 = buf[2] * sc;
    var dh, dm, dl = _bj_k_td_add_d(bh, bm, bl, -1.0);
    var r2: f64 = _bj_k_rn3(dh, dm, dl);
    return r2;
}

# ── ln and log10 ────────────────────────────────────────────────────────────────────────────────
# ── pow (M3c-2b) ────────────────────────────────────────────────────────────────────────────────

# RN(mm·2^s) for an integer 1 ≤ mm < 2^62 and an integer |s| < 2^40, by integer rounding: ties to even,
# subnormal results on the 2^-1074 grid, +∞ past DBL_MAX, +0 below half of 2^-1074. Exact, so it rounds exact
# results and exact midpoints right.
#must_use
fn _bj_k_cr_from_int(mm, s): f64 {
    var b = 0;
    var t = mm;
    while (t != 0) {
        t = t >> 1;
        b = b + 1;
    }
    var top = s + b - 1;                         # the exponent of mm·2^s's leading bit
    if (top > 1023) {
        var inf: f64 = _BJ_K_INF;
        return inf;
    }
    var lsb = top - 52;                          # the result's last bit, at most 53 bits and not below 2^-1074
    if (lsb < 0 - 1074) { lsb = 0 - 1074; }
    var sh = lsb - s;
    var q = mm;
    if (sh > 0) {
        if (sh > 62) { return 0.0; }
        q = mm >> sh;
        var rem = mm - (q << sh);
        var half = 1 << (sh - 1);
        if (rem > half || (rem == half && (q & 1) == 1)) { q = q + 1; }
    } else {
        lsb = s;
    }
    var qf: f64 = f64_from(q);                   # q ≤ 2^53: exact
    if (lsb >= 0 - 1022) {
        var sc: f64 = _bj_k_cr_pow2(lsb);
        var r: f64 = qf * sc;                    # exact, or +∞ when q·2^lsb = 2^1024
        return r;
    }
    var s1: f64 = _bj_k_cr_pow2(lsb + 1074);       # q·2^lsb = ((q·2^(lsb + 1074))·2^-52)·2^-1022: each step exact
    var s2: f64 = _bj_k_cr_pow2(0 - 52);
    var s3: f64 = _bj_k_cr_pow2(0 - 1022);
    var w: f64 = ((qf * s1) * s2) * s3;
    return w;
}

# ── sin and cos (M4a) ───────────────────────────────────────────────────────────────────────────
# ── atan2 and acos (M4a) ────────────────────────────────────────────────────────────────────────
# ── x·2^y, correctly rounded (M4d): ADR 0002 #13 ──────────────────────────────────────────────────────
# ── 1/(100·x), correctly rounded (M4e): ADR 0002 #19 ──────────────────────────────────────────────────
# ── binary64 with an unbounded exponent (M4e-2): ADR 0002 #20 ──────────────────────────────────────────────

# (s, e) for a double r whose magnitude is normal, times 2^e: s is r with its exponent field set to 0 (1 ≤ |s| < 2), e
# plus r's exponent. A zero or a special gives (r, 0). r is never subnormal here (every caller's r is a significand
# operation's result, at least 2^-107 in magnitude, or a value _bj_k_ux_from has scaled).
#must_use
fn _bj_k_ux_norm(r: f64, e): (f64, i64) {
    var b = load64(&r);
    var be = (b >> 52) & 0x7FF;
    if (be == 0 || be == 0x7FF) { return (r, 0); }
    var sb = (b & 0x800FFFFFFFFFFFFF) | 0x3FF0000000000000;
    var s: f64 = sb;
    return (s, e + be - 1023);
}

# The unbounded-exponent value of a double x: (s, e) with x = s·2^e exactly (subnormals included); ±0, ±∞ and NaN give
# (x, 0).
#must_use
fn _bj_k_ux_from(x: f64): (f64, i64) {
    var b = load64(&x);
    if ((b & 0x7FF0000000000000) == 0 && (b & 0x7FFFFFFFFFFFFFFF) != 0) {
        var p54: f64 = 0x4350000000000000;           # 2^54: a subnormal scaled into the normal range, exactly
        var y: f64 = x * p54;
        var s, e = _bj_k_ux_norm(y, 0 - 54);
        return (s, e);
    }
    var s2, e2 = _bj_k_ux_norm(x, 0);
    return (s2, e2);
}

# −x.
#must_use
fn _bj_k_ux_neg(xs: f64, xe): (f64, i64) {
    var n: f64 = -xs;
    return (n, xe);
}

# x·y, rounded to 53 bits with an unbounded exponent.
#must_use
fn _bj_k_ux_mul(xs: f64, xe, ys: f64, ye): (f64, i64) {
    var p: f64 = xs * ys;
    var s, e = _bj_k_ux_norm(p, xe + ye);
    return (s, e);
}

# x/y, rounded to 53 bits with an unbounded exponent (y = ±0 gives IEEE's ±∞ or NaN).
#must_use
fn _bj_k_ux_div(xs: f64, xe, ys: f64, ye): (f64, i64) {
    var q: f64 = xs / ys;
    var s, e = _bj_k_ux_norm(q, xe - ye);
    return (s, e);
}

# √x, rounded to 53 bits with an unbounded exponent: √s·2^(e/2), or √(2s)·2^((e − 1)/2) for an odd e (2s exact).
# ±0, a negative x, ±∞ and NaN as IEEE's √ (√−0 = −0).
#must_use
fn _bj_k_ux_sqrt(xs: f64, xe): (f64, i64) {
    if (xs <= 0.0 || xs != xs || xs == _BJ_K_INF) {
        var z: f64 = f64_sqrt(xs);
        return (z, 0);
    }
    var odd = xe & 1;
    var w: f64 = xs;
    if (odd != 0) { w = xs * 2.0; }
    var r: f64 = f64_sqrt(w);
    var s, e = _bj_k_ux_norm(r, (xe - odd) / 2);
    return (s, e);
}

# x + y, rounded to 53 bits with an unbounded exponent (the section comment's argument). A zero operand contributes
# nothing (x + ±0 = x); two zeros, or a special, add as IEEE's significands do.
#must_use
fn _bj_k_ux_add(xs: f64, xe, ys: f64, ye): (f64, i64) {
    var dx: f64 = xs - xs;
    var dy: f64 = ys - ys;
    if (xs == 0.0 || ys == 0.0 || dx != 0.0 || dy != 0.0) {
        if (ys == 0.0 && xs != 0.0 && dx == 0.0) { return (xs, xe); }
        if (xs == 0.0 && ys != 0.0 && dy == 0.0) { return (ys, ye); }
        var z: f64 = xs + ys;
        return (z, 0);
    }
    var hs: f64 = xs;
    var he = xe;
    var ls: f64 = ys;
    var le = ye;
    if (ye > xe) {
        hs = ys;
        he = ye;
        ls = xs;
        le = xe;
    }
    var d = he - le;
    if (d > 55) { return (hs, he); }
    var sc: f64 = _bj_k_cr_pow2(0 - d);
    var t: f64 = ls * sc;                           # exact: at least 2^-55
    var r: f64 = hs + t;
    var s, e = _bj_k_ux_norm(r, he);
    return (s, e);
}

# x − y, rounded to 53 bits with an unbounded exponent: x + (−y) (IEEE's x − y, signed zeros included).
#must_use
fn _bj_k_ux_sub(xs: f64, xe, ys: f64, ye): (f64, i64) {
    var ny: f64 = -ys;
    var s, e = _bj_k_ux_add(xs, xe, ny, ye);
    return (s, e);
}

# −1, 0 or 1 as x <, =, > y in exact value; 2 when either is NaN. Zeros are equal whatever their signs.
#must_use
fn _bj_k_ux_cmp(xs: f64, xe, ys: f64, ye): i64 {
    if (xs != xs || ys != ys) { return 2; }
    var dx: f64 = xs - xs;
    var dy: f64 = ys - ys;
    if (xs == 0.0 || ys == 0.0 || dx != 0.0 || dy != 0.0) {
        # a zero or ±∞ against anything: the significands order the values (a finite nonzero one is 1 ≤ |s| < 2)
        if (xs < ys) { return 0 - 1; }
        if (xs > ys) { return 1; }
        return 0;
    }
    if ((xs < 0.0) != (ys < 0.0)) {
        if (xs < 0.0) { return 0 - 1; }
        return 1;
    }
    if (xe == ye) {
        if (xs < ys) { return 0 - 1; }
        if (xs > ys) { return 1; }
        return 0;
    }
    var c = 1;
    if (xe < ye) { c = 0 - 1; }
    if (xs < 0.0) { c = 0 - c; }
    return c;
}

# 1 if x ≤ y (false for a NaN), as f64's `<=` on the exact values.
#must_use
fn _bj_k_ux_le(xs: f64, xe, ys: f64, ye): i64 {
    var c = _bj_k_ux_cmp(xs, xe, ys, ye);
    if (c == 0 - 1 || c == 0) { return 1; }
    return 0;
}

# Rust's x.max(y) on the exact values (_bj_k_max's semantics): a NaN operand is ignored, equal operands give y.
#must_use
fn _bj_k_ux_max(xs: f64, xe, ys: f64, ye): (f64, i64) {
    if (xs != xs) { return (ys, ye); }
    if (ys != ys) { return (xs, xe); }
    if (_bj_k_ux_cmp(xs, xe, ys, ye) == 1) { return (xs, xe); }
    return (ys, ye);
}

# 1 if 0 < x < +∞ (validate.cyr's _bj_k_is_positive on the exact value): a normalised value's sign and class are its
# significand's.
#must_use
fn _bj_k_ux_is_positive(xs: f64, xe): i64 {
    if (xs > 0.0 && xs < _BJ_K_INF) { return 1; }
    return 0;
}

# 1 if the double x is the 53-bit rounding of an exact value in binary64's normal range, by its magnitude alone: |x| in
# [2⁻¹⁰²¹, DBL_MAX]. An IEEE product, quotient or square root that large has an exact value above 2⁻¹⁰²² (RN is
# monotone: below 2⁻¹⁰²² it rounds to at most 2⁻¹⁰²²), where binary64's rounding is the 53-bit one, and a finite one is
# not past DBL_MAX (IEEE overflow is the 53-bit rounding past it). 2⁻¹⁰²² itself is excluded: a value just below it
# rounds there at the subnormal grid but below it at 53 bits. The fast-path range tests of the overflow audit's
# #20-style functions (B3: gas, potential, inorganic) use it.
#must_use
fn _bj_k_ux_normal(x: f64): i64 {
    var u = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (u < 0x0020000000000000 || u > 0x7FEFFFFFFFFFFFFF) { return 0; }
    return 1;
}

# RN((s + t)·2^e) in binary64, rounded once, for a normalised s with s = RN53(s + t) (|t| at most half an ulp of s: t
# is the exact error of the operation that produced s, or 0 for an exact value): s·2^e itself when it is normal
# (2^-1022 ≤ |s·2^e|, e ≤ 1023); ±∞ past e = 1023; at the 2^-1074 grid by _bj_k_cr_finish (|s| + ±t, scaled once) below
# 2^-1022, where t breaks a midpoint s·2^e toward the exact value (the section comment); ±0 below 2^-1100 (under a
# quarter of 2^-1074). A zero or a special s is returned as it is.
#must_use
fn _bj_k_ux_round(s: f64, e, t: f64): f64 {
    var ds: f64 = s - s;
    if (s == 0.0 || ds != 0.0) { return s; }
    if (e > 1023) {
        var inf: f64 = _BJ_K_INF;
        if (s < 0.0) { inf = -inf; }
        return inf;
    }
    if (e >= 0 - 1022) {
        var sc: f64 = _bj_k_cr_pow2(e);
        var y: f64 = s * sc;
        return y;
    }
    if (e < 0 - 1100) {
        var z: f64 = s * 0.0;
        return z;
    }
    var h: f64 = s;
    var m: f64 = t;
    if (s < 0.0) {
        h = -s;
        m = -t;
    }
    var r: f64 = _bj_k_cr_finish(e, h, m, 0.0);
    if (s < 0.0) { r = -r; }
    return r;
}

# RN(x·y) in binary64, rounded once: the 53-bit product (TwoProduct of the significands, its exact error), then
# _bj_k_ux_round. A zero or special operand gives IEEE's product of the significands.
#must_use
fn _bj_k_ux_mul_f64(xs: f64, xe, ys: f64, ye): f64 {
    var p: f64 = xs * ys;
    var dp: f64 = p - p;
    if (p == 0.0 || dp != 0.0) { return p; }
    var ph, pe = _bj_k_two_prod(xs, ys);
    var e = xe + ye;
    if (ph >= 2.0 || ph <= -2.0) {
        ph = ph * 0.5;
        pe = pe * 0.5;
        e = e + 1;
    }
    var r: f64 = _bj_k_ux_round(ph, e, pe);
    return r;
}

# RN(x/y) in binary64, rounded once: q = RN(s₁/s₂), the remainder s₁ − q·s₂ (s₁ − p exact by Sterbenz, p = RN(q·s₂),
# then − pe: the sign is exact), its quotient by s₂ as the error, then _bj_k_ux_round. A zero dividend, a zero divisor
# or a special gives IEEE's quotient of the significands.
#must_use
fn _bj_k_ux_div_f64(xs: f64, xe, ys: f64, ye): f64 {
    var q: f64 = xs / ys;
    var dq: f64 = q - q;
    var dy: f64 = ys - ys;
    if (q == 0.0 || dq != 0.0 || dy != 0.0) { return q; }
    var p, pe = _bj_k_two_prod(q, ys);
    var rem: f64 = (xs - p) - pe;
    var t: f64 = rem / ys;
    var e = xe - ye;
    if (q < 1.0 && q > -1.0) {
        q = q * 2.0;
        t = t * 2.0;
        e = e - 1;
    }
    var r: f64 = _bj_k_ux_round(q, e, t);
    return r;
}

# RN(x + y) in binary64, rounded once: TwoSum of the aligned significands (d ≤ 55), its sum renormalised with its error;
# for d ≥ 56 the larger term with a sticky ±2^-60 in the smaller's direction (below a quarter ulp, so it moves only a
# midpoint, which is where the exact sum's side matters). A zero operand gives the other rounded once; two zeros or a
# special, IEEE's sum.
#must_use
fn _bj_k_ux_add_f64(xs: f64, xe, ys: f64, ye): f64 {
    var dx: f64 = xs - xs;
    var dy: f64 = ys - ys;
    if (dx != 0.0 || dy != 0.0 || (xs == 0.0 && ys == 0.0)) {
        var z: f64 = xs + ys;
        return z;
    }
    if (xs == 0.0) {
        var ry: f64 = _bj_k_ux_round(ys, ye, 0.0);
        return ry;
    }
    if (ys == 0.0) {
        var rx: f64 = _bj_k_ux_round(xs, xe, 0.0);
        return rx;
    }
    var hs: f64 = xs;
    var he = xe;
    var ls: f64 = ys;
    var le = ye;
    if (ye > xe) {
        hs = ys;
        he = ye;
        ls = xs;
        le = xe;
    }
    var d = he - le;
    if (d > 55) {
        var st: f64 = 0x3C30000000000000;           # 2^-60
        if (ls < 0.0) { st = -st; }
        var rs: f64 = _bj_k_ux_round(hs, he, st);
        return rs;
    }
    var sc: f64 = _bj_k_cr_pow2(0 - d);
    var t: f64 = ls * sc;                           # exact
    var r, err = _bj_k_two_sum(hs, t);
    if (r == 0.0) { return r; }                     # an exact cancellation: +0
    var s, e = _bj_k_ux_norm(r, he);
    var k = e - he;                                 # r = s·2^k, −107 ≤ k ≤ 1
    var ks: f64 = _bj_k_cr_pow2(0 - k);
    var te: f64 = err * ks;                         # exact (err is a multiple of 2^-107)
    var y: f64 = _bj_k_ux_round(s, e, te);
    return y;
}

# RN(x − y) in binary64, rounded once.
#must_use
fn _bj_k_ux_sub_f64(xs: f64, xe, ys: f64, ye): f64 {
    var ny: f64 = -ys;
    var r: f64 = _bj_k_ux_add_f64(xs, xe, ny, ye);
    return r;
}

# RN(√x) in binary64, rounded once: r = RN(√w) (w = s or 2s, in [1, 4)), the residual w − r² (r² = p + pe by
# TwoProduct, w − p exact by Sterbenz, then − pe: its sign is exact), its quotient by 2r as the error, then
# _bj_k_ux_round. √x is either exact (a 27-bit significand) or irrational, so a midpoint is only ever an exact one,
# broken to even. ±0, a negative x, ±∞ and NaN as IEEE's √.
#must_use
fn _bj_k_ux_sqrt_f64(xs: f64, xe): f64 {
    if (xs <= 0.0 || xs != xs || xs == _BJ_K_INF) {
        var z: f64 = f64_sqrt(xs);
        return z;
    }
    var odd = xe & 1;
    var w: f64 = xs;
    if (odd != 0) { w = xs * 2.0; }
    var r: f64 = f64_sqrt(w);
    var p, pe = _bj_k_two_prod(r, r);
    var rem: f64 = (w - p) - pe;
    var tr: f64 = r + r;
    var t: f64 = rem / tr;
    var k = (xe - odd) / 2;
    if (r >= 2.0) {                                 # √w rounded up to 2: (1, k + 1)
        r = r * 0.5;
        t = t * 0.5;
        k = k + 1;
    }
    var y: f64 = _bj_k_ux_round(r, k, t);
    return y;
}

# ── exact rationals rounded once (M4e-3): ADR 0002 #21, #22 ──────────────────────────────────────────────────

# The capacity of a multi-word integer, in 32-bit limbs (8: below 2^256, 64 bytes).
const _BJ_K_BN_LIMBS = 8;

# a = v, for v a 64-bit word read as unsigned (the other limbs cleared).
fn _bj_k_bn_set(a, v) {
    store64(a, v & 0xFFFFFFFF);
    store64(a + 8, v >> 32);
    var k = 2;
    while (k < _BJ_K_BN_LIMBS) {
        store64(a + 8 * k, 0);
        k = k + 1;
    }
    return 0;
}

# a = b.
fn _bj_k_bn_copy(a, b) {
    var k = 0;
    while (k < _BJ_K_BN_LIMBS) {
        store64(a + 8 * k, load64(b + 8 * k));
        k = k + 1;
    }
    return 0;
}

# The bit length of a (0 for zero).
#must_use
fn _bj_k_bn_bitlen(a): i64 {
    var k = _BJ_K_BN_LIMBS - 1;
    while (k >= 0) {
        var w = load64(a + 8 * k);
        if (w != 0) {
            var b = 0;
            while (w != 0) {
                w = w >> 1;
                b = b + 1;
            }
            return 32 * k + b;
        }
        k = k - 1;
    }
    return 0;
}

# −1, 0 or 1 as a <, =, > b.
#must_use
fn _bj_k_bn_cmp(a, b): i64 {
    var k = _BJ_K_BN_LIMBS - 1;
    while (k >= 0) {
        var x = load64(a + 8 * k);
        var y = load64(b + 8 * k);
        if (x < y) { return 0 - 1; }
        if (x > y) { return 1; }
        k = k - 1;
    }
    return 0;
}

# r = a + b (r may be a or b); the sum must be below 2^256.
fn _bj_k_bn_add(r, a, b) {
    var c = 0;
    var k = 0;
    while (k < _BJ_K_BN_LIMBS) {
        var s = load64(a + 8 * k) + load64(b + 8 * k) + c;
        store64(r + 8 * k, s & 0xFFFFFFFF);
        c = s >> 32;
        k = k + 1;
    }
    return 0;
}

# r = a − b, for a ≥ b (r may be a or b).
fn _bj_k_bn_sub(r, a, b) {
    var borrow = 0;
    var k = 0;
    while (k < _BJ_K_BN_LIMBS) {
        var d = load64(a + 8 * k) - load64(b + 8 * k) - borrow;
        borrow = 0;
        if (d < 0) {
            d = d + 0x100000000;
            borrow = 1;
        }
        store64(r + 8 * k, d);
        k = k + 1;
    }
    return 0;
}

# a = a·m in place, for 0 ≤ m < 2^32; the product must be below 2^256. Each limb·m + carry is below 2^64.
fn _bj_k_bn_mul_small(a, m) {
    var c = 0;
    var k = 0;
    while (k < _BJ_K_BN_LIMBS) {
        var t = load64(a + 8 * k) * m + c;
        store64(a + 8 * k, t & 0xFFFFFFFF);
        c = t >> 32;
        k = k + 1;
    }
    return 0;
}

# r = a·b, schoolbook on the limbs, r distinct from a and b; the product must be below 2^256. Each limb product plus
# the partial limb and the carry is below 2^64.
fn _bj_k_bn_mul(r, a, b) {
    var k = 0;
    while (k < _BJ_K_BN_LIMBS) {
        store64(r + 8 * k, 0);
        k = k + 1;
    }
    var la = (_bj_k_bn_bitlen(a) + 31) / 32;
    var lb = (_bj_k_bn_bitlen(b) + 31) / 32;
    var i = 0;
    while (i < la) {
        var ai = load64(a + 8 * i);
        var c = 0;
        var j = 0;
        while (j < lb && i + j < _BJ_K_BN_LIMBS) {
            var t = ai * load64(b + 8 * j) + load64(r + 8 * (i + j)) + c;
            store64(r + 8 * (i + j), t & 0xFFFFFFFF);
            c = t >> 32;
            j = j + 1;
        }
        if (i + lb < _BJ_K_BN_LIMBS) { store64(r + 8 * (i + lb), c); }
        i = i + 1;
    }
    return 0;
}

# a = a·2^s in place, for s ≥ 0; the result must be below 2^256.
fn _bj_k_bn_shl(a, s) {
    var w = s / 32;
    var b = s - 32 * w;
    var k = _BJ_K_BN_LIMBS - 1;
    while (k >= 0) {
        var v = 0;
        if (k - w >= 0) {
            v = (load64(a + 8 * (k - w)) << b) & 0xFFFFFFFF;
            if (b > 0 && k - w - 1 >= 0) { v = v | (load64(a + 8 * (k - w - 1)) >> (32 - b)); }
        }
        store64(a + 8 * k, v);
        k = k - 1;
    }
    return 0;
}

# (M, E) with x = M·2^E and 2^52 ≤ M < 2^53 for the bits b of a positive finite nonzero double (a subnormal's
# significand shifted up, E below −1074).
#must_use
fn _bj_k_f64_int(b): (i64, i64) {
    var be = b >> 52;
    var m = b & 0x000FFFFFFFFFFFFF;
    if (be != 0) { return (m | 0x0010000000000000, be - 1075); }
    var e = 0 - 1074;
    while (m < 0x0010000000000000) {
        m = m << 1;
        e = e - 1;
    }
    return (m, e);
}

# RN(p/q·2^e) in binary64, rounded once, for multi-word integers 0 ≤ p < 2^254 and 1 ≤ q < 2^254 and |e| < 2^39 (the
# section comment): exact, ties to even, subnormal results on the 2^-1074 grid, +∞ past DBL_MAX, +0 for p = 0 and below
# half of 2^-1074. p and q are not changed.
#must_use
fn _bj_k_cr_ratio(p, q, e): f64 {
    var bp = _bj_k_bn_bitlen(p);
    if (bp == 0) { return 0.0; }
    var bq = _bj_k_bn_bitlen(q);
    var nb[64];
    var db[64];
    var tb[64];
    _bj_k_bn_copy(&nb, p);
    _bj_k_bn_copy(&db, q);
    var t = bp - bq;
    var ll = bp;
    if (t >= 0) {
        _bj_k_bn_shl(&db, t);
    } else {
        _bj_k_bn_shl(&nb, 0 - t);
        ll = bq;
    }
    if (_bj_k_bn_cmp(&nb, &db) < 0) {
        _bj_k_bn_shl(&nb, 1);
        t = t - 1;
    }
    var n = (ll + 32) / 32;                         # the limbs of L + 1 bits: N < 2D throughout
    var np = &nb;
    var tp = &tb;
    var qq = 0;
    var i = 0;
    while (i < 55) {
        var borrow = 0;                             # T = N − D, kept when it does not borrow
        var k = 0;
        while (k < n) {
            var d = load64(np + 8 * k) - load64(&db + 8 * k) - borrow;
            borrow = 0;
            if (d < 0) {
                d = d + 0x100000000;
                borrow = 1;
            }
            store64(tp + 8 * k, d);
            k = k + 1;
        }
        qq = qq << 1;
        if (borrow == 0) {
            var sw = np;
            np = tp;
            tp = sw;
            qq = qq + 1;
        }
        var c = 0;                                  # N = 2N
        k = 0;
        while (k < n) {
            var w = load64(np + 8 * k);
            store64(np + 8 * k, ((w << 1) | c) & 0xFFFFFFFF);
            c = w >> 31;
            k = k + 1;
        }
        i = i + 1;
    }
    var sticky = 0;
    var j = 0;
    while (j < n) {
        if (load64(np + 8 * j) != 0) { sticky = 1; }
        j = j + 1;
    }
    var r: f64 = _bj_k_cr_from_int(2 * qq + sticky, e + t - 55);
    return r;
}

# (a_h + a_l)·(b_h + b_l) as a normalised double-double (h, l): TwoProduct of the heads (p + e exactly), the cross terms
# a_h·b_l + a_l·b_h rounded, a_l·b_l dropped, e + c rounded, FastTwoSum (exact, |p| ≥ |e + c|). For normalised inputs
# (|a_l| ≤ 2^-53·|a_h|, likewise b) with |a_h|, |b_h| < 2^996 and |a_h·b_h| ≥ 2^-900 (TwoProduct's conditions, every
# term normal): h + l = (a_h + a_l)(b_h + b_l)(1 + δ) with |δ| ≤ 8.01·2^-106 < 2^-102.99 (with u = 2^-53 and
# P = |a_h·b_h|: the two cross products' roundings u²·P each, their sum's 2u²·P, e + c's 3u²·P, the dropped term u²·P,
# so 8u²(1 + u)·P, and P ≤ |product|/(1 − u)²), |l| ≤ 2^-53·|h|.
#must_use
fn _bj_k_dd_mul(ah: f64, al: f64, bh: f64, bl: f64): (f64, f64) {
    var p, e = _bj_k_two_prod(ah, bh);
    var c: f64 = (ah * bl) + (al * bh);
    var t: f64 = e + c;
    var h, l = _bj_k_fast_two_sum(p, t);
    return (h, l);
}

# (RN(n/d), 1) for the double-double quotient n/d = (n_h + n_l)/(d_h + d_l) of an exact positive value v, or (0, 0) when
# the rounding test fails. n and d are normalised (|n_l| ≤ 2^-53·n_h, likewise d), n_h, d_h and n_h/d_h in
# [2^-900, 2^900], and they may carry relative errors δn, δd (n = N(1 + δn), d = D(1 + δd), v = N/D) with
# |δn| + |δd| ≤ 32u², u = 2^-53. y0 = RN(n_h/d_h); y0·d_h = a + b (TwoProduct); n_h − a is exact (Sterbenz: a is within
# 2u of n_h); r = (((n_h − a) − b) + n_l) − y0·d_l is n − y0·d to 7.04u²·n (four roundings: u²·n_h, 2.01u², 1.01u² and
# 3.01u² of n_h); d = RN(r/d_h) (|r| ≤ 3.02u·n, and r/d_h is r/d to 2.01u, so d is r/d to 6.08u²·v); so y0 + d is n/d to
# 13.12u², and v to 13.12u² + 32.01u² = 45.13u². The test: ε = 2^-100·y0 = 64u²·y0 ≥ 63.9u²·v; RN(d ∓ ε) are d ∓ ε to
# 3.04u²·v, so y0 + RN(d − ε) < v < y0 + RN(d + ε), and when the two sums round to the same double, RN being monotone,
# v rounds to it: exact values (half an ulp from every boundary) pass, a midpoint never does. It fails with probability
# about 2^-46 (v within 2^-99 of a midpoint, relative).
#must_use
fn _bj_k_dd_div_cr(nh: f64, nl: f64, dh: f64, dl: f64): (f64, i64) {
    var y0: f64 = nh / dh;
    var a: f64 = y0 * dh;                           # y0·d_h = a + b: TwoProduct, inline (Veltkamp's 2^27 + 1 split)
    var sp: f64 = 134217729.0;
    var cy: f64 = sp * y0;
    var yh: f64 = cy - (cy - y0);
    var yl: f64 = y0 - yh;
    var cd: f64 = sp * dh;
    var dhh: f64 = cd - (cd - dh);
    var dhl: f64 = dh - dhh;
    var b: f64 = (yl * dhl) - (((a - (yh * dhh)) - (yl * dhh)) - (yh * dhl));
    var s: f64 = nh - a;
    var s1: f64 = s - b;
    var s2: f64 = s1 + nl;
    var s3: f64 = y0 * dl;
    var r: f64 = s2 - s3;
    var d: f64 = r / dh;
    var k100: f64 = 0x39B0000000000000;             # 2^-100
    var eps: f64 = y0 * k100;
    var lo: f64 = d - eps;
    var hi: f64 = d + eps;
    var z1: f64 = y0 + lo;
    var z2: f64 = y0 + hi;
    if (z1 != z2) { return (0.0, 0); }
    return (z1, 1);
}

# ── correctly rounded monomials (the overflow audit's B1, B2): ADR 0002 #27 … #30 ────────────────────────────────────

# The factor limits (the fast path's error budget above, the significand tables below).
const _BJ_K_MONO_NMAX = 6;

const _BJ_K_MONO_DMAX = 4;

# (a_h + a_l)·b as a normalised double-double (h, l), for a normalised a (|a_l| ≤ u·|a_h|, u = 2⁻⁵³) and a double b with
# |a_h|, |b| < 2⁹⁹⁶ and |a_h·b| ≥ 2⁻⁹⁰⁰ (TwoProduct's conditions): a_h·b = p + e exactly; c = RN(a_l·b), within
# u·|a_l·b| ≤ u²·P (P = |a_h·b|); t = RN(e + c), within 2u²(1 + u)·P (|e| ≤ u·|p| and |c| ≤ u(1 + u)·P);
# FastTwoSum(p, t) exact (|t| ≤ 2.01u·|p|). So h + l = a·b + δ with |δ| ≤ (3 + 2u)u²·P ≤ 3.01u²·|a·b|
# (P ≤ |a·b|/(1 − u)), and |l| ≤ u·|h|.
#must_use
fn _bj_k_dd_mul_d(ah: f64, al: f64, b: f64): (f64, f64) {
    var p: f64 = ah * b;                            # a_h·b = p + e: TwoProduct, inline (Veltkamp's 2^27 + 1 split)
    var sp: f64 = 134217729.0;
    var ca: f64 = sp * ah;
    var ahh: f64 = ca - (ca - ah);
    var ahl: f64 = ah - ahh;
    var cb: f64 = sp * b;
    var bh: f64 = cb - (cb - b);
    var bl: f64 = b - bh;
    var e: f64 = (ahl * bl) - (((p - (ahh * bh)) - (ahl * bh)) - (ahh * bl));
    var c: f64 = al * b;
    var t: f64 = e + c;
    var h: f64 = p + t;                             # FastTwoSum(p, t), inline
    var l: f64 = t - (h - p);
    return (h, l);
}

# _bj_k_dd_div_cr's steps without the verdict: (z₁, z₂) = (RN(y₀ + RN(d − ε)), RN(y₀ + RN(d + ε))) for the quotient n/d
# of normalised double-doubles under _bj_k_dd_div_cr's conditions, whose proof gives y₀ + RN(d − ε) < v < y₀ + RN(d + ε)
# for the exact value v: z₁ = z₂ is RN(v), and otherwise v lies strictly between two points within 2⁻⁹⁸·v of each other
# that round to z₁ and z₂.
#must_use
fn _bj_k_dd_div_ends(nh: f64, nl: f64, dh: f64, dl: f64): (f64, f64) {
    var y0: f64 = nh / dh;
    var a: f64 = y0 * dh;                           # y0·d_h = a + b: TwoProduct, inline (Veltkamp's 2^27 + 1 split)
    var sp: f64 = 134217729.0;
    var cy: f64 = sp * y0;
    var yh: f64 = cy - (cy - y0);
    var yl: f64 = y0 - yh;
    var cd: f64 = sp * dh;
    var dhh: f64 = cd - (cd - dh);
    var dhl: f64 = dh - dhh;
    var b: f64 = (yl * dhl) - (((a - (yh * dhh)) - (yl * dhh)) - (yh * dhl));
    var s: f64 = nh - a;
    var s1: f64 = s - b;
    var s2: f64 = s1 + nl;
    var s3: f64 = y0 * dl;
    var r: f64 = s2 - s3;
    var d: f64 = r / dh;
    var k100: f64 = 0x39B0000000000000;             # 2^-100
    var eps: f64 = y0 * k100;
    var lo: f64 = d - eps;
    var hi: f64 = d + eps;
    var z1: f64 = y0 + lo;
    var z2: f64 = y0 + hi;
    return (z1, z2);
}

# The sign (−1, 0 or 1) of the exact sum of the n doubles at p (finite, every partial sum far below DBL_MAX; n ≤ 16), by
# Shewchuk's Grow-Expansion with zero elimination ("Adaptive Precision Floating-Point Arithmetic and Fast Robust
# Geometric Predicates", Discrete Comput. Geom. 18 (1997), Theorem 10): each term is added to a nonoverlapping expansion
# kept in increasing magnitude by a chain of TwoSums (Knuth's, inline), which keeps it nonoverlapping and its sum exact;
# zero components are dropped. Each nonzero component then exceeds the sum of all smaller ones in magnitude, so the
# largest one's sign is the sum's, and an empty expansion is the sum 0.
#must_use
fn _bj_k_exp_sign(p, n): i64 {
    var ex: f64[16];
    var m = 0;
    var i = 0;
    while (i < n) {
        var q: f64 = load64(p + 8 * i);
        var j = 0;
        var w = 0;
        while (j < m) {
            var ej: f64 = load64(&ex + 8 * j);
            var s: f64 = q + ej;
            var bb: f64 = s - q;
            var er: f64 = (q - (s - bb)) + (ej - bb);
            if (er != 0.0) {
                store64(&ex + 8 * w, er);
                w = w + 1;
            }
            q = s;
            j = j + 1;
        }
        if (q != 0.0) {
            store64(&ex + 8 * w, q);
            w = w + 1;
        }
        m = w;
        i = i + 1;
    }
    if (m == 0) { return 0; }
    var top: f64 = load64(&ex + 8 * (m - 1));
    if (top > 0.0) { return 1; }
    return 0 - 1;
}

# For the n doubles at p: (g + 2·f, c, e) with g the xor of their sign bits, f = 1 if one is ±0 or 2 if one is not
# finite (else 0), c the count of significands other than 1, stored at out as f64 words in [1, 2), and e the sum of
# their exponents. A subnormal is first scaled by 2⁵⁴ (exactly).
#must_use
fn _bj_k_mono_sig(p, n, out): (i64, i64, i64) {
    var sg = 0;
    var flag = 0;
    var c = 0;
    var e = 0;
    var i = 0;
    while (i < n) {
        var b = load64(p + 8 * i);
        sg = sg ^ (b >> 63);
        var a = b & 0x7FFFFFFFFFFFFFFF;
        var be = a >> 52;
        if (be == 0x7FF) {
            flag = 2;
        } elif (a == 0) {
            if (flag == 0) { flag = 1; }
        } else {
            if (be == 0) {
                var xs: f64 = a;
                var p54: f64 = 0x4350000000000000;  # 2^54
                var ys: f64 = xs * p54;
                a = _bj_k_bits(ys);
                be = (a >> 52) - 54;
            }
            e = e + be - 1023;
            var m = a & 0x000FFFFFFFFFFFFF;
            if (m != 0) {
                store64(out + 8 * c, m | 0x3FF0000000000000);
                c = c + 1;
            }
        }
        i = i + 1;
    }
    return (sg + 2 * flag, c, e);
}

# The product of the c significands at s (in [1, 2) each) as a normalised double-double: 1, the one factor, an exact
# TwoProduct, then _bj_k_dd_mul_d per further factor.
#must_use
fn _bj_k_mono_prod(s, c): (f64, f64) {
    if (c == 0) { return (1.0, 0.0); }
    var h: f64 = load64(s);
    var l: f64 = 0.0;
    if (c == 1) { return (h, l); }
    var s1: f64 = load64(s + 8);
    var ph, pl = _bj_k_two_prod(h, s1);
    h = ph;
    l = pl;
    var i = 2;
    while (i < c) {
        var si: f64 = load64(s + 8 * i);
        var qh, ql = _bj_k_dd_mul_d(h, l, si);
        h = qh;
        l = ql;
        i = i + 1;
    }
    return (h, l);
}

# RN(F) for F = N/D (the cn significands at sn, the cd at sd; cn ≤ 3, cd ≤ 2) where the rounding test left the adjacent
# doubles z₁ < z₂ with their midpoint μ the one boundary between (the section comment): the sign of N − D·μ, an exact
# sum of doubles — N exactly (1, s₀, p_h + p_l, or the TwoProducts p_h·s₂ and p_l·s₂: s₀s₁ = p_h + p_l, every product of
# numbers in [2⁻¹⁰⁴, 8) with an error far above the subnormal range), and −D·μ = −Σ (dⱼ·z₁ + dⱼ·(u/2)) with
# D = d₀ (+ d₁) exactly, dⱼ·z₁ TwoProducts and dⱼ·(u/2) exact (u = z₂ − z₁ is exact by Sterbenz, a power of two at least
# 2⁻⁵⁸) — by _bj_k_exp_sign. D > 0, so F > μ gives z₂, F < μ gives z₁, and F = μ the even one.
#must_use
fn _bj_k_mono_tie(sn, cn, sd, cd, z1: f64, z2: f64): f64 {
    var tb: f64[10];
    var nt = 1;
    if (cn == 0) {
        var one: f64 = 1.0;
        store64(&tb, one);
    } elif (cn == 1) {
        store64(&tb, load64(sn));
    } else {
        var s0: f64 = load64(sn);
        var s1: f64 = load64(sn + 8);
        var ph, pl = _bj_k_two_prod(s0, s1);
        if (cn == 2) {
            store64(&tb, ph);
            store64(&tb + 8, pl);
            nt = 2;
        } else {
            var s2: f64 = load64(sn + 16);
            var a, b = _bj_k_two_prod(ph, s2);
            var c, d = _bj_k_two_prod(pl, s2);
            store64(&tb, a);
            store64(&tb + 8, b);
            store64(&tb + 16, c);
            store64(&tb + 24, d);
            nt = 4;
        }
    }
    var d0: f64 = 1.0;
    var d1: f64 = 0.0;
    if (cd >= 1) { d0 = load64(sd); }
    if (cd == 2) {
        var t1: f64 = load64(sd + 8);
        var qh, ql = _bj_k_two_prod(d0, t1);
        d0 = qh;
        d1 = ql;
    }
    var u: f64 = z2 - z1;
    var hu: f64 = u * 0.5;
    var a0, b0 = _bj_k_two_prod(d0, z1);
    var h0: f64 = d0 * hu;
    var na0: f64 = -a0;
    var nb0: f64 = -b0;
    var nh0: f64 = -h0;
    store64(&tb + 8 * nt, na0);
    store64(&tb + 8 * nt + 8, nb0);
    store64(&tb + 8 * nt + 16, nh0);
    nt = nt + 3;
    if (d1 != 0.0) {
        var a1, b1 = _bj_k_two_prod(d1, z1);
        var h1: f64 = d1 * hu;
        var na1: f64 = -a1;
        var nb1: f64 = -b1;
        var nh1: f64 = -h1;
        store64(&tb + 8 * nt, na1);
        store64(&tb + 8 * nt + 8, nb1);
        store64(&tb + 8 * nt + 16, nh1);
        nt = nt + 3;
    }
    var sg = _bj_k_exp_sign(&tb, nt);
    if (sg > 0) { return z2; }
    if (sg < 0) { return z1; }
    if ((_bj_k_bits(z1) & 1) == 0) { return z1; }
    return z2;
}

# RN(Π num / Π den) by the fast path (the section comment), for the nn doubles at num and the nd at den: (RN, 1), or
# (0, 0) when the result may be subnormal or the rounding test fails beyond _bj_k_mono_tie's shapes. NaN (with 1)
# outside the domain: more than _BJ_K_MONO_NMAX or _BJ_K_MONO_DMAX factors, a non-finite factor, a zero denominator
# factor.
#must_use
fn _bj_k_cr_mono_fast(num, nn, den, nd): (f64, i64) {
    if (nn < 0 || nd < 0 || nn > _BJ_K_MONO_NMAX || nd > _BJ_K_MONO_DMAX) {
        var nan0: f64 = _bj_k_nan();
        return (nan0, 1);
    }
    var sn: f64[6];
    var sd: f64[4];
    var gfn, cn, en = _bj_k_mono_sig(num, nn, &sn);
    var gfd, cd, ed = _bj_k_mono_sig(den, nd, &sd);
    if ((gfn >> 1) == 2 || (gfd >> 1) != 0) {
        var nan1: f64 = _bj_k_nan();
        return (nan1, 1);
    }
    var neg = (gfn ^ gfd) & 1;
    if ((gfn >> 1) == 1) {
        var z: f64 = 0.0;
        if (neg == 1) { z = -z; }
        return (z, 1);
    }
    var nh, nl = _bj_k_mono_prod(&sn, cn);
    var dh, dl = _bj_k_mono_prod(&sd, cd);
    var z1, z2 = _bj_k_dd_div_ends(nh, nl, dh, dl);
    var y: f64 = z1;
    if (z1 != z2) {
        if (cn > 3 || cd > 2) { return (0.0, 0); }
        y = _bj_k_mono_tie(&sn, cn, &sd, cd, z1, z2);
    }
    var k = en - ed;
    var yb = _bj_k_bits(y);
    var kk = k + (yb >> 52) - 1023;                # K = k + e_y
    if (kk > 1023) {
        var inf: f64 = _BJ_K_INF;
        if (neg == 1) { inf = -inf; }
        return (inf, 1);
    }
    if (kk < 0 - 1075) {
        var zu: f64 = 0.0;
        if (neg == 1) { zu = -zu; }
        return (zu, 1);
    }
    if (kk < 0 - 1021) { return (0.0, 0); }
    var rb = yb + (k << 52);                        # the exponent field + k, in 2 … 2046
    if (neg == 1) { rb = rb | 0x8000000000000000; }
    var r: f64 = rb;
    return (r, 1);
}

# RN(Π num / Π den) by the exact path alone (the section comment), for every argument of the domain; NaN outside it (as
# _bj_k_cr_mono_fast, and past the 253-bit capacity).
#must_use
fn _bj_k_cr_mono_acc(num, nn, den, nd): f64 {
    var nan: f64 = _bj_k_nan();
    if (nn < 0 || nd < 0 || nn > _BJ_K_MONO_NMAX || nd > _BJ_K_MONO_DMAX) { return nan; }
    var pb[64];
    var qb[64];
    var tb[64];
    var rb[64];
    var neg = 0;
    var zero = 0;
    var ee = 0;
    var side = 0;
    while (side < 2) {
        var p = num;
        var n = nn;
        var acc = &pb;
        if (side == 1) {
            p = den;
            n = nd;
            acc = &qb;
        }
        _bj_k_bn_set(acc, 1);
        var bits = 0;
        var i = 0;
        while (i < n) {
            var b = load64(p + 8 * i);
            neg = neg ^ (b >> 63);
            var a = b & 0x7FFFFFFFFFFFFFFF;
            if ((a >> 52) == 0x7FF) { return nan; }
            if (a == 0) {
                if (side == 1) { return nan; }
                zero = 1;
            } else {
                var mm, e = _bj_k_f64_int(a);
                while ((mm & 1) == 0) {
                    mm = mm >> 1;
                    e = e + 1;
                }
                var t = mm;
                while (t != 0) {
                    t = t >> 1;
                    bits = bits + 1;
                }
                if (side == 0) { ee = ee + e; } else { ee = ee - e; }
                _bj_k_bn_set(&tb, mm);
                _bj_k_bn_mul(&rb, acc, &tb);
                _bj_k_bn_copy(acc, &rb);
            }
            i = i + 1;
        }
        if (bits > 253) { return nan; }
        side = side + 1;
    }
    var r: f64 = 0.0;
    if (zero == 0) { r = _bj_k_cr_ratio(&pb, &qb, ee); }
    if (neg == 1) { r = -r; }
    return r;
}

# RN(Π num / Π den), correctly rounded (the section comment): the fast path, then the exact path where it declines.
#must_use
fn _bj_k_cr_mono(num, nn, den, nd): f64 {
    var r, ok = _bj_k_cr_mono_fast(num, nn, den, nd);
    if (ok == 1) { return r; }
    var a: f64 = _bj_k_cr_mono_acc(num, nn, den, nd);
    return a;
}

# (z₁, z₂) = (RN(h + RN(l − ε)), RN(h + RN(l + ε))), ε = 2⁻¹⁰⁰·h, for a positive normalised double-double h + l within
# 32u² of an exact value N (the section comment): z₁ = z₂ is RN(N).
#must_use
fn _bj_k_dd_round_ends(h: f64, l: f64): (f64, f64) {
    var k100: f64 = 0x39B0000000000000;             # 2^-100
    var eps: f64 = h * k100;
    var lo: f64 = l - eps;
    var hi: f64 = l + eps;
    var z1: f64 = h + lo;
    var z2: f64 = h + hi;
    return (z1, z2);
}

# (±y·2^k, 1) for y = RN(F) positive and normal, when the result's exponent K = k + e_y lies in [−1021, 1023], (±∞, 1)
# past 1023, (0, 0) below −1021 (the section comment).
#must_use
fn _bj_k_mono_fin(y: f64, k, neg): (f64, i64) {
    var yb = load64(&y);
    var kk = k + (yb >> 52) - 1023;
    if (kk > 1023) {
        var inf: f64 = _BJ_K_INF;
        if (neg == 1) { inf = -inf; }
        return (inf, 1);
    }
    if (kk < 0 - 1021) { return (0.0, 0); }
    var rb = yb + (k << 52);
    if (neg == 1) { rb = rb | 0x8000000000000000; }
    var r: f64 = rb;
    return (r, 1);
}

# RN(x·y/z) by its fast path: (RN, 1), or (0, 0) to fall back. M4f-2's _bj_k_mul_div_fast (stoichiometry.cyr), now for
# both signs. N = sₓ·s_y = p_h + p_l exactly (TwoProduct), D = s_z exact, so _bj_k_dd_div_cr's steps (inline, d_l = 0)
# have exact operands and its test proves RN(F) when z₁ = z₂ (F in (½, 4)); otherwise the one boundary between, the
# midpoint of z₁ and z₂, decides exactly (_bj_k_mul_div_tie; midpoints are common here: m·3/2 is one whenever 3m has 54
# bits).
#must_use
fn _bj_k_mul_div_fast(x: f64, y: f64, z: f64): (f64, i64) {
    var bx = load64(&x);
    var by = load64(&y);
    var bz = load64(&z);
    var neg = (bx ^ by ^ bz) >> 63;
    var abs = 0x7FFFFFFFFFFFFFFF;
    var ax = bx & abs;
    var ay = by & abs;
    var az = bz & abs;
    var nmin = 0x0010000000000000;
    var nmax = 0x7FF0000000000000;
    if (ax < nmin || ay < nmin || az < nmin || ax >= nmax || ay >= nmax || az >= nmax) { return (0.0, 0); }
    var k = (ax >> 52) + (ay >> 52) - (az >> 52) - 1023;                # eₓ + e_y − e_z
    var mask = 0x000FFFFFFFFFFFFF;
    var one = 0x3FF0000000000000;
    var sxb = (ax & mask) | one;
    var syb = (ay & mask) | one;
    var szb = (az & mask) | one;
    var sx: f64 = sxb;
    var sy: f64 = syb;
    var sz: f64 = szb;
    var ph, pl = _bj_k_two_prod(sx, sy);
    var y0: f64 = ph / sz;
    var ta, tb = _bj_k_two_prod(y0, sz);
    var s0: f64 = ph - ta;
    var s1: f64 = s0 - tb;
    var rr: f64 = s1 + pl;
    var dq: f64 = rr / sz;
    var k100: f64 = 0x39B0000000000000;     # 2⁻¹⁰⁰
    var eps: f64 = y0 * k100;
    var lo: f64 = dq - eps;
    var hi: f64 = dq + eps;
    var z1: f64 = y0 + lo;
    var z2: f64 = y0 + hi;
    var f: f64 = z1;
    if (z1 != z2) { f = _bj_k_mul_div_tie(ph, pl, sz, z1, z2); }
    var r, ok = _bj_k_mono_fin(f, k, neg);
    return (r, ok);
}

# RN(F) for F = N/D (N = p_h + p_l, D = s_z, as in _bj_k_mul_div_fast) where the rounding test left two adjacent doubles
# z₁ < z₂ and F strictly between points that round to them: the midpoint μ = z₁ + u/2 (u = z₂ − z₁, exact) is the only
# boundary there, so RN(F) is z₁ if F < μ, z₂ if F > μ, and the even one of the two if F = μ. The sign of F − μ is that
# of T = N − D·μ = (p_h − a) + p_l − b − h, with D·z₁ = a + b (TwoProduct) and h = D·(u/2) exact: p_h − a is exact by
# Sterbenz (a and p_h are within 2⁻⁵¹ of N), and each of the four terms is a multiple of 2⁻¹⁰⁷ (p_h, p_l of 2⁻¹⁰⁴; z₁ ≥
# ½ − 2⁻⁵⁴ of 2⁻⁵⁴, so a, b of 2⁻¹⁰⁶; u/2 ≥ 2⁻⁵⁵, so h of 2⁻¹⁰⁷) below 2⁻⁴⁸ in magnitude (|N − D·z₁| ≤ D·u < 2⁻⁴⁹):
# scaled by 2¹⁰⁷ (exact) each is an integer below 2⁵⁹, so T·2¹⁰⁷ is their exact sum in 64-bit integers. (M4f-2's, moved
# with it; _bj_k_mono_tie is its general form.)
#must_use
fn _bj_k_mul_div_tie(ph: f64, pl: f64, sz: f64, z1: f64, z2: f64): f64 {
    var u: f64 = z2 - z1;
    var hu: f64 = u * 0.5;
    var a, b = _bj_k_two_prod(sz, z1);
    var h: f64 = sz * hu;
    var e1: f64 = ph - a;
    var p107: f64 = 0x46A0000000000000;     # 2¹⁰⁷
    var ie: f64 = e1 * p107;
    var il: f64 = pl * p107;
    var ib: f64 = b * p107;
    var ih: f64 = h * p107;
    var t = f64_to(ie) + f64_to(il) - f64_to(ib) - f64_to(ih);
    if (t > 0) { return z2; }
    if (t < 0) { return z1; }
    if ((_bj_k_bits(z1) & 1) == 0) { return z1; }
    return z2;
}

# RN(x·y/z), correctly rounded, for every argument of _bj_k_cr_mono's domain: M4f-2's stoichiometry (ADR 0002 #24: the
# yields and the percent composition) and kinetics' steady_state_intermediate (#28).
#must_use
fn _bj_k_cr_mul_div(x: f64, y: f64, z: f64): f64 {
    var r, ok = _bj_k_mul_div_fast(x, y, z);
    if (ok == 1) { return r; }
    var nb: f64[2];
    store64(&nb, x);
    store64(&nb + 8, y);
    var db: f64[1];
    store64(&db, z);
    var g: f64 = _bj_k_cr_mono(&nb, 2, &db, 1);
    return g;
}

# RN(x·y·z) by its fast path: N = sₓs_ys_z by _bj_k_dd_mul_d on the exact TwoProduct sₓs_y (within 3.01u², N in [1, 8)),
# rounded by _bj_k_dd_round_ends; a failed test (a midpoint or near one) falls back.
#must_use
fn _bj_k_mul3_fast(x: f64, y: f64, z: f64): (f64, i64) {
    var bx = load64(&x);
    var by = load64(&y);
    var bz = load64(&z);
    var neg = (bx ^ by ^ bz) >> 63;
    var abs = 0x7FFFFFFFFFFFFFFF;
    var ax = bx & abs;
    var ay = by & abs;
    var az = bz & abs;
    var nmin = 0x0010000000000000;
    var nmax = 0x7FF0000000000000;
    if (ax < nmin || ay < nmin || az < nmin || ax >= nmax || ay >= nmax || az >= nmax) { return (0.0, 0); }
    var k = (ax >> 52) + (ay >> 52) + (az >> 52) - 3069;                # eₓ + e_y + e_z
    var mask = 0x000FFFFFFFFFFFFF;
    var one = 0x3FF0000000000000;
    var sxb = (ax & mask) | one;
    var syb = (ay & mask) | one;
    var szb = (az & mask) | one;
    var sx: f64 = sxb;
    var sy: f64 = syb;
    var sz: f64 = szb;
    var ph, pl = _bj_k_two_prod(sx, sy);
    var h, l = _bj_k_dd_mul_d(ph, pl, sz);
    var z1, z2 = _bj_k_dd_round_ends(h, l);
    if (z1 != z2) { return (0.0, 0); }
    var r, ok = _bj_k_mono_fin(z1, k, neg);
    return (r, ok);
}

# RN(x·y·z), correctly rounded: heat_transfer, boiling_point_elevation, freezing_point_depression (ADR 0002 #27).
#must_use
fn _bj_k_cr_mul3(x: f64, y: f64, z: f64): f64 {
    var r, ok = _bj_k_mul3_fast(x, y, z);
    if (ok == 1) { return r; }
    var nb: f64[3];
    store64(&nb, x);
    store64(&nb + 8, y);
    store64(&nb + 16, z);
    var g: f64 = _bj_k_cr_mono(&nb, 3, 0, 0);
    return g;
}

# RN(x/(y·z)) by its fast path: N = sₓ exact, D = s_ys_z an exact TwoProduct, F in (¼, 2) by _bj_k_dd_div_ends; a failed
# test falls back (x/(y·z) is never a 53-bit midpoint: one would need sₓ's odd part to have 54 bits).
#must_use
fn _bj_k_div2_fast(x: f64, y: f64, z: f64): (f64, i64) {
    var bx = load64(&x);
    var by = load64(&y);
    var bz = load64(&z);
    var neg = (bx ^ by ^ bz) >> 63;
    var abs = 0x7FFFFFFFFFFFFFFF;
    var ax = bx & abs;
    var ay = by & abs;
    var az = bz & abs;
    var nmin = 0x0010000000000000;
    var nmax = 0x7FF0000000000000;
    if (ax < nmin || ay < nmin || az < nmin || ax >= nmax || ay >= nmax || az >= nmax) { return (0.0, 0); }
    var k = (ax >> 52) - (ay >> 52) - (az >> 52) + 1023;                # eₓ − e_y − e_z
    var mask = 0x000FFFFFFFFFFFFF;
    var one = 0x3FF0000000000000;
    var sxb = (ax & mask) | one;
    var syb = (ay & mask) | one;
    var szb = (az & mask) | one;
    var sx: f64 = sxb;
    var sy: f64 = syb;
    var sz: f64 = szb;
    var dh, dl = _bj_k_two_prod(sy, sz);
    var z1, z2 = _bj_k_dd_div_ends(sx, 0.0, dh, dl);
    if (z1 != z2) { return (0.0, 0); }
    var r, ok = _bj_k_mono_fin(z1, k, neg);
    return (r, ok);
}

# RN(x/(y·z)), correctly rounded: specific_heat_from_calorimetry (#27), zero_order_half_life past 2·k's overflow (#28).
#must_use
fn _bj_k_cr_div2(x: f64, y: f64, z: f64): f64 {
    var r, ok = _bj_k_div2_fast(x, y, z);
    if (ok == 1) { return r; }
    var nb: f64[1];
    store64(&nb, x);
    var db: f64[2];
    store64(&db, y);
    store64(&db + 8, z);
    var g: f64 = _bj_k_cr_mono(&nb, 1, &db, 2);
    return g;
}

# RN(x·y·z/w) by its fast path: N as in _bj_k_mul3_fast (within 3.01u²), D = s_w exact, F in (½, 8) by
# _bj_k_dd_div_ends; a failed test falls back.
#must_use
fn _bj_k_mul3_div_fast(x: f64, y: f64, z: f64, w: f64): (f64, i64) {
    var bx = load64(&x);
    var by = load64(&y);
    var bz = load64(&z);
    var bw = load64(&w);
    var neg = (bx ^ by ^ bz ^ bw) >> 63;
    var abs = 0x7FFFFFFFFFFFFFFF;
    var ax = bx & abs;
    var ay = by & abs;
    var az = bz & abs;
    var aw = bw & abs;
    var nmin = 0x0010000000000000;
    var nmax = 0x7FF0000000000000;
    if (ax < nmin || ay < nmin || az < nmin || aw < nmin) { return (0.0, 0); }
    if (ax >= nmax || ay >= nmax || az >= nmax || aw >= nmax) { return (0.0, 0); }
    var k = (ax >> 52) + (ay >> 52) + (az >> 52) - (aw >> 52) - 2046;   # eₓ + e_y + e_z − e_w
    var mask = 0x000FFFFFFFFFFFFF;
    var one = 0x3FF0000000000000;
    var sxb = (ax & mask) | one;
    var syb = (ay & mask) | one;
    var szb = (az & mask) | one;
    var swb = (aw & mask) | one;
    var sx: f64 = sxb;
    var sy: f64 = syb;
    var sz: f64 = szb;
    var sw: f64 = swb;
    var ph, pl = _bj_k_two_prod(sx, sy);
    var h, l = _bj_k_dd_mul_d(ph, pl, sz);
    var z1, z2 = _bj_k_dd_div_ends(h, l, sw, 0.0);
    if (z1 != z2) { return (0.0, 0); }
    var r, ok = _bj_k_mono_fin(z1, k, neg);
    return (r, ok);
}

# RN(x·y·z/w), correctly rounded: pre_equilibrium_rate (#28).
#must_use
fn _bj_k_cr_mul3_div(x: f64, y: f64, z: f64, w: f64): f64 {
    var r, ok = _bj_k_mul3_div_fast(x, y, z, w);
    if (ok == 1) { return r; }
    var nb: f64[3];
    store64(&nb, x);
    store64(&nb + 8, y);
    store64(&nb + 16, z);
    var db: f64[1];
    store64(&db, w);
    var g: f64 = _bj_k_cr_mono(&nb, 3, &db, 1);
    return g;
}

# RN(a·b·c·d·f) by its fast path: the exact TwoProduct s_a·s_b, then _bj_k_dd_mul_d by s_c, s_d and s_f (within
# 3·3.01u²·(1 + 2⁻⁵⁰) < 9.1u², N in [1, 32)), rounded by _bj_k_dd_round_ends; a failed test falls back.
#must_use
fn _bj_k_mul5_fast(a: f64, b: f64, c: f64, d: f64, f: f64): (f64, i64) {
    var ba = load64(&a);
    var bb = load64(&b);
    var bc = load64(&c);
    var bd = load64(&d);
    var bf = load64(&f);
    var neg = (ba ^ bb ^ bc ^ bd ^ bf) >> 63;
    var abs = 0x7FFFFFFFFFFFFFFF;
    var aa = ba & abs;
    var ab = bb & abs;
    var ac = bc & abs;
    var ad = bd & abs;
    var af = bf & abs;
    var nmin = 0x0010000000000000;
    var nmax = 0x7FF0000000000000;
    if (aa < nmin || ab < nmin || ac < nmin || ad < nmin || af < nmin) { return (0.0, 0); }
    if (aa >= nmax || ab >= nmax || ac >= nmax || ad >= nmax || af >= nmax) { return (0.0, 0); }
    var k = (aa >> 52) + (ab >> 52) + (ac >> 52) + (ad >> 52) + (af >> 52) - 5115;
    var mask = 0x000FFFFFFFFFFFFF;
    var one = 0x3FF0000000000000;
    var sab = (aa & mask) | one;
    var sbb = (ab & mask) | one;
    var scb = (ac & mask) | one;
    var sdb = (ad & mask) | one;
    var sfb = (af & mask) | one;
    var sa: f64 = sab;
    var sb: f64 = sbb;
    var sc: f64 = scb;
    var sd: f64 = sdb;
    var sf: f64 = sfb;
    var ph, pl = _bj_k_two_prod(sa, sb);
    var h1, l1 = _bj_k_dd_mul_d(ph, pl, sc);
    var h2, l2 = _bj_k_dd_mul_d(h1, l1, sd);
    var h3, l3 = _bj_k_dd_mul_d(h2, l2, sf);
    var z1, z2 = _bj_k_dd_round_ends(h3, l3);
    if (z1 != z2) { return (0.0, 0); }
    var r, ok = _bj_k_mono_fin(z1, k, neg);
    return (r, ok);
}

# RN(a·b·c·d·f), correctly rounded: osmotic_pressure's i·M·R·1000·T (#27).
#must_use
fn _bj_k_cr_mul5(a: f64, b: f64, c: f64, d: f64, f: f64): f64 {
    var r, ok = _bj_k_mul5_fast(a, b, c, d, f);
    if (ok == 1) { return r; }
    var nb: f64[5];
    store64(&nb, a);
    store64(&nb + 8, b);
    store64(&nb + 16, c);
    store64(&nb + 24, d);
    store64(&nb + 32, f);
    var g: f64 = _bj_k_cr_mono(&nb, 5, 0, 0);
    return g;
}

# RN(x·y/(z·w)) by its fast path: N = sₓs_y and D = s_zs_w exact TwoProducts, F in (¼, 4) by _bj_k_dd_div_ends (exact
# operands, inside its 32u² budget); a failed test (a midpoint, or within 2⁻⁹⁸ of one) falls back.
#must_use
fn _bj_k_mul2_div2_fast(x: f64, y: f64, z: f64, w: f64): (f64, i64) {
    var bx = load64(&x);
    var by = load64(&y);
    var bz = load64(&z);
    var bw = load64(&w);
    var neg = (bx ^ by ^ bz ^ bw) >> 63;
    var abs = 0x7FFFFFFFFFFFFFFF;
    var ax = bx & abs;
    var ay = by & abs;
    var az = bz & abs;
    var aw = bw & abs;
    var nmin = 0x0010000000000000;
    var nmax = 0x7FF0000000000000;
    if (ax < nmin || ay < nmin || az < nmin || aw < nmin) { return (0.0, 0); }
    if (ax >= nmax || ay >= nmax || az >= nmax || aw >= nmax) { return (0.0, 0); }
    var k = (ax >> 52) + (ay >> 52) - (az >> 52) - (aw >> 52);          # eₓ + e_y − e_z − e_w
    var mask = 0x000FFFFFFFFFFFFF;
    var one = 0x3FF0000000000000;
    var sxb = (ax & mask) | one;
    var syb = (ay & mask) | one;
    var szb = (az & mask) | one;
    var swb = (aw & mask) | one;
    var sx: f64 = sxb;
    var sy: f64 = syb;
    var sz: f64 = szb;
    var sw: f64 = swb;
    var ph, pl = _bj_k_two_prod(sx, sy);
    var dh, dl = _bj_k_two_prod(sz, sw);
    var z1, z2 = _bj_k_dd_div_ends(ph, pl, dh, dl);
    if (z1 != z2) { return (0.0, 0); }
    var r, ok = _bj_k_mono_fin(z1, k, neg);
    return (r, ok);
}

# RN(x·y/(z·w)), correctly rounded: faraday_mass_deposited's Q·M/(n·F) (#29). A midpoint the fast path leaves is
# _bj_k_cr_mono's (its 2/2 tie resolution).
#must_use
fn _bj_k_cr_mul2_div2(x: f64, y: f64, z: f64, w: f64): f64 {
    var r, ok = _bj_k_mul2_div2_fast(x, y, z, w);
    if (ok == 1) { return r; }
    var nb: f64[2];
    store64(&nb, x);
    store64(&nb + 8, y);
    var db: f64[2];
    store64(&db, z);
    store64(&db + 8, w);
    var g: f64 = _bj_k_cr_mono(&nb, 2, &db, 2);
    return g;
}

# RN(x·y·z/(v·w)) by its fast path: N as in _bj_k_mul3_fast (within 3.01u², in [1, 8)), D = s_vs_w an exact TwoProduct,
# F in (⅛, 8) by _bj_k_dd_div_ends; a failed test falls back.
#must_use
fn _bj_k_mul3_div2_fast(x: f64, y: f64, z: f64, v: f64, w: f64): (f64, i64) {
    var bx = load64(&x);
    var by = load64(&y);
    var bz = load64(&z);
    var bv = load64(&v);
    var bw = load64(&w);
    var neg = (bx ^ by ^ bz ^ bv ^ bw) >> 63;
    var abs = 0x7FFFFFFFFFFFFFFF;
    var ax = bx & abs;
    var ay = by & abs;
    var az = bz & abs;
    var av = bv & abs;
    var aw = bw & abs;
    var nmin = 0x0010000000000000;
    var nmax = 0x7FF0000000000000;
    if (ax < nmin || ay < nmin || az < nmin || av < nmin || aw < nmin) { return (0.0, 0); }
    if (ax >= nmax || ay >= nmax || az >= nmax || av >= nmax || aw >= nmax) { return (0.0, 0); }
    var k = (ax >> 52) + (ay >> 52) + (az >> 52) - (av >> 52) - (aw >> 52) - 1023;   # eₓ + e_y + e_z − e_v − e_w
    var mask = 0x000FFFFFFFFFFFFF;
    var one = 0x3FF0000000000000;
    var sxb = (ax & mask) | one;
    var syb = (ay & mask) | one;
    var szb = (az & mask) | one;
    var svb = (av & mask) | one;
    var swb = (aw & mask) | one;
    var sx: f64 = sxb;
    var sy: f64 = syb;
    var sz: f64 = szb;
    var sv: f64 = svb;
    var sw: f64 = swb;
    var ph, pl = _bj_k_two_prod(sx, sy);
    var h, l = _bj_k_dd_mul_d(ph, pl, sz);
    var dh, dl = _bj_k_two_prod(sv, sw);
    var z1, z2 = _bj_k_dd_div_ends(h, l, dh, dl);
    if (z1 != z2) { return (0.0, 0); }
    var r, ok = _bj_k_mono_fin(z1, k, neg);
    return (r, ok);
}

# RN(x·y·z/(v·w)), correctly rounded: faraday_mass_ratio's m_A·M_B·n_A/(n_B·M_A) (#29). A midpoint the fast path leaves
# is _bj_k_cr_mono's (its 3/2 tie resolution).
#must_use
fn _bj_k_cr_mul3_div2(x: f64, y: f64, z: f64, v: f64, w: f64): f64 {
    var r, ok = _bj_k_mul3_div2_fast(x, y, z, v, w);
    if (ok == 1) { return r; }
    var nb: f64[3];
    store64(&nb, x);
    store64(&nb + 8, y);
    store64(&nb + 16, z);
    var db: f64[2];
    store64(&db, v);
    store64(&db + 8, w);
    var g: f64 = _bj_k_cr_mono(&nb, 3, &db, 2);
    return g;
}

# RN(a·b·c·d) by its fast path: the exact TwoProduct s_a·s_b, then _bj_k_dd_mul_d by s_c and s_d (within
# 2·3.01u²·(1 + 2⁻⁵⁰) < 6.1u², N in [1, 16)), rounded by _bj_k_dd_round_ends; a failed test falls back.
#must_use
fn _bj_k_mul4_fast(a: f64, b: f64, c: f64, d: f64): (f64, i64) {
    var ba = load64(&a);
    var bb = load64(&b);
    var bc = load64(&c);
    var bd = load64(&d);
    var neg = (ba ^ bb ^ bc ^ bd) >> 63;
    var abs = 0x7FFFFFFFFFFFFFFF;
    var aa = ba & abs;
    var ab = bb & abs;
    var ac = bc & abs;
    var ad = bd & abs;
    var nmin = 0x0010000000000000;
    var nmax = 0x7FF0000000000000;
    if (aa < nmin || ab < nmin || ac < nmin || ad < nmin) { return (0.0, 0); }
    if (aa >= nmax || ab >= nmax || ac >= nmax || ad >= nmax) { return (0.0, 0); }
    var k = (aa >> 52) + (ab >> 52) + (ac >> 52) + (ad >> 52) - 4092;   # e_a + e_b + e_c + e_d
    var mask = 0x000FFFFFFFFFFFFF;
    var one = 0x3FF0000000000000;
    var sab = (aa & mask) | one;
    var sbb = (ab & mask) | one;
    var scb = (ac & mask) | one;
    var sdb = (ad & mask) | one;
    var sa: f64 = sab;
    var sb: f64 = sbb;
    var sc: f64 = scb;
    var sd: f64 = sdb;
    var ph, pl = _bj_k_two_prod(sa, sb);
    var h1, l1 = _bj_k_dd_mul_d(ph, pl, sc);
    var h2, l2 = _bj_k_dd_mul_d(h1, l1, sd);
    var z1, z2 = _bj_k_dd_round_ends(h2, l2);
    if (z1 != z2) { return (0.0, 0); }
    var r, ok = _bj_k_mono_fin(z1, k, neg);
    return (r, ok);
}

# RN(a·b·c·d), correctly rounded: rigid_rotor_energy's h·B·J·(J + 1) (#30).
#must_use
fn _bj_k_cr_mul4(a: f64, b: f64, c: f64, d: f64): f64 {
    var r, ok = _bj_k_mul4_fast(a, b, c, d);
    if (ok == 1) { return r; }
    var nb: f64[4];
    store64(&nb, a);
    store64(&nb + 8, b);
    store64(&nb + 16, c);
    store64(&nb + 24, d);
    var g: f64 = _bj_k_cr_mono(&nb, 4, 0, 0);
    return g;
}

# RN(x/(y·z·w)) by its fast path: N = sₓ exact, D = s_ys_zs_w by _bj_k_dd_mul_d on the exact TwoProduct s_ys_z (within
# 3.01u², in [1, 8)), F in (⅛, 2) by _bj_k_dd_div_ends; a failed test falls back.
#must_use
fn _bj_k_div3_fast(x: f64, y: f64, z: f64, w: f64): (f64, i64) {
    var bx = load64(&x);
    var by = load64(&y);
    var bz = load64(&z);
    var bw = load64(&w);
    var neg = (bx ^ by ^ bz ^ bw) >> 63;
    var abs = 0x7FFFFFFFFFFFFFFF;
    var ax = bx & abs;
    var ay = by & abs;
    var az = bz & abs;
    var aw = bw & abs;
    var nmin = 0x0010000000000000;
    var nmax = 0x7FF0000000000000;
    if (ax < nmin || ay < nmin || az < nmin || aw < nmin) { return (0.0, 0); }
    if (ax >= nmax || ay >= nmax || az >= nmax || aw >= nmax) { return (0.0, 0); }
    var k = (ax >> 52) - (ay >> 52) - (az >> 52) - (aw >> 52) + 2046;   # eₓ − e_y − e_z − e_w
    var mask = 0x000FFFFFFFFFFFFF;
    var one = 0x3FF0000000000000;
    var sxb = (ax & mask) | one;
    var syb = (ay & mask) | one;
    var szb = (az & mask) | one;
    var swb = (aw & mask) | one;
    var sx: f64 = sxb;
    var sy: f64 = syb;
    var sz: f64 = szb;
    var sw: f64 = swb;
    var ph, pl = _bj_k_two_prod(sy, sz);
    var dh, dl = _bj_k_dd_mul_d(ph, pl, sw);
    var z1, z2 = _bj_k_dd_div_ends(sx, 0.0, dh, dl);
    if (z1 != z2) { return (0.0, 0); }
    var r, ok = _bj_k_mono_fin(z1, k, neg);
    return (r, ok);
}

# RN(x/(y·z·w)), correctly rounded: rotational_constant's h/(8·π·π·I), called as (h/8)/(π·π·I) (h/8 exact) (#30).
#must_use
fn _bj_k_cr_div3(x: f64, y: f64, z: f64, w: f64): f64 {
    var r, ok = _bj_k_div3_fast(x, y, z, w);
    if (ok == 1) { return r; }
    var nb: f64[1];
    store64(&nb, x);
    var db: f64[3];
    store64(&db, y);
    store64(&db + 8, z);
    store64(&db + 16, w);
    var g: f64 = _bj_k_cr_mono(&nb, 1, &db, 3);
    return g;
}

# ── correctly rounded square roots of quotients (the overflow audit's B2): ADR 0002 #30 ──────────────────────────────

# (y₀, d) with y₀ + d = √(sₓ/s_y) to 5.7u² (the section comment), for sₓ/s_y in (½, 4) and both in [1, 4). (Inlining
# the two TwoProducts saved 1 ns of 87 and was not kept.)
#must_use
fn _bj_k_sqrt_div_dd(sx: f64, sy: f64): (f64, f64) {
    var qh: f64 = sx / sy;
    var a, b = _bj_k_two_prod(qh, sy);
    var rem: f64 = (sx - a) - b;
    var ql: f64 = rem / sy;
    var y0: f64 = f64_sqrt(qh);
    var p, pe = _bj_k_two_prod(y0, y0);
    var t1: f64 = (qh - p) - pe;
    var t: f64 = t1 + ql;
    var tr: f64 = y0 + y0;
    var d: f64 = t / tr;
    return (y0, d);
}

# RN(√(x/y)) by the fast path (the section comment): (RN, 1), or (0, 0) for an operand that is not a positive normal
# double, a failed rounding test or a possibly subnormal result.
#must_use
fn _bj_k_sqrt_div_fast(x: f64, y: f64): (f64, i64) {
    var bx = load64(&x);
    var by = load64(&y);
    var nmin = 0x0010000000000000;
    var nmax = 0x7FF0000000000000;
    if (bx < nmin || by < nmin || bx >= nmax || by >= nmax) { return (0.0, 0); }     # a sign bit reads negative
    var kk = (bx >> 52) - (by >> 52);                                   # eₓ − e_y
    var mask = 0x000FFFFFFFFFFFFF;
    var one = 0x3FF0000000000000;
    var sxb = (bx & mask) | one;
    var syb = (by & mask) | one;
    var sx: f64 = sxb;
    var sy: f64 = syb;
    if ((kk & 1) != 0) {
        sx = sx * 2.0;
        kk = kk - 1;
    }
    var y0, d = _bj_k_sqrt_div_dd(sx, sy);
    var k100: f64 = 0x39B0000000000000;     # 2⁻¹⁰⁰
    var eps: f64 = y0 * k100;
    var lo: f64 = d - eps;
    var hi: f64 = d + eps;
    var z1: f64 = y0 + lo;
    var z2: f64 = y0 + hi;
    if (z1 != z2) { return (0.0, 0); }
    var r, ok = _bj_k_mono_fin(z1, kk / 2, 0);
    return (r, ok);
}

# R²·B into w (multi-word, below 2¹⁶⁵), for 0 ≤ R < 2⁵⁷ and B at bb; t and s are scratch.
fn _bj_k_sqrt_sq_mul(w, rr, bb, t, s) {
    _bj_k_bn_set(t, rr);
    _bj_k_bn_mul(s, t, t);
    _bj_k_bn_mul(w, s, bb);
    return 0;
}

# RN(√(x/y)) by the exact path alone (the section comment), for positive finite x and y; NaN otherwise.
#must_use
fn _bj_k_sqrt_div_acc(x: f64, y: f64): f64 {
    var bx = load64(&x);
    var by = load64(&y);
    var nmax = 0x7FF0000000000000;
    if (bx <= 0 || by <= 0 || bx >= nmax || by >= nmax) {
        var nan: f64 = _bj_k_nan();
        return nan;
    }
    var am, ea = _bj_k_f64_int(bx);
    var bm, eb = _bj_k_f64_int(by);
    var e = ea - eb;
    if ((e & 1) != 0) {
        am = am * 2;
        e = e - 1;
    }
    var af: f64 = f64_from(am);              # below 2⁵⁴: exact
    var bf: f64 = f64_from(bm);
    var p52: f64 = 0x3CB0000000000000;      # 2⁻⁵²: A/B as a quotient of significands in [1, 4), exactly scaled
    var sa: f64 = af * p52;
    var sb: f64 = bf * p52;
    var y0, d = _bj_k_sqrt_div_dd(sa, sb);
    var p55: f64 = 0x4360000000000000;      # 2⁵⁵
    var gy: f64 = y0 * p55;                 # an integer below 2⁵⁶ (y₀'s ulp is at least 2⁻⁵³)
    var gd: f64 = d * p55;
    var rr = f64_to(gy) + f64_to(gd);
    var pb[64];
    var bb[64];
    var wb[64];
    var tb[64];
    var sb2[64];
    _bj_k_bn_set(&pb, am);
    _bj_k_bn_shl(&pb, 110);
    _bj_k_bn_set(&bb, bm);
    var up = 1;
    while (up == 1) {
        _bj_k_sqrt_sq_mul(&wb, rr + 1, &bb, &tb, &sb2);
        if (_bj_k_bn_cmp(&wb, &pb) > 0) {
            up = 0;
        } else {
            rr = rr + 1;
        }
    }
    _bj_k_sqrt_sq_mul(&wb, rr, &bb, &tb, &sb2);
    while (_bj_k_bn_cmp(&wb, &pb) > 0) {
        rr = rr - 1;
        _bj_k_sqrt_sq_mul(&wb, rr, &bb, &tb, &sb2);
    }
    var sticky = 0;
    if (_bj_k_bn_cmp(&wb, &pb) != 0) { sticky = 1; }
    var h = (e - 110) / 2;
    var r: f64 = _bj_k_cr_from_int(2 * rr + sticky, h - 1);
    return r;
}

# RN(√(x/y)), correctly rounded (the section comment), for positive finite x and y: the fast path, then the exact path
# where it declines; NaN outside the domain.
#must_use
fn _bj_k_cr_sqrt_div(x: f64, y: f64): f64 {
    var r, ok = _bj_k_sqrt_div_fast(x, y);
    if (ok == 1) { return r; }
    var a: f64 = _bj_k_sqrt_div_acc(x, y);
    return a;
}

# ── correctly rounded w·√((x/y)·2^e) (the overflow audit's B3): ADR 0002 #32 ──────────────────────────────────────────

# RN(w·√((x/y)·2^e)) by the fast path (the section comment): (RN, 1), or (0, 0) for an operand that is not a positive
# normal double, a failed rounding test or a possibly subnormal result.
#must_use
fn _bj_k_mul_sqrt_ratio_fast(w: f64, x: f64, y: f64, e): (f64, i64) {
    var bw = load64(&w);
    var bx = load64(&x);
    var by = load64(&y);
    var nmin = 0x0010000000000000;
    var nmax = 0x7FF0000000000000;
    if (bw < nmin || bx < nmin || by < nmin) { return (0.0, 0); }      # a sign bit reads negative
    if (bw >= nmax || bx >= nmax || by >= nmax) { return (0.0, 0); }
    var kk = (bx >> 52) - (by >> 52) + e;                               # eₓ − e_y + e
    var mask = 0x000FFFFFFFFFFFFF;
    var one = 0x3FF0000000000000;
    var sxb = (bx & mask) | one;
    var syb = (by & mask) | one;
    var swb = (bw & mask) | one;
    var sx: f64 = sxb;
    var sy: f64 = syb;
    var sw: f64 = swb;
    if ((kk & 1) != 0) {
        sx = sx * 2.0;
        kk = kk - 1;
    }
    var y0, d = _bj_k_sqrt_div_dd(sx, sy);
    var ph, pl = _bj_k_two_prod(y0, sw);
    var c: f64 = d * sw;
    var t: f64 = pl + c;
    var h, l = _bj_k_fast_two_sum(ph, t);
    var z1, z2 = _bj_k_dd_round_ends(h, l);
    if (z1 != z2) { return (0.0, 0); }
    var k = (bw >> 52) - 1023 + kk / 2;
    var r, ok = _bj_k_mono_fin(z1, k, 0);
    return (r, ok);
}

# RN(w·√((x/y)·2^e)) by the exact path alone (the section comment), for positive finite w, x and y; NaN otherwise.
#must_use
fn _bj_k_mul_sqrt_ratio_acc(w: f64, x: f64, y: f64, e): f64 {
    var bw = load64(&w);
    var bx = load64(&x);
    var by = load64(&y);
    var nmax = 0x7FF0000000000000;
    if (bw <= 0 || bx <= 0 || by <= 0 || bw >= nmax || bx >= nmax || by >= nmax) {
        var nan: f64 = _bj_k_nan();
        return nan;
    }
    var wm, ew = _bj_k_f64_int(bw);
    var am, ea = _bj_k_f64_int(bx);
    var bm, eb = _bj_k_f64_int(by);
    var ee = ea - eb + e;
    if ((ee & 1) != 0) {
        am = am * 2;
        ee = ee - 1;
    }
    var wf: f64 = f64_from(wm);              # below 2⁵³: exact
    var af: f64 = f64_from(am);              # below 2⁵⁴: exact
    var bf: f64 = f64_from(bm);
    var p52: f64 = 0x3CB0000000000000;      # 2⁻⁵²: A/B as a quotient of significands in [1, 4), exactly scaled
    var sa: f64 = af * p52;
    var sb: f64 = bf * p52;
    var y0, d = _bj_k_sqrt_div_dd(sa, sb);
    var gh, gl = _bj_k_two_prod(wf, y0);      # W·y₀ exactly, at least 2^51.5: 8·g_h is an integer
    var gd: f64 = wf * d;
    var g8: f64 = gh * 8.0;
    var t8: f64 = (gl + gd) * 8.0;
    var rr = f64_to(g8) + f64_to(t8);       # within a few units of R
    var pb[64];
    var tb[64];
    var bb[64];
    var wb[64];
    var sb2[64];
    _bj_k_bn_set(&tb, wm);
    _bj_k_bn_mul(&sb2, &tb, &tb);
    _bj_k_bn_set(&tb, am);
    _bj_k_bn_mul(&pb, &sb2, &tb);
    _bj_k_bn_shl(&pb, 6);
    _bj_k_bn_set(&bb, bm);
    var up = 1;
    while (up == 1) {
        _bj_k_sqrt_sq_mul(&wb, rr + 1, &bb, &tb, &sb2);
        if (_bj_k_bn_cmp(&wb, &pb) > 0) {
            up = 0;
        } else {
            rr = rr + 1;
        }
    }
    _bj_k_sqrt_sq_mul(&wb, rr, &bb, &tb, &sb2);
    while (_bj_k_bn_cmp(&wb, &pb) > 0) {
        rr = rr - 1;
        _bj_k_sqrt_sq_mul(&wb, rr, &bb, &tb, &sb2);
    }
    var sticky = 0;
    if (_bj_k_bn_cmp(&wb, &pb) != 0) { sticky = 1; }
    var h = ew + ee / 2 - 3;
    var r: f64 = _bj_k_cr_from_int(2 * rr + sticky, h - 1);
    return r;
}

# RN(w·√((x/y)·2^e)), correctly rounded (the section comment), for positive finite w, x and y: the fast path, then the
# exact path where it declines; NaN outside the domain.
#must_use
fn _bj_k_cr_mul_sqrt_ratio(w: f64, x: f64, y: f64, e): f64 {
    var r, ok = _bj_k_mul_sqrt_ratio_fast(w, x, y, e);
    if (ok == 1) { return r; }
    var a: f64 = _bj_k_mul_sqrt_ratio_acc(w, x, y, e);
    return a;
}

# --- crmath_mono.cyr ---

# crmath_mono.cyr — RN(√(x₁·…·xₐ / (y₁·…·y_b))), the correctly rounded square root of a monomial (bijli, M1 part 5b),
# on kimiya's machinery (src/crmath_kx.cyr).
#
# For the "round once" decision of the range-edge review (plan §0.1, the user's 2026-11-12 answer): a formula that is
# one root of a product or quotient of inputs and constants is correctly rounded, where kimiya's shapes stop at
# √(x/y) and w·√((x/y)·2^e). bijli's are maxwell's wave_speed 1/√(ε·μ) (no numerator factor, two denominator factors)
# and skin_depth √(2/(ω·μ·σ)) (2 enters as an exponent, three denominator factors). Rust's chains round three or
# four times (one ulp off on about a quarter of inputs) and their products over- or underflow where the root is
# representable (wave_speed(1e-160, 1e-160) is 3.6·10¹⁰ ulp off, (1e160, 1e160) gives 0).
#
# Domain: at most _BJ_SQM_NMAX numerator and _BJ_SQM_DMAX denominator factors, each a positive finite double; NaN
# otherwise (the callers keep Rust's semantics for ±∞, zeros and NaN). The value v = √F lies within about 2^±2200;
# it is +∞ past DBL_MAX's rounding boundary, subnormal below 2^-1022, +0 below half of 2^-1074.
#
# The fast path, _bj_cr_sqrt_mono_fast (u = 2⁻⁵³). kimiya's _bj_k_mono_sig splits each side into its significands
# other than 1 (in [1, 2); a subnormal scaled by 2⁵⁴ first) and the sum of exponents; _bj_k_mono_prod makes the
# products N = n_h + n_l and D = d_h + d_l normalised double-doubles (one factor exact, two an exact TwoProduct, a
# third by _bj_k_dd_mul_d within 3.01u²), so N/D is within 3.1u² of the exact significand quotient. With
# K = Σ e_num − Σ e_den made even (N doubled, exactly, when it is odd), F = N/D·2^K, N in [1, 2⁴), D in [1, 2⁴).
# _bj_sqm_dd then forms q_h + q_l = N/D (q_h = RN(n_h/d_h); its remainder n_h − q_h·d_h is exact by TwoProduct and
# Sterbenz, and n_l − q_h·d_l joins it with an error at most 3u²·q_h), y₀ = RN(√q_h), and the Newton step
# δ = ((q_h − y₀²) + q_l)/(2y₀) (q_h − y₀² exact by TwoProduct and Sterbenz, as kimiya's _bj_k_sqrt_div_dd). The
# quotient's error is at most 7u² relative, half of it in the root, and the step's own at most 5.7u² (kimiya's bound),
# so y₀ + δ is within 11u² of √(N/D), and within 13u² of the exact root with N's and D's errors. That is inside
# _bj_k_dd_round_ends's budget of 32u²: z₁ = z₂ proves RN(√(N/D)) = z₁, and _bj_k_mono_fin scales it by 2^(K/2),
# exactly for a normal result, to ±∞ past DBL_MAX, and declines a possibly subnormal one.
#
# The exact path, _bj_cr_sqrt_mono_acc: each factor x = M·2^E with 2⁵² ≤ M < 2⁵³ (kimiya's _bj_k_f64_int), P the
# product of the numerator's M and Q the denominator's (multi-word, below 2^160 and 2^213), F = P/Q·2^E. With S chosen
# so that R = ⌊√(P·2^S/Q)⌋ has 56 or 57 bits and E − S is even, R is the largest integer with R²·Q ≤ P·2^S: an
# estimate from the double-double root, within one or two, corrected by exact comparisons. The sticky bit records
# R²·Q ≠ P·2^S, and kimiya's _bj_k_cr_from_int rounds (2R + sticky)·2^((E − S)/2 − 1) once: the binade's grid or the
# subnormal one, ties to even, +∞ past DBL_MAX. (R has at least 55 bits, so the sticky bit sits below every rounding
# position.) The multi-word integers here are bijli's own, of _BJ_SQM_LIMBS 32-bit limbs (below 2^384): kimiya's
# stop at 2^256, and R²·Q reaches 2^327.
#
# scripts/oracle/cr_verify.py's sqrt_mono family checks both paths against an exact integer square root on x86_64 and
# aarch64.

const _BJ_SQM_NMAX = 3;
const _BJ_SQM_DMAX = 4;
const _BJ_SQM_LIMBS = 12;

# ── multi-word integers: _BJ_SQM_LIMBS limbs of 32 bits, least significant first, one per 64-bit word ──────────────

# a = v, for 0 ≤ v < 2^63.
fn _bj_sqm_set(a, v) {
    for (var k = 0; k < _BJ_SQM_LIMBS; k = k + 1) { store64(a + 8 * k, 0); }
    store64(a, v & 0xFFFFFFFF);
    store64(a + 8, v >> 32);
    return 0;
}

# The number of significant bits of a (0 for zero).
#must_use
fn _bj_sqm_bitlen(a): i64 {
    var k = _BJ_SQM_LIMBS - 1;
    while (k >= 0 && load64(a + 8 * k) == 0) { k = k - 1; }
    if (k < 0) { return 0; }
    var top = load64(a + 8 * k);
    var b = 0;
    while (top != 0) {
        top = top >> 1;
        b = b + 1;
    }
    return 32 * k + b;
}

# r = a·b, truncated to the capacity (the callers stay below it); r must not alias a or b.
fn _bj_sqm_mul(r, a, b) {
    for (var k = 0; k < _BJ_SQM_LIMBS; k = k + 1) { store64(r + 8 * k, 0); }
    var la = (_bj_sqm_bitlen(a) + 31) / 32;
    var lb = (_bj_sqm_bitlen(b) + 31) / 32;
    for (var i = 0; i < la; i = i + 1) {
        var ai = load64(a + 8 * i);
        var c = 0;
        var j = 0;
        while (j < lb && i + j < _BJ_SQM_LIMBS) {
            # ai·bⱼ + rᵢ₊ⱼ + c < 2⁶⁴: the sum wraps nothing, and >> is logical
            var t = ai * load64(b + 8 * j) + load64(r + 8 * (i + j)) + c;
            store64(r + 8 * (i + j), t & 0xFFFFFFFF);
            c = t >> 32;
            j = j + 1;
        }
        if (i + lb < _BJ_SQM_LIMBS) { store64(r + 8 * (i + lb), c); }
    }
    return 0;
}

# a = a·2^s, for 0 ≤ s (truncated to the capacity).
fn _bj_sqm_shl(a, s) {
    var w = s / 32;
    var b = s - 32 * w;
    var k = _BJ_SQM_LIMBS - 1;
    while (k >= 0) {
        var v = 0;
        if (k - w >= 0) { v = (load64(a + 8 * (k - w)) << b) & 0xFFFFFFFF; }
        if (b > 0 && k - w - 1 >= 0) { v = v | (load64(a + 8 * (k - w - 1)) >> (32 - b)); }
        store64(a + 8 * k, v);
        k = k - 1;
    }
    return 0;
}

# −1, 0 or 1 as a < b, a = b or a > b.
#must_use
fn _bj_sqm_cmp(a, b): i64 {
    var k = _BJ_SQM_LIMBS - 1;
    while (k >= 0) {
        var x = load64(a + 8 * k);
        var y = load64(b + 8 * k);
        if (x < y) { return 0 - 1; }
        if (x > y) { return 1; }
        k = k - 1;
    }
    return 0;
}

# w = R²·B, for 0 ≤ R < 2^62 and B at bb; t and s are scratch.
fn _bj_sqm_sq_mul(w, rr, bb, t, s) {
    _bj_sqm_set(t, rr);
    _bj_sqm_mul(s, t, t);
    _bj_sqm_mul(w, s, bb);
    return 0;
}

# ── the root ────────────────────────────────────────────────────────────────────────────────────────────────────

# (y₀, δ) with y₀ + δ = √(N/D) to 11u² (the section comment), for normalised double-doubles N = n_h + n_l and
# D = d_h + d_l in [1, 2⁴).
#must_use
fn _bj_sqm_dd(nh: f64, nl: f64, dh: f64, dl: f64): (f64, f64) {
    var qh: f64 = nh / dh;
    var a, b = _bj_k_two_prod(qh, dh);
    var r0: f64 = (nh - a) - b;
    var r1: f64 = qh * dl;
    var r2: f64 = nl - r1;
    var rem: f64 = r0 + r2;
    var ql: f64 = rem / dh;
    var y0: f64 = f64_sqrt(qh);
    var p, pe = _bj_k_two_prod(y0, y0);
    var t1: f64 = (qh - p) - pe;
    var t: f64 = t1 + ql;
    var tr: f64 = y0 + y0;
    var d: f64 = t / tr;
    return (y0, d);
}

# The significands of the n factors at p written to out as kimiya's _bj_k_mono_sig does, for a side of the domain:
# (count, exponent sum), or (−1, 0) when a factor is not positive and finite.
#must_use
fn _bj_sqm_side(p, n, out): (i64, i64) {
    var fl, c, e = _bj_k_mono_sig(p, n, out);
    if (fl != 0) { return (0 - 1, 0); }
    return (c, e);
}

# RN(√F) by the fast path (the section comment): (RN, 1), or (0, 0) for a failed rounding test, a possibly subnormal
# result or an argument outside the domain.
#must_use
fn _bj_cr_sqrt_mono_fast(num, nn, den, nd): (f64, i64) {
    if (nn < 0 || nd < 0 || nn > _BJ_SQM_NMAX || nd > _BJ_SQM_DMAX) { return (0.0, 0); }
    var sn: f64[3];
    var sd: f64[4];
    var cn, en = _bj_sqm_side(num, nn, &sn);
    var cd, ed = _bj_sqm_side(den, nd, &sd);
    if (cn < 0 || cd < 0) { return (0.0, 0); }
    var nh, nl = _bj_k_mono_prod(&sn, cn);
    var dh, dl = _bj_k_mono_prod(&sd, cd);
    var kk = en - ed;
    if ((kk & 1) != 0) {
        nh = nh * 2.0;
        nl = nl * 2.0;
        kk = kk - 1;
    }
    var y0, d = _bj_sqm_dd(nh, nl, dh, dl);
    var z1, z2 = _bj_k_dd_round_ends(y0, d);
    if (z1 != z2) { return (0.0, 0); }
    var r, ok = _bj_k_mono_fin(z1, kk / 2, 0);
    return (r, ok);
}

# RN(√F) by the exact path alone (the section comment); NaN outside the domain.
#must_use
fn _bj_cr_sqrt_mono_acc(num, nn, den, nd): f64 {
    var nan: f64 = _bj_k_nan();
    if (nn < 0 || nd < 0 || nn > _BJ_SQM_NMAX || nd > _BJ_SQM_DMAX) { return nan; }
    var pb[96];
    var qb[96];
    var tb[96];
    var rb[96];
    var ee = 0;
    _bj_sqm_set(&pb, 1);
    _bj_sqm_set(&qb, 1);
    var side = 0;
    while (side < 2) {
        var p = num;
        var n = nn;
        var acc = &pb;
        if (side == 1) {
            p = den;
            n = nd;
            acc = &qb;
        }
        for (var i = 0; i < n; i = i + 1) {
            var b = load64(p + 8 * i);
            if (b <= 0 || b >= 0x7FF0000000000000) { return nan; }
            var mm, e = _bj_k_f64_int(b);
            if (side == 0) { ee = ee + e; } else { ee = ee - e; }
            _bj_sqm_set(&tb, mm);
            _bj_sqm_mul(&rb, acc, &tb);
            for (var k = 0; k < _BJ_SQM_LIMBS; k = k + 1) { store64(acc + 8 * k, load64(&rb + 8 * k)); }
        }
        side = side + 1;
    }
    # S: R = ⌊√(P·2^S/Q)⌋ near 2^56, with E − S even.
    var bp = _bj_sqm_bitlen(&pb);
    var bq = _bj_sqm_bitlen(&qb);
    var s = 112 - bp + bq;
    if (((ee - s) & 1) != 0) { s = s + 1; }
    var ab[96];
    var bb[96];
    for (var k2 = 0; k2 < _BJ_SQM_LIMBS; k2 = k2 + 1) {
        store64(&ab + 8 * k2, load64(&pb + 8 * k2));
        store64(&bb + 8 * k2, load64(&qb + 8 * k2));
    }
    if (s >= 0) { _bj_sqm_shl(&ab, s); } else { _bj_sqm_shl(&bb, 0 - s); }
    # The estimate: the significands' root by _bj_sqm_dd, scaled by 2^h (A/B = (Π sₙ/Π s_d)·2^(52·(nn − nd) + s)).
    var sn: f64[3];
    var sd: f64[4];
    var g = 52 * (nn - nd) + s;
    var p52: f64 = 0x3CB0000000000000;      # 2⁻⁵²: each M as its significand in [1, 2), exactly
    for (var i2 = 0; i2 < nn; i2 = i2 + 1) {
        var m2, e2 = _bj_k_f64_int(load64(num + 8 * i2));
        var mf: f64 = f64_from(m2);
        sn[i2] = mf * p52;
    }
    for (var i3 = 0; i3 < nd; i3 = i3 + 1) {
        var m3, e3 = _bj_k_f64_int(load64(den + 8 * i3));
        var mf3: f64 = f64_from(m3);
        sd[i3] = mf3 * p52;
    }
    var nh, nl = _bj_k_mono_prod(&sn, nn);
    var dh, dl = _bj_k_mono_prod(&sd, nd);
    if ((g & 1) != 0) {
        nh = nh * 2.0;
        nl = nl * 2.0;
        g = g - 1;
    }
    var y0, d = _bj_sqm_dd(nh, nl, dh, dl);
    var sc: f64 = _bj_k_cr_pow2(g / 2);     # 2^h, h ≤ 57 + … : the root near 2^56
    var gy: f64 = y0 * sc;
    var gd: f64 = d * sc;
    var rr = f64_to(gy) + f64_to(gd);
    # R: the largest integer with R²·B ≤ A.
    var wb[96];
    var w2[96];
    var t1[96];
    var t2[96];
    _bj_sqm_sq_mul(&wb, rr, &bb, &t1, &t2);
    while (_bj_sqm_cmp(&wb, &ab) > 0) {
        rr = rr - 1;
        _bj_sqm_sq_mul(&wb, rr, &bb, &t1, &t2);
    }
    var up = 1;
    while (up == 1) {
        _bj_sqm_sq_mul(&w2, rr + 1, &bb, &t1, &t2);
        if (_bj_sqm_cmp(&w2, &ab) > 0) { up = 0; } else { rr = rr + 1; }
    }
    _bj_sqm_sq_mul(&wb, rr, &bb, &t1, &t2);
    var sticky = 0;
    if (_bj_sqm_cmp(&wb, &ab) != 0) { sticky = 1; }
    var r: f64 = _bj_k_cr_from_int(2 * rr + sticky, (ee - s) / 2 - 1);
    return r;
}

# RN(√(Π num / Π den)), correctly rounded (the section comment), for at most _BJ_SQM_NMAX positive finite numerator
# and _BJ_SQM_DMAX denominator factors: the fast path, then the exact path where it declines; NaN outside the domain.
#must_use
fn _bj_cr_sqrt_mono(num, nn, den, nd): f64 {
    var r, ok = _bj_cr_sqrt_mono_fast(num, nn, den, nd);
    if (ok == 1) { return r; }
    var a: f64 = _bj_cr_sqrt_mono_acc(num, nn, den, nd);
    return a;
}

# ── RN(x₁·…·xₙ) of full-precision doubles (M2 part 2b-3) ───────────────────────────────────────────────────────────

# kimiya's _bj_k_cr_mono holds four 53-bit significands and a 41-bit integer per side in its exact path, and gives NaN
# past it; a product of five full-precision doubles (circuit's solenoid μ·n·n·A·l) needs 265 bits. This exact path
# multiplies the integer significands M (x = M·2^E, kimiya's _bj_k_f64_int) in bijli's limbs (below 2^318 for six),
# keeps the top 60 bits T of the product P and a sticky bit for the rest, and _bj_k_cr_from_int rounds
# (2T + sticky)·2^(K − 1) once (P = T·2^K + rest): the binade's grid or the subnormal one, ties to even, +∞ past
# DBL_MAX. The rounding keeps at most 53 of 2T + sticky's 61 bits, so the sticky bit lies below every rounding position
# and stands for the rest exactly (an exact tie has rest = 0). `cr_verify.py`'s prod5 families check it.

# RN(x₀·…·x_(n−1)) for 1 ≤ n ≤ 6 finite doubles, exactly; a zero factor gives IEEE's signed zero (the xor of the signs),
# NaN outside the domain.
#must_use
fn _bj_cr_prod_acc(x, n): f64 {
    var nan: f64 = _bj_k_nan();
    if (n < 1 || n > 6) { return nan; }
    var p[96];
    var t[96];
    var r[96];
    _bj_sqm_set(&p, 1);
    var neg = 0;
    var zero = 0;
    var e = 0;
    for (var i = 0; i < n; i = i + 1) {
        var b = load64(x + 8 * i);
        neg = neg ^ (b >> 63);
        var a = b & 0x7FFFFFFFFFFFFFFF;
        if ((a >> 52) == 0x7FF) { return nan; }
        if (a == 0) {
            zero = 1;
            continue;
        }
        var m, ee = _bj_k_f64_int(a);
        e = e + ee;
        _bj_sqm_set(&t, m);
        _bj_sqm_mul(&r, &p, &t);
        for (var k = 0; k < _BJ_SQM_LIMBS; k = k + 1) { store64(&p + 8 * k, load64(&r + 8 * k)); }
    }
    if (zero == 1) {
        var z: f64 = 0.0;
        if (neg == 1) { z = -z; }
        return z;
    }
    var len = _bj_sqm_bitlen(&p);
    var mm = load64(&p) | (load64(&p + 8) << 32);
    var s = e;
    if (len > 61) {
        var sh = len - 60;
        var top = 0;
        for (var j = 0; j < 60; j = j + 1) {
            var pos = sh + j;
            var bit = (load64(&p + 8 * (pos / 32)) >> (pos % 32)) & 1;
            top = top | (bit << j);
        }
        var sticky = 0;
        var w = sh / 32;
        for (var k2 = 0; k2 < w; k2 = k2 + 1) {
            if (load64(&p + 8 * k2) != 0) { sticky = 1; }
        }
        var low = load64(&p + 8 * w) & ((1 << (sh % 32)) - 1);
        if (low != 0) { sticky = 1; }
        mm = 2 * top + sticky;
        s = e + sh - 1;
    }
    var rr: f64 = _bj_k_cr_from_int(mm, s);
    if (neg == 1) { rr = -rr; }
    return rr;
}

# RN(a·b·c·d·f), correctly rounded for any five finite doubles: kimiya's fast path (_bj_k_mul5_fast, its error budget
# independent of the factors' sizes), then _bj_cr_prod_acc where it declines (a subnormal factor or result, or a value
# within about 2^-100 of a midpoint); NaN outside the domain.
#must_use
fn _bj_cr_mul5(a: f64, b: f64, c: f64, d: f64, f: f64): f64 {
    var r, ok = _bj_k_mul5_fast(a, b, c, d, f);
    if (ok == 1) { return r; }
    var nb: f64[5];
    nb[0] = a;
    nb[1] = b;
    nb[2] = c;
    nb[3] = d;
    nb[4] = f;
    var g: f64 = _bj_cr_prod_acc(&nb, 5);
    return g;
}

# ── RN(Π num / Π den) for up to six factors a side (M2 part 2b-4) ──────────────────────────────────────────────────

# kimiya's _bj_k_cr_mono takes at most six numerator and four denominator factors; relativity's Larmor power
# q²a²/(6πε₀c³) has six below (6, π, ε₀ and c three times; no exact rewrite merges them to four: 6c is a double, but
# c², 6c², πε₀ are not). These are kimiya's steps without the count limit:
# - the fast path: _bj_k_mono_sig splits each side into its significands other than 1 (in [1, 2)) and the sum of
#   exponents; _bj_k_mono_prod makes N and D normalised double-doubles (exact for up to two significands, then
#   3.01u² relative per further one by _bj_k_dd_mul_d), so with six a side each is within 12.04u² and the two within
#   24.08u², inside _bj_k_dd_div_ends's 32u² budget (N and D in [1, 2⁶), the quotient in (2⁻⁶, 2⁶)); z₁ = z₂ proves
#   RN(N/D), and _bj_k_mono_fin scales it by 2^(Σe_num − Σe_den), exactly for a normal result, ±∞ past DBL_MAX,
#   declining a possibly subnormal one. A failed test (a value within about 2⁻⁹⁸ of a midpoint) declines too.
# - the exact path: each side's integer significands (kimiya's _bj_k_f64_int, trailing zeros dropped) multiplied in
#   kimiya's multi-word integers, and _bj_k_cr_ratio rounds P/Q·2^E once. Its capacity is kimiya's: 253 bits a side
#   (four full-precision doubles and a 41-bit integer, or the Larmor power's 212 over 192), NaN past it.
# `cr_verify.py`'s mono_wide families check both against exact rationals.

# The exact path alone: RN(Π num / Π den) for 0 ≤ nn, nd ≤ 6 finite doubles (a zero numerator factor gives IEEE's
# signed zero), NaN outside the domain (a non-finite factor, a zero denominator factor, more than six a side, past
# 253 bits a side).
#must_use
fn _bj_cr_mono_wide_acc(num, nn, den, nd): f64 {
    var nan: f64 = _bj_k_nan();
    if (nn < 0 || nd < 0 || nn > 6 || nd > 6) { return nan; }
    var pb[64];
    var qb[64];
    var tb[64];
    var rb[64];
    var neg = 0;
    var zero = 0;
    var ee = 0;
    var side = 0;
    while (side < 2) {
        var p = num;
        var n = nn;
        var acc = &pb;
        if (side == 1) {
            p = den;
            n = nd;
            acc = &qb;
        }
        _bj_k_bn_set(acc, 1);
        var bits = 0;
        var i = 0;
        while (i < n) {
            var b = load64(p + 8 * i);
            neg = neg ^ (b >> 63);
            var a = b & 0x7FFFFFFFFFFFFFFF;
            if ((a >> 52) == 0x7FF) { return nan; }
            if (a == 0) {
                if (side == 1) { return nan; }
                zero = 1;
            } else {
                var mm, e = _bj_k_f64_int(a);
                while ((mm & 1) == 0) {
                    mm = mm >> 1;
                    e = e + 1;
                }
                var t = mm;
                while (t != 0) {
                    t = t >> 1;
                    bits = bits + 1;
                }
                if (side == 0) { ee = ee + e; } else { ee = ee - e; }
                _bj_k_bn_set(&tb, mm);
                _bj_k_bn_mul(&rb, acc, &tb);
                _bj_k_bn_copy(acc, &rb);
            }
            i = i + 1;
        }
        if (bits > 253) { return nan; }
        side = side + 1;
    }
    var r: f64 = 0.0;
    if (zero == 0) { r = _bj_k_cr_ratio(&pb, &qb, ee); }
    if (neg == 1) { r = -r; }
    return r;
}

# RN(Π num / Π den), correctly rounded, for 0 ≤ nn, nd ≤ 6 finite doubles within the exact path's capacity: the fast
# path, then the exact path where it declines; NaN outside the domain.
#must_use
fn _bj_cr_mono_wide(num, nn, den, nd): f64 {
    var nan: f64 = _bj_k_nan();
    if (nn < 0 || nd < 0 || nn > 6 || nd > 6) { return nan; }
    var sn: f64[6];
    var sd: f64[6];
    var gfn, cn, en = _bj_k_mono_sig(num, nn, &sn);
    var gfd, cd, ed = _bj_k_mono_sig(den, nd, &sd);
    if ((gfn >> 1) == 2 || (gfd >> 1) != 0) { return nan; }
    var neg = (gfn ^ gfd) & 1;
    if ((gfn >> 1) == 1) {
        var z: f64 = 0.0;
        if (neg == 1) { z = -z; }
        return z;
    }
    var nh, nl = _bj_k_mono_prod(&sn, cn);
    var dh, dl = _bj_k_mono_prod(&sd, cd);
    var z1, z2 = _bj_k_dd_div_ends(nh, nl, dh, dl);
    if (z1 == z2) {
        var y: f64 = z1;
        var r, ok = _bj_k_mono_fin(y, en - ed, neg);
        if (ok == 1) { return r; }
    }
    var a: f64 = _bj_cr_mono_wide_acc(num, nn, den, nd);
    return a;
}

# --- crmath_ux_data.cyr ---

# crmath_ux_data.cyr — 2/π for src/crmath_ux.cyr's Payne–Hanek reduction of a 53-bit angle past DBL_MAX (bijli,
# M1 parts 5c-2 and 5d-3). Generated by scripts/oracle/crtables.py's render_ux (python3 -I scripts/oracle/validate.py
# . --write) from π computed exactly to 2800 bits and checked against MPFR; do not edit.

# 2/π in 96 chunks of 28 bits: chunk n is bits 28n + 1 … 28n + 28 after the binary point.
var _bj_ux_2opi[768];
var _bj_ux_ready = 0;

# Fills the table, once.
fn _bj_ux_load() {
    if (_bj_ux_ready == 1) { return 0; }
    store64(&_bj_ux_2opi + 0, 0xA2F9836);
    store64(&_bj_ux_2opi + 8, 0xE4E4415);
    store64(&_bj_ux_2opi + 16, 0x29FC275);
    store64(&_bj_ux_2opi + 24, 0x7D1F534);
    store64(&_bj_ux_2opi + 32, 0xDDC0DB6);
    store64(&_bj_ux_2opi + 40, 0x295993C);
    store64(&_bj_ux_2opi + 48, 0x439041F);
    store64(&_bj_ux_2opi + 56, 0xE5163AB);
    store64(&_bj_ux_2opi + 64, 0xDEBBC56);
    store64(&_bj_ux_2opi + 72, 0x1B7246E);
    store64(&_bj_ux_2opi + 80, 0x3A424DD);
    store64(&_bj_ux_2opi + 88, 0x2E00649);
    store64(&_bj_ux_2opi + 96, 0x2EEA09D);
    store64(&_bj_ux_2opi + 104, 0x1921CFE);
    store64(&_bj_ux_2opi + 112, 0x1DEB1CB);
    store64(&_bj_ux_2opi + 120, 0x129A73E);
    store64(&_bj_ux_2opi + 128, 0xE88235F);
    store64(&_bj_ux_2opi + 136, 0x52EBB44);
    store64(&_bj_ux_2opi + 144, 0x84E99C7);
