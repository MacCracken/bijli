        var cd0, cd1, cd2 = _bj_k_td_mul_d(d0, d1, d2, c);
        var x0, x1, x2 = _bj_k_td_add(n0, n1, n2, -cd0, -cd1, -cd2);
        var cn0, cn1, cn2 = _bj_k_td_mul_d(n0, n1, n2, c);
        var y0, y1, y2 = _bj_k_td_add(d0, d1, d2, cn0, cn1, cn2);
        a0 = x0;
        a1 = x1;
        a2 = x2;
        b0 = y0;
        b1 = y1;
        b2 = y2;
    }
    var db: f64[3];
    _bj_k_td_div(a0, a1, a2, b0, b1, b2, &db);
    var dh: f64 = db[0];
    var dm: f64 = db[1];
    var dl: f64 = db[2];
    var wh, wm, wl = _bj_k_td_mul(dh, dm, dl, dh, dm, dl);
    var ph: f64 = load64(&_BJ_K_CR_ATAN_ACC + 168);  # 1/17 (index 3·(8 − 1))
    var pm: f64 = load64(&_BJ_K_CR_ATAN_ACC + 176);
    var pl: f64 = load64(&_BJ_K_CR_ATAN_ACC + 184);
    var k = 7;
    while (k >= 1) {                              # (−1)^k/(2k + 1) + w·P
        var th, tm, tl = _bj_k_td_mul(ph, pm, pl, wh, wm, wl);
        var off = (k - 1) * 24;
        var ch: f64 = load64(&_BJ_K_CR_ATAN_ACC + off);
        var cm: f64 = load64(&_BJ_K_CR_ATAN_ACC + off + 8);
        var cl: f64 = load64(&_BJ_K_CR_ATAN_ACC + off + 16);
