        return re;
    }
    var L[112];
    var M[112];
    var P[112];
    var ls = _bj_cr_log_fx(&L, x);
    # |y| = my·2^q with 1 ≤ my < 2 (y is normal here: |y·log x| ≥ 2^-60 and |log x| < 746).
    var wy = _bj_cr_word(y) & 9223372036854775807;
    var q = ((wy >> 52) & 2047) - 1023;
