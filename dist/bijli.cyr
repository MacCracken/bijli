        var p2 = 1 << s;
        if (u % p2 != 0) { return 0; }
        var us = u / p2;
        if (a == 1) {
            e = us * yn;
        } else {
            if (yn < 0 || s > 5) { return 0; }
            var c = a;
            for (var j = 0; j < s; j = j + 1) {
                var r = _bj_cr_isqrt(c);
                if (r * r != c) { return 0; }
                c = r;
            }
            if (yn > 63) { return 0; }
            n = _bj_cr_ipow(c, yn);
            if (n == 0) { return 0; }
            e = us * yn;
