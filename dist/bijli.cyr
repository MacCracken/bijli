# --- crmath.cyr ---

# crmath.cyr — correctly rounded exp, sin, cos, tan, sinh, cosh, hypot, pow and atan2 (impetus ADR 0011 and its
# amendments; hypot, pow and atan2 have their own sections after exp, sin and cos).
# Copied from impetus's src/crmath.cyr (its ADR 0011) with the prefixes renamed (_im_cr_ → _bj_cr_, _IM_ → _BJ_);
# bijli's ADR 0001 adopts it. Keep the two in step: a fix in one is a fix for the other. The tan section, after
# cos, is bijli's own (M1 part 1c), built on impetus's sin and cos phases and reduction; so is the sinh and cosh
# section after it (M1 part 2d), on impetus's exp phases and slow path.
#
# Round-to-nearest-even of the exact mathematical value, on every input, the same bits on every
# target: only + − × ÷, the f64 rounding builtins and integer operations, no x87 and no polyfill.
# Each function follows Ziv's strategy, three phases, each result returned only when a rounding test,
# with an error bound a few bits wider than the evaluation's, shows that every value within the bound
# rounds to the same double:
# - phase 1, table-driven in double with a few exact products (2^(j/64) for exp, sin and cos of i/64),
#   bound 2^-62 (measured worst 2^-66 to 2^-67): decides about 99.7 % of arguments, at about 2× the
#   polyfills' cost;
# - phase 2, in double-double (about 2^-100 relative), bounds 2^-88 and 2^-74;
# - phase 3, the slow path in 364-bit fixed point (14 limbs of 28 bits), with Payne–Hanek reduction
#   for sin and cos against 1,568 bits of 2/π, whose result is rounded once.
# The slow path's error is below 2^-290 relative. A double argument is never that close to a
# rounding boundary of exp, sin or cos: the hardest cases are known to need about 2^-120
# (Lefèvre–Muller), and there are no exact midpoints (Lindemann–Weierstrass). Tables:
# src/crmath_data.cyr, generated by scripts/oracle/crtables.py.

# ── fixed point: 14 limbs of 28 bits, limb 0 the integer part ──────────────────────
# A number is a 112-byte buffer; limb j weighs 2^(-28j). Values here are non-negative and below 2^27.

const _BJ_CR_L = 14;
const _BJ_CR_MASK = 268435455;

# The word of an f64 (an untyped parameter, an i64 return).
#must_use
fn _bj_cr_word(x): i64 {
    return x;
}

# The f64 whose bits are the word w.
#must_use
fn _bj_cr_from_word(w): f64 {
    var b[8];
    store64(&b, w);
    var r: f64 = load64(&b);
    return r;
}

# Limb j of fixed-point number a.
#must_use
fn _bj_cr_limb(a, j): i64 {
    return load64(a + j * 8);
}

# a = 0.
fn _bj_cr_zero(a) {
    for (var j = 0; j < _BJ_CR_L; j = j + 1) { store64(a + j * 8, 0); }
    return 0;
}

# 1 when a is 0.
#must_use
fn _bj_cr_is_zero(a): i64 {
    for (var j = 0; j < _BJ_CR_L; j = j + 1) {
        if (load64(a + j * 8) != 0) { return 0; }
    }
    return 1;
}

# −1, 0 or 1 as a < b, a = b, a > b.
#must_use
fn _bj_cr_cmp(a, b): i64 {
    for (var j = 0; j < _BJ_CR_L; j = j + 1) {
        var x = load64(a + j * 8);
        var y = load64(b + j * 8);
        if (x < y) { return 0 - 1; }
        if (x > y) { return 1; }
    }
    return 0;
}

# d = a + b (d may be a or b).
fn _bj_cr_add(d, a, b) {
    var carry = 0;
    var j = _BJ_CR_L - 1;
    while (j >= 0) {
        var t = load64(a + j * 8) + load64(b + j * 8) + carry;
        if (j > 0) {
            store64(d + j * 8, t & _BJ_CR_MASK);
            carry = t >> 28;
        } else {
            store64(d, t);
        }
        j = j - 1;
    }
    return 0;
}

# d = a − b, for a ≥ b (d may be a or b).
fn _bj_cr_sub(d, a, b) {
    var borrow = 0;
    var j = _BJ_CR_L - 1;
    while (j >= 0) {
        var t = load64(a + j * 8) - load64(b + j * 8) - borrow;
        borrow = 0;
        if (t < 0 && j > 0) {
            t = t + 268435456;
            borrow = 1;
        }
        store64(d + j * 8, t);
        j = j - 1;
    }
    return 0;
}

# d = a·b, truncated to 13 fraction limbs (d may be a or b). Column sums stay below 2^60.
fn _bj_cr_mul(d, a, b) {
    var col[128];
    var n = _BJ_CR_L + 2;
    for (var p = 0; p < n; p = p + 1) { store64(&col + p * 8, 0); }
    for (var i = 0; i < _BJ_CR_L; i = i + 1) {
        var ai = load64(a + i * 8);
        if (ai != 0) {
            var k = 0;
            while (k < _BJ_CR_L && i + k < n) {
                var at = &col + (i + k) * 8;
                store64(at, load64(at) + ai * load64(b + k * 8));
                k = k + 1;
            }
        }
    }
    var p2 = n - 1;
    while (p2 > 0) {
        var v = load64(&col + p2 * 8);
        store64(&col + (p2 - 1) * 8, load64(&col + (p2 - 1) * 8) + (v >> 28));
        store64(&col + p2 * 8, v & _BJ_CR_MASK);
        p2 = p2 - 1;
    }
    for (var j = 0; j < _BJ_CR_L; j = j + 1) { store64(d + j * 8, load64(&col + j * 8)); }
    return 0;
}

# d = a·s for a small integer 0 ≤ s < 2^28 (d may be a).
fn _bj_cr_mul_small(d, a, s) {
    var carry = 0;
    var j = _BJ_CR_L - 1;
    while (j >= 0) {
        var t = load64(a + j * 8) * s + carry;
        if (j > 0) {
            store64(d + j * 8, t & _BJ_CR_MASK);
            carry = t >> 28;
        } else {
            store64(d, t);
        }
        j = j - 1;
    }
    return 0;
}

# d = a / s, truncated, for a small integer 0 < s < 2^28 (d may be a).
fn _bj_cr_div_small(d, a, s) {
    var r = 0;
    for (var j = 0; j < _BJ_CR_L; j = j + 1) {
        var cur = (r << 28) + load64(a + j * 8);
        store64(d + j * 8, cur / s);
        r = cur % s;
    }
    return 0;
}

# a = x, exactly, for 0 ≤ x < 2^27 whose lowest set bit is at or above 2^-364.
fn _bj_cr_set(a, x: f64) {
    _bj_cr_zero(a);
    var w = _bj_cr_word(x);
    var ef = (w >> 52) & 2047;
    if (ef == 0) { return 0; }
    var m = (w & 4503599627370495) | 4503599627370496;
    var e = ef - 1075;
    for (var j = 0; j < _BJ_CR_L; j = j + 1) {
        var s = e + 28 * j;
        var v = 0;
        if (s >= 0) {
            if (s < 28) { v = (m << s) & _BJ_CR_MASK; }
        } elif (0 - s < 53) {
            v = (m >> (0 - s)) & _BJ_CR_MASK;
        }
        store64(a + j * 8, v);
    }
    return 0;
}

# Bit q (the bit of weight 2^q, q ≤ 27) of a.
#must_use
fn _bj_cr_bit(a, q): i64 {
    var j = (27 - q) / 28;
    if (j >= _BJ_CR_L) { return 0; }
    return (load64(a + j * 8) >> (q + 28 * j)) & 1;
}

# 1 when a has a set bit of weight below 2^q.
#must_use
fn _bj_cr_sticky(a, q): i64 {
    var j = (27 - q) / 28;
    if (j >= _BJ_CR_L) { return 0; }
    var pos = q + 28 * j;
    if ((load64(a + j * 8) & ((1 << pos) - 1)) != 0) { return 1; }
    for (var i = j + 1; i < _BJ_CR_L; i = i + 1) {
        if (load64(a + i * 8) != 0) { return 1; }
    }
    return 0;
}

# The double nearest a·2^k (ties to even), negated when neg is 1, for a > 0 whose integer part is
# below 2^28: normal, subnormal, or ±∞ on overflow.
#must_use
fn _bj_cr_round(a, k, neg): f64 {
    var j0 = 0;
    while (j0 < _BJ_CR_L && load64(a + j0 * 8) == 0) { j0 = j0 + 1; }
    var sign = 0;
    if (neg == 1) { sign = 0 - 9223372036854775807 - 1; }
    if (j0 == _BJ_CR_L) { return _bj_cr_from_word(sign); }
    var v = load64(a + j0 * 8);
    var b = 0;
    while ((v >> (b + 1)) != 0) { b = b + 1; }
    var top = b - 28 * j0;
    var ex = top + k;
    var p = 53;
    if (ex < 0 - 1022) { p = ex + 1075; }
    if (p < 0) { return _bj_cr_from_word(sign); }
    var mant = 0;
    for (var i = 0; i < p; i = i + 1) { mant = (mant << 1) | _bj_cr_bit(a, top - i); }
    var rb = _bj_cr_bit(a, top - p);
    var st = _bj_cr_sticky(a, top - p);
    if (rb == 1 && (st == 1 || (mant & 1) == 1)) { mant = mant + 1; }
    if (ex < 0 - 1022) {
        # Subnormal (or the carry into the smallest normal): the bits are the count of 2^-1074.
        return _bj_cr_from_word(sign | mant);
    }
    if (mant == 9007199254740992) {
        mant = 4503599627370496;
        ex = ex + 1;
    }
    if (ex > 1023) { return _bj_cr_from_word(sign | 9218868437227405312); }
    return _bj_cr_from_word(sign | ((ex + 1023) << 52) | (mant - 4503599627370496));
}

# ── slow paths ──────────────────────────────────────────────────────────────────────

# exp(x), correctly rounded, in fixed point: x = k·ln 2 + r with 0 ≤ r < ln 2, exp(r) by its Taylor
# series, then 2^k. For finite x with 2^-55 ≤ |x| < 746.
#must_use
fn _bj_cr_exp_slow(x: f64): f64 {
    _bj_cr_load();
    var X[112];
    var ax: f64 = f64_abs(x);
    _bj_cr_set(&X, ax);
    var q: f64 = x * _BJ_CR_INVLN2;
    var neg = 0;
    if (x < 0.0) { neg = 1; }
    var r: f64 = _bj_cr_exp_fx(&X, neg, q, 0);
    return r;
}

# exp(x) for the fixed-point |x| = X (below 746), x negative when neg is 1, correctly rounded (and
# negated when rneg is 1), with q an estimate of x/ln 2 within 1: the reduction and the series of
# `_bj_cr_exp_slow`, which pow's slow path shares.
#must_use
fn _bj_cr_exp_fx(X, neg, q: f64, rneg): f64 {
    var A[112];
    var R[112];
    var T[112];
    var S[112];
    var kf: f64 = f64_floor(q);
    var k = f64_to(kf);
    var tries = 0;
    while (tries < 4) {
        var kk = k;
        if (kk < 0) { kk = 0 - kk; }
        _bj_cr_mul_small(&A, &_bj_cr_ln2, kk);
        var lo = 0;
        if (neg == 0) {
            if (_bj_cr_cmp(X, &A) < 0) { lo = 1; } else { _bj_cr_sub(&R, X, &A); }
        } else {
            if (_bj_cr_cmp(&A, X) < 0) { lo = 1; } else { _bj_cr_sub(&R, &A, X); }
        }
        if (lo == 1) {
            k = k - 1;
        } elif (_bj_cr_cmp(&R, &_bj_cr_ln2) >= 0) {
            k = k + 1;
        } else {
            tries = 4;
        }
        tries = tries + 1;
    }
    _bj_cr_zero(&S);
    _bj_cr_zero(&T);
    store64(&S, 1);
    store64(&T, 1);
    for (var n = 1; n < 200; n = n + 1) {
        _bj_cr_mul(&T, &T, &R);
        _bj_cr_div_small(&T, &T, n);
        if (_bj_cr_is_zero(&T) == 1) { break; }
        _bj_cr_add(&S, &S, &T);
    }
    return _bj_cr_round(&S, k, rneg);
}

# Y = (ax·2/π mod 1)·π/2 in fixed point, by Payne–Hanek, and the quadrant floor(ax·2/π) mod 4.
# ax = m·2^e: the 2/π bits that put multiples of 4 into ax·2/π are skipped, and the rest are taken
# in 28-bit chunks aligned so that m·2^d (2 ≤ d ≤ 29, three limbs) times them gives the product's
# limbs directly. For finite ax ≥ π/4.
fn _bj_cr_reduce(Y, ax: f64): i64 {
    var w = _bj_cr_word(ax);
    var ef = (w >> 52) & 2047;
    var m = (w & 4503599627370495) | 4503599627370496;
    var e = ef - 1075;
    var u = ((e - 2) % 28 + 28) % 28;
    var t = e - 2 - u;
    var d = e - t;
    var mk[24];
    store64(&mk, (m << d) & _BJ_CR_MASK);
    if (d >= 28) {
        store64(&mk + 8, (m << (d - 28)) & _BJ_CR_MASK);
    } else {
        store64(&mk + 8, (m >> (28 - d)) & _BJ_CR_MASK);
    }
    store64(&mk + 16, (m >> (56 - d)) & _BJ_CR_MASK);
    var base = t / 28;
    var ncol = _BJ_CR_L + 2;
    var col[128];
    for (var f = 0; f < ncol; f = f + 1) {
        var sum = 0;
        for (var kk = 0; kk < 3; kk = kk + 1) {
            var jj = kk + f - 1;
            var idx = base + jj;
            if (jj >= 0 && idx >= 0 && idx < 56) {
                sum = sum + load64(&mk + kk * 8) * load64(&_bj_cr_2opi + idx * 8);
            }
        }
        store64(&col + f * 8, sum);
    }
    var p = ncol - 1;
    while (p > 0) {
        var v = load64(&col + p * 8);
        store64(&col + (p - 1) * 8, load64(&col + (p - 1) * 8) + (v >> 28));
        store64(&col + p * 8, v & _BJ_CR_MASK);
        p = p - 1;
    }
    var quad = load64(&col) & 3;
    store64(Y, 0);
    for (var j = 1; j < _BJ_CR_L; j = j + 1) { store64(Y + j * 8, load64(&col + j * 8)); }
    _bj_cr_mul(Y, Y, &_bj_cr_pio2);
    return quad;
}

# D = sin(Y) (want_sin 1) or cos(Y) (0) for 0 ≤ Y < π/2, by the Taylor series with the positive and
# negative terms summed apart (both results are non-negative there).
fn _bj_cr_sin_cos_series(D, Y, want_sin) {
    var Y2[112];
    var T[112];
    var P[112];
    var N[112];
    _bj_cr_mul(&Y2, Y, Y);
    _bj_cr_zero(&N);
    if (want_sin == 1) {
        memcpy(&T, Y, 112);
        memcpy(&P, Y, 112);
    } else {
        _bj_cr_zero(&T);
        _bj_cr_zero(&P);
        store64(&T, 1);
        store64(&P, 1);
    }
    for (var n = 1; n < 120; n = n + 1) {
        _bj_cr_mul(&T, &T, &Y2);
        var dv = (2 * n) * (2 * n + 1);
        if (want_sin == 0) { dv = (2 * n - 1) * (2 * n); }
        _bj_cr_div_small(&T, &T, dv);
        if (_bj_cr_is_zero(&T) == 1) { break; }
        if ((n & 1) == 1) { _bj_cr_add(&N, &N, &T); } else { _bj_cr_add(&P, &P, &T); }
    }
    _bj_cr_sub(D, &P, &N);
    return 0;
}

# sin(x) (want_sin 1) or cos(x) (0), correctly rounded, in fixed point, for finite |x| ≥ 2^-27.
#must_use
fn _bj_cr_sin_cos_slow(x: f64, want_sin): f64 {
    _bj_cr_load();
    var Y[112];
    var D[112];
    var ax: f64 = f64_abs(x);
    var quad = 0;
    if (ax < 0.78) {
        _bj_cr_set(&Y, ax);
    } else {
        quad = _bj_cr_reduce(&Y, ax);
    }
    # sin(y + qπ/2) is sin y, cos y, −sin y, −cos y; cos(y + qπ/2) is cos y, −sin y, −cos y, sin y.
    var use_sin = want_sin;
    if ((quad & 1) == 1) { use_sin = 1 - want_sin; }
    var neg = 0;
    if (want_sin == 1 && quad >= 2) { neg = 1; }
    if (want_sin == 0 && (quad == 1 || quad == 2)) { neg = 1; }
    if (want_sin == 1 && x < 0.0) { neg = 1 - neg; }
    _bj_cr_sin_cos_series(&D, &Y, use_sin);
    return _bj_cr_round(&D, 0, neg);
}

# ── double-double (as kimiya's src/mathx.cyr) ───────────────────────────────────────

# a + b = s + e exactly (Knuth's TwoSum).
#must_use
fn _bj_cr_two_sum(a: f64, b: f64): (f64, f64) {
    var s: f64 = a + b;
    var bb: f64 = s - a;
    var e: f64 = (a - (s - bb)) + (b - bb);
    return (s, e);
}

# a + b = s + e exactly, for |a| ≥ |b| or a = 0 (Dekker's FastTwoSum).
#must_use
fn _bj_cr_fast_two_sum(a: f64, b: f64): (f64, f64) {
    var s: f64 = a + b;
    var e: f64 = b - (s - a);
    return (s, e);
}

# a·b = p + e exactly (Dekker's TwoProduct, Veltkamp's 2^27 + 1 split), for |a|, |b| < 2^996 and no
# underflow in e.
#must_use
fn _bj_cr_two_prod(a: f64, b: f64): (f64, f64) {
    var p: f64 = a * b;
    var split: f64 = 134217729.0;
    var ca: f64 = split * a;
    var ah: f64 = ca - (ca - a);
    var al: f64 = a - ah;
    var cb: f64 = split * b;
    var bh: f64 = cb - (cb - b);
    var bl: f64 = b - bh;
    var e: f64 = (al * bl) - (((p - (ah * bh)) - (al * bh)) - (ah * bl));
    return (p, e);
}

# (ah + al) + (bh + bl), renormalised.
#must_use
fn _bj_cr_dd_add(ah: f64, al: f64, bh: f64, bl: f64): (f64, f64) {
    var s, e = _bj_cr_two_sum(ah, bh);
    var t, f = _bj_cr_two_sum(al, bl);
    var e1: f64 = e + t;
    var s1, e2 = _bj_cr_fast_two_sum(s, e1);
    var e3: f64 = e2 + f;
    var s2, e4 = _bj_cr_fast_two_sum(s1, e3);
    return (s2, e4);
}

# (ah + al)·(bh + bl), renormalised.
#must_use
fn _bj_cr_dd_mul(ah: f64, al: f64, bh: f64, bl: f64): (f64, f64) {
    var p, e = _bj_cr_two_prod(ah, bh);
    var cross: f64 = (ah * bl) + (al * bh);
    var e1: f64 = e + cross;
    var s, t = _bj_cr_fast_two_sum(p, e1);
    return (s, t);
}

# (ah + al) / d for a double d ≠ 0.
#must_use
fn _bj_cr_dd_div_d(ah: f64, al: f64, d: f64): (f64, f64) {
    var q1: f64 = ah / d;
    var p, e = _bj_cr_two_prod(q1, d);
    var r: f64 = ((ah - p) - e) + al;
    var q2: f64 = r / d;
    var s, t = _bj_cr_fast_two_sum(q1, q2);
    return (s, t);
}

# 1 when every value within err (≥ 0) of h + l rounds to h: h normal and not near overflow, and
# |l| + err below half the spacing next to h (a quarter of ulp(h) when h is a power of two, where the
# spacing below halves), with a 2^-20 margin for the rounding of the test itself.
#must_use
fn _bj_cr_rounds_to(h: f64, l: f64, err: f64): i64 {
    var w = _bj_cr_word(h) & 9223372036854775807;
    var ef = w >> 52;
    if (ef < 60 || ef > 2040) { return 0; }
    var half: f64 = _bj_cr_from_word((ef - 53) << 52);
    if ((w & 4503599627370495) == 0) { half = half * 0.5; }
    var lim: f64 = half - half * 0.00000095367431640625;
    var al: f64 = f64_abs(l);
    var d: f64 = al + err;
    if (d < lim) { return 1; }
    return 0;
}

# 2^k for −1022 ≤ k ≤ 1023.
#must_use
fn _bj_cr_pow2(k): f64 {
    return _bj_cr_from_word((k + 1023) << 52);
}

# ── exp, sin, cos ───────────────────────────────────────────────────────────────────

# Calls that phase 1 could not decide, and slow-path calls, since start (diagnostics: the tests
# check that phase 1 decides almost every input).
var _bj_cr_phase2_calls = 0;
var _bj_cr_slow_calls = 0;

# Phase 1 of exp, for −708 ≤ x ≤ 709.7, into out: h, l (f64 words) and k, with exp(x) = 2^k·(h + l)
# within 2^-62 relative (the analysis gives about 2^-64.5).
# - n = round(x·64/ln 2), j = n mod 64, k = (n − j)/64; r = x − n·(ln 2/64) as rh + rl: n·hi is exact
#   (hi has 36 bits, |n| < 2^17) and so is x − n·hi (Sterbenz); rl from TwoSum, so r is within
#   2^-77 of exact (the hi + lo split of ln 2/64 times n).
# - exp(r) = 1 + r + r²·q(r), q = 1/2 + r/3! + … + r⁵/7! by Horner in double (|r| ≤ 2^-7.5:
#   truncation 2^-75; r²q within about 2^-67 absolute).
# - exp(x)/2^k = T·(1 + rh + rest), rest = r²q + rl, T = 2^(j/64) as hi + lo: T_hi·rh exactly by
#   TwoProduct (inline, Veltkamp's split), T_hi + its high part by FastTwoSum, everything else in a low
#   word whose roundings sum to about 2^-66.
fn _bj_cr_exp_p1(x: f64, out) {
    _bj_cr_load();
    var qf: f64 = x * _BJ_CR_INV_L64;
    var nf: f64 = f64_round(qf);
    var n = f64_to(nf);
    var j = n & 63;
    var k = (n - j) / 64;
    var hn: f64 = nf * _BJ_CR_L64_HI;
    var t: f64 = x - hn;
    var pn: f64 = nf * _BJ_CR_L64_LO;
    var npn: f64 = -pn;
    # (rh, rl) = TwoSum(t, −n·lo).
    var rh: f64 = t + npn;
    var bb: f64 = rh - t;
    var rl: f64 = (t - (rh - bb)) + (npn - bb);
    var q: f64 = _BJ_CR_F6 + rh * _BJ_CR_F7;
    q = _BJ_CR_F5 + rh * q;
    q = _BJ_CR_F4 + rh * q;
    q = _BJ_CR_F3 + rh * q;
    q = 0.5 + rh * q;
    var rr: f64 = rh * rh;
    var w: f64 = rr * q;
    var rest: f64 = w + rl;
    var th: f64 = load64(&_bj_cr_exp2t + j * 16);
    var tlo: f64 = load64(&_bj_cr_exp2t + j * 16 + 8);
    # (ah, al) = TwoProduct(th, rh).
    var ah: f64 = th * rh;
    var split: f64 = 134217729.0;
    var ca: f64 = split * th;
    var t1: f64 = ca - (ca - th);
    var t2: f64 = th - t1;
    var cb: f64 = split * rh;
    var r1: f64 = cb - (cb - rh);
    var r2: f64 = rh - r1;
    var al: f64 = (t2 * r2) - (((ah - (t1 * r1)) - (t2 * r1)) - (t1 * r2));
    # (s, e) = FastTwoSum(th, ah): |th| ≥ |ah|.
    var s: f64 = th + ah;
    var e: f64 = ah - (s - th);
    var low: f64 = ((e + al) + th * rest) + (tlo + tlo * rh);
    var h: f64 = s + low;
    var l: f64 = low - (h - s);
    store64(out, _bj_cr_word(h));
    store64(out + 8, _bj_cr_word(l));
    store64(out + 16, k);
    return 0;
}

# Phase 2 of exp, for −708 ≤ x ≤ 709.7, into out: h, l and k as phase 1, within 2^-88 relative:
# x = k·ln 2 + r (k·hi exact, r in double-double against a three-part ln 2), exp(r) by 27 Taylor
# terms in double-double.
fn _bj_cr_exp_p2(x: f64, out) {
    var qf: f64 = x * _BJ_CR_INVLN2;
    var kf: f64 = f64_round(qf);
    var k = f64_to(kf);
    var hk: f64 = kf * _BJ_CR_LN2_HI;
    var t: f64 = x - hk;
    var ph, pl = _bj_cr_two_prod(kf, _BJ_CR_LN2_MID);
    var rh, rl = _bj_cr_dd_add(t, 0.0, -ph, -pl);
    var lo: f64 = kf * _BJ_CR_LN2_LO;
    var r2h, r2l = _bj_cr_dd_add(rh, rl, -lo, 0.0);
    var sh: f64 = 1.0;
    var sl: f64 = 0.0;
    var th: f64 = 1.0;
    var tl: f64 = 0.0;
    for (var n = 1; n <= 27; n = n + 1) {
        var mh, ml = _bj_cr_dd_mul(th, tl, r2h, r2l);
        var nf: f64 = f64_from(n);
        var qh, ql = _bj_cr_dd_div_d(mh, ml, nf);
        th = qh;
        tl = ql;
        var ah, al = _bj_cr_dd_add(sh, sl, th, tl);
        sh = ah;
        sl = al;
    }
    store64(out, _bj_cr_word(sh));
    store64(out + 8, _bj_cr_word(sl));
    store64(out + 16, k);
    return 0;
}

# h·2^k for a phase result h in [0.5, 2.1) whose product is a normal double (−1022 ≤ k ≤ 1024).
#must_use
fn _bj_cr_scale(h: f64, k): f64 {
    if (k > 1000) {
        var big: f64 = h * _bj_cr_pow2(1000);
        var bk: f64 = big * _bj_cr_pow2(k - 1000);
        return bk;
    }
    var r: f64 = h * _bj_cr_pow2(k);
    return r;
}

# exp(x), correctly rounded. NaN for NaN, +∞ for +∞ and x above the overflow point, +0 for −∞ and
# x below the underflow point, subnormal results rounded once. For −708 ≤ x ≤ 709.7: phase 1 (the
# 2^(j/64) table, error bound 2^-62), then phase 2 (double-double, 2^-88), each returned only when
# the rounding test decides it, with 2^k by exact scaling; then, or outside that range, the slow
# path.
#must_use
fn _bj_cr_exp(x: f64): f64 {
    if (x != x) { return x; }
    if (x > 710.0) {
        var inf: f64 = _bj_cr_from_word(9218868437227405312);
        return inf;
    }
    if (x < 0.0 - 746.0) { return 0.0; }
    var ax: f64 = f64_abs(x);
    if (ax < 0.0000000000000000277555756156289135105907917022705078125) { return 1.0; }
    if (x >= 0.0 - 708.0 && x <= 709.7) {
        var o[24];
        _bj_cr_exp_p1(x, &o);
        var h1: f64 = load64(&o);
        var l1: f64 = load64(&o + 8);
        var e1: f64 = h1 * 0.00000000000000000021684043449710088680149056017398834228515625;
        if (_bj_cr_rounds_to(h1, l1, e1) == 1) { return _bj_cr_scale(h1, load64(&o + 16)); }
        _bj_cr_phase2_calls = _bj_cr_phase2_calls + 1;
        _bj_cr_exp_p2(x, &o);
        var h2: f64 = load64(&o);
        var l2: f64 = load64(&o + 8);
        var e2: f64 = h2 * 0.0000000000000000000000000032311742677852643549664402;
        if (_bj_cr_rounds_to(h2, l2, e2) == 1) { return _bj_cr_scale(h2, load64(&o + 16)); }
    }
    _bj_cr_slow_calls = _bj_cr_slow_calls + 1;
    var rs: f64 = _bj_cr_exp_slow(x);
    return rs;
}

# cos(r) (want_sin 0) or sin(r) (1) of a double-double |r| ≤ π/4 (+ a rounding), by 16 Taylor terms,
# the last below 2^-128 of the sum (as kimiya's _km_dd_cos_sin).
#must_use
fn _bj_cr_dd_sin_cos(rh: f64, rl: f64, want_sin): (f64, f64) {
    var r2h, r2l = _bj_cr_dd_mul(rh, rl, rh, rl);
    var th: f64 = 1.0;
    var tl: f64 = 0.0;
    var k = 0;
    if (want_sin == 1) {
        th = rh;
        tl = rl;
        k = 1;
    }
    var sh: f64 = th;
    var sl: f64 = tl;
    for (var n = 1; n <= 16; n = n + 1) {
        var mh, ml = _bj_cr_dd_mul(th, tl, r2h, r2l);
        var d: f64 = f64_from((k + 1) * (k + 2));
        var qh, ql = _bj_cr_dd_div_d(mh, ml, d);
        th = -qh;
        tl = -ql;
        var ah, al = _bj_cr_dd_add(sh, sl, th, tl);
        sh = ah;
        sl = al;
        k = k + 2;
    }
    return (sh, sl);
}

# Phase 1 of sin and cos, for 2^-27 ≤ |x| ≤ 2^20, into out: sin x as hi, lo (words 0, 1) and cos x
# (words 2, 3), whichever `want` asks for (1 sin, 2 cos, 3 both), each within 2^-62 relative (the
# analysis gives about 2^-65). 0 when the reduction cancels below 2^-24 (k ≠ 0), else 1.
# - k = round(|x|·2/π), y = |x| − k·π/2 against c1 + c2 + c3 (c1, c2 of 33 bits, so k·c1 and k·c2 are
#   exact): |x| − k·c1 exactly (Sterbenz), the next by TwoSum, k·c3 rounded: y = yh + yl within 2^-96.
# - u = |y| = a + z + ul with a = i/64 (i = round(64u)), |z| ≤ 2^-7, z exact; the table holds sin a and
#   cos a as hi + lo. sin z = z + z³·p(z²) and cos z − 1 = −z²/2 + z⁴·p(z²) in double, z² by TwoProduct
#   so the −z²/2 term is exact; ul enters linearly.
# - sin u = S + C·z + [S·(cos z − 1) + C·(sin z − z + ul) + S_lo + C_lo·z], with C·z by TwoProduct and
#   S + C_hi·z by TwoSum; cos u likewise with −S·z. Every other term's rounding is below 2^-66 of the
#   result (the result is at least S/2, or z itself when i = 0).
fn _bj_cr_sc_p1(x: f64, ax: f64, want, out): i64 {
    _bj_cr_load();
    var qf: f64 = ax * _BJ_CR_TWO_OVER_PI;
    var kf: f64 = f64_round(qf);
    var k = f64_to(kf);
    var uh: f64 = ax;
    var ul: f64 = 0.0;
    var sg = 1;
    if (k != 0) {
        var m1: f64 = kf * _BJ_CR_PIO2_C1;
        var t1: f64 = ax - m1;
        var m2: f64 = kf * _BJ_CR_PIO2_C2;
        var nm2: f64 = -m2;
        var t2: f64 = t1 + nm2;
        var bb: f64 = t2 - t1;
        var e2: f64 = (t1 - (t2 - bb)) + (nm2 - bb);
        var p3: f64 = kf * _BJ_CR_PIO2_C3;
        var lo: f64 = e2 - p3;
        var yh: f64 = t2 + lo;
        var yl: f64 = lo - (yh - t2);
        var ay: f64 = f64_abs(yh);
        if (ay < 0.000000059604644775390625) { return 0; }
        uh = ay;
        ul = yl;
        if (yh < 0.0) {
            sg = 0 - 1;
            ul = -yl;
        }
    }
    var q = k & 3;
    var need_s = 0;
    var need_c = 0;
    if ((want & 1) == 1) {
        if ((q & 1) == 0) { need_s = 1; } else { need_c = 1; }
    }
    if ((want & 2) == 2) {
        if ((q & 1) == 0) { need_c = 1; } else { need_s = 1; }
    }
    var i64f: f64 = uh * 64.0;
    var ri: f64 = f64_round(i64f);
    var i = f64_to(ri);
    var a: f64 = ri * 0.015625;
    var z: f64 = uh - a;
    var shi: f64 = load64(&_bj_cr_sct + i * 32);
    var slo: f64 = load64(&_bj_cr_sct + i * 32 + 8);
    var chi: f64 = load64(&_bj_cr_sct + i * 32 + 16);
    var clo: f64 = load64(&_bj_cr_sct + i * 32 + 24);
    # (zh, zl) = TwoProduct(z, z).
    var split: f64 = 134217729.0;
    var zh: f64 = z * z;
    var cz: f64 = split * z;
    var z1: f64 = cz - (cz - z);
    var z2: f64 = z - z1;
    var zl: f64 = (z2 * z2) - (((zh - (z1 * z1)) - (z2 * z1)) - (z1 * z2));
    var clead: f64 = -0.5 * zh;
    var pc: f64 = _BJ_CR_F4 - zh * _BJ_CR_F6;
    var crest: f64 = (-0.5 * zl + (zh * zh) * pc) - ul * z;
    var ps: f64 = _BJ_CR_F5 - zh * _BJ_CR_F7;
    ps = zh * ps - _BJ_CR_F3;
    var sz: f64 = (z * zh) * ps;
    var szl: f64 = sz + ul;
    var su_h: f64 = 0.0;
    var su_l: f64 = 0.0;
    var cu_h: f64 = 0.0;
    var cu_l: f64 = 0.0;
    var cs1: f64 = split * z;
    var zs1: f64 = cs1 - (cs1 - z);
    var zs2: f64 = z - zs1;
    if (need_s == 1) {
        # (mh, ml) = TwoProduct(C_hi, z); (s0, e0) = TwoSum(S_hi, mh).
        var mh: f64 = chi * z;
        var cc: f64 = split * chi;
        var c1: f64 = cc - (cc - chi);
        var c2: f64 = chi - c1;
        var ml: f64 = (c2 * zs2) - (((mh - (c1 * zs1)) - (c2 * zs1)) - (c1 * zs2));
        var s0: f64 = shi + mh;
        var b0: f64 = s0 - shi;
        var e0: f64 = (shi - (s0 - b0)) + (mh - b0);
        var low: f64 = (((e0 + ml) + shi * clead) + shi * crest) + ((chi * szl + slo) + clo * z);
        su_h = s0 + low;
        su_l = low - (su_h - s0);
    }
    if (need_c == 1) {
        # (nh, nl) = TwoProduct(S_hi, z); (c0, f0) = TwoSum(C_hi, −nh).
        var nh: f64 = shi * z;
        var sc: f64 = split * shi;
        var s1: f64 = sc - (sc - shi);
        var s2: f64 = shi - s1;
        var nl: f64 = (s2 * zs2) - (((nh - (s1 * zs1)) - (s2 * zs1)) - (s1 * zs2));
        var nnh: f64 = -nh;
        var c0: f64 = chi + nnh;
        var b1: f64 = c0 - chi;
        var f0: f64 = (chi - (c0 - b1)) + (nnh - b1);
        var lowc: f64 = (((f0 - nl) + chi * clead) + chi * crest) + ((clo - shi * szl) - slo * z);
        cu_h = c0 + lowc;
        cu_l = lowc - (cu_h - c0);
    }
    # y = sg·u: sin y = sg·sin u, cos y = cos u. Then by quadrant, then the sign of x for sin.
    if (sg < 0) {
        su_h = -su_h;
        su_l = -su_l;
    }
    var sxh: f64 = su_h;
    var sxl: f64 = su_l;
    var cxh: f64 = cu_h;
    var cxl: f64 = cu_l;
    if ((q & 1) == 1) {
        sxh = cu_h;
        sxl = cu_l;
        cxh = su_h;
        cxl = su_l;
    }
    if (q == 2 || q == 3) {
        sxh = -sxh;
        sxl = -sxl;
    }
    if (q == 1 || q == 2) {
        cxh = -cxh;
        cxl = -cxl;
    }
    if (x < 0.0) {
        sxh = -sxh;
        sxl = -sxl;
    }
    store64(out, _bj_cr_word(sxh));
    store64(out + 8, _bj_cr_word(sxl));
    store64(out + 16, _bj_cr_word(cxh));
    store64(out + 24, _bj_cr_word(cxl));
    return 1;
}

# Phase 2 of sin and cos, for 2^-27 ≤ |x| ≤ 2^20, into out: sin x as hi, lo (words 0, 1), cos x (2, 3)
# and their relative error bounds (4, 5), whichever `want` asks for. k = round(|x|·2/π), y = |x| − k·π/2
# in double-double against a four-part π/2 (k·p1 exact), the 16-term series of y in double-double:
# 2^-74 for sin y and 2^-88 for cos y, swapped with the quadrant. 0 when the reduction cancels below
# |y| = 2^-24 (k ≠ 0), else 1.
fn _bj_cr_sc_p2(x: f64, ax: f64, want, out): i64 {
    var qf: f64 = ax * _BJ_CR_TWO_OVER_PI;
    var kf: f64 = f64_round(qf);
    var k = f64_to(kf);
    var h1: f64 = kf * _BJ_CR_PIO2_1;
    var t: f64 = ax - h1;
    var p2h, p2l = _bj_cr_two_prod(kf, _BJ_CR_PIO2_2);
    var ah, al = _bj_cr_dd_add(t, 0.0, -p2h, -p2l);
    var p3h, p3l = _bj_cr_two_prod(kf, _BJ_CR_PIO2_3);
    var bh, bl = _bj_cr_dd_add(ah, al, -p3h, -p3l);
    var p4: f64 = kf * _BJ_CR_PIO2_4;
    var yh, yl = _bj_cr_dd_add(bh, bl, -p4, 0.0);
    var ay: f64 = f64_abs(yh);
    # A reduction that cancels to |y| < 2^-24 loses the error bound; with k = 0 there is none (y = x).
    if (k != 0 && ay < 0.000000059604644775390625) { return 0; }
    var q = k & 3;
    # Series needed: sin y for an even quadrant's sin or an odd one's cos, cos y otherwise.
    var need_sn = 0;
    var need_cs = 0;
    if ((want & 1) == 1) {
        if ((q & 1) == 0) { need_sn = 1; } else { need_cs = 1; }
    }
    if ((want & 2) == 2) {
        if ((q & 1) == 0) { need_cs = 1; } else { need_sn = 1; }
    }
    var snh: f64 = 0.0;
    var snl: f64 = 0.0;
    var csh: f64 = 0.0;
    var csl: f64 = 0.0;
    if (need_sn == 1) {
        var a1, a2 = _bj_cr_dd_sin_cos(yh, yl, 1);
        snh = a1;
        snl = a2;
    }
    if (need_cs == 1) {
        var b1, b2 = _bj_cr_dd_sin_cos(yh, yl, 0);
        csh = b1;
        csl = b2;
    }
    # sin(y + qπ/2): sin y, cos y, −sin y, −cos y; cos(y + qπ/2): cos y, −sin y, −cos y, sin y.
    var s1h: f64 = snh;
    var s1l: f64 = snl;
    var es: f64 = 0.000000000000000000000052939559203393770;
    var c1h: f64 = csh;
    var c1l: f64 = csl;
    var ec: f64 = 0.0000000000000000000000000032311742677852643549664402;
    if (q == 1 || q == 3) {
        s1h = csh;
        s1l = csl;
        c1h = snh;
        c1l = snl;
        var tmp: f64 = es;
        es = ec;
        ec = tmp;
    }
    if (q == 2 || q == 3) {
        s1h = -s1h;
        s1l = -s1l;
    }
    if (q == 1 || q == 2) {
        c1h = -c1h;
        c1l = -c1l;
    }
    if (x < 0.0) {
        s1h = -s1h;
        s1l = -s1l;
    }
    store64(out, _bj_cr_word(s1h));
    store64(out + 8, _bj_cr_word(s1l));
    store64(out + 16, _bj_cr_word(c1h));
    store64(out + 24, _bj_cr_word(c1l));
    store64(out + 32, _bj_cr_word(es));
    store64(out + 40, _bj_cr_word(ec));
    return 1;
}

# (sin x, cos x), each correctly rounded. sin(±0) = ±0, cos(±0) = 1; NaN for NaN and ±∞. |x| < 2^-27:
# (x, 1) exactly. For |x| ≤ 2^20: phase 1 (the i/64 table, error bound 2^-62), then phase 2
# (double-double, 2^-74 for a sin y and 2^-88 for a cos y), each value returned only when the rounding
# test decides it; then, or for |x| > 2^20, the slow path.
#must_use
fn _bj_cr_sin_cos(x: f64): (f64, f64) {
    var s, c = _bj_cr_sc(x, 3);
    return (s, c);
}

# (sin x, cos x) as _bj_cr_sin_cos, evaluating only what `want` asks for: 1 sin, 2 cos, 3 both (the
# other is returned as 0).
#must_use
fn _bj_cr_sc(x: f64, want): (f64, f64) {
    if (x != x) { return (x, x); }
    var ax: f64 = f64_abs(x);
    var d0: f64 = x - x;
    if (d0 != 0.0) {
        var nan: f64 = d0 / d0;
        return (nan, nan);
    }
    if (ax < 0.000000007450580596923828125) { return (x, 1.0); }
    var sv: f64 = 0.0;
    var cv: f64 = 0.0;
    var wnt = want;
    if (ax <= 1048576.0) {
        var o[48];
        if (_bj_cr_sc_p1(x, ax, wnt, &o) == 1) {
            if ((wnt & 1) == 1) {
                var h1: f64 = load64(&o);
                var a1: f64 = f64_abs(h1);
                var e1: f64 = a1 * 0.00000000000000000021684043449710088680149056017398834228515625;
                if (_bj_cr_rounds_to(h1, load64(&o + 8), e1) == 1) {
                    sv = h1;
                    wnt = wnt - 1;
                }
            }
            if ((wnt & 2) == 2) {
                var h2: f64 = load64(&o + 16);
                var a2: f64 = f64_abs(h2);
                var e2: f64 = a2 * 0.00000000000000000021684043449710088680149056017398834228515625;
                if (_bj_cr_rounds_to(h2, load64(&o + 24), e2) == 1) {
                    cv = h2;
                    wnt = wnt - 2;
                }
            }
            if (wnt == 0) { return (sv, cv); }
        }
        _bj_cr_phase2_calls = _bj_cr_phase2_calls + 1;
        if (_bj_cr_sc_p2(x, ax, wnt, &o) == 1) {
            var es: f64 = load64(&o + 32);
            var ec: f64 = load64(&o + 40);
            if ((wnt & 1) == 1) {
                var h3: f64 = load64(&o);
                var a3: f64 = f64_abs(h3);
                var e3: f64 = a3 * es;
                if (_bj_cr_rounds_to(h3, load64(&o + 8), e3) == 1) {
                    sv = h3;
                    wnt = wnt - 1;
                }
            }
            if ((wnt & 2) == 2) {
                var h4: f64 = load64(&o + 16);
                var a4: f64 = f64_abs(h4);
                var e4: f64 = a4 * ec;
                if (_bj_cr_rounds_to(h4, load64(&o + 24), e4) == 1) {
                    cv = h4;
                    wnt = wnt - 2;
                }
            }
        }
    }
    if ((wnt & 1) == 1) {
        _bj_cr_slow_calls = _bj_cr_slow_calls + 1;
        sv = _bj_cr_sin_cos_slow(x, 1);
    }
    if ((wnt & 2) == 2) {
        _bj_cr_slow_calls = _bj_cr_slow_calls + 1;
        cv = _bj_cr_sin_cos_slow(x, 0);
    }
    return (sv, cv);
}

# sin(x), correctly rounded (see _bj_cr_sin_cos).
#must_use
fn _bj_cr_sin(x: f64): f64 {
    var s, c = _bj_cr_sc(x, 1);
    var r: f64 = s;
    return r;
}

# cos(x), correctly rounded (see _bj_cr_sin_cos).
#must_use
fn _bj_cr_cos(x: f64): f64 {
    var s, c = _bj_cr_sc(x, 2);
    var r: f64 = c;
    return r;
}

# ── tan (bijli's, M1 part 1c: not in impetus's file) ───────────────────────────────
# tan x = sin x / cos x on the phases and the reduction above. A quotient of two rounded values is not
# correctly rounded, so both are kept unrounded (double-double, or fixed point), divided, and rounded once.

# Calls that phase 1 could not decide, and slow-path calls, since start (diagnostics, as for sin and cos).
var _bj_cr_tan_phase2_calls = 0;
var _bj_cr_tan_slow_calls = 0;

# tan x, correctly rounded, in fixed point, for finite |x| ≥ 2^-27. Y = |x| reduced into [0, π/2) with its
# quadrant q (Y = |x| below 0.78), S = sin Y and C = cos Y by the series; tan |x| is S/C for an even q and −C/S
# for an odd one. The divisor M is scaled by 2^e into [2, 4) (e from its double estimate), its reciprocal taken
# by Newton, and the quotient N/(M·2^e) < 1/2 rounded once at 2^e. No double is within 2^-61 of a multiple of
# π/2, so M and N are at least about 2^-61, and their absolute error (a few 2^-360) stays below 2^-290
# relative.
#must_use
fn _bj_cr_tan_slow(x: f64): f64 {
    _bj_cr_load();
    var Y[112];
    var S[112];
    var C[112];
    var D[112];
    var R[112];
    var Q[112];
    var ax: f64 = f64_abs(x);
    var quad = 0;
    if (ax < 0.78) {
        _bj_cr_set(&Y, ax);
    } else {
        quad = _bj_cr_reduce(&Y, ax);
    }
    _bj_cr_sin_cos_series(&S, &Y, 1);
    _bj_cr_sin_cos_series(&C, &Y, 0);
    # tan(y + qπ/2) is tan y for an even q and −cot y for an odd one; tan is odd.
    var num = &S;
    var den = &C;
    var neg = 0;
    if ((quad & 1) == 1) {
        num = &C;
        den = &S;
        neg = 1;
    }
    if (x < 0.0) { neg = 1 - neg; }
    var md: f64 = _bj_cr_round(den, 0, 0);
    var e = 1 - _bj_cr_ilogb(md);
    _bj_cr_shift(&D, den, e);
    var dd: f64 = _bj_cr_ldexp(md, e);
    _bj_cr_recip(&R, &D, dd);
    _bj_cr_mul(&Q, num, &R);
    var r: f64 = _bj_cr_round(&Q, e, neg);
    return r;
}

# tan x, correctly rounded. tan(±0) = ±0; NaN for NaN and ±∞; |x| < 2^-27 gives x itself (tan x − x is about
# x³/3, below half an ulp of x). For |x| ≤ 2^20, Ziv's phases on sin and cos:
# - phase 1 gives both within 2^-62 relative, so their double-double quotient is within 2^-60 (2^-62 + 2^-62
#   + the division's 2^-100, rounded up);
# - phase 2 gives them within es and ec (2^-74 and 2^-88, swapped by quadrant), the quotient within
#   es + ec + 2^-98;
# each returned only when the rounding test decides it. Then, or for |x| > 2^20, the slow path.
#must_use
fn _bj_cr_tan(x: f64): f64 {
    if (x != x) { return x; }
    var d0: f64 = x - x;
    if (d0 != 0.0) {
        var nan: f64 = d0 / d0;
        return nan;
    }
    var ax: f64 = f64_abs(x);
    if (ax < 0.000000007450580596923828125) { return x; }
    if (ax <= 1048576.0) {
        var o[48];
        if (_bj_cr_sc_p1(x, ax, 3, &o) == 1) {
            var h1, l1 = _bj_cr_dd_div(load64(&o), load64(&o + 8), load64(&o + 16), load64(&o + 24));
            var t1: f64 = h1;
            var u1: f64 = l1;
            var a1: f64 = f64_abs(t1);
            var e1: f64 = a1 * 0.000000000000000000867361737988403547205962240695953369140625;
            if (_bj_cr_rounds_to(t1, u1, e1) == 1) { return t1; }
        }
        _bj_cr_tan_phase2_calls = _bj_cr_tan_phase2_calls + 1;
        if (_bj_cr_sc_p2(x, ax, 3, &o) == 1) {
            var h2, l2 = _bj_cr_dd_div(load64(&o), load64(&o + 8), load64(&o + 16), load64(&o + 24));
            var t2: f64 = h2;
            var u2: f64 = l2;
            var es: f64 = load64(&o + 32);
            var ec: f64 = load64(&o + 40);
            var e98: f64 = _bj_cr_pow2(0 - 98);
            var eb: f64 = (es + ec) + e98;
            var a2: f64 = f64_abs(t2);
            var e2: f64 = a2 * eb;
            if (_bj_cr_rounds_to(t2, u2, e2) == 1) { return t2; }
        }
    }
    _bj_cr_tan_slow_calls = _bj_cr_tan_slow_calls + 1;
    var r: f64 = _bj_cr_tan_slow(x);
    return r;
}

# ── sinh and cosh (bijli's, M1 part 2d: not in impetus's file) ────────────────────
# cosh x = (e^|x| + e^−|x|)/2 and sinh x = sign(x)·(e^|x| − e^−|x|)/2, on exp's phases and slow path above. The two
# terms are summed as a double-double at e^|x|'s scale and scaled by 2^(k−1) once, so nothing overflows before the
# result does (|x| to 711; exp's phases hold there, only its final scaling stops at 709.7). Each phase's bound is
# absolute (both terms' errors), so sinh's cancellation only lowers how often the rounding test passes, never its
# correctness; below |x| = 1/2, where it would cancel more than a bit, sinh is its Taylor series instead. Then, as
# everywhere in this file, the slow path in fixed point, rounded once. Rust reaches these through hisab's complex
# sin and cos (glibc's sinh and cosh); bijli calls no other.

# Calls that phase 1 could not decide, and slow-path calls, since start (diagnostics, as for sin and cos).
var _bj_cr_hyp_phase2_calls = 0;
var _bj_cr_hyp_slow_calls = 0;

# The k with e^x = S·2^k, and S = e^r in [1, 2) into S, for the fixed-point |x| = X (below 746), x negative when neg
# is 1, with q an estimate of x/ln 2 within 1: _bj_cr_exp_fx's reduction and series, the rounding left to the
# caller.
fn _bj_cr_exp_fx_parts(S, X, neg, q: f64): i64 {
    var A[112];
    var R[112];
    var T[112];
    var kf: f64 = f64_floor(q);
    var k = f64_to(kf);
    var tries = 0;
    while (tries < 4) {
        var kk = k;
        if (kk < 0) { kk = 0 - kk; }
        _bj_cr_mul_small(&A, &_bj_cr_ln2, kk);
        var lo = 0;
        if (neg == 0) {
            if (_bj_cr_cmp(X, &A) < 0) { lo = 1; } else { _bj_cr_sub(&R, X, &A); }
        } else {
            if (_bj_cr_cmp(&A, X) < 0) { lo = 1; } else { _bj_cr_sub(&R, &A, X); }
        }
        if (lo == 1) {
            k = k - 1;
        } elif (_bj_cr_cmp(&R, &_bj_cr_ln2) >= 0) {
            k = k + 1;
        } else {
            tries = 4;
        }
        tries = tries + 1;
    }
    _bj_cr_zero(S);
    _bj_cr_zero(&T);
    store64(S, 1);
    store64(&T, 1);
    for (var n = 1; n < 200; n = n + 1) {
        _bj_cr_mul(&T, &T, &R);
        _bj_cr_div_small(&T, &T, n);
        if (_bj_cr_is_zero(&T) == 1) { break; }
        _bj_cr_add(S, S, &T);
    }
    return k;
}

# D = sinh Y for the fixed-point Y = |x| < 1/2, by its Taylor series (every term positive; the last below 2^-364).
fn _bj_cr_sinh_series(D, Y) {
    var Y2[112];
    var T[112];
    _bj_cr_mul(&Y2, Y, Y);
    memcpy(&T, Y, 112);
    memcpy(D, Y, 112);
    for (var n = 1; n < 120; n = n + 1) {
        _bj_cr_mul(&T, &T, &Y2);
        _bj_cr_div_small(&T, &T, (2 * n) * (2 * n + 1));
        if (_bj_cr_is_zero(&T) == 1) { break; }
        _bj_cr_add(D, D, &T);
    }
    return 0;
}

# (e^ax − e^−ax)/2 (minus 1) or (e^ax + e^−ax)/2 (minus 0) in fixed point, correctly rounded and negated when neg is
# 1, for 2^-26 ≤ ax < 711: e^ax = S1·2^k1 and e^−ax = S2·2^k2 (k1 ≥ 0 > k2), S2 shifted to S1's scale (truncated:
# below 2^-364 of S1 when the shift passes the 364 bits), the sum or difference rounded once at 2^(k1 − 1). Each
# exponential is within a few 2^-360 relative and the difference is at least a fifth of S1 for ax ≥ 1/2, so the
# result keeps 2^-350.
#must_use
fn _bj_cr_hyp_slow_exp(ax: f64, minus, neg): f64 {
    _bj_cr_load();
    var X[112];
    var S1[112];
    var S2[112];
    var U[112];
    var D[112];
    _bj_cr_set(&X, ax);
    var q: f64 = ax * _BJ_CR_INVLN2;
    var nq: f64 = -q;
    var k1 = _bj_cr_exp_fx_parts(&S1, &X, 0, q);
    var k2 = _bj_cr_exp_fx_parts(&S2, &X, 1, nq);
    _bj_cr_shr(&U, &S2, k1 - k2);
    if (minus == 1) {
        _bj_cr_sub(&D, &S1, &U);
    } else {
        _bj_cr_add(&D, &S1, &U);
    }
    var r: f64 = _bj_cr_round(&D, k1 - 1, neg);
    return r;
}

# sinh x, correctly rounded, in fixed point, for finite 2^-26 ≤ |x| < 711: the series below 1/2, the exponentials
# above.
#must_use
fn _bj_cr_sinh_slow(x: f64): f64 {
    _bj_cr_load();
    var ax: f64 = f64_abs(x);
    var neg = 0;
    if (x < 0.0) { neg = 1; }
    if (ax < 0.5) {
        var Y[112];
        var D[112];
        _bj_cr_set(&Y, ax);
        _bj_cr_sinh_series(&D, &Y);
        var r: f64 = _bj_cr_round(&D, 0, neg);
        return r;
    }
    var r2: f64 = _bj_cr_hyp_slow_exp(ax, 1, neg);
    return r2;
}

# cosh x, correctly rounded, in fixed point, for finite 2^-26 ≤ |x| < 711.
#must_use
fn _bj_cr_cosh_slow(x: f64): f64 {
    var ax: f64 = f64_abs(x);
    var r: f64 = _bj_cr_hyp_slow_exp(ax, 0, 0);
    return r;
}

# sinh of a double 2^-26 ≤ |x| < 1/2 by 16 Taylor terms in double-double (as _bj_cr_dd_sin_cos, every sign +): the
# last term is below 2^-150 of the sum, and the 16 steps' roundings (each about 2^-104 relative) stay below 2^-98.
#must_use
fn _bj_cr_dd_sinh(x: f64): (f64, f64) {
    var x2h, x2l = _bj_cr_two_prod(x, x);
    var th: f64 = x;
    var tl: f64 = 0.0;
    var sh: f64 = x;
    var sl: f64 = 0.0;
    var k = 1;
    for (var n = 1; n <= 16; n = n + 1) {
        var mh, ml = _bj_cr_dd_mul(th, tl, x2h, x2l);
        var d: f64 = f64_from((k + 1) * (k + 2));
        var qh, ql = _bj_cr_dd_div_d(mh, ml, d);
        th = qh;
        tl = ql;
        var ah, al = _bj_cr_dd_add(sh, sl, th, tl);
        sh = ah;
        sl = al;
        k = k + 2;
    }
    return (sh, sl);
}

# Phase p (1: exp's phase 1, 2^-62; 2: its phase 2, 2^-88) of (e^ax − e^−ax)/2 (minus 1) or the sum (minus 0), for
# 0 < ax < 711, into out: h, l (the sum at e^ax's scale 2^k), an absolute error bound on h + l, and k. e^ax =
# 2^k·(h1 + l1); e^−ax = 2^k2·(h2 + l2), scaled to 2^k (exact, or below 2^-1074 of a term ≥ 1/2 if it underflows);
# above ax = 708, e^−ax is below 2^-2040 of the result and is left out. The bound is twice the two terms' errors,
# 2^-61 (2^-87) of h1 + |R|, which also covers the double-double sum's rounding and an underflowed R.
fn _bj_cr_hyp_phase(ax: f64, minus, p, out) {
    var o1[24];
    if (p == 1) { _bj_cr_exp_p1(ax, &o1); } else { _bj_cr_exp_p2(ax, &o1); }
    var h1: f64 = load64(&o1);
    var l1: f64 = load64(&o1 + 8);
    var k1 = load64(&o1 + 16);
    var rh: f64 = 0.0;
    var rl: f64 = 0.0;
    if (ax <= 708.0) {
        var o2[24];
        var nax: f64 = -ax;
        if (p == 1) { _bj_cr_exp_p1(nax, &o2); } else { _bj_cr_exp_p2(nax, &o2); }
        var h2: f64 = load64(&o2);
        var l2: f64 = load64(&o2 + 8);
        var dk = load64(&o2 + 16) - k1;
        rh = _bj_cr_ldexp(h2, dk);
        rl = _bj_cr_ldexp(l2, dk);
    }
    if (minus == 1) {
        rh = -rh;
        rl = -rl;
    }
    var sh, sl = _bj_cr_dd_add(h1, l1, rh, rl);
    var rel: f64 = _bj_cr_pow2(0 - 61);
    if (p == 2) { rel = _bj_cr_pow2(0 - 87); }
    var ar: f64 = f64_abs(rh);
    var mag: f64 = h1 + ar;
    var err: f64 = mag * rel;
    store64(out, _bj_cr_word(sh));
    store64(out + 8, _bj_cr_word(sl));
    store64(out + 16, _bj_cr_word(err));
    store64(out + 24, k1);
    return 0;
}

# The value of a decided phase: h·2^(k − 1), negated when neg is 1 (±∞ when it overflows, which is then the correctly
# rounded result: h is).
#must_use
fn _bj_cr_hyp_value(h: f64, k, neg): f64 {
    var r: f64 = _bj_cr_scale(h, k - 1);
    if (neg == 1) { r = -r; }
    return r;
}

# cosh x, correctly rounded. cosh(±0) = 1, +∞ for ±∞ and |x| ≥ 711 (cosh overflows from 710.4758600739439 on), NaN
# for NaN; |x| < 2^-26 gives 1 (cosh x − 1 < x²/2·(1 + x²) is below half an ulp of 1). Phases 1 and 2 of the
# exponentials (see the section header), each value returned only when the rounding test decides it; then the slow
# path.
#must_use
fn _bj_cr_cosh(x: f64): f64 {
    if (x != x) { return x; }
    var ax: f64 = f64_abs(x);
    if (ax < 0.000000014901161193847656250) { return 1.0; }
    if (ax >= 711.0) {
        var inf: f64 = 1.0 / 0.0;
        return inf;
    }
    var o[32];
    _bj_cr_hyp_phase(ax, 0, 1, &o);
    var h1: f64 = load64(&o);
    if (_bj_cr_rounds_to(h1, load64(&o + 8), load64(&o + 16)) == 1) {
        var r1: f64 = _bj_cr_hyp_value(h1, load64(&o + 24), 0);
        return r1;
    }
    _bj_cr_hyp_phase2_calls = _bj_cr_hyp_phase2_calls + 1;
    _bj_cr_hyp_phase(ax, 0, 2, &o);
    var h2: f64 = load64(&o);
    if (_bj_cr_rounds_to(h2, load64(&o + 8), load64(&o + 16)) == 1) {
        var r2: f64 = _bj_cr_hyp_value(h2, load64(&o + 24), 0);
        return r2;
    }
    _bj_cr_hyp_slow_calls = _bj_cr_hyp_slow_calls + 1;
    var r3: f64 = _bj_cr_cosh_slow(x);
    return r3;
}

# sinh x, correctly rounded. sinh(±0) = ±0, ±∞ for ±∞ and |x| ≥ 711, NaN for NaN; |x| < 2^-26 gives x itself (sinh x
# − x < x³/6·(1 + x²) is below half an ulp of x). Below |x| = 1/2 the double-double series (bound 2^-96), above it the
# exponentials' phases 1 and 2, each value returned only when the rounding test decides it; then the slow path. sinh
# is odd: the sign is applied last (negation is exact, and rounding to nearest is symmetric).
#must_use
fn _bj_cr_sinh(x: f64): f64 {
    if (x != x) { return x; }
    var ax: f64 = f64_abs(x);
    if (ax < 0.000000014901161193847656250) { return x; }
    var neg = 0;
    if (x < 0.0) { neg = 1; }
    if (ax >= 711.0) {
        var inf: f64 = 1.0 / 0.0;
        if (neg == 1) { inf = -inf; }
        return inf;
    }
    if (ax < 0.5) {
        var sh, sl = _bj_cr_dd_sinh(ax);
        var hs: f64 = sh;
        var ls: f64 = sl;
        var es: f64 = hs * _bj_cr_pow2(0 - 96);
        if (_bj_cr_rounds_to(hs, ls, es) == 1) {
            if (neg == 1) { hs = -hs; }
            return hs;
        }
    } else {
        var o[32];
        _bj_cr_hyp_phase(ax, 1, 1, &o);
        var h1: f64 = load64(&o);
        if (_bj_cr_rounds_to(h1, load64(&o + 8), load64(&o + 16)) == 1) {
            var r1: f64 = _bj_cr_hyp_value(h1, load64(&o + 24), neg);
            return r1;
        }
        _bj_cr_hyp_phase2_calls = _bj_cr_hyp_phase2_calls + 1;
        _bj_cr_hyp_phase(ax, 1, 2, &o);
        var h2: f64 = load64(&o);
        if (_bj_cr_rounds_to(h2, load64(&o + 8), load64(&o + 16)) == 1) {
            var r2: f64 = _bj_cr_hyp_value(h2, load64(&o + 24), neg);
            return r2;
        }
    }
    _bj_cr_hyp_slow_calls = _bj_cr_hyp_slow_calls + 1;
    var r3: f64 = _bj_cr_sinh_slow(x);
    return r3;
}

# ── hypot ───────────────────────────────────────────────────────────────────────────
# hypot(x, y) = √(x² + y²), correctly rounded (impetus ADR 0011, amended for hypot). The operands are scaled by a
# power of two so the larger is in [1, 2); x² + y² is formed in double-double from exact products, its
# square root corrected once by the residual (relative error below 2^-100, tested against 2^-96), and
# the result scaled back exactly. Undecided cases, and results in the first normal binade or below
# (whose spacing is the subnormal grid's), take the slow path: x² + y² exactly in fixed point,
# compared with the exact squares of the midpoints next to the candidate. An exact midpoint can occur
# (a Pythagorean triple with a 54-bit odd hypotenuse) and rounds to even.

var _bj_cr_hypot_slow_calls = 0;

# h·2^k, exact whenever the result is representable (subnormal included) and in up to three exact
# steps; ±∞ on overflow.
#must_use
fn _bj_cr_ldexp(h: f64, k): f64 {
    var r: f64 = h;
    var j = k;
    while (j > 1000) {
        var up: f64 = _bj_cr_pow2(1000);
        r = r * up;
        j = j - 1000;
    }
    while (j < 0 - 1000) {
        var down: f64 = _bj_cr_pow2(0 - 1000);
        r = r * down;
        j = j + 1000;
    }
    var p: f64 = _bj_cr_pow2(j);
    var out: f64 = r * p;
    return out;
}

# The doubles next above and below a positive finite double.
#must_use
fn _bj_cr_next_up(x: f64): f64 { return _bj_cr_from_word(_bj_cr_word(x) + 1); }
#must_use
fn _bj_cr_next_down(x: f64): f64 { return _bj_cr_from_word(_bj_cr_word(x) - 1); }

# The exact square of (c + g) into Q, for c ≥ 0, |g| ≤ c a power of two, sign gs (1 adds, -1
# subtracts), both with no set bit below 2^-60, using M and G as scratch.
fn _bj_cr_sq_mid(Q, M, G, c: f64, g: f64, gs) {
    _bj_cr_set(M, c);
    _bj_cr_set(G, g);
    if (gs > 0) { _bj_cr_add(M, M, G); } else { _bj_cr_sub(M, M, G); }
    _bj_cr_mul(Q, M, M);
    return 0;
}

# The slow path: a in [1, 2), b ≤ a (at least 2^-54), the result c·2^k for the candidate c0 within an
# ulp. The grid is the doubles' near c0, or, when c0·2^k is in the first normal binade or below, the
# multiples of 2^(-1074-k).
#must_use
fn _bj_cr_hypot_slow(a: f64, b: f64, k, c0: f64): f64 {
    _bj_cr_hypot_slow_calls = _bj_cr_hypot_slow_calls + 1;
    var A[112];
    var B[112];
    var S[112];
    var Q[112];
    var M[112];
    var G[112];
    _bj_cr_set(&A, a);
    _bj_cr_set(&B, b);
    _bj_cr_mul(&S, &A, &A);
    _bj_cr_mul(&Q, &B, &B);
    _bj_cr_add(&S, &S, &Q);
    var c: f64 = c0;
    var sub = 0;
    var u: f64 = 0.0;
    var ce = (_bj_cr_word(c) >> 52) - 1023;
    if (ce + k <= 0 - 1022) {
        sub = 1;
        u = _bj_cr_pow2(0 - 1074 - k);
        var q: f64 = c / u + 0.5;
        var n: f64 = f64_floor(q);
        c = n * u;
    }
    var done = 0;
    var it = 0;
    while (done == 0 && it < 8) {
        it = it + 1;
        var lo: f64 = 0.0;
        var hi: f64 = 0.0;
        if (sub == 1) {
            lo = c - u;
            hi = c + u;
        } else {
            lo = _bj_cr_next_down(c);
            hi = _bj_cr_next_up(c);
        }
        var gl: f64 = (c - lo) * 0.5;
        var gh: f64 = (hi - c) * 0.5;
        _bj_cr_sq_mid(&Q, &M, &G, c, gl, 0 - 1);
        var cl = _bj_cr_cmp(&S, &Q);
        if (cl < 0) {
            c = lo;
        } else {
            _bj_cr_sq_mid(&Q, &M, &G, c, gh, 1);
            var chi = _bj_cr_cmp(&S, &Q);
            if (chi > 0) {
                c = hi;
            } else {
                # Inside [lower midpoint, upper midpoint]: c, unless exactly on a midpoint (ties to even).
                var odd = _bj_cr_word(c) & 1;
                if (sub == 1) {
                    var nc: f64 = c / u;
                    odd = f64_to(nc) & 1;
                }
                if (odd == 1) {
                    if (chi == 0) { c = hi; } elif (cl == 0) { c = lo; }
                }
                done = 1;
            }
        }
    }
    return _bj_cr_ldexp(c, k);
}

# hypot(x, y), correctly rounded: +∞ when either is infinite (even with a NaN), NaN when either is NaN,
# |x| when y is 0, +∞ on overflow, subnormal results rounded once. Mirrors `f64::hypot` with the
# exact result in place of libm's.
#must_use
fn _bj_cr_hypot(x: f64, y: f64): f64 {
    var ax: f64 = f64_abs(x);
    var ay: f64 = f64_abs(y);
    var inf: f64 = _bj_cr_from_word(9218868437227405312);
    if (ax == inf || ay == inf) { return inf; }
    if (ax != ax || ay != ay) {
        var nan: f64 = x + y;
        return nan;
    }
    var a: f64 = ax;
    var b: f64 = ay;
    if (b > a) {
        a = ay;
        b = ax;
    }
    if (b == 0.0) { return a; }
    var top: f64 = a;
    var k = 0;
    var ef = _bj_cr_word(a) >> 52;
    if (ef == 0) {
        var up: f64 = _bj_cr_pow2(64);
        a = a * up;
        b = b * up;
        k = 0 - 64;
        ef = _bj_cr_word(a) >> 52;
    }
    var e = ef - 1023;
    var sa: f64 = _bj_cr_ldexp(a, 0 - e);
    var sb: f64 = _bj_cr_ldexp(b, 0 - e);
    k = k + e;
    # b/a below 2^-54: the true value exceeds a by under 2^-109 of it, so it rounds to a.
    var tiny: f64 = _bj_cr_pow2(0 - 54);
    if (sb < tiny) { return top; }
    var ph, pl = _bj_cr_two_prod(sa, sa);
    var qh, ql = _bj_cr_two_prod(sb, sb);
    var sh, sl = _bj_cr_dd_add(ph, pl, qh, ql);
    var s_hi: f64 = sh;
    var s_lo: f64 = sl;
    var r: f64 = f64_sqrt(s_hi);
    var rh, rl = _bj_cr_two_prod(r, r);
    var rhf: f64 = rh;
    var rlf: f64 = rl;
    var d1: f64 = s_hi - rhf;
    var e1: f64 = d1 - rlf;
    var e2: f64 = e1 + s_lo;
    var two_r: f64 = 2.0 * r;
    var corr: f64 = e2 / two_r;
    var h, l = _bj_cr_fast_two_sum(r, corr);
    var hf: f64 = h;
    var lf: f64 = l;
    var bound: f64 = _bj_cr_pow2(0 - 96);
    var err: f64 = hf * bound;
    var he = (_bj_cr_word(hf) >> 52) - 1023;
    if (he + k > 0 - 1022 && _bj_cr_rounds_to(hf, lf, err) == 1) {
        return _bj_cr_ldexp(hf, k);
    }
    return _bj_cr_hypot_slow(sa, sb, k, hf);
}

# ── pow ─────────────────────────────────────────────────────────────────────────────
# pow(x, y) = x^y, correctly rounded (impetus ADR 0011, amended for pow). The specials follow C99 Annex F, as
# glibc's pow does. For x > 0 (a negative x with an integer y takes the sign of the parity):
# - two fast phases: log x in double-double (x = 2^e·m with 0.75 ≤ m < 1.5, log m = 2·atanh(s),
#   s = (m − 1)/(1 + m), so the relative error holds near x = 1 too), r = y·log x by TwoProduct, then
#   exp(r) as exp at the high word times exp of the low word. Phase 1 takes the series' tail in double
#   (log about 2^-73) and exp's table-driven phase 1, tested against 2^-61 + |r|·2^-71; phase 2 the full
#   double-double series (about 2^-100) and exp's phase 2, tested against 2^-80 (the error is about
#   2^-87);
# - the slow path, for the undecided, results below 2^-1022 or near overflow: first an exactness test
#   in integer arithmetic. x^y is a dyadic rational (a double, a midpoint between two, or neither)
#   exactly when x = a·2^u (a odd) and either y is a non-negative integer, or y = Y/2^s (Y > 0 odd) with
#   a a perfect 2^s-th power c^(2^s) and 2^s dividing u, or a = 1 with an integer exponent; then
#   x^y = c^Y·2^(uY/2^s), computed and rounded exactly when its odd part is below 2^63, which covers every
#   double and midpoint (25^11.5 = 5^23 is a midpoint; glibc 2.44 misrounds the subnormal ties of
#   port-parity.md §8). Otherwise log x, y·log x and exp in the 364-bit fixed point, relative error
#   below 2^-290.
# Unlike exp, sin and cos, pow's hardest cases are not known in general. An inexact dyadic value of
# B > 63 bits is at least 2^-B (relative) from every midpoint, so the slow path decides it outright for
# B below about 290; otherwise, as for every other input, it relies on no x^y lying within 2^-290 of a
# midpoint without being one (the published hard cases need about 2^-120).

var _bj_cr_pow_phase2_calls = 0;
var _bj_cr_pow_slow_calls = 0;

# The series coefficients 1/(2k + 1), k = 0 .. 24, in double-double (hi, lo pairs), computed once.
var _bj_cr_odd_inv[400];
var _bj_cr_odd_ready = 0;

# Fills the coefficient table on first use.
fn _bj_cr_odd_load() {
    if (_bj_cr_odd_ready == 1) { return 0; }
    for (var k = 0; k < 25; k = k + 1) {
        var den: f64 = f64_from(2 * k + 1);
        var h, l = _bj_cr_dd_div_d(1.0, 0.0, den);
        store64(&_bj_cr_odd_inv + k * 16, h);
        store64(&_bj_cr_odd_inv + k * 16 + 8, l);
    }
    _bj_cr_odd_ready = 1;
    return 0;
}

# 1 when the finite y is an integer.
#must_use
fn _bj_cr_is_int(y: f64): i64 {
    var ay: f64 = f64_abs(y);
    if (ay >= 4503599627370496.0) { return 1; }
    var fl: f64 = f64_floor(y);
    if (fl == y) { return 1; }
    return 0;
}

# 1 when the finite y is an odd integer.
#must_use
fn _bj_cr_is_odd(y: f64): i64 {
    var ay: f64 = f64_abs(y);
    if (ay >= 9007199254740992.0 || _bj_cr_is_int(y) == 0) { return 0; }
    return f64_to(y) & 1;
}

# b^k for b ≥ 3, k ≥ 0 when it is below 2^63, else 0.
#must_use
fn _bj_cr_ipow(b, k): i64 {
    var n = 1;
    var lim = 9223372036854775807 / b;
    for (var i = 0; i < k; i = i + 1) {
        if (n > lim) { return 0; }
        n = n * b;
    }
    return n;
}

# floor(√n) for 0 ≤ n < 2^53.
#must_use
fn _bj_cr_isqrt(n): i64 {
    var nf: f64 = f64_from(n);
    var rf: f64 = f64_sqrt(nf);
    var r = f64_to(rf);
    while (r * r > n) { r = r - 1; }
    while ((r + 1) * (r + 1) <= n) { r = r + 1; }
    return r;
}

# (ah + al) / (bh + bl), for bh ≠ 0.
#must_use
fn _bj_cr_dd_div(ah: f64, al: f64, bh: f64, bl: f64): (f64, f64) {
    var q1: f64 = ah / bh;
    var p, e = _bj_cr_two_prod(q1, bh);
    var pf: f64 = p;
    var ef: f64 = e;
    var r: f64 = (((ah - pf) - ef) + al) - q1 * bl;
    var q2: f64 = r / bh;
    var s, t = _bj_cr_fast_two_sum(q1, q2);
    return (s, t);
}

# x = 2^e·m with 0.75 ≤ m < 1.5, for finite x > 0, into out: e, then m's word.
fn _bj_cr_log_split(x: f64, out) {
    var adj = 0;
    var w = _bj_cr_word(x);
    if (((w >> 52) & 2047) == 0) {
        var up: f64 = _bj_cr_pow2(54);
        var xs: f64 = x * up;
        w = _bj_cr_word(xs);
        adj = 54;
    }
    var e = ((w >> 52) & 2047) - 1023 - adj;
    var m: f64 = _bj_cr_from_word((w & 4503599627370495) | (1023 << 52));
    if (m >= 1.5) {
        m = m * 0.5;
        e = e + 1;
    }
    store64(out, e);
    store64(out + 8, _bj_cr_word(m));
    return 0;
}

# log m for 0.75 ≤ m < 1.5 in double-double: t = m − 1 (exact), s = t/(1 + m), log m = 2s·(1 + s²/3 +
# s⁴/5 + …) by Horner from the 25th term (|s| ≤ 0.2: the first omitted is below 2^-116 relative).
#must_use
fn _bj_cr_log_m_dd(m: f64): (f64, f64) {
    var t: f64 = m - 1.0;
    var z: f64 = 0.0;
    if (t == 0.0) { return (z, z); }
    var dh, dl = _bj_cr_two_sum(1.0, m);
    var sh, sl = _bj_cr_dd_div(t, 0.0, dh, dl);
    var zh, zl = _bj_cr_dd_mul(sh, sl, sh, sl);
    _bj_cr_odd_load();
    var ph: f64 = load64(&_bj_cr_odd_inv + 24 * 16);
    var pl: f64 = load64(&_bj_cr_odd_inv + 24 * 16 + 8);
    for (var k = 23; k >= 0; k = k - 1) {
        var mh, ml = _bj_cr_dd_mul(zh, zl, ph, pl);
        var ch: f64 = load64(&_bj_cr_odd_inv + k * 16);
        var cl: f64 = load64(&_bj_cr_odd_inv + k * 16 + 8);
        var nh, nl = _bj_cr_dd_add(ch, cl, mh, ml);
        ph = nh;
        pl = nl;
    }
    var rh, rl = _bj_cr_dd_mul(sh, sl, ph, pl);
    var rhf: f64 = rh;
    var rlf: f64 = rl;
    var h: f64 = rhf * 2.0;
    var l: f64 = rlf * 2.0;
    return (h, l);
}

# log m for 0.75 ≤ m < 1.5 in double-double to about 2^-73 relative, for phase 1: the series of
# `_bj_cr_log_m_dd` with its first four terms in double-double and the rest (from s⁸/9, below 2^-21.7 of
# the sum, to the 15th) by Horner in double, whose 2^-53 relative error is then below 2^-74 of the whole.
#must_use
fn _bj_cr_log_m_p1(m: f64): (f64, f64) {
    var t: f64 = m - 1.0;
    var z: f64 = 0.0;
    if (t == 0.0) { return (z, z); }
    var dh, dl = _bj_cr_two_sum(1.0, m);
    var sh, sl = _bj_cr_dd_div(t, 0.0, dh, dl);
    var zh, zl = _bj_cr_dd_mul(sh, sl, sh, sl);
    var zhf: f64 = zh;
    _bj_cr_odd_load();
    var tail: f64 = load64(&_bj_cr_odd_inv + 14 * 16);
    for (var k = 13; k >= 4; k = k - 1) {
        var ck: f64 = load64(&_bj_cr_odd_inv + k * 16);
        tail = ck + zhf * tail;
    }
    var c7h: f64 = load64(&_bj_cr_odd_inv + 3 * 16);
    var c7l: f64 = load64(&_bj_cr_odd_inv + 3 * 16 + 8);
    var th, tl = _bj_cr_dd_mul(zh, zl, tail, 0.0);
    var qh, ql = _bj_cr_dd_add(c7h, c7l, th, tl);
    var c5h: f64 = load64(&_bj_cr_odd_inv + 2 * 16);
    var c5l: f64 = load64(&_bj_cr_odd_inv + 2 * 16 + 8);
    var uh, ul = _bj_cr_dd_mul(zh, zl, qh, ql);
    var vh, vl = _bj_cr_dd_add(c5h, c5l, uh, ul);
    var c3h: f64 = load64(&_bj_cr_odd_inv + 16);
    var c3l: f64 = load64(&_bj_cr_odd_inv + 24);
    var wh, wl = _bj_cr_dd_mul(zh, zl, vh, vl);
    var xh, xl = _bj_cr_dd_add(c3h, c3l, wh, wl);
    var yh, yl = _bj_cr_dd_mul(zh, zl, xh, xl);
    var ph, pl = _bj_cr_dd_add(1.0, 0.0, yh, yl);
    var rh, rl = _bj_cr_dd_mul(sh, sl, ph, pl);
    var rhf: f64 = rh;
    var rlf: f64 = rl;
    var h: f64 = rhf * 2.0;
    var l: f64 = rlf * 2.0;
    return (h, l);
}

# log x in double-double for finite x > 0: e·ln 2 (e·hi exact, e·mid by TwoProduct) plus log m, the
# latter to about 2^-100 relative (precise 1) or about 2^-69 (0, phase 1).
#must_use
fn _bj_cr_log_dd_at(x: f64, precise): (f64, f64) {
    var sp[16];
    _bj_cr_log_split(x, &sp);
    var e = load64(&sp);
    var m: f64 = load64(&sp + 8);
    var lmh: f64 = 0.0;
    var lml: f64 = 0.0;
    if (precise == 1) {
        var ah0, al0 = _bj_cr_log_m_dd(m);
        lmh = ah0;
        lml = al0;
    } else {
        var ah1, al1 = _bj_cr_log_m_p1(m);
        lmh = ah1;
        lml = al1;
    }
    var ef: f64 = f64_from(e);
    var hk: f64 = ef * _BJ_CR_LN2_HI;
    var mh, ml = _bj_cr_two_prod(ef, _BJ_CR_LN2_MID);
    var lo: f64 = ef * _BJ_CR_LN2_LO;
    var ah, al = _bj_cr_dd_add(hk, 0.0, mh, ml);
    var bh, bl = _bj_cr_dd_add(ah, al, lo, 0.0);
    var ch, cl = _bj_cr_dd_add(bh, bl, lmh, lml);
    return (ch, cl);
}

# log x in double-double for finite x > 0, relative error about 2^-100 (measured worst 2^-103.4 over
# 200,000 arguments against MPFR at 320 bits, near 1 included).
#must_use
fn _bj_cr_log_dd(x: f64): (f64, f64) {
    var h, l = _bj_cr_log_dd_at(x, 1);
    return (h, l);
}

# The fast phases for x > 0 (x ≠ 1), finite y ≠ 0, into out as a word, the result negated when neg is
# 1: 1 when decided (out of range included), 0 for the slow path. Phase 1 (precise 0): log x to about
# 2^-73 (measured worst 2^-73.2) and exp's phase 1 (2^-62), tested against 2^-61 + |r|·2^-71; phase 2
# (precise 1): log x to about 2^-100 (measured 2^-103.4) and exp's phase 2 (2^-88), tested against 2^-80.
fn _bj_cr_pow_p1(x: f64, y: f64, neg, out, precise): i64 {
    var sign = 0;
    if (neg == 1) { sign = 0 - 9223372036854775807 - 1; }
    var lh, ll = _bj_cr_log_dd_at(x, precise);
    var lhf: f64 = lh;
    var llf: f64 = ll;
    var rough: f64 = y * lhf;
    # |r − rough| < 2^-42: above ln(DBL_MAX + ulp/2) ≈ 709.7827 it overflows, at or below
    # −1075·ln 2 ≈ −745.1332 it rounds to 0 (2^-1075 is a tie to even), and below 2^-60 in magnitude
    # exp(r) is within 2^-59 of 1, which rounds to 1.
    if (rough > 709.79) {
        store64(out, sign | 9218868437227405312);
        return 1;
    }
    if (rough < 0.0 - 745.14) {
        store64(out, sign);
        return 1;
    }
    var ar: f64 = f64_abs(rough);
    if (ar < 0.000000000000000000867361737988403547205962240695953369140625) {
        store64(out, sign | 4607182418800017408);
        return 1;
    }
    var ph, pl = _bj_cr_two_prod(y, lhf);
    var phf: f64 = ph;
    var plf: f64 = pl;
    var ql: f64 = y * llf;
    var e1: f64 = plf + ql;
    var rh, rl = _bj_cr_fast_two_sum(phf, e1);
    var rhf: f64 = rh;
    var rlf: f64 = rl;
    if (rhf < 0.0 - 708.0 || rhf > 709.7) { return 0; }
    var o[24];
    if (precise == 1) { _bj_cr_exp_p2(rhf, &o); } else { _bj_cr_exp_p1(rhf, &o); }
    var h: f64 = load64(&o);
    var l: f64 = load64(&o + 8);
    # exp(rl) = 1 + c, |rl| ≤ 2^-44: c = rl + rl²/2 (the next term is below 2^-133).
    var c: f64 = rlf * rlf * 0.5;
    c = rlf + c;
    var hch, hcl = _bj_cr_two_prod(h, c);
    var hchf: f64 = hch;
    var hclf: f64 = hcl;
    var s1, s2 = _bj_cr_fast_two_sum(h, hchf);
    var s2f: f64 = s2;
    var lc: f64 = l * c;
    var low: f64 = s2f + (l + (hclf + lc));
    var fh, fl = _bj_cr_fast_two_sum(s1, low);
    var fhf: f64 = fh;
    var flf: f64 = fl;
    var bound: f64 = _bj_cr_pow2(0 - 80);
    if (precise == 0) {
        var arh: f64 = f64_abs(rhf);
        var b1: f64 = _bj_cr_pow2(0 - 61);
        var b2: f64 = _bj_cr_pow2(0 - 71);
        bound = b1 + arh * b2;
    }
    var err: f64 = fhf * bound;
    if (_bj_cr_rounds_to(fhf, flf, err) == 0) { return 0; }
    var res: f64 = _bj_cr_scale(fhf, load64(&o + 16));
    store64(out, sign | _bj_cr_word(res));
    return 1;
}

# d = a·2^q (d may be a), bits below 2^-364 dropped; the result's integer part below 2^27.
fn _bj_cr_shift(d, a, q) {
    if (d != a) { memcpy(d, a, 112); }
    var k = q;
    while (k > 0) {
        var s = k;
        if (s > 27) { s = 27; }
        _bj_cr_mul_small(d, d, 1 << s);
        k = k - s;
    }
    while (k < 0) {
        var s2 = 0 - k;
        if (s2 > 27) { s2 = 27; }
        _bj_cr_div_small(d, d, 1 << s2);
        k = k + s2;
    }
    return 0;
}

# D = (−1)^sa·A + (−1)^sb·B in magnitude (D may be A or B): its sign, 0 or 1.
fn _bj_cr_sadd(D, A, sa, B, sb): i64 {
    if (sa == sb) {
        _bj_cr_add(D, A, B);
        return sa;
    }
    if (_bj_cr_cmp(A, B) >= 0) {
        _bj_cr_sub(D, A, B);
        return sa;
    }
    _bj_cr_sub(D, B, A);
    return sb;
}

# R = 1/D for 1 ≤ D < 4, from the double estimate d: Newton's R·(2 − D·R) four times (53 bits, then
# double each time, to the 364-bit truncation).
fn _bj_cr_recip(R, D, d: f64) {
    var two[112];
    var E[112];
    var W[112];
    _bj_cr_zero(&two);
    store64(&two, 2);
    var r0: f64 = 1.0 / d;
    _bj_cr_set(R, r0);
    for (var i = 0; i < 4; i = i + 1) {
        _bj_cr_mul(&E, D, R);
        _bj_cr_sub(&W, &two, &E);
        _bj_cr_mul(R, R, &W);
    }
    return 0;
}

# L = |log x| in fixed point for finite x > 0: its sign (1 for x < 1). e·ln 2 plus log m = 2·atanh(s),
# s = |m − 1|/(1 + m) ≤ 0.2, summed until the terms vanish (about 75).
fn _bj_cr_log_fx(L, x: f64): i64 {
    var sp[16];
    _bj_cr_log_split(x, &sp);
    var e = load64(&sp);
    var m: f64 = load64(&sp + 8);
    var t: f64 = m - 1.0;
    var ts = 0;
    if (t < 0.0) { ts = 1; }
    var at: f64 = f64_abs(t);
    var S[112];
    _bj_cr_zero(&S);
    if (at != 0.0) {
        var T[112];
        var D[112];
        var R[112];
        var Z[112];
        var Z2[112];
        var P[112];
        var Q[112];
        _bj_cr_set(&T, at);
        _bj_cr_set(&D, m);
        store64(&D, load64(&D) + 1);
        var dm: f64 = 1.0 + m;
        _bj_cr_recip(&R, &D, dm);
        _bj_cr_mul(&Z, &T, &R);
        _bj_cr_mul(&Z2, &Z, &Z);
        memcpy(&P, &Z, 112);
        memcpy(&S, &Z, 112);
        for (var k = 1; k < 200; k = k + 1) {
            _bj_cr_mul(&P, &P, &Z2);
            _bj_cr_div_small(&Q, &P, 2 * k + 1);
            if (_bj_cr_is_zero(&Q) == 1) { break; }
            _bj_cr_add(&S, &S, &Q);
        }
        _bj_cr_add(&S, &S, &S);
    }
    var E[112];
    var ae = e;
    var es = 0;
    if (e < 0) {
        ae = 0 - e;
        es = 1;
    }
    _bj_cr_mul_small(&E, &_bj_cr_ln2, ae);
    return _bj_cr_sadd(L, &E, es, &S, ts);
}

# The exactness test of the slow path for x > 0 (x ≠ 1), finite y ≠ 0: when x^y is a dyadic rational
# whose odd part is below 2^63, its correct rounding into out (negated when neg is 1) and 1;
# otherwise 0. See the section comment.
fn _bj_cr_pow_exact(x: f64, y: f64, neg, out): i64 {
    var w = _bj_cr_word(x);
    var ef = (w >> 52) & 2047;
    var a = w & 4503599627370495;
    var u = 0 - 1074;
    if (ef != 0) {
        a = a | 4503599627370496;
        u = ef - 1075;
    }
    while ((a & 1) == 0) {
        a = a >> 1;
        u = u + 1;
    }
    var wy = _bj_cr_word(y) & 9223372036854775807;
    var ey = (wy >> 52) & 2047;
    var yy = wy & 4503599627370495;
    var v = 0 - 1074;
    if (ey != 0) {
        yy = yy | 4503599627370496;
        v = ey - 1075;
    }
    while ((yy & 1) == 0) {
        yy = yy >> 1;
        v = v + 1;
    }
    var yn = yy;
    if (y < 0.0) { yn = 0 - yy; }
    var n = 1;
    var e = 0;
    if (v >= 0) {
        # An integer exponent yn·2^v; one this large leaves the range unless x is a power of two, and
        # then only with u = 0, which is x = 1.
        if (v > 20 || yy > 1048576) { return 0; }
        var ni = yn << v;
        if (a == 1) {
            e = u * ni;
        } else {
            if (ni < 0 || ni > 63) { return 0; }
            n = _bj_cr_ipow(a, ni);
            if (n == 0) { return 0; }
            e = u * ni;
        }
    } else {
        var s = 0 - v;
        if (s > 30) { return 0; }
        var p2 = 1 << s;
        if (u % p2 != 0) { return 0; }
        var us = u / p2;
        if (a == 1) {
            e = us * yn;
        } else {
            if (yn < 0 || s > 5) { return 0; }
            var c = a;
            for (var j = 0; j < s; j = j + 1) {
                var r = _bj_cr_isqrt(c);
                if (r * r != c) { return 0; }
                c = r;
            }
            if (yn > 63) { return 0; }
            n = _bj_cr_ipow(c, yn);
            if (n == 0) { return 0; }
            e = us * yn;
        }
    }
    # n·2^e with n < 2^63, as n/2^60 in fixed point, rounded once.
    var A[112];
    _bj_cr_zero(&A);
    store64(&A, n >> 60);
    store64(&A + 8, (n >> 32) & _BJ_CR_MASK);
    store64(&A + 16, (n >> 4) & _BJ_CR_MASK);
    store64(&A + 24, (n & 15) << 24);
    var res: f64 = _bj_cr_round(&A, e + 60, neg);
    store64(out, _bj_cr_word(res));
    return 1;
}

# The slow path for x > 0 (x ≠ 1), finite y ≠ 0 with |y·log x| between 2^-60 and 746: exactly when
# x^y is dyadic, else in fixed point.
#must_use
fn _bj_cr_pow_slow(x: f64, y: f64, neg): f64 {
    _bj_cr_load();
    var o[8];
    if (_bj_cr_pow_exact(x, y, neg, &o) == 1) {
        var re: f64 = load64(&o);
        return re;
    }
    var L[112];
    var M[112];
    var P[112];
    var ls = _bj_cr_log_fx(&L, x);
    # |y| = my·2^q with 1 ≤ my < 2 (y is normal here: |y·log x| ≥ 2^-60 and |log x| < 746).
    var wy = _bj_cr_word(y) & 9223372036854775807;
    var q = ((wy >> 52) & 2047) - 1023;
    var my: f64 = _bj_cr_from_word((wy & 4503599627370495) | (1023 << 52));
    _bj_cr_set(&M, my);
    _bj_cr_mul(&P, &M, &L);
    _bj_cr_shift(&P, &P, q);
    var rs = ls;
    if (y < 0.0) { rs = 1 - ls; }
    var lh, ll = _bj_cr_log_dd(x);
    var lhf: f64 = lh;
    var r0: f64 = y * lhf;
    var qe: f64 = r0 * _BJ_CR_INVLN2;
