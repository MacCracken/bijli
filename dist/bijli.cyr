# --- crmath_ux.cyr ---

# crmath_ux.cyr — e^x, cosh, sinh, ln(s·2^E), (s·2^E)^y, and sin and cos past DBL_MAX, each with an unbounded
# exponent (bijli, M1 part 5c-2), for BjComplex's transcendental range edges (ADR 0002 row 16).
#
# At a range edge hisab's chain runs with an unbounded exponent (the user's decision of 2026-11-12, ADR 0002 rows 14 and
# 16): every operation rounded to 53 bits, the last one once into binary64. The transcendental operations of that chain
# that can leave binary64's normal range are e^re in complex exp, cosh and sinh of im in complex sin and cos, ln and pow
# of an |z| (or a power) past DBL_MAX or below 2^-1022, and sin and cos of an angle past DBL_MAX (powf's n·arg z; the
# Green's function's k·R, M1 part 5d-3). Each returns its 53-bit value as kimiya's _bj_k_ux_* pair (s in [1, 2), an i64
# exponent), or ln, sin and cos their final binary64 value (always normal). Every one runs on src/crmath.cyr's 364-bit
# fixed point (impetus's slow paths, error below 2^-290 relative): e^x by _bj_cr_exp_fx_parts (x = k·ln 2 + r, e^r by
# its series), ln by _bj_cr_log_fx plus E·ln 2, pow as pow's own slow path (an exactness test, then |y|·|ln x| and e^±),
# sin and cos by Payne–Hanek against a longer table of the same 2/π (src/crmath_ux_data.cyr). They are slow (tens of
# microseconds), and only the edges reach them.
#
# The rounding. _bj_cr_round_ux takes the fixed point's 53 leading bits, the round bit and the sticky bit, ties to
# even, with no exponent range. A value within 2^-290 of a rounding boundary would need an argument far harder than
# any known: the hardest double arguments of exp, log, sin and cos need about 2^-120 (Lefèvre–Muller), and the
# arguments here differ only in their exponent (s·2^E, or a 53-bit angle), for which no search is published; the
# 170-bit margin is what crmath's pow already relies on. Exact midpoints: e^x, ln x, sin and cos of a nonzero
# rational are transcendental (Lindemann–Weierstrass), and a dyadic power is caught exactly by _bj_ux_pow_exact.
# scripts/oracle/cr_verify.py's ux_* families check every function here against MPFR at 53 bits with its widest
# exponent range, on x86_64 and aarch64.
#
# Far past the range the value is (1, ±_BJ_UX_HUGE): a stand-in whose products with every factor the chain can give it
# overflow, or round to zero, exactly as the true value's do. For e^x, cosh and sinh that is beyond |x| = 1500: their
# factors are doubles (cos and sin of a part), at least 2^-1074 in magnitude, and e^1500·2^-1074 > 2^1090. For a power
# it is beyond |y·ln x| = 10000: its factor can be the sine of an angle n·arg z far below 2^-1074, but never below
# 2^-2098·|n| (arg z ≥ 2^-1074/2^1024), and a power past e^1500 needs |n| ≥ 2 (|ln |z|| < 745), while e^10000 is
# 2^14426. Every real exponent here stays below 2^15, far from the stand-in's 2^20.

# The exponent of the stand-in for a value beyond every product's range (2^20).
const _BJ_UX_HUGE = 1048576;

# The fixed-point a·2^k (a ≥ 0, its integer part below 2^28) rounded to 53 bits, ties to even, with an unbounded
# exponent: (s, e), s in [1, 2) (negated when neg is 1), so that the value is s·2^e; (±0, 0) for a = 0. _bj_cr_round
# without its subnormal and overflow ends.
#must_use
fn _bj_cr_round_ux(a, k, neg): (f64, i64) {
    var sign = 0;
    if (neg == 1) { sign = 0 - 9223372036854775807 - 1; }
    var j0 = 0;
    while (j0 < _BJ_CR_L && load64(a + j0 * 8) == 0) { j0 = j0 + 1; }
    if (j0 == _BJ_CR_L) {
        var z: f64 = _bj_cr_from_word(sign);
        return (z, 0);
    }
    var v = load64(a + j0 * 8);
    var b = 0;
    while ((v >> (b + 1)) != 0) { b = b + 1; }
    var top = b - 28 * j0;
    var mant = 0;
    for (var i = 0; i < 53; i = i + 1) { mant = (mant << 1) | _bj_cr_bit(a, top - i); }
    var rb = _bj_cr_bit(a, top - 53);
    var st = _bj_cr_sticky(a, top - 53);
    if (rb == 1 && (st == 1 || (mant & 1) == 1)) { mant = mant + 1; }
    var ex = top + k;
    if (mant == 9007199254740992) {
        mant = 4503599627370496;
        ex = ex + 1;
    }
    var s: f64 = _bj_cr_from_word(sign | (1023 << 52) | (mant - 4503599627370496));
    return (s, ex);
}

# e^x rounded to 53 bits with an unbounded exponent, for finite x with |x| ≥ 2^-300: (s, e); (1, ±_BJ_UX_HUGE)
# beyond |x| = 1500 (the section comment).
#must_use
fn _bj_ux_exp(x: f64): (f64, i64) {
    if (x > 1500.0) { return (1.0, _BJ_UX_HUGE); }
    if (x < -1500.0) { return (1.0, 0 - _BJ_UX_HUGE); }
    _bj_cr_load();
    var X[112];
    var S[112];
    var ax: f64 = f64_abs(x);
    _bj_cr_set(&X, ax);
    var q: f64 = x * _BJ_CR_INVLN2;
    var neg = 0;
    if (x < 0.0) { neg = 1; }
    var k = _bj_cr_exp_fx_parts(&S, &X, neg, q);
    var s, e = _bj_cr_round_ux(&S, k, 0);
    return (s, e);
}

# cosh x rounded to 53 bits with an unbounded exponent, for finite |x| > 710: e^|x|/2. e^-|x| is below 2^-2048 of it,
# so far below the fixed point's 2^-364 that the exact sum and e^|x| round alike (as _bj_cr_hyp_slow_exp truncates
# it); (1, _BJ_UX_HUGE) beyond 1500.
#must_use
fn _bj_ux_cosh(x: f64): (f64, i64) {
    var ax: f64 = f64_abs(x);
    var s, e = _bj_ux_exp(ax);
    if (e == _BJ_UX_HUGE) { return (s, e); }
    return (s, e - 1);
}

# sinh x rounded to 53 bits with an unbounded exponent, for finite |x| > 710: ±e^|x|/2, as _bj_ux_cosh.
#must_use
fn _bj_ux_sinh(x: f64): (f64, i64) {
    var s, e = _bj_ux_cosh(x);
    if (x < 0.0) {
        var ns: f64 = -s;
        return (ns, e);
    }
    return (s, e);
}

# |ln(s·2^E)| into L, and its sign (1 for a value below 1), for a positive normal double s and |E| < 2^26.
fn _bj_ux_log_fx(L, s: f64, ex): i64 {
    _bj_cr_load();
    var ls = _bj_cr_log_fx(L, s);
    var E[112];
    var ae = ex;
    var es = 0;
    if (ex < 0) {
        ae = 0 - ex;
        es = 1;
    }
    _bj_cr_mul_small(&E, &_bj_cr_ln2, ae);
    var sg = _bj_cr_sadd(L, &E, es, L, ls);
    return sg;
}

# ln(s·2^E), correctly rounded into binary64, for a positive normal double s and |E| < 2^26 (the section comment).
#must_use
fn _bj_ux_ln(s: f64, ex): f64 {
    var L[112];
    var sg = _bj_ux_log_fx(&L, s, ex);
    var r: f64 = _bj_cr_round(&L, 0, sg);
    return r;
}

# The exactness test of the pow slow path for x = s·2^E (a positive normal double s, |E| < 2^26) and a finite y ≠ 0:
# when x^y is a dyadic rational whose odd part is below 2^63, its 53-bit rounding into out (s, then e) and 1;
# otherwise 0. _bj_cr_pow_exact's body with the base's exponent unbounded and the rounding _bj_cr_round_ux's
# (src/crmath.cyr is impetus's copy, kept in step with it, so the variant is bijli's and lives here). A power this
# test rejects is irrational, or has an odd part of at least 2^63, which no 53-bit midpoint has.
fn _bj_ux_pow_exact(s: f64, ex, y: f64, out): i64 {
    var w = _bj_cr_word(s);
    var a = (w & 4503599627370495) | 4503599627370496;
    var u = ((w >> 52) & 2047) - 1075 + ex;
    while ((a & 1) == 0) {
        a = a >> 1;
        u = u + 1;
    }
    var wy = _bj_cr_word(y) & 9223372036854775807;
    var ey = (wy >> 52) & 2047;
    var yy = wy & 4503599627370495;
    var v = 0 - 1074;
    if (ey != 0) {
        yy = yy | 4503599627370496;
        v = ey - 1075;
    }
    while ((yy & 1) == 0) {
        yy = yy >> 1;
        v = v + 1;
    }
    var yn = yy;
    if (y < 0.0) { yn = 0 - yy; }
    var n = 1;
    var e = 0;
    if (v >= 0) {
        if (v > 20 || yy > 1048576) { return 0; }
        var ni = yn << v;
        if (a == 1) {
            e = u * ni;
        } else {
            if (ni < 0 || ni > 63) { return 0; }
            n = _bj_cr_ipow(a, ni);
            if (n == 0) { return 0; }
            e = u * ni;
        }
    } else {
        var sh = 0 - v;
        if (sh > 30) { return 0; }
        var p2 = 1 << sh;
        if (u % p2 != 0) { return 0; }
        var us = u / p2;
        if (a == 1) {
            e = us * yn;
        } else {
            if (yn < 0 || sh > 5) { return 0; }
            var c = a;
            for (var j = 0; j < sh; j = j + 1) {
                var r = _bj_cr_isqrt(c);
                if (r * r != c) { return 0; }
                c = r;
            }
            if (yn > 63) { return 0; }
            n = _bj_cr_ipow(c, yn);
            if (n == 0) { return 0; }
            e = us * yn;
        }
    }
    # n·2^e with n < 2^63, as n/2^60 in fixed point, rounded to 53 bits.
    var A[112];
    _bj_cr_zero(&A);
    store64(&A, n >> 60);
    store64(&A + 8, (n >> 32) & _BJ_CR_MASK);
    store64(&A + 16, (n >> 4) & _BJ_CR_MASK);
    store64(&A + 24, (n & 15) << 24);
    var rs, re = _bj_cr_round_ux(&A, e + 60, 0);
    store64(out, _bj_cr_word(rs));
    store64(out + 8, re);
    return 1;
}

# (s·2^E)^y rounded to 53 bits with an unbounded exponent, for a positive normal double s, |E| < 2^26 and a finite y:
# (r, e). y = 0 gives 1 (pow's rule); |y·ln x| below 2^-60 gives 1 (the power is within 2^-60 of 1); past 10000 the
# stand-in (1, ±_BJ_UX_HUGE) (the section comment). Then an exact dyadic power exactly, else the fixed point (where
# |y·ln x| ≤ 10000 keeps every value below 2^27).
#must_use
fn _bj_ux_pow(s: f64, ex, y: f64): (f64, i64) {
    if (y == 0.0) { return (1.0, 0); }
    var ls0: f64 = _bj_k_cr_ln(s);
    var ef: f64 = f64_from(ex);
    var lnv: f64 = ls0 + ef * 0.6931471805599453;
    var t: f64 = y * lnv;
    if (t > 10000.0) { return (1.0, _BJ_UX_HUGE); }
    if (t < -10000.0) { return (1.0, 0 - _BJ_UX_HUGE); }
    var at: f64 = f64_abs(t);
    if (at < 0.000000000000000000867361737988403547205962240695953369140625) { return (1.0, 0); }   # 2^-60
    var o[16];
    if (_bj_ux_pow_exact(s, ex, y, &o) == 1) {
        var xs: f64 = load64(&o);
        var xe = load64(&o + 8);
        return (xs, xe);
    }
    _bj_cr_load();
    var L[112];
    var M[112];
    var P[112];
    var S[112];
    var ls = _bj_ux_log_fx(&L, s, ex);
    # |y| = my·2^q with 1 ≤ my < 2 (y is normal: |y·ln x| ≥ 2^-60 and |ln x| < 2^25).
    var wy = _bj_cr_word(y) & 9223372036854775807;
    var q = ((wy >> 52) & 2047) - 1023;
    var my: f64 = _bj_cr_from_word((wy & 4503599627370495) | (1023 << 52));
    _bj_cr_set(&M, my);
    _bj_cr_mul(&P, &M, &L);
    _bj_cr_shift(&P, &P, q);
    var rs = ls;
    if (y < 0.0) { rs = 1 - ls; }
    var qe: f64 = t * _BJ_CR_INVLN2;
    var k = _bj_cr_exp_fx_parts(&S, &P, rs, qe);
    var r, re = _bj_cr_round_ux(&S, k, 0);
    return (r, re);
}

# Y = (t·2/π mod 1)·π/2 in fixed point, and the quadrant floor(t·2/π) mod 4, for t = m·2^e with m < 2^54 and
# e ≤ 2000 (a 53-bit value below 2^2054): _bj_cr_reduce's body with m and e given, for an angle past DBL_MAX (powf's
# n·arg z, the Green's function's k·R), against src/crmath_ux_data.cyr's 96 chunks of 2/π (_bj_cr_reduce takes a
# double and impetus's 56 chunks; src/crmath.cyr is impetus's copy). The chunks it reads end at index 88.
fn _bj_ux_reduce(Y, m, e): i64 {
    _bj_ux_load();
    var u = ((e - 2) % 28 + 28) % 28;
    var t = e - 2 - u;
    var d = e - t;
    var mk[24];
    store64(&mk, (m << d) & _BJ_CR_MASK);
    if (d >= 28) {
        store64(&mk + 8, (m << (d - 28)) & _BJ_CR_MASK);
    } else {
        store64(&mk + 8, (m >> (28 - d)) & _BJ_CR_MASK);
    }
    store64(&mk + 16, (m >> (56 - d)) & _BJ_CR_MASK);
    var base = t / 28;
    var ncol = _BJ_CR_L + 2;
    var col[128];
    for (var f = 0; f < ncol; f = f + 1) {
        var sum = 0;
        for (var kk = 0; kk < 3; kk = kk + 1) {
            var jj = kk + f - 1;
            var idx = base + jj;
            if (jj >= 0 && idx >= 0 && idx < 96) {
                sum = sum + load64(&mk + kk * 8) * load64(&_bj_ux_2opi + idx * 8);
            }
        }
        store64(&col + f * 8, sum);
    }
    var p = ncol - 1;
    while (p > 0) {
        var v = load64(&col + p * 8);
        store64(&col + (p - 1) * 8, load64(&col + (p - 1) * 8) + (v >> 28));
        store64(&col + p * 8, v & _BJ_CR_MASK);
        p = p - 1;
    }
    var quad = load64(&col) & 3;
    store64(Y, 0);
    for (var j = 1; j < _BJ_CR_L; j = j + 1) { store64(Y + j * 8, load64(&col + j * 8)); }
    _bj_cr_mul(Y, Y, &_bj_cr_pio2);
    return quad;
}

# sin t (want_sin 1) or cos t (0), correctly rounded into binary64, for the 53-bit t = ts·2^te past DBL_MAX
# (1 ≤ |ts| < 2, 1024 ≤ te ≤ 2052): _bj_cr_sin_cos_slow on _bj_ux_reduce.
#must_use
fn _bj_ux_sin_cos(ts: f64, te, want_sin): f64 {
    _bj_cr_load();
    var Y[112];
    var D[112];
    var w = _bj_cr_word(ts);
    var m = (w & 4503599627370495) | 4503599627370496;
    var quad = _bj_ux_reduce(&Y, m, te - 52);
    # sin(y + qπ/2) is sin y, cos y, −sin y, −cos y; cos(y + qπ/2) is cos y, −sin y, −cos y, sin y.
    var use_sin = want_sin;
    if ((quad & 1) == 1) { use_sin = 1 - want_sin; }
    var neg = 0;
    if (want_sin == 1 && quad >= 2) { neg = 1; }
    if (want_sin == 0 && (quad == 1 || quad == 2)) { neg = 1; }
    if (want_sin == 1 && ts < 0.0) { neg = 1 - neg; }
    _bj_cr_sin_cos_series(&D, &Y, use_sin);
    var r: f64 = _bj_cr_round(&D, 0, neg);
    return r;
}

# --- crmath_cmp.cyr ---

# crmath_cmp.cyr — the exact Singularity threshold (bijli, M1 part 5d-1, ADR 0002 row 17).
#
# field.rs and charge.rs refuse a field point closer to its source than √(1e-30) m by testing the rounded
# r² = dx² + dy² + dz² against the double nearest 10^-30, and the Green's functions test the rounded R = √r² the same
# way. The user's decision of 2026-11-12 makes the test exact: the exact Σ (aᵢ − bᵢ)² of the inputs themselves against
# 10^-30, or against 10^-60 for R < 10^-30.
#
# The band. The rounded r² is within a few ulps of the exact one: each difference, square and sum is rounded once
# (five roundings, each within half an ulp), and a square that underflows costs at most 2^-1074 absolute, nothing at
# this scale (10^-30 is about 2^-100). R adds one correctly rounded root. A non-finite input makes the rounded value NaN
# or +∞, and Rust's comparison stands. So outside 64 ulps of the double nearest 10^-30 the rounded comparison is the
# exact one, and only inside that band (_bj_x_band's 2) does _bj_x_r2_below run.
#
# The exact test. Each difference is s + t exactly (TwoSum, exact in binary64 with gradual underflow), so
# r² = Σ (s² + 2st + t²): nine products of two doubles, each ±m·2^k with m < 2^107. Times 10^p the sum is compared with
# 1 in integers: Σ ±m·5^p·2^(k + p − b) against 2^(−b), b the least exponent (or 0). In the band no term exceeds
# about 2^-98 (r² is near 10^-30) and none has a bit below 2^-2148 (t² of a subnormal t), so the integers span at most
# about 2,300 bits, inside the 2,560 the 80 limbs of 32 bits hold.

const _BJ_XN_L = 80;
const _BJ_XN_M = 4294967295;

# The origin, for a test of |a|² (b = 0).
var _bj_x_origin[24];

# a = 0.
fn _bj_xn_zero(a) {
    for (var i = 0; i < _BJ_XN_L; i = i + 1) { store64(a + i * 8, 0); }
    return 0;
}

# a = m, for 0 ≤ m < 2^63.
fn _bj_xn_set(a, m) {
    _bj_xn_zero(a);
    store64(a, m & _BJ_XN_M);
    store64(a + 8, m >> 32);
    return 0;
}

# a = a·v, for 0 < v < 2^30: no limb product or carry leaves 2^62.
fn _bj_xn_mul_small(a, v) {
    var carry = 0;
    for (var i = 0; i < _BJ_XN_L; i = i + 1) {
        var t = load64(a + i * 8) * v + carry;
        store64(a + i * 8, t & _BJ_XN_M);
        carry = t >> 32;
    }
    return 0;
}

# acc = acc + a·2^sh, for sh ≥ 0, the sum below 2^2560.
fn _bj_xn_add_shl(acc, a, sh) {
    var q = sh / 32;
    var r = sh % 32;
    var carry = 0;
    for (var i = 0; i + q < _BJ_XN_L; i = i + 1) {
        var x = load64(a + i * 8);
        var lo = (x << r) & _BJ_XN_M;
        var hi = 0;
        if (r > 0) { hi = x >> (32 - r); }
        var t = load64(acc + (i + q) * 8) + lo + carry;
        store64(acc + (i + q) * 8, t & _BJ_XN_M);
        carry = (t >> 32) + hi;
    }
    return 0;
}

# −1, 0 or 1 as a <, =, > b.
#must_use
fn _bj_xn_cmp(a, b): i64 {
    var i = _BJ_XN_L - 1;
    while (i >= 0) {
        var x = load64(a + i * 8);
        var y = load64(b + i * 8);
        if (x < y) { return 0 - 1; }
        if (x > y) { return 1; }
        i = i - 1;
    }
    return 0;
}

# dst = m1·m2·c·5^p, for m1, m2 < 2^53, c 1 or 2, p ≥ 0: m2 in two parts below 2^27, 5^p twelve fives at a time.
fn _bj_xn_term(dst, m1, m2, c, p) {
    var lo[640];
    var hi[640];
    _bj_xn_set(&lo, m1);
    _bj_xn_mul_small(&lo, m2 & 67108863);
    _bj_xn_set(&hi, m1);
    _bj_xn_mul_small(&hi, m2 >> 26);
    _bj_xn_zero(dst);
    _bj_xn_add_shl(dst, &lo, 0);
    _bj_xn_add_shl(dst, &hi, 26);
    if (c == 2) { _bj_xn_mul_small(dst, 2); }
    var f12 = 1;
    for (var k = 0; k < 12; k = k + 1) { f12 = f12 * 5; }
    var q = p;
    while (q >= 12) {
        _bj_xn_mul_small(dst, f12);
        q = q - 12;
    }
    var f = 1;
    for (var j = 0; j < q; j = j + 1) { f = f * 5; }
    if (f > 1) { _bj_xn_mul_small(dst, f); }
    return 0;
}

# The finite double x ≠ 0 as ±m·2^k: m (below 2^53) into out[0], k into out[1]; returns 1 for a negative x.
fn _bj_x_split(x: f64, out): i64 {
    var w = _bj_cr_word(x);
    var a = w & 9223372036854775807;
    var be = a >> 52;
    var m = a & 4503599627370495;
    var k = 0 - 1074;
    if (be != 0) {
        m = m | 4503599627370496;
        k = be - 1075;
    }
    store64(out, m);
    store64(out + 8, k);
    if (w < 0) { return 1; }
    return 0;
}

# 1 when the exact Σᵢ (aᵢ − bᵢ)² (i < 3) is below 10^-p, for finite aᵢ, bᵢ whose differences don't overflow and
# 0 < p ≤ 60 (the section comment).
#must_use
fn _bj_x_r2_below(a: *f64, b: *f64, p): i64 {
    var tm: i64[54];                                         # per term: m1, k1, m2, k2, c, negative
    var nt = 0;
    var sp: i64[2];
    var tp: i64[2];
    for (var i = 0; i < 3; i = i + 1) {
        var ai: f64 = a[i];
        var nb: f64 = -b[i];
        var s, t = _bj_cr_two_sum(ai, nb);
        var sv: f64 = s;
        var tv: f64 = t;
        var sn = 0;
        var tn = 0;
        if (sv != 0.0) { sn = _bj_x_split(sv, &sp); }
        if (tv != 0.0) { tn = _bj_x_split(tv, &tp); }
        if (sv != 0.0) {
            tm[nt * 6] = sp[0];
            tm[nt * 6 + 1] = sp[1];
            tm[nt * 6 + 2] = sp[0];
            tm[nt * 6 + 3] = sp[1];
            tm[nt * 6 + 4] = 1;
            tm[nt * 6 + 5] = 0;
            nt = nt + 1;
        }
        if (sv != 0.0 && tv != 0.0) {
            tm[nt * 6] = sp[0];
            tm[nt * 6 + 1] = sp[1];
            tm[nt * 6 + 2] = tp[0];
            tm[nt * 6 + 3] = tp[1];
            tm[nt * 6 + 4] = 2;
            tm[nt * 6 + 5] = sn ^ tn;
            nt = nt + 1;
        }
        if (tv != 0.0) {
            tm[nt * 6] = tp[0];
            tm[nt * 6 + 1] = tp[1];
            tm[nt * 6 + 2] = tp[0];
            tm[nt * 6 + 3] = tp[1];
            tm[nt * 6 + 4] = 1;
            tm[nt * 6 + 5] = 0;
            nt = nt + 1;
        }
    }
    var base = 0;
    for (var j = 0; j < nt; j = j + 1) {
        var e = tm[j * 6 + 1] + tm[j * 6 + 3] + p;
        if (e < base) { base = e; }
    }
    var P[640];
    var N[640];
    var T[640];
    _bj_xn_zero(&P);
    _bj_xn_zero(&N);
    for (var u = 0; u < nt; u = u + 1) {
        _bj_xn_term(&T, tm[u * 6], tm[u * 6 + 2], tm[u * 6 + 4], p);
        var sh = tm[u * 6 + 1] + tm[u * 6 + 3] + p - base;
        if (tm[u * 6 + 5] == 1) { _bj_xn_add_shl(&N, &T, sh); } else { _bj_xn_add_shl(&P, &T, sh); }
    }
    _bj_xn_set(&T, 1);
    _bj_xn_add_shl(&N, &T, 0 - base);
    if (_bj_xn_cmp(&P, &N) < 0) { return 1; }
    return 0;
}

# The band test for a rounded value v (r² against the double t nearest 10^-30, or R against it): 0 when v is NaN or
# more than 64 ulps above t (not singular), 1 when more than 64 ulps below (singular), 2 inside the band (the exact
# test decides). v is non-negative or NaN.
#must_use
fn _bj_x_band(v: f64, t: f64): i64 {
    if (v != v) { return 0; }
    var w = _bj_cr_word(v) - _bj_cr_word(t);
    if (w > 64) { return 0; }
    if (w < -64) { return 1; }
    return 2;
}

# --- mathx.cyr ---

# mathx.cyr — bijli's math helpers: Rust std semantics on top of the Cyrius builtins.
#
# Port plan §9.1 and §6 step 4. Each helper mirrors one std f64 method as rustc 1.99.1 compiles
# it, and is pinned by tests/golden/math.tsv:
# - min / max / clamp ignore a NaN operand as Rust does (the stdlib f64_min / f64_max return the
#   second operand when the first is NaN, and NaN when the second is);
# - the predicates and copysign have no public stdlib counterpart;
# - to_radians and to_degrees are one multiply by Rust's folded constant;
# - powi is compiler-rt's `__powidf2`, which Rust calls for bijli's run-time exponents.
# - exp, sin, cos, sin_cos, hypot, pow, atan2 and atan are correctly rounded (src/crmath.cyr, impetus's ADR 0011
#   adopted by bijli's ADR 0001), and so are tan (bijli's, on impetus's sin and cos), acos, log10 (kimiya's) and
#   asin (src/crmath_k.cyr): the same bits on every target, matching the corrected oracle. cbrt is ganita's,
#   already correctly rounded.
# Adapted from impetus's src/mathx.cyr (its `_im_` helpers).

# `std::f64::consts::PI`, the double nearest π (0x400921FB54442D18). Rust folds `4.0 * PI * EPSILON_0` and the like at
# compile time; the port computes the same IEEE products at run time, which gives the same bits.
var _BJ_PI: f64 = 3.141592653589793;

# π/180 as Rust folds `consts::PI / 180.0`: the double nearest, pinned by the to_radians rows.
var _BJ_RADS_PER_DEG: f64 = 0.017453292519943295;

# 180/π as Rust folds `180.0f64 / consts::PI`: pinned by the to_degrees rows.
var _BJ_DEGS_PER_RAD: f64 = 57.29577951308232;

# The bits of an f64 as an integer word: an untyped parameter, an i64 return.
#must_use
fn _bj_bits(x): i64 {
    return x;
}

# The f64 whose bit pattern is the word `w`.
#must_use
fn _bj_from_bits(w): f64 {
    var r: f64 = w;
    return r;
}

# 1 when x is NaN. Mirrors `f64::is_nan`.
#must_use
fn _bj_is_nan(x: f64): i64 {
    if (x != x) { return 1; }
    return 0;
}

# 1 when x is neither infinite nor NaN (x − x is 0 only then). Mirrors `f64::is_finite`.
#must_use
fn _bj_is_finite(x: f64): i64 {
    var d: f64 = x - x;
    if (d == 0.0) { return 1; }
    return 0;
}

# The smaller of x and y, ignoring a NaN operand (NaN only when both are). Equal operands, +0 and
# −0 included, give y, as rustc 1.99.1's `x.min(y)` does (minsd). Mirrors `f64::min`.
#must_use
fn _bj_min(x: f64, y: f64): f64 {
    if (x != x) { return y; }
    if (y != y) { return x; }
    if (x < y) { return x; }
    return y;
}

# The larger of x and y, ignoring a NaN operand (NaN only when both are). Equal operands give y
# (maxsd). Mirrors `f64::max`.
#must_use
fn _bj_max(x: f64, y: f64): f64 {
    if (x != x) { return y; }
    if (y != y) { return x; }
    if (x > y) { return x; }
    return y;
}

# x restricted to [lo, hi]: lo when x < lo, hi when x > hi, else x (a NaN x stays NaN). Rust
# panics on lo > hi or a NaN bound; every caller passes valid bounds. Mirrors `f64::clamp`.
#must_use
fn _bj_clamp(x: f64, lo: f64, hi: f64): f64 {
    var r: f64 = x;
    if (r < lo) { r = lo; }
    if (r > hi) { r = hi; }
    return r;
}

# x's magnitude with y's sign bit (NaN payloads kept; a NaN y gives its own sign). Mirrors
# `f64::copysign`.
#must_use
fn _bj_copysign(x: f64, y: f64): f64 {
    var mag = _bj_bits(x) & 0x7FFFFFFFFFFFFFFF;
    var sign = _bj_bits(y) & 0x8000000000000000;
    var r: f64 = _bj_from_bits(mag | sign);
    return r;
}

# Degrees to radians: one multiply by the folded π/180. Mirrors `f64::to_radians`.
#must_use
fn _bj_to_radians(x: f64): f64 {
    var r: f64 = x * _BJ_RADS_PER_DEG;
    return r;
}

# Radians to degrees: one multiply by the folded 180/π. Mirrors `f64::to_degrees`.
#must_use
fn _bj_to_degrees(x: f64): f64 {
    var r: f64 = x * _BJ_DEGS_PER_RAD;
    return r;
}

# x^n for an integer n, as compiler-rt's `__powidf2` computes it (Rust's `x.powi(n)` with a
# run-time exponent): square-and-multiply over |n|, then 1 / result for a negative n. `n` is an
# i32 value; |i32::MIN| = 2^31 fits the i64 loop counter.
#must_use
fn _bj_powi(x: f64, n): f64 {
    var a: f64 = x;
    var p = n;
    var recip = 0;
    if (n < 0) {
        recip = 1;
        p = 0 - n;
    }
    var mul: f64 = 1.0;
    loop {
        if ((p & 1) != 0) { mul = mul * a; }
        p = p >> 1;
        if (p == 0) { break; }
        a = a * a;
    }
    if (recip == 1) {
        var q: f64 = 1.0 / mul;
        return q;
    }
    return mul;
}

# e^x, correctly rounded (src/crmath.cyr). Stands for `f64::exp`.
#must_use
fn _bj_exp(x: f64): f64 {
    var r: f64 = _bj_cr_exp(x);
    return r;
}

# √(x² + y²), correctly rounded. Stands for `f64::hypot`.
#must_use
fn _bj_hypot(x: f64, y: f64): f64 {
    var r: f64 = _bj_cr_hypot(x, y);
    return r;
}

# x^y, correctly rounded. Stands for `f64::powf`.
#must_use
fn _bj_powf(x: f64, y: f64): f64 {
    var r: f64 = _bj_cr_pow(x, y);
    return r;
}

# (sin x, cos x), each correctly rounded. Stands for `f64::sin_cos`. Read as `var s, c = _bj_sin_cos(x);` and
# bind each to an f64 local.
#must_use
fn _bj_sin_cos(x: f64): (f64, f64) {
    var s, c = _bj_cr_sin_cos(x);
    var sv: f64 = s;
    var cv: f64 = c;
    return (sv, cv);
}

# sin x, correctly rounded. Stands for `f64::sin`.
#must_use
fn _bj_sin(x: f64): f64 {
    var r: f64 = _bj_cr_sin(x);
    return r;
}

# cos x, correctly rounded. Stands for `f64::cos`.
#must_use
fn _bj_cos(x: f64): f64 {
    var r: f64 = _bj_cr_cos(x);
    return r;
}

# The angle of (x, y) in [−π, π], correctly rounded, C99 Annex F's specials and signs of zero included. Stands for
# `y.atan2(x)`.
#must_use
fn _bj_atan2(y: f64, x: f64): f64 {
    var r: f64 = _bj_cr_atan2(y, x);
    return r;
}

# atan x, correctly rounded: atan2(x, 1) is the same real number, so its correctly rounded value is atan's. The
# specials agree too: atan(±0) = ±0 (atan2(±0, 1)), atan(±∞) = ±π/2, atan(NaN) = NaN. Stands for `f64::atan`.
#must_use
fn _bj_atan(x: f64): f64 {
    var r: f64 = _bj_cr_atan2(x, 1.0);
    return r;
}

# tan x, correctly rounded (src/crmath.cyr's tan section, bijli's). Stands for `f64::tan`.
#must_use
fn _bj_tan(x: f64): f64 {
    var r: f64 = _bj_cr_tan(x);
    return r;
}

# acos x, correctly rounded (src/crmath_k.cyr, kimiya's). Stands for `f64::acos`.
#must_use
fn _bj_acos(x: f64): f64 {
    var r: f64 = _bj_k_cr_acos(x);
    return r;
}

# asin x, correctly rounded (src/crmath_k.cyr). Stands for `f64::asin`.
#must_use
fn _bj_asin(x: f64): f64 {
    var r: f64 = _bj_k_cr_asin(x);
    return r;
}

# sinh x, correctly rounded (src/crmath.cyr's sinh and cosh section, bijli's). Stands for `f64::sinh`.
#must_use
fn _bj_sinh(x: f64): f64 {
    var r: f64 = _bj_cr_sinh(x);
    return r;
}

# cosh x, correctly rounded (src/crmath.cyr's sinh and cosh section, bijli's). Stands for `f64::cosh`.
#must_use
fn _bj_cosh(x: f64): f64 {
    var r: f64 = _bj_cr_cosh(x);
    return r;
}

# ln x, correctly rounded (src/crmath_k.cyr, kimiya's). Stands for `f64::ln`.
#must_use
fn _bj_ln(x: f64): f64 {
    var r: f64 = _bj_k_cr_ln(x);
    return r;
}

# log10 x, correctly rounded (src/crmath_k.cyr, kimiya's): log10(10^k) = k exactly for k = 0 … 22. Stands for
# `f64::log10`.
#must_use
fn _bj_log10(x: f64): f64 {
    var r: f64 = _bj_k_cr_log10(x);
    return r;
}

# --- crmath_vx.cyr ---

# crmath_vx.cyr — 3-vector chains with an unbounded exponent (bijli, M1 part 5d-2, ADR 0002 row 18).
#
# At a range edge field.rs's and charge.rs's chains run with an unbounded exponent, as BjComplex's do (ADR 0002 row
# 14): every operation rounded to 53 bits (kimiya's _bj_k_ux_*, src/crmath_kx.cyr), the last one once into binary64.
# These are the helpers field.cyr and charge.cyr share (both are `private` files, so the helpers live in a file of
# internals).
#
# The guard: Rust's chain, then a test of what it computed. A chain of products and sums of doubles differs from the
# unbounded one only where a product leaves the normal range. One past DBL_MAX makes the sums it enters ±∞ or NaN. One
# below 2^-1022 (subnormal, or 0 from nonzero factors) is u, |u| < 2^-1022, and its 53-bit value differs. Where u meets
# an operand o with |o| ≥ 2^-968 it lies below half the gap next to o (at least 2^(-968-54) = 2^-1022), so both chains
# give o. Where |o| < 2^-968 the sum is below 2^-967, and a later term t with |t| ≥ 2^-913 absorbs it the same way;
# otherwise the final value is below 2^-912 in magnitude. Every product of normal values, and every sum of them, rounds
# alike in both (a difference below 2^-1022 is exact). So when the chain's sum (or difference) S has
# |S| ∈ [2^-900, DBL_MAX], the two chains agree on S: _BJ_VX_LO and _BJ_VX_HI. An exact 0 agrees when every product is
# exact (a zero factor, or normal): _bj_vx_exact. Anything else takes the unbounded chain, which gives Rust's bits
# wherever they were right. A non-finite input keeps Rust's chain.

# 2^-900, DBL_MAX and 2^-1022, the guards' bounds (bit patterns into f64 variables).
var _BJ_VX_LO: f64 = 0x07B0000000000000;
var _BJ_VX_HI: f64 = 0x7FEFFFFFFFFFFFFF;
var _BJ_VX_MN: f64 = 0x0010000000000000;

# 1 when |s| ∈ [2^-900, DBL_MAX] (the section comment); NaN gives 0.
#must_use
fn _bj_vx_band(s: f64): i64 {
    var a: f64 = f64_abs(s);
    if (a >= _BJ_VX_LO && a <= _BJ_VX_HI) { return 1; }
    return 0;
}

# 1 when the binary64 product p = a·b is its exact value for the chain: a zero factor, or |p| in (2^-1022, DBL_MAX].
#must_use
fn _bj_vx_exact(a: f64, b: f64, p: f64): i64 {
    if (a == 0.0 || b == 0.0) { return 1; }
    var ap: f64 = f64_abs(p);
    if (ap > _BJ_VX_MN && ap <= _BJ_VX_HI) { return 1; }
    return 0;
}

# 1 when none of a, b, c, d is NaN or infinite.
#must_use
fn _bj_vx_finite4(a: f64, b: f64, c: f64, d: f64): i64 {
    var s: f64 = (a - a) + (b - b) + (c - c) + (d - d);
    if (s == 0.0) { return 1; }
    return 0;
}

# x·y with an unbounded exponent, rounded to 53 bits: (s, e).
#must_use
fn _bj_vx_mul(x: f64, y: f64): (f64, i64) {
    var xs, xe = _bj_k_ux_from(x);
    var ys, ye = _bj_k_ux_from(y);
    var s, e = _bj_k_ux_mul(xs, xe, ys, ye);
    return (s, e);
}

# (x² + y²) + z², each operation with an unbounded exponent and rounded to 53 bits: (s, e).
#must_use
fn _bj_vx_sumsq(x: f64, y: f64, z: f64): (f64, i64) {
    var as2, ae2 = _bj_vx_mul(x, x);
    var bs2, be2 = _bj_vx_mul(y, y);
    var cs2, ce2 = _bj_vx_mul(z, z);
    var ss, se = _bj_k_ux_add(as2, ae2, bs2, be2);
    var ts, te = _bj_k_ux_add(ss, se, cs2, ce2);
    return (ts, te);
}

# 1 when Rust's (x² + y²) + z² = s is the unbounded chain's: |s| in the band, or every part 0, or a part not finite.
#must_use
fn _bj_vx_sumsq_plain(x: f64, y: f64, z: f64, s: f64): i64 {
    if (s >= _BJ_VX_LO && s <= _BJ_VX_HI) { return 1; }
    if (x == 0.0 && y == 0.0 && z == 0.0) { return 1; }
    var d: f64 = (x - x) + (y - y) + (z - z);
    if (d != 0.0) { return 1; }
    return 0;
}

# a·b − c·d with an unbounded exponent, to 53 bits: (s, e).
#must_use
fn _bj_vx_cross1(a: f64, b: f64, c: f64, d: f64): (f64, i64) {
    var ps, pe = _bj_vx_mul(a, b);
    var qs, qe = _bj_vx_mul(c, d);
    var s, e = _bj_k_ux_sub(ps, pe, qs, qe);
    return (s, e);
}

# One cross-product component, a·b − c·d rounded once into binary64, given Rust's r = a·b − c·d: r itself where Rust's
# chain is the unbounded one (r in the band, an exact 0, or a factor not finite), else the unbounded chain.
#must_use
fn _bj_vx_cross1_f64(a: f64, b: f64, c: f64, d: f64, r: f64): f64 {
    if (_bj_vx_band(r) == 1 || _bj_vx_finite4(a, b, c, d) == 0) { return r; }
    if (r == 0.0) {
        var p: f64 = a * b;
        var q: f64 = c * d;
        if (_bj_vx_exact(a, b, p) == 1 && _bj_vx_exact(c, d, q) == 1) { return r; }
    }
    var ps, pe = _bj_vx_mul(a, b);
    var qs, qe = _bj_vx_mul(c, d);
    var u: f64 = _bj_k_ux_sub_f64(ps, pe, qs, qe);
    return u;
}

# ── an angle with an unbounded exponent (M1 part 5c-2's, shared by complex powf and the Green's function) ──

# cos t to 53 bits, for the 53-bit t = ts·2^te: 1 below 2^-1022 (and at 0); past DBL_MAX by _bj_ux_sin_cos; else the
# double t's correctly rounded cosine (binary64's rounding of a normal value is the 53-bit one).
#must_use
fn _bj_vx_cos53(ts: f64, te): (f64, i64) {
    if (ts == 0.0 || te < 0 - 1022) { return (1.0, 0); }
    if (te > 1023) {
        var cb: f64 = _bj_ux_sin_cos(ts, te, 0);
        var bs, be = _bj_k_ux_from(cb);
        return (bs, be);
    }
    var t: f64 = _bj_k_ux_round(ts, te, 0.0);
    var c: f64 = _bj_cos(t);
    var s, e = _bj_k_ux_from(c);
    return (s, e);
}

# sin t to 53 bits, for the 53-bit t = ts·2^te: t itself below 2^-1022 (sin t = t(1 − t²/6) rounds to t; ±0 keeps
# its sign); past DBL_MAX by _bj_ux_sin_cos; else the double t's correctly rounded sine.
#must_use
fn _bj_vx_sin53(ts: f64, te): (f64, i64) {
    if (ts == 0.0 || te < 0 - 1022) { return (ts, te); }
    if (te > 1023) {
        var sb: f64 = _bj_ux_sin_cos(ts, te, 1);
        var bs, be = _bj_k_ux_from(sb);
        return (bs, be);
    }
    var t: f64 = _bj_k_ux_round(ts, te, 0.0);
    var sn: f64 = _bj_sin(t);
    var s, e = _bj_k_ux_from(sn);
    return (s, e);
}

# ── the point charges' chains (M1 part 5d-3), shared by field.cyr and charge.cyr ─────────────────────────────────

# The address a as a *f64 (a typed return binds an untyped word without a warning).
#must_use
fn _bj_vx_f64p(a): *f64 {
    return a;
}

# 1 when none of the n doubles at p is NaN or infinite.
#must_use
fn _bj_vx_finite_n(p: *f64, n): i64 {
    var s: f64 = 0.0;
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = p[i];
        s = s + (x - x);
    }
    if (s == 0.0) { return 1; }
    return 0;
}

# The unbounded chain's offset d = f − c, |d| and 1/|d|, each to 53 bits: d into s[0..2] and e[0..2], |d| into s[3]
# and e[3], 1/|d| into s[4] and e[4].
fn _bj_vx_offset_ux(f: *f64, c: *f64, s: *f64, e: *i64) {
    for (var i = 0; i < 3; i = i + 1) {
        var a: f64 = f[i];
        var b: f64 = c[i];
        var as, ae = _bj_k_ux_from(a);
        var bs, be = _bj_k_ux_from(b);
        var ds, de = _bj_k_ux_sub(as, ae, bs, be);
        s[i] = ds;
        e[i] = de;
    }
    var xs, xe = _bj_k_ux_mul(s[0], e[0], s[0], e[0]);
    var ys, ye = _bj_k_ux_mul(s[1], e[1], s[1], e[1]);
    var zs, ze = _bj_k_ux_mul(s[2], e[2], s[2], e[2]);
    var ps, pe = _bj_k_ux_add(xs, xe, ys, ye);
    var r2s, r2e = _bj_k_ux_add(ps, pe, zs, ze);
    var rs, re = _bj_k_ux_sqrt(r2s, r2e);
    s[3] = rs;
    e[3] = re;
    var is, ie = _bj_k_ux_div(1.0, 0, rs, re);
    s[4] = is;
    e[4] = ie;
    return 0;
}

# The unbounded chain of k·q₁·q₂·(1/r)³ for the offset f − c (Rust's left-to-right products; q₂ = 1 for one charge):
# the offset and 1/r as _bj_vx_offset_ux, the factor into s[5] and e[5].
fn _bj_vx_coulomb_ux(k: f64, q1: f64, q2: f64, f: *f64, c: *f64, s: *f64, e: *i64) {
    _bj_vx_offset_ux(f, c, s, e);
    var ks, ke = _bj_k_ux_from(k);
    var as, ae = _bj_k_ux_from(q1);
    var bs, be = _bj_k_ux_from(q2);
    var m1s, m1e = _bj_k_ux_mul(ks, ke, as, ae);
    var m2s, m2e = _bj_k_ux_mul(m1s, m1e, bs, be);
    var f1s, f1e = _bj_k_ux_mul(m2s, m2e, s[4], e[4]);
    var f2s, f2e = _bj_k_ux_mul(f1s, f1e, s[4], e[4]);
    var f3s, f3e = _bj_k_ux_mul(f2s, f2e, s[4], e[4]);
    s[5] = f3s;
    e[5] = f3e;
    return 0;
}

# k·q₁·q₂·(1/r)³·(f − c) at a range edge, into the three f64 at out (a BjFieldVector's x, y, z): _bj_vx_coulomb_ux,
# each component's product rounded once.
fn _bj_vx_coulomb_edge(k: f64, q1: f64, q2: f64, f: *f64, c: *f64, out) {
    var s: f64[6];
    var e: i64[6];
    _bj_vx_coulomb_ux(k, q1, q2, f, c, &s, &e);
    var o: *f64 = _bj_vx_f64p(out);
    var ox: f64 = _bj_k_ux_mul_f64(s[5], e[5], s[0], e[0]);
    var oy: f64 = _bj_k_ux_mul_f64(s[5], e[5], s[1], e[1]);
    var oz: f64 = _bj_k_ux_mul_f64(s[5], e[5], s[2], e[2]);
    o[0] = ox;
    o[1] = oy;
    o[2] = oz;
    return 0;
}

# 1 when the point-charge chain k·q₁·q₂·(1/r)³·d that Rust evaluated (r² = rsq, its first product kq = k·q₁, then
# kq2 = kq·q₂, the factor fct) is the unbounded one: the fast test of field.cyr's section comment, else a zero charge
# with r² finite (the offset exact, so 0·d has the unbounded chain's signs), or a non-finite input among the n at p.
#must_use
fn _bj_vx_coulomb_plain(rsq: f64, kq: f64, kq2: f64, fct: f64, q1: f64, q2: f64, p: *f64, n): i64 {
    var e1 = (load64(&rsq) >> 52) & 0x7FF;
    var e2 = (load64(&kq) >> 52) & 0x7FF;
    var e3 = (load64(&kq2) >> 52) & 0x7FF;
    var e4 = (load64(&fct) >> 52) & 0x7FF;
    if (((2046 - e1) | (e2 - 2) | (2046 - e2) | (e3 - 2) | (2046 - e3) | (e4 - 2) | (2046 - e4)) >= 0) { return 1; }
    if ((q1 == 0.0 || q2 == 0.0) && e1 <= 2046) { return 1; }               # an exact 0 factor, the offset exact
    if (_bj_vx_finite_n(p, n) == 0) { return 1; }
    return 0;
}

# --- fmtf.cyr ---

# fmtf.cyr — f64 to text: the shortest round-trip digits, in Rust's Display and serde_json's forms.
#
# Copied from impetus's src/fmtf.cyr (its ADR 0010) with the prefixes renamed (_im_ → _bj_): the bignum and the
# digit generator are impetus's, line for line (keep the two in step). Both Rust printers bijli's text comes from
# print the SHORTEST digits that parse back to the same double, choosing the closest to the exact value among them:
# Rust's `Display` (core's Grisu with a Dragon fallback) and serde_json 1.0.154's zmij (Schubfach). They differ only
# on an exact tie between two closest candidates: core rounds it up, zmij to the even digit. The digits come from
# Burger & Dybvig's free-format algorithm ("Printing Floating-Point Numbers Quickly and Accurately", 1996) on a
# small bignum: exact, with no tables. tests/golden/fmtf.tsv pins both forms against Rust over every binade, the
# powers of ten, the ties and a seeded sweep.
#
# bijli's change is the output: a bounded text buffer (BjText below) instead of a growing string builder, so the
# error record (src/error.cyr) and the log lines (src/log.cyr) format into fixed storage and nothing allocates.
# One f64 needs at most 327 bytes in either form (the smallest subnormal is "0." + 323 zeros + "5" in Display).
#
# Forms:
# - `_bj_fmt_f64_debug` (bijli's, M1 part 3c): Rust's `{:?}` — exponential below 1e-4 and from 1e16, else positional
#   with a fractional digit (`1.0`, `1e-5`, `1e16`), for the `{pos:?}` in trace_field_line's errors.
# - `_bj_fmt_f64_display`: Rust's `{}` — always positional, no ".0" (`100`, `0.1`, `-0`), `NaN`, `inf`, `-inf`.
# - `_bj_fmt_f64_json`: serde_json — positional while the decimal exponent is in −5..=15, with ".0" on an integer
#   (`100.0`, `0.00001`); otherwise `d.ddde±x` (`1e+16`, `1.5e-7`); `null` for NaN and ±∞.

# ── BjText: a bounded text buffer ───────────────────────────────────────────────────
# Three words: the buffer's address, its capacity in bytes, and the length written so far. The text is kept
# NUL-terminated; bytes past capacity − 1 are dropped and counted in the length, so `_bj_tx_overflowed` tells.

# t = an empty text over [buf, buf + cap), cap ≥ 1.
fn _bj_tx_init(t, buf, cap) {
    store64(t, buf);
    store64(t + 8, cap);
    store64(t + 16, 0);
    store8(buf, 0);
    return 0;
}

# The text's address (NUL-terminated).
#must_use
fn _bj_tx_ptr(t): i64 {
    return load64(t);
}

# The number of bytes kept (below the capacity).
#must_use
fn _bj_tx_len(t): i64 {
    var n = load64(t + 16);
    var cap = load64(t + 8);
    if (n > cap - 1) { return cap - 1; }
    return n;
}

# 1 when bytes were dropped for want of room.
#must_use
fn _bj_tx_overflowed(t): i64 {
    if (load64(t + 16) > load64(t + 8) - 1) { return 1; }
    return 0;
}

# Appends byte c.
fn _bj_tx_putc(t, c) {
    var n = load64(t + 16);
    var buf = load64(t);
    if (n < load64(t + 8) - 1) {
        store8(buf + n, c);
        store8(buf + n + 1, 0);
    }
    store64(t + 16, n + 1);
    return 0;
}

# Appends the C string s (one loop over its bytes, the same result as a _bj_tx_putc per byte).
fn _bj_tx_cstr(t, s) {
    var n = load64(t + 16);
    var room = load64(t + 8) - 1;
    var buf = load64(t);
    var i = 0;
    var c = load8(s);
    while (c != 0) {
        if (n + i < room) { store8(buf + n + i, c); }
        i = i + 1;
        c = load8(s + i);
    }
    var end = n + i;
    if (end < room) { store8(buf + end, 0); } else { store8(buf + room, 0); }
    store64(t + 16, end);
    return 0;
}

# Appends n as an unsigned decimal (a Rust `usize` or `u64`: the word's 64 bits, so 2^63 and above print as
# themselves).
fn _bj_tx_u64(t, n) {
    var d[24];
    var k = 0;
    var v = n;
    if (v < 0) {
        # The top bit set: split off the last digit with an unsigned divide by 10 (v = 2q + r).
        var q = (v >> 1) & 0x7FFFFFFFFFFFFFFF;
        var hi = q / 5;
        var lo = v - hi * 10;
        store8(&d, 48 + lo);
        k = 1;
        v = hi;
    }
    if (v == 0 && k == 0) {
        _bj_tx_putc(t, 48);
        return 0;
    }
    while (v != 0) {
        store8(&d + k, 48 + v % 10);
        v = v / 10;
        k = k + 1;
    }
    while (k > 0) {
        k = k - 1;
        _bj_tx_putc(t, load8(&d + k));
    }
    return 0;
}

# Appends n as a signed decimal (a Rust `i64` or `i32`).
fn _bj_tx_i64(t, n) {
    if (n < 0) {
        _bj_tx_putc(t, 45);
        if (n == 0 - 9223372036854775807 - 1) {
            _bj_tx_cstr(t, "9223372036854775808");
            return 0;
        }
        _bj_tx_u64(t, 0 - n);
        return 0;
    }
    _bj_tx_u64(t, n);
    return 0;
}

# ── bignum ──────────────────────────────────────────────────────────────────────────
# A non-negative integer in 32-bit limbs, little-endian: word 0 the limb count, words 1..40 the limbs.
# 40 limbs hold 2^1280; the algorithm's values stay below 2^1140. No leading zero limbs.
var _BJ_BN_WORDS = 41;

# a := v, for 0 <= v < 2^63.
fn _bj_bn_set(a, v) {
    var n = 0;
    var x = v;
    while (x != 0) {
        store64(a + 8 + n * 8, x & 0xFFFFFFFF);
        x = x >> 32;
        n = n + 1;
    }
    store64(a, n);
    return 0;
}

# dst := src.
fn _bj_bn_copy(dst, src) {
    var n = load64(src);
    for (var i = 0; i <= n; i = i + 1) { store64(dst + i * 8, load64(src + i * 8)); }
    return 0;
}

# a := a × m, for 0 < m < 2^31.
fn _bj_bn_mul_small(a, m) {
    var n = load64(a);
    var carry = 0;
    for (var i = 0; i < n; i = i + 1) {
        var t = load64(a + 8 + i * 8) * m + carry;
        store64(a + 8 + i * 8, t & 0xFFFFFFFF);
        carry = t >> 32;
    }
    while (carry != 0) {
        store64(a + 8 + n * 8, carry & 0xFFFFFFFF);
        carry = carry >> 32;
        n = n + 1;
    }
    store64(a, n);
    return 0;
}

# a := a × 10^k, for k >= 0 (in steps of 10^9).
fn _bj_bn_mul_pow10(a, k) {
    var left = k;
    while (left >= 9) {
        _bj_bn_mul_small(a, 1000000000);
        left = left - 9;
    }
    var m = 1;
    for (var i = 0; i < left; i = i + 1) { m = m * 10; }
    if (m > 1) { _bj_bn_mul_small(a, m); }
    return 0;
}

# a := a × 2^k, for k >= 0.
fn _bj_bn_shl(a, k) {
    var n = load64(a);
    if (n == 0) { return 0; }
    var q = k / 32;
    var b = k % 32;
    if (b != 0) {
        var carry = 0;
        for (var i = 0; i < n; i = i + 1) {
            var t = (load64(a + 8 + i * 8) << b) | carry;
            store64(a + 8 + i * 8, t & 0xFFFFFFFF);
            carry = t >> 32;
        }
        if (carry != 0) {
            store64(a + 8 + n * 8, carry);
            n = n + 1;
        }
    }
    if (q > 0) {
        var i = n - 1;
        while (i >= 0) {
            store64(a + 8 + (i + q) * 8, load64(a + 8 + i * 8));
            i = i - 1;
        }
        for (var j = 0; j < q; j = j + 1) { store64(a + 8 + j * 8, 0); }
        n = n + q;
    }
    store64(a, n);
    return 0;
}

# dst := a + b (dst distinct from both).
fn _bj_bn_sum(dst, a, b) {
    var na = load64(a);
    var nb = load64(b);
    var n = na;
    if (nb > n) { n = nb; }
    var carry = 0;
    for (var i = 0; i < n; i = i + 1) {
        var x = 0;
        var y = 0;
        if (i < na) { x = load64(a + 8 + i * 8); }
        if (i < nb) { y = load64(b + 8 + i * 8); }
        var t = x + y + carry;
        store64(dst + 8 + i * 8, t & 0xFFFFFFFF);
        carry = t >> 32;
    }
    if (carry != 0) {
        store64(dst + 8 + n * 8, carry);
        n = n + 1;
    }
    store64(dst, n);
    return 0;
}

# -1, 0 or 1 as a < b, a = b, a > b.
#must_use
fn _bj_bn_cmp(a, b): i64 {
    var na = load64(a);
    var nb = load64(b);
    if (na != nb) {
        if (na < nb) { return 0 - 1; }
        return 1;
    }
    var i = na - 1;
    while (i >= 0) {
        var x = load64(a + 8 + i * 8);
        var y = load64(b + 8 + i * 8);
        if (x != y) {
            if (x < y) { return 0 - 1; }
            return 1;
        }
        i = i - 1;
    }
    return 0;
}

# a := a − b, for a >= b.
fn _bj_bn_sub(a, b) {
    var na = load64(a);
    var nb = load64(b);
    var borrow = 0;
    for (var i = 0; i < na; i = i + 1) {
        var y = 0;
        if (i < nb) { y = load64(b + 8 + i * 8); }
        var t = load64(a + 8 + i * 8) - y - borrow;
        borrow = 0;
        if (t < 0) {
            t = t + 0x100000000;
            borrow = 1;
        }
        store64(a + 8 + i * 8, t);
    }
    while (na > 0 && load64(a + na * 8) == 0) { na = na - 1; }
    store64(a, na);
    return 0;
}

# The number of bits in x > 0.
#must_use
fn _bj_bitlen(x): i64 {
    var n = 0;
    var v = x;
    while (v != 0) {
        v = v >> 1;
        n = n + 1;
    }
    return n;
}

# ── shortest digits (Burger & Dybvig, free format) ──────────────────────────────────

# The shortest decimal digits of the positive finite double with bits `bits` that read back to it,
# the closest to its exact value among them: writes the ASCII digits to `digits` (17 bytes is
# enough) and returns (n, k) with value = 0.d1d2…dn × 10^k. When the exact value lies exactly
# halfway between the two closest candidates, `tie_even` 0 takes the upper one (Rust's core
# printer: 2^-25 is 2.9802322387695313e-8) and 1 the even one (serde_json's zmij: …5312e-8).
fn _bj_shortest(bits, digits, tie_even) {
    var be = (bits >> 52) & 0x7FF;
    var f = bits & 0xFFFFFFFFFFFFF;
    var e = 0 - 1074;
    if (be != 0) {
        f = f | 0x10000000000000;
        e = be - 1075;
    }
    # IEEE round-half-even on reading: the interval's ends belong to it when f is even.
    var even = 1 - (f & 1);
    var r[328];
    var s[328];
    var mp[328];
    var mm[328];
    var t[328];
    if (e >= 0) {
        if (f != 0x10000000000000) {
            _bj_bn_set(&r, f);
            _bj_bn_shl(&r, e + 1);
            _bj_bn_set(&s, 2);
            _bj_bn_set(&mp, 1);
            _bj_bn_shl(&mp, e);
            _bj_bn_copy(&mm, &mp);
        } else {
            _bj_bn_set(&r, f);
            _bj_bn_shl(&r, e + 2);
            _bj_bn_set(&s, 4);
            _bj_bn_set(&mp, 1);
            _bj_bn_shl(&mp, e + 1);
            _bj_bn_set(&mm, 1);
            _bj_bn_shl(&mm, e);
        }
    } else {
        if (e == 0 - 1074 || f != 0x10000000000000) {
            _bj_bn_set(&r, f);
            _bj_bn_shl(&r, 1);
            _bj_bn_set(&s, 1);
            _bj_bn_shl(&s, 1 - e);
            _bj_bn_set(&mp, 1);
            _bj_bn_set(&mm, 1);
        } else {
            _bj_bn_set(&r, f);
            _bj_bn_shl(&r, 2);
            _bj_bn_set(&s, 1);
            _bj_bn_shl(&s, 2 - e);
            _bj_bn_set(&mp, 2);
            _bj_bn_set(&mm, 1);
        }
    }
    # k = ⌈log10(v) − 1e-10⌉ from the binary exponent: never too large, at most one too small
    # (the fixup below adds the one).
    var lg: f64 = f64_from(e + _bj_bitlen(f) - 1);
    var est: f64 = lg * 0.30102999566398114 - 0.0000000001;
    var k = f64_to(f64_ceil(est));
    if (k >= 0) {
        _bj_bn_mul_pow10(&s, k);
    } else {
        _bj_bn_mul_pow10(&r, 0 - k);
        _bj_bn_mul_pow10(&mp, 0 - k);
        _bj_bn_mul_pow10(&mm, 0 - k);
    }
    _bj_bn_sum(&t, &r, &mp);
    var c = _bj_bn_cmp(&t, &s);
    if ((even == 1 && c >= 0) || (even == 0 && c > 0)) {
        _bj_bn_mul_small(&s, 10);
        k = k + 1;
    }
    var n = 0;
    while (1) {
        _bj_bn_mul_small(&r, 10);
        _bj_bn_mul_small(&mp, 10);
        _bj_bn_mul_small(&mm, 10);
        var d = 0;
        while (_bj_bn_cmp(&r, &s) >= 0) {
            _bj_bn_sub(&r, &s);
            d = d + 1;
        }
        var lo = _bj_bn_cmp(&r, &mm);
        var tc1 = 0;
        if (lo < 0 || (even == 1 && lo == 0)) { tc1 = 1; }
        _bj_bn_sum(&t, &r, &mp);
        var hi = _bj_bn_cmp(&t, &s);
        var tc2 = 0;
        if (hi > 0 || (even == 1 && hi == 0)) { tc2 = 1; }
        if (tc1 == 0 && tc2 == 0) {
            store8(digits + n, 48 + d);
            n = n + 1;
        } else {
            if (tc1 == 1 && tc2 == 1) {
                # Both neighbours read back: the closer one, 2r against s; a tie per `tie_even`.
                _bj_bn_copy(&t, &r);
                _bj_bn_shl(&t, 1);
                var half = _bj_bn_cmp(&t, &s);
                if (half > 0) { d = d + 1; }
                if (half == 0 && (tie_even == 0 || (d & 1) == 1)) { d = d + 1; }
            } elif (tc2 == 1) {
                d = d + 1;
            }
            store8(digits + n, 48 + d);
            n = n + 1;
            return (n, k);
        }
    }
    return (n, k);
}

# ── formatting ──────────────────────────────────────────────────────────────────────

# Appends `count` copies of byte c.
fn _bj_tx_repeat(t, c, count) {
    for (var i = 0; i < count; i = i + 1) { _bj_tx_putc(t, c); }
    return 0;
}

# Appends digits [from, to) of `digits`.
fn _bj_tx_digits(t, digits, from, to) {
    for (var i = from; i < to; i = i + 1) { _bj_tx_putc(t, load8(digits + i)); }
    return 0;
}

# Appends 0.d1…dn × 10^k positionally: "123.45", "0.00012", "12300". With `int_suffix` 1, an integer gets ".0"
# (serde_json's form).
fn _bj_tx_positional(t, digits, n, k, int_suffix) {
    if (k <= 0) {
        _bj_tx_putc(t, 48);
        _bj_tx_putc(t, 46);
        _bj_tx_repeat(t, 48, 0 - k);
        _bj_tx_digits(t, digits, 0, n);
        return 0;
    }
    if (k >= n) {
        _bj_tx_digits(t, digits, 0, n);
        _bj_tx_repeat(t, 48, k - n);
        if (int_suffix == 1) {
            _bj_tx_putc(t, 46);
            _bj_tx_putc(t, 48);
        }
        return 0;
    }
    _bj_tx_digits(t, digits, 0, k);
    _bj_tx_putc(t, 46);
    _bj_tx_digits(t, digits, k, n);
    return 0;
}

# Appends x as Rust's `Display` (`{}`) writes an f64. Mirrors `<f64 as Display>::fmt`.
fn _bj_fmt_f64_display(t, x: f64) {
    var bits = _bj_bits(x);
    if (x != x) {
        _bj_tx_cstr(t, "NaN");
        return 0;
    }
    if (bits < 0) { _bj_tx_putc(t, 45); }
    var mag = bits & 0x7FFFFFFFFFFFFFFF;
    if (mag == 0x7FF0000000000000) {
        _bj_tx_cstr(t, "inf");
        return 0;
    }
    if (mag == 0) {
        _bj_tx_putc(t, 48);
        return 0;
    }
    var digits[24];
    var n, k = _bj_shortest(mag, &digits, 0);
    _bj_tx_positional(t, &digits, n, k, 0);
    return 0;
}

# Appends x as Rust's `Debug` (`{:?}`) writes an f64 (core's `float_to_general_debug`): the shortest digits as Display,
# but exponential (`1e-5`, `1.5e16`, no `+`) when |x| is non-zero and below 1e-4, or at least 1e16, and otherwise
# positional with at least one fractional digit (`1.0`, `0.1`); `NaN`, `inf`, `-inf`, `0.0`, `-0.0`. Mirrors
# `<f64 as Debug>::fmt`.
fn _bj_fmt_f64_debug(t, x: f64) {
    var bits = _bj_bits(x);
    if (x != x) {
        _bj_tx_cstr(t, "NaN");
        return 0;
    }
    if (bits < 0) { _bj_tx_putc(t, 45); }
    var mag = bits & 0x7FFFFFFFFFFFFFFF;
    if (mag == 0x7FF0000000000000) {
        _bj_tx_cstr(t, "inf");
        return 0;
    }
    if (mag == 0) {
        _bj_tx_cstr(t, "0.0");
        return 0;
    }
    var digits[24];
    var n, k = _bj_shortest(mag, &digits, 0);
    var ax: f64 = _bj_from_bits(mag);
    var lo: f64 = 0.0001;
    var hi: f64 = 10000000000000000.0;
    if (ax < lo || ax >= hi) {
        _bj_tx_putc(t, load8(&digits));
        if (n > 1) {
            _bj_tx_putc(t, 46);
            _bj_tx_digits(t, &digits, 1, n);
        }
        _bj_tx_putc(t, 101);
        _bj_tx_i64(t, k - 1);
        return 0;
    }
    _bj_tx_positional(t, &digits, n, k, 1);
    return 0;
}

# Appends a Rust `[f64; 3]` as its Debug writes it: "[a, b, c]", each element in f64 Debug form. Mirrors
# `<[f64; 3] as Debug>::fmt`.
fn _bj_fmt_f64x3_debug(t, p: *f64) {
    _bj_tx_putc(t, 91);
    _bj_fmt_f64_debug(t, p[0]);
    _bj_tx_cstr(t, ", ");
    _bj_fmt_f64_debug(t, p[1]);
    _bj_tx_cstr(t, ", ");
    _bj_fmt_f64_debug(t, p[2]);
    _bj_tx_putc(t, 93);
    return 0;
}

# The number of non-finite values _bj_fmt_f64_json has written as `null`, as serde_json does. A caller that must
# not lose one zeroes it, writes, and checks it.
var _bj_json_nonfinite = 0;

# Appends x as serde_json 1.0.154 writes an f64 (zmij's format). Mirrors `serde_json::to_string(&x)`.
fn _bj_fmt_f64_json(t, x: f64) {
    var bits = _bj_bits(x);
    var mag = bits & 0x7FFFFFFFFFFFFFFF;
    if (mag >= 0x7FF0000000000000) {
        _bj_json_nonfinite = _bj_json_nonfinite + 1;
        _bj_tx_cstr(t, "null");
        return 0;
    }
    if (bits < 0) { _bj_tx_putc(t, 45); }
    if (mag == 0) {
        _bj_tx_cstr(t, "0.0");
        return 0;
    }
    var digits[24];
    var n, k = _bj_shortest(mag, &digits, 1);
    var ex = k - 1;
    if (ex >= 0 - 5 && ex <= 15) {
        _bj_tx_positional(t, &digits, n, k, 1);
        return 0;
    }
    _bj_tx_putc(t, load8(&digits));
    if (n > 1) {
        _bj_tx_putc(t, 46);
        _bj_tx_digits(t, &digits, 1, n);
    }
    _bj_tx_putc(t, 101);
    if (ex >= 0) {
        _bj_tx_putc(t, 43);
        _bj_tx_i64(t, ex);
    } else {
        _bj_tx_putc(t, 45);
        _bj_tx_i64(t, 0 - ex);
    }
    return 0;
}

# --- log.cyr ---

# log.cyr — bijli's logging: Rust's `tracing` sites and `logging::init` on sakshi (port of rust-old/src/logging.rs).
#
# Rust 1.2.0 emits through `tracing` (39 debug!, 15 warn!, 4 error!, 4 trace!), which prints nothing until the
# consumer installs a subscriber; `bijli::logging::init()` installs one filtered by the `BIJLI_LOG` environment
# variable, else "info". The port keeps that:
# - bijli's own gate, `_bj_log_level`, starts OFF (−1): a consumer that never calls bj_log_init sees nothing, as a
#   Rust consumer with no subscriber;
# - bj_log_init sets the gate from BIJLI_LOG, else from its default, once (Rust's `try_init`: the first
#   subscriber stays), and raises sakshi's process-wide level to it when sakshi's is lower, so bijli's events
#   reach sakshi's output. It never lowers sakshi's level: other libraries' logging is not bijli's to silence
#   (Rust's subscriber filters every crate; ADR 0002 row 8);
# - BIJLI_LOG takes a level (`off`, `error`, `warn`, `info`, `debug`, `trace`, any case, or `0`–`5`) or a
#   comma-separated list of directives, of which bare levels and `bijli=<level>` apply, the last one winning.
#   Other targets' directives are ignored, and a value with none that applies falls back to the default, as
#   `EnvFilter::try_from_env` falls back on an invalid value (ADR 0002 row 8: not EnvFilter's whole grammar).
# Each helper tests the gate before it touches the message, so a disabled site costs one compare (prakash measured
# strlen first at 28–37 ns and the level first at 7 ns). Sites that format values test `_bj_log_on(level)`, then
# write into a stack BjText (src/fmtf.cyr) and emit it with `_bj_log_text`.
# The levels are sakshi's: SK_ERROR 1, SK_WARN 2, SK_INFO 3, SK_DEBUG 4, SK_TRACE 5; −1 is off.

private

# bijli's gate: events above it are dropped before sakshi sees them. −1: off.
var _bj_log_level = 0 - 1;

# 1 once bj_log_init has run (the first call decides, as Rust's `try_init`).
var _bj_log_inited = 0;

# The lowercase of ASCII byte c.
#must_use
fn _bj_log_lower(c): i64 {
    if (c >= 65 && c <= 90) { return c + 32; }
    return c;
}

# 1 when [p, p + n) is the lowercase word w, compared without case.
#must_use
fn _bj_log_word_is(p, n, w): i64 {
    if (n != strlen(w)) { return 0; }
    for (var i = 0; i < n; i = i + 1) {
        if (_bj_log_lower(load8(p + i)) != load8(w + i)) { return 0; }
    }
    return 1;
}

# The level a level name [p, p + n) names: −1 for off, 1–5 for error … trace, −2 for no level.
#must_use
fn _bj_log_level_of(p, n): i64 {
    if (n == 1) {
        var c = load8(p);
        if (c == 48) { return 0 - 1; }
        if (c >= 49 && c <= 53) { return c - 48; }
        return 0 - 2;
    }
    if (_bj_log_word_is(p, n, "off") == 1) { return 0 - 1; }
    if (_bj_log_word_is(p, n, "error") == 1) { return 1; }
    if (_bj_log_word_is(p, n, "warn") == 1) { return 2; }
    if (_bj_log_word_is(p, n, "info") == 1) { return 3; }
    if (_bj_log_word_is(p, n, "debug") == 1) { return 4; }
    if (_bj_log_word_is(p, n, "trace") == 1) { return 5; }
    return 0 - 2;
}

# The level a filter string sets for bijli (see the header), or −2 when none of its directives applies or s is 0.
#must_use
public fn _bj_log_parse(s): i64 {
    if (s == 0) { return 0 - 2; }
    var lv = 0 - 2;
    var n = strlen(s);
    var at = 0;
    while (at <= n) {
        var end = at;
        while (end < n && load8(s + end) != 44) { end = end + 1; }
        var a = at;
        var b = end;
        while (a < b && load8(s + a) == 32) { a = a + 1; }
        while (b > a && load8(s + b - 1) == 32) { b = b - 1; }
        var eq = a;
        while (eq < b && load8(s + eq) != 61) { eq = eq + 1; }
        if (eq == b) {
            var l1 = _bj_log_level_of(s + a, b - a);
            if (l1 != 0 - 2) { lv = l1; }
        } elif (eq - a == 5 && memeq(s + a, "bijli", 5) == 1) {
            var l2 = _bj_log_level_of(s + eq + 1, b - eq - 1);
            if (l2 != 0 - 2) { lv = l2; }
        }
        at = end + 1;
    }
    return lv;
}

# Installs bijli's logging with `default_level` (a level name, as BIJLI_LOG takes) when BIJLI_LOG is unset or
# sets nothing for bijli; an unreadable default is "info". Once only: a later call changes nothing. Mirrors
# `bijli::logging::init_with_level`.
public fn bj_log_init_with_level(default_level): i64 {
    if (_bj_log_inited == 1) { return 0; }
    _bj_log_inited = 1;
    var lv = _bj_log_parse(getenv("BIJLI_LOG"));
    if (lv == 0 - 2) { lv = _bj_log_parse(default_level); }
    if (lv == 0 - 2) { lv = 3; }
    _bj_log_level = lv;
    if (lv > sakshi_get_level()) { sakshi_set_level(lv); }
    return 0;
}

# Installs bijli's logging at BIJLI_LOG's level, else "info". Mirrors `bijli::logging::init`.
public fn bj_log_init(): i64 {
    return bj_log_init_with_level("info");
}

# Sets bijli's gate directly (−1 off, 1 error … 5 trace), leaving sakshi's own level alone: for a consumer that
# configures sakshi itself.
public fn bj_set_log_level(level): i64 {
    _bj_log_level = level;
    return 0;
}

# bijli's gate (−1 off, 1 error … 5 trace).
#must_use
public fn bj_log_level(): i64 {
    return _bj_log_level;
}

# 1 when an event at `level` passes bijli's gate: test it before formatting a message.
#must_use
public fn _bj_log_on(level): i64 {
    if (level <= _bj_log_level) { return 1; }
    return 0;
}

# Emits the C string msg at `level` through sakshi, when the gate passes it.
public fn _bj_log(level, msg): i64 {
    if (level > _bj_log_level) { return 0; }
    var n = strlen(msg);
    if (level == 1) { sakshi_error(msg, n); }
    elif (level == 2) { sakshi_warn(msg, n); }
    elif (level == 3) { sakshi_info(msg, n); }
    elif (level == 4) { sakshi_debug(msg, n); }
    else { sakshi_trace(msg, n); }
    return 0;
}

# Emits a BjText's contents at `level` (the gate tested again, so a caller may skip `_bj_log_on`).
public fn _bj_log_text(level, t): i64 {
    if (level > _bj_log_level) { return 0; }
    return _bj_log(level, _bj_tx_ptr(t));
}

# Rust's `tracing::error!` with a fixed message.
public fn _bj_error(msg): i64 {
    if (_bj_log_level < 1) { return 0; }
    return _bj_log(1, msg);
}

# Rust's `tracing::warn!` with a fixed message.
public fn _bj_warn(msg): i64 {
    if (_bj_log_level < 2) { return 0; }
    return _bj_log(2, msg);
}

# Rust's `tracing::debug!` with a fixed message.
public fn _bj_debug(msg): i64 {
    if (_bj_log_level < 4) { return 0; }
    return _bj_log(4, msg);
}

# Rust's `tracing::trace!` with a fixed message.
public fn _bj_trace(msg): i64 {
    if (_bj_log_level < 5) { return 0; }
    return _bj_log(5, msg);
}

# --- error.cyr ---

# error.cyr — bijli's error codes and the per-thread last-error record (port of rust-old/src/error.rs).
#
# A fallible bijli function returns a value-form Result whose Err payload is one of the BJ_ERR_* codes:
# `var t, v = f(..); if (is_err_result(t) == 1) { .. v is the code .. }`. The golden token `E:InvalidParameter`
# is BJ_ERR_INVALID_PARAMETER: BJ_ERR_ + snake(variant). The values follow the Rust variant order and are
# append-only (the Cyrius form of #[non_exhaustive]); BJ_ERR_TRANSPORT (ADR 0002 row 7), BJ_ERR_ALLOCATION (row 9:
# where Rust aborts on a failed allocation, the port returns this) and BJ_ERR_DESERIALIZE (row 10: a JSON document
# the readers refuse, where Rust's serde_json returns its own error type) are Cyrius-only.
#
# Rust's variants carry data (`DimensionMismatch { expected, got }`, `InvalidPermittivity { value }`, the
# `reason` and `context` strings, mostly `format!`ed with the caller's values). A one-word Result can't hold it,
# so the code that makes an error also fills the calling thread's LAST-ERROR RECORD (ADR 0002 row 4): the code,
# the variant's fields, and Rust's Display text of the error byte for byte (`e.to_string()`, with f64 fields in
# Rust's shortest form through src/fmtf.cyr). bj_last_error_* read it back. A later error on the same thread
# replaces it; a success leaves it alone (as errno). Nothing is lost, nothing is logged (Rust logs no error),
# and nothing allocates per error.
#
# Where the record lives. Cyrius has no thread-local variables; lib/thread_local.cyr gives slots in a per-thread
# block, which on Linux the main thread has only once someone calls thread_local_init, and whose slot numbers are
# claimed once (thread_local_alloc). So:
# - on Linux the main thread (tid = pid) uses a static record, and needs no block; elsewhere (Windows, macOS) every
#   thread has a block, the main one included, and keeps its record in the slot like the others;
# - every other thread keeps a pointer to its own record, from fl_alloc (thread-safe since 6.5.19), in one slot
#   bijli claims on first use; bj_init claims it early, on the main thread before any worker starts, as
#   thread_local.cyr's contract asks of a library; bj_thread_done gives a worker's record back;
# - without a slot (the 112 library slots used up), or in thread_local.cyr's foreign mode (one slot array for
#   one glibc thread), every thread shares the static record.
#
# Making an error, inside bijli: `return Err(_bj_err_singularity());`, or for a formatted reason
#     var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
#     _bj_tx_cstr(t, "frequency must be positive, got ");
#     _bj_fmt_f64_display(t, frequency);
#     return Err(BJ_ERR_INVALID_PARAMETER);

private

public enum BjError {
    BJ_ERR_NONE = 0;
    BJ_ERR_DIMENSION_MISMATCH = 1;
    BJ_ERR_ZERO_CHARGE = 2;
    BJ_ERR_SINGULARITY = 3;
    BJ_ERR_INSUFFICIENT_RESOLUTION = 4;
    BJ_ERR_INVALID_PERMITTIVITY = 5;
    BJ_ERR_INVALID_PERMEABILITY = 6;
    BJ_ERR_DIVISION_BY_ZERO = 7;
    BJ_ERR_INVALID_PARAMETER = 8;
    BJ_ERR_TRANSPORT = 9;
    BJ_ERR_ALLOCATION = 10;
    BJ_ERR_DESERIALIZE = 11;
}

# ── the record ──────────────────────────────────────────────────────────────────────
# Words: 0 the code; 8 and 16 the integer fields (expected and got, or cells); 24 the f64 field (value, or
# domain_size) as bits; 32 the byte offset of the reason or context inside the text, −1 when the variant has
# none; 40–56 the text's BjText header (src/fmtf.cyr). The text, NUL-terminated, from byte 64.
const _BJ_ERR_REC = 2112;
const _BJ_ERR_TEXT = 64;
const _BJ_ERR_CAP = 2048;

# The static record: the Linux main thread's, and every thread's when there is no slot.
var _bj_err_static[2112];

# The thread_local slot holding a thread's record pointer: −1 until claimed, and −1 for good when none was left.
var _bj_err_slot = 0 - 1;

# The claim's once-gate (0 unclaimed, 1 claiming) and its published flag.
var _bj_err_gate = 0;
var _bj_err_ready = 0;

# Claims the slot once, from whichever thread gets there first; the others wait for it to be published.
fn _bj_err_claim(): i64 {
    if (_bj_err_ready == 1) { return _bj_err_slot; }
    if (atomic_cas(&_bj_err_gate, 0, 1) == 1) {
        _bj_err_slot = thread_local_alloc();
        atomic_store(&_bj_err_ready, 1);
    }
    while (atomic_load(&_bj_err_ready) == 0) { }
    return _bj_err_slot;
}

# r = an empty record: no error.
fn _bj_err_reset(r) {
    store64(r, BJ_ERR_NONE);
    store64(r + 8, 0);
    store64(r + 16, 0);
    store64(r + 24, 0);
    store64(r + 32, 0 - 1);
    _bj_tx_init(r + 40, r + _BJ_ERR_TEXT, _BJ_ERR_CAP);
    return 0;
}

# 1 when the calling thread uses the static record (see the header). On Linux, until thread_create has run
# (lib/atomic.cyr's `_threads_active`, armed before any child starts), the caller can only be the main thread, whose
# record is the static one whatever happens later: no slot, no syscall. Elsewhere the main thread keeps its record
# in the slot like any other, from the first call on, so the shortcut would switch records under it (the PE run
# of tests/error.tcyr's last_error_per_thread caught that).
#must_use
fn _bj_err_uses_static(): i64 {
    #ifdef CYRIUS_TARGET_LINUX
    if (_threads_active == 0) { return 1; }
    #endif
    if (_bj_err_claim() < 0) { return 1; }
    if (_tlocal_foreign == 1) { return 1; }
    #ifdef CYRIUS_TARGET_LINUX
    if (syscall(SYS_GETTID) == sys_getpid()) { return 1; }
    #endif
    return 0;
}

# The calling thread's record, made on first use.
#must_use
fn _bj_err_rec(): i64 {
    if (_bj_err_uses_static() == 1) {
        if (load64(&_bj_err_static + 40) == 0) { _bj_err_reset(&_bj_err_static); }
        return &_bj_err_static;
    }
    var r = thread_local_get(_bj_err_slot);
    if (r == 0) {
        r = fl_alloc(_BJ_ERR_REC);
        if (r == 0) {
            # No memory for this thread's record: share the static one rather than lose the error.
            if (load64(&_bj_err_static + 40) == 0) { _bj_err_reset(&_bj_err_static); }
            return &_bj_err_static;
        }
        _bj_err_reset(r);
        thread_local_set(_bj_err_slot, r);
    }
    return r;
}

# Starts recording error `code` on the calling thread: the record emptied, the code set, and the text's BjText
# returned for the Display text to be written into.
fn _bj_err_begin(code): i64 {
    var r = _bj_err_rec();
    _bj_err_reset(r);
    store64(r, code);
    return r + 40;
}

# ── making errors (bijli-internal) ──────────────────────────────────────────────────

# Records DimensionMismatch { expected, got } (usize fields); returns its code. Rust's text:
# "invalid field dimensions: expected {expected}D, got {got}D".
public fn _bj_err_dimension_mismatch(expected, got): i64 {
    var t = _bj_err_begin(BJ_ERR_DIMENSION_MISMATCH);
    store64(t - 32, expected);
    store64(t - 24, got);
    _bj_tx_cstr(t, "invalid field dimensions: expected ");
    _bj_tx_u64(t, expected);
    _bj_tx_cstr(t, "D, got ");
    _bj_tx_u64(t, got);
    _bj_tx_putc(t, 68);
    return BJ_ERR_DIMENSION_MISMATCH;
}

# Records ZeroCharge; returns its code.
public fn _bj_err_zero_charge(): i64 {
    var t = _bj_err_begin(BJ_ERR_ZERO_CHARGE);
    _bj_tx_cstr(t, "charge magnitude is zero — cannot compute field direction");
    return BJ_ERR_ZERO_CHARGE;
}

# Records Singularity; returns its code.
public fn _bj_err_singularity(): i64 {
    var t = _bj_err_begin(BJ_ERR_SINGULARITY);
    _bj_tx_cstr(t, "singularity: field evaluation at source point (distance = 0)");
    return BJ_ERR_SINGULARITY;
}

# Records InsufficientResolution { cells, domain_size }; returns its code. Rust's text:
# "grid resolution too coarse: {cells} cells for domain size {domain_size}".
public fn _bj_err_insufficient_resolution(cells, domain_size: f64): i64 {
    var t = _bj_err_begin(BJ_ERR_INSUFFICIENT_RESOLUTION);
    store64(t - 32, cells);
    store64(t - 16, _bj_bits(domain_size));
    _bj_tx_cstr(t, "grid resolution too coarse: ");
    _bj_tx_u64(t, cells);
    _bj_tx_cstr(t, " cells for domain size ");
    _bj_fmt_f64_display(t, domain_size);
    return BJ_ERR_INSUFFICIENT_RESOLUTION;
}

# Records InvalidPermittivity { value }; returns its code. Rust's text: "invalid permittivity: {value} (must be > 0)".
public fn _bj_err_invalid_permittivity(value: f64): i64 {
    var t = _bj_err_begin(BJ_ERR_INVALID_PERMITTIVITY);
    store64(t - 16, _bj_bits(value));
    _bj_tx_cstr(t, "invalid permittivity: ");
    _bj_fmt_f64_display(t, value);
    _bj_tx_cstr(t, " (must be > 0)");
    return BJ_ERR_INVALID_PERMITTIVITY;
}

# Records InvalidPermeability { value }; returns its code. Rust's text: "invalid permeability: {value} (must be > 0)".
public fn _bj_err_invalid_permeability(value: f64): i64 {
    var t = _bj_err_begin(BJ_ERR_INVALID_PERMEABILITY);
    store64(t - 16, _bj_bits(value));
    _bj_tx_cstr(t, "invalid permeability: ");
    _bj_fmt_f64_display(t, value);
    _bj_tx_cstr(t, " (must be > 0)");
    return BJ_ERR_INVALID_PERMEABILITY;
}

# Starts an error whose payload is a string, DivisionByZero { context }, InvalidParameter { reason } or the
# Cyrius-only Transport { reason }, Allocation { reason } and Deserialize { reason }: writes the Display text's prefix,
# marks where the string starts, and returns the BjText for the caller to write the string into. A code with no
# string payload gets no prefix.
public fn _bj_err_reason(code): i64 {
    var t = _bj_err_begin(code);
    if (code == BJ_ERR_DIVISION_BY_ZERO) { _bj_tx_cstr(t, "division by zero in EM calculation: "); }
    elif (code == BJ_ERR_INVALID_PARAMETER) { _bj_tx_cstr(t, "invalid parameter: "); }
    elif (code == BJ_ERR_TRANSPORT) { _bj_tx_cstr(t, "transport error: "); }
    elif (code == BJ_ERR_ALLOCATION) { _bj_tx_cstr(t, "allocation failed: "); }
    elif (code == BJ_ERR_DESERIALIZE) { _bj_tx_cstr(t, "deserialization failed: "); }
    else { return t; }
    store64(t - 8, _bj_tx_len(t));
    return t;
}

# Records DivisionByZero { context } with a fixed context; returns its code.
public fn _bj_err_division_by_zero(context): i64 {
    var t = _bj_err_reason(BJ_ERR_DIVISION_BY_ZERO);
    _bj_tx_cstr(t, context);
    return BJ_ERR_DIVISION_BY_ZERO;
}

# Records InvalidParameter { reason } with a fixed reason; returns its code.
public fn _bj_err_invalid_parameter(reason): i64 {
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, reason);
    return BJ_ERR_INVALID_PARAMETER;
}

# Records the Cyrius-only Transport { reason } (ADR 0002 row 7) with a fixed reason; returns its code.
public fn _bj_err_transport(reason): i64 {
    var t = _bj_err_reason(BJ_ERR_TRANSPORT);
    _bj_tx_cstr(t, reason);
    return BJ_ERR_TRANSPORT;
}

# ── the public API ──────────────────────────────────────────────────────────────────

# Claims bijli's thread-local slot now. Call it once on the main thread before starting threads that call
# bijli, as lib/thread_local.cyr asks of a library; without it the slot is claimed on the first error. Returns 1
# when threads get records of their own, 0 when they will share one (no slot was left).
public fn bj_init(): i64 {
    if (_bj_err_claim() < 0) { return 0; }
    return 1;
}

# Gives the calling worker thread's record back (call it before the thread ends, so a thread pool that churns
# threads does not keep one record per thread ever started). Its last error is forgotten. No effect on a thread
# that uses the static record.
public fn bj_thread_done(): i64 {
    if (_bj_err_uses_static() == 1) { return 0; }
    var r = thread_local_get(_bj_err_slot);
    if (r != 0) {
        thread_local_set(_bj_err_slot, 0);
        fl_free(r);
    }
    return 0;
}

# The calling thread's last error code, or BJ_ERR_NONE.
#must_use
public fn bj_last_error(): i64 {
    return load64(_bj_err_rec());
}

# The calling thread's last error as Rust's Display writes it (`e.to_string()`), NUL-terminated; "" for none.
# Valid until the thread's next error.
#must_use
public fn bj_last_error_display(): i64 {
    return _bj_err_rec() + _BJ_ERR_TEXT;
}

# The reason or context string of the last error when it has one (DivisionByZero, InvalidParameter, Transport,
# Allocation),
# NUL-terminated; "" otherwise.
#must_use
public fn bj_last_error_detail(): i64 {
    var r = _bj_err_rec();
    var at = load64(r + 32);
    if (at < 0) { return ""; }
    return r + _BJ_ERR_TEXT + at;
}

# DimensionMismatch's `expected` (0 for another error).
#must_use
public fn bj_last_error_expected(): i64 {
    var r = _bj_err_rec();
    if (load64(r) != BJ_ERR_DIMENSION_MISMATCH) { return 0; }
    return load64(r + 8);
}

# DimensionMismatch's `got` (0 for another error).
#must_use
public fn bj_last_error_got(): i64 {
    var r = _bj_err_rec();
    if (load64(r) != BJ_ERR_DIMENSION_MISMATCH) { return 0; }
    return load64(r + 16);
}

# InsufficientResolution's `cells` (0 for another error).
#must_use
public fn bj_last_error_cells(): i64 {
    var r = _bj_err_rec();
    if (load64(r) != BJ_ERR_INSUFFICIENT_RESOLUTION) { return 0; }
    return load64(r + 8);
}

# InsufficientResolution's `domain_size` (0 for another error).
#must_use
public fn bj_last_error_domain_size(): f64 {
    var r = _bj_err_rec();
    var v: f64 = 0.0;
    if (load64(r) == BJ_ERR_INSUFFICIENT_RESOLUTION) { v = load64(r + 24); }
    return v;
}

# InvalidPermittivity's or InvalidPermeability's `value` (0 for another error).
#must_use
public fn bj_last_error_value(): f64 {
    var r = _bj_err_rec();
    var c = load64(r);
    var v: f64 = 0.0;
    if (c == BJ_ERR_INVALID_PERMITTIVITY || c == BJ_ERR_INVALID_PERMEABILITY) { v = load64(r + 24); }
    return v;
}

# Forgets the calling thread's last error.
public fn bj_last_error_clear(): i64 {
    _bj_err_reset(_bj_err_rec());
    return 0;
}

# The Rust variant name of an error code (`"InvalidParameter"`), "None" for BJ_ERR_NONE, "Transport", "Allocation"
# and "Deserialize" for the Cyrius-only codes, or "Unknown" for a value that is no code.
#must_use
public fn bj_error_name(code): i64 {
    if (code == BJ_ERR_NONE) { return "None"; }
    if (code == BJ_ERR_DIMENSION_MISMATCH) { return "DimensionMismatch"; }
    if (code == BJ_ERR_ZERO_CHARGE) { return "ZeroCharge"; }
    if (code == BJ_ERR_SINGULARITY) { return "Singularity"; }
    if (code == BJ_ERR_INSUFFICIENT_RESOLUTION) { return "InsufficientResolution"; }
    if (code == BJ_ERR_INVALID_PERMITTIVITY) { return "InvalidPermittivity"; }
    if (code == BJ_ERR_INVALID_PERMEABILITY) { return "InvalidPermeability"; }
    if (code == BJ_ERR_DIVISION_BY_ZERO) { return "DivisionByZero"; }
    if (code == BJ_ERR_INVALID_PARAMETER) { return "InvalidParameter"; }
    if (code == BJ_ERR_TRANSPORT) { return "Transport"; }
    if (code == BJ_ERR_ALLOCATION) { return "Allocation"; }
    if (code == BJ_ERR_DESERIALIZE) { return "Deserialize"; }
    return "Unknown";
}

# The Rust error's Display text without its payload: thiserror's message up to the first field
# (`"invalid parameter"` for `invalid parameter: negative frequency`), the whole message for ZeroCharge and
# Singularity. "no error" for BJ_ERR_NONE and "unknown error" for a value that is no code.
#must_use
public fn bj_error_message(code): i64 {
    if (code == BJ_ERR_NONE) { return "no error"; }
    if (code == BJ_ERR_DIMENSION_MISMATCH) { return "invalid field dimensions"; }
    if (code == BJ_ERR_ZERO_CHARGE) { return "charge magnitude is zero — cannot compute field direction"; }
    if (code == BJ_ERR_SINGULARITY) { return "singularity: field evaluation at source point (distance = 0)"; }
    if (code == BJ_ERR_INSUFFICIENT_RESOLUTION) { return "grid resolution too coarse"; }
    if (code == BJ_ERR_INVALID_PERMITTIVITY) { return "invalid permittivity"; }
    if (code == BJ_ERR_INVALID_PERMEABILITY) { return "invalid permeability"; }
    if (code == BJ_ERR_DIVISION_BY_ZERO) { return "division by zero in EM calculation"; }
    if (code == BJ_ERR_INVALID_PARAMETER) { return "invalid parameter"; }
    if (code == BJ_ERR_TRANSPORT) { return "transport error"; }
    if (code == BJ_ERR_ALLOCATION) { return "allocation failed"; }
    if (code == BJ_ERR_DESERIALIZE) { return "deserialization failed"; }
    return "unknown error";
}

# --- complex.cyr ---

# complex.cyr — BjComplex, complex numbers by value, and bijli's one time convention.
#
# ── The time convention (ADR 0002 row 5, port plan §4.4) ────────────────────────────────────────────────────────
# Stated here once: every module's doc points here instead of carrying its own.
# - A time-harmonic quantity is the real part of a phasor times e^{+jωt}: a(t) = Re{A·e^{+jωt}}, with j = √−1
#   written as an engineer writes it. So a wave travelling toward +z is A·e^{−jkz}; an inductor's impedance is
#   +jωL and a capacitor's 1/(jωC); a lossy permittivity is ε' − jε'', and an absorbing index is n − jκ
#   (Im < 0). This is the convention of FDTD (Taflove & Hagness), RF (Pozar), antennas (Balanis) and Gaussian
#   beams (Siegman), and the one Touchstone files and Smith charts are defined in.
# - Circular polarization is named with IEEE handedness (IEEE Std 145): right-hand circular rotates with the
#   fingers of a right hand whose thumb points along the propagation (clockwise when the wave is viewed receding
#   from the observer). For a wave along +z, the right-hand circular Jones vector is (1, −j)/√2: at z = 0 its field
#   is x̂·cos ωt + ŷ·sin ωt, turning from x̂ to ŷ.
# - Rust bijli 1.2.0 mixed this with e^{−iωt} in polarization, beam, the field Green's function and the FDTD media.
#   The port uses the one convention everywhere: those modules' complex amplitudes are the oracle's conjugates
#   and their phases its negations, mapped exactly in the parity harness (ADR 0002 row 5).
#
# ── BjComplex ────────────────────────────────────────────────────────────────────────────────────────────────────
# Port of Rust hisab 1.4.0's `num::Complex`, which bijli 1.2.0 re-exports (`bijli::polarization::Complex`), and of
# polarization.rs's `complex_real` / `complex_zero` / `complex_from_polar` and `ComplexExt::norm`. Every operation
# is hisab's formula in hisab's order of operations (port plan §9.2), so each golden row compares bit for bit:
# no hypot rescue in `abs`, the textbook division, `sqrt` through polar form.
#
# Range edges (ADR 0002 row 14, the user's decision of 2026-11-12, kimiya ADR 0002 #20). Where a component leaves
# [2^-511, 2^511), re², a cross product or their sum can over- or underflow although the result is representable:
# abs(1e160, 1e160) is ∞, (1e200, 1e200)² has a real part ∞ − ∞ = NaN for 0, 1/(1e160, 0) is 0 for 1e-160. There hisab's
# chain is evaluated with an unbounded exponent (src/crmath_kx.cyr's _bj_k_ux_*: every operation rounded to 53 bits,
# nothing over- or underflowing) and its last operation rounded once into binary64 — abs, norm_sq, the product, inv, the
# quotient, is_zero's comparison, and sqrt's root and polar products. When every nonzero component lies in [2^-511,
# 2^511) no square or product leaves the normal range, so that evaluation IS hisab's in binary64, and the rows keep
# Rust's bits; a NaN or infinite component keeps hisab's chain as it is. ln and powf take |z| from the same evaluation
# (row 14). The chain's transcendental steps follow the same rule (ADR 0002 row 16, M1 part 5c-2): where e^re (exp),
# cosh and sinh of im (sin, cos), ln or pow of |z|, the power |z|^n, or an angle (sqrt's arg z / 2, powf's n·arg z)
# is not a normal double, it is taken to 53 bits with an unbounded exponent (src/crmath_ux.cyr) and each final product
# rounded once: exp(710 + j0) is (∞, 0) where hisab's is (∞, NaN), sin(j800) (0, ∞) for (NaN, ∞). powf has no cutoff
# (row 15): hisab returned 0 for every |z|² < 1e-300, whatever the exponent. The transcendentals are bijli's correctly
# rounded ones (src/mathx.cyr, src/crmath_ux.cyr), so the results are the same on every target and match the corrected
# oracle where glibc misrounds.
#
# A BjComplex is a 16-byte struct value: returned in two registers, passed by address and copied on entry. Rust's
# operators are the operator fns, `a + b`, `a - b`, `a * b`, `a / b`; with an f64 operand, `a.scale(s)` (Rust's
# `a * s` and `s * a`: the same two products) and `a.div_f64(s)`. A compound assignment is `a = a + b` (Cyrius
# refuses `+=` on a struct value; hisab's `+=` computes the same). `From<f64>` is BjComplex_from_real, `From<(f64,
# f64)>` is BjComplex_new, `Default` is BjComplex_default. `sin` and `cos` take bijli's correctly rounded sinh and
# cosh (src/crmath.cyr, M1 part 2d).

private

public struct BjComplex {
    re: f64;
    im: f64;
}

# ── the range edges (ADR 0002 row 14) ─────────────────────────────────────────────────────────────────────────────

# 1 when x is ±0 or 2^-511 ≤ |x| < 2^511: its square, and its product with any other such value, is normal (or
# exactly 0), and so is a sum of two of them, unless it is past DBL_MAX: < 2^1023.
#must_use
fn _bj_cx_ok(x: f64): i64 {
    var b = _bj_bits(x) & 0x7FFFFFFFFFFFFFFF;
    if (b == 0) { return 1; }
    var be = b >> 52;
    if (be >= 512 && be < 1534) { return 1; }
    return 0;
}

# 1 when hisab's chain on x and y is the unbounded one (both components in range), or must stay hisab's (one not
# finite); 0 at a range edge.
#must_use
fn _bj_cx_plain(x: f64, y: f64): i64 {
    var ex = (load64(&x) >> 52) & 0x7FF;
    var ey = (load64(&y) >> 52) & 0x7FF;
    if (((ex - 512) | (ey - 512) | (1533 - ex) | (1533 - ey)) >= 0) { return 1; }   # the common case: one test
    if (ex == 2047 || ey == 2047) { return 1; }
    if (_bj_cx_ok(x) == 1 && _bj_cx_ok(y) == 1) { return 1; }
    return 0;
}

# _bj_cx_plain for an operation on two complex values: hisab's chain when any of the four parts is not finite, or
# all are in range.
#must_use
fn _bj_cx_plain4(a: f64, b: f64, c: f64, d: f64): i64 {
    var ea = (load64(&a) >> 52) & 0x7FF;
    var eb = (load64(&b) >> 52) & 0x7FF;
    var ec = (load64(&c) >> 52) & 0x7FF;
    var ed = (load64(&d) >> 52) & 0x7FF;
    # the common case, every biased exponent in [512, 1533]: each difference below is ≥ 0, so their OR is (one test)
    var lo = (ea - 512) | (eb - 512) | (ec - 512) | (ed - 512);
    var hi = (1533 - ea) | (1533 - eb) | (1533 - ec) | (1533 - ed);
    if ((lo | hi) >= 0) { return 1; }
    if (ea == 2047 || eb == 2047 || ec == 2047 || ed == 2047) { return 1; }
    if (_bj_cx_ok(a) + _bj_cx_ok(b) + _bj_cx_ok(c) + _bj_cx_ok(d) == 4) { return 1; }
    return 0;
}

# x·y with an unbounded exponent, rounded to 53 bits: (s, e).
#must_use
fn _bj_cx_ux_mul(x: f64, y: f64): (f64, i64) {
    var xs, xe = _bj_k_ux_from(x);
    var ys, ye = _bj_k_ux_from(y);
    var s, e = _bj_k_ux_mul(xs, xe, ys, ye);
    return (s, e);
}

# x² + y², each operation with an unbounded exponent and rounded to 53 bits: (s, e).
#must_use
fn _bj_cx_ux_sumsq(x: f64, y: f64): (f64, i64) {
    var as2, ae2 = _bj_cx_ux_mul(x, x);
    var bs2, be2 = _bj_cx_ux_mul(y, y);
    var s, e = _bj_k_ux_add(as2, ae2, bs2, be2);
    return (s, e);
}

# |x + jy| with an unbounded exponent, to 53 bits: (s, e).
#must_use
fn _bj_cx_ux_abs(x: f64, y: f64): (f64, i64) {
    var s, e = _bj_cx_ux_sumsq(x, y);
    var rs, re2 = _bj_k_ux_sqrt(s, e);
    return (rs, re2);
}

# ── the transcendental range edges (ADR 0002 row 16) ──────────────────────────────────────────────────────────────

# arg z with an unbounded exponent, to 53 bits, given its binary64 value g: g itself when it is exact (im = ±0: ±0 or
# ±π) or normal and above 2^-1022 (binary64's rounding is then the 53-bit one); else im/re to 53 bits. An arg that
# small has re > 0 and |im/re| < 2^-1021, where atan2(im, re) = (im/re)(1 − δ) with δ < 2^-2042, while a quotient of
# two doubles that is not a 53-bit value lies at least 2^-107 (relative) from every 53-bit midpoint: both round alike.
#must_use
fn _bj_cx_arg_ux(g: f64, re: f64, im: f64): (f64, i64) {
    var gb = _bj_bits(g) & 0x7FFFFFFFFFFFFFFF;
    if (im == 0.0 || gb > 0x0010000000000000) {
        var s, e = _bj_k_ux_from(g);
        return (s, e);
    }
    var ys, ye = _bj_k_ux_from(im);
    var xs, xe = _bj_k_ux_from(re);
    var qs, qe = _bj_k_ux_div(ys, ye, xs, xe);
    return (qs, qe);
}

# z^n = from_polar(|z|^n, n·arg z) with an unbounded exponent, for the 53-bit |z| = as·2^ae (positive, normal) and a
# finite n: |z|^n by _bj_ux_pow, arg z by _bj_cx_arg_ux, their product n·arg to 53 bits, its cosine and sine, each
# polar product rounded once.
#must_use
fn _bj_cx_powf_edge(as: f64, ae, n: f64, g: f64, re: f64, im: f64): BjComplex {
    var ps, pe = _bj_ux_pow(as, ae, n);
    var gs, ge = _bj_cx_arg_ux(g, re, im);
    var ns, ne = _bj_k_ux_from(n);
    var ts, te = _bj_k_ux_mul(gs, ge, ns, ne);
    var cs, ce = _bj_vx_cos53(ts, te);
    var ss, se = _bj_vx_sin53(ts, te);
    var wr: f64 = _bj_k_ux_mul_f64(ps, pe, cs, ce);
    var wi: f64 = _bj_k_ux_mul_f64(ps, pe, ss, se);
    var w: BjComplex;
    w.re = wr;
    w.im = wi;
    return w;
}

# 1 when complex sin and cos keep hisab's chain: |im| ≤ 710 (cosh and sinh are normal, or sinh is im itself), or a part
# is not finite; 0 at an edge.
#must_use
fn _bj_cx_hyp_plain(re: f64, im: f64): i64 {
    var ib = _bj_bits(im) & 0x7FFFFFFFFFFFFFFF;
    if (ib <= 0x4086300000000000) { return 1; }                                 # |im| ≤ 710
    if (ib >= 0x7FF0000000000000) { return 1; }
    if ((_bj_bits(re) & 0x7FF0000000000000) == 0x7FF0000000000000) { return 1; }
    return 0;
}

# 1 when powf's binary64 chain is the unbounded one: |z|^n = r normal and above 2^-1022, arg z = g exact or above
# 2^-1022, and θ = g·n exactly 0 or normal and above 2^-1022 (every intermediate's rounding is then the 53-bit one);
# 0 at an edge.
#must_use
fn _bj_cx_powf_plain(r: f64, g: f64, theta: f64, n: f64, im: f64): i64 {
    var rb = _bj_bits(r) & 0x7FFFFFFFFFFFFFFF;
    if (rb <= 0x0010000000000000 || rb >= 0x7FF0000000000000) { return 0; }
    var gb = _bj_bits(g) & 0x7FFFFFFFFFFFFFFF;
    if (im != 0.0 && gb <= 0x0010000000000000) { return 0; }
    var tb = _bj_bits(theta) & 0x7FFFFFFFFFFFFFFF;
    if (tb == 0) {
        if (gb == 0 || n == 0.0) { return 1; }
        return 0;
    }
    if (tb <= 0x0010000000000000 || tb >= 0x7FF0000000000000) { return 0; }
    return 1;
}

# The product (ar + j·ai)(br + j·bi) at a range edge: hisab's chain with an unbounded exponent, each sum rounded once.
#must_use
fn _bj_cx_mul_edge(ar: f64, ai: f64, br: f64, bi: f64): BjComplex {
    var ps, pe = _bj_cx_ux_mul(ar, br);
    var qs, qe = _bj_cx_ux_mul(ai, bi);
    var r: f64 = _bj_k_ux_sub_f64(ps, pe, qs, qe);
    var us, ue = _bj_cx_ux_mul(ar, bi);
    var vs, ve = _bj_cx_ux_mul(ai, br);
    var i: f64 = _bj_k_ux_add_f64(us, ue, vs, ve);
    var z: BjComplex;
    z.re = r;
    z.im = i;
    return z;
}

# The quotient (ar + j·ai)/(br + j·bi) at a range edge: hisab's chain with an unbounded exponent, each quotient rounded
# once.
#must_use
fn _bj_cx_div_edge(ar: f64, ai: f64, br: f64, bi: f64): BjComplex {
    var ds, de = _bj_cx_ux_sumsq(br, bi);
    var ps, pe = _bj_cx_ux_mul(ar, br);
    var qs, qe = _bj_cx_ux_mul(ai, bi);
    var ns, ne = _bj_k_ux_add(ps, pe, qs, qe);
    var us, ue = _bj_cx_ux_mul(ai, br);
    var vs, ve = _bj_cx_ux_mul(ar, bi);
    var ms, me = _bj_k_ux_sub(us, ue, vs, ve);
    var r: f64 = _bj_k_ux_div_f64(ns, ne, ds, de);
    var i: f64 = _bj_k_ux_div_f64(ms, me, ds, de);
    var z: BjComplex;
    z.re = r;
    z.im = i;
    return z;
}

# re + j·im. Mirrors `Complex::new` (and `From<(f64, f64)>`).
#must_use
#pure
public fn BjComplex_new(re: f64, im: f64): BjComplex {
    var z: BjComplex;
    z.re = re;
    z.im = im;
    return z;
}

# re + j·0. Mirrors `Complex::from_real` (and `From<f64>`).
#must_use
#pure
public fn BjComplex_from_real(re: f64): BjComplex {
    var z: BjComplex;
    z.re = re;
    z.im = 0.0;
    return z;
}

# 0 + j·0. Mirrors `Complex::default`.
#must_use
#pure
public fn BjComplex_default(): BjComplex {
    var z: BjComplex;
    z.re = 0.0;
    z.im = 0.0;
    return z;
}

# r·e^{jθ} = (r·cos θ, r·sin θ). Mirrors `Complex::from_polar`.
#must_use
#pure
public fn BjComplex_from_polar(r: f64, theta: f64): BjComplex {
    var c: f64 = _bj_cos(theta);
    var s: f64 = _bj_sin(theta);
    var z: BjComplex;
    z.re = r * c;
    z.im = r * s;
    return z;
}

# a + b. Mirrors `Add for Complex` (and `+=`).
#must_use
#pure
public fn BjComplex_add(a: BjComplex, b: BjComplex): BjComplex {
    var z: BjComplex;
    z.re = a.re + b.re;
    z.im = a.im + b.im;
    return z;
}

# a − b. Mirrors `Sub for Complex` (and `-=`).
#must_use
#pure
public fn BjComplex_sub(a: BjComplex, b: BjComplex): BjComplex {
    var z: BjComplex;
    z.re = a.re - b.re;
    z.im = a.im - b.im;
    return z;
}

# a·b = (a.re·b.re − a.im·b.im, a.re·b.im + a.im·b.re), each product rounded (no fused multiply-add, as rustc
# compiles it); at a range edge with an unbounded exponent, the sum rounded once (ADR 0002 row 14). Mirrors
# `Mul for Complex` (and `*=`).
#must_use
#pure
public fn BjComplex_mul(a: BjComplex, b: BjComplex): BjComplex {
    if (_bj_cx_plain4(a.re, a.im, b.re, b.im) == 0) {
        var w: BjComplex = _bj_cx_mul_edge(a.re, a.im, b.re, b.im);
        return w;
    }
    var z: BjComplex;
    z.re = a.re * b.re - a.im * b.im;
    z.im = a.re * b.im + a.im * b.re;
    return z;
}

# a / b by the textbook formula: ((a.re·b.re + a.im·b.im)/d, (a.im·b.re − a.re·b.im)/d), d = b.re² + b.im²; at a
# range edge with an unbounded exponent, each quotient rounded once (ADR 0002 row 14). Mirrors `Div for Complex`.
#must_use
#pure
public fn BjComplex_div(a: BjComplex, b: BjComplex): BjComplex {
    if (_bj_cx_plain4(a.re, a.im, b.re, b.im) == 0) {
        var w: BjComplex = _bj_cx_div_edge(a.re, a.im, b.re, b.im);
        return w;
    }
    var d: f64 = b.re * b.re + b.im * b.im;
    var z: BjComplex;
    z.re = (a.re * b.re + a.im * b.im) / d;
    z.im = (a.im * b.re - a.re * b.im) / d;
    return z;
}

# −a. Mirrors `Neg for Complex`.
#must_use
#pure
public fn BjComplex_neg(a: BjComplex): BjComplex {
    var z: BjComplex;
    z.re = -a.re;
    z.im = -a.im;
    return z;
}

impl BjComplex {
    # √(re² + im²), no rescaling; at a range edge with an unbounded exponent, the root rounded once (see the header,
    # ADR 0002 row 14). Mirrors `Complex::abs`.
    #must_use
    #pure
    public fn abs(self): f64 {
        if (_bj_cx_plain(self.re, self.im) == 1) {
            var s: f64 = self.re * self.re + self.im * self.im;
            var r: f64 = f64_sqrt(s);
            return r;
        }
        var us, ue = _bj_cx_ux_sumsq(self.re, self.im);
        var u: f64 = _bj_k_ux_sqrt_f64(us, ue);
        return u;
    }

    # |z|, the same as abs. Mirrors bijli's `ComplexExt::norm`.
    #must_use
    #pure
    public fn norm(self): f64 {
        var r: f64 = BjComplex_abs(self);
        return r;
    }

    # re − j·im. Mirrors `Complex::conj`.
    #must_use
    #pure
    public fn conj(self): BjComplex {
        var z: BjComplex;
        z.re = self.re;
        z.im = -self.im;
        return z;
    }

    # re² + im²; at a range edge with an unbounded exponent, the sum rounded once (ADR 0002 row 14). Mirrors
    # `Complex::norm_sq` (and `ComplexExt::norm_sq`).
    #must_use
    #pure
    public fn norm_sq(self): f64 {
        if (_bj_cx_plain(self.re, self.im) == 1) {
            var r: f64 = self.re * self.re + self.im * self.im;
            return r;
        }
        var as2, ae2 = _bj_cx_ux_mul(self.re, self.re);
        var bs2, be2 = _bj_cx_ux_mul(self.im, self.im);
        var u: f64 = _bj_k_ux_add_f64(as2, ae2, bs2, be2);
        return u;
    }

    # atan2(im, re), in [−π, π]. Mirrors `Complex::arg` (and `ComplexExt::arg`).
    #must_use
    #pure
    public fn arg(self): f64 {
        var r: f64 = _bj_atan2(self.im, self.re);
        return r;
    }

    # e^re·(cos im, sin im); for a finite z with re outside [−708, 709] (e^re past DBL_MAX or below 2^-1022) e^re
    # with an unbounded exponent and each product rounded once (ADR 0002 row 16). Mirrors `Complex::exp`.
    #must_use
    #pure
    public fn exp(self): BjComplex {
        var c: f64 = _bj_cos(self.im);
        var s: f64 = _bj_sin(self.im);
        var z: BjComplex;
        var dr: f64 = self.re - self.re;
        var di: f64 = self.im - self.im;
        if ((self.re >= -708.0 && self.re <= 709.0) || dr != 0.0 || di != 0.0) {
            var r: f64 = _bj_exp(self.re);
            z.re = r * c;
            z.im = r * s;
            return z;
        }
        var es, ee = _bj_ux_exp(self.re);
        var cs, ce = _bj_k_ux_from(c);
        var ss, se = _bj_k_ux_from(s);
        var wr: f64 = _bj_k_ux_mul_f64(es, ee, cs, ce);
        var wi: f64 = _bj_k_ux_mul_f64(es, ee, ss, se);
        z.re = wr;
        z.im = wi;
        return z;
    }

    # (ln |z|, arg z), the principal branch; at a range edge |z| with an unbounded exponent (ADR 0002 row 14), and its
    # logarithm with one where it is past DBL_MAX or below 2^-1022 (row 16). Mirrors `Complex::ln`.
    #must_use
    #pure
    public fn ln(self): BjComplex {
        var g: f64 = BjComplex_arg(self);
        var z: BjComplex;
        z.im = g;
        if (_bj_cx_plain(self.re, self.im) == 1) {
            var p: f64 = self.re * self.re + self.im * self.im;
            var a: f64 = f64_sqrt(p);
            var l: f64 = _bj_ln(a);
            z.re = l;
            return z;
        }
        var as, ae = _bj_cx_ux_abs(self.re, self.im);
        if (ae < 0 - 1022 || ae > 1023) {
            var lu: f64 = _bj_ux_ln(as, ae);
            z.re = lu;
            return z;
        }
        var a2: f64 = _bj_k_ux_round(as, ae, 0.0);
        var l2: f64 = _bj_ln(a2);
        z.re = l2;
        return z;
    }

    # from_polar(√|z|, arg z / 2), the principal branch; at a range edge |z| and its root with an unbounded exponent,
    # the polar products rounded once (ADR 0002 row 14). Where im ≠ 0 and |arg z| < 2^-1020, so that arg z / 2 is not
    # a normal double, the angle with an unbounded exponent too (row 16): its cosine is 1 and its sine itself.
    # Mirrors `Complex::sqrt`.
    #must_use
    #pure
    public fn sqrt(self): BjComplex {
        var g: f64 = BjComplex_arg(self);
        var theta: f64 = g / 2.0;
        var tiny = 0;
        if ((_bj_bits(g) & 0x7FFFFFFFFFFFFFFF) < 0x0030000000000000 && self.im != 0.0) {
            var dr: f64 = self.re - self.re;
            if (dr == 0.0) { tiny = 1; }                    # re = +∞ (arg ±0) keeps hisab's chain
        }
        var plain = _bj_cx_plain(self.re, self.im);
        if (plain == 1 && tiny == 0) {
            var a: f64 = BjComplex_abs(self);
            var r: f64 = f64_sqrt(a);
            var z: BjComplex = BjComplex_from_polar(r, theta);
            return z;
        }
        var as2, ae2 = _bj_cx_ux_abs(self.re, self.im);
        var rs, re2 = _bj_k_ux_sqrt(as2, ae2);
        if (tiny == 1) {
            var gs, ge = _bj_cx_arg_ux(g, self.re, self.im);
            var t: BjComplex;
            var tr: f64 = _bj_k_ux_mul_f64(rs, re2, 1.0, 0);
            var ti: f64 = _bj_k_ux_mul_f64(rs, re2, gs, ge - 1);
            t.re = tr;
            t.im = ti;
            return t;
        }
        var c: f64 = _bj_cos(theta);
        var sn: f64 = _bj_sin(theta);
        var cs, ce = _bj_k_ux_from(c);
        var ss, se = _bj_k_ux_from(sn);
        var w: BjComplex;
        var wr: f64 = _bj_k_ux_mul_f64(rs, re2, cs, ce);
        var wi: f64 = _bj_k_ux_mul_f64(rs, re2, ss, se);
        w.re = wr;
        w.im = wi;
        return w;
    }

    # z^n = from_polar(|z|^n, n·arg z) for every z ≠ 0; at a range edge |z| with an unbounded exponent (ADR 0002 row
    # 14), and where |z|, |z|^n, arg z or n·arg z is not a normal double (past DBL_MAX, below 2^-1022), the whole chain
    # with one, each polar product rounded once (row 16, _bj_cx_powf_edge). z = 0 follows pow's rules for a zero base:
    # 0 for n > 0, 1 for n = 0, +∞ for n < 0 (each with im +0), NaN for a NaN n. hisab returned 0 for every |z|² <
    # 1e-300 (row 15: z⁰ was 0, z⁻¹ 0). A non-finite z or n keeps hisab's chain. Mirrors `Complex::powf`.
    #must_use
    #pure
    public fn powf(self, n: f64): BjComplex {
        if (self.re == 0.0 && self.im == 0.0) {
            var zz: BjComplex;
            zz.im = 0.0;
            if (n != n) {
                zz.re = n;
                zz.im = n;
            } elif (n > 0.0) {
                zz.re = 0.0;
            } elif (n == 0.0) {
                zz.re = 1.0;
            } else {
                zz.re = _BJ_K_INF;
            }
            return zz;
        }
        var g: f64 = BjComplex_arg(self);
        var theta: f64 = g * n;
        var dn: f64 = n - n;
        if (_bj_cx_plain(self.re, self.im) == 1 || dn != 0.0) {
            var p: f64 = self.re * self.re + self.im * self.im;
            var a: f64 = f64_sqrt(p);                       # hisab's |z| (a non-finite n gives NaN whatever |z| is)
            var r: f64 = _bj_powf(a, n);
            var da: f64 = a - a;
            if (da != 0.0 || dn != 0.0 || _bj_cx_powf_plain(r, g, theta, n, self.im) == 1) {
                var z: BjComplex = BjComplex_from_polar(r, theta);
                return z;
            }
            var ps, pe = _bj_k_ux_from(a);
            var w: BjComplex = _bj_cx_powf_edge(ps, pe, n, g, self.re, self.im);
            return w;
        }
        var as, ae = _bj_cx_ux_abs(self.re, self.im);
        if (ae >= 0 - 1022 && ae <= 1023) {
            var a2: f64 = _bj_k_ux_round(as, ae, 0.0);
            var r2: f64 = _bj_powf(a2, n);
            if (_bj_cx_powf_plain(r2, g, theta, n, self.im) == 1) {
                var z2: BjComplex = BjComplex_from_polar(r2, theta);
                return z2;
            }
        }
        var w2: BjComplex = _bj_cx_powf_edge(as, ae, n, g, self.re, self.im);
        return w2;
    }

    # sin z = (sin re·cosh im, cos re·sinh im); for a finite z with |im| > 710 (cosh and sinh past DBL_MAX) cosh and
    # sinh with an unbounded exponent and each product rounded once (ADR 0002 row 16). Mirrors `Complex::sin`.
    #must_use
    #pure
    public fn sin(self): BjComplex {
        var s: f64 = _bj_sin(self.re);
        var c: f64 = _bj_cos(self.re);
        var z: BjComplex;
        if (_bj_cx_hyp_plain(self.re, self.im) == 1) {
            var ch: f64 = _bj_cosh(self.im);
            var sh: f64 = _bj_sinh(self.im);
            z.re = s * ch;
            z.im = c * sh;
            return z;
        }
        var hs, he = _bj_ux_cosh(self.im);
        var ks, ke = _bj_ux_sinh(self.im);
        var ss, se = _bj_k_ux_from(s);
        var cs, ce = _bj_k_ux_from(c);
        var wr: f64 = _bj_k_ux_mul_f64(ss, se, hs, he);
        var wi: f64 = _bj_k_ux_mul_f64(cs, ce, ks, ke);
        z.re = wr;
        z.im = wi;
        return z;
    }

    # cos z = (cos re·cosh im, (−sin re)·sinh im); for a finite z with |im| > 710 as sin. Mirrors `Complex::cos`.
    #must_use
    #pure
    public fn cos(self): BjComplex {
        var c: f64 = _bj_cos(self.re);
        var s: f64 = _bj_sin(self.re);
        var ns: f64 = -s;
        var z: BjComplex;
        if (_bj_cx_hyp_plain(self.re, self.im) == 1) {
            var ch: f64 = _bj_cosh(self.im);
            var sh: f64 = _bj_sinh(self.im);
            z.re = c * ch;
            z.im = ns * sh;
            return z;
        }
        var hs, he = _bj_ux_cosh(self.im);
        var ks, ke = _bj_ux_sinh(self.im);
        var cs, ce = _bj_k_ux_from(c);
        var ns2, nse = _bj_k_ux_from(ns);
        var wr: f64 = _bj_k_ux_mul_f64(cs, ce, hs, he);
        var wi: f64 = _bj_k_ux_mul_f64(ns2, nse, ks, ke);
        z.re = wr;
        z.im = wi;
        return z;
    }

    # 1/z = (re/d, −im/d), d = re² + im²; at a range edge d with an unbounded exponent and each quotient rounded once
    # (ADR 0002 row 14). Mirrors `Complex::inv`.
    #must_use
    #pure
    public fn inv(self): BjComplex {
        var nim: f64 = -self.im;
        var z: BjComplex;
        if (_bj_cx_plain(self.re, self.im) == 1) {
            var d: f64 = self.re * self.re + self.im * self.im;
            z.re = self.re / d;
            z.im = nim / d;
            return z;
        }
        var ds, de = _bj_cx_ux_sumsq(self.re, self.im);
        var xs, xe = _bj_k_ux_from(self.re);
        var ys, ye = _bj_k_ux_from(nim);
        var r: f64 = _bj_k_ux_div_f64(xs, xe, ds, de);
        var i: f64 = _bj_k_ux_div_f64(ys, ye, ds, de);
        z.re = r;
        z.im = i;
        return z;
    }

    # 1 when re² + im² < tol² (0 for NaN); at a range edge both sides with an unbounded exponent, compared exactly
    # (ADR 0002 row 14). Mirrors `Complex::is_zero`.
    #must_use
    #pure
    public fn is_zero(self, tol: f64): i64 {
        if (_bj_cx_plain4(self.re, self.im, tol, 0.0) == 1) {
            var ns: f64 = self.re * self.re + self.im * self.im;
            var t2: f64 = tol * tol;
            if (ns < t2) { return 1; }
            return 0;
        }
        var ns2, ne2 = _bj_cx_ux_sumsq(self.re, self.im);
        var ts, te = _bj_cx_ux_mul(tol, tol);
        if (_bj_k_ux_cmp(ns2, ne2, ts, te) == 0 - 1) { return 1; }
        return 0;
    }

    # (re·s, im·s). Mirrors `Mul<f64> for Complex`, `*=` with an f64, and `Mul<Complex> for f64` (s·re is re·s).
    #must_use
    #pure
    public fn scale(self, s: f64): BjComplex {
        var z: BjComplex;
        z.re = self.re * s;
        z.im = self.im * s;
        return z;
    }

    # (re/s, im/s). Mirrors `Div<f64> for Complex`.
    #must_use
    #pure
    public fn div_f64(self, s: f64): BjComplex {
        var z: BjComplex;
        z.re = self.re / s;
        z.im = self.im / s;
        return z;
    }

    # Writes z as Rust's Display does (`format!("{z}")`): "{re}+{im}i" when im ≥ 0 (−0 included, so 1 − j0 is
    # "1+-0i"), else "{re}{im}i" (a NaN im too), each part in Rust's f64 Display form (src/fmtf.cyr). Mirrors
    # `Display for Complex`.
    public fn display(self, t): i64 {
        _bj_fmt_f64_display(t, self.re);
        var im: f64 = self.im;
        if (im >= 0.0) { _bj_tx_putc(t, 43); }
        _bj_fmt_f64_display(t, im);
        _bj_tx_putc(t, 105);
        return 0;
    }
}

# re + j·0. Mirrors `bijli::polarization::complex_real`.
#must_use
#pure
public fn bj_complex_real(re: f64): BjComplex {
    var z: BjComplex = BjComplex_from_real(re);
    return z;
}

# 0 + j·0. Mirrors `bijli::polarization::complex_zero`.
#must_use
#pure
public fn bj_complex_zero(): BjComplex {
    var z: BjComplex = BjComplex_new(0.0, 0.0);
    return z;
}

# magnitude·e^{j·phase}. Mirrors `bijli::polarization::complex_from_polar`.
#must_use
#pure
public fn bj_complex_from_polar(magnitude: f64, phase: f64): BjComplex {
    var z: BjComplex = BjComplex_from_polar(magnitude, phase);
    return z;
}

# --- field.cyr ---

# field.cyr — electric and magnetic fields (port of rust-old/src/field.rs). M1 part 3a: BjFieldVector, point charges,
# superposition, energy densities and dipoles; part 3b: the Gauss's-law fields, multipoles, images, Green's functions
# and the stress tensor; part 3c: trace_field_line, into a BjPolyline.
#
# SI units: metres, coulombs, volts per metre, tesla. The harmonic time convention is src/complex.cyr's.
#
# Shapes. A Rust position `[f64; 3]` is the address of three consecutive f64 (`var p: f64[3];`, passed as `&p`). A
# Rust `Result<FieldVector>` writes the vector through `out: *BjFieldVector` and returns a value-form Result: `Ok(0)`,
# or `Err(code)` with the error in the last-error record (src/error.cyr), `out` untouched. A `Result<f64>` stays a
# Result with the f64 payload. Every formula is Rust's in Rust's order of operations, so the golden rows compare bit
# for bit (class A); constants are src/constants.cyr's (generated), and `1e-30`, the singular cutoff on r², is its
# literal written out (pinned by the rows either side of it). The cutoff is tested exactly (ADR 0002 row 17, the
# user's decision of 2026-11-12): the exact r² of the inputs against 10^-30, and the exact R against 10^-30, through
# src/crmath_cmp.cyr, whose band test leaves Rust's comparison wherever the rounded value is more than 64 ulps from
# the cutoff. A radial distance is a double, and the double nearest 10^-30 lies above it, so `distance < 1e-30` is
# already exact.

private

# Rust's `1e-30`, the double nearest 10^-30: field points closer to the source than 10^-15 m are singular.
public var _BJ_FIELD_R2_MIN: f64 = 0.000000000000000000000000000001;

# ── BjFieldVector ───────────────────────────────────────────────────────────────────────────────────────────────

# A 3D vector field value at a point. Mirrors `FieldVector` (24 bytes, by value).
public struct BjFieldVector {
    x: f64;
    y: f64;
    z: f64;
}

# (x, y, z). Mirrors `FieldVector::new`.
#must_use
#pure
public fn BjFieldVector_new(x: f64, y: f64, z: f64): BjFieldVector {
    var v: BjFieldVector;
    v.x = x;
    v.y = y;
    v.z = z;
    return v;
}

# (0, 0, 0). Mirrors `FieldVector::zero`.
#must_use
#pure
public fn BjFieldVector_zero(): BjFieldVector {
    var v: BjFieldVector;
    v.x = 0.0;
    v.y = 0.0;
    v.z = 0.0;
    return v;
}

# (0, 0, 0). Mirrors `Default for FieldVector`.
#must_use
#pure
public fn BjFieldVector_default(): BjFieldVector {
    var v: BjFieldVector = BjFieldVector_zero();
    return v;
}

# The vector of the three f64 at p. Mirrors `From<[f64; 3]> for FieldVector`.
#must_use
#pure
public fn BjFieldVector_from_array(p: *f64): BjFieldVector {
    var v: BjFieldVector;
    v.x = p[0];
    v.y = p[1];
    v.z = p[2];
    return v;
}

# a + b. Mirrors `Add for FieldVector` (and `+=`: write `a = a + b`).
#must_use
#pure
public fn BjFieldVector_add(a: BjFieldVector, b: BjFieldVector): BjFieldVector {
    var v: BjFieldVector;
    v.x = a.x + b.x;
    v.y = a.y + b.y;
    v.z = a.z + b.z;
    return v;
}

# a − b. Mirrors `Sub for FieldVector` (and `-=`).
#must_use
#pure
public fn BjFieldVector_sub(a: BjFieldVector, b: BjFieldVector): BjFieldVector {
    var v: BjFieldVector;
    v.x = a.x - b.x;
    v.y = a.y - b.y;
    v.z = a.z - b.z;
    return v;
}

# a·s. Mirrors `Mul<f64> for FieldVector` (and `*=` with an f64): `v * 2.0`.
#must_use
#pure
public fn BjFieldVector_mul(a: BjFieldVector, s: f64): BjFieldVector {
    var v: BjFieldVector;
    v.x = a.x * s;
    v.y = a.y * s;
    v.z = a.z * s;
    return v;
}

# s·a, each product s·component in that order. Mirrors `Mul<FieldVector> for f64` (`2.0 * v`).
#must_use
#pure
public fn BjFieldVector_scale_left(s: f64, a: BjFieldVector): BjFieldVector {
    var v: BjFieldVector;
    v.x = s * a.x;
    v.y = s * a.y;
    v.z = s * a.z;
    return v;
}

# −a. Mirrors `Neg for FieldVector`.
#must_use
#pure
public fn BjFieldVector_neg(a: BjFieldVector): BjFieldVector {
    var v: BjFieldVector;
    v.x = -a.x;
    v.y = -a.y;
    v.z = -a.z;
    return v;
}

# Rust's u·v in binary64, with no range-edge path: for the chains that keep Rust's evaluation until their own part
# of M1 part 5d (the dipoles, the Poynting flux).
#must_use
fn _bj_fv_dot_rust(u: BjFieldVector, v: BjFieldVector): f64 {
    var r: f64 = u.x * v.x + u.y * v.y + u.z * v.z;
    return r;
}

# Rust's u × v in binary64, with no range-edge path (the Poynting flux, until its part of 5d).
#must_use
fn _bj_fv_cross_rust(u: BjFieldVector, v: BjFieldVector): BjFieldVector {
    var w: BjFieldVector;
    w.x = u.y * v.z - u.z * v.y;
    w.y = u.z * v.x - u.x * v.z;
    w.z = u.x * v.y - u.y * v.x;
    return w;
}

# |(x, y, z)| at a range edge: the sum of squares with an unbounded exponent, the root rounded once.
#must_use
fn _bj_fv_mag_edge(x: f64, y: f64, z: f64): f64 {
    var us, ue = _bj_vx_sumsq(x, y, z);
    var u: f64 = _bj_k_ux_sqrt_f64(us, ue);
    return u;
}

# |(x, y, z)|² at a range edge: the chain with an unbounded exponent, the last sum rounded once.
#must_use
fn _bj_fv_msq_edge(x: f64, y: f64, z: f64): f64 {
    var as2, ae2 = _bj_vx_mul(x, x);
    var bs2, be2 = _bj_vx_mul(y, y);
    var cs2, ce2 = _bj_vx_mul(z, z);
    var ss, se = _bj_k_ux_add(as2, ae2, bs2, be2);
    var u: f64 = _bj_k_ux_add_f64(ss, se, cs2, ce2);
    return u;
}

# (x, y, z)/|(x, y, z)| at a range edge into out: |v| to 53 bits with an unbounded exponent, each quotient rounded once.
fn _bj_fv_norm_edge(x: f64, y: f64, z: f64, out: *BjFieldVector) {
    var ms2, me2 = _bj_vx_sumsq(x, y, z);
    var mg, mge = _bj_k_ux_sqrt(ms2, me2);
    var xs, xe = _bj_k_ux_from(x);
    var ys, ye = _bj_k_ux_from(y);
    var zs, ze = _bj_k_ux_from(z);
    var ox: f64 = _bj_k_ux_div_f64(xs, xe, mg, mge);
    var oy: f64 = _bj_k_ux_div_f64(ys, ye, mg, mge);
    var oz: f64 = _bj_k_ux_div_f64(zs, ze, mg, mge);
    out.x = ox;
    out.y = oy;
    out.z = oz;
    return 0;
}

# u·v at a range edge: the chain with an unbounded exponent, the last sum rounded once; Rust's s where its chain is
# the unbounded one (an exact 0, or a part not finite: the band test is the caller's).
#must_use
fn _bj_fv_dot_edge(u: BjFieldVector, v: BjFieldVector, s: f64): f64 {
    if (_bj_vx_finite4(u.x, u.y, u.z, v.x) == 0 || _bj_vx_finite4(v.y, v.z, 0.0, 0.0) == 0) { return s; }
    if (s == 0.0) {
        var p: f64 = u.x * v.x;
        var q: f64 = u.y * v.y;
        var r: f64 = u.z * v.z;
        var e = _bj_vx_exact(u.x, v.x, p) + _bj_vx_exact(u.y, v.y, q) + _bj_vx_exact(u.z, v.z, r);
        if (e == 3) { return s; }
    }
    var ps, pe = _bj_vx_mul(u.x, v.x);
    var qs, qe = _bj_vx_mul(u.y, v.y);
    var rs, re = _bj_vx_mul(u.z, v.z);
    var ss, se = _bj_k_ux_add(ps, pe, qs, qe);
    var w: f64 = _bj_k_ux_add_f64(ss, se, rs, re);
    return w;
}

impl BjFieldVector {
    # √(x² + y² + z²), no rescaling; at a range edge (a square past DBL_MAX or below 2^-1022 that the result can
    # see) with an unbounded exponent, the root rounded once (ADR 0002 row 18, src/crmath_vx.cyr's guard). Mirrors
    # `FieldVector::magnitude`.
    #must_use
    #pure
    public fn magnitude(self): f64 {
        var x: f64 = self.x;
        var y: f64 = self.y;
        var z: f64 = self.z;
        var s: f64 = x * x + y * y + z * z;
        if ((s >= _BJ_VX_LO && s <= _BJ_VX_HI) || _bj_vx_sumsq_plain(x, y, z, s) == 1) {
            var r: f64 = f64_sqrt(s);
            return r;
        }
        var u: f64 = _bj_fv_mag_edge(x, y, z);
        return u;
    }

    # x² + y² + z²; at a range edge with an unbounded exponent, the last sum rounded once (ADR 0002 row 18). Mirrors
    # `FieldVector::magnitude_sq`.
    #must_use
    #pure
    public fn magnitude_sq(self): f64 {
        var x: f64 = self.x;
        var y: f64 = self.y;
        var z: f64 = self.z;
        var s: f64 = x * x + y * y + z * z;
        if ((s >= _BJ_VX_LO && s <= _BJ_VX_HI) || _bj_vx_sumsq_plain(x, y, z, s) == 1) { return s; }
        var u: f64 = _bj_fv_msq_edge(x, y, z);
        return u;
    }

    # The unit vector in this direction, into out: each part over |v|. Errors: DivisionByZero for the zero vector,
    # InvalidParameter for a NaN or infinite component. In range (every part ±0 or in [2^-511, 2^511)) this is Rust's
    # code. At a range edge, where Rust rescales by the largest part first (two more roundings), its first branch runs
    # with an unbounded exponent instead: |v| to 53 bits, each quotient rounded once (ADR 0002 row 18). So the result
    # is exactly scale-invariant, the same bits for 2^k·v wherever the parts stay exact. Mirrors
    # `FieldVector::normalized`.
    public fn normalized(self, out: *BjFieldVector): Result {
        var ms: f64 = self.x * self.x + self.y * self.y + self.z * self.z;
        if (_bj_vx_sumsq_plain(self.x, self.y, self.z, ms) == 0) {
            _bj_fv_norm_edge(self.x, self.y, self.z, out);
            return Ok(0);
        }
        var tiny: f64 = _bj_from_bits(0x0010000000000000);        # f64::MIN_POSITIVE
        if (_bj_is_finite(ms) == 1 && ms >= tiny) {
            var mag: f64 = f64_sqrt(ms);
            out.x = self.x / mag;
            out.y = self.y / mag;
            out.z = self.z / mag;
            return Ok(0);
        }
        var x: f64 = self.x;
        var y: f64 = self.y;
        var z: f64 = self.z;
        if (_bj_is_finite(x) == 0 || _bj_is_finite(y) == 0 || _bj_is_finite(z) == 0) {
            var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(t, "cannot normalize non-finite vector ");
            BjFieldVector_display(self, t);
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        # Rust's chain stands and |v|² is below 2^-1022 or not finite: every part is ±0 (a non-finite one was refused
        # above). Rust's rescale by the largest part, which only the range edges reach, is the unbounded path above.
        return Err(_bj_err_division_by_zero("zero vector cannot be normalized"));
    }

    # self·o; at a range edge with an unbounded exponent, the last sum rounded once (ADR 0002 row 18). Mirrors
    # `FieldVector::dot`.
    #must_use
    #pure
    public fn dot(self, o: BjFieldVector): f64 {
        var r: f64 = self.x * o.x + self.y * o.y + self.z * o.z;
        var a: f64 = f64_abs(r);
        if (a >= _BJ_VX_LO && a <= _BJ_VX_HI) { return r; }
        var u: f64 = _bj_fv_dot_edge(self, o, r);
        return u;
    }

    # self × o; at a range edge with an unbounded exponent, each difference rounded once (ADR 0002 row 18). Mirrors
    # `FieldVector::cross`.
    #must_use
    #pure
    public fn cross(self, o: BjFieldVector): BjFieldVector {
        var v: BjFieldVector;
        var cx: f64 = self.y * o.z - self.z * o.y;
        var cy: f64 = self.z * o.x - self.x * o.z;
        var cz: f64 = self.x * o.y - self.y * o.x;
        v.x = cx;
        v.y = cy;
        v.z = cz;
        # Every component's biased exponent in [123, 2046] is |c| ∈ [2^-900, DBL_MAX] (src/crmath_vx.cyr's band).
        var ex = (load64(&cx) >> 52) & 0x7FF;
        var ey = (load64(&cy) >> 52) & 0x7FF;
        var ez = (load64(&cz) >> 52) & 0x7FF;
        if (((ex - 123) | (ey - 123) | (ez - 123) | (2046 - ex) | (2046 - ey) | (2046 - ez)) >= 0) { return v; }
        # A component that is 0 through zero factors is exact; so is one in the band.
        var hard = 0;
        if (((ex - 123) | (2046 - ex)) < 0 && !(cx == 0.0 && (self.y == 0.0 || o.z == 0.0) && (self.z == 0.0
              || o.y == 0.0))) { hard = 1; }
        if (((ey - 123) | (2046 - ey)) < 0 && !(cy == 0.0 && (self.z == 0.0 || o.x == 0.0) && (self.x == 0.0
              || o.z == 0.0))) { hard = 1; }
        if (((ez - 123) | (2046 - ez)) < 0 && !(cz == 0.0 && (self.x == 0.0 || o.y == 0.0) && (self.y == 0.0
              || o.x == 0.0))) { hard = 1; }
        if (hard == 0) { return v; }
        if (_bj_vx_finite4(self.x, self.y, self.z, o.x) == 0 || _bj_vx_finite4(o.y, o.z, 0.0, 0.0) == 0) {
            return v;                                       # a non-finite part keeps Rust's chain
        }
        var ux: f64 = _bj_vx_cross1_f64(self.y, o.z, self.z, o.y, cx);
        var uy: f64 = _bj_vx_cross1_f64(self.z, o.x, self.x, o.z, cy);
        var uz: f64 = _bj_vx_cross1_f64(self.x, o.y, self.y, o.x, cz);
        v.x = ux;
        v.y = uy;
        v.z = uz;
        return v;
    }

    # self·s. Mirrors `FieldVector::scale`.
    #must_use
    #pure
    public fn scale(self, s: f64): BjFieldVector {
        var v: BjFieldVector;
        v.x = self.x * s;
        v.y = self.y * s;
        v.z = self.z * s;
        return v;
    }

    # 1 when every component equals o's (IEEE: −0 equals +0, NaN equals nothing). Mirrors the derived `PartialEq`.
    #must_use
    #pure
    public fn eq(self, o: BjFieldVector): i64 {
        var a: f64 = self.x;
        var b: f64 = self.y;
        var c: f64 = self.z;
        if (a == o.x && b == o.y && c == o.z) { return 1; }
        return 0;
    }

    # Writes the three components to the f64 at p. Mirrors `From<FieldVector> for [f64; 3]`.
    public fn to_array(self, p: *f64): i64 {
        p[0] = self.x;
        p[1] = self.y;
        p[2] = self.z;
        return 0;
    }

    # Writes "(x, y, z)" as Rust's Display does, each component in Rust's f64 Display form (src/fmtf.cyr). Mirrors
    # `Display for FieldVector`.
    public fn display(self, t): i64 {
        _bj_tx_putc(t, 40);
        _bj_fmt_f64_display(t, self.x);
        _bj_tx_cstr(t, ", ");
        _bj_fmt_f64_display(t, self.y);
        _bj_tx_cstr(t, ", ");
        _bj_fmt_f64_display(t, self.z);
        _bj_tx_putc(t, 41);
        return 0;
    }
}

# ── point charges ───────────────────────────────────────────────────────────────────────────────────────────────
#
# Range edges (ADR 0002 row 18, M1 part 5d-3): where the offset overflows, or k·q, the factor k·q·(1/r)³ (or
# μ₀q/(4πr²)), a unit-vector part or a cross component leaves the normal range, the chain runs with an unbounded
# exponent and each output component's last product rounds once (src/crmath_vx.cyr). The guard tests Rust's own values:
# past the Singularity cutoff r² ≥ 10^-30 (2^-100), so r² finite keeps the squares' sum the unbounded chain's
# (crmath_vx's band argument), and a chain of products by 1/r is the unbounded one when its first and last values are
# normal and above 2^-1022 (the ones between lie between them). Biased exponents in [2, 2046] are that test. A zero
# charge passes when r² is finite (then the offset, and so the signs of the zero products, are the unbounded chain's),
# and a non-finite input keeps Rust's chain.

# E = kq/r²·r̂ (V/m) at field_pos from a point charge at charge_pos, as k·q·(1/r)³ times the offset; at a range edge
# with an unbounded exponent, each component rounded once (ADR 0002 row 18). Singularity when the exact r² < 10^-30
# (row 17). Mirrors `field::electric_field_point_charge`.
public fn bj_electric_field_point_charge(charge_q: f64, charge_pos: *f64, field_pos: *f64,
  out: *BjFieldVector): Result {
    var dx: f64 = field_pos[0] - charge_pos[0];
    var dy: f64 = field_pos[1] - charge_pos[1];
    var dz: f64 = field_pos[2] - charge_pos[2];
    var r_sq: f64 = dx * dx + dy * dy + dz * dz;
    var band = _bj_x_band(r_sq, _BJ_FIELD_R2_MIN);
    if (band == 2) { band = _bj_x_r2_below(field_pos, charge_pos, 30); }
    if (band == 1) {
        return Err(_bj_err_singularity());
    }
    var rt: f64 = f64_sqrt(r_sq);
    var inv_r: f64 = 1.0 / rt;
    var kq: f64 = BJ_COULOMB_K * charge_q;
    var factor: f64 = kq * inv_r * inv_r * inv_r;
    out.x = factor * dx;
    out.y = factor * dy;
    out.z = factor * dz;
    # k·q and the factor normal (an overflowed offset makes 1/r and so the factor 0, so r² needs no test of its own).
    var e2 = (load64(&kq) >> 52) & 0x7FF;
    var e3 = (load64(&factor) >> 52) & 0x7FF;
    if (((e2 - 2) | (2046 - e2) | (e3 - 2) | (2046 - e3)) >= 0) { return Ok(0); }
    _bj_fv_point_e_slow(charge_q, charge_pos, field_pos, r_sq, kq, factor, out);
    return Ok(0);
}

# The point charge's field past its fast test, into out (which holds Rust's): Rust's chain stands for a zero charge
# with r² finite or a non-finite input, else the unbounded chain.
fn _bj_fv_point_e_slow(q: f64, c: *f64, f: *f64, r_sq: f64, kq: f64, factor: f64, out: *BjFieldVector) {
    var p: f64[7];
    p[0] = q;
    p[1] = c[0];
    p[2] = c[1];
    p[3] = c[2];
    p[4] = f[0];
    p[5] = f[1];
    p[6] = f[2];
    if (_bj_vx_coulomb_plain(r_sq, kq, kq, factor, q, 1.0, &p, 7) == 1) { return 0; }
    _bj_vx_coulomb_edge(BJ_COULOMB_K, q, 1.0, f, c, out);
    return 0;
}

# V = kq/r (volts) at a range edge: the offset and |d| with an unbounded exponent, k·q to 53 bits, the quotient rounded
# once.
#must_use
fn _bj_fv_potential_edge(q: f64, f: *f64, c: *f64): f64 {
    var s: f64[5];
    var e: i64[5];
    _bj_vx_offset_ux(f, c, &s, &e);
    var ks, ke = _bj_k_ux_from(BJ_COULOMB_K);
    var qs, qe = _bj_k_ux_from(q);
    var ms, me = _bj_k_ux_mul(ks, ke, qs, qe);
    var v: f64 = _bj_k_ux_div_f64(ms, me, s[3], e[3]);
    return v;
}

# V = kq/r (volts); at a range edge with an unbounded exponent, the quotient rounded once (ADR 0002 row 18).
# Singularity when the exact r² < 10^-30 (row 17). Mirrors `field::electric_potential_point_charge`.
public fn bj_electric_potential_point_charge(charge_q: f64, charge_pos: *f64, field_pos: *f64): Result {
    var dx: f64 = field_pos[0] - charge_pos[0];
    var dy: f64 = field_pos[1] - charge_pos[1];
    var dz: f64 = field_pos[2] - charge_pos[2];
    var r_sq: f64 = dx * dx + dy * dy + dz * dz;
    var band = _bj_x_band(r_sq, _BJ_FIELD_R2_MIN);
    if (band == 2) { band = _bj_x_r2_below(field_pos, charge_pos, 30); }
    if (band == 1) {
        return Err(_bj_err_singularity());
    }
    var rt: f64 = f64_sqrt(r_sq);
    var kq: f64 = BJ_COULOMB_K * charge_q;
    var v: f64 = kq / rt;
    var e1 = (load64(&r_sq) >> 52) & 0x7FF;
    var e2 = (load64(&kq) >> 52) & 0x7FF;
    if (((2046 - e1) | (e2 - 2) | (2046 - e2)) >= 0) { return Ok(v); }
    var p: f64[7];
    p[0] = charge_q;
    p[1] = charge_pos[0];
    p[2] = charge_pos[1];
    p[3] = charge_pos[2];
    p[4] = field_pos[0];
    p[5] = field_pos[1];
    p[6] = field_pos[2];
    if ((charge_q == 0.0 && e1 <= 2046) || _bj_vx_finite_n(&p, 7) == 0) { return Ok(v); }
    var u: f64 = _bj_fv_potential_edge(charge_q, field_pos, charge_pos);
    return Ok(u);
}

# B = (μ₀/4π)·q(v × r̂)/r² at a range edge, into out: the offset, 1/r and r̂ with an unbounded exponent, v × r̂ and the
# factor ((μ₀/4π)·q)·(1/r)² to 53 bits, each component's product rounded once.
fn _bj_fv_moving_b_edge(q: f64, c: *f64, vel: *f64, f: *f64, mu4: f64, out: *BjFieldVector) {
    var s: f64[5];
    var e: i64[5];
    _bj_vx_offset_ux(f, c, &s, &e);
    var hxs, hxe = _bj_k_ux_mul(s[0], e[0], s[4], e[4]);
    var hys, hye = _bj_k_ux_mul(s[1], e[1], s[4], e[4]);
    var hzs, hze = _bj_k_ux_mul(s[2], e[2], s[4], e[4]);
    var v0s, v0e = _bj_k_ux_from(vel[0]);
    var v1s, v1e = _bj_k_ux_from(vel[1]);
    var v2s, v2e = _bj_k_ux_from(vel[2]);
    var a1s, a1e = _bj_k_ux_mul(v1s, v1e, hzs, hze);
    var a2s, a2e = _bj_k_ux_mul(v2s, v2e, hys, hye);
    var cxs, cxe = _bj_k_ux_sub(a1s, a1e, a2s, a2e);
    var b1s, b1e = _bj_k_ux_mul(v2s, v2e, hxs, hxe);
    var b2s, b2e = _bj_k_ux_mul(v0s, v0e, hzs, hze);
    var cys, cye = _bj_k_ux_sub(b1s, b1e, b2s, b2e);
    var c1s, c1e = _bj_k_ux_mul(v0s, v0e, hys, hye);
    var c2s, c2e = _bj_k_ux_mul(v1s, v1e, hxs, hxe);
    var czs, cze = _bj_k_ux_sub(c1s, c1e, c2s, c2e);
    var ms, me = _bj_k_ux_from(mu4);
    var qs, qe = _bj_k_ux_from(q);
    var mqs, mqe = _bj_k_ux_mul(ms, me, qs, qe);
    var f1s, f1e = _bj_k_ux_mul(mqs, mqe, s[4], e[4]);
    var f2s, f2e = _bj_k_ux_mul(f1s, f1e, s[4], e[4]);
    var ox: f64 = _bj_k_ux_mul_f64(f2s, f2e, cxs, cxe);
    var oy: f64 = _bj_k_ux_mul_f64(f2s, f2e, cys, cye);
    var oz: f64 = _bj_k_ux_mul_f64(f2s, f2e, czs, cze);
    out.x = ox;
    out.y = oy;
    out.z = oz;
    return 0;
}

# 1 when a moving charge's unit-vector part h = d·(1/r) is its 53-bit value: normal and above 2^-1022, or d = 0.
#must_use
fn _bj_fv_unit_ok(h: f64, d: f64): i64 {
    if (d == 0.0) { return 1; }
    var b = (load64(&h) >> 52) & 0x7FF;
    if (b >= 2 && b <= 2046) { return 1; }
    return 0;
}

# 1 when a cross component c = a·b − x·y of the moving charge's v × r̂ is its 53-bit value: in the band, or 0 through
# zero factors.
#must_use
fn _bj_fv_cross_ok(c: f64, a: f64, b: f64, x: f64, y: f64): i64 {
    if (_bj_vx_band(c) == 1) { return 1; }
    if (c == 0.0 && (a == 0.0 || b == 0.0) && (x == 0.0 || y == 0.0)) { return 1; }
    return 0;
}

# B = (μ₀/4π)·q(v × r̂)/r² (tesla) at field_pos from a charge at charge_pos moving with `velocity` (Biot–Savart); at a
# range edge with an unbounded exponent, each component rounded once (ADR 0002 row 18). Singularity when the exact
# r² < 10^-30 (row 17). Mirrors `field::magnetic_field_moving_charge`.
public fn bj_magnetic_field_moving_charge(charge_q: f64, charge_pos: *f64, velocity: *f64, field_pos: *f64,
  out: *BjFieldVector): Result {
    var dx: f64 = field_pos[0] - charge_pos[0];
    var dy: f64 = field_pos[1] - charge_pos[1];
    var dz: f64 = field_pos[2] - charge_pos[2];
    var r_sq: f64 = dx * dx + dy * dy + dz * dz;
    var band = _bj_x_band(r_sq, _BJ_FIELD_R2_MIN);
    if (band == 2) { band = _bj_x_r2_below(field_pos, charge_pos, 30); }
    if (band == 1) {
        return Err(_bj_err_singularity());
    }
    var rt: f64 = f64_sqrt(r_sq);
    var inv_r: f64 = 1.0 / rt;
    var rx: f64 = dx * inv_r;
    var ry: f64 = dy * inv_r;
    var rz: f64 = dz * inv_r;
    var cross_x: f64 = velocity[1] * rz - velocity[2] * ry;
    var cross_y: f64 = velocity[2] * rx - velocity[0] * rz;
    var cross_z: f64 = velocity[0] * ry - velocity[1] * rx;
    var four_pi: f64 = 4.0 * _BJ_PI;
    var mu4: f64 = BJ_MU_0 / four_pi;
    var mq: f64 = mu4 * charge_q;
    var factor: f64 = mq * inv_r * inv_r;
    out.x = factor * cross_x;
    out.y = factor * cross_y;
    out.z = factor * cross_z;
    var e1 = (load64(&r_sq) >> 52) & 0x7FF;
    var e2 = (load64(&mq) >> 52) & 0x7FF;
    var e3 = (load64(&factor) >> 52) & 0x7FF;
    var hx = (load64(&rx) >> 52) & 0x7FF;
    var hy = (load64(&ry) >> 52) & 0x7FF;
    var hz = (load64(&rz) >> 52) & 0x7FF;
    var cx = (load64(&cross_x) >> 52) & 0x7FF;
    var cy = (load64(&cross_y) >> 52) & 0x7FF;
    var cz = (load64(&cross_z) >> 52) & 0x7FF;
    # One test, branch-free: each term is negative when out of range, and masked to 0 when the part is an exact 0 (an
    # offset part 0 for r̂; zero factors in both products for a cross component). z(x) = 1 when x = ±0.
    var v0: f64 = velocity[0];
    var v1: f64 = velocity[1];
    var v2: f64 = velocity[2];
    var zdx = ((load64(&dx) & 0x7FFFFFFFFFFFFFFF) - 1) >> 63;
    var zdy = ((load64(&dy) & 0x7FFFFFFFFFFFFFFF) - 1) >> 63;
    var zdz = ((load64(&dz) & 0x7FFFFFFFFFFFFFFF) - 1) >> 63;
    var zv0 = ((load64(&v0) & 0x7FFFFFFFFFFFFFFF) - 1) >> 63;
    var zv1 = ((load64(&v1) & 0x7FFFFFFFFFFFFFFF) - 1) >> 63;
    var zv2 = ((load64(&v2) & 0x7FFFFFFFFFFFFFFF) - 1) >> 63;
    var w = (2046 - e1) | (e2 - 2) | (2046 - e2) | (e3 - 2) | (2046 - e3);
    w = w | (((hx - 2) | (2046 - hx)) & (zdx - 1)) | (((hy - 2) | (2046 - hy)) & (zdy - 1));
    w = w | (((hz - 2) | (2046 - hz)) & (zdz - 1));
    w = w | (((cx - 123) | (2046 - cx)) & ((((zv1 | zdz) & (zv2 | zdy))) - 1));
    w = w | (((cy - 123) | (2046 - cy)) & ((((zv2 | zdx) & (zv0 | zdz))) - 1));
    w = w | (((cz - 123) | (2046 - cz)) & ((((zv0 | zdy) & (zv1 | zdx))) - 1));
    if (w >= 0) { return Ok(0); }
    _bj_fv_moving_b_slow(charge_q, charge_pos, velocity, field_pos, mu4, out);
    return Ok(0);
}

# The moving charge's field past both tiers, into out (which holds Rust's): Rust's chain stands for a non-finite input,
# else the unbounded chain.
fn _bj_fv_moving_b_slow(q: f64, c: *f64, vel: *f64, f: *f64, mu4: f64, out: *BjFieldVector) {
    var p: f64[10];
    p[0] = q;
    for (var i = 0; i < 3; i = i + 1) {
        p[1 + i] = c[i];
        p[4 + i] = vel[i];
        p[7 + i] = f[i];
    }
    if (_bj_vx_finite_n(&p, 10) == 0) { return 0; }
    _bj_fv_moving_b_edge(q, c, vel, f, mu4, out);
    return 0;
}

# 1 when one charge's field in a superposition is its 53-bit value with Rust's chain the unbounded one: the point
# charge's fast test, and each component normal and above 2^-1022 or exactly 0 (a zero offset part); a zero charge
# with r² finite makes every product an exact 0 with the unbounded chain's signs.
#must_use
fn _bj_fv_super_plain(r_sq: f64, kq: f64, factor: f64, ex: f64, ey: f64, ez: f64, dx: f64, dy: f64, dz: f64,
  q: f64): i64 {
    var e1 = (load64(&r_sq) >> 52) & 0x7FF;
    if (q == 0.0 && e1 <= 2046) { return 1; }
    var e2 = (load64(&kq) >> 52) & 0x7FF;
    var e3 = (load64(&factor) >> 52) & 0x7FF;
    if (((2046 - e1) | (e2 - 2) | (2046 - e2) | (e3 - 2) | (2046 - e3)) < 0) { return 0; }
    if (_bj_fv_unit_ok(ex, dx) + _bj_fv_unit_ok(ey, dy) + _bj_fv_unit_ok(ez, dz) == 3) { return 1; }
    return 0;
}

# The superposition at a range edge, into out: each charge's field to 53 bits (_bj_vx_coulomb_ux, its products with an
# unbounded exponent), summed in order from zero with an unbounded exponent, the last addition rounded once.
fn _bj_fv_super_edge(charges: *f64, n, field_pos: *f64, out: *BjFieldVector) {
    var s: f64[6];
    var e: i64[6];
    var acs: f64[3];
    var ace: i64[3];
    var fin: f64[3];
    for (var k = 0; k < 3; k = k + 1) {
        acs[k] = 0.0;
        ace[k] = 0;
    }
    for (var i = 0; i < n; i = i + 1) {
        var c: *f64 = charges + i * 4;
        var q: f64 = c[0];
        _bj_vx_coulomb_ux(BJ_COULOMB_K, q, 1.0, field_pos, c + 1, &s, &e);
        for (var j = 0; j < 3; j = j + 1) {
            var gs, ge = _bj_k_ux_mul(s[5], e[5], s[j], e[j]);
            if (i == n - 1) {
                var r: f64 = _bj_k_ux_add_f64(acs[j], ace[j], gs, ge);
                fin[j] = r;
            } else {
                var ns, ne = _bj_k_ux_add(acs[j], ace[j], gs, ge);
                acs[j] = ns;
                ace[j] = ne;
            }
        }
    }
    out.x = fin[0];
    out.y = fin[1];
    out.z = fin[2];
    return 0;
}

# The sum of the point-charge fields of n charges at field_pos, each charge 32 bytes at `charges` (q, then its
# position: Rust's `(f64, [f64; 3])`), accumulated in order from zero. The first singular charge's error is returned.
# At a range edge (a field or a partial sum Rust rounded outside the normal range) the whole sum runs with an
# unbounded exponent, each field kept to 53 bits and the last addition rounded once (ADR 0002 row 18). Mirrors
# `field::electric_field_superposition`.
public fn bj_electric_field_superposition(charges: *f64, n, field_pos: *f64, out: *BjFieldVector): Result {
    var tx: f64 = 0.0;
    var ty: f64 = 0.0;
    var tz: f64 = 0.0;
    var plain = 1;
    for (var i = 0; i < n; i = i + 1) {
        var c: *f64 = charges + i * 4;
        var q: f64 = c[0];
        var cp: *f64 = c + 1;
        var dx: f64 = field_pos[0] - cp[0];
        var dy: f64 = field_pos[1] - cp[1];
        var dz: f64 = field_pos[2] - cp[2];
        var r_sq: f64 = dx * dx + dy * dy + dz * dz;
        var band = _bj_x_band(r_sq, _BJ_FIELD_R2_MIN);
        if (band == 2) { band = _bj_x_r2_below(field_pos, cp, 30); }
        if (band == 1) { return Err(_bj_err_singularity()); }
        var rt: f64 = f64_sqrt(r_sq);
        var inv_r: f64 = 1.0 / rt;
        var kq: f64 = BJ_COULOMB_K * q;
        var factor: f64 = kq * inv_r * inv_r * inv_r;
        var ex: f64 = factor * dx;
        var ey: f64 = factor * dy;
        var ez: f64 = factor * dz;
        tx = tx + ex;
        ty = ty + ey;
        tz = tz + ez;
        if (plain == 1) {
            # k·q, the factor and each field component normal (a zero component with a zero offset part is exact).
            var b2 = (load64(&kq) >> 52) & 0x7FF;
            var b3 = (load64(&factor) >> 52) & 0x7FF;
            var g1 = (load64(&ex) >> 52) & 0x7FF;
            var g2 = (load64(&ey) >> 52) & 0x7FF;
            var g3 = (load64(&ez) >> 52) & 0x7FF;
            var w = (b2 - 2) | (2046 - b2) | (b3 - 2) | (2046 - b3);
            var w2 = w;
            if (dx != 0.0) { w2 = w2 | (g1 - 2) | (2046 - g1); }
            if (dy != 0.0) { w2 = w2 | (g2 - 2) | (2046 - g2); }
            if (dz != 0.0) { w2 = w2 | (g3 - 2) | (2046 - g3); }
            if (w2 < 0) { plain = _bj_fv_super_plain(r_sq, kq, factor, ex, ey, ez, dx, dy, dz, q); }
        }
    }
    var b1 = (load64(&tx) >> 52) & 0x7FF;
    var b2 = (load64(&ty) >> 52) & 0x7FF;
    var b3 = (load64(&tz) >> 52) & 0x7FF;
    if (plain == 1 && b1 != 2047 && b2 != 2047 && b3 != 2047) {
        out.x = tx;
        out.y = ty;
        out.z = tz;
        return Ok(0);
    }
    var all: f64 = 0.0;
    for (var j = 0; j < 4 * n; j = j + 1) {
        var y: f64 = charges[j];
        all = all + (y - y);
    }
    if (all != 0.0 || _bj_vx_finite_n(field_pos, 3) == 0) {
        out.x = tx;                                         # a non-finite input keeps Rust's chain
        out.y = ty;
        out.z = tz;
        return Ok(0);
    }
    _bj_fv_super_edge(charges, n, field_pos, out);
    return Ok(0);
}

# u = ε₀E²/2 (J/m³), correctly rounded (ADR 0002 row 13; a non-finite E keeps Rust's 0.5·ε₀·E·E). Mirrors
# `field::electric_energy_density`.
#must_use
#pure
public fn bj_electric_energy_density(e_magnitude: f64): f64 {
    if (_bj_is_finite(e_magnitude) == 0) {
        var u: f64 = 0.5 * BJ_EPSILON_0 * e_magnitude * e_magnitude;
        return u;
    }
    var cr: f64 = _bj_k_cr_mul4(0.5, BJ_EPSILON_0, e_magnitude, e_magnitude);
    return cr;
}

# u = B²/(2μ₀) (J/m³), correctly rounded (ADR 0002 row 13; a non-finite B keeps Rust's B·B/(2μ₀)). Mirrors
# `field::magnetic_energy_density`.
#must_use
#pure
public fn bj_magnetic_energy_density(b_magnitude: f64): f64 {
    var two_mu: f64 = 2.0 * BJ_MU_0;
    if (_bj_is_finite(b_magnitude) == 0) {
        var u: f64 = b_magnitude * b_magnitude / two_mu;
        return u;
    }
    var cr: f64 = _bj_k_cr_mul_div(b_magnitude, b_magnitude, two_mu);
    return cr;
}

# ── dipoles ─────────────────────────────────────────────────────────────────────────────────────────────────────

# The unit vector toward p and 1/|p| for a field position p with |p|² ≥ 10^-30 exactly, into r_hat; returns 1/|p|, or
# −1 when the exact |p|² < 10^-30 (singular: ADR 0002 row 17).
fn _bj_field_rhat(p: *f64, r_hat: *BjFieldVector): f64 {
    var r_sq: f64 = p[0] * p[0] + p[1] * p[1] + p[2] * p[2];
    var band = _bj_x_band(r_sq, _BJ_FIELD_R2_MIN);
    if (band == 2) { band = _bj_x_r2_below(p, &_bj_x_origin, 30); }
    if (band == 1) { return -1.0; }
    var rt: f64 = f64_sqrt(r_sq);
    var inv_r: f64 = 1.0 / rt;
    r_hat.x = p[0] * inv_r;
    r_hat.y = p[1] * inv_r;
    r_hat.z = p[2] * inv_r;
    return inv_r;
}

# E = (1/4πε₀r³)·[3(p·r̂)r̂ − p] at field_pos from a dipole p at the origin, as r̂·(3(p·r̂)·f) − p·f with f =
# (1/r)³/(4πε₀). Singularity when the exact r² < 10^-30. Mirrors `field::electric_dipole_field`.
public fn bj_electric_dipole_field(dipole_moment: BjFieldVector, field_pos: *f64, out: *BjFieldVector): Result {
    var r_hat: BjFieldVector;
    var inv_r: f64 = _bj_field_rhat(field_pos, &r_hat);
    if (inv_r < 0.0) { return Err(_bj_err_singularity()); }
    var inv_r3: f64 = inv_r * inv_r * inv_r;
    var p_dot: f64 = _bj_fv_dot_rust(dipole_moment, r_hat);
    var d: f64 = 4.0 * _BJ_PI * BJ_EPSILON_0;
    var factor: f64 = inv_r3 / d;
    var k: f64 = 3.0 * p_dot * factor;
    var a: BjFieldVector = r_hat.scale(k);
    var b: BjFieldVector = dipole_moment.scale(factor);
    var e: BjFieldVector = a - b;
    out.x = e.x;
    out.y = e.y;
    out.z = e.z;
    return Ok(0);
}

# V = p·r̂/(4πε₀r²) at field_pos from a dipole p at the origin, as (p·r̂)·(1/r)·(1/r)/(4πε₀). Singularity when
# the exact r² < 10^-30. Mirrors `field::electric_dipole_potential`.
public fn bj_electric_dipole_potential(dipole_moment: BjFieldVector, field_pos: *f64): Result {
    var r_hat: BjFieldVector;
    var inv_r: f64 = _bj_field_rhat(field_pos, &r_hat);
    if (inv_r < 0.0) { return Err(_bj_err_singularity()); }
    var p_dot: f64 = _bj_fv_dot_rust(dipole_moment, r_hat);
    var d: f64 = 4.0 * _BJ_PI * BJ_EPSILON_0;
    var v: f64 = p_dot * inv_r * inv_r / d;
    return Ok(v);
}

# B = (μ₀/4πr³)·[3(m·r̂)r̂ − m] at field_pos from a magnetic dipole m at the origin, as r̂·(3(m·r̂)·f) − m·f with
# f = μ₀·(1/r)³/(4π). Singularity when the exact r² < 10^-30. Mirrors `field::magnetic_dipole_field`.
public fn bj_magnetic_dipole_field(magnetic_moment: BjFieldVector, field_pos: *f64, out: *BjFieldVector): Result {
    var r_hat: BjFieldVector;
    var inv_r: f64 = _bj_field_rhat(field_pos, &r_hat);
    if (inv_r < 0.0) { return Err(_bj_err_singularity()); }
    var inv_r3: f64 = inv_r * inv_r * inv_r;
    var m_dot: f64 = _bj_fv_dot_rust(magnetic_moment, r_hat);
    var four_pi: f64 = 4.0 * _BJ_PI;
    var factor: f64 = BJ_MU_0 * inv_r3 / four_pi;
    var k: f64 = 3.0 * m_dot * factor;
    var a: BjFieldVector = r_hat.scale(k);
    var b: BjFieldVector = magnetic_moment.scale(factor);
    var e: BjFieldVector = a - b;
    out.x = e.x;
    out.y = e.y;
    out.z = e.z;
    return Ok(0);
}

# ── Gauss's-law fields (M1 part 3b) ─────────────────────────────────────────────────────────────────────────────

# |E| = σ/(2ε₀) (V/m) from an infinite plane of surface charge density σ. Mirrors
# `field::electric_field_infinite_plane`.
#must_use
#pure
public fn bj_electric_field_infinite_plane(surface_charge_density: f64): f64 {
    var d: f64 = 2.0 * BJ_EPSILON_0;
    var e: f64 = surface_charge_density / d;
    return e;
}

# A radial distance's errors: InvalidParameter when NaN or negative, Singularity below 10^-30 m (the double nearest
# 10^-30 lies above it, so Rust's `distance < 1e-30` is the exact test); else Ok(0). Mirrors
# field.rs's `pub(crate) check_radial_distance`.
public fn _bj_check_radial_distance(distance: f64): Result {
    if (distance != distance || distance < 0.0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "distance must be non-negative, got ");
        _bj_fmt_f64_display(t, distance);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (distance < _BJ_FIELD_R2_MIN) { return Err(_bj_err_singularity()); }
    return Ok(0);
}

# E_r = kQ/r² (V/m) outside a uniformly charged sphere (r > R), correctly rounded (ADR 0002 row 13; a non-finite
# operand keeps Rust's k·Q/(r·r)). Errors as _bj_check_radial_distance. Mirrors `field::electric_field_charged_sphere`.
public fn bj_electric_field_charged_sphere(total_charge: f64, distance: f64): Result {
    var t, v = _bj_check_radial_distance(distance);
    if (is_err_result(t) == 1) { return Err(v); }
    if (_bj_is_finite(total_charge) == 0 || _bj_is_finite(distance) == 0) {
        var r2: f64 = distance * distance;
        var e: f64 = BJ_COULOMB_K * total_charge / r2;
        return Ok(e);
    }
    var cr: f64 = _bj_k_cr_mul2_div2(BJ_COULOMB_K, total_charge, distance, distance);
    return Ok(cr);
}

# E_r = kQ·(r/R)/R² (V/m) inside a uniformly charged sphere, 0 ≤ r ≤ R: kQr/R³ correctly rounded (ADR 0002 row 13;
# a non-finite Q keeps Rust's chain). InvalidParameter when R is not positive and
# finite, or r is outside [0, R] (or NaN). Mirrors `field::electric_field_inside_sphere`.
public fn bj_electric_field_inside_sphere(total_charge: f64, sphere_radius: f64, distance: f64): Result {
    if (!(sphere_radius > 0.0 && _bj_is_finite(sphere_radius) == 1)) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "sphere radius must be positive and finite, got ");
        _bj_fmt_f64_display(t, sphere_radius);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (!(distance >= 0.0 && distance <= sphere_radius)) {
        var t2 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t2, "distance must lie in [0, R] = [0, ");
        _bj_fmt_f64_display(t2, sphere_radius);
        _bj_tx_cstr(t2, "] for the interior field, got ");
        _bj_fmt_f64_display(t2, distance);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (_bj_is_finite(total_charge) == 0) {
        var frac: f64 = distance / sphere_radius;
        var r2: f64 = sphere_radius * sphere_radius;
        var e: f64 = BJ_COULOMB_K * total_charge * frac / r2;
        return Ok(e);
    }
    var num: f64[3];
    var den: f64[3];
    num[0] = BJ_COULOMB_K;
    num[1] = total_charge;
    num[2] = distance;
    den[0] = sphere_radius;
    den[1] = sphere_radius;
    den[2] = sphere_radius;
    var cr: f64 = _bj_k_cr_mono(&num, 3, &den, 3);
    return Ok(cr);
}

# E_r = λ/(2πε₀r) (V/m) from an infinite line of linear charge density λ, correctly rounded with π as Rust's double
# (ADR 0002 row 13; a non-finite operand keeps Rust's λ/(2·π·ε₀·r)). Errors as _bj_check_radial_distance. Mirrors
# `field::electric_field_infinite_line`.
public fn bj_electric_field_infinite_line(linear_charge_density: f64, distance: f64): Result {
    var t, v = _bj_check_radial_distance(distance);
    if (is_err_result(t) == 1) { return Err(v); }
    if (_bj_is_finite(linear_charge_density) == 0 || _bj_is_finite(distance) == 0) {
        var d: f64 = 2.0 * _BJ_PI * BJ_EPSILON_0 * distance;
        var e: f64 = linear_charge_density / d;
        return Ok(e);
    }
    var two_pi: f64 = 2.0 * _BJ_PI;
    var cr: f64 = _bj_k_cr_div3(linear_charge_density, two_pi, BJ_EPSILON_0, distance);
    return Ok(cr);
}

# E_r = λ/(2πε₀r) outside an infinite uniformly charged cylinder: the line's field and errors. Mirrors
# `field::electric_field_outside_cylinder`.
public fn bj_electric_field_outside_cylinder(linear_charge_density: f64, distance: f64): Result {
    return bj_electric_field_infinite_line(linear_charge_density, distance);
}

# E_r = ρr/(2ε₀) (V/m) inside an infinite uniformly charged cylinder, correctly rounded (ADR 0002 row 13; a non-finite
# operand keeps Rust's ρ·r/(2ε₀)). InvalidParameter when r is NaN or negative.
# Mirrors `field::electric_field_inside_cylinder`.
public fn bj_electric_field_inside_cylinder(volume_charge_density: f64, distance: f64): Result {
    if (distance != distance || distance < 0.0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "distance must be non-negative, got ");
        _bj_fmt_f64_display(t, distance);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var d: f64 = 2.0 * BJ_EPSILON_0;
    if (_bj_is_finite(volume_charge_density) == 0 || _bj_is_finite(distance) == 0) {
        var e: f64 = volume_charge_density * distance / d;
        return Ok(e);
    }
    var cr: f64 = _bj_k_cr_mul_div(volume_charge_density, distance, d);
    return Ok(cr);
}

# E_z = kQz/(z² + R²)^(3/2) (V/m) on the axis of a ring of radius R in the plane z = 0, z signed; 0 at the centre,
# Singularity there only for R = 0 (a point charge). InvalidParameter when R is negative, NaN or infinite, or z is not
# finite. Mirrors `field::electric_field_ring_axis`.
public fn bj_electric_field_ring_axis(total_charge: f64, ring_radius: f64, axial_distance: f64): Result {
    if (!(ring_radius >= 0.0 && _bj_is_finite(ring_radius) == 1)) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "ring radius must be non-negative and finite, got ");
        _bj_fmt_f64_display(t, ring_radius);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (_bj_is_finite(axial_distance) == 0) {
        var t2 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t2, "axial distance must be finite, got ");
        _bj_fmt_f64_display(t2, axial_distance);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (axial_distance == 0.0) {
        if (ring_radius == 0.0) { return Err(_bj_err_singularity()); }
        var zero: f64 = 0.0;
        return Ok(zero);
    }
    var d_sq: f64 = axial_distance * axial_distance + ring_radius * ring_radius;
    var rt: f64 = f64_sqrt(d_sq);
    var denom: f64 = d_sq * rt;
    var e: f64 = BJ_COULOMB_K * total_charge * axial_distance / denom;
    return Ok(e);
}

# E_z = sgn(z)·(σ/2ε₀)·(R/r)·(R/(r + |z|)), r = √(z² + R²), on the axis of a disk of radius R in the plane z = 0: the
# cancellation-free form, the one-sided limit at z = ±0 by the sign bit. InvalidParameter when R is not positive and
# finite, or z is not finite. Mirrors `field::electric_field_disk_axis`.
public fn bj_electric_field_disk_axis(surface_charge_density: f64, disk_radius: f64, axial_distance: f64): Result {
    if (!(disk_radius > 0.0 && _bj_is_finite(disk_radius) == 1)) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "disk radius must be positive and finite, got ");
        _bj_fmt_f64_display(t, disk_radius);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (_bj_is_finite(axial_distance) == 0) {
        var t2 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t2, "axial distance must be finite, got ");
        _bj_fmt_f64_display(t2, axial_distance);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var abs_z: f64 = f64_abs(axial_distance);
    var s2: f64 = axial_distance * axial_distance + disk_radius * disk_radius;
    var r: f64 = f64_sqrt(s2);
    var g1: f64 = disk_radius / r;
    var rz: f64 = r + abs_z;
    var g2: f64 = disk_radius / rz;
    var geometric: f64 = g1 * g2;
    var sign: f64 = _bj_copysign(1.0, axial_distance);
    var d: f64 = 2.0 * BJ_EPSILON_0;
    var e: f64 = sign * surface_charge_density / d * geometric;
    return Ok(e);
}

# ── multipoles (M1 part 3b) ─────────────────────────────────────────────────────────────────────────────────────

# V = (1/4πε₀)·½·Σᵢⱼ Qᵢⱼxᵢxⱼ/r⁵ (volts) at field_pos from a quadrupole at the origin: Σ in i-then-j order from 0, over
# 8πε₀r⁵ with r⁵ = r²·r²·r. q_tensor is 9 f64, row-major (Rust's `[[f64; 3]; 3]`). Singularity when the exact
# r² < 10^-30 (ADR 0002 row 17). Mirrors `field::electric_quadrupole_potential`.
public fn bj_electric_quadrupole_potential(q_tensor: *f64, field_pos: *f64): Result {
    var r_sq: f64 = field_pos[0] * field_pos[0] + field_pos[1] * field_pos[1] + field_pos[2] * field_pos[2];
    var band = _bj_x_band(r_sq, _BJ_FIELD_R2_MIN);
    if (band == 2) { band = _bj_x_r2_below(field_pos, &_bj_x_origin, 30); }
    if (band == 1) {
        return Err(_bj_err_singularity());
    }
    var r: f64 = f64_sqrt(r_sq);
    var r5: f64 = r_sq * r_sq * r;
    var sum: f64 = 0.0;
    for (var i = 0; i < 3; i = i + 1) {
        for (var j = 0; j < 3; j = j + 1) {
            var term: f64 = q_tensor[i * 3 + j] * field_pos[i] * field_pos[j];
            sum = sum + term;
        }
    }
    var d: f64 = 8.0 * _BJ_PI * BJ_EPSILON_0 * r5;
    var v: f64 = sum / d;
    return Ok(v);
}

# (r, cos θ, sin θ, φ) of a point into out (4 f64); 0 at the origin, else 1. cos θ = z/r and sin θ = ρ/r, clamped,
# straight from the components (no acos round trip); φ = atan2(y, x). Mirrors field.rs's `spherical_coords`.
fn _bj_spherical_coords(pos: *f64, out: *f64): i64 {
    var rho_sq: f64 = pos[0] * pos[0] + pos[1] * pos[1];
    var s: f64 = rho_sq + pos[2] * pos[2];
    var r: f64 = f64_sqrt(s);
    if (r == 0.0) { return 0; }
    var c0: f64 = pos[2] / r;
    var rho: f64 = f64_sqrt(rho_sq);
    var s0: f64 = rho / r;
    out[0] = r;
    out[1] = _bj_clamp(c0, -1.0, 1.0);
    out[2] = _bj_clamp(s0, 0.0, 1.0);
    out[3] = _bj_atan2(pos[1], pos[0]);
    return 1;
}

# rˡ: compiler-rt's powi for l up to 2^31 − 1 (Rust's `r.powi(l as i32)`), powf above. Mirrors field.rs's
# `radial_power`.
#must_use
fn _bj_radial_power(r: f64, l): f64 {
    if (l <= 2147483647) {
        var p: f64 = _bj_powi(r, l);
        return p;
    }
    var lf: f64 = f64_from(l);
    var q: f64 = _bj_powf(r, lf);
    return q;
}

# P_l^m(x), the associated Legendre function with the Condon–Shortley phase, by the upward recurrence; s = √(1 − x²)
# passed in so it stays accurate near |x| = 1. 0 for m > l. Mirrors field.rs's private `associated_legendre`.
#must_use
public fn _bj_associated_legendre(l, m, x: f64, s: f64): f64 {
    if (m > l) {
        var z0: f64 = 0.0;
        return z0;
    }
    var pmm: f64 = 1.0;
    var fact: f64 = 1.0;
    for (var k = 0; k < m; k = k + 1) {
        var nf: f64 = -fact;
        pmm = pmm * (nf * s);
        fact = fact + 2.0;
    }
    if (l == m) { return pmm; }
    var m_f: f64 = f64_from(m);
    var pmmp1: f64 = x * (2.0 * m_f + 1.0) * pmm;
    if (l == m + 1) { return pmmp1; }
    var pll: f64 = 0.0;
    for (var ll = m + 2; ll <= l; ll = ll + 1) {
        var ll_f: f64 = f64_from(ll);
        var a: f64 = x * (2.0 * ll_f - 1.0) * pmmp1;
        var b: f64 = (ll_f + m_f - 1.0) * pmm;
        pll = (a - b) / (ll_f - m_f);
        pmm = pmmp1;
        pmmp1 = pll;
    }
    return pll;
}

# P̄_l^m(x) = √((2l+1)/(4π)·(l−m)!/(l+m)!)·P_l^m(x), CS phase included, by the stable recurrence (Numerical Recipes
# §6.7, no factorials). 0 for m > l. Mirrors field.rs's private `normalized_associated_legendre`.
#must_use
fn _bj_normalized_associated_legendre(l, m, x: f64, s: f64): f64 {
    if (m > l) {
        var z0: f64 = 0.0;
        return z0;
    }
    var pmm: f64 = 1.0;
    for (var k = 1; k <= m; k = k + 1) {
        var k_f: f64 = f64_from(k);
        var ratio: f64 = (2.0 * k_f - 1.0) / (2.0 * k_f);
        var sr: f64 = f64_sqrt(ratio);
        var ns: f64 = -s;
        pmm = pmm * (ns * sr);
    }
    var m_f: f64 = f64_from(m);
    var c0: f64 = (2.0 * m_f + 1.0) / (4.0 * _BJ_PI);
    var c: f64 = f64_sqrt(c0);
    pmm = pmm * c;
    if (l == m) { return pmm; }
    var c3: f64 = 2.0 * m_f + 3.0;
    var s3: f64 = f64_sqrt(c3);
    var pmmp1: f64 = x * s3 * pmm;
    if (l == m + 1) { return pmmp1; }
    var m_sq: f64 = m_f * m_f;
    var mp1: f64 = m_f + 1.0;
    var a0: f64 = (4.0 * mp1 * mp1 - 1.0) / (mp1 * mp1 - m_sq);
    var a_prev: f64 = f64_sqrt(a0);
    var pll: f64 = 0.0;
    for (var ll = m + 2; ll <= l; ll = ll + 1) {
        var ll_f: f64 = f64_from(ll);
        var an: f64 = (4.0 * ll_f * ll_f - 1.0) / (ll_f * ll_f - m_sq);
        var a: f64 = f64_sqrt(an);
        var inner: f64 = x * pmmp1 - pmm / a_prev;
        pll = a * inner;
        pmm = pmmp1;
        pmmp1 = pll;
        a_prev = a;
    }
    return pll;
}

# The InvalidParameter of a moment's order: "|m| must be ≤ l, got l={l}, m={m}" (Rust's), and, Cyrius-only, l outside
# a u32 or m outside an i32 (the types Rust's signature gives them).
fn _bj_moment_order_error(l, m): i64 {
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    if (l < 0 || l > 4294967295 || m < 0 - 2147483648 || m > 2147483647) {
        _bj_tx_cstr(t, "l must be a u32 and m an i32, got l=");
    } else {
        _bj_tx_cstr(t, "|m| must be ≤ l, got l=");
    }
    _bj_tx_i64(t, l);
    _bj_tx_cstr(t, ", m=");
    _bj_tx_i64(t, m);
    return BJ_ERR_INVALID_PARAMETER;
}

# M_lm = Σᵢ qᵢ·rᵢˡ·P_l^|m|(cos θᵢ)·{cos(mφᵢ) for m ≥ 0, sin(|m|φᵢ) for m < 0}, the unnormalized real moment (C·mˡ) of
# n charges at `charges` (32 bytes each: q, x, y, z), summed in order; a charge at the origin adds q to the monopole
# only. InvalidParameter when |m| > l. Mirrors `field::multipole_moment`.
public fn bj_multipole_moment(l, m, charges: *f64, n): Result {
    var m_abs = m;
    if (m < 0) { m_abs = 0 - m; }
    if (l < 0 || l > 4294967295 || m < 0 - 2147483648 || m > 2147483647 || m_abs > l) {
        return Err(_bj_moment_order_error(l, m));
    }
    var m_f: f64 = f64_from(m_abs);
    var moment: f64 = 0.0;
    var sc: f64[4];
    for (var i = 0; i < n; i = i + 1) {
        var c: *f64 = charges + i * 4;
        var q: f64 = c[0];
        if (_bj_spherical_coords(c + 1, &sc) == 0) {
            if (l == 0) { moment = moment + q; }
        } else {
            var r: f64 = sc[0];
            var ang: f64 = m_f * sc[3];
            var az: f64 = 0.0;
            if (m >= 0) { az = _bj_cos(ang); } else { az = _bj_sin(ang); }
            var rp: f64 = _bj_radial_power(r, l);
            var pl: f64 = _bj_associated_legendre(l, m_abs, sc[1], sc[2]);
            var term: f64 = q * rp * pl * az;
            moment = moment + term;
        }
    }
    return Ok(moment);
}

# q_lm = Σᵢ qᵢ·rᵢˡ·Y*_lm(θᵢ, φᵢ) (Jackson eq. 4.3, orthonormal Y with the CS phase), into out as (Re, Im):
# w·(cos mφ, −sin mφ) for m ≥ 0, and (−1)^|m|·w·(cos |m|φ, sin |m|φ) for m < 0, w = q·rˡ·P̄_l^|m|(cos θ); a charge at
# the origin adds q·0.5/√π to Re q₀₀ only. Static, so no time convention enters. InvalidParameter when |m| > l. Mirrors
# `field::spherical_multipole_moment` (its `(f64, f64)` is a BjComplex here).
public fn bj_spherical_multipole_moment(l, m, charges: *f64, n, out: *BjComplex): Result {
    var m_abs = m;
    if (m < 0) { m_abs = 0 - m; }
    if (l < 0 || l > 4294967295 || m < 0 - 2147483648 || m > 2147483647 || m_abs > l) {
        return Err(_bj_moment_order_error(l, m));
    }
    var m_f: f64 = f64_from(m_abs);
    var neg_sign: f64 = 1.0;
    if ((m_abs & 1) == 1) { neg_sign = -1.0; }
    var re: f64 = 0.0;
    var im: f64 = 0.0;
    var sp: f64 = f64_sqrt(_BJ_PI);
    var sc: f64[4];
    for (var i = 0; i < n; i = i + 1) {
        var c: *f64 = charges + i * 4;
        var q: f64 = c[0];
        if (_bj_spherical_coords(c + 1, &sc) == 0) {
            if (l == 0) {
                var y00: f64 = q * 0.5 / sp;
                re = re + y00;
            }
        } else {
            var rp: f64 = _bj_radial_power(sc[0], l);
            var pl: f64 = _bj_normalized_associated_legendre(l, m_abs, sc[1], sc[2]);
            var w: f64 = q * rp * pl;
            var ang: f64 = m_f * sc[3];
            var s, cs = _bj_sin_cos(ang);
            var sv: f64 = s;
            var cv: f64 = cs;
            if (m >= 0) {
                var wc: f64 = w * cv;
                var ws: f64 = w * sv;
                re = re + wc;
                im = im - ws;
            } else {
                var nc: f64 = neg_sign * w * cv;
                var ns: f64 = neg_sign * w * sv;
                re = re + nc;
                im = im + ns;
            }
        }
    }
    out.re = re;
    out.im = im;
    return Ok(0);
}

# ── method of images (M1 part 3b) ───────────────────────────────────────────────────────────────────────────────

# The image of a charge at `position` in a conducting plane z = plane_z: returns −charge, and writes the mirror
# point (x, y, 2·plane_z − z) to image_pos; where 2·plane_z overflows (|plane_z| ≥ 2^1023, z finite) the difference
# with an unbounded exponent, rounded once (ADR 0002 row 18). Mirrors `field::image_charge_plane` (its tuple: the
# charge returned, the position written).
#must_use
public fn bj_image_charge_plane(charge: f64, position: *f64, plane_z: f64, image_pos: *f64): f64 {
    var z: f64 = position[2];
    var image_z: f64 = 2.0 * plane_z - z;
    var bp = (_bj_bits(plane_z) >> 52) & 0x7FF;
    if (bp >= 2046 && bp != 2047 && _bj_is_finite(z) == 1) {
        var ps, pe = _bj_k_ux_from(plane_z);
        var zs, ze = _bj_k_ux_from(z);
        var iz: f64 = _bj_k_ux_sub_f64(ps, pe + 1, zs, ze);
        image_z = iz;
    }
    image_pos[0] = position[0];
    image_pos[1] = position[1];
    image_pos[2] = image_z;
    var q: f64 = -charge;
    return q;
}

# The image of a charge at `position` outside a grounded sphere of radius R at the origin: Ok(q' = −(R/d)·q), and the
# position (R²/d²)·r into image_pos (Griffiths Ex. 3.2). InvalidParameter when R is not positive and finite, or the
# charge is not strictly outside (a NaN position included). Mirrors `field::image_charge_sphere`.
public fn bj_image_charge_sphere(charge: f64, position: *f64, sphere_radius: f64, image_pos: *f64): Result {
    if (!(sphere_radius > 0.0 && _bj_is_finite(sphere_radius) == 1)) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "sphere radius must be positive and finite, got ");
        _bj_fmt_f64_display(t, sphere_radius);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var d_sq: f64 = position[0] * position[0] + position[1] * position[1] + position[2] * position[2];
    var d: f64 = f64_sqrt(d_sq);
    if (d != d || d <= sphere_radius) {
        var t2 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t2, "charge must be outside the sphere (|r| = ");
        _bj_fmt_f64_display(t2, d);
        _bj_tx_cstr(t2, " > R = ");
        _bj_fmt_f64_display(t2, sphere_radius);
        _bj_tx_putc(t2, 41);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var ratio: f64 = sphere_radius / d;
    var nq: f64 = -charge;
    var q_image: f64 = nq * ratio;
    var scale: f64 = ratio * ratio;
    image_pos[0] = position[0] * scale;
    image_pos[1] = position[1] * scale;
    image_pos[2] = position[2] * scale;
    return Ok(q_image);
}

# The image of a charge at height z > 0 over a dielectric half-space (Jackson §4.4): Ok(q' = −q(ε₂ − ε₁)/(ε₁ + ε₂)),
# and the mirror point (x, y, −z) into image_pos. InvalidParameter when z is not positive and finite, then
# InvalidPermittivity for the first of ε₁, ε₂ that is not positive and finite. Where the product −q·(ε₂ − ε₁) or the
# sum ε₁ + ε₂ leaves the normal range (a finite q), the chain runs with an unbounded exponent and the quotient is
# rounded once (ADR 0002 row 18). Mirrors `field::image_charge_dielectric`.
public fn bj_image_charge_dielectric(charge: f64, position: *f64, eps_r1: f64, eps_r2: f64, image_pos: *f64): Result {
    var z: f64 = position[2];
    if (!(z > 0.0 && _bj_is_finite(z) == 1)) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "charge must be in medium 1 (z > 0) for dielectric image method, got z = ");
        _bj_fmt_f64_display(t, z);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (!(eps_r1 > 0.0 && _bj_is_finite(eps_r1) == 1)) { return Err(_bj_err_invalid_permittivity(eps_r1)); }
    if (!(eps_r2 > 0.0 && _bj_is_finite(eps_r2) == 1)) { return Err(_bj_err_invalid_permittivity(eps_r2)); }
    var nq: f64 = -charge;
    var diff: f64 = eps_r2 - eps_r1;
    var num: f64 = nq * diff;
    var den: f64 = eps_r1 + eps_r2;
    var q_image: f64 = num / den;
    if (_bj_is_finite(charge) == 1 && _bj_fv_dielectric_plain(nq, diff, num, den) == 0) {
        var ns, ne = _bj_k_ux_from(nq);
        var e1s, e1e = _bj_k_ux_from(eps_r1);
        var e2s, e2e = _bj_k_ux_from(eps_r2);
        var ds, de = _bj_k_ux_sub(e2s, e2e, e1s, e1e);
        var ms, me = _bj_k_ux_mul(ns, ne, ds, de);
        var ss, se = _bj_k_ux_add(e1s, e1e, e2s, e2e);
        var qi: f64 = _bj_k_ux_div_f64(ms, me, ss, se);
        q_image = qi;
    }
    image_pos[0] = position[0];
    image_pos[1] = position[1];
    image_pos[2] = -z;
    return Ok(q_image);
}

# 1 when the dielectric image's binary64 chain is the unbounded one (ε₁, ε₂ positive normal doubles): the sum below
# DBL_MAX, the product of −q and the difference exactly 0 (one factor 0) or normal and above 2^-1022; the difference
# of two positive doubles is exact wherever it is small, so it needs no test.
#must_use
fn _bj_fv_dielectric_plain(nq: f64, diff: f64, num: f64, den: f64): i64 {
    var bd = _bj_bits(den) >> 52;
    if (bd >= 2047) { return 0; }
    var bn = _bj_bits(num) & 0x7FFFFFFFFFFFFFFF;
    if (bn == 0) {
        if (nq == 0.0 || diff == 0.0) { return 1; }
        return 0;
    }
    if (bn <= 0x0010000000000000 || bn >= 0x7FF0000000000000) { return 0; }
    return 1;
}

# ── Green's functions (M1 part 3b) ──────────────────────────────────────────────────────────────────────────────

# (4π)·R for R = |f − c| with an unbounded exponent, to 53 bits: (s, e) (the Green's functions at a range edge).
#must_use
fn _bj_fv_green_den_ux(f: *f64, c: *f64): (f64, i64) {
    var o: f64[5];
    var oe: i64[5];
    _bj_vx_offset_ux(f, c, &o, &oe);
    var four_pi: f64 = 4.0 * _BJ_PI;
    var ps, pe = _bj_k_ux_from(four_pi);
    var ds, de = _bj_k_ux_mul(ps, pe, o[3], oe[3]);
    return (ds, de);
}

# The scalar Green's function at a range edge, into out: R, 4πR, its reciprocal and k·R with an unbounded exponent, the
# cosine and sine of the 53-bit k·R (past DBL_MAX by _bj_vx_cos53, _bj_vx_sin53), each product rounded once.
fn _bj_fv_green_scalar_edge(f: *f64, c: *f64, k: f64, out: *BjComplex) {
    var o: f64[5];
    var oe: i64[5];
    _bj_vx_offset_ux(f, c, &o, &oe);
    var four_pi: f64 = 4.0 * _BJ_PI;
    var ps, pe = _bj_k_ux_from(four_pi);
    var ds, de = _bj_k_ux_mul(ps, pe, o[3], oe[3]);
    var fs, fe = _bj_k_ux_div(1.0, 0, ds, de);
    var ks, ke = _bj_k_ux_from(k);
    var ts, te = _bj_k_ux_mul(ks, ke, o[3], oe[3]);
    var cs, ce = _bj_vx_cos53(ts, te);
    var ss, se = _bj_vx_sin53(ts, te);
    var re: f64 = _bj_k_ux_mul_f64(fs, fe, cs, ce);
    var im: f64 = _bj_k_ux_mul_f64(fs, fe, ss, se);
    out.re = re;
    out.im = -im;
    return 0;
}

# G(r, r') = e^{−jkR}/(4πR), the free-space scalar Green's function of the outgoing wave in bijli's e^{+jωt}
# convention (src/complex.cyr), into out: (cos kR, −sin kR)/(4πR). Rust's e^{+ikR}/(4πR) was the e^{−iωt} form, so the
# port's value is its conjugate (ADR 0002 row 5). At a range edge (4πR past DBL_MAX, 1/(4πR) or kR outside the normal
# range) the chain runs with an unbounded exponent, kR's cosine and sine included, each product rounded once (row 18).
# Singularity when the exact R < 10^-30 (row 17). Mirrors `field::greens_function_scalar` (its `(f64, f64)` is a
# BjComplex here).
public fn bj_greens_function_scalar(field_pos: *f64, source_pos: *f64, k: f64, out: *BjComplex): Result {
    var dx: f64 = field_pos[0] - source_pos[0];
    var dy: f64 = field_pos[1] - source_pos[1];
    var dz: f64 = field_pos[2] - source_pos[2];
    var s: f64 = dx * dx + dy * dy + dz * dz;
    var r: f64 = f64_sqrt(s);
    var band = _bj_x_band(r, _BJ_FIELD_R2_MIN);
    if (band == 2) { band = _bj_x_r2_below(field_pos, source_pos, 60); }
    if (band == 1) {
        return Err(_bj_err_singularity());
    }
    var d: f64 = 4.0 * _BJ_PI * r;
    var factor: f64 = 1.0 / d;
    var kr: f64 = k * r;
    var c: f64 = _bj_cos(kr);
    var sn: f64 = _bj_sin(kr);
    var im: f64 = factor * sn;
    out.re = factor * c;
    out.im = -im;
    var e1 = (load64(&d) >> 52) & 0x7FF;
    var e2 = (load64(&factor) >> 52) & 0x7FF;
    var e3 = (load64(&kr) >> 52) & 0x7FF;
    if (((2046 - e1) | (e2 - 2) | (2046 - e2) | (e3 - 2) | (2046 - e3)) >= 0) { return Ok(0); }
    var p: f64[7];
    for (var i = 0; i < 3; i = i + 1) {
        p[i] = field_pos[i];
        p[3 + i] = source_pos[i];
    }
    p[6] = k;
    if (_bj_vx_finite_n(&p, 7) == 0) { return Ok(0); }
    if (k == 0.0 && ((2046 - e1) | (e2 - 2) | (2046 - e2)) >= 0) { return Ok(0); }
    _bj_fv_green_scalar_edge(field_pos, source_pos, k, out);
    return Ok(0);
}

# G(r, r') = 1/(4πR), the static Green's function (k = 0); where 4πR passes DBL_MAX, R and 4πR with an unbounded
# exponent and the quotient rounded once (ADR 0002 row 18). Singularity when the exact R < 10^-30 (row 17). Mirrors
# `field::greens_function_static`.
public fn bj_greens_function_static(field_pos: *f64, source_pos: *f64): Result {
    var dx: f64 = field_pos[0] - source_pos[0];
    var dy: f64 = field_pos[1] - source_pos[1];
    var dz: f64 = field_pos[2] - source_pos[2];
    var s: f64 = dx * dx + dy * dy + dz * dz;
    var r: f64 = f64_sqrt(s);
    var band = _bj_x_band(r, _BJ_FIELD_R2_MIN);
    if (band == 2) { band = _bj_x_r2_below(field_pos, source_pos, 60); }
    if (band == 1) {
        return Err(_bj_err_singularity());
    }
    var d: f64 = 4.0 * _BJ_PI * r;
    var g: f64 = 1.0 / d;
    var e1 = (load64(&d) >> 52) & 0x7FF;
    if (e1 <= 2046) { return Ok(g); }
    var p: f64[6];
    for (var i = 0; i < 3; i = i + 1) {
        p[i] = field_pos[i];
        p[3 + i] = source_pos[i];
    }
    if (_bj_vx_finite_n(&p, 6) == 0) { return Ok(g); }
    var ds, de = _bj_fv_green_den_ux(field_pos, source_pos);
    var u: f64 = _bj_k_ux_div_f64(1.0, 0, ds, de);
    return Ok(u);
}

# ── the Maxwell stress tensor (M1 part 3b) ──────────────────────────────────────────────────────────────────────

# T_ij = ε₀(EᵢEⱼ − ½δᵢⱼE²) + (1/μ₀)(BᵢBⱼ − ½δᵢⱼB²) (Pa) into out, 9 f64 row-major (Rust's `[[f64; 3]; 3]`). Mirrors
# `field::maxwell_stress_tensor`.
public fn bj_maxwell_stress_tensor(e: BjFieldVector, b: BjFieldVector, out: *f64): i64 {
    var ea: f64[3];
    var ba: f64[3];
    e.to_array(&ea);
    b.to_array(&ba);
    var e_sq: f64 = _bj_fv_dot_rust(e, e);
    var b_sq: f64 = _bj_fv_dot_rust(b, b);
    var inv_mu0: f64 = 1.0 / BJ_MU_0;
    for (var i = 0; i < 3; i = i + 1) {
        for (var j = 0; j < 3; j = j + 1) {
            var delta: f64 = 0.0;
            if (i == j) { delta = 1.0; }
            var te: f64 = ea[i] * ea[j] - 0.5 * delta * e_sq;
            var tb: f64 = ba[i] * ba[j] - 0.5 * delta * b_sq;
            var t1: f64 = BJ_EPSILON_0 * te;
            var t2: f64 = inv_mu0 * tb;
            out[i * 3 + j] = t1 + t2;
        }
    }
    return 0;
}

# Fᵢ = Σⱼ Tᵢⱼnⱼ (N/m²), the force per unit area on a surface of outward normal n, each sum from 0 in j order.
# `tensor` is 9 f64, row-major. Mirrors `field::stress_tensor_force`.
#must_use
public fn bj_stress_tensor_force(tensor: *f64, normal: BjFieldVector): BjFieldVector {
    var n: f64[3];
    normal.to_array(&n);
    var f: f64[3];
    for (var i = 0; i < 3; i = i + 1) {
        var acc: f64 = 0.0;
        for (var j = 0; j < 3; j = j + 1) {
            var term: f64 = tensor[i * 3 + j] * n[j];
            acc = acc + term;
        }
        f[i] = acc;
    }
    var v: BjFieldVector = BjFieldVector_new(f[0], f[1], f[2]);
    return v;
}

# P ≈ Σ ((E × B)·(1/μ₀))·n̂·ΔA (W), the Poynting flux through a closed surface from n samples, each 10 f64 at
# `samples` (E, B, the outward normal, ΔA: Rust's `(FieldVector, FieldVector, FieldVector, f64)`), summed in order
# from 0. Mirrors `field::poynting_flux_surface`.
#must_use
public fn bj_poynting_flux_surface(samples: *f64, n): f64 {
    var inv_mu0: f64 = 1.0 / BJ_MU_0;
    var total: f64 = 0.0;
    for (var i = 0; i < n; i = i + 1) {
        var p: *f64 = samples + i * 10;
        var e: BjFieldVector = BjFieldVector_from_array(p);
        var b: BjFieldVector = BjFieldVector_from_array(p + 3);
        var nv: BjFieldVector = BjFieldVector_from_array(p + 6);
        var da: f64 = p[9];
        var cr: BjFieldVector = _bj_fv_cross_rust(e, b);
        var s: BjFieldVector = cr.scale(inv_mu0);
        var dt: f64 = _bj_fv_dot_rust(s, nv);
        var term: f64 = dt * da;
        total = total + term;
    }
    return total;
}

# ── field lines (M1 part 3c) ────────────────────────────────────────────────────────────────────────────────────

# A polyline of 3D points, a caller-owned growable buffer (Rust's `Vec<[f64; 3]>`, port plan §9.5): `pts` the address
# of 3·cap f64 from fl_alloc (0 while empty), `len` the points in use. Make one with BjPolyline_new, reuse it across
# calls (its buffer is kept), and give it back with BjPolyline_free.
public struct BjPolyline {
    pts;
    len;
    cap;
}

# The address a as a *f64 (an untyped word stored into a typed pointer warns; a typed return does not).
#must_use
fn _bj_f64p(a): *f64 {
    return a;
}

# An empty polyline (no buffer yet).
#must_use
public fn BjPolyline_new(): BjPolyline {
    var p: BjPolyline;
    p.pts = 0;
    p.len = 0;
    p.cap = 0;
    return p;
}

# Frees p's buffer and empties it.
public fn BjPolyline_free(p: *BjPolyline): i64 {
    if (p.pts != 0) { fl_free(p.pts); }
    p.pts = 0;
    p.len = 0;
    p.cap = 0;
    return 0;
}

impl BjPolyline {
    # The number of points.
    #must_use
    public fn count(self): i64 {
        return self.len;
    }

    # The address of point i's three f64 (0 ≤ i < count).
    #must_use
    public fn at(self, i): *f64 {
        var a: *f64 = _bj_f64p(self.pts + i * 24);
        return a;
    }
}

# Room in p for n points (p's points kept): 1, or 0 when the allocation fails. Grows to n, or to twice p's capacity
# when that is more.
fn _bj_poly_reserve(p: *BjPolyline, n): i64 {
    if (n <= p.cap) { return 1; }
    var c = p.cap * 2;
    if (c < n) { c = n; }
    var buf = fl_alloc(c * 24);
    if (buf == 0) { return 0; }
    if (p.pts != 0) {
        memcpy(buf, p.pts, p.len * 24);
        fl_free(p.pts);
    }
    p.pts = buf;
    p.cap = c;
    return 1;
}

# Appends point q (three f64) to p: 1, or 0 when p can't grow.
fn _bj_poly_push(p: *BjPolyline, q: *f64): i64 {
    if (p.len == p.cap && _bj_poly_reserve(p, p.len + 1) == 0) { return 0; }
    var a: *f64 = _bj_f64p(p.pts + p.len * 24);
    a[0] = q[0];
    a[1] = q[1];
    a[2] = q[2];
    p.len = p.len + 1;
    return 1;
}

# Rust's TRACE_INITIAL_CAPACITY: the first reservation is min(max_steps + 1, 4096) points; the buffer grows beyond.
var _BJ_TRACE_INITIAL_CAPACITY = 4096;

# Traces a field line from `start` by forward Euler, x ← x + h·F(x)/|F(x)|, into out (emptied first): `start`, then
# one point per step, at most max_steps + 1 points. `max_steps` is Rust's usize, its 64 bits unsigned: −1 is usize::MAX.
# `field_fn` is called through callptr as `field_fn(pos, f)`, pos the three f64 of the position and f a *BjFieldVector
# to fill; it returns BJ_ERR_NONE, or a BJ_ERR_* code with its error recorded (Rust's `Fn([f64; 3]) ->
# Result<FieldVector>`: a Result can't pass through callptr, plan §9.3). The line stops early, Ok, at a null point
# (a zero field), when field_fn returns Singularity (a source or sink), or at a field with an infinite component.
# Errors: InvalidParameter when step_size is not positive and finite, start is not finite, or field_fn returns a NaN
# component; any other error of field_fn's is returned as is; Allocation when out can't grow (Rust aborts there; ADR
# 0002 row 9). On an error out is empty. A success leaves the last-error record as field_fn left it. Mirrors
# `field::trace_field_line`.
public fn bj_trace_field_line(start: *f64, step_size: f64, max_steps, field_fn, out: *BjPolyline): Result {
    out.len = 0;
    if (!(step_size > 0.0 && _bj_is_finite(step_size) == 1)) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "step size must be positive and finite, got ");
        _bj_fmt_f64_display(t, step_size);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (_bj_is_finite(start[0]) == 0 || _bj_is_finite(start[1]) == 0 || _bj_is_finite(start[2]) == 0) {
        var t2 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t2, "start position must be finite, got ");
        _bj_fmt_f64x3_debug(t2, start);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (_bj_log_on(4) == 1) {
        var lb[400];
        var lt[24];
        _bj_tx_init(&lt, &lb, 400);
        _bj_tx_cstr(&lt, "tracing field line start=");
        _bj_fmt_f64x3_debug(&lt, start);
        _bj_tx_cstr(&lt, " step_size=");
        _bj_fmt_f64_debug(&lt, step_size);
        _bj_tx_cstr(&lt, " max_steps=");
        _bj_tx_u64(&lt, max_steps);
        _bj_log_text(4, &lt);
    }
    var first = _BJ_TRACE_INITIAL_CAPACITY;
    if (max_steps >= 0 && max_steps < _BJ_TRACE_INITIAL_CAPACITY - 1) { first = max_steps + 1; }
    if (_bj_poly_reserve(out, first) == 0) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "field line buffer");
        return Err(BJ_ERR_ALLOCATION);
    }
    var pos: f64[3];
    pos[0] = start[0];
    pos[1] = start[1];
    pos[2] = start[2];
    _bj_poly_push(out, &pos);
    var stop_reason = "max_steps reached";
    var f: BjFieldVector;
    var dir: BjFieldVector;
    var i = 0;
    while (i != max_steps) {
        var st = callptr(field_fn, &pos, &f);
        if (st != BJ_ERR_NONE) {
            if (st == BJ_ERR_SINGULARITY) {
                stop_reason = "singularity (source/sink)";
                break;
            }
            out.len = 0;
            return Err(st);
        }
        var fx: f64 = f.x;
        var fy: f64 = f.y;
        var fz: f64 = f.z;
        if (fx != fx || fy != fy || fz != fz) {
            out.len = 0;
            var t3 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(t3, "field function returned NaN at ");
            _bj_fmt_f64x3_debug(t3, &pos);
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        if (_bj_is_finite(fx) == 0 || _bj_is_finite(fy) == 0 || _bj_is_finite(fz) == 0) {
            stop_reason = "infinite field (source/sink)";
            break;
        }
        # A finite field fails to normalize only when it is zero: test that first, so a null point leaves the
        # last-error record alone, as Rust's discarded error has no effect.
        if (fx == 0.0 && fy == 0.0 && fz == 0.0) {
            stop_reason = "null point";
            break;
        }
        var tn, vn = f.normalized(&dir);
        pos[0] = pos[0] + step_size * dir.x;
        pos[1] = pos[1] + step_size * dir.y;
        pos[2] = pos[2] + step_size * dir.z;
        if (_bj_poly_push(out, &pos) == 0) {
            out.len = 0;
            _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "field line buffer");
            return Err(BJ_ERR_ALLOCATION);
        }
        i = i + 1;
    }
    if (_bj_log_on(4) == 1) {
        var lb2[160];
        var lt2[24];
        _bj_tx_init(&lt2, &lb2, 160);
        _bj_tx_cstr(&lt2, "field line traced points=");
        _bj_tx_u64(&lt2, out.len);
        _bj_tx_cstr(&lt2, " stop_reason=\"");
        _bj_tx_cstr(&lt2, stop_reason);
        _bj_tx_putc(&lt2, 34);
        _bj_log_text(4, &lt2);
    }
    return Ok(0);
}

# --- maxwell.cyr ---

# maxwell.cyr — Maxwell's equations: the divergences, the displacement current, wave speed, refractive index,
# impedance, wavelength and frequency, skin depth (port of rust-old/src/maxwell.rs, M1 part 3d).
#
# SI units throughout. A fallible function returns a value-form Result with its f64 payload, the error in the last-error
# record (src/error.cyr). No harmonic quantity appears here, so no time convention (src/complex.cyr) is involved.
#
# The roots are rounded once (ADR 0002 row 13, the user's "round once" decision of 2026-11-12): wave_speed, the
# refractive index, the impedances and skin depth are the correctly rounded √ of their monomial (src/crmath_mono.cyr;
# kimiya's √(x/y) for the impedances), where Rust's chains round two to four times (one ulp off on about a quarter of
# inputs) and their products and quotients over- or underflow where the root is representable. An infinite operand keeps
# Rust's result (an infinite product or quotient, then its root). The divergences, the displacement current, wavelength
# and frequency are one IEEE operation each, already rounded once: Rust's bits.

private

# The InvalidPermittivity or InvalidPermeability of a medium's ε and μ (NaN or not positive, ε first), or 0.
fn _bj_check_eps_mu(permittivity: f64, permeability: f64): i64 {
    if (permittivity != permittivity || permittivity <= 0.0) { return _bj_err_invalid_permittivity(permittivity); }
    if (permeability != permeability || permeability <= 0.0) { return _bj_err_invalid_permeability(permeability); }
    return 0;
}

# The InvalidParameter "<name> must be positive, got <value>" for a NaN or non-positive value, or 0.
fn _bj_check_positive(name, value: f64): i64 {
    if (value != value || value <= 0.0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, name);
        _bj_tx_cstr(t, " must be positive, got ");
        _bj_fmt_f64_display(t, value);
        return BJ_ERR_INVALID_PARAMETER;
    }
    return 0;
}

# ∇·E = ρ/ε₀ (V/m²) for a charge density ρ (C/m³). Mirrors `maxwell::gauss_electric_divergence`.
#must_use
#pure
public fn bj_gauss_electric_divergence(charge_density: f64): f64 {
    var d: f64 = charge_density / BJ_EPSILON_0;
    return d;
}

# ∇·B = 0: there are no magnetic monopoles. Mirrors `maxwell::gauss_magnetic_divergence`.
#must_use
#pure
public fn bj_gauss_magnetic_divergence(): f64 {
    var z: f64 = 0.0;
    return z;
}

# J_d = ε₀·∂E/∂t (A/m²). Mirrors `maxwell::displacement_current`.
#must_use
#pure
public fn bj_displacement_current(de_dt: BjFieldVector): BjFieldVector {
    var j: BjFieldVector = de_dt.scale(BJ_EPSILON_0);
    return j;
}

# v = 1/√(εμ) (m/s), correctly rounded (ADR 0002 row 13); 0 for an infinite ε or μ, as Rust's 1/√∞.
# InvalidPermittivity, then InvalidPermeability, for a NaN or non-positive ε or μ. Mirrors `maxwell::wave_speed`.
public fn bj_wave_speed(permittivity: f64, permeability: f64): Result {
    var c = _bj_check_eps_mu(permittivity, permeability);
    if (c != 0) { return Err(c); }
    if (permittivity == _BJ_K_INF || permeability == _BJ_K_INF) { return Ok(0.0); }
    var den: f64[2];
    den[0] = permittivity;
    den[1] = permeability;
    var v: f64 = _bj_cr_sqrt_mono(0, 0, &den, 2);
    return Ok(v);
}

# n = √(ε_r·μ_r), correctly rounded (ADR 0002 row 13); +∞ for an infinite ε_r or μ_r. Errors as wave_speed's.
# Mirrors `maxwell::refractive_index`.
public fn bj_refractive_index(relative_permittivity: f64, relative_permeability: f64): Result {
    var c = _bj_check_eps_mu(relative_permittivity, relative_permeability);
    if (c != 0) { return Err(c); }
    if (relative_permittivity == _BJ_K_INF || relative_permeability == _BJ_K_INF) { return Ok(_BJ_K_INF); }
    var num: f64[2];
    num[0] = relative_permittivity;
    num[1] = relative_permeability;
    var n: f64 = _bj_cr_sqrt_mono(&num, 2, 0, 0);
    return Ok(n);
}

# η = √(μ/ε) (ohms), correctly rounded (ADR 0002 row 13); an infinite ε or μ keeps Rust's √(μ/ε) (+∞, 0, or NaN for
# both). Errors as wave_speed's. Mirrors `maxwell::impedance`.
public fn bj_impedance(permittivity: f64, permeability: f64): Result {
    var c = _bj_check_eps_mu(permittivity, permeability);
    if (c != 0) { return Err(c); }
    if (permittivity == _BJ_K_INF || permeability == _BJ_K_INF) {
        var q: f64 = permeability / permittivity;
        var eta: f64 = f64_sqrt(q);
        return Ok(eta);
    }
    var r: f64 = _bj_k_cr_sqrt_div(permeability, permittivity);   # kimiya's √(x/y): the same bits, faster
    return Ok(r);
}

# η₀ = √(μ₀/ε₀) ≈ 376.73 Ω, correctly rounded (ADR 0002 row 13). Mirrors `maxwell::free_space_impedance`.
#must_use
#pure
public fn bj_free_space_impedance(): f64 {
    var eta: f64 = _bj_k_cr_sqrt_div(BJ_MU_0, BJ_EPSILON_0);
    return eta;
}

# λ = v/f (m). InvalidParameter for a NaN or non-positive frequency, then velocity. Mirrors `maxwell::wavelength`.
public fn bj_wavelength(frequency: f64, velocity: f64): Result {
    var c = _bj_check_positive("frequency", frequency);
    if (c != 0) { return Err(c); }
    c = _bj_check_positive("velocity", velocity);
    if (c != 0) { return Err(c); }
    var l: f64 = velocity / frequency;
    return Ok(l);
}

# f = v/λ (Hz). InvalidParameter for a NaN or non-positive wavelength, then velocity. Mirrors `maxwell::frequency`.
public fn bj_frequency(wavelength_m: f64, velocity: f64): Result {
    var c = _bj_check_positive("wavelength", wavelength_m);
    if (c != 0) { return Err(c); }
    c = _bj_check_positive("velocity", velocity);
    if (c != 0) { return Err(c); }
    var f: f64 = velocity / wavelength_m;
    return Ok(f);
}

# The InvalidParameter "<name> must be positive for skin depth, got <value>", or 0.
fn _bj_check_skin(name, value: f64): i64 {
    if (value != value || value <= 0.0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, name);
        _bj_tx_cstr(t, " must be positive for skin depth, got ");
        _bj_fmt_f64_display(t, value);
        return BJ_ERR_INVALID_PARAMETER;
    }
    return 0;
}

# δ = √(2/(ωμσ)) (m), how far an EM wave reaches into a good conductor (σ ≫ ωε), correctly rounded (ADR 0002 row 13);
# 0 for an infinite ω, μ or σ, as Rust's √(2/∞). InvalidParameter unless ω, μ and σ are each positive (checked in
# that order; NaN refused). Mirrors `maxwell::skin_depth`.
public fn bj_skin_depth(angular_freq: f64, permeability: f64, conductivity: f64): Result {
    var c = _bj_check_skin("angular frequency", angular_freq);
    if (c != 0) { return Err(c); }
    c = _bj_check_skin("permeability", permeability);
    if (c != 0) { return Err(c); }
    c = _bj_check_skin("conductivity", conductivity);
    if (c != 0) { return Err(c); }
    if (angular_freq == _BJ_K_INF || permeability == _BJ_K_INF || conductivity == _BJ_K_INF) { return Ok(0.0); }
    var num: f64[1];
    var den: f64[3];
    num[0] = 2.0;
    den[0] = angular_freq;
    den[1] = permeability;
    den[2] = conductivity;
    var d: f64 = _bj_cr_sqrt_mono(&num, 1, &den, 3);
    return Ok(d);
}

# --- charge.cyr ---

# charge.cyr — point charges, Coulomb's law, the Lorentz force, cyclotron motion (port of rust-old/src/charge.rs,
# M1 part 3d).
#
# SI units: coulombs, newtons, metres, seconds. Every formula is Rust's in Rust's order (the golden rows compare bit for
# bit, class A), but for the three that are one product or quotient of inputs and constants (the Coulomb energy,
# cyclotron frequency and Larmor radius), which are rounded once (ADR 0002 row 13). The constants (BJ_ELEMENTARY_CHARGE,
# BJ_ELECTRON_MASS, BJ_PROTON_MASS) are src/constants.cyr's. Shapes as src/field.cyr's: a `[f64; 3]` is the address of
# three f64; a `Result<FieldVector>` writes through an out pointer; a fallible constructor of a struct over 16 bytes
# writes through `out` too.

private

# A point charge with its position and velocity. Mirrors `charge::PointCharge`; Rust's `[f64; 3]` fields are
# `(f64, f64, f64)` tuples stored inline (`q.position.0` for `q.position[0]`; probe p15), 64 bytes, by value.
public struct BjPointCharge {
    charge: f64;
    mass: f64;
    position: (f64, f64, f64);
    velocity: (f64, f64, f64);
}

# A point charge into out; InvalidParameter when mass is NaN or not positive, out untouched. Mirrors
# `PointCharge::new`.
public fn BjPointCharge_new(charge: f64, mass: f64, position: *f64, velocity: *f64, out: *BjPointCharge): Result {
    if (mass != mass || mass <= 0.0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "mass must be positive, got ");
        _bj_fmt_f64_display(t, mass);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    out.charge = charge;
    out.mass = mass;
    out.position = (position[0], position[1], position[2]);
    out.velocity = (velocity[0], velocity[1], velocity[2]);
    return Ok(0);
}

# A particle of charge q and mass m at rest at `position`.
#must_use
fn _bj_particle_at(q: f64, m: f64, position: *f64): BjPointCharge {
    var p: BjPointCharge;
    p.charge = q;
    p.mass = m;
    p.position = (position[0], position[1], position[2]);
    p.velocity = (0.0, 0.0, 0.0);
    return p;
}

# An electron at rest at `position`: charge −e, the electron mass. Mirrors `PointCharge::electron`.
#must_use
public fn BjPointCharge_electron(position: *f64): BjPointCharge {
    var q: f64 = -BJ_ELEMENTARY_CHARGE;
    var p: BjPointCharge = _bj_particle_at(q, BJ_ELECTRON_MASS, position);
    return p;
}

# A proton at rest at `position`: charge e, the proton mass. Mirrors `PointCharge::proton`.
#must_use
public fn BjPointCharge_proton(position: *f64): BjPointCharge {
    var p: BjPointCharge = _bj_particle_at(BJ_ELEMENTARY_CHARGE, BJ_PROTON_MASS, position);
    return p;
}

# Writes a `(f64, f64, f64)` tuple's elements to p[0..3]: the `[f64; 3]` the field functions take.
fn _bj_tuple3_put(t: (f64, f64, f64), p: *f64): i64 {
    p[0] = t.0;
    p[1] = t.1;
    p[2] = t.2;
    return 0;
}

impl BjPointCharge {
    # E at field_pos from this charge, into out: bj_electric_field_point_charge's value and errors. Mirrors
    # `PointCharge::electric_field_at`.
    public fn electric_field_at(self, field_pos: *f64, out: *BjFieldVector): Result {
        var pos: f64[3];
        _bj_tuple3_put(self.position, &pos);
        return bj_electric_field_point_charge(self.charge, &pos, field_pos, out);
    }

    # V at field_pos from this charge: bj_electric_potential_point_charge's value and errors. Mirrors
    # `PointCharge::electric_potential_at`.
    public fn electric_potential_at(self, field_pos: *f64): Result {
        var pos: f64[3];
        _bj_tuple3_put(self.position, &pos);
        return bj_electric_potential_point_charge(self.charge, &pos, field_pos);
    }

    # B at field_pos from this moving charge (Biot–Savart), into out: bj_magnetic_field_moving_charge's. Mirrors
    # `PointCharge::magnetic_field_at`.
    public fn magnetic_field_at(self, field_pos: *f64, out: *BjFieldVector): Result {
        var pos: f64[3];
        var vel: f64[3];
        _bj_tuple3_put(self.position, &pos);
        _bj_tuple3_put(self.velocity, &vel);
        return bj_magnetic_field_moving_charge(self.charge, &pos, &vel, field_pos, out);
    }

    # The Lorentz force on this charge, moving with its velocity, in fields E and B: bj_lorentz_force's. Mirrors
    # `PointCharge::lorentz_force_in`.
    #must_use
    public fn lorentz_force_in(self, electric_field: BjFieldVector, magnetic_field: BjFieldVector): BjFieldVector {
        var v: BjFieldVector = BjFieldVector_new(self.velocity.0, self.velocity.1, self.velocity.2);
        var f: BjFieldVector = bj_lorentz_force(self.charge, v, electric_field, magnetic_field);
        return f;
    }
}

# F = kq₁q₂/r²·r̂ (N) on q1 from q2, as k·q₁·q₂·(1/r)³ times the offset q1 − q2 (away from q2 when they repel).
# At a range edge with an unbounded exponent, each component rounded once (ADR 0002 row 18). Singularity when the
# exact r² < 10^-30 (row 17). Mirrors `charge::coulomb_force`.
public fn bj_coulomb_force(q1: BjPointCharge, q2: BjPointCharge, out: *BjFieldVector): Result {
    var dx: f64 = q1.position.0 - q2.position.0;
    var dy: f64 = q1.position.1 - q2.position.1;
    var dz: f64 = q1.position.2 - q2.position.2;
    var r_sq: f64 = dx * dx + dy * dy + dz * dz;
    var band = _bj_x_band(r_sq, _BJ_FIELD_R2_MIN);
    if (band == 2) {
        var pa: f64[3];
        var pb: f64[3];
        pa[0] = q1.position.0;
        pa[1] = q1.position.1;
        pa[2] = q1.position.2;
        pb[0] = q2.position.0;
        pb[1] = q2.position.1;
        pb[2] = q2.position.2;
        band = _bj_x_r2_below(&pa, &pb, 30);
    }
    if (band == 1) { return Err(_bj_err_singularity()); }
    var rt: f64 = f64_sqrt(r_sq);
    var inv_r: f64 = 1.0 / rt;
    var kq: f64 = BJ_COULOMB_K * q1.charge;
    var kq2: f64 = kq * q2.charge;
    var factor: f64 = kq2 * inv_r * inv_r * inv_r;
    out.x = factor * dx;
    out.y = factor * dy;
    out.z = factor * dz;
    # k·q₁, k·q₁·q₂ and the factor normal (an overflowed offset makes the factor 0, so r² needs no test of its own).
    var e2 = (load64(&kq) >> 52) & 0x7FF;
    var e3 = (load64(&kq2) >> 52) & 0x7FF;
    var e4 = (load64(&factor) >> 52) & 0x7FF;
    if (((e2 - 2) | (2046 - e2) | (e3 - 2) | (2046 - e3) | (e4 - 2) | (2046 - e4)) >= 0) { return Ok(0); }
    _bj_ch_coulomb_slow(q1, q2, r_sq, kq, kq2, factor, out);
    return Ok(0);
}

# coulomb_force past its fast test, into out (which holds Rust's): Rust's chain stands for a zero charge with r² finite
# or a non-finite input, else the unbounded chain.
fn _bj_ch_coulomb_slow(q1: BjPointCharge, q2: BjPointCharge, r_sq: f64, kq: f64, kq2: f64, factor: f64,
  out: *BjFieldVector) {
    var pa: f64[3];
    var pb: f64[3];
    var p: f64[8];
    pa[0] = q1.position.0;
    pa[1] = q1.position.1;
    pa[2] = q1.position.2;
    pb[0] = q2.position.0;
    pb[1] = q2.position.1;
    pb[2] = q2.position.2;
    p[0] = q1.charge;
    p[1] = q2.charge;
    for (var i = 0; i < 3; i = i + 1) {
        p[2 + i] = pa[i];
        p[5 + i] = pb[i];
    }
    if (_bj_vx_coulomb_plain(r_sq, kq, kq2, factor, q1.charge, q2.charge, &p, 8) == 1) { return 0; }
    _bj_vx_coulomb_edge(BJ_COULOMB_K, q1.charge, q2.charge, &pa, &pb, out);
    return 0;
}

# One component of the Lorentz force, (e + (a·b − c·d))·q, given Rust's s = e + (a·b − c·d): s·q where Rust's chain is
# the unbounded one (s in the band, an exact 0 from exact products, or a part not finite: src/crmath_vx.cyr's guard),
# else the chain with an unbounded exponent and the product by q rounded once.
#must_use
fn _bj_ch_lorentz1(e: f64, a: f64, b: f64, c: f64, d: f64, s: f64, q: f64): f64 {
    var f: f64 = s * q;
    var dq: f64 = (q - q) + (e - e);
    if (_bj_vx_band(s) == 1 || dq != 0.0 || _bj_vx_finite4(a, b, c, d) == 0) { return f; }
    if (s == 0.0) {
        var p: f64 = a * b;
        var r: f64 = c * d;
        if (_bj_vx_exact(a, b, p) == 1 && _bj_vx_exact(c, d, r) == 1) { return f; }
    }
    var vs, ve = _bj_vx_cross1(a, b, c, d);
    var es, ee = _bj_k_ux_from(e);
    var ss, se = _bj_k_ux_add(es, ee, vs, ve);
    var qs, qe = _bj_k_ux_from(q);
    var u: f64 = _bj_k_ux_mul_f64(ss, se, qs, qe);
    return u;
}

# F = q(E + v × B) (N), as (E + v × B)·q; at a range edge (a product past DBL_MAX or below 2^-1022 that the result can
# see) the chain with an unbounded exponent, each product by q rounded once (ADR 0002 row 18). Mirrors
# `charge::lorentz_force`.
#must_use
#pure
public fn bj_lorentz_force(charge: f64, velocity: BjFieldVector, electric_field: BjFieldVector,
  magnetic_field: BjFieldVector): BjFieldVector {
    var v: BjFieldVector = velocity;
    var b: BjFieldVector = magnetic_field;
    var e: BjFieldVector = electric_field;
    var sx: f64 = e.x + (v.y * b.z - v.z * b.y);
    var sy: f64 = e.y + (v.z * b.x - v.x * b.z);
    var sz: f64 = e.z + (v.x * b.y - v.y * b.x);
    var w: BjFieldVector;
    w.x = sx * charge;
    w.y = sy * charge;
    w.z = sz * charge;
    # Each s's biased exponent in [123, 2046] is |s| ∈ [2^-900, DBL_MAX] (src/crmath_vx.cyr's band); q finite.
    var cq: f64 = charge;
    var ex = (load64(&sx) >> 52) & 0x7FF;
    var ey = (load64(&sy) >> 52) & 0x7FF;
    var ez = (load64(&sz) >> 52) & 0x7FF;
    var eq = (load64(&cq) >> 52) & 0x7FF;
    if (((ex - 123) | (ey - 123) | (ez - 123) | (2046 - ex) | (2046 - ey) | (2046 - ez) | (2046 - eq)) >= 0) {
        return w;
    }
    # A component that is 0 through zero factors and a zero E is exact; so is one in the band.
    var hard = 0;
    if (((ex - 123) | (2046 - ex)) < 0 && !(sx == 0.0 && e.x == 0.0 && (v.y == 0.0 || b.z == 0.0) && (v.z == 0.0
          || b.y == 0.0))) { hard = 1; }
    if (((ey - 123) | (2046 - ey)) < 0 && !(sy == 0.0 && e.y == 0.0 && (v.z == 0.0 || b.x == 0.0) && (v.x == 0.0
          || b.z == 0.0))) { hard = 1; }
    if (((ez - 123) | (2046 - ez)) < 0 && !(sz == 0.0 && e.z == 0.0 && (v.x == 0.0 || b.y == 0.0) && (v.y == 0.0
          || b.x == 0.0))) { hard = 1; }
    if (hard == 0 && eq != 2047) { return w; }
    var dq: f64 = charge - charge;
    var dv: f64 = (v.x - v.x) + (v.y - v.y) + (v.z - v.z) + (e.x - e.x) + (e.y - e.y) + (e.z - e.z);
    dv = dv + (b.x - b.x) + (b.y - b.y) + (b.z - b.z) + dq;
    if (dv != 0.0) { return w; }                            # a non-finite part keeps Rust's chain
    var fx: f64 = _bj_ch_lorentz1(e.x, v.y, b.z, v.z, b.y, sx, charge);
    var fy: f64 = _bj_ch_lorentz1(e.y, v.z, b.x, v.x, b.z, sy, charge);
    var fz: f64 = _bj_ch_lorentz1(e.z, v.x, b.y, v.y, b.x, sz, charge);
    w.x = fx;
    w.y = fy;
    w.z = fz;
    return w;
}

# p = qd (C·m). Mirrors `charge::dipole_moment`.
#must_use
#pure
public fn bj_dipole_moment(charge: f64, separation: f64): f64 {
    var p: f64 = charge * separation;
    return p;
}

# U = qV (J). Mirrors `charge::potential_energy`.
#must_use
#pure
public fn bj_potential_energy(charge: f64, potential: f64): f64 {
    var u: f64 = charge * potential;
    return u;
}

# U = kq₁q₂/r (J), correctly rounded (ADR 0002 row 13; an infinite or NaN operand keeps Rust's (k·q₁·q₂)/r).
# InvalidParameter when r is NaN or negative, Singularity below 1e-30 m (field.rs's check_radial_distance). Mirrors
# `charge::coulomb_potential_energy`.
public fn bj_coulomb_potential_energy(q1: f64, q2: f64, distance: f64): Result {
    var t, v = _bj_check_radial_distance(distance);
    if (is_err_result(t) == 1) { return Err(v); }
    if (_bj_is_finite(q1) == 0 || _bj_is_finite(q2) == 0 || _bj_is_finite(distance) == 0) {
        var u: f64 = BJ_COULOMB_K * q1 * q2 / distance;
        return Ok(u);
    }
    var cr: f64 = _bj_k_cr_mul3_div(BJ_COULOMB_K, q1, q2, distance);
    return Ok(cr);
}

# A particle mass's error for `what`: DivisionByZero "mass cannot be zero for <what>" for 0, InvalidParameter "mass
# must be positive for <what>, got <mass>" for NaN or negative; else 0. Mirrors charge.rs's private `check_mass`.
fn _bj_check_mass(mass: f64, what): i64 {
    if (mass == 0.0) {
        var t = _bj_err_reason(BJ_ERR_DIVISION_BY_ZERO);
        _bj_tx_cstr(t, "mass cannot be zero for ");
        _bj_tx_cstr(t, what);
        return BJ_ERR_DIVISION_BY_ZERO;
    }
    if (mass != mass || mass <= 0.0) {
        var t2 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t2, "mass must be positive for ");
        _bj_tx_cstr(t2, what);
        _bj_tx_cstr(t2, ", got ");
        _bj_fmt_f64_display(t2, mass);
        return BJ_ERR_INVALID_PARAMETER;
    }
    return 0;
}

# ω_c = |q|B/m (rad/s) for |B| ≥ 0 (T), correctly rounded (ADR 0002 row 13; an infinite operand keeps Rust's
# (|q|·B)/m). DivisionByZero for a zero mass; InvalidParameter for a negative mass, a NaN
# charge, or a negative or NaN |B| (in that order). Mirrors `charge::cyclotron_frequency`.
public fn bj_cyclotron_frequency(charge: f64, mass: f64, b_magnitude: f64): Result {
    var c = _bj_check_mass(mass, "cyclotron frequency");
    if (c != 0) { return Err(c); }
    if (charge != charge) { return Err(_bj_err_invalid_parameter("charge must not be NaN")); }
    if (b_magnitude != b_magnitude || b_magnitude < 0.0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "|B| must be non-negative, got ");
        _bj_fmt_f64_display(t, b_magnitude);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var aq: f64 = f64_abs(charge);
    if (_bj_is_finite(aq) == 0 || _bj_is_finite(b_magnitude) == 0 || _bj_is_finite(mass) == 0) {
        var w: f64 = aq * b_magnitude / mass;
        return Ok(w);
    }
    var cr: f64 = _bj_k_cr_mul_div(aq, b_magnitude, mass);
    return Ok(cr);
}

# r_L = m|v⊥|/(|q|B) (m) for |B| > 0, correctly rounded (ADR 0002 row 13: Rust divides in two steps, m·|v⊥|/|q|/B,
# so a tiny |q|·B can't underflow, but m·|v⊥| still can; an infinite operand keeps that chain). DivisionByZero for a
# zero mass, charge or |B|; InvalidParameter for a negative mass or |B|, or a NaN argument (in Rust's order). Mirrors
# `charge::larmor_radius`.
public fn bj_larmor_radius(mass: f64, v_perp: f64, charge: f64, b_magnitude: f64): Result {
    var c = _bj_check_mass(mass, "Larmor radius");
    if (c != 0) { return Err(c); }
    if (v_perp != v_perp || charge != charge) {
        return Err(_bj_err_invalid_parameter("v_perp and charge must not be NaN"));
    }
    if (charge == 0.0) { return Err(_bj_err_division_by_zero("charge cannot be zero for Larmor radius")); }
    if (b_magnitude == 0.0) { return Err(_bj_err_division_by_zero("|B| cannot be zero for Larmor radius")); }
    if (b_magnitude != b_magnitude || b_magnitude <= 0.0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "|B| must be positive, got ");
        _bj_fmt_f64_display(t, b_magnitude);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var av: f64 = f64_abs(v_perp);
    var aq: f64 = f64_abs(charge);
    var fin = _bj_is_finite(mass) + _bj_is_finite(av) + _bj_is_finite(aq) + _bj_is_finite(b_magnitude);
    if (fin != 4) {
        var r: f64 = mass * av / aq / b_magnitude;
        return Ok(r);
    }
    var cr: f64 = _bj_k_cr_mul2_div2(mass, av, aq, b_magnitude);
    return Ok(cr);
}

# --- json.cyr ---

# json.cyr — JSON for M1's serializable types: BjComplex (Rust hisab 1.4.0's `Complex`), BjFieldVector and
# BjPointCharge, as serde_json 1.0.154 writes and reads them (port plan D5, M1 part 4; ADR 0002 rows 10–12).
#
# Writers append serde's document to a `str_builder`: the fields in Rust declaration order, no spaces, a `[f64; 3]`
# as an array, every f64 through bayan's printer (`bayan_f64_to_json`, the printer `#derive(Serialize)` uses): the
# shortest round-trip digits, `null` for NaN and ±∞ as serde_json writes them. The notation is bayan's, not ryu's
# (`10000000000000000.0` where serde_json writes `1e16`); each parses to the same bits, which is what the golden rows
# compare (D5). The document is built on the stack and appended in one grow, so a refused allocation leaves the
# builder as it was and returns BJ_ERR_ALLOCATION (the builder's own grow would exit the process). Hand-written, not
# derived: on cyrius 6.7.18 a `#derive(Serialize)` in a second `private` file fails to compile (the derive's shared
# helper is private to the first one), and the derive would export its scanner decoders as bijli API (probe p16).
#
# Readers parse the text with bayan's value tree and apply serde's derive semantics:
# - a struct reads from an object, by field name, or from an array, by position (serde's sequence form), which must
#   hold exactly its fields; a `[f64; 3]` reads from an array of exactly three numbers;
# - a field missing, a value of the wrong JSON type, or an array of the wrong length is BJ_ERR_DESERIALIZE;
# - unknown fields are ignored, whatever their value (it must still be valid JSON);
# - an f64 takes any JSON number, correctly rounded (ADR 0002 row 11: serde_json's default parse is best-effort, and
#   the golden rows compare against the correctly rounded value), and never `null` (serde_json writes NaN and ±∞ as
#   `null` and can't read them back, nor can the port); a number whose correctly rounded value overflows is refused,
#   as serde_json refuses `1e400`;
# - the whole document is checked, unknown values included (ADR 0002 row 12): a key repeated in any object, a lone
#   surrogate escape in any string, or containers nested past 128 levels refuse it. serde_json checks only what it
#   deserializes: it refuses those in the struct's own fields and keys, and skips an unknown value unchecked;
# - a mass that `BjPointCharge_new` would refuse is read as written: Rust's fields are public, and the readers read
#   back every document the writers write.
# Where bayan reads the text otherwise than serde_json, one pass before bayan sees it puts that right: the integer
# `-0` (an integer 0 in bayan's tree, so an f64 field would lose the sign; serde_json reads -0.0) and an integer
# outside i64 (refused by bayan; a number to serde_json) each get `.0` appended, which bayan reads as a float,
# correctly rounded; a raw control character in a string (taken by bayan; refused by serde_json and RFC 8259 §7) and
# bytes that are not UTF-8 in a string (which a Rust `&str` can't hold) refuse the document. A document with no such
# integer is parsed in place.
#
# A failed read fills the calling thread's last-error record: BJ_ERR_DESERIALIZE, Display
# `deserialization failed: <reason>`, with serde's wording where it applies (`missing field `y``) and bayan's for a
# syntax error, at its byte offset in the caller's text. `out` is written only on success.
#
# Memory. Every node of the tree comes from a decode region on the reader's stack: freelist chunks, chained and given
# back when the read ends, so a read leaves the heap as it found it (nothing on the bump heap) and two threads reading
# at once share nothing.

private

# ── writers ─────────────────────────────────────────────────────────────────────────

# Appends the C string s at buf + n; the new length.
fn _bj_jw_cstr(buf, n, s): i64 {
    var k = strlen(s);
    memcpy(buf + n, s, k);
    return n + k;
}

# Appends the f64 with bits x in bayan's JSON form (at most 25 bytes; `null` for NaN and ±∞); the new length.
fn _bj_jw_f64(buf, n, x): i64 {
    return n + bayan_f64_to_json(x, buf + n);
}

# Appends `[a,b,c]` for the three f64 at p; the new length.
fn _bj_jw_triple(buf, n, a, b, c): i64 {
    var m = n;
    store8(buf + m, 91);
    m = _bj_jw_f64(buf, m + 1, a);
    store8(buf + m, 44);
    m = _bj_jw_f64(buf, m + 1, b);
    store8(buf + m, 44);
    m = _bj_jw_f64(buf, m + 1, c);
    store8(buf + m, 93);
    return m + 1;
}

# Appends the document [buf, buf + n) to the builder sb in one grow: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it
# was.
#must_use
fn _bj_jw_put(sb, buf, n): Result {
    store8(buf + n, 0);
    if (str_builder_add_cstr_a(default_alloc(), sb, buf) != 0) {
        var t = _bj_err_reason(BJ_ERR_ALLOCATION);
        _bj_tx_cstr(t, "the JSON document's builder can't grow");
        return Err(BJ_ERR_ALLOCATION);
    }
    return Ok(0);
}

# Appends `{"re":<re>,"im":<im>}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors
# `serde_json::to_string(&c)` for Rust hisab's `Complex`.
#must_use
public fn BjComplex_to_json(c: *BjComplex, sb): Result {
    var buf[80];
    var n = _bj_jw_cstr(&buf, 0, "{\"re\":");
    n = _bj_jw_f64(&buf, n, c.re);
    n = _bj_jw_cstr(&buf, n, ",\"im\":");
    n = _bj_jw_f64(&buf, n, c.im);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"x":<x>,"y":<y>,"z":<z>}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors
# `serde_json::to_string(&v)` for `field::FieldVector`.
#must_use
public fn BjFieldVector_to_json(v: *BjFieldVector, sb): Result {
    var buf[112];
    var n = _bj_jw_cstr(&buf, 0, "{\"x\":");
    n = _bj_jw_f64(&buf, n, v.x);
    n = _bj_jw_cstr(&buf, n, ",\"y\":");
    n = _bj_jw_f64(&buf, n, v.y);
    n = _bj_jw_cstr(&buf, n, ",\"z\":");
    n = _bj_jw_f64(&buf, n, v.z);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"charge":<q>,"mass":<m>,"position":[<x>,<y>,<z>],"velocity":[<vx>,<vy>,<vz>]}` to the builder sb: Ok(0),
# or Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors `serde_json::to_string(&p)` for `charge::PointCharge`.
#must_use
public fn BjPointCharge_to_json(p: *BjPointCharge, sb): Result {
    var buf[320];
    var n = _bj_jw_cstr(&buf, 0, "{\"charge\":");
    n = _bj_jw_f64(&buf, n, p.charge);
    n = _bj_jw_cstr(&buf, n, ",\"mass\":");
    n = _bj_jw_f64(&buf, n, p.mass);
    n = _bj_jw_cstr(&buf, n, ",\"position\":");
    var x: f64 = p.position.0;
    var y: f64 = p.position.1;
    var z: f64 = p.position.2;
    n = _bj_jw_triple(&buf, n, x, y, z);
    n = _bj_jw_cstr(&buf, n, ",\"velocity\":");
    var vx: f64 = p.velocity.0;
    var vy: f64 = p.velocity.1;
    var vz: f64 = p.velocity.2;
    n = _bj_jw_triple(&buf, n, vx, vy, vz);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# ── the decode region ───────────────────────────────────────────────────────────────
# A region on the reader's stack, 64 bytes: +0 the chunk chain (each chunk's first word links the next), +8 the next
# free byte, +16 the current chunk's end, +24 the 40-byte allocator bayan calls (lib/alloc.cyr's vtable: alloc,
# realloc, free, reset, state). Chunks are freelist blocks of one 4,096-byte class; a request larger than a chunk
# gets a block of its own. Nothing is freed before the read ends, when _bj_jr_close gives every chunk back.

const _BJ_JR_REGION = 64;
const _BJ_JR_CHUNK = 4080;

# A block of `size` bytes, 16-byte aligned, or 0 when the freelist refuses.
fn _bj_jr_alloc(st, size): i64 {
    var n = (size + 15) & (0 - 16);
    if (n <= 0) { n = 16; }
    var cur = load64(st + 8);
    if (cur != 0 && cur + n <= load64(st + 16)) {
        store64(st + 8, cur + n);
        return cur;
    }
    var cap = _BJ_JR_CHUNK - 16;
    var own = 0;
    if (n > cap) {
        cap = n;
        own = 1;
    }
    var c = fl_alloc(cap + 16);
    if (c == 0) { return 0; }
    store64(c, load64(st));
    store64(st, c);
    if (own == 0) {
        store64(st + 8, c + 16 + n);
        store64(st + 16, c + 16 + cap);
    }
    return c + 16;
}

# A block of new_size bytes holding the first min(old_size, new_size) bytes at old, or 0.
fn _bj_jr_realloc(st, old, old_size, new_size): i64 {
    var p = _bj_jr_alloc(st, new_size);
    if (p == 0) { return 0; }
    var k = old_size;
    if (new_size < k) { k = new_size; }
    if (old != 0 && k > 0) { memcpy(p, old, k); }
    return p;
}

# A block is freed with its region.
fn _bj_jr_free(st, p): i64 {
    return 0;
}

# Gives every chunk back; the region is empty and usable again.
fn _bj_jr_reset(st): i64 {
    var c = load64(st);
    while (c != 0) {
        var next = load64(c);
        fl_free(c);
        c = next;
    }
    store64(st, 0);
    store64(st + 8, 0);
    store64(st + 16, 0);
    return 0;
}

# Makes the region at rg empty; its allocator is rg + 24.
fn _bj_jr_open(rg): i64 {
    store64(rg, 0);
    store64(rg + 8, 0);
    store64(rg + 16, 0);
    store64(rg + 24, &_bj_jr_alloc);
    store64(rg + 32, &_bj_jr_realloc);
    store64(rg + 40, &_bj_jr_free);
    store64(rg + 48, &_bj_jr_reset);
    store64(rg + 56, rg);
    return rg + 24;
}

# Gives the region's memory back.
fn _bj_jr_close(rg): i64 {
    return _bj_jr_reset(rg);
}

# ── the document ────────────────────────────────────────────────────────────────────

# 1 when the integer token [p, p + n), its digits from offset ds, is one bayan reads otherwise than serde_json: `-0`,
# or a magnitude outside i64 (more than 19 digits, or 19 above i64's bound; leading zeros, which both refuse, count
# as digits).
#must_use
fn _bj_jr_int_odd(p, n, ds): i64 {
    if (n == 2 && load8(p) == 45 && load8(p + 1) == 48) { return 1; }
    var digits = n - ds;
    if (digits < 19) { return 0; }
    if (digits > 19) { return 1; }
    var bound = "9223372036854775807";
    if (ds == 1) { bound = "9223372036854775808"; }
    for (var k = 0; k < 19; k = k + 1) {
        var d = load8(p + ds + k);
        var b = load8(bound + k);
        if (d < b) { return 0; }
        if (d > b) { return 1; }
    }
    return 0;
}

# The length of the well-formed UTF-8 sequence (RFC 3629: no overlong form, no surrogate, nothing past U+10FFFF) at
# p, whose first byte is 0x80 or above and which has n bytes left, or 0.
#must_use
fn _bj_jr_utf8(p, n): i64 {
    var b0 = load8(p);
    var need = 0;
    var lo = 128;
    var hi = 191;
    if (b0 >= 194 && b0 <= 223) { need = 1; }
    elif (b0 == 224) {
        need = 2;
        lo = 160;
    } elif (b0 >= 225 && b0 <= 236) { need = 2; }
    elif (b0 == 237) {
        need = 2;
        hi = 159;
    } elif (b0 >= 238 && b0 <= 239) { need = 2; }
    elif (b0 == 240) {
        need = 3;
        lo = 144;
    } elif (b0 >= 241 && b0 <= 243) { need = 3; }
    elif (b0 == 244) {
        need = 3;
        hi = 143;
    } else { return 0; }
    if (need >= n) { return 0; }
    var b1 = load8(p + 1);
    if (b1 < lo || b1 > hi) { return 0; }
    for (var k = 2; k <= need; k = k + 1) {
        var b = load8(p + k);
        if (b < 128 || b > 191) { return 0; }
    }
    return need + 1;
}

# Notes the defect `msg` at byte `pos` in flaw[0..2] (its offset, its message), unless an earlier one is noted.
fn _bj_jr_flaw(flaw, pos, msg) {
    if (load64(flaw) < 0) {
        store64(flaw, pos);
        store64(flaw + 8, msg);
    }
    return 0;
}

# One read-only pass over the JSON text [buf, buf + len) for what bayan's tree reads otherwise than serde_json:
# - the integer tokens outside strings that _bj_jr_int_odd names: their count is returned, and when `ends` is not 0
#   each one's end offset goes to ends[0..] (a number with a fraction or an exponent is bayan's to read as it is);
# - inside strings, a raw control character (U+0000..U+001F, which RFC 8259 §7 and serde_json refuse and bayan
#   takes) or bytes that are not UTF-8 (which a Rust `&str` can't hold): the first is noted in flaw[0..2].
# On a malformed document the pass may misread where strings are, but `.0` after a run of digits can't make a
# malformed document well formed, and bayan's own error comes first when it is earlier in the text.
fn _bj_jr_scan(buf, len, ends, flaw): i64 {
    var count = 0;
    var i = 0;
    while (i < len) {
        var c = load8(buf + i);
        if (c == 34) {
            i = i + 1;
            while (i < len) {
                var d = load8(buf + i);
                if (d == 34) { break; }
                if (d == 92) { i = i + 2; }
                elif (d < 32) {
                    _bj_jr_flaw(flaw, i, "a control character (U+0000..U+001F) in a string");
                    i = i + 1;
                } elif (d < 128) { i = i + 1; }
                else {
                    var u = _bj_jr_utf8(buf + i, len - i);
                    if (u == 0) {
                        _bj_jr_flaw(flaw, i, "invalid UTF-8 in a string");
                        u = 1;
                    }
                    i = i + u;
                }
            }
            i = i + 1;
        } elif (c == 45 || (c >= 48 && c <= 57)) {
            var s = i;
            if (c == 45) { i = i + 1; }
            var ds = i - s;
            while (i < len && load8(buf + i) >= 48 && load8(buf + i) <= 57) { i = i + 1; }
            var e = i;
            var g = 0;
            if (i < len) { g = load8(buf + i); }
            if (g == 46 || g == 101 || g == 69) {
                while (i < len) {
                    var h = load8(buf + i);
                    if ((h >= 48 && h <= 57) || h == 46 || h == 101 || h == 69 || h == 43 || h == 45) { i = i + 1; }
                    else { break; }
                }
            } elif (e > s + ds && _bj_jr_int_odd(buf + s, e - s, ds) == 1) {
                if (ends != 0) { store64(ends + count * 8, e); }
                count = count + 1;
            }
        } else {
            i = i + 1;
        }
    }
    return count;
}

# Records a syntax error: bayan's message at byte `pos` of the caller's text. Returns BJ_ERR_DESERIALIZE.
fn _bj_jr_syntax(msg, pos): i64 {
    var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
    _bj_tx_cstr(t, msg);
    _bj_tx_cstr(t, " at byte ");
    _bj_tx_i64(t, pos);
    return BJ_ERR_DESERIALIZE;
}

# The value tree of the JSON text [buf, buf + len), on the region whose allocator is `a`, or 0 with the error
# recorded (BJ_ERR_DESERIALIZE; BJ_ERR_ALLOCATION when the region can't grow). Of a string defect the scan noted and
# bayan's own error, the earlier in the text is reported.
fn _bj_jr_doc(a, buf, len): i64 {
    if (buf == 0 || len < 0) {
        _bj_jr_syntax("no document", 0);
        return 0;
    }
    var flaw: i64[2];
    flaw[0] = 0 - 1;
    flaw[1] = 0;
    var text = buf;
    var tlen = len;
    var ends = 0;
    var odd = _bj_jr_scan(buf, len, 0, &flaw);
    if (odd > 0) {
        ends = alloc_via(a, odd * 8);
        tlen = len + odd * 2;
        text = alloc_via(a, tlen);
        if (ends == 0 || text == 0) {
            var t = _bj_err_reason(BJ_ERR_ALLOCATION);
            _bj_tx_cstr(t, "the JSON reader's decode region can't grow");
            return 0;
        }
        _bj_jr_scan(buf, len, ends, &flaw);
        var from = 0;
        var to = 0;
        for (var k = 0; k < odd; k = k + 1) {
            var e = load64(ends + k * 8);
            memcpy(text + to, buf + from, e - from);
            to = to + e - from;
            store8(text + to, 46);
            store8(text + to + 1, 48);
            to = to + 2;
            from = e;
        }
        memcpy(text + to, buf + from, len - from);
    }
    var ps[48];
    var v = bayan_json_v_parse_ctx_a(a, &ps, text, tlen);
    if (v != 0) {
        if (flaw[0] < 0) { return v; }
        _bj_jr_syntax(flaw[1], flaw[0]);
        return 0;
    }
    var msg = bayan_json_state_error(&ps);
    var pos = bayan_json_state_error_pos(&ps);
    # A position in the rewritten text, back in the caller's: two bytes fewer for each `.0` before it.
    if (odd > 0) {
        var shift = 0;
        for (var j = 0; j < odd; j = j + 1) {
            if (load64(ends + j * 8) + shift + 2 <= pos) { shift = shift + 2; }
        }
        pos = pos - shift;
    }
    if (_bj_jr_starts(msg, "out of memory") == 1) {
        var t2 = _bj_err_reason(BJ_ERR_ALLOCATION);
        _bj_tx_cstr(t2, "the JSON reader's decode region can't grow");
        return 0;
    }
    if (flaw[0] >= 0 && flaw[0] < pos) {
        _bj_jr_syntax(flaw[1], flaw[0]);
        return 0;
    }
    _bj_jr_syntax(msg, pos);
    return 0;
}

# 1 when the C string s starts with the C string p.
#must_use
fn _bj_jr_starts(s, p): i64 {
    var k = 0;
    while (load8(p + k) != 0) {
        if (load8(s + k) != load8(p + k)) { return 0; }
        k = k + 1;
    }
    return 1;
}

# ── values ──────────────────────────────────────────────────────────────────────────

# serde's name for the JSON type of node v, as its "invalid type" message gives it.
#must_use
fn _bj_jr_kind(v): i64 {
    var tag = bayan_json_v_tag(v);
    if (tag == JTAG_NULL) { return "null"; }
    if (tag == JTAG_BOOL) { return "boolean"; }
    if (tag == JTAG_INT) { return "integer"; }
    if (tag == JTAG_FLOAT) { return "floating point"; }
    if (tag == JTAG_STR) { return "string"; }
    if (tag == JTAG_ARR) { return "sequence"; }
    return "map";
}

# Records `invalid type: <kind of v>, expected <what>`. Returns BJ_ERR_DESERIALIZE.
fn _bj_jr_type(v, what): i64 {
    var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
    _bj_tx_cstr(t, "invalid type: ");
    _bj_tx_cstr(t, _bj_jr_kind(v));
    _bj_tx_cstr(t, ", expected ");
    _bj_tx_cstr(t, what);
    return BJ_ERR_DESERIALIZE;
}

# Records `invalid length <n>, expected <what>`. Returns BJ_ERR_DESERIALIZE.
fn _bj_jr_length(n, what): i64 {
    var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
    _bj_tx_cstr(t, "invalid length ");
    _bj_tx_i64(t, n);
    _bj_tx_cstr(t, ", expected ");
    _bj_tx_cstr(t, what);
    return BJ_ERR_DESERIALIZE;
}

# Records `missing field `<name>``. Returns BJ_ERR_DESERIALIZE.
fn _bj_jr_missing(name): i64 {
    var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
    _bj_tx_cstr(t, "missing field `");
    _bj_tx_cstr(t, name);
    _bj_tx_putc(t, 96);
    return BJ_ERR_DESERIALIZE;
}

# Node v as an f64 into *out: 0, or BJ_ERR_DESERIALIZE recorded. An integer converts to the nearest f64 (exact below
# 2^53, as serde's `n as f64`); a float is bayan's correctly rounded parse, refused when it overflowed.
fn _bj_jr_f64(v, out): i64 {
    var tag = bayan_json_v_tag(v);
    if (tag != JTAG_INT && tag != JTAG_FLOAT) { return _bj_jr_type(v, "f64"); }
    var bits = bayan_json_v_float(v);
    if ((bits & 0x7FF0000000000000) == 0x7FF0000000000000) {
        var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
        _bj_tx_cstr(t, "number out of range");
        return BJ_ERR_DESERIALIZE;
    }
    store64(out, bits);
    return 0;
}

# Node v as a `[f64; 3]` into out[0..3]: an array of exactly three numbers. 0, or BJ_ERR_DESERIALIZE recorded.
fn _bj_jr_f64x3(v, out): i64 {
    if (bayan_json_v_tag(v) != JTAG_ARR) { return _bj_jr_type(v, "an array of length 3"); }
    var n = bayan_json_v_arr_len(v);
    if (n != 3) { return _bj_jr_length(n, "an array of length 3"); }
    for (var k = 0; k < 3; k = k + 1) {
        var c = _bj_jr_f64(bayan_json_v_arr_get(v, k), out + k * 8);
        if (c != 0) { return c; }
    }
    return 0;
}

# The form of struct node v with n fields: 1 an object, 2 an array of exactly n elements (serde's sequence form), or
# 0 with BJ_ERR_DESERIALIZE recorded (`what` names the struct: "struct FieldVector").
fn _bj_jr_form(v, n, what): i64 {
    var tag = bayan_json_v_tag(v);
    if (tag == JTAG_OBJ) { return 1; }
    if (tag != JTAG_ARR) {
        _bj_jr_type(v, what);
        return 0;
    }
    var k = bayan_json_v_arr_len(v);
    if (k != n) {
        var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
        _bj_tx_cstr(t, "invalid length ");
        _bj_tx_i64(t, k);
        _bj_tx_cstr(t, ", expected ");
        _bj_tx_cstr(t, what);
        _bj_tx_cstr(t, " with ");
        _bj_tx_i64(t, n);
        _bj_tx_cstr(t, " elements");
        return 0;
    }
    return 2;
}

# Field i, named `name`, of struct node v in `form`: its node, or 0 with `missing field` recorded.
fn _bj_jr_field(v, form, i, name): i64 {
    var f = 0;
    if (form == 1) { f = bayan_json_v_obj_get_by_cstr(v, name); }
    else { f = bayan_json_v_arr_get(v, i); }
    if (f == 0) { _bj_jr_missing(name); }
    return f;
}

# Struct node v whose n fields, named names[0..n], are all f64, into out[0..n]. 0, or the code recorded.
fn _bj_jr_f64_struct(v, names, n, what, out): i64 {
    var form = _bj_jr_form(v, n, what);
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    for (var k = 0; k < n; k = k + 1) {
        var f = _bj_jr_field(v, form, k, load64(names + k * 8));
        if (f == 0) { return BJ_ERR_DESERIALIZE; }
        var c = _bj_jr_f64(f, out + k * 8);
        if (c != 0) { return c; }
    }
    return 0;
}

# Reads the document [buf, buf + len) with decoder `dec(node, words)` into the n words at w: 0, or the code recorded.
fn _bj_jr_read(buf, len, dec, w): i64 {
    var rg[64];
    var a = _bj_jr_open(&rg);
    var code = BJ_ERR_DESERIALIZE;
    var v = _bj_jr_doc(a, buf, len);
    if (v != 0) { code = fncall2(dec, v, w); }
    else { code = bj_last_error(); }
    _bj_jr_close(&rg);
    return code;
}

# The decoders, each from a node into words.
fn _bj_jr_complex(v, w): i64 {
    var names: i64[2];
    names[0] = "re";
    names[1] = "im";
    return _bj_jr_f64_struct(v, &names, 2, "struct Complex", w);
}

fn _bj_jr_field_vector(v, w): i64 {
    var names: i64[3];
    names[0] = "x";
    names[1] = "y";
    names[2] = "z";
    return _bj_jr_f64_struct(v, &names, 3, "struct FieldVector", w);
}

fn _bj_jr_point_charge(v, w): i64 {
    var form = _bj_jr_form(v, 4, "struct PointCharge");
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    var f = _bj_jr_field(v, form, 0, "charge");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    var c = _bj_jr_f64(f, w);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 1, "mass");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    c = _bj_jr_f64(f, w + 8);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 2, "position");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    c = _bj_jr_f64x3(f, w + 16);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 3, "velocity");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    return _bj_jr_f64x3(f, w + 40);
}

# ── readers ─────────────────────────────────────────────────────────────────────────

# Reads a `Complex` document from [buf, buf + len) into *out: Ok(0), or Err(BJ_ERR_DESERIALIZE) (BJ_ERR_ALLOCATION
# when the decode region can't grow) with the reason recorded and out untouched. Mirrors
# `serde_json::from_str::<Complex>` for Rust hisab's `Complex`.
#must_use
public fn BjComplex_from_json(buf, len, out: *BjComplex): Result {
    var w: f64[2];
    var code = _bj_jr_read(buf, len, &_bj_jr_complex, &w);
    if (code != 0) { return Err(code); }
    out.re = w[0];
    out.im = w[1];
    return Ok(0);
}

# Reads a `FieldVector` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched,
# as BjComplex_from_json. Mirrors `serde_json::from_str::<FieldVector>`.
#must_use
public fn BjFieldVector_from_json(buf, len, out: *BjFieldVector): Result {
    var w: f64[3];
    var code = _bj_jr_read(buf, len, &_bj_jr_field_vector, &w);
    if (code != 0) { return Err(code); }
    out.x = w[0];
    out.y = w[1];
    out.z = w[2];
    return Ok(0);
}

# Reads a `PointCharge` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched,
# as BjComplex_from_json. Mirrors `serde_json::from_str::<PointCharge>`.
#must_use
public fn BjPointCharge_from_json(buf, len, out: *BjPointCharge): Result {
    var w: f64[8];
    var code = _bj_jr_read(buf, len, &_bj_jr_point_charge, &w);
    if (code != 0) { return Err(code); }
    out.charge = w[0];
    out.mass = w[1];
    out.position = (w[2], w[3], w[4]);
    out.velocity = (w[5], w[6], w[7]);
    return Ok(0);
}
