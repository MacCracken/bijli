}

# RN(x·y·z/(v·w)) by its fast path: N as in _bj_k_mul3_fast (within 3.01u², in [1, 8)), D = s_vs_w an exact TwoProduct,
# F in (⅛, 8) by _bj_k_dd_div_ends; a failed test falls back.
#must_use
fn _bj_k_mul3_div2_fast(x: f64, y: f64, z: f64, v: f64, w: f64): (f64, i64) {
    var bx = load64(&x);
    var by = load64(&y);
    var bz = load64(&z);
    var bv = load64(&v);
    var bw = load64(&w);
    var neg = (bx ^ by ^ bz ^ bv ^ bw) >> 63;
    var abs = 0x7FFFFFFFFFFFFFFF;
    var ax = bx & abs;
    var ay = by & abs;
    var az = bz & abs;
    var av = bv & abs;
    var aw = bw & abs;
    var nmin = 0x0010000000000000;
    var nmax = 0x7FF0000000000000;
    if (ax < nmin || ay < nmin || az < nmin || av < nmin || aw < nmin) { return (0.0, 0); }
    if (ax >= nmax || ay >= nmax || az >= nmax || av >= nmax || aw >= nmax) { return (0.0, 0); }
    var k = (ax >> 52) + (ay >> 52) + (az >> 52) - (av >> 52) - (aw >> 52) - 1023;   # eₓ + e_y + e_z − e_v − e_w
    var mask = 0x000FFFFFFFFFFFFF;
    var one = 0x3FF0000000000000;
    var sxb = (ax & mask) | one;
    var syb = (ay & mask) | one;
    var szb = (az & mask) | one;
    var svb = (av & mask) | one;
    var swb = (aw & mask) | one;
    var sx: f64 = sxb;
    var sy: f64 = syb;
    var sz: f64 = szb;
    var sv: f64 = svb;
    var sw: f64 = swb;
    var ph, pl = _bj_k_two_prod(sx, sy);
    var h, l = _bj_k_dd_mul_d(ph, pl, sz);
    var dh, dl = _bj_k_two_prod(sv, sw);
    var z1, z2 = _bj_k_dd_div_ends(h, l, dh, dl);
    if (z1 != z2) { return (0.0, 0); }
    var r, ok = _bj_k_mono_fin(z1, k, neg);
    return (r, ok);
}

# RN(x·y·z/(v·w)), correctly rounded: faraday_mass_ratio's m_A·M_B·n_A/(n_B·M_A) (#29). A midpoint the fast path leaves
# is _bj_k_cr_mono's (its 3/2 tie resolution).
#must_use
fn _bj_k_cr_mul3_div2(x: f64, y: f64, z: f64, v: f64, w: f64): f64 {
    var r, ok = _bj_k_mul3_div2_fast(x, y, z, v, w);
    if (ok == 1) { return r; }
    var nb: f64[3];
    store64(&nb, x);
    store64(&nb + 8, y);
    store64(&nb + 16, z);
    var db: f64[2];
    store64(&db, v);
    store64(&db + 8, w);
    var g: f64 = _bj_k_cr_mono(&nb, 3, &db, 2);
    return g;
}

# RN(a·b·c·d) by its fast path: the exact TwoProduct s_a·s_b, then _bj_k_dd_mul_d by s_c and s_d (within
# 2·3.01u²·(1 + 2⁻⁵⁰) < 6.1u², N in [1, 16)), rounded by _bj_k_dd_round_ends; a failed test falls back.
#must_use
fn _bj_k_mul4_fast(a: f64, b: f64, c: f64, d: f64): (f64, i64) {
    var ba = load64(&a);
    var bb = load64(&b);
    var bc = load64(&c);
    var bd = load64(&d);
    var neg = (ba ^ bb ^ bc ^ bd) >> 63;
    var abs = 0x7FFFFFFFFFFFFFFF;
    var aa = ba & abs;
    var ab = bb & abs;
    var ac = bc & abs;
    var ad = bd & abs;
    var nmin = 0x0010000000000000;
    var nmax = 0x7FF0000000000000;
    if (aa < nmin || ab < nmin || ac < nmin || ad < nmin) { return (0.0, 0); }
    if (aa >= nmax || ab >= nmax || ac >= nmax || ad >= nmax) { return (0.0, 0); }
    var k = (aa >> 52) + (ab >> 52) + (ac >> 52) + (ad >> 52) - 4092;   # e_a + e_b + e_c + e_d
    var mask = 0x000FFFFFFFFFFFFF;
    var one = 0x3FF0000000000000;
    var sab = (aa & mask) | one;
    var sbb = (ab & mask) | one;
    var scb = (ac & mask) | one;
    var sdb = (ad & mask) | one;
    var sa: f64 = sab;
    var sb: f64 = sbb;
    var sc: f64 = scb;
    var sd: f64 = sdb;
    var ph, pl = _bj_k_two_prod(sa, sb);
    var h1, l1 = _bj_k_dd_mul_d(ph, pl, sc);
    var h2, l2 = _bj_k_dd_mul_d(h1, l1, sd);
    var z1, z2 = _bj_k_dd_round_ends(h2, l2);
    if (z1 != z2) { return (0.0, 0); }
    var r, ok = _bj_k_mono_fin(z1, k, neg);
    return (r, ok);
}

# RN(a·b·c·d), correctly rounded: rigid_rotor_energy's h·B·J·(J + 1) (#30).
#must_use
fn _bj_k_cr_mul4(a: f64, b: f64, c: f64, d: f64): f64 {
    var r, ok = _bj_k_mul4_fast(a, b, c, d);
    if (ok == 1) { return r; }
    var nb: f64[4];
    store64(&nb, a);
    store64(&nb + 8, b);
    store64(&nb + 16, c);
    store64(&nb + 24, d);
    var g: f64 = _bj_k_cr_mono(&nb, 4, 0, 0);
    return g;
}

# RN(x/(y·z·w)) by its fast path: N = sₓ exact, D = s_ys_zs_w by _bj_k_dd_mul_d on the exact TwoProduct s_ys_z (within
# 3.01u², in [1, 8)), F in (⅛, 2) by _bj_k_dd_div_ends; a failed test falls back.
#must_use
fn _bj_k_div3_fast(x: f64, y: f64, z: f64, w: f64): (f64, i64) {
    var bx = load64(&x);
    var by = load64(&y);
    var bz = load64(&z);
    var bw = load64(&w);
    var neg = (bx ^ by ^ bz ^ bw) >> 63;
    var abs = 0x7FFFFFFFFFFFFFFF;
    var ax = bx & abs;
    var ay = by & abs;
    var az = bz & abs;
    var aw = bw & abs;
    var nmin = 0x0010000000000000;
    var nmax = 0x7FF0000000000000;
    if (ax < nmin || ay < nmin || az < nmin || aw < nmin) { return (0.0, 0); }
    if (ax >= nmax || ay >= nmax || az >= nmax || aw >= nmax) { return (0.0, 0); }
    var k = (ax >> 52) - (ay >> 52) - (az >> 52) - (aw >> 52) + 2046;   # eₓ − e_y − e_z − e_w
    var mask = 0x000FFFFFFFFFFFFF;
    var one = 0x3FF0000000000000;
    var sxb = (ax & mask) | one;
    var syb = (ay & mask) | one;
    var szb = (az & mask) | one;
    var swb = (aw & mask) | one;
    var sx: f64 = sxb;
    var sy: f64 = syb;
    var sz: f64 = szb;
    var sw: f64 = swb;
    var ph, pl = _bj_k_two_prod(sy, sz);
    var dh, dl = _bj_k_dd_mul_d(ph, pl, sw);
    var z1, z2 = _bj_k_dd_div_ends(sx, 0.0, dh, dl);
    if (z1 != z2) { return (0.0, 0); }
    var r, ok = _bj_k_mono_fin(z1, k, neg);
    return (r, ok);
}

# RN(x/(y·z·w)), correctly rounded: rotational_constant's h/(8·π·π·I), called as (h/8)/(π·π·I) (h/8 exact) (#30).
#must_use
fn _bj_k_cr_div3(x: f64, y: f64, z: f64, w: f64): f64 {
    var r, ok = _bj_k_div3_fast(x, y, z, w);
    if (ok == 1) { return r; }
    var nb: f64[1];
    store64(&nb, x);
    var db: f64[3];
    store64(&db, y);
    store64(&db + 8, z);
    store64(&db + 16, w);
    var g: f64 = _bj_k_cr_mono(&nb, 1, &db, 3);
    return g;
}

# ── correctly rounded square roots of quotients (the overflow audit's B2): ADR 0002 #30 ──────────────────────────────

# (y₀, d) with y₀ + d = √(sₓ/s_y) to 5.7u² (the section comment), for sₓ/s_y in (½, 4) and both in [1, 4). (Inlining
# the two TwoProducts saved 1 ns of 87 and was not kept.)
#must_use
fn _bj_k_sqrt_div_dd(sx: f64, sy: f64): (f64, f64) {
    var qh: f64 = sx / sy;
    var a, b = _bj_k_two_prod(qh, sy);
    var rem: f64 = (sx - a) - b;
    var ql: f64 = rem / sy;
    var y0: f64 = f64_sqrt(qh);
    var p, pe = _bj_k_two_prod(y0, y0);
    var t1: f64 = (qh - p) - pe;
    var t: f64 = t1 + ql;
    var tr: f64 = y0 + y0;
    var d: f64 = t / tr;
    return (y0, d);
}

# RN(√(x/y)) by the fast path (the section comment): (RN, 1), or (0, 0) for an operand that is not a positive normal
# double, a failed rounding test or a possibly subnormal result.
#must_use
fn _bj_k_sqrt_div_fast(x: f64, y: f64): (f64, i64) {
    var bx = load64(&x);
    var by = load64(&y);
    var nmin = 0x0010000000000000;
    var nmax = 0x7FF0000000000000;
    if (bx < nmin || by < nmin || bx >= nmax || by >= nmax) { return (0.0, 0); }     # a sign bit reads negative
    var kk = (bx >> 52) - (by >> 52);                                   # eₓ − e_y
    var mask = 0x000FFFFFFFFFFFFF;
    var one = 0x3FF0000000000000;
    var sxb = (bx & mask) | one;
    var syb = (by & mask) | one;
    var sx: f64 = sxb;
    var sy: f64 = syb;
    if ((kk & 1) != 0) {
        sx = sx * 2.0;
        kk = kk - 1;
    }
    var y0, d = _bj_k_sqrt_div_dd(sx, sy);
    var k100: f64 = 0x39B0000000000000;     # 2⁻¹⁰⁰
    var eps: f64 = y0 * k100;
    var lo: f64 = d - eps;
    var hi: f64 = d + eps;
    var z1: f64 = y0 + lo;
    var z2: f64 = y0 + hi;
    if (z1 != z2) { return (0.0, 0); }
    var r, ok = _bj_k_mono_fin(z1, kk / 2, 0);
    return (r, ok);
}

# R²·B into w (multi-word, below 2¹⁶⁵), for 0 ≤ R < 2⁵⁷ and B at bb; t and s are scratch.
fn _bj_k_sqrt_sq_mul(w, rr, bb, t, s) {
    _bj_k_bn_set(t, rr);
    _bj_k_bn_mul(s, t, t);
    _bj_k_bn_mul(w, s, bb);
    return 0;
}

# RN(√(x/y)) by the exact path alone (the section comment), for positive finite x and y; NaN otherwise.
#must_use
fn _bj_k_sqrt_div_acc(x: f64, y: f64): f64 {
    var bx = load64(&x);
    var by = load64(&y);
    var nmax = 0x7FF0000000000000;
    if (bx <= 0 || by <= 0 || bx >= nmax || by >= nmax) {
        var nan: f64 = _bj_k_nan();
        return nan;
    }
    var am, ea = _bj_k_f64_int(bx);
    var bm, eb = _bj_k_f64_int(by);
    var e = ea - eb;
    if ((e & 1) != 0) {
        am = am * 2;
        e = e - 1;
    }
    var af: f64 = f64_from(am);              # below 2⁵⁴: exact
    var bf: f64 = f64_from(bm);
    var p52: f64 = 0x3CB0000000000000;      # 2⁻⁵²: A/B as a quotient of significands in [1, 4), exactly scaled
    var sa: f64 = af * p52;
    var sb: f64 = bf * p52;
    var y0, d = _bj_k_sqrt_div_dd(sa, sb);
    var p55: f64 = 0x4360000000000000;      # 2⁵⁵
    var gy: f64 = y0 * p55;                 # an integer below 2⁵⁶ (y₀'s ulp is at least 2⁻⁵³)
    var gd: f64 = d * p55;
    var rr = f64_to(gy) + f64_to(gd);
    var pb[64];
    var bb[64];
    var wb[64];
    var tb[64];
    var sb2[64];
    _bj_k_bn_set(&pb, am);
    _bj_k_bn_shl(&pb, 110);
    _bj_k_bn_set(&bb, bm);
    var up = 1;
    while (up == 1) {
        _bj_k_sqrt_sq_mul(&wb, rr + 1, &bb, &tb, &sb2);
        if (_bj_k_bn_cmp(&wb, &pb) > 0) {
            up = 0;
        } else {
            rr = rr + 1;
        }
    }
    _bj_k_sqrt_sq_mul(&wb, rr, &bb, &tb, &sb2);
    while (_bj_k_bn_cmp(&wb, &pb) > 0) {
        rr = rr - 1;
        _bj_k_sqrt_sq_mul(&wb, rr, &bb, &tb, &sb2);
    }
    var sticky = 0;
    if (_bj_k_bn_cmp(&wb, &pb) != 0) { sticky = 1; }
    var h = (e - 110) / 2;
    var r: f64 = _bj_k_cr_from_int(2 * rr + sticky, h - 1);
    return r;
}

# RN(√(x/y)), correctly rounded (the section comment), for positive finite x and y: the fast path, then the exact path
# where it declines; NaN outside the domain.
#must_use
fn _bj_k_cr_sqrt_div(x: f64, y: f64): f64 {
    var r, ok = _bj_k_sqrt_div_fast(x, y);
    if (ok == 1) { return r; }
    var a: f64 = _bj_k_sqrt_div_acc(x, y);
    return a;
}

# ── correctly rounded w·√((x/y)·2^e) (the overflow audit's B3): ADR 0002 #32 ──────────────────────────────────────────

# RN(w·√((x/y)·2^e)) by the fast path (the section comment): (RN, 1), or (0, 0) for an operand that is not a positive
# normal double, a failed rounding test or a possibly subnormal result.
#must_use
fn _bj_k_mul_sqrt_ratio_fast(w: f64, x: f64, y: f64, e): (f64, i64) {
    var bw = load64(&w);
    var bx = load64(&x);
    var by = load64(&y);
    var nmin = 0x0010000000000000;
    var nmax = 0x7FF0000000000000;
    if (bw < nmin || bx < nmin || by < nmin) { return (0.0, 0); }      # a sign bit reads negative
    if (bw >= nmax || bx >= nmax || by >= nmax) { return (0.0, 0); }
    var kk = (bx >> 52) - (by >> 52) + e;                               # eₓ − e_y + e
    var mask = 0x000FFFFFFFFFFFFF;
    var one = 0x3FF0000000000000;
    var sxb = (bx & mask) | one;
    var syb = (by & mask) | one;
    var swb = (bw & mask) | one;
    var sx: f64 = sxb;
    var sy: f64 = syb;
    var sw: f64 = swb;
    if ((kk & 1) != 0) {
        sx = sx * 2.0;
        kk = kk - 1;
    }
    var y0, d = _bj_k_sqrt_div_dd(sx, sy);
    var ph, pl = _bj_k_two_prod(y0, sw);
    var c: f64 = d * sw;
    var t: f64 = pl + c;
    var h, l = _bj_k_fast_two_sum(ph, t);
    var z1, z2 = _bj_k_dd_round_ends(h, l);
    if (z1 != z2) { return (0.0, 0); }
    var k = (bw >> 52) - 1023 + kk / 2;
    var r, ok = _bj_k_mono_fin(z1, k, 0);
    return (r, ok);
}

# RN(w·√((x/y)·2^e)) by the exact path alone (the section comment), for positive finite w, x and y; NaN otherwise.
#must_use
fn _bj_k_mul_sqrt_ratio_acc(w: f64, x: f64, y: f64, e): f64 {
    var bw = load64(&w);
    var bx = load64(&x);
    var by = load64(&y);
    var nmax = 0x7FF0000000000000;
    if (bw <= 0 || bx <= 0 || by <= 0 || bw >= nmax || bx >= nmax || by >= nmax) {
        var nan: f64 = _bj_k_nan();
        return nan;
    }
    var wm, ew = _bj_k_f64_int(bw);
    var am, ea = _bj_k_f64_int(bx);
    var bm, eb = _bj_k_f64_int(by);
    var ee = ea - eb + e;
    if ((ee & 1) != 0) {
        am = am * 2;
        ee = ee - 1;
    }
    var wf: f64 = f64_from(wm);              # below 2⁵³: exact
    var af: f64 = f64_from(am);              # below 2⁵⁴: exact
    var bf: f64 = f64_from(bm);
    var p52: f64 = 0x3CB0000000000000;      # 2⁻⁵²: A/B as a quotient of significands in [1, 4), exactly scaled
    var sa: f64 = af * p52;
    var sb: f64 = bf * p52;
    var y0, d = _bj_k_sqrt_div_dd(sa, sb);
    var gh, gl = _bj_k_two_prod(wf, y0);      # W·y₀ exactly, at least 2^51.5: 8·g_h is an integer
    var gd: f64 = wf * d;
    var g8: f64 = gh * 8.0;
    var t8: f64 = (gl + gd) * 8.0;
    var rr = f64_to(g8) + f64_to(t8);       # within a few units of R
    var pb[64];
    var tb[64];
    var bb[64];
    var wb[64];
    var sb2[64];
    _bj_k_bn_set(&tb, wm);
    _bj_k_bn_mul(&sb2, &tb, &tb);
    _bj_k_bn_set(&tb, am);
    _bj_k_bn_mul(&pb, &sb2, &tb);
    _bj_k_bn_shl(&pb, 6);
    _bj_k_bn_set(&bb, bm);
    var up = 1;
    while (up == 1) {
        _bj_k_sqrt_sq_mul(&wb, rr + 1, &bb, &tb, &sb2);
        if (_bj_k_bn_cmp(&wb, &pb) > 0) {
            up = 0;
        } else {
            rr = rr + 1;
        }
    }
    _bj_k_sqrt_sq_mul(&wb, rr, &bb, &tb, &sb2);
    while (_bj_k_bn_cmp(&wb, &pb) > 0) {
        rr = rr - 1;
        _bj_k_sqrt_sq_mul(&wb, rr, &bb, &tb, &sb2);
    }
    var sticky = 0;
    if (_bj_k_bn_cmp(&wb, &pb) != 0) { sticky = 1; }
    var h = ew + ee / 2 - 3;
    var r: f64 = _bj_k_cr_from_int(2 * rr + sticky, h - 1);
    return r;
}

# RN(w·√((x/y)·2^e)), correctly rounded (the section comment), for positive finite w, x and y: the fast path, then the
# exact path where it declines; NaN outside the domain.
#must_use
fn _bj_k_cr_mul_sqrt_ratio(w: f64, x: f64, y: f64, e): f64 {
    var r, ok = _bj_k_mul_sqrt_ratio_fast(w, x, y, e);
    if (ok == 1) { return r; }
    var a: f64 = _bj_k_mul_sqrt_ratio_acc(w, x, y, e);
    return a;
}

# --- crmath_mono.cyr ---

# crmath_mono.cyr — RN(√(x₁·…·xₐ / (y₁·…·y_b))), the correctly rounded square root of a monomial (bijli, M1 part 5b),
# on kimiya's machinery (src/crmath_kx.cyr).
#
# For the "round once" decision of the range-edge review (plan §0.1, the user's 2026-11-12 answer): a formula that is
# one root of a product or quotient of inputs and constants is correctly rounded, where kimiya's shapes stop at
# √(x/y) and w·√((x/y)·2^e). bijli's are maxwell's wave_speed 1/√(ε·μ) (no numerator factor, two denominator factors)
# and skin_depth √(2/(ω·μ·σ)) (2 enters as an exponent, three denominator factors). Rust's chains round three or
# four times (one ulp off on about a quarter of inputs) and their products over- or underflow where the root is
# representable (wave_speed(1e-160, 1e-160) is 3.6·10¹⁰ ulp off, (1e160, 1e160) gives 0).
#
# Domain: at most _BJ_SQM_NMAX numerator and _BJ_SQM_DMAX denominator factors, each a positive finite double; NaN
# otherwise (the callers keep Rust's semantics for ±∞, zeros and NaN). The value v = √F lies within about 2^±2200;
# it is +∞ past DBL_MAX's rounding boundary, subnormal below 2^-1022, +0 below half of 2^-1074.
#
# The fast path, _bj_cr_sqrt_mono_fast (u = 2⁻⁵³). kimiya's _bj_k_mono_sig splits each side into its significands
# other than 1 (in [1, 2); a subnormal scaled by 2⁵⁴ first) and the sum of exponents; _bj_k_mono_prod makes the
# products N = n_h + n_l and D = d_h + d_l normalised double-doubles (one factor exact, two an exact TwoProduct, a
# third by _bj_k_dd_mul_d within 3.01u²), so N/D is within 3.1u² of the exact significand quotient. With
# K = Σ e_num − Σ e_den made even (N doubled, exactly, when it is odd), F = N/D·2^K, N in [1, 2⁴), D in [1, 2⁴).
# _bj_sqm_dd then forms q_h + q_l = N/D (q_h = RN(n_h/d_h); its remainder n_h − q_h·d_h is exact by TwoProduct and
# Sterbenz, and n_l − q_h·d_l joins it with an error at most 3u²·q_h), y₀ = RN(√q_h), and the Newton step
# δ = ((q_h − y₀²) + q_l)/(2y₀) (q_h − y₀² exact by TwoProduct and Sterbenz, as kimiya's _bj_k_sqrt_div_dd). The
# quotient's error is at most 7u² relative, half of it in the root, and the step's own at most 5.7u² (kimiya's bound),
# so y₀ + δ is within 11u² of √(N/D), and within 13u² of the exact root with N's and D's errors. That is inside
# _bj_k_dd_round_ends's budget of 32u²: z₁ = z₂ proves RN(√(N/D)) = z₁, and _bj_k_mono_fin scales it by 2^(K/2),
# exactly for a normal result, to ±∞ past DBL_MAX, and declines a possibly subnormal one.
#
# The exact path, _bj_cr_sqrt_mono_acc: each factor x = M·2^E with 2⁵² ≤ M < 2⁵³ (kimiya's _bj_k_f64_int), P the
# product of the numerator's M and Q the denominator's (multi-word, below 2^160 and 2^213), F = P/Q·2^E. With S chosen
# so that R = ⌊√(P·2^S/Q)⌋ has 56 or 57 bits and E − S is even, R is the largest integer with R²·Q ≤ P·2^S: an
# estimate from the double-double root, within one or two, corrected by exact comparisons. The sticky bit records
# R²·Q ≠ P·2^S, and kimiya's _bj_k_cr_from_int rounds (2R + sticky)·2^((E − S)/2 − 1) once: the binade's grid or the
# subnormal one, ties to even, +∞ past DBL_MAX. (R has at least 55 bits, so the sticky bit sits below every rounding
# position.) The multi-word integers here are bijli's own, of _BJ_SQM_LIMBS 32-bit limbs (below 2^384): kimiya's
# stop at 2^256, and R²·Q reaches 2^327.
#
# scripts/oracle/cr_verify.py's sqrt_mono family checks both paths against an exact integer square root on x86_64 and
# aarch64.

const _BJ_SQM_NMAX = 3;
const _BJ_SQM_DMAX = 4;
const _BJ_SQM_LIMBS = 12;

# ── multi-word integers: _BJ_SQM_LIMBS limbs of 32 bits, least significant first, one per 64-bit word ──────────────

# a = v, for 0 ≤ v < 2^63.
fn _bj_sqm_set(a, v) {
    for (var k = 0; k < _BJ_SQM_LIMBS; k = k + 1) { store64(a + 8 * k, 0); }
    store64(a, v & 0xFFFFFFFF);
    store64(a + 8, v >> 32);
    return 0;
}

# The number of significant bits of a (0 for zero).
#must_use
fn _bj_sqm_bitlen(a): i64 {
    var k = _BJ_SQM_LIMBS - 1;
    while (k >= 0 && load64(a + 8 * k) == 0) { k = k - 1; }
    if (k < 0) { return 0; }
    var top = load64(a + 8 * k);
    var b = 0;
    while (top != 0) {
        top = top >> 1;
        b = b + 1;
    }
    return 32 * k + b;
}

# r = a·b, truncated to the capacity (the callers stay below it); r must not alias a or b.
fn _bj_sqm_mul(r, a, b) {
    for (var k = 0; k < _BJ_SQM_LIMBS; k = k + 1) { store64(r + 8 * k, 0); }
    var la = (_bj_sqm_bitlen(a) + 31) / 32;
    var lb = (_bj_sqm_bitlen(b) + 31) / 32;
    for (var i = 0; i < la; i = i + 1) {
        var ai = load64(a + 8 * i);
        var c = 0;
        var j = 0;
        while (j < lb && i + j < _BJ_SQM_LIMBS) {
            # ai·bⱼ + rᵢ₊ⱼ + c < 2⁶⁴: the sum wraps nothing, and >> is logical
            var t = ai * load64(b + 8 * j) + load64(r + 8 * (i + j)) + c;
            store64(r + 8 * (i + j), t & 0xFFFFFFFF);
            c = t >> 32;
            j = j + 1;
        }
        if (i + lb < _BJ_SQM_LIMBS) { store64(r + 8 * (i + lb), c); }
    }
    return 0;
}

# a = a·2^s, for 0 ≤ s (truncated to the capacity).
fn _bj_sqm_shl(a, s) {
    var w = s / 32;
    var b = s - 32 * w;
    var k = _BJ_SQM_LIMBS - 1;
    while (k >= 0) {
        var v = 0;
        if (k - w >= 0) { v = (load64(a + 8 * (k - w)) << b) & 0xFFFFFFFF; }
        if (b > 0 && k - w - 1 >= 0) { v = v | (load64(a + 8 * (k - w - 1)) >> (32 - b)); }
        store64(a + 8 * k, v);
        k = k - 1;
    }
    return 0;
}

# −1, 0 or 1 as a < b, a = b or a > b.
#must_use
fn _bj_sqm_cmp(a, b): i64 {
    var k = _BJ_SQM_LIMBS - 1;
    while (k >= 0) {
        var x = load64(a + 8 * k);
        var y = load64(b + 8 * k);
        if (x < y) { return 0 - 1; }
        if (x > y) { return 1; }
        k = k - 1;
    }
    return 0;
}

# w = R²·B, for 0 ≤ R < 2^62 and B at bb; t and s are scratch.
fn _bj_sqm_sq_mul(w, rr, bb, t, s) {
    _bj_sqm_set(t, rr);
    _bj_sqm_mul(s, t, t);
    _bj_sqm_mul(w, s, bb);
    return 0;
}

# ── the root ────────────────────────────────────────────────────────────────────────────────────────────────────

# (y₀, δ) with y₀ + δ = √(N/D) to 11u² (the section comment), for normalised double-doubles N = n_h + n_l and
# D = d_h + d_l in [1, 2⁴).
#must_use
fn _bj_sqm_dd(nh: f64, nl: f64, dh: f64, dl: f64): (f64, f64) {
    var qh: f64 = nh / dh;
    var a, b = _bj_k_two_prod(qh, dh);
    var r0: f64 = (nh - a) - b;
    var r1: f64 = qh * dl;
    var r2: f64 = nl - r1;
    var rem: f64 = r0 + r2;
    var ql: f64 = rem / dh;
    var y0: f64 = f64_sqrt(qh);
    var p, pe = _bj_k_two_prod(y0, y0);
    var t1: f64 = (qh - p) - pe;
    var t: f64 = t1 + ql;
    var tr: f64 = y0 + y0;
    var d: f64 = t / tr;
    return (y0, d);
}

# The significands of the n factors at p written to out as kimiya's _bj_k_mono_sig does, for a side of the domain:
# (count, exponent sum), or (−1, 0) when a factor is not positive and finite.
#must_use
fn _bj_sqm_side(p, n, out): (i64, i64) {
    var fl, c, e = _bj_k_mono_sig(p, n, out);
    if (fl != 0) { return (0 - 1, 0); }
    return (c, e);
}

# RN(√F) by the fast path (the section comment): (RN, 1), or (0, 0) for a failed rounding test, a possibly subnormal
# result or an argument outside the domain.
#must_use
fn _bj_cr_sqrt_mono_fast(num, nn, den, nd): (f64, i64) {
    if (nn < 0 || nd < 0 || nn > _BJ_SQM_NMAX || nd > _BJ_SQM_DMAX) { return (0.0, 0); }
    var sn: f64[3];
    var sd: f64[4];
    var cn, en = _bj_sqm_side(num, nn, &sn);
    var cd, ed = _bj_sqm_side(den, nd, &sd);
    if (cn < 0 || cd < 0) { return (0.0, 0); }
    var nh, nl = _bj_k_mono_prod(&sn, cn);
    var dh, dl = _bj_k_mono_prod(&sd, cd);
    var kk = en - ed;
    if ((kk & 1) != 0) {
        nh = nh * 2.0;
        nl = nl * 2.0;
        kk = kk - 1;
    }
    var y0, d = _bj_sqm_dd(nh, nl, dh, dl);
    var z1, z2 = _bj_k_dd_round_ends(y0, d);
    if (z1 != z2) { return (0.0, 0); }
    var r, ok = _bj_k_mono_fin(z1, kk / 2, 0);
    return (r, ok);
}

# RN(√F) by the exact path alone (the section comment); NaN outside the domain.
#must_use
fn _bj_cr_sqrt_mono_acc(num, nn, den, nd): f64 {
    var nan: f64 = _bj_k_nan();
    if (nn < 0 || nd < 0 || nn > _BJ_SQM_NMAX || nd > _BJ_SQM_DMAX) { return nan; }
    var pb[96];
    var qb[96];
    var tb[96];
    var rb[96];
    var ee = 0;
    _bj_sqm_set(&pb, 1);
    _bj_sqm_set(&qb, 1);
    var side = 0;
    while (side < 2) {
        var p = num;
        var n = nn;
        var acc = &pb;
        if (side == 1) {
            p = den;
            n = nd;
            acc = &qb;
        }
        for (var i = 0; i < n; i = i + 1) {
            var b = load64(p + 8 * i);
            if (b <= 0 || b >= 0x7FF0000000000000) { return nan; }
            var mm, e = _bj_k_f64_int(b);
            if (side == 0) { ee = ee + e; } else { ee = ee - e; }
            _bj_sqm_set(&tb, mm);
            _bj_sqm_mul(&rb, acc, &tb);
            for (var k = 0; k < _BJ_SQM_LIMBS; k = k + 1) { store64(acc + 8 * k, load64(&rb + 8 * k)); }
        }
        side = side + 1;
    }
    # S: R = ⌊√(P·2^S/Q)⌋ near 2^56, with E − S even.
    var bp = _bj_sqm_bitlen(&pb);
    var bq = _bj_sqm_bitlen(&qb);
    var s = 112 - bp + bq;
    if (((ee - s) & 1) != 0) { s = s + 1; }
    var ab[96];
    var bb[96];
    for (var k2 = 0; k2 < _BJ_SQM_LIMBS; k2 = k2 + 1) {
        store64(&ab + 8 * k2, load64(&pb + 8 * k2));
        store64(&bb + 8 * k2, load64(&qb + 8 * k2));
    }
    if (s >= 0) { _bj_sqm_shl(&ab, s); } else { _bj_sqm_shl(&bb, 0 - s); }
    # The estimate: the significands' root by _bj_sqm_dd, scaled by 2^h (A/B = (Π sₙ/Π s_d)·2^(52·(nn − nd) + s)).
    var sn: f64[3];
    var sd: f64[4];
    var g = 52 * (nn - nd) + s;
    var p52: f64 = 0x3CB0000000000000;      # 2⁻⁵²: each M as its significand in [1, 2), exactly
    for (var i2 = 0; i2 < nn; i2 = i2 + 1) {
        var m2, e2 = _bj_k_f64_int(load64(num + 8 * i2));
        var mf: f64 = f64_from(m2);
        sn[i2] = mf * p52;
    }
    for (var i3 = 0; i3 < nd; i3 = i3 + 1) {
        var m3, e3 = _bj_k_f64_int(load64(den + 8 * i3));
        var mf3: f64 = f64_from(m3);
        sd[i3] = mf3 * p52;
    }
    var nh, nl = _bj_k_mono_prod(&sn, nn);
    var dh, dl = _bj_k_mono_prod(&sd, nd);
    if ((g & 1) != 0) {
        nh = nh * 2.0;
        nl = nl * 2.0;
        g = g - 1;
    }
    var y0, d = _bj_sqm_dd(nh, nl, dh, dl);
    var sc: f64 = _bj_k_cr_pow2(g / 2);     # 2^h, h ≤ 57 + … : the root near 2^56
    var gy: f64 = y0 * sc;
    var gd: f64 = d * sc;
    var rr = f64_to(gy) + f64_to(gd);
    # R: the largest integer with R²·B ≤ A.
    var wb[96];
    var w2[96];
    var t1[96];
    var t2[96];
    _bj_sqm_sq_mul(&wb, rr, &bb, &t1, &t2);
    while (_bj_sqm_cmp(&wb, &ab) > 0) {
        rr = rr - 1;
        _bj_sqm_sq_mul(&wb, rr, &bb, &t1, &t2);
    }
    var up = 1;
    while (up == 1) {
        _bj_sqm_sq_mul(&w2, rr + 1, &bb, &t1, &t2);
        if (_bj_sqm_cmp(&w2, &ab) > 0) { up = 0; } else { rr = rr + 1; }
    }
    _bj_sqm_sq_mul(&wb, rr, &bb, &t1, &t2);
    var sticky = 0;
    if (_bj_sqm_cmp(&wb, &ab) != 0) { sticky = 1; }
    var r: f64 = _bj_k_cr_from_int(2 * rr + sticky, (ee - s) / 2 - 1);
    return r;
}

# RN(√(Π num / Π den)), correctly rounded (the section comment), for at most _BJ_SQM_NMAX positive finite numerator
# and _BJ_SQM_DMAX denominator factors: the fast path, then the exact path where it declines; NaN outside the domain.
#must_use
fn _bj_cr_sqrt_mono(num, nn, den, nd): f64 {
    var r, ok = _bj_cr_sqrt_mono_fast(num, nn, den, nd);
    if (ok == 1) { return r; }
    var a: f64 = _bj_cr_sqrt_mono_acc(num, nn, den, nd);
    return a;
}

# --- crmath_ux_data.cyr ---

# crmath_ux_data.cyr — 2/π for src/crmath_ux.cyr's Payne–Hanek reduction of a 53-bit angle past DBL_MAX (bijli,
# M1 parts 5c-2 and 5d-3). Generated by scripts/oracle/crtables.py's render_ux (python3 -I scripts/oracle/validate.py
# . --write) from π computed exactly to 2800 bits and checked against MPFR; do not edit.

# 2/π in 96 chunks of 28 bits: chunk n is bits 28n + 1 … 28n + 28 after the binary point.
var _bj_ux_2opi[768];
var _bj_ux_ready = 0;

# Fills the table, once.
