        var a: f64 = 1.0 - ax;                    # exact (Sterbenz)
        var bh: f64 = 1.0 + ax;                   # Fast2Sum(1, |x|)
        var bl: f64 = ax - (bh - 1.0);
        var ca: f64 = 134217729.0 * a;            # (1 − |x|)·bh by Dekker's product
        var a1: f64 = ca - (ca - a);
        var a2: f64 = a - a1;
        var cb: f64 = 134217729.0 * bh;
        var b1: f64 = cb - (cb - bh);
        var b2: f64 = bh - b1;
        wh = a * bh;
        var we: f64 = (((a1 * b1) - wh) + (a1 * b2) + (a2 * b1)) + (a2 * b2);
        wl = we + (a * bl);
    } else {
        var cx: f64 = 134217729.0 * ax;           # x² = p + pe (Dekker)
        var x1: f64 = cx - (cx - ax);
        var x2: f64 = ax - x1;
        var p: f64 = ax * ax;
        var pe: f64 = (((x1 * x1) - p) + (2.0 * (x1 * x2))) + (x2 * x2);
        wh = 1.0 - p;                             # Fast2Sum(1, −p)
        var we2: f64 = (1.0 - wh) - p;
        wl = we2 - pe;
    }
    var sh: f64 = f64_sqrt(wh);                   # s = sh + sl, one Newton step
    var cs: f64 = 134217729.0 * sh;
    var s1: f64 = cs - (cs - sh);
    var s2: f64 = sh - s1;
    var sp2: f64 = sh * sh;
    var spe: f64 = (((s1 * s1) - sp2) + (2.0 * (s1 * s2))) + (s2 * s2);
    var sl: f64 = (((wh - sp2) - spe) + wl) / (2.0 * sh);
    if (ax <= sh) {
        var h1, l1, e1 = _bj_k_atan_core(ax, 0.0, sh, sl, 0);
        return (h1, l1, e1);
    }
    var h2, l2, e2 = _bj_k_atan_core(sh, sl, ax, 0.0, 2);
    return (h2, l2, e2);
