    var m: f64 = load64(&sp + 8);
    var t: f64 = m - 1.0;
    var ts = 0;
    if (t < 0.0) { ts = 1; }
    var at: f64 = f64_abs(t);
    var S[112];
    _bj_cr_zero(&S);
    if (at != 0.0) {
        var T[112];
        var D[112];
        var R[112];
        var Z[112];
        var Z2[112];
        var P[112];
        var Q[112];
        _bj_cr_set(&T, at);
        _bj_cr_set(&D, m);
        store64(&D, load64(&D) + 1);
        var dm: f64 = 1.0 + m;
        _bj_cr_recip(&R, &D, dm);
        _bj_cr_mul(&Z, &T, &R);
        _bj_cr_mul(&Z2, &Z, &Z);
        memcpy(&P, &Z, 112);
        memcpy(&S, &Z, 112);
        for (var k = 1; k < 200; k = k + 1) {
            _bj_cr_mul(&P, &P, &Z2);
            _bj_cr_div_small(&Q, &P, 2 * k + 1);
            if (_bj_cr_is_zero(&Q) == 1) { break; }
            _bj_cr_add(&S, &S, &Q);
        }
