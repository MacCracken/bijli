}

# x^y, correctly rounded, with the specials of C99 Annex F: 1 for y = ±0 or x = 1 (even with a NaN),
# NaN for a NaN otherwise or a negative finite x with a non-integer y; the limits at y = ±∞, x = ±0 and
# x = ±∞; a negative x with an odd integer y negates. +∞ on overflow, subnormal results rounded once.
# Mirrors `f64::powf` with the exact result in place of libm's.
#must_use
fn _bj_cr_pow(x: f64, y: f64): f64 {
    if (y == 0.0) { return 1.0; }
    if (x == 1.0) { return 1.0; }
    if (x != x || y != y) {
        var nan: f64 = x + y;
        return nan;
    }
    var ax: f64 = f64_abs(x);
    var ay: f64 = f64_abs(y);
    var inf: f64 = _bj_cr_from_word(9218868437227405312);
    var nzero: f64 = _bj_cr_from_word(0 - 9223372036854775807 - 1);
    if (ay == inf) {
        if (ax == 1.0) { return 1.0; }
        if ((ax < 1.0 && y < 0.0) || (ax > 1.0 && y > 0.0)) { return inf; }
        return 0.0;
    }
    var odd = _bj_cr_is_odd(y);
    if (ax == 0.0) {
        if (y < 0.0) {
            if (odd == 1) {
                var pole: f64 = 1.0 / x;
                return pole;
            }
            return inf;
        }
        if (odd == 1) { return x; }
        return 0.0;
    }
    if (ax == inf) {
        if (x < 0.0) {
            if (y < 0.0) {
                if (odd == 1) { return nzero; }
                return 0.0;
            }
            if (odd == 1) {
                var ninf: f64 = -inf;
                return ninf;
            }
            return inf;
        }
        if (y < 0.0) { return 0.0; }
        return inf;
    }
    var neg = 0;
    if (x < 0.0) {
        if (_bj_cr_is_int(y) == 0) {
            var zero: f64 = 0.0;
            var dom: f64 = zero / zero;
            return dom;
        }
        neg = odd;
    }
    if (ax == 1.0) {
        if (neg == 1) { return 0.0 - 1.0; }
        return 1.0;
    }
    var o[8];
    if (_bj_cr_pow_p1(ax, y, neg, &o, 0) == 1) {
        var r1: f64 = load64(&o);
        return r1;
    }
    _bj_cr_pow_phase2_calls = _bj_cr_pow_phase2_calls + 1;
    if (_bj_cr_pow_p1(ax, y, neg, &o, 1) == 1) {
        var r2: f64 = load64(&o);
        return r2;
    }
    _bj_cr_pow_slow_calls = _bj_cr_pow_slow_calls + 1;
    var rs: f64 = _bj_cr_pow_slow(ax, y, neg);
    return rs;
}

# ── atan2 ───────────────────────────────────────────────────────────────────────────
# atan2(y, x), correctly rounded (impetus ADR 0011, amended for atan2). The specials follow C99 Annex F, as glibc's do:
# signed zeros and ±π for y = ±0, ±π/2 for x = ±0, ±π/4, ±3π/4 and ±π/2 for an infinite y, ±0 and ±π for an infinite
# x. Otherwise, with r = a/b ≤ 1 for a = min(|x|, |y|) and b = max, the result is ±z where z = atan(r), π/2 − atan(r)
# when |y| > |x|, and π − that when x < 0:
# - r < 2^-60 with z = atan(r) itself: atan(r) = r − r³/3 + …, and r³/3 is below 2^-107·r, closer than r can come to
#   a rounding midpoint without being one (r = num/den with two 53-bit odd parts). So the result is the IEEE quotient,
#   except at an exact midpoint, where atan(r) < r rounds toward zero. A midpoint needs 54 significant bits, so it
#   only occurs on the subnormal grid: num = A·2^α, den = B·2^β with A, B odd, B | A and α − β = −1075;
# - phase 1, in double-double: r exactly (the quotient of num and den scaled by the same power of two, and its
#   remainder by TwoProduct), c = i/64 nearest r, t = (r − c)/(1 + r·c) with |t| ≤ 2^-7, atan(r) = atan(c) + atan(t)
#   from the generated table and t + t·p(t²) through t^11; then the quadrant moves with π/2 and π in double-double.
#   Tested against 2^-63·|z| (the error is below about 2^-65.5·|z|): decides all but about 2^-10 of arguments;
# - the slow path: vectoring CORDIC in the 364-bit fixed point on (b, a), which needs no division: 364 rotations by
#   ±atan(2^-k) (each by its series in the fixed point as it is needed; 2^-k itself from k = 122), the angle then
#   moved to its quadrant and rounded once. Absolute error below about 2^-345, relative below 2^-285 since z ≥ 2^-60
#   there. atan2's hardest cases, like atan's, need about 2^-120, and there are no exact midpoints but the subnormal
#   ones above (Lindemann–Weierstrass: atan of a nonzero rational is transcendental).

var _bj_cr_atan2_slow_calls = 0;

# d = a·2^-k, truncated (d ≠ a), by whole limbs and a bit shift.
fn _bj_cr_shr(d, a, k) {
    var q = k / 28;
    var r = k % 28;
    for (var j = 0; j < _BJ_CR_L; j = j + 1) {
        var src = j - q;
        var v = 0;
        if (src >= 0) {
            v = load64(a + src * 8) >> r;
            if (src >= 1 && r > 0) { v = v | ((load64(a + (src - 1) * 8) << (28 - r)) & _BJ_CR_MASK); }
        }
        store64(d + j * 8, v);
    }
    return 0;
}

# T = atan(2^-k) for 0 ≤ k ≤ 364 in the fixed point: π/4 for k = 0 (π/2 halved), else Σ (−1)^n·2^(−k(2n + 1))/(2n + 1)
# while the term's bit is within the fixed point (each term truncated: error below 2^-356); 2^-k alone from k = 122,
# where the next term is below 2^-366. Computed as the slow path needs it, so crmath keeps no 14 KB table.
fn _bj_cr_atan_pow2(T, k) {
    if (k == 0) {
        _bj_cr_div_small(T, &_bj_cr_pio2, 2);
        return 0;
    }
    var t[112];
    _bj_cr_zero(T);
    var n = 0;
    while (k * (2 * n + 1) <= 364) {
        _bj_cr_zero(&t);
        var e = k * (2 * n + 1);
        var j = (e + 27) / 28;
        store64(&t + j * 8, 1 << (28 * j - e));
        if (n > 0) { _bj_cr_div_small(&t, &t, 2 * n + 1); }
        if ((n & 1) == 0) { _bj_cr_add(T, T, &t); } else { _bj_cr_sub(T, T, &t); }
        n = n + 1;
    }
    return 0;
}

# The slow path, for the scaled pair (0 ≤ num ≤ den, den in [1, 2)): z = atan(num/den) by vectoring CORDIC, moved to
# its quadrant (swap: π/2 − z; neg_x: π − that) and rounded, negated when neg_y is 1.
#must_use
fn _bj_cr_atan2_slow(num: f64, den: f64, swap, neg_x, neg_y): f64 {
    _bj_cr_load();
    _bj_cr_atan2_slow_calls = _bj_cr_atan2_slow_calls + 1;
    var X[112];
    var Y[112];
    var XS[112];
    var YS[112];
    var P[112];
    var N[112];
    var Z[112];
    var AT[112];
    _bj_cr_set(&X, den);
    _bj_cr_set(&Y, num);
    _bj_cr_zero(&P);
    _bj_cr_zero(&N);
    # Y is held as a magnitude and a sign (ys 1 for negative); X only grows.
    var ys = 0;
    var k = 0;
    while (k < 364 && _bj_cr_is_zero(&Y) == 0) {
        _bj_cr_shr(&XS, &X, k);
        _bj_cr_shr(&YS, &Y, k);
        _bj_cr_add(&X, &X, &YS);
        var acc = &P;
        if (ys == 1) { acc = &N; }
        # Y ≥ 0: Y − X·2^-k and the angle grows by atan(2^-k); Y < 0: Y + X·2^-k and it shrinks.
        ys = _bj_cr_sadd(&Y, &Y, ys, &XS, 1 - ys);
        _bj_cr_atan_pow2(&AT, k);
        _bj_cr_add(acc, acc, &AT);
        k = k + 1;
    }
    var zs = _bj_cr_sadd(&Z, &P, 0, &N, 1);
    if (swap == 1) { zs = _bj_cr_sadd(&Z, &_bj_cr_pio2, 0, &Z, 1 - zs); }
    if (neg_x == 1) {
        var PI[112];
        _bj_cr_add(&PI, &_bj_cr_pio2, &_bj_cr_pio2);
        zs = _bj_cr_sadd(&Z, &PI, 0, &Z, 1 - zs);
    }
    var neg = neg_y;
    if (zs == 1) { neg = 1 - neg; }
    var out: f64 = _bj_cr_round(&Z, 0, neg);
    return out;
}

# v, negated when neg is 1.
#must_use
fn _bj_cr_signed(v: f64, neg): f64 {
    if (neg == 1) { return -v; }
    return v;
}

# A finite x ≠ 0 as m·2^e with m odd: (m, e).
#must_use
fn _bj_cr_odd_split(x: f64) {
    var w = _bj_cr_word(x) & 9223372036854775807;
    var ef = w >> 52;
    var m = w & 4503599627370495;
    var e = 0 - 1074;
    if (ef > 0) {
        m = m | 4503599627370496;
        e = ef - 1075;
    }
    while ((m & 1) == 0) {
        m = m >> 1;
        e = e + 1;
    }
    return (m, e);
}

# atan(num/den) for 0 < num/den < 2^-60, given q, the IEEE quotient: q, except at an exact midpoint of the subnormal
# grid, where atan(r) < r rounds to the neighbour toward zero.
#must_use
fn _bj_cr_atan_tiny(num: f64, den: f64, q: f64): f64 {
    var a, ea = _bj_cr_odd_split(num);
    var b, eb = _bj_cr_odd_split(den);
    if (ea - eb == 0 - 1075 && a % b == 0) { return _bj_cr_from_word((a / b - 1) / 2); }
    return q;
}

# The exponent e with 2^e ≤ x < 2^(e + 1), for a finite x > 0.
#must_use
fn _bj_cr_ilogb(x: f64): i64 {
    var w = _bj_cr_word(x);
    var ef = (w >> 52) & 2047;
    if (ef > 0) { return ef - 1023; }
    var m = w & 4503599627370495;
    var b = 0;
    while ((m >> (b + 1)) != 0) { b = b + 1; }
    return b - 1074;
}

#must_use
fn _bj_cr_atan2(y: f64, x: f64): f64 {
    if (y != y || x != x) {
        var nn: f64 = y + x;
        return nn;
    }
    _bj_cr_load();
    var neg_y = 0;
    var neg_x = 0;
    if (_bj_cr_word(y) < 0) { neg_y = 1; }
    if (_bj_cr_word(x) < 0) { neg_x = 1; }
    var ay: f64 = f64_abs(y);
    var ax: f64 = f64_abs(x);
    var zero: f64 = 0.0;
    var inf: f64 = 1.0 / zero;
    if (ay == 0.0) {
        if (neg_x == 0) { return y; }
        return _bj_cr_signed(_BJ_CR_PI_HI, neg_y);
    }
    if (ax == 0.0) { return _bj_cr_signed(_BJ_CR_PIO2_HI, neg_y); }
    if (ay == inf) {
        var vi: f64 = _BJ_CR_PIO2_HI;
        if (ax == inf) {
            vi = _BJ_CR_PIO4;
            if (neg_x == 1) { vi = _BJ_CR_PI3O4; }
        }
        return _bj_cr_signed(vi, neg_y);
    }
    if (ax == inf) {
        if (neg_x == 0) { return _bj_cr_signed(0.0, neg_y); }
        return _bj_cr_signed(_BJ_CR_PI_HI, neg_y);
    }
    var swap = 0;
    var num: f64 = ay;
    var den: f64 = ax;
    if (ay > ax) {
        swap = 1;
        num = ax;
        den = ay;
    }
    var q: f64 = num / den;
    var tiny: f64 = _bj_cr_pow2(0 - 60);
    var e = _bj_cr_ilogb(den);
    var nums: f64 = _bj_cr_ldexp(num, 0 - e);
    var dens: f64 = _bj_cr_ldexp(den, 0 - e);
    var zh: f64 = q;
    var zl: f64 = 0.0;
    if (q < tiny) {
        if (swap == 0 && neg_x == 0) { return _bj_cr_signed(_bj_cr_atan_tiny(num, den, q), neg_y); }
        # atan(r) ≈ q within r³/3 + ulp(q)/2 < 2^-112, far below the quadrant moves' half-ulp.
    } else {
        var rh: f64 = nums / dens;
        var p, pe = _bj_cr_two_prod(rh, dens);
        var pf: f64 = p;
        var pef: f64 = pe;
        var rem: f64 = (nums - pf) - pef;
        var rl: f64 = rem / dens;
        var fi: f64 = f64_floor(rh * 64.0 + 0.5);
        var i = f64_to(fi);
        var c: f64 = fi / 64.0;
        var nh0: f64 = rh - c;
        var nh, nl = _bj_cr_two_sum(nh0, rl);
        var rch, rcl = _bj_cr_two_prod(rh, c);
        var rclf: f64 = rcl;
        var rlc: f64 = rl * c;
        var dh, dl = _bj_cr_dd_add(1.0, 0.0, rch, rclf + rlc);
        var th, tl = _bj_cr_dd_div(nh, nl, dh, dl);
        var thf: f64 = th;
        _bj_cr_odd_load();
        var c3: f64 = load64(&_bj_cr_odd_inv + 16);
        var c5: f64 = load64(&_bj_cr_odd_inv + 32);
        var c7: f64 = load64(&_bj_cr_odd_inv + 48);
        var c9: f64 = load64(&_bj_cr_odd_inv + 64);
        var c11: f64 = load64(&_bj_cr_odd_inv + 80);
        var t2: f64 = thf * thf;
        var poly: f64 = t2 * (0.0 - c3 + t2 * (c5 + t2 * (0.0 - c7 + t2 * (c9 - t2 * c11))));
        var tp: f64 = thf * poly;
        var ah, al = _bj_cr_dd_add(th, tl, tp, 0.0);
        var cth: f64 = load64(&_bj_cr_atant + i * 16);
        var ctl: f64 = load64(&_bj_cr_atant + i * 16 + 8);
        var sh, sl = _bj_cr_dd_add(cth, ctl, ah, al);
        zh = sh;
        zl = sl;
    }
    if (swap == 1) {
        var wh, wl = _bj_cr_dd_add(_BJ_CR_PIO2_HI, _BJ_CR_PIO2_LO, -zh, -zl);
        zh = wh;
        zl = wl;
    }
    if (neg_x == 1) {
        var vh, vl = _bj_cr_dd_add(_BJ_CR_PI_HI, _BJ_CR_PI_LO, -zh, -zl);
        zh = vh;
        zl = vl;
    }
    var azh: f64 = f64_abs(zh);
    var err: f64 = azh * _bj_cr_pow2(0 - 63);
    if (_bj_cr_rounds_to(zh, zl, err) == 1) { return _bj_cr_signed(zh, neg_y); }
    return _bj_cr_atan2_slow(nums, dens, swap, neg_x, neg_y);
}

# --- crmath_k_data.cyr ---

# bijli — tables of the correctly rounded acos, asin and log10 (src/crmath_k.cyr)
#
# GENERATED by scripts/oracle/crtables_k.py (kimiya's scripts/oracle/mathx_tables.py, its ln and atan
# tables only) from MPFR 4.2.2 (400-bit values) and exact rationals. Do not edit.
# Regenerate: python3 -I -B scripts/oracle/crtables_k.py   (--check verifies this file is current)
#
# Every value is an IEEE-754 binary64 bit pattern, in an i64 table (read with load64) or an i64 global,
# assigned to an f64 local (a hex literal in an f64 initialiser would be an integer). A multi-word entry
# is a value split into doubles, each the nearest double to what the previous ones leave: a + b + c is
# the value to about 2^(-53·k) relative. kimiya ADR 0006; the error analysis is in src/crmath_k.cyr.

