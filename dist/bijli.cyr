# asin x, correctly rounded: the odd function's value at |x| from the fast core and its rounding test, else the
# accurate path, then x's sign (negation is exact, and round-to-nearest is symmetric). Mirrors `f64::asin`.
#must_use
fn _bj_k_cr_asin(x: f64): f64 {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
