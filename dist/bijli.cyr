        store64(out + 8, gm);
        store64(out + 16, gl);
        return;
    }
    var oh: f64 = _BJ_K_CR_SC_PIO2H;
    var om: f64 = _BJ_K_CR_SC_PIO2M;
    var ol: f64 = _BJ_K_CR_SC_PIO2L;
    if (oct == 1) {
        oh = _BJ_K_CR_SC_PIH;
        om = _BJ_K_CR_SC_PIM;
        ol = _BJ_K_CR_SC_PIL;
    }
    if (oct != 3) {
        gh = -gh;
        gm = -gm;
        gl = -gl;
    }
    var rh, rm, rl = _bj_k_td_add(oh, om, ol, gh, gm, gl);
    store64(out, rh);
    store64(out + 8, rm);
    store64(out + 16, rl);
