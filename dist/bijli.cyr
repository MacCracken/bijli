# acos x for 2^-56 ≤ |x| < 1 as a triple-double at out[0..2] (the accurate path before its rounding).
fn _bj_k_acos_acc_td(x: f64, out) {
    var ax: f64 = f64_abs(x);
    var w0: f64 = 0.0;
    var w1: f64 = 0.0;
    var w2: f64 = 0.0;
    if (ax >= 0.5) {                              # (1 − |x|)·(1 + |x|): four exact products
        var a: f64 = 1.0 - ax;
        var bh, bl = _bj_k_fast_two_sum(1.0, ax);
        var p0, e0 = _bj_k_two_prod(a, bh);
        var p1, e1 = _bj_k_two_prod(a, bl);
        var g0, g1, g2 = _bj_k_td_add_d(p0, e0, 0.0, p1);
        var h0, h1, h2 = _bj_k_td_add_d(g0, g1, g2, e1);
        w0 = h0;
        w1 = h1;
        w2 = h2;
    } else {
        var p, pe = _bj_k_two_prod(ax, ax);
        var k0, k1, k2 = _bj_k_td_add_d(1.0, 0.0, 0.0, -p);
        var m0, m1, m2 = _bj_k_td_add_d(k0, k1, k2, -pe);
