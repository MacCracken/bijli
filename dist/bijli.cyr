const _BJ_TS_WS_N = 25;
var _bj_ts_ws: i64[25] = {
    0x9, 0xA, 0xB, 0xC, 0xD, 0x20, 0x85, 0xA0,
    0x1680, 0x2000, 0x2001, 0x2002, 0x2003, 0x2004, 0x2005, 0x2006,
    0x2007, 0x2008, 0x2009, 0x200A, 0x2028, 0x2029, 0x202F, 0x205F,
    0x3000,
};

# --- touchstone.cyr ---

# touchstone.cyr — rf.rs's Touchstone v1.1 I/O: (M4 part 1c-1) the reader, `parse_touchstone` into a
# BjTouchstoneData, and the TouchstoneFormat names; (M4 part 1c-2) the writer, `try_write_touchstone`, every number in
# Rust's `{:e}` form (src/fmtf.cyr's _bj_fmt_f64_exp), and BjTouchstoneData_new for data to write.
#
# The content is bytes read as UTF-8, as Rust's `&str` is: bytes that are not UTF-8 are refused (ADR 0002 row 38).
# Rust's str methods are followed exactly:
# - a line ends at '\n', and one '\r' before it is dropped (`str::lines`); `!` starts a comment;
# - `trim` and `split_whitespace` split on Unicode's White_Space (`char::is_whitespace`, src/touchstone_data.cyr);
# - a number has `parse::<f64>`'s grammar: an optional sign, ASCII digits with an optional point (`1.` and `.5` but not
#   `.`), an optional exponent with digits; no '_'. inf and nan are numbers there and not finite here, so the same
#   error. Its value is the stdlib's correctly rounded f64_parse_n, as Rust's is;
# - an error quotes a token as Rust's `{:?}` of a str, cut to 32 characters and '…' (`snippet`), escaping what Rust's
#   core escapes (src/touchstone_data.cyr's ranges, computed by the oracle's compiler).
#
# A pair is (v₁, v₂) in RI; in MA and DB it is (r·cos θ, r·sin θ) with one correctly rounded sincos of θ = v₂·π/180
# (Rust's folded to_radians), r = v₁ in MA and 10^(v₁/20) in DB (the correctly rounded pow, as `10.0_f64.powf`). Where
# 10^(v₁/20) or θ leaves the normal range, the chain runs with an unbounded exponent, each product rounded once (ADR
# 0002 row 18, M4 part 2d-4a: _bj_ts_polar_ux). 2-port records are ordered N11 N21 N12 N22, every other port count
# row-major. For a 2-port, a record whose frequency does not increase starts the noise-parameter block, which is
# skipped.
#
# A BjTouchstoneData's shape is fixed at construction (ADR 0002 row 36): `points` frequencies and as many ports-port
# matrices in one fl_alloc block, given back by BjTouchstoneData_free.

private

# The S-parameter formats of a Touchstone file. Mirrors `TouchstoneFormat`; the writers refuse any other value.
public enum BjTouchstoneFormat {
    BJ_TOUCHSTONE_FORMAT_MAGNITUDE_ANGLE = 0;
    BJ_TOUCHSTONE_FORMAT_REAL_IMAG = 1;
    BJ_TOUCHSTONE_FORMAT_DB_ANGLE = 2;
}

# The most ports the reader and writer take: a record is 1 + 2n² values. Mirrors `MAX_TOUCHSTONE_PORTS`.
const _BJ_TS_MAX_PORTS = 256;

# The smallest normal double, 2^-1022, and +∞.
var _BJ_TS_MIN_NORMAL: f64 = 0x0010000000000000;
var _BJ_TS_INF: f64 = 0x7FF0000000000000;

# An N-port network's S-parameters at `points` frequencies: `ports` (a usize, 1 to 256), `z0` (the option line's R,
# Ω), `frequencies`, the address of `points` f64 (Hz), and `s_matrices`, the address of `points` BjSMatrix (24 bytes
# each), every one a ports-port matrix whose entries and impedances lie in the same fl_alloc block. Read them with
# frequency_at and matrix_at; never BjSMatrix_free a matrix of the data: BjTouchstoneData_free gives the block back.
# Mirrors `TouchstoneData`.
public struct BjTouchstoneData {
    ports;
    z0: f64;
    points;
    frequencies;
    s_matrices;
}

# The address a as a *BjSMatrix (an untyped word stored into a typed pointer warns; a typed return does not).
#must_use
fn _bj_ts_smp(a): *BjSMatrix {
    return a;
}

# The address a as a *f64.
#must_use
fn _bj_ts_f64p(a): *f64 {
    return a;
}

# Allocates the data's block into *out: points frequencies (0), then the points matrix headers, then each matrix's
# ports² entries (0) and ports impedances (z0). 0, or the Allocation code recorded (out untouched).
fn _bj_ts_alloc(ports, z0: f64, points, out: *BjTouchstoneData): i64 {
    var per = ports * ports * 16 + ports * 8;
    var blk = 0;
    if (ports >= 0 && ports < 1048576 && points > 0 && points < 1099511627776 / (32 + per)) {
        blk = fl_calloc(points * (32 + per));
    }
    if (blk == 0 && points != 0) {
        var t = _bj_err_reason(BJ_ERR_ALLOCATION);
        _bj_tx_cstr(t, "Touchstone data of ");
        _bj_tx_u64(t, points);
        _bj_tx_cstr(t, " points");
        return BJ_ERR_ALLOCATION;
    }
    var hdr = blk + points * 8;
    var data = blk + points * 32;
    for (var k = 0; k < points; k = k + 1) {
        var s = data + k * per;
        var zp = s + ports * ports * 16;
        store64(hdr + k * 24, ports);
        store64(hdr + k * 24 + 8, s);
        store64(hdr + k * 24 + 16, zp);
        for (var j = 0; j < ports; j = j + 1) { store64(zp + j * 8, _bj_bits(z0)); }
    }
    out.ports = ports;
    out.z0 = z0;
    out.points = points;
    out.frequencies = blk;
    out.s_matrices = 0;
    if (points > 0) { out.s_matrices = hdr; }
    return 0;
}

# A new BjTouchstoneData of `points` frequencies (0 Hz) and as many ports-port matrices (every entry 0, every
# reference impedance z0) into *out, for bj_try_write_touchstone: Ok(0), or Err(Allocation) with out untouched. Nothing
# is checked, as Rust's struct literal checks nothing: the writer does. Fill it with set_frequency and each matrix_at's
# set and set_z0.
#must_use
public fn BjTouchstoneData_new(ports, z0: f64, points, out: *BjTouchstoneData): Result {
    if (ports < 0 || points < 0) {
        var t = _bj_err_reason(BJ_ERR_ALLOCATION);
        _bj_tx_cstr(t, "Touchstone data of ");
        _bj_tx_u64(t, points);
        _bj_tx_cstr(t, " points");
        return Err(BJ_ERR_ALLOCATION);
    }
    var e = _bj_ts_alloc(ports, z0, points, out);
    if (e != 0) { return Err(e); }
    return Ok(0);
}

# Gives d's block back and empties it (no points).
public fn BjTouchstoneData_free(d: *BjTouchstoneData): i64 {
    if (d.frequencies != 0) { fl_free(d.frequencies); }
    d.points = 0;
    d.frequencies = 0;
    d.s_matrices = 0;
    return 0;
}

impl BjTouchstoneData {
    # Rust's `frequencies[k]` (Hz); NaN unless 0 ≤ k < points.
    #must_use
    public fn frequency_at(self, k): f64 {
        if (k < 0 || k >= self.points) {
            var nan: f64 = _bj_from_bits(0x7FF8000000000000);
            return nan;
        }
        var fp: *f64 = _bj_ts_f64p(self.frequencies);
        var f: f64 = fp[k];
        return f;
    }

    # Sets frequency k (Rust's `frequencies[k] = f`, Hz): Ok(0), or Err(InvalidParameter) unless 0 ≤ k < points. The
    # value is not checked, as Rust's field isn't: the writer checks it.
    #must_use
    public fn set_frequency(self, k, f: f64): Result {
        if (k < 0 || k >= self.points) {
            var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(t, "frequency index must be below ");
            _bj_tx_u64(t, self.points);
            _bj_tx_cstr(t, ", got ");
            _bj_tx_u64(t, k);
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        store64(self.frequencies + k * 8, _bj_bits(f));
        return Ok(0);
    }

    # Rust's `&s_matrices[k]`: the address of matrix k (in the data's block: read or set its entries, never free it),
    # or 0 unless 0 ≤ k < points.
    #must_use
    public fn matrix_at(self, k): *BjSMatrix {
        if (k < 0 || k >= self.points) { return _bj_ts_smp(0); }
        return _bj_ts_smp(self.s_matrices + k * 24);
    }
}

# ── the text: UTF-8, White_Space, Rust's {:?} ────────────────────────────────────────────────────────────────────

# The offset of the first byte of c[0..n) that is not part of a well-formed UTF-8 sequence (Rust's `str::from_utf8`:
# no overlong forms, no surrogates, nothing past U+10FFFF), or -1 when all of it is UTF-8.
#must_use
fn _bj_ts_utf8_bad(c, n): i64 {
    var i = 0;
    while (i < n) {
        var b = load8(c + i);
        if (b < 128) {
            i = i + 1;
        } else {
            var need = 0;
            var lo = 128;
            var hi = 191;
            if (b >= 194 && b <= 223) { need = 1; }
            elif (b == 224) {
                need = 2;
                lo = 160;
            } elif (b >= 225 && b <= 236) { need = 2; }
            elif (b == 237) {
                need = 2;
                hi = 159;
            } elif (b >= 238 && b <= 239) { need = 2; }
            elif (b == 240) {
                need = 3;
                lo = 144;
            } elif (b >= 241 && b <= 243) { need = 3; }
            elif (b == 244) {
                need = 3;
                hi = 143;
            } else { return i; }
            if (i + need >= n) { return i; }
            var b1 = load8(c + i + 1);
            if (b1 < lo || b1 > hi) { return i; }
            for (var k = 2; k <= need; k = k + 1) {
                var bk = load8(c + i + k);
                if (bk < 128 || bk > 191) { return i; }
            }
            i = i + need + 1;
        }
    }
    return 0 - 1;
}

# The scalar value of the UTF-8 character at c + i and its byte count (c is valid UTF-8).
#must_use
fn _bj_ts_dec(c, i): (i64, i64) {
    var b = load8(c + i);
    if (b < 128) { return (b, 1); }
    if (b < 224) { return (((b & 31) << 6) | (load8(c + i + 1) & 63), 2); }
    if (b < 240) {
        var u3 = ((b & 15) << 12) | ((load8(c + i + 1) & 63) << 6) | (load8(c + i + 2) & 63);
        return (u3, 3);
    }
    var u4 = ((b & 7) << 18) | ((load8(c + i + 1) & 63) << 12) | ((load8(c + i + 2) & 63) << 6);
    u4 = u4 | (load8(c + i + 3) & 63);
    return (u4, 4);
}

# 1 when u is White_Space (`char::is_whitespace`).
#must_use
fn _bj_ts_is_ws(u): i64 {
    if (u == 32 || (u >= 9 && u <= 13)) { return 1; }
    if (u < 133) { return 0; }
    for (var k = 6; k < _BJ_TS_WS_N; k = k + 1) {
        if (_bj_ts_ws[k] == u) { return 1; }
    }
    return 0;
}

# The offset of the first character of c[i..e) that isn't White_Space, or e. ASCII is tested inline (the common case).
#must_use
fn _bj_ts_skip_ws(c, i, e): i64 {
    var p = i;
    while (p < e) {
        var b = load8(c + p);
        if (b < 128) {
            if (b != 32 && (b < 9 || b > 13)) { return p; }
            p = p + 1;
        } else {
            var u, l = _bj_ts_dec(c, p);
            if (_bj_ts_is_ws(u) == 0) { return p; }
            p = p + l;
        }
    }
    return e;
}

# The end of c[a..e) with its trailing White_Space dropped (a starts a character).
#must_use
fn _bj_ts_trim_end(c, a, e): i64 {
    var q = e;
    while (q > a) {
        var s = q - 1;
        var b = load8(c + s);
        if (b < 128) {
            if (b != 32 && (b < 9 || b > 13)) { return q; }
            q = s;
            continue;
        }
        while (s > a && (load8(c + s) & 192) == 128) { s = s - 1; }
        var u, l = _bj_ts_dec(c, s);
        if (_bj_ts_is_ws(u) == 0) { return q; }
        q = s;
    }
    return a;
}

# The end of the token that starts at c + i: the first White_Space character before e, or e. ASCII inline.
#must_use
fn _bj_ts_tok_end(c, i, e): i64 {
    var p = i;
    while (p < e) {
        var b = load8(c + p);
        if (b < 128) {
            if (b == 32 || (b >= 9 && b <= 13)) { return p; }
            p = p + 1;
        } else {
            var u, l = _bj_ts_dec(c, p);
            if (_bj_ts_is_ws(u) == 1) { return p; }
            p = p + l;
        }
    }
    return e;
}

# The six uppercase hex digits at p as a number.
#must_use
fn _bj_ts_hex6(p): i64 {
    var v = 0;
    for (var k = 0; k < 6; k = k + 1) {
        var d = load8(p + k);
        if (d >= 65) { d = d - 55; } else { d = d - 48; }
        v = v * 16 + d;
    }
    return v;
}

# 1 when Rust's `{:?}` of a str writes u as `\u{…}`: a binary search of src/touchstone_data.cyr's ranges (range r at
# byte 1 + 109·(r / 9) + 12·(r % 9) of its literal).
#must_use
fn _bj_ts_escaped(u): i64 {
    var lo = 0;
    var hi = _BJ_TS_ESC_N - 1;
    while (lo <= hi) {
        var mid = (lo + hi) / 2;
        var p = _bj_ts_esc + 1 + 109 * (mid / 9) + 12 * (mid % 9);
        var a = _bj_ts_hex6(p);
        var b = _bj_ts_hex6(p + 6);
        if (u < a) { hi = mid - 1; }
        elif (u > b) { lo = mid + 1; }
        else { return 1; }
    }
    return 0;
}

# Writes u in lowercase hexadecimal, no leading zeros.
fn _bj_ts_hex(t, u) {
    var sh = 20;
    while (sh > 0 && ((u >> sh) & 15) == 0) { sh = sh - 4; }
    while (sh >= 0) {
        var d = (u >> sh) & 15;
        if (d < 10) { _bj_tx_putc(t, 48 + d); } else { _bj_tx_putc(t, 87 + d); }
        sh = sh - 4;
    }
    return 0;
}

# Writes `{:?}` of the token c[i..e) cut to 32 characters with '…' appended past them (rf.rs's `snippet`).
fn _bj_ts_quote(t, c, i, e) {
    var chars = 0;
    var lim = e;
    var p = i;
    while (p < e) {
        if (chars == 32) {
            lim = p;
            p = e;
        } else {
            var u0, l0 = _bj_ts_dec(c, p);
            chars = chars + 1;
            p = p + l0;
        }
    }
    _bj_tx_putc(t, 34);
    p = i;
    while (p < lim) {
        var u, l = _bj_ts_dec(c, p);
        if (u == 0) { _bj_tx_cstr(t, "\\0"); }
        elif (u == 9) { _bj_tx_cstr(t, "\\t"); }
        elif (u == 10) { _bj_tx_cstr(t, "\\n"); }
        elif (u == 13) { _bj_tx_cstr(t, "\\r"); }
        elif (u == 34) { _bj_tx_cstr(t, "\\\""); }
        elif (u == 92) { _bj_tx_cstr(t, "\\\\"); }
        elif (_bj_ts_escaped(u) == 1) {
            _bj_tx_cstr(t, "\\u{");
            _bj_ts_hex(t, u);
            _bj_tx_putc(t, 125);
        } else {
            for (var k = 0; k < l; k = k + 1) { _bj_tx_putc(t, load8(c + p + k)); }
        }
        p = p + l;
    }
    if (lim < e) { _bj_tx_cstr(t, "…"); }
    _bj_tx_putc(t, 34);
    return 0;
}

# The value of the token c[i..e) into out[0] when it has `parse::<f64>`'s number grammar and its value is finite: 1,
# else 0 (inf, infinity and nan are numbers to Rust, but not finite).
#must_use
fn _bj_ts_num(c, i, e, out: *f64): i64 {
    var p = i;
    if (p < e && (load8(c + p) == 43 || load8(c + p) == 45)) { p = p + 1; }
    var d = 0;
    while (p < e && load8(c + p) >= 48 && load8(c + p) <= 57) {
        p = p + 1;
        d = d + 1;
    }
    if (p < e && load8(c + p) == 46) {
        p = p + 1;
        while (p < e && load8(c + p) >= 48 && load8(c + p) <= 57) {
            p = p + 1;
            d = d + 1;
        }
    }
    if (d == 0) { return 0; }
    if (p < e && (load8(c + p) == 101 || load8(c + p) == 69)) {
        p = p + 1;
        if (p < e && (load8(c + p) == 43 || load8(c + p) == 45)) { p = p + 1; }
        var x = 0;
        while (p < e && load8(c + p) >= 48 && load8(c + p) <= 57) {
            p = p + 1;
            x = x + 1;
        }
        if (x == 0) { return 0; }
    }
    if (p != e) { return 0; }
    var v: f64 = _bj_from_bits(f64_parse_n(c + i, e - i));
    if (_bj_is_finite(v) == 0) { return 0; }
    out[0] = v;
    return 1;
}

# 1 when c[i..e) is lit (an uppercase ASCII word) once ASCII letters are uppercased (`to_ascii_uppercase() == lit`).
#must_use
fn _bj_ts_word(c, i, e, lit): i64 {
    var n = strlen(lit);
    if (e - i != n) { return 0; }
    for (var k = 0; k < n; k = k + 1) {
        var b = load8(c + i + k);
        if (b >= 97 && b <= 122) { b = b - 32; }
        if (b != load8(lit + k)) { return 0; }
    }
    return 1;
}

# ── the reader ──────────────────────────────────────────────────────────────────────────────────────────────────

# Starts InvalidParameter "Touchstone line {line_no}: <head>" and returns its BjText.
fn _bj_ts_line_err(line_no, head): i64 {
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, "Touchstone line ");
    _bj_tx_u64(t, line_no);
    _bj_tx_cstr(t, ": ");
    _bj_tx_cstr(t, head);
    return t;
}

# Applies an option line's text c[i..e) (after '#') to opt = [the frequency multiplier's bits, the format, Z₀'s bits]:
# 0, or the InvalidParameter code recorded. Mirrors rf.rs's `parse_option_line`.
fn _bj_ts_options(c, i, e, line_no, opt: *i64): i64 {
    var p = _bj_ts_skip_ws(c, i, e);
    while (p < e) {
        var te = _bj_ts_tok_end(c, p, e);
        if (_bj_ts_word(c, p, te, "HZ") == 1) { opt[0] = _bj_bits(1.0); }
        elif (_bj_ts_word(c, p, te, "KHZ") == 1) { opt[0] = _bj_bits(1000.0); }
        elif (_bj_ts_word(c, p, te, "MHZ") == 1) { opt[0] = _bj_bits(1000000.0); }
        elif (_bj_ts_word(c, p, te, "GHZ") == 1) { opt[0] = _bj_bits(1000000000.0); }
        elif (_bj_ts_word(c, p, te, "S") == 1) { te = te; }
        elif (_bj_ts_word(c, p, te, "Y") == 1 || _bj_ts_word(c, p, te, "Z") == 1 || _bj_ts_word(c, p, te, "H") == 1
          || _bj_ts_word(c, p, te, "G") == 1) {
            var t = _bj_ts_line_err(line_no, "only S-parameter data is supported, got parameter type ");
            for (var k = p; k < te; k = k + 1) { _bj_tx_putc(t, load8(c + k)); }
            return BJ_ERR_INVALID_PARAMETER;
        } elif (_bj_ts_word(c, p, te, "MA") == 1) { opt[1] = BJ_TOUCHSTONE_FORMAT_MAGNITUDE_ANGLE; }
        elif (_bj_ts_word(c, p, te, "RI") == 1) { opt[1] = BJ_TOUCHSTONE_FORMAT_REAL_IMAG; }
        elif (_bj_ts_word(c, p, te, "DB") == 1) { opt[1] = BJ_TOUCHSTONE_FORMAT_DB_ANGLE; }
        elif (_bj_ts_word(c, p, te, "R") == 1) {
            var vs = _bj_ts_skip_ws(c, te, e);
            if (vs >= e) {
                _bj_ts_line_err(line_no, "option R must be followed by the reference impedance");
                return BJ_ERR_INVALID_PARAMETER;
            }
            var ve = _bj_ts_tok_end(c, vs, e);
            var r: f64[1];
            var ok = _bj_ts_num(c, vs, ve, &r);
            var rv: f64 = r[0];
            if (ok == 0 || rv <= 0.0) {
                var u = _bj_ts_line_err(line_no, "reference impedance must be a finite positive number, got ");
                _bj_ts_quote(u, c, vs, ve);
                return BJ_ERR_INVALID_PARAMETER;
            }
            opt[2] = _bj_bits(rv);
            te = ve;
        } else {
            var w = _bj_ts_line_err(line_no, "unrecognized option ");
            _bj_ts_quote(w, c, p, te);
            return BJ_ERR_INVALID_PARAMETER;
        }
        p = _bj_ts_skip_ws(c, te, e);
    }
    return 0;
}

# The store of complete records during a parse: st = [buffer, capacity, length] in words; a record is its frequency
# then its ports² entries row-major (re, im). Grows st by `need` words: 0, or the Allocation code recorded.
fn _bj_ts_grow(st: *i64, need): i64 {
    if (st[2] + need <= st[1]) { return 0; }
    var cap = st[1] * 2;
    if (cap < st[2] + need) { cap = st[2] + need; }
    if (cap < 64) { cap = 64; }
    var nb = 0;
    if (cap < 137438953472) { nb = fl_alloc(cap * 8); }
    if (nb == 0) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "Touchstone record buffer");
        return BJ_ERR_ALLOCATION;
    }
    if (st[0] != 0) {
        memcpy(nb, st[0], st[2] * 8);
        fl_free(st[0]);
    }
    st[0] = nb;
    st[1] = cap;
    return 0;
}

# A pair's (r·cos θ, r·sin θ) at a range edge (ADR 0002 row 18, M4 part 2d-4a), into out[0] and out[1]: rf.rs's chain
# with an unbounded exponent, each product rounded once. r is v₁ in MA, 10^(v₁/20) to 53 bits in DB (where Rust's
# power left the normal range); θ is v₂·π/180, and below 2^-1022 (Rust's θ not normal, v₂ ≠ 0) θ to 53 bits, whose
# sine to 53 bits is θ itself (within θ³/6) and cosine 1; elsewhere the correctly rounded sine and cosine of Rust's θ.
fn _bj_ts_polar_ux(fmt, v1: f64, v2: f64, out: *f64) {
    var ms, me = _bj_k_ux_from(v1);
    if (fmt == BJ_TOUCHSTONE_FORMAT_DB_ANGLE) {
        var y: f64 = v1 / 20.0;
        var ps, pe = _bj_ux_pow(1.25, 3, y);                # 10 = 1.25·2³
        ms = ps;
        me = pe;
    }
    var th: f64 = _bj_to_radians(v2);
    var ath: f64 = f64_abs(th);
    var cs: f64 = 1.0;
    var ce = 0;
    var ss: f64 = 0.0;
    var se = 0;
    if (ath <= _BJ_TS_MIN_NORMAL && v2 != 0.0) {
        var vs, ve = _bj_k_ux_from(v2);
        var rs, re0 = _bj_k_ux_from(_BJ_RADS_PER_DEG);
        var ts, te = _bj_k_ux_mul(vs, ve, rs, re0);
        ss = ts;
        se = te;
    } else {
        var s, c = _bj_sin_cos(th);
        var s2, e2 = _bj_k_ux_from(s);
        var c2, f2 = _bj_k_ux_from(c);
        ss = s2;
        se = e2;
        cs = c2;
        ce = f2;
    }
    out[0] = _bj_k_ux_mul_f64(ms, me, cs, ce);
    out[1] = _bj_k_ux_mul_f64(ms, me, ss, se);
}

# Appends the complete record rec = [f, v₁, v₂, …] to the store as its frequency f·mult and its S-matrix: 0, or the
# code recorded (InvalidParameter for a pair that isn't representable, Allocation). Mirrors rf.rs's
# `touchstone_record`.
fn _bj_ts_record(rec: *f64, ports, fmt, mult: f64, line_no, st: *i64): i64 {
    var nn = ports * ports;
    var g = _bj_ts_grow(st, 1 + 2 * nn);
    if (g != 0) { return g; }
    var base: *f64 = _bj_ts_f64p(st[0] + st[2] * 8);
    var f0: f64 = rec[0];
    var fr: f64 = f0 * mult;
    base[0] = fr;
    for (var k = 0; k < nn; k = k + 1) {
        var v1: f64 = rec[1 + 2 * k];
        var v2: f64 = rec[2 + 2 * k];
        var re: f64 = v1;
        var im: f64 = v2;
        if (fmt != BJ_TOUCHSTONE_FORMAT_REAL_IMAG) {
            var mag: f64 = v1;
            var edge = 0;
            if (fmt == BJ_TOUCHSTONE_FORMAT_DB_ANGLE) {
                mag = _bj_powf(10.0, v1 / 20.0);
                if (mag <= _BJ_TS_MIN_NORMAL || mag == _BJ_TS_INF) { edge = 1; }
            }
            var th: f64 = _bj_to_radians(v2);
            var ath: f64 = f64_abs(th);
            if (ath <= _BJ_TS_MIN_NORMAL && v2 != 0.0) { edge = 1; }
            if (edge == 0) {
                var s, c = _bj_sin_cos(th);
                re = mag * c;
                im = mag * s;
            } else {
                var w: f64[2];
                _bj_ts_polar_ux(fmt, v1, v2, &w);
                re = w[0];
                im = w[1];
            }
        }
        var i = k / ports;
        var j = k % ports;
        if (ports == 2) {
            i = k % 2;
            j = k / 2;
        }
        if (_bj_is_finite(re) == 0 || _bj_is_finite(im) == 0) {
            var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(t, "Touchstone record ending at line ");
            _bj_tx_u64(t, line_no);
            _bj_tx_cstr(t, ": S");
            _bj_tx_u64(t, i + 1);
            _bj_tx_u64(t, j + 1);
            _bj_tx_cstr(t, " = (");
            _bj_fmt_f64_display(t, v1);
            _bj_tx_cstr(t, ", ");
            _bj_fmt_f64_display(t, v2);
            _bj_tx_cstr(t, ") is not representable");
            return BJ_ERR_INVALID_PARAMETER;
        }
        base[1 + 2 * (i * ports + j)] = re;
        base[2 + 2 * (i * ports + j)] = im;
    }
    st[2] = st[2] + 1 + 2 * nn;
    return 0;
}

# Emits a debug line "<head> line=N".
fn _bj_ts_log_line(head, line_no) {
    if (_bj_log_on(4) == 0) { return 0; }
    var lb[96];
    var lt[24];
    _bj_tx_init(&lt, &lb, 96);
    _bj_tx_cstr(&lt, head);
    _bj_tx_cstr(&lt, " line=");
    _bj_tx_u64(&lt, line_no);
    _bj_log_text(4, &lt);
    return 0;
}

# The parse proper into the store st and res = [Z₀'s bits, the format, the point count]: 0, or the code recorded.
fn _bj_ts_parse(c, n, ports, rec: *f64, st: *i64, res: *i64): i64 {
    var rlen = 1 + 2 * ports * ports;
    var opt: i64[3];
    opt[0] = _bj_bits(1000000000.0);
    opt[1] = BJ_TOUCHSTONE_FORMAT_MAGNITUDE_ANGLE;
    opt[2] = _bj_bits(50.0);
    var seen = 0;
    var noise = 0;
    var rn = 0;
    var points = 0;
    var last: f64 = 0.0;
    var line_no = 0;
    var pos = 0;
    var v: f64[1];
    while (pos < n) {
        var eol = pos;
        var be = 0 - 1;
        var ch = 0;
        while (eol < n) {
            ch = load8(c + eol);
            if (ch == 10) { break; }
            if (ch == 33 && be < 0) { be = eol; }
            eol = eol + 1;
        }
        var le = eol;
        if (eol < n && le > pos && load8(c + le - 1) == 13) { le = le - 1; }
        line_no = line_no + 1;
        if (be < 0 || be > le) { be = le; }
        var a = _bj_ts_skip_ws(c, pos, be);
        var b = _bj_ts_trim_end(c, a, be);
        pos = eol + 1;
        if (a < b && load8(c + a) == 35) {
            if (seen == 1) {
                _bj_ts_log_line("ignoring additional Touchstone option line", line_no);
            } else {
                if (points > 0 || rn > 0 || noise == 1) {
                    _bj_ts_line_err(line_no, "option line must precede the network data");
                    return BJ_ERR_INVALID_PARAMETER;
                }
                seen = 1;
                var oe = _bj_ts_options(c, a + 1, b, line_no, &opt);
                if (oe != 0) { return oe; }
            }
        } elif (a < b && load8(c + a) == 91) {
            _bj_ts_line_err(line_no, "Touchstone 2.0 keywords are not supported (v1.1 only)");
            return BJ_ERR_INVALID_PARAMETER;
        } elif (a < b) {
            var mult: f64 = _bj_from_bits(opt[0]);
            var p = a;
            while (p < b) {
                var te = _bj_ts_tok_end(c, p, b);
                if (_bj_ts_num(c, p, te, &v) == 0) {
                    var t = _bj_ts_line_err(line_no, "expected a finite number, got ");
                    _bj_ts_quote(t, c, p, te);
                    return BJ_ERR_INVALID_PARAMETER;
                }
                var x: f64 = v[0];
                var take = 1;
                if (noise == 1) { take = 0; }
                if (take == 1 && rn == 0) {
                    var fq: f64 = x * mult;
                    var ok = 0;
                    if (_bj_is_finite(fq) == 1 && fq >= 0.0) { ok = 1; }
                    if (ok == 0) {
                        var u = _bj_ts_line_err(line_no, "frequency must be finite and non-negative, got ");
                        _bj_fmt_f64_display(u, x);
                        return BJ_ERR_INVALID_PARAMETER;
                    }
                    if (ports == 2 && points > 0 && fq <= last) {
                        _bj_ts_log_line("skipping 2-port noise parameter block", line_no);
                        noise = 1;
                        take = 0;
                    }
                }
                if (take == 1) {
                    rec[rn] = x;
                    rn = rn + 1;
                    if (rn == rlen) {
                        var re = _bj_ts_record(rec, ports, opt[1], mult, line_no, st);
                        if (re != 0) { return re; }
                        var f0: f64 = rec[0];
                        last = f0 * mult;
                        points = points + 1;
                        rn = 0;
                    }
                }
                p = _bj_ts_skip_ws(c, te, b);
            }
        }
    }
    if (rn > 0) {
        var w = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(w, "Touchstone data ends with an incomplete record: ");
        _bj_tx_u64(w, rn);
        _bj_tx_cstr(w, " of ");
        _bj_tx_u64(w, rlen);
        _bj_tx_cstr(w, " values");
        return BJ_ERR_INVALID_PARAMETER;
    }
    if (points == 0) { return _bj_err_invalid_parameter("no valid data found in Touchstone content"); }
    res[0] = opt[2];
    res[1] = opt[1];
    res[2] = points;
    return 0;
}

# The format's Rust Debug name ("MagnitudeAngle", "RealImag", "DbAngle"), its serde name too (public for
# src/json.cyr).
#must_use
public fn _bj_ts_format_name(fmt): i64 {
    if (fmt == BJ_TOUCHSTONE_FORMAT_REAL_IMAG) { return "RealImag"; }
    if (fmt == BJ_TOUCHSTONE_FORMAT_DB_ANGLE) { return "DbAngle"; }
    return "MagnitudeAngle";
}

# Parses Touchstone v1.1 (`.sNp`) S-parameter content, the len bytes at content, for a ports-port network into a new
# BjTouchstoneData in *out: Ok(0), or Err with out untouched (and never read).
# - The option line `# <unit> <param> <format> R <z0>` is case-insensitive, its defaults `GHz S MA R 50`. Only the
#   first is used (later ones are ignored, as the spec says), and it must precede the data. Units Hz, kHz, MHz, GHz;
#   formats RI, MA, DB (angles in degrees); parameter types other than S are refused.
# - `!` starts a comment anywhere on a line. Values are a token stream, so a record may span lines (one matrix row per
#   line for 3 ports and more); a record is 1 + 2n² numbers.
# - 2-port records are `f N11 N21 N12 N22`, every other port count row-major. For a 2-port, a record whose frequency
#   doesn't increase starts the noise-parameter block, which is skipped.
# InvalidParameter unless ports is 1 to 256 and the content is UTF-8 (ADR 0002 row 38), and for an unknown or
# malformed option (R missing, not finite and positive), a parameter type other than S, a Touchstone 2.0 keyword, a
# token that isn't a finite number, a negative or non-finite frequency, a pair that isn't representable, a partial
# last record, or no record at all; Allocation when the buffers can't be had. Mirrors `rf::parse_touchstone`.
#must_use
public fn bj_parse_touchstone(content, len, ports, out: *BjTouchstoneData): Result {
    if (ports <= 0 || ports > _BJ_TS_MAX_PORTS) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "Touchstone port count must be in 1..=256, got ");
        _bj_tx_u64(t, ports);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (_bj_log_on(4) == 1) {
        var lb[96];
        var lt[24];
        _bj_tx_init(&lt, &lb, 96);
        _bj_tx_cstr(&lt, "parsing Touchstone data ports=");
        _bj_tx_u64(&lt, ports);
        _bj_tx_cstr(&lt, " bytes=");
        _bj_tx_u64(&lt, len);
        _bj_log_text(4, &lt);
    }
    var bad = _bj_ts_utf8_bad(content, len);
    if (bad >= 0) {
        var u = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(u, "Touchstone content is not valid UTF-8 (an invalid sequence at byte ");
        _bj_tx_u64(u, bad);
        _bj_tx_cstr(u, ")");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var rlen = 1 + 2 * ports * ports;
    var rec = fl_alloc(rlen * 8);
    if (rec == 0) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "Touchstone record buffer");
        return Err(BJ_ERR_ALLOCATION);
    }
    var st: i64[3];
    st[0] = 0;
    st[1] = 0;
    st[2] = 0;
    var res: i64[3];
    var e = _bj_ts_parse(content, len, ports, _bj_ts_f64p(rec), &st, &res);
    fl_free(rec);
    if (e == 0) {
        var d: BjTouchstoneData;
        var z0: f64 = _bj_from_bits(res[0]);
        e = _bj_ts_alloc(ports, z0, res[2], &d);
        if (e == 0) {
            var stride = 1 + 2 * ports * ports;
            for (var k = 0; k < res[2]; k = k + 1) {
                var src = st[0] + k * stride * 8;
                store64(d.frequencies + k * 8, load64(src));
                memcpy(load64(d.s_matrices + k * 24 + 8), src + 8, (stride - 1) * 8);
            }
            out.ports = d.ports;
            out.z0 = d.z0;
            out.points = d.points;
            out.frequencies = d.frequencies;
            out.s_matrices = d.s_matrices;
            if (_bj_log_on(4) == 1) {
                var mb[160];
                var mt[24];
                _bj_tx_init(&mt, &mb, 160);
                _bj_tx_cstr(&mt, "parsed Touchstone data ports=");
                _bj_tx_u64(&mt, ports);
                _bj_tx_cstr(&mt, " points=");
                _bj_tx_u64(&mt, res[2]);
                _bj_tx_cstr(&mt, " z0=");
                _bj_fmt_f64_debug(&mt, z0);
                _bj_tx_cstr(&mt, " format=");
                _bj_tx_cstr(&mt, _bj_ts_format_name(res[1]));
                _bj_log_text(4, &mt);
            }
        }
    }
    if (st[0] != 0) { fl_free(st[0]); }
    if (e != 0) { return Err(e); }
    return Ok(0);
}

# ── the writer (M4 part 1c-2) ───────────────────────────────────────────────────────────────────────────────────

# Starts InvalidParameter "S-matrix #{k} <head>" and returns its BjText.
fn _bj_ts_matrix_err(k, head): i64 {
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, "S-matrix #");
    _bj_tx_u64(t, k);
    _bj_tx_cstr(t, head);
    return t;
}

# The consistency the writer needs: 0, or the InvalidParameter code recorded. The port count, R, then per point the
# frequency (finite, non-negative, strictly increasing), the matrix's ports, its reference impedances (all equal to R:
# z0_equal, both finite, ADR 0002 row 37) and its entries (finite). Rust's lengths can't disagree here (ADR 0002 row
# 36). Mirrors rf.rs's `validate_touchstone`.
fn _bj_ts_validate(d: *BjTouchstoneData): i64 {
    var n = d.ports;
    if (n <= 0 || n > _BJ_TS_MAX_PORTS) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "Touchstone port count must be in 1..=256, got ");
        _bj_tx_u64(t, n);
        return BJ_ERR_INVALID_PARAMETER;
    }
    var r: f64 = d.z0;
    var e = _bj_rf_require("Touchstone reference impedance", r);
    if (e != 0) { return e; }
    var prev: f64 = 0.0;
    for (var k = 0; k < d.points; k = k + 1) {
        var f: f64 = d.frequency_at(k);
        var ok = 0;
        if (_bj_is_finite(f) == 1 && f >= 0.0) { ok = 1; }
        if (ok == 0) {
            var u = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(u, "frequency #");
            _bj_tx_u64(u, k);
            _bj_tx_cstr(u, " must be finite and non-negative, got ");
            _bj_fmt_f64_display(u, f);
            return BJ_ERR_INVALID_PARAMETER;
        }
        if (k > 0 && f <= prev) {
            var w = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(w, "Touchstone frequencies must be strictly increasing (#");
            _bj_tx_u64(w, k);
            _bj_tx_cstr(w, ": ");
            _bj_fmt_f64_display(w, f);
            _bj_tx_cstr(w, ")");
            return BJ_ERR_INVALID_PARAMETER;
        }
        prev = f;
        var m: *BjSMatrix = d.matrix_at(k);
        if (m.ports != n) {
            var x = _bj_ts_matrix_err(k, " has ");
            _bj_tx_u64(x, m.ports);
            _bj_tx_cstr(x, " ports, expected ");
            _bj_tx_u64(x, n);
            return BJ_ERR_INVALID_PARAMETER;
        }
        var zp: *f64 = _bj_ts_f64p(m.z0);
        var same = 1;
        for (var j = 0; j < n; j = j + 1) {
            if (_bj_rf_z0_equal(zp[j], r) == 0) { same = 0; }
        }
        if (same == 0) {
            var y = _bj_ts_matrix_err(k, " reference impedances [");
            for (var i = 0; i < n; i = i + 1) {
                if (i > 0) { _bj_tx_cstr(y, ", "); }
                _bj_fmt_f64_debug(y, zp[i]);
            }
            _bj_tx_cstr(y, "] differ from the file's R ");
            _bj_fmt_f64_display(y, r);
            return BJ_ERR_INVALID_PARAMETER;
        }
        var sp: *f64 = _bj_ts_f64p(m.s);
        var fin = 1;
        for (var q = 0; q < 2 * n * n; q = q + 1) {
            if (_bj_is_finite(sp[q]) == 0) { fin = 0; }
        }
        if (fin == 0) {
            _bj_ts_matrix_err(k, " contains non-finite values");
            return BJ_ERR_INVALID_PARAMETER;
        }
    }
    return 0;
}

# MA's |S| or DB's 20·log₁₀ max(|S|, 2^-1022) for an entry whose squares leave the normal range (ADR 0002 row 18, M4
# part 2d-4b): |S| as BjComplex's abs at its edge (row 14: re² + im² to 53 bits with an unbounded exponent, the root
# rounded once); in DB past DBL_MAX, log₁₀ of the 53-bit |S| (src/crmath_ux.cyr), then Rust's 20·.
fn _bj_ts_mag_ux(re: f64, im: f64, format): f64 {
    var us, ue = _bj_cx_ux_sumsq(re, im);
    if (format == BJ_TOUCHSTONE_FORMAT_DB_ANGLE) {
        var ms, me = _bj_k_ux_sqrt(us, ue);
        if (me >= 1024) {
            var lu: f64 = _bj_ux_log10(ms, me);
            var du: f64 = 20.0 * lu;
            return du;
        }
    }
    var nrm: f64 = _bj_k_ux_sqrt_f64(us, ue);
    if (format == BJ_TOUCHSTONE_FORMAT_DB_ANGLE) {
        if (nrm < _BJ_TS_MIN_NORMAL) { nrm = _BJ_TS_MIN_NORMAL; }
        var lg: f64 = _bj_log10(nrm);
        var db: f64 = 20.0 * lg;
        return db;
    }
    return nrm;
}

# arg S in degrees where atan2(im, re) is at most 2^-1022 and im ≠ 0 (ADR 0002 row 18, M4 part 2d-4b): the angle to 53
# bits with an unbounded exponent (src/rf.cyr's _bj_rf_atan2_ux: im/re itself there), its product by 180/π rounded
# once.
fn _bj_ts_deg_ux(re: f64, im: f64): f64 {
    var ys, ye = _bj_k_ux_from(im);
    var xs, xe = _bj_k_ux_from(re);
    var gs, ge = _bj_rf_atan2_ux(ys, ye, xs, xe);
    var ds, de = _bj_k_ux_from(_BJ_DEGS_PER_RAD);
    var r: f64 = _bj_k_ux_mul_f64(gs, ge, ds, de);
    return r;
}

# Writes the pair "  {v1:e}  {v2:e}" of the entry re + j·im in the format: (re, im) for RI; for MA (|S|, arg S in
# degrees) and for DB (20 log₁₀ max(|S|, MIN_POSITIVE), arg S in degrees), |S| = √(re² + im²) and arg S = atan2(im,
# re) as hisab's. Where re² or im² leaves the normal range, |S| is BjComplex's abs at its edge and DB's logarithm takes
# an |S| past DBL_MAX; where arg S is at most 2^-1022, it is kept to 53 bits for its degrees (ADR 0002 row 18, M4
# part 2d-4b). 0, or InvalidParameter "S-parameter {S} cannot be written in {format:?} format" recorded when either
# value isn't finite (MA's |S| past DBL_MAX). Mirrors rf.rs's `push_touchstone_pair` and `format_complex_pair`.
fn _bj_ts_pair(t, re: f64, im: f64, format): i64 {
    var v1: f64 = re;
    var v2: f64 = im;
    if (format != BJ_TOUCHSTONE_FORMAT_REAL_IMAG) {
        if (_bj_cx_plain(re, im) == 1) {
            var nrm: f64 = f64_sqrt(re * re + im * im);
            v1 = nrm;
            if (format == BJ_TOUCHSTONE_FORMAT_DB_ANGLE) {
                if (nrm < _BJ_TS_MIN_NORMAL) { nrm = _BJ_TS_MIN_NORMAL; }
                var lg: f64 = _bj_log10(nrm);
                v1 = 20.0 * lg;
            }
        } else {
            v1 = _bj_ts_mag_ux(re, im, format);
        }
        var g: f64 = _bj_atan2(im, re);
        v2 = _bj_to_degrees(g);
        var ag: f64 = f64_abs(g);
        if (ag <= _BJ_TS_MIN_NORMAL && im != 0.0) { v2 = _bj_ts_deg_ux(re, im); }
    }
    if (_bj_is_finite(v1) == 0 || _bj_is_finite(v2) == 0) {
        var u = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(u, "S-parameter ");
        var z: BjComplex = BjComplex_new(re, im);
        z.display(u);
        _bj_tx_cstr(u, " cannot be written in ");
        _bj_tx_cstr(u, _bj_ts_format_name(format));
        _bj_tx_cstr(u, " format");
        return BJ_ERR_INVALID_PARAMETER;
    }
    _bj_tx_cstr(t, "  ");
    _bj_fmt_f64_exp(t, v1);
    _bj_tx_cstr(t, "  ");
    _bj_fmt_f64_exp(t, v2);
    return 0;
}

# The records of d, after the header, into t: 0, or a pair's code recorded.
fn _bj_ts_records(t, d: *BjTouchstoneData, format): i64 {
    var n = d.ports;
    for (var k = 0; k < d.points; k = k + 1) {
        var f: f64 = d.frequency_at(k);
        var g: f64 = f / 1000000000.0;
        _bj_fmt_f64_exp(t, g);
        var m: *BjSMatrix = d.matrix_at(k);
        var sp: *f64 = _bj_ts_f64p(m.s);
        if (n == 2) {
            for (var q = 0; q < 4; q = q + 1) {
                var at = q;
                if (q == 1) { at = 2; }
                if (q == 2) { at = 1; }
                var e = _bj_ts_pair(t, sp[2 * at], sp[2 * at + 1], format);
                if (e != 0) { return e; }
            }
        } else {
            var first = 1;
            for (var i = 0; i < n; i = i + 1) {
                for (var j = 0; j < n; j = j + 1) {
                    if (j % 4 == 0) {
                        if (first == 0) { _bj_tx_cstr(t, "\n "); }
                        first = 0;
                    }
                    var e2 = _bj_ts_pair(t, sp[2 * (i * n + j)], sp[2 * (i * n + j) + 1], format);
                    if (e2 != 0) { return e2; }
                }
            }
        }
        _bj_tx_putc(t, 10);
    }
    return 0;
}

# Appends d as Touchstone v1.1 text to the builder sb: `! Touchstone file generated by bijli`, `# GHz S <fmt> R <z0>`,
# then one record per frequency, every number in Rust's `{:e}` form (the shortest digits that read back, so the text
# parses with bj_parse_touchstone to the same values up to GHz ↔ Hz). 1- and 2-port records are one line (2-port
# order `f N11 N21 N12 N22`); for 3 ports and more each matrix row starts a new line, at most four pairs to a line. In
# DB |S| is clamped to MIN_POSITIVE, so a zero writes as a finite dB value. Ok(0), or Err with sb as it was:
# InvalidParameter when d is inconsistent (ports not 1 to 256, R not finite and positive, frequencies not finite,
# non-negative and strictly increasing, a matrix's impedances not R's, a non-finite entry) or an entry can't be written
# in the format; Allocation when the text's buffer can't be had or sb can't grow. A format value that is no
# BjTouchstoneFormat (Rust's enum has no other) is refused first, InvalidParameter. Mirrors `rf::try_write_touchstone`.
#must_use
public fn bj_try_write_touchstone(d: *BjTouchstoneData, format, sb): Result {
    if (format < 0 || format > 2) {
        var u = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(u, "unknown Touchstone format ");
        _bj_tx_i64(u, format);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var e = _bj_ts_validate(d);
    if (e != 0) { return Err(e); }
    var n = d.ports;
    if (_bj_log_on(4) == 1) {
        var lb[128];
        var lt[24];
        _bj_tx_init(&lt, &lb, 128);
        _bj_tx_cstr(&lt, "writing Touchstone data ports=");
        _bj_tx_u64(&lt, n);
        _bj_tx_cstr(&lt, " points=");
        _bj_tx_u64(&lt, d.points);
        _bj_tx_cstr(&lt, " format=");
        _bj_tx_cstr(&lt, _bj_ts_format_name(format));
        _bj_log_text(4, &lt);
    }
    var per = 32 + n * n * 60;
    var buf = 0;
    if (d.points < 1099511627776 / per) { buf = fl_alloc(512 + d.points * per + 1); }
    if (buf == 0) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "the Touchstone text's buffer");
        return Err(BJ_ERR_ALLOCATION);
    }
    var t[24];
    _bj_tx_init(&t, buf, 512 + d.points * per);
    _bj_tx_cstr(&t, "! Touchstone file generated by bijli\n# GHz S ");
    if (format == BJ_TOUCHSTONE_FORMAT_REAL_IMAG) { _bj_tx_cstr(&t, "RI"); }
    elif (format == BJ_TOUCHSTONE_FORMAT_DB_ANGLE) { _bj_tx_cstr(&t, "DB"); }
    else { _bj_tx_cstr(&t, "MA"); }
    _bj_tx_cstr(&t, " R ");
    var r: f64 = d.z0;
    _bj_fmt_f64_display(&t, r);
    _bj_tx_putc(&t, 10);
    var e2 = _bj_ts_records(&t, d, format);
    if (e2 != 0) {
        fl_free(buf);
        return Err(e2);
    }
    store8(buf + _bj_tx_len(&t), 0);
    var full = str_builder_add_cstr_a(default_alloc(), sb, buf);
    fl_free(buf);
    if (full != 0) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "the Touchstone text's builder can't grow");
        return Err(BJ_ERR_ALLOCATION);
    }
    return Ok(0);
}

# --- fdtd1d.cyr ---

# fdtd1d.cyr — fdtd.rs's 1D solver (M5 part 1a): `Fdtd1d`, the Yee algorithm for E_z and H_y travelling along x,
# with a first-order Mur absorbing boundary at each end, matched to the medium beside it. SI units.
#
# e_field[i] lives at x = i·dx and h_field[i] at x = (i + ½)·dx; h_field[num_cells − 1] lies outside the E domain and
# is never updated. The time step is half the 1D Courant limit, dt = dx/(2c).
#
# A grid's six arrays (E, H, ε_r, μ_r and the two update coefficients), and a scratch row for the update, are one
# anonymous mmap, fixed at construction and given back by BjFdtd1d_free (port plan §9.5). Rust's public, resizable
# `Vec` fields, and the per-step layout check that guarded them, are gone (ADR 0002 row 2): the fields `e_field` and
# `h_field` are the arrays' addresses and `num_cells` their length, and nothing can resize them. No step allocates.
# The Mur coefficients take a cancellation-free form where Rust's cancelled (`_bj_fd1_mur`, ADR 0002 row 40).
# The updates run on the packed f64v_* verbs, each lane rounding Rust's three operations, so the bits are Rust's
# (port plan §9.3, probe p10), except where a cell's update leaves the normal range: that cell runs it with an unbounded
# exponent (ADR 0002 row 18, src/crmath_edge.cyr's _bj_e_cell_row). The file is time-domain only; bijli's one harmonic
# convention, e^{+jωt}, is stated in src/complex.cyr's header.

private

var _BJ_FD1_INF: f64 = 0x7FF0000000000000;
# std::f64::consts::PI, as src/mathx.cyr's _BJ_PI (private to that file).
var _BJ_FD1_PI: f64 = 3.141592653589793;
# The grid's arrays, each num_cells f64, in one mapping: E, H, ε_r, μ_r, the E coefficients, the H coefficients and
# the update's scratch row.
var _BJ_FD1_ARRAYS = 7;
# The largest num_cells whose mapping (56 bytes a cell) a 64-bit length can hold.
var _BJ_FD1_MAX_CELLS = 164703072086692425;

# Rust's `run(steps, None, ..)`: no source cell. Rust's Some(cell) with cell ≥ num_cells injects nothing either, so
# usize::MAX (−1) is None exactly.
public var BJ_FDTD_NO_SOURCE = 0 - 1;

# 1D FDTD simulation state: E_z and H_y along x. `e_field` and `h_field` are the addresses of num_cells f64 (read and
# write them, as Rust's public vectors); `permittivity` and `permeability` hold ε_r per E node and μ_r per H node,
# `e_coeff` dt/(ε₀ε_r dx) and `h_coeff` dt/(μ₀μ_r dx). `dx` (m) and `dt` (s) are the steps, `step` the time-step
# index, `abc_left` and `abc_right` the Mur coefficients (v·dt − dx)/(v·dt + dx) with v the phase velocity beside each
# end. `work` is the update's scratch row (no Rust counterpart) and `map_bytes` the mapping's length (0 once freed).
# Mirrors `Fdtd1d`.
public struct BjFdtd1d {
    e_field;
    h_field;
    permittivity;
    permeability;
    e_coeff;
    h_coeff;
    dx: f64;
    dt: f64;
    step;
    num_cells;
    abc_left: f64;
    abc_right: f64;
    work;
    map_bytes;
}

# A word as a *f64 (the typed return keeps the binding typed).
#must_use
fn _bj_fd1_f64p(a): *f64 {
    return a;
}

# An update coefficient dt/(k₀·dx·m), m = ε_r or μ_r (1 at construction), rounded once (ADR 0002 row 13, M5 part 2b);
# Rust's (dt/(k₀·dx))/m rounded three times. Rust's chain stays where dt or dx isn't finite or dx is 0 (both are
# writable fields).
#must_use
fn _bj_fd1_coeff(dt: f64, k0: f64, dx: f64, m: f64): f64 {
    var kd: f64 = k0 * dx;
    var base: f64 = dt / kd;
    var r: f64 = base / m;
    var zt: f64 = dt * 0.0;
    var zx: f64 = dx * 0.0;
    if (zt == 0.0 && zx == 0.0 && dx != 0.0) {
        var num: f64[1];
        var den: f64[3];
        num[0] = dt;
        den[0] = k0;
        den[1] = dx;
        den[2] = m;
        r = _bj_k_cr_mono(&num, 1, &den, 3);
    }
    return r;
}

# 1 when x is finite and strictly positive (NaN-safe). Mirrors fdtd.rs's `is_positive_finite`.
#must_use
fn _bj_fd1_pos(x: f64): i64 {
    if (x > 0.0 && x < _BJ_FD1_INF) { return 1; }
    return 0;
}

# 2^-1022: the normal range's floor.
var _BJ_FD1_DMIN: f64 = 0x0010000000000000;

# 1 when x is 0, or finite with |x| ≥ 2^-1022.
#must_use
fn _bj_fd1_normal(x: f64): i64 {
    if (x == 0.0) { return 1; }
    var a: f64 = f64_abs(x);
    if (a >= _BJ_FD1_DMIN && a < _BJ_FD1_INF) { return 1; }
    return 0;
}

# 1 when the product z = x·y kept the normal range: z normal, or 0 from a zero factor (not an underflow).
#must_use
fn _bj_fd1_prod_ok(z: f64, x: f64, y: f64): i64 {
    if (_bj_fd1_normal(z) == 0) { return 0; }
    if (z == 0.0 && x != 0.0 && y != 0.0) { return 0; }
    return 1;
}

# x·y to 53 bits with an unbounded exponent, from the doubles x and y.
#must_use
fn _bj_fd1_mul2(x: f64, y: f64): (f64, i64) {
    var xs, xe = _bj_k_ux_from(x);
    var ys, ye = _bj_k_ux_from(y);
    var ps, pe = _bj_k_ux_mul(xs, xe, ys, ye);
    return (ps, pe);
}

# The value s·2^e as a double when it is normal (or zero): (1, it), else (0, 0.0).
#must_use
fn _bj_fd1_exact(s: f64, e): (i64, f64) {
    if (s == 0.0) { return (1, s); }
    if (e < 0 - 1022 || e > 1023) { return (0, 0.0); }
    var x: f64 = _bj_k_ux_round(s, e, 0.0);
    return (1, x);
}

# The cancellation-free form (c²dt² − ε_rμ_r·dx²)/(c·dt + dx·√(ε_rμ_r))² (ADR 0002 row 40, M5 part 2a-1b) on dt and dx
# scaled by the power of two 2^s that brings c·dt into [1, 2) (M5 part 2d-2b: the form is scale-free and the scaling
# exact, so in range the bits are part 2a-1b's, and it now holds at every scale). (cs, ce) is c·dt and (rs, re) is
# √(ε_rμ_r), each to 53 bits with an unbounded exponent. Returns (1, k), or (0, 0.0) where dt·2^s or dx·2^s isn't a
# normal double.
#must_use
fn _bj_fd1_mur_band(dt: f64, dx: f64, eps_r: f64, mu_r: f64, cs: f64, ce, rs: f64, re): (i64, f64) {
    var ts, te = _bj_k_ux_from(dt);
    var xs, xe = _bj_k_ux_from(dx);
    var ok1, dt2 = _bj_fd1_exact(ts, te - ce);
    var ok2, dx2 = _bj_fd1_exact(xs, xe - ce);
    if (ok1 == 0 || ok2 == 0) { return (0, 0.0); }
    var rv: f64[5];
    rv[0] = BJ_SPEED_OF_LIGHT;
    rv[1] = dt2;
    rv[2] = eps_r;
    rv[3] = mu_r;
    rv[4] = dx2;
    var ro: f64[1];
    if (_bj_cr_rat(&rv, 5, _bj_cr_rat_spec(11), 0, &ro) == 0) { return (0, 0.0); }
    var bs, be = _bj_k_ux_mul(xs, xe - ce, rs, re);
    var ok3, b2 = _bj_fd1_exact(bs, be);
    if (ok3 == 0) { return (0, 0.0); }
    var s: f64 = cs + b2;
    var s2: f64 = s * s;
    var n: f64 = ro[0];
    var k: f64 = n / s2;
    return (1, k);
}

# The first-order Mur coefficient (v·dt − dx)/(v·dt + dx), v = c/√(ε_r μ_r): Rust's c·dt/√(ε_r μ_r). For finite,
# positive arguments:
# - where the unbounded v·dt lies in (2dx/3, 2dx), its difference with dx at least doubles v·dt's rounding error,
#   cancelling outright at ε_rμ_r = 1/4 (k = 0, perfect absorption at dt = dx/2c), so there it takes the
#   cancellation-free form (_bj_fd1_mur_band; ADR 0002 row 40, M5 parts 2a-1b and 2d-2b);
# - elsewhere, where ε_rμ_r, its root, c·dt, v·dt, v·dt − dx or v·dt + dx leaves the normal range, the chain runs with
#   an unbounded exponent and the quotient is rounded once (ADR 0002 row 18, M5 part 2d-2b: ε_rμ_r below the range gave
#   v·dt = ∞ and k = NaN where it is near 1);
# - and otherwise, as for any other argument, Rust's chain. Mirrors fdtd.rs's `mur_coefficient`.
#must_use
fn _bj_fd1_mur(dt: f64, dx: f64, eps_r: f64, mu_r: f64): f64 {
    var em: f64 = eps_r * mu_r;
    var root: f64 = f64_sqrt(em);
    var c: f64 = BJ_SPEED_OF_LIGHT;
    var cdt: f64 = c * dt;
    var v_dt: f64 = cdt / root;
    var num: f64 = v_dt - dx;
    var den: f64 = v_dt + dx;
    var k: f64 = num / den;
    var z: f64 = dt * 0.0 + dx * 0.0 + eps_r * 0.0 + mu_r * 0.0;
    if (z != 0.0 || dt <= 0.0 || dx <= 0.0 || eps_r <= 0.0 || mu_r <= 0.0) { return k; }
    var as, ae = _bj_k_ux_from(eps_r);
    var bs, be = _bj_k_ux_from(mu_r);
    var es, ee = _bj_k_ux_mul(as, ae, bs, be);
    var rs, re = _bj_k_ux_sqrt(es, ee);
    var cxs, cxe = _bj_k_ux_from(c);
    var ts, te = _bj_k_ux_from(dt);
    var cs, ce = _bj_k_ux_mul(cxs, cxe, ts, te);
    var vs, ve = _bj_k_ux_div(cs, ce, rs, re);
    var xs, xe = _bj_k_ux_from(dx);
    var v3s, v3e = _bj_k_ux_mul(3.0, 0, vs, ve);
    if (_bj_k_ux_cmp(v3s, v3e, xs, xe + 1) == 1 && _bj_k_ux_cmp(vs, ve, xs, xe + 1) == 0 - 1) {
        var ok, kb = _bj_fd1_mur_band(dt, dx, eps_r, mu_r, cs, ce, rs, re);
        if (ok == 1) { return kb; }
    }
    var nrm = _bj_fd1_normal(em) & _bj_fd1_normal(root) & _bj_fd1_normal(cdt) & _bj_fd1_normal(v_dt);
    nrm = nrm & _bj_fd1_normal(num) & _bj_fd1_normal(den);
    if (nrm == 1) { return k; }
    var ns, ne = _bj_k_ux_sub(vs, ve, xs, xe);
    var qs, qe = _bj_k_ux_add(vs, ve, xs, xe);
    var ku: f64 = _bj_k_ux_div_f64(ns, ne, qs, qe);
    return ku;
}

# Creates a 1D grid of num_cells cells (a usize) and spacing dx (m) into *out, every field zero, vacuum everywhere,
# dt = dx/(2c) and the vacuum Mur coefficient at both ends: Ok(0); or, with out untouched, Err(InsufficientResolution)
# for num_cells < 2, Err(InvalidParameter) "dx must be finite and positive, got {dx}", Err(Allocation) when the
# grid's mapping can't be had (Rust's vec! aborts there; ADR 0002 row 9). Give the grid back with BjFdtd1d_free.
# Mirrors `Fdtd1d::new`.
#must_use
public fn BjFdtd1d_new(num_cells, dx: f64, out: *BjFdtd1d): Result {
    if (num_cells >= 0 && num_cells < 2) {
        var nf: f64 = f64_from(num_cells);
        var size: f64 = nf * dx;
        return Err(_bj_err_insufficient_resolution(num_cells, size));
    }
    if (_bj_fd1_pos(dx) == 0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "dx must be finite and positive, got ");
        _bj_fmt_f64_display(t, dx);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var map = 0;
    if (num_cells > 0 && num_cells <= _BJ_FD1_MAX_CELLS) { map = mmap_anon(num_cells * 8 * _BJ_FD1_ARRAYS); }
    if (map == 0) {
        var ta = _bj_err_reason(BJ_ERR_ALLOCATION);
        _bj_tx_cstr(ta, "a 1D FDTD grid of ");
        _bj_tx_u64(ta, num_cells);
        _bj_tx_cstr(ta, " cells");
        return Err(BJ_ERR_ALLOCATION);
    }
    var c: f64 = BJ_SPEED_OF_LIGHT;
    var c2: f64 = 2.0 * c;
    var dt: f64 = dx / c2;
    var ce: f64 = _bj_fd1_coeff(dt, BJ_EPSILON_0, dx, 1.0);
    var ch: f64 = _bj_fd1_coeff(dt, BJ_MU_0, dx, 1.0);
    var abc: f64 = _bj_fd1_mur(dt, dx, 1.0, 1.0);
    var n = num_cells;
    var eps: *f64 = _bj_fd1_f64p(map + 2 * n * 8);
    var mu: *f64 = _bj_fd1_f64p(map + 3 * n * 8);
    var cep: *f64 = _bj_fd1_f64p(map + 4 * n * 8);
    var chp: *f64 = _bj_fd1_f64p(map + 5 * n * 8);
    for (var i = 0; i < n; i = i + 1) {
        eps[i] = 1.0;
        mu[i] = 1.0;
        cep[i] = ce;
        chp[i] = ch;
    }
    out.e_field = map;
    out.h_field = map + n * 8;
    out.permittivity = map + 2 * n * 8;
    out.permeability = map + 3 * n * 8;
    out.e_coeff = map + 4 * n * 8;
    out.h_coeff = map + 5 * n * 8;
    out.work = map + 6 * n * 8;
    out.dx = dx;
    out.dt = dt;
    out.step = 0;
    out.num_cells = n;
    out.abc_left = abc;
    out.abc_right = abc;
    out.map_bytes = n * 8 * _BJ_FD1_ARRAYS;
    if (_bj_log_on(4) == 1) {
        var lb[256];
        var lt[24];
        _bj_tx_init(&lt, &lb, 256);
        _bj_tx_cstr(&lt, "FDTD 1D simulation created num_cells=");
        _bj_tx_u64(&lt, n);
        _bj_tx_cstr(&lt, " dx=");
        _bj_fmt_f64_debug(&lt, dx);
        _bj_tx_cstr(&lt, " dt=");
        _bj_fmt_f64_debug(&lt, dt);
        _bj_tx_cstr(&lt, " abc_coeff=");
        _bj_fmt_f64_debug(&lt, abc);
        _bj_log_text(4, &lt);
    }
    return Ok(0);
}

# Gives a grid's mapping back and empties it (num_cells 0, every address 0); a second call does nothing.
public fn BjFdtd1d_free(sim: *BjFdtd1d): i64 {
    if (sim.map_bytes > 0) { cyr_munmap(sim.e_field, sim.map_bytes); }
    sim.e_field = 0;
    sim.h_field = 0;
    sim.permittivity = 0;
    sim.permeability = 0;
    sim.e_coeff = 0;
    sim.h_coeff = 0;
    sim.work = 0;
    sim.num_cells = 0;
    sim.map_bytes = 0;
    return 0;
}

# min(end, n) for usize words: a negative word is past 2^63, so above n.
#must_use
fn _bj_fd1_umin(end, n): i64 {
    if (end < 0 || end > n) { return n; }
    return end;
}

# The source sample amplitude·sin((2π·f)·(step·dt)) with an unbounded exponent (ADR 0002 row 18, M5 part 2d-2b): t, 2πf
# and the phase to 53 bits, the sine by _bj_vx_sin53 (Payne–Hanek past DBL_MAX), the product rounded once. sf is Rust's
# `step as f64`.
#must_use
fn _bj_fd1_source_ux(sf: f64, dt: f64, w: f64, f: f64, amp: f64): f64 {
    var ts, te = _bj_fd1_mul2(sf, dt);
    var ws, we = _bj_fd1_mul2(w, f);
    var ps, pe = _bj_k_ux_mul(ws, we, ts, te);
    var ss, se = _bj_vx_sin53(ps, pe);
    var as, ae = _bj_k_ux_from(amp);
    var v: f64 = _bj_k_ux_mul_f64(as, ae, ss, se);
    return v;
}

# 1 when every field, ε_r, μ_r and dx of the grid is finite.
#must_use
fn _bj_fd1_finite_fields(sim: *BjFdtd1d): i64 {
    var e: *f64 = _bj_fd1_f64p(sim.e_field);
    var h: *f64 = _bj_fd1_f64p(sim.h_field);
    var eps: *f64 = _bj_fd1_f64p(sim.permittivity);
    var mu: *f64 = _bj_fd1_f64p(sim.permeability);
    var z: f64 = sim.dx * 0.0;
    for (var i = 0; i < sim.num_cells; i = i + 1) {
        var zi: f64 = e[i] * 0.0 + h[i] * 0.0 + eps[i] * 0.0 + mu[i] * 0.0;
        z = z + zi;
    }
    if (z == 0.0) { return 1; }
    return 0;
}

# total_energy's chain with an unbounded exponent (ADR 0002 row 18, M5 part 2d-2b): each product, term and partial sum
# to 53 bits, the sum from −0.0, and sum·dx rounded once.
#must_use
fn _bj_fd1_energy_ux(sim: *BjFdtd1d): f64 {
    var e: *f64 = _bj_fd1_f64p(sim.e_field);
    var h: *f64 = _bj_fd1_f64p(sim.h_field);
    var eps: *f64 = _bj_fd1_f64p(sim.permittivity);
    var mu: *f64 = _bj_fd1_f64p(sim.permeability);
    var ss: f64 = -0.0;
    var se = 0;
    var e0s, e0e = _bj_k_ux_from(BJ_EPSILON_0);
    var m0s, m0e = _bj_k_ux_from(BJ_MU_0);
    for (var i = 0; i < sim.num_cells; i = i + 1) {
        var es, ee = _bj_k_ux_from(e[i]);
        var hs, he = _bj_k_ux_from(h[i]);
        var a1s, a1e = _bj_fd1_mul2(0.5, eps[i]);
        var a2s, a2e = _bj_k_ux_mul(a1s, a1e, e0s, e0e);
        var a3s, a3e = _bj_k_ux_mul(a2s, a2e, es, ee);
        var as, ae = _bj_k_ux_mul(a3s, a3e, es, ee);
        var b1s, b1e = _bj_fd1_mul2(0.5, mu[i]);
        var b2s, b2e = _bj_k_ux_mul(b1s, b1e, m0s, m0e);
        var b3s, b3e = _bj_k_ux_mul(b2s, b2e, hs, he);
        var bs, be = _bj_k_ux_mul(b3s, b3e, hs, he);
        var ts, te = _bj_k_ux_add(as, ae, bs, be);
        var ns, ne = _bj_k_ux_add(ss, se, ts, te);
        ss = ns;
        se = ne;
    }
    var xs, xe = _bj_k_ux_from(sim.dx);
    var en: f64 = _bj_k_ux_mul_f64(ss, se, xs, xe);
    return en;
}

impl BjFdtd1d {
    # Recomputes the Mur coefficients from the medium beside each end: ε_r of E node 1 and μ_r of H node 0 on the
    # left, both at n − 2 on the right. Mirrors `update_abc_coefficients`.
    fn update_abc_coefficients(self) {
        var n = self.num_cells;
        if (n < 2) { return 0; }
        var eps: *f64 = _bj_fd1_f64p(self.permittivity);
        var mu: *f64 = _bj_fd1_f64p(self.permeability);
        var dt: f64 = self.dt;
        var dx: f64 = self.dx;
        var e1: f64 = eps[1];
        var m0: f64 = mu[0];
        var kl: f64 = _bj_fd1_mur(dt, dx, e1, m0);
        var er: f64 = eps[n - 2];
        var mr: f64 = mu[n - 2];
        var kr: f64 = _bj_fd1_mur(dt, dx, er, mr);
        self.abc_left = kl;
        self.abc_right = kr;
        return 0;
    }

    # Sets ε_r on cells start..end (usize; end clamped to the grid) and recomputes the Mur coefficients: Ok(0), or
    # Err(InvalidPermittivity) with the grid untouched unless eps_r is finite and positive. Mirrors
    # `Fdtd1d::set_permittivity`.
    #must_use
    public fn set_permittivity(self, start, end, eps_r: f64): Result {
        if (_bj_fd1_pos(eps_r) == 0) { return Err(_bj_err_invalid_permittivity(eps_r)); }
        var hi = _bj_fd1_umin(end, self.num_cells);
        var ce: f64 = _bj_fd1_coeff(self.dt, BJ_EPSILON_0, self.dx, eps_r);
        var eps: *f64 = _bj_fd1_f64p(self.permittivity);
        var cep: *f64 = _bj_fd1_f64p(self.e_coeff);
        if (start >= 0) {
            for (var i = start; i < hi; i = i + 1) {
                eps[i] = eps_r;
                cep[i] = ce;
            }
        }
        self.update_abc_coefficients();
        return Ok(0);
    }

    # Sets μ_r on cells start..end (usize; end clamped to the grid) and recomputes the Mur coefficients: Ok(0), or
    # Err(InvalidPermeability) with the grid untouched unless mu_r is finite and positive. Mirrors
    # `Fdtd1d::set_permeability`.
    #must_use
    public fn set_permeability(self, start, end, mu_r: f64): Result {
        if (_bj_fd1_pos(mu_r) == 0) { return Err(_bj_err_invalid_permeability(mu_r)); }
        var hi = _bj_fd1_umin(end, self.num_cells);
        var ch: f64 = _bj_fd1_coeff(self.dt, BJ_MU_0, self.dx, mu_r);
        var mu: *f64 = _bj_fd1_f64p(self.permeability);
        var chp: *f64 = _bj_fd1_f64p(self.h_coeff);
        if (start >= 0) {
            for (var i = start; i < hi; i = i + 1) {
                mu[i] = mu_r;
                chp[i] = ch;
            }
        }
        self.update_abc_coefficients();
        return Ok(0);
    }

    # Adds value to E at cell (a soft source); a cell outside the grid is ignored. Mirrors `Fdtd1d::add_source`.
    public fn add_source(self, cell, value: f64) {
        if (cell >= 0 && cell < self.num_cells) {
            var e: *f64 = _bj_fd1_f64p(self.e_field);
            var x: f64 = e[cell];
            e[cell] = x + value;
        }
        return 0;
    }

    # Advances one time step: H from E, then the interior E from H, then the Mur boundaries,
    # E₀ⁿ⁺¹ = E₁ⁿ + k (E₁ⁿ⁺¹ − E₀ⁿ) and its mirror at the right end (Mur 1981; Taflove & Hagness, ch. 7); a cell whose
    # update leaves the normal range runs it with an unbounded exponent, rounded once (ADR 0002 row 18, M5 parts 2d-2a
    # and 2d-3: src/crmath_edge.cyr's _bj_e_cell_row). Mirrors `Fdtd1d::step_once`.
    public fn step_once(self) {
        var n = self.num_cells;
        if (n < 2) {
            self.step = self.step + 1;
            return 0;
        }
        var e: *f64 = _bj_fd1_f64p(self.e_field);
        var h: *f64 = _bj_fd1_f64p(self.h_field);
        var ce: *f64 = _bj_fd1_f64p(self.e_coeff);
        var ch: *f64 = _bj_fd1_f64p(self.h_coeff);
        var w: *f64 = _bj_fd1_f64p(self.work);
        var e_left: f64 = e[1];
        var e_right: f64 = e[n - 2];
        # H[i] += c_h[i]·(E[i + 1] − E[i]) for i < n − 1, then E[i] += c_e[i]·(H[i] − H[i − 1]) for 0 < i < n − 1.
        _bj_e_cell_row(h, ch, 8, e + 1, e, w, n - 1);
        _bj_e_cell_row(e + 1, ce + 1, 8, h + 1, h, w, n - 2);
        e[0] = _bj_e_cell_one(e_left, self.abc_left, e[1], e[0]);
        e[n - 1] = _bj_e_cell_one(e_right, self.abc_right, e[n - 2], e[n - 1]);
        self.step = self.step + 1;
        return 0;
    }

    # Runs `steps` time steps (a usize). Before each, when source_cell is in the grid, adds
    # source_amplitude·sin(2π·source_frequency·t) at it, t = step·dt; BJ_FDTD_NO_SOURCE (or any cell outside the
    # grid) injects nothing, as Rust's None. Where t, 2πf or the phase leaves the normal range for finite arguments
    # (the phase past DBL_MAX, where Rust took the sine of ∞), the sample runs with an unbounded exponent, the sine past
    # DBL_MAX by Payne–Hanek (ADR 0002 row 18, M5 part 2d-2b). Mirrors `Fdtd1d::run`.
    public fn run(self, steps, source_cell, source_frequency: f64, source_amplitude: f64) {
        if (_bj_log_on(4) == 1) {
            var lb[256];
            var lt[24];
            _bj_tx_init(&lt, &lb, 256);
            _bj_tx_cstr(&lt, "FDTD run started steps=");
            _bj_tx_u64(&lt, steps);
            _bj_tx_cstr(&lt, " source_cell=");
            if (source_cell == BJ_FDTD_NO_SOURCE) { _bj_tx_cstr(&lt, "None"); }
            else {
                _bj_tx_cstr(&lt, "Some(");
                _bj_tx_u64(&lt, source_cell);
                _bj_tx_cstr(&lt, ")");
            }
            _bj_tx_cstr(&lt, " source_frequency=");
            _bj_fmt_f64_debug(&lt, source_frequency);
            _bj_tx_cstr(&lt, " source_amplitude=");
            _bj_fmt_f64_debug(&lt, source_amplitude);
            _bj_log_text(4, &lt);
        }
        var inject = 0;
        if (source_cell >= 0 && source_cell < self.num_cells) { inject = 1; }
        var w: f64 = 2.0 * _BJ_FD1_PI;
        for (var k = 0; k != steps; k = k + 1) {
            if (inject == 1) {
                var sf: f64 = f64_from(self.step);
                var dt: f64 = self.dt;
                var t: f64 = sf * dt;
                var wf: f64 = w * source_frequency;
                var arg: f64 = wf * t;
                var s: f64 = _bj_sin(arg);
                var v: f64 = source_amplitude * s;
                var ok = _bj_fd1_prod_ok(t, sf, dt) & _bj_fd1_prod_ok(wf, w, source_frequency);
                ok = ok & _bj_fd1_prod_ok(arg, wf, t);
                var zf: f64 = dt * 0.0 + source_frequency * 0.0 + source_amplitude * 0.0;
                if (ok == 0 && zf == 0.0) { v = _bj_fd1_source_ux(sf, dt, w, source_frequency, source_amplitude); }
                self.add_source(source_cell, v);
            }
            self.step_once();
        }
        return 0;
    }

    # The simulation time step·dt (s), rounded once: a step past 2^53 (a written field) is split exactly as
    # s_hi + s_lo, where Rust's `step as f64` rounded first (ADR 0002 row 13, M5 part 2b). Mirrors `Fdtd1d::time`.
    #must_use
    public fn time(self): f64 {
        var s = self.step;
        var dt: f64 = self.dt;
        var sf: f64 = f64_from(s);
        var t: f64 = sf * dt;
        var z: f64 = dt * 0.0;
        if ((s < 0 || s > 9007199254740992) && z == 0.0) {
            var hi = (s >> 11) << 11;
            var rv: f64[3];
            var hf: f64 = f64_from(hi >> 11);
            rv[0] = hf * 2048.0;
            rv[1] = dt;
            rv[2] = f64_from(s & 2047);
            var ro: f64[1];
            if (_bj_cr_rat(&rv, 3, _bj_cr_rat_spec(14), 0, &ro) == 1) { t = ro[0]; }
        }
        return t;
    }

    # The field energy per unit area, dx·Σ(½ε_rε₀E² + ½μ_rμ₀H²), summed from −0.0 as Rust's `Sum`. Where a product,
    # a term or the running sum leaves the normal range for finite fields (E² past DBL_MAX, or below the range, while
    # the energy is representable), the whole chain runs with an unbounded exponent and the last product is rounded
    # once (ADR 0002 row 18, M5 part 2d-2b). Mirrors `Fdtd1d::total_energy`.
    #must_use
    public fn total_energy(self): f64 {
        var e: *f64 = _bj_fd1_f64p(self.e_field);
        var h: *f64 = _bj_fd1_f64p(self.h_field);
        var eps: *f64 = _bj_fd1_f64p(self.permittivity);
        var mu: *f64 = _bj_fd1_f64p(self.permeability);
        var sum: f64 = -0.0;
        var ok = 1;
        for (var i = 0; i < self.num_cells; i = i + 1) {
            var ei: f64 = e[i];
            var hi: f64 = h[i];
            var ep: f64 = eps[i];
            var mp: f64 = mu[i];
            var a1: f64 = 0.5 * ep;
            var a2: f64 = a1 * BJ_EPSILON_0;
            var a3: f64 = a2 * ei;
            var a: f64 = a3 * ei;
            var b1: f64 = 0.5 * mp;
            var b2: f64 = b1 * BJ_MU_0;
            var b3: f64 = b2 * hi;
            var b: f64 = b3 * hi;
            var term: f64 = a + b;
            sum = sum + term;
            if (ok == 1) {
                ok = _bj_fd1_prod_ok(a1, 0.5, ep) & _bj_fd1_prod_ok(a2, a1, BJ_EPSILON_0) & _bj_fd1_prod_ok(a3, a2, ei);
                ok = ok & _bj_fd1_prod_ok(a, a3, ei) & _bj_fd1_prod_ok(b1, 0.5, mp) & _bj_fd1_prod_ok(b2, b1, BJ_MU_0);
                ok = ok & _bj_fd1_prod_ok(b3, b2, hi) & _bj_fd1_prod_ok(b, b3, hi);
                ok = ok & _bj_fd1_normal(term) & _bj_fd1_normal(sum);
            }
        }
        var dx: f64 = self.dx;
        var energy: f64 = sum * dx;
        if (ok == 0 && _bj_fd1_finite_fields(self) == 1) { energy = _bj_fd1_energy_ux(self); }
        return energy;
    }
}

# --- fdtd_source.cyr ---

# fdtd_source.cyr — fdtd.rs's sources (M5 part 1b): the Gaussian pulse, the Ricker wavelet, the differentiated and the
# modulated Gaussian, and the total-field/scattered-field plane-wave source `TfsfSource`. SI units: times in seconds,
# frequencies in Hz, lengths in metres.
#
# The pulses are Rust's chains on src/crmath.cyr's correctly rounded exp and sin. A width τ of 0 or NaN gives 0.0.
#
# A BjTfsfSource holds the 1D auxiliary grid that carries the incident plane wave (E_z, H_y travelling in +x), with a
# first-order Mur boundary at each end. Its two arrays and a scratch row are one anonymous mmap, fixed at construction
# and given back by BjTfsfSource_free (ADR 0002 row 2): `inc_e` and `inc_h` are their addresses and `nx` their length.
# The updates run on the packed f64v_* verbs, each lane rounding Rust's three operations (port plan §9.3), and a cell
# whose update leaves the normal range runs it with an unbounded exponent (ADR 0002 row 18). Rust's
# `TfsfSource::new` clamped invalid input with a warning; here both constructors validate and return Err, as
# `try_new` does (ADR 0002 row 3). The file is time-domain only; bijli's one harmonic convention, e^{+jωt}, is stated
# in src/complex.cyr's header.

private

var _BJ_FS_INF: f64 = 0x7FF0000000000000;
# std::f64::consts::PI, as src/mathx.cyr's _BJ_PI (private to that file).
var _BJ_FS_PI: f64 = 3.141592653589793;
# 10⁻¹²: the tolerance on the 1D Courant limit c·dt ≤ dx·(1 + 10⁻¹²), so dt = dx/c computed in binary64 passes.
var _BJ_FS_REL12: f64 = 0.000000000001;
# The largest nx whose mapping (24 bytes a cell: E, H and the scratch row) a 64-bit length can hold.
var _BJ_FS_MAX_CELLS = 384307168202282325;

# A word as a *f64 (the typed return keeps the binding typed).
#must_use
fn _bj_fs_f64p(a): *f64 {
    return a;
}

# 1 when c·dt > dx·(1 + 10⁻¹²) exactly, the decimal 10⁻¹² (ADR 0002 row 17, M5 part 2c), for finite dt, dx > 0: the
# rounded c·dt against RN(dx·RN(1 + 1e-12)) decides outside ±10⁻⁶ (their errors are below 2^-51); inside, and where
# either is ∞ or below DBL_MIN, the sign of the exact 10¹²·c·dt − (10¹² + 1)·dx (src/crmath_edge.cyr's rational 15).
# Rust's rounded test accepted dt up to a few ulps past the limit (the double 1 + 1e-12 lies above 1 + 10⁻¹²).
#must_use
fn _bj_fs_courant_over(dt: f64, dx: f64): i64 {
    var c: f64 = BJ_SPEED_OF_LIGHT;
    var cdt: f64 = c * dt;
    var tol: f64 = 1.0 + _BJ_FS_REL12;
    var lim: f64 = dx * tol;
    var dmin: f64 = 0x0010000000000000;
    if (cdt < _BJ_FS_INF && lim < _BJ_FS_INF && cdt >= dmin && lim >= dmin) {
        var lo: f64 = lim * 0.999999;
        var hi: f64 = lim * 1.000001;
        if (cdt < lo) { return 0; }
        if (cdt > hi) { return 1; }
    }
    var rv: f64[5];
    rv[0] = 1000000000000.0;
    rv[1] = c;
    rv[2] = dt;
    rv[3] = 1000000000001.0;
    rv[4] = dx;
    var ro: f64[1];
    var k = _bj_cr_rat(&rv, 5, _bj_cr_rat_spec(15), 0, &ro);
    var s: f64 = ro[0];
    if (s > 0.0) { return 1; }
    return 0;
}

# 1 when x is finite and strictly positive (NaN-safe). Mirrors fdtd.rs's `is_positive_finite`.
#must_use
fn _bj_fs_pos(x: f64): i64 {
    if (x > 0.0 && x < _BJ_FS_INF) { return 1; }
    return 0;
}

# 1 when a ≥ b as usize words (a negative word is past 2^63).
#must_use
fn _bj_fs_uge(a, b): i64 {
    if ((a < 0) == (b < 0)) {
        if (a >= b) { return 1; }
        return 0;
    }
    if (a < 0) { return 1; }
    return 0;
}

# ── the pulses ──────────────────────────────────────────────────────────────────────────────────────────────────────

# 2^-1022 and 2^-300: the normal range's floor, and the |x| below which e^x is 1 at 53 bits.
var _BJ_FS_DMIN: f64 = 0x0010000000000000;
var _BJ_FS_2M300: f64 = 0x2D30000000000000;

# 1 when x is 0, or finite with |x| ≥ 2^-1022: an intermediate the pulses' chains can keep (ADR 0002 row 18).
#must_use
fn _bj_fs_normal(x: f64): i64 {
    if (x == 0.0) { return 1; }
    var a: f64 = f64_abs(x);
    if (a >= _BJ_FS_DMIN && a < _BJ_FS_INF) { return 1; }
    return 0;
}

# 1 when every one of t, t₀ and τ is finite.
#must_use
fn _bj_fs_fin3(t: f64, t0: f64, tau: f64): i64 {
    var z: f64 = t * 0.0 + t0 * 0.0 + tau * 0.0;
    if (z == 0.0) { return 1; }
    return 0;
}

# u = (t − t₀)/τ, each operation to 53 bits with an unbounded exponent: (s, e).
#must_use
fn _bj_fs_arg_ux(t: f64, t0: f64, tau: f64): (f64, i64) {
    var ts, te = _bj_k_ux_from(t);
    var us, ue = _bj_k_ux_from(t0);
    var ds, de = _bj_k_ux_sub(ts, te, us, ue);
    var vs, ve = _bj_k_ux_from(tau);
    var as, ae = _bj_k_ux_div(ds, de, vs, ve);
    return (as, ae);
}

# e^x to 53 bits with an unbounded exponent for the 53-bit x = xs·2^xe: 1 for x = 0 or |x| < 2^-300 (e^x rounds to 1),
# _bj_ux_exp_wide's value to |x| = 2^47, and its far stand-in (1, ±_BJ_UX_FAR) beyond.
#must_use
fn _bj_fs_exp_ux(xs: f64, xe): (f64, i64) {
    if (xs == 0.0) { return (1.0, 0); }
    if (xe > 46) {
        if (xs > 0.0) { return (1.0, _BJ_UX_FAR); }
        return (1.0, 0 - _BJ_UX_FAR);
    }
    var x: f64 = _bj_k_ux_round(xs, xe, 0.0);
    var ax: f64 = f64_abs(x);
    if (ax < _BJ_FS_2M300) { return (1.0, 0); }
    var gs, ge = _bj_ux_exp_wide(x);
    return (gs, ge);
}

# 1 when τ is 0 or NaN, where every pulse is 0.0.
#must_use
fn _bj_fs_no_width(tau: f64): i64 {
    if (tau == 0.0 || tau != tau) { return 1; }
    return 0;
}

# The Gaussian pulse exp(−((t − t₀)/τ)²): 1 at t₀; 0.0 for τ = 0 or NaN. Where t − t₀ overflows for finite arguments
# (against a τ that brings u back), the chain runs with an unbounded exponent to its exp (ADR 0002 row 18, M5 part
# 2d-1); its other edges need nothing (a subnormal t − t₀ is exact, a subnormal u gives e⁰ = 1, an infinite one 0, as
# the unbounded chain does). Mirrors `gaussian_pulse`.
#must_use
public fn bj_gaussian_pulse(t: f64, t0: f64, tau: f64): f64 {
    if (_bj_fs_no_width(tau) == 1) { return 0.0; }
    var d: f64 = t - t0;
    var arg: f64 = d / tau;
    var na: f64 = -arg;
    var x: f64 = na * arg;
    var g: f64 = _bj_exp(x);
    var ad: f64 = f64_abs(d);
    if (ad == _BJ_FS_INF && _bj_fs_fin3(t, t0, tau) == 1) {
        var as, ae = _bj_fs_arg_ux(t, t0, tau);
        var ns, ne = _bj_k_ux_neg(as, ae);
        var xs, xe = _bj_k_ux_mul(ns, ne, as, ae);
        if (xs == 0.0) { return 1.0; }
        if (xe > 10) { return 0.0; }
        var xd: f64 = _bj_k_ux_round(xs, xe, 0.0);
        g = _bj_exp(xd);
    }
    return g;
}

# The Ricker wavelet (1 − 2u²)·exp(−u²), u = (t − t₀)/τ: even, 1 at t₀, no DC content; 0.0 for τ = 0 or NaN. Where an
# intermediate leaves the normal range for finite arguments (u² past DBL_MAX, where Rust's −∞·0 was NaN for −0;
# e^{−u²} below 2^-1022 while 1 − 2u² lifts the product back; t − t₀ or u past either end), the chain runs with an
# unbounded exponent and the product is rounded once (ADR 0002 row 18, M5 part 2d-1). Mirrors `ricker_wavelet`.
#must_use
public fn bj_ricker_wavelet(t: f64, t0: f64, tau: f64): f64 {
    if (_bj_fs_no_width(tau) == 1) { return 0.0; }
    var d: f64 = t - t0;
    var arg: f64 = d / tau;
    var arg2: f64 = arg * arg;
    var a: f64 = 2.0 * arg2;
    var c: f64 = 1.0 - a;
    var na: f64 = -arg2;
    var g: f64 = _bj_exp(na);
    var r: f64 = c * g;
    var ok = _bj_fs_normal(d) & _bj_fs_normal(arg) & _bj_fs_normal(arg2) & _bj_fs_normal(g);
    if (_bj_fs_fin3(t, t0, tau) == 1 && ok == 0) {
        var as, ae = _bj_fs_arg_ux(t, t0, tau);
        var a2s, a2e = _bj_k_ux_mul(as, ae, as, ae);
        var cs, ce = _bj_k_ux_sub(1.0, 0, a2s, a2e + 1);
        var ns, ne = _bj_k_ux_neg(a2s, a2e);
        var gs, ge = _bj_fs_exp_ux(ns, ne);
        r = _bj_k_ux_mul_f64(cs, ce, gs, ge);
    }
    return r;
}

# The differentiated Gaussian −2(t − t₀)/τ²·exp(−((t − t₀)/τ)²), the time derivative of the Gaussian pulse, as Rust's
# (−2u/τ)·exp(−u²); 0.0 for τ = 0 or NaN. Where an intermediate leaves the normal range for finite arguments (−2u/τ
# past DBL_MAX against an e^{−u²} below 2^-1022, Rust's ∞·0 = NaN; u subnormal), the chain runs with an unbounded
# exponent and the product is rounded once (ADR 0002 row 18, M5 part 2d-1). Mirrors `differentiated_gaussian`.
#must_use
public fn bj_differentiated_gaussian(t: f64, t0: f64, tau: f64): f64 {
    if (_bj_fs_no_width(tau) == 1) { return 0.0; }
    var d: f64 = t - t0;
    var arg: f64 = d / tau;
    var m: f64 = -2.0 * arg;
    var q: f64 = m / tau;
    var na: f64 = -arg;
    var x: f64 = na * arg;
    var g: f64 = _bj_exp(x);
    var r: f64 = q * g;
    var ok = _bj_fs_normal(d) & _bj_fs_normal(arg) & _bj_fs_normal(q) & _bj_fs_normal(g);
    if (_bj_fs_fin3(t, t0, tau) == 1 && ok == 0) {
        var as, ae = _bj_fs_arg_ux(t, t0, tau);
        var ms, me = _bj_k_ux_neg(as, ae + 1);
        var vs, ve = _bj_k_ux_from(tau);
        var qs, qe = _bj_k_ux_div(ms, me, vs, ve);
        var ns, ne = _bj_k_ux_neg(as, ae);
        var xs, xe = _bj_k_ux_mul(ns, ne, as, ae);
        var gs, ge = _bj_fs_exp_ux(xs, xe);
        r = _bj_k_ux_mul_f64(qs, qe, gs, ge);
    }
    return r;
}

# The modulated Gaussian exp(−((t − t₀)/τ)²)·sin(2πf₀(t − t₀)), its sine's argument Rust's (2π·f₀)·(t − t₀); 0.0 for
# τ = 0 or NaN. Where an intermediate leaves the normal range for finite arguments (the phase past DBL_MAX, where Rust
# took the sine of ∞; e^{−u²} below 2^-1022; t − t₀, u or 2πf₀ past either end), the chain runs with an unbounded
# exponent, the sine past DBL_MAX by Payne–Hanek (_bj_vx_sin53), and the product is rounded once (ADR 0002 row 18, M5
# part 2d-1). Mirrors `modulated_gaussian_pulse`.
#must_use
public fn bj_modulated_gaussian_pulse(t: f64, t0: f64, tau: f64, frequency: f64): f64 {
    if (_bj_fs_no_width(tau) == 1) { return 0.0; }
    var d: f64 = t - t0;
    var arg: f64 = d / tau;
    var na: f64 = -arg;
    var x: f64 = na * arg;
    var g: f64 = _bj_exp(x);
    var w: f64 = 2.0 * _BJ_FS_PI;
    var wf: f64 = w * frequency;
    var ph: f64 = wf * d;
    var s: f64 = _bj_sin(ph);
    var r: f64 = g * s;
    var ok = _bj_fs_normal(d) & _bj_fs_normal(arg) & _bj_fs_normal(g) & _bj_fs_normal(wf) & _bj_fs_normal(ph);
    var zf: f64 = frequency * 0.0;
    if (_bj_fs_fin3(t, t0, tau) == 1 && zf == 0.0 && ok == 0) {
        var as, ae = _bj_fs_arg_ux(t, t0, tau);
        var ns, ne = _bj_k_ux_neg(as, ae);
        var xs, xe = _bj_k_ux_mul(ns, ne, as, ae);
        var gs, ge = _bj_fs_exp_ux(xs, xe);
        var ts, te = _bj_k_ux_from(t);
        var us, ue = _bj_k_ux_from(t0);
        var ds, de = _bj_k_ux_sub(ts, te, us, ue);
        var ws, we = _bj_k_ux_from(w);
        var fs, fe = _bj_k_ux_from(frequency);
        var wfs, wfe = _bj_k_ux_mul(ws, we, fs, fe);
        var ps, pe = _bj_k_ux_mul(wfs, wfe, ds, de);
        var ss, se = _bj_vx_sin53(ps, pe);
        r = _bj_k_ux_mul_f64(gs, ge, ss, se);
    }
    return r;
}

# ── the TF/SF source ────────────────────────────────────────────────────────────────────────────────────────────────

# A TF/SF plane-wave source: the 1D auxiliary grid of the incident wave. `inc_e` and `inc_h` are the addresses of nx
# f64 each: E^inc at x = i·dx and H^inc at x = (i + ½)·dx (inc_h[nx − 1] stays 0); after k calls to step, E^inc is at
# time k·dt and H^inc at (k − ½)·dt. `boundary_x` is the first total-field column and `source_cell` the soft source's
# node; both stay writable, as Rust's public fields, and step and the incident_* readers guard them. `e_coeff_1d`
# dt/(ε₀dx), `h_coeff_1d` dt/(μ₀dx) and `abc_coeff` (S − 1)/(S + 1), S = c·dt/dx, are fixed. `work` is the update's
# scratch row (no Rust counterpart) and `map_bytes` the mapping's length (0 once freed). `abc_coeff` is rounded once
# from the exact (c·dt − dx)/(c·dt + dx) (ADR 0002 row 40). Mirrors `TfsfSource`.
#
# The left-edge recipe for a boundary at bx, with updates H[i] += c_h·(E[i + 1] − E[i]) and E[i] += c_e·(H[i] − H[i −
# 1]) (BjFdtd1d's, and the 2D TM grid's H_y and E_z): update H, then H[bx − 1] −= c_h·incident_e(); call step(source);
# update E, then E[bx] −= c_e·incident_h() (Schneider, *Understanding the FDTD Method*, §3.10–3.11).
public struct BjTfsfSource {
    inc_e;
    inc_h;
    boundary_x;
    source_cell;
    nx;
    e_coeff_1d: f64;
    h_coeff_1d: f64;
    abc_coeff: f64;
    work;
    map_bytes;
}

# Records InvalidParameter "<head>{n}<mid>{m}" with n and m usize; returns its code.
fn _bj_fs_bad_range(head, n, mid, m): i64 {
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, head);
    _bj_tx_u64(t, n);
    _bj_tx_cstr(t, mid);
    _bj_tx_u64(t, m);
    return BJ_ERR_INVALID_PARAMETER;
}

# Creates a TF/SF source over nx cells (a usize) with its boundary at column boundary_x into *out: the soft source at
# max(boundary_x/4, 1) (at most nx − 2), every field zero. Ok(0), or with out untouched:
# - Err(InsufficientResolution) for nx < 3;
# - Err(InvalidParameter) "TFSF boundary_x must be in 1..{nx}, got {boundary_x}" unless 1 ≤ boundary_x < nx;
# - Err(InvalidParameter) "dx must be finite and positive, got {dx}";
# - Err(InvalidParameter) "dt must be in (0, dx/c] = (0, {dx/c}], got {dt}" unless 0 < dt and c·dt ≤ dx·(1 + 10⁻¹²)
#   (the 1D Courant limit, decided exactly: ADR 0002 row 17);
# - Err(Allocation) when the grid's mapping can't be had (Rust's vec! aborts; ADR 0002 row 9).
# Give it back with BjTfsfSource_free. Mirrors `TfsfSource::try_new`.
#must_use
public fn BjTfsfSource_try_new(nx, boundary_x, dx: f64, dt: f64, out: *BjTfsfSource): Result {
    if (nx >= 0 && nx < 3) {
        var nf: f64 = f64_from(nx);
        var size: f64 = nf * dx;
        return Err(_bj_err_insufficient_resolution(nx, size));
    }
    if (boundary_x == 0 || _bj_fs_uge(boundary_x, nx) == 1) {
        return Err(_bj_fs_bad_range("TFSF boundary_x must be in 1..", nx, ", got ", boundary_x));
    }
    if (_bj_fs_pos(dx) == 0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "dx must be finite and positive, got ");
        _bj_fmt_f64_display(t, dx);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var c: f64 = BJ_SPEED_OF_LIGHT;
    var cdt: f64 = c * dt;
    if (_bj_fs_pos(dt) == 0 || _bj_fs_courant_over(dt, dx) == 1) {
        var td = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(td, "dt must be in (0, dx/c] = (0, ");
        var dxc: f64 = dx / c;
        _bj_fmt_f64_display(td, dxc);
        _bj_tx_cstr(td, "], got ");
        _bj_fmt_f64_display(td, dt);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var map = 0;
    if (nx > 0 && nx <= _BJ_FS_MAX_CELLS) { map = mmap_anon(nx * 24); }
    if (map == 0) {
        var ta = _bj_err_reason(BJ_ERR_ALLOCATION);
        _bj_tx_cstr(ta, "a TFSF auxiliary grid of ");
        _bj_tx_u64(ta, nx);
        _bj_tx_cstr(ta, " cells");
        return Err(BJ_ERR_ALLOCATION);
    }
    # dt/(ε₀dx) and dt/(μ₀dx), each rounded once (ADR 0002 row 13, M5 part 2b).
    var mn: f64[1];
    var md: f64[2];
    mn[0] = dt;
    md[0] = BJ_EPSILON_0;
    md[1] = dx;
    var ec: f64 = _bj_k_cr_mono(&mn, 1, &md, 2);
    md[0] = BJ_MU_0;
    var hc: f64 = _bj_k_cr_mono(&mn, 1, &md, 2);
    var s: f64 = cdt / dx;
    var sm: f64 = s - 1.0;
    var sp: f64 = s + 1.0;
    var abc: f64 = sm / sp;
    # (S − 1)/(S + 1) = (c·dt − dx)/(c·dt + dx), rounded once (ADR 0002 row 40, M5 part 2a-1b): Rust's cancelled at
    # the magic time step S = 1. The arguments are finite and positive here, so the denominator isn't 0.
    var rv: f64[3];
    rv[0] = dt;
    rv[1] = dx;
    rv[2] = c;
    var ro: f64[1];
    if (_bj_cr_rat(&rv, 3, _bj_cr_rat_spec(10), 0, &ro) == 1) { abc = ro[0]; }
    var sc = boundary_x / 4;
    if (sc < 1) { sc = 1; }
    if (sc > nx - 2) { sc = nx - 2; }
    out.inc_e = map;
    out.inc_h = map + nx * 8;
    out.work = map + nx * 16;
    out.boundary_x = boundary_x;
    out.source_cell = sc;
    out.nx = nx;
    out.e_coeff_1d = ec;
    out.h_coeff_1d = hc;
    out.abc_coeff = abc;
    out.map_bytes = nx * 24;
    if (_bj_log_on(4) == 1) {
        var lb[256];
        var lt[24];
        _bj_tx_init(&lt, &lb, 256);
        _bj_tx_cstr(&lt, "TFSF source created nx=");
        _bj_tx_u64(&lt, nx);
        _bj_tx_cstr(&lt, " boundary_x=");
        _bj_tx_u64(&lt, boundary_x);
        _bj_tx_cstr(&lt, " source_cell=");
        _bj_tx_u64(&lt, sc);
        _bj_tx_cstr(&lt, " dx=");
        _bj_fmt_f64_debug(&lt, dx);
        _bj_tx_cstr(&lt, " dt=");
        _bj_fmt_f64_debug(&lt, dt);
        _bj_tx_cstr(&lt, " courant=");
        _bj_fmt_f64_debug(&lt, s);
        _bj_log_text(4, &lt);
    }
    return Ok(0);
}

# As BjTfsfSource_try_new. Rust's `TfsfSource::new` clamped invalid input with a warning (nx to 3, boundary_x into
# 1..nx, dx or dt replaced so S = 1, dt clamped to dx/c); the port refuses the same inputs as try_new does, with its
# error (ADR 0002 row 3). Mirrors `TfsfSource::new`.
#must_use
public fn BjTfsfSource_new(nx, boundary_x, dx: f64, dt: f64, out: *BjTfsfSource): Result {
    return BjTfsfSource_try_new(nx, boundary_x, dx, dt, out);
}

# Gives a source's mapping back and empties it (nx 0, both addresses 0); a second call does nothing.
public fn BjTfsfSource_free(src: *BjTfsfSource): i64 {
    if (src.map_bytes > 0) { cyr_munmap(src.inc_e, src.map_bytes); }
    src.inc_e = 0;
    src.inc_h = 0;
    src.work = 0;
    src.nx = 0;
    src.map_bytes = 0;
    return 0;
}

impl BjTfsfSource {
    # Advances the auxiliary grid one step: H from E, then source_value added at source_cell (clamped to 1..nx − 2,
    # since the field is writable), then the interior E from H, then the Mur boundaries at both ends. A cell whose
    # update leaves the normal range runs it with an unbounded exponent, rounded once (ADR 0002 row 18, M5 part 2d-3:
    # src/crmath_edge.cyr's _bj_e_cell_row, the 1D grid's rule). A grid under three cells (a freed one) is left alone.
    # Mirrors `TfsfSource::step`.
    public fn step(self, source_value: f64) {
        var n = self.nx;
        if (n < 3) { return 0; }
        var e: *f64 = _bj_fs_f64p(self.inc_e);
        var h: *f64 = _bj_fs_f64p(self.inc_h);
        var hc: f64[1];
        var ec: f64[1];
        hc[0] = self.h_coeff_1d;
        ec[0] = self.e_coeff_1d;
        var w: *f64 = _bj_fs_f64p(self.work);
        var e_left: f64 = e[1];
        var e_right: f64 = e[n - 2];
        # H[i] += c_h·(E[i + 1] − E[i]) for i < n − 1.
        _bj_e_cell_row(h, &hc, 0, e + 1, e, w, n - 1);
        var sc = self.source_cell;
        if (sc < 0 || sc > n - 2) { sc = n - 2; }
        if (sc < 1) { sc = 1; }
        var x: f64 = e[sc];
        e[sc] = x + source_value;
        # E[i] += c_e·(H[i] − H[i − 1]) for 0 < i < n − 1.
        _bj_e_cell_row(e + 1, &ec, 0, h + 1, h, w, n - 2);
        var k: f64 = self.abc_coeff;
        e[0] = _bj_e_cell_one(e_left, k, e[1], e[0]);
        e[n - 1] = _bj_e_cell_one(e_right, k, e[n - 2], e[n - 1]);
        return 0;
    }

    # E^inc at the boundary node x = boundary_x·dx, or 0.0 when boundary_x is outside the grid. Mirrors
    # `TfsfSource::incident_e`.
    #must_use
    public fn incident_e(self): f64 {
        var bx = self.boundary_x;
        if (bx < 0 || bx >= self.nx) { return 0.0; }
        var e: *f64 = _bj_fs_f64p(self.inc_e);
        var v: f64 = e[bx];
        return v;
    }

    # H^inc at x = (boundary_x − ½)·dx, inc_h[boundary_x − 1], the scattered-field node beside the boundary, or 0.0 when
    # it doesn't exist (boundary_x 0 or outside the grid). Mirrors `TfsfSource::incident_h`.
    #must_use
    public fn incident_h(self): f64 {
        var i = self.boundary_x - 1;
        if (self.boundary_x == 0 || i < 0 || i >= self.nx) { return 0.0; }
        var h: *f64 = _bj_fs_f64p(self.inc_h);
        var v: f64 = h[i];
        return v;
    }
}

# --- fdtd_media_data.cyr ---

# bijli — fdtd_media_data.cyr: the dispersive presets of src/fdtd_media.cyr (M5 part 1c)
#
# Generated once from bijli 1.2.0, hisab 1.4.0, by the Rust generator retired with the Rust tree (ADR 0003);
# frozen, since 1.2.0 is. Do not edit. scripts/oracle/validate.py checks each value against tests/golden/fdtd.tsv.
#
# Each field of DrudeMaterial::gold(), DrudeMaterial::silver() and DebyeMaterial::water().

var _BJ_GOLD_EPS_INF: f64 = 1.0;
var _BJ_GOLD_OMEGA_P: f64 = 13700000000000000.0;
var _BJ_GOLD_GAMMA: f64 = 40500000000000.0;
var _BJ_SILVER_EPS_INF: f64 = 1.0;
var _BJ_SILVER_OMEGA_P: f64 = 13900000000000000.0;
var _BJ_SILVER_GAMMA: f64 = 27300000000000.0;
var _BJ_WATER_EPS_INF: f64 = 4.9;
var _BJ_WATER_EPS_S: f64 = 78.4;
var _BJ_WATER_TAU: f64 = 0.00000000000827;

# --- fdtd_media.cyr ---

# fdtd_media.cyr — fdtd.rs's FDTD media (M5 part 1c): the lossy material's update coefficients, the Drude, Lorentz and
# Debye models' auxiliary-differential-equation (ADE) coefficients with the gold, silver and water presets, and the
# subpixel permittivity averages. SI units: conductivities in S/m, angular frequencies in rad/s, times in seconds.
#
# Each material is a small struct passed by value. Its `new` stores the fields unchecked, as Rust's does, and
# `try_new` validates them. The presets' fields are generated from the oracle into src/fdtd_media_data.cyr.
#
# The coefficients are rounded once from their exact values (ADR 0002 row 40, the user's answer of 2026-11-15): each is
# a ratio of sums of products of the inputs and ε₀ (src/crmath_edge.cyr's _bj_cr_rat), where Rust's chains of (1 ∓ s)
# and (2 ∓ γΔt) cancelled as s → 1 or γΔt → 2 (the lossy C_a 5.6·10⁻⁵ off at s = 1 + 10⁻¹²). An output keeps Rust's
# chain where an operand it reads isn't finite or Rust's formula divides by an exact zero (ε_r = 0, Δx = 0, Δt = 0 for
# Debye, or a denominator such as 1 + s exactly 0).
#
# bijli's one harmonic convention is e^{+jωt} with IEEE handedness (src/complex.cyr's header; ADR 0002 row 5). Rust
# stated the Drude, Lorentz and Debye permittivities in e^{−iωt}; they are stated here in e^{+jωt}. The ADE
# coefficients are time-domain, so no number changes.

private

var _BJ_FM_INF: f64 = 0x7FF0000000000000;
var _BJ_FM_NAN: f64 = 0x7FF8000000000000;

# 1 when x is finite (NaN-safe).
#must_use
fn _bj_fm_fin(x: f64): i64 {
    var z: f64 = x * 0.0;
    if (z == 0.0) { return 1; }
    return 0;
}

# r, rounded once: rational k of src/crmath_edge.cyr over the n doubles at v when ok = 1 and its denominator isn't
# exactly 0, else r as given (Rust's chain).
#must_use
fn _bj_fm_rat(r: f64, ok, v: *f64, n, k): f64 {
    if (ok == 0) { return r; }
    var o: f64[1];
    if (_bj_cr_rat(v, n, _bj_cr_rat_spec(k), 0, &o) == 0) { return r; }
    var x: f64 = o[0];
    return x;
}

# 1 when x is finite and strictly positive (NaN-safe). Mirrors fdtd.rs's `is_positive_finite`.
#must_use
fn _bj_fm_pos(x: f64): i64 {
    if (x > 0.0 && x < _BJ_FM_INF) { return 1; }
    return 0;
}

# 0 when value is a valid relative permittivity (finite, > 0), else InvalidPermittivity recorded and its code. Mirrors
# fdtd.rs's `check_permittivity`.
fn _bj_fm_perm(value: f64): i64 {
    if (_bj_fm_pos(value) == 1) { return 0; }
    return _bj_err_invalid_permittivity(value);
}

# 0 when value is finite and non-negative (−0 included), else InvalidParameter "{name} must be finite and
# non-negative, got {value}" recorded and its code. Mirrors fdtd.rs's `check_non_negative`.
fn _bj_fm_nonneg(name, value: f64): i64 {
    if (value >= 0.0 && value < _BJ_FM_INF) { return 0; }
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, name);
    _bj_tx_cstr(t, " must be finite and non-negative, got ");
    _bj_fmt_f64_display(t, value);
    return BJ_ERR_INVALID_PARAMETER;
}

# 0 when value is finite and strictly positive, else InvalidParameter "{name} must be finite and positive, got
# {value}" recorded and its code. Mirrors fdtd.rs's `check_positive`.
fn _bj_fm_positive(name, value: f64): i64 {
    if (_bj_fm_pos(value) == 1) { return 0; }
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, name);
    _bj_tx_cstr(t, " must be finite and positive, got ");
    _bj_fmt_f64_display(t, value);
    return BJ_ERR_INVALID_PARAMETER;
}

# ── the lossy material ──────────────────────────────────────────────────────────────────────────────────────────────

# A lossy material with static conductivity σ: E^{n+1} = C_a·E^n + C_b·(∇×H), C_a = (1 − σΔt/2ε)/(1 + σΔt/2ε),
# C_b = (Δt/ε)/(1 + σΔt/2ε). `eps_r` is the relative permittivity, `conductivity` σ in S/m. Mirrors `LossyMaterial`.
public struct BjLossyMaterial {
    eps_r: f64;
    conductivity: f64;
}

# A lossy material, unchecked (ε_r ≤ 0 makes the coefficients meaningless; BjLossyMaterial_try_new checks). Mirrors
# `LossyMaterial::new`.
#must_use
public fn BjLossyMaterial_new(eps_r: f64, conductivity: f64): BjLossyMaterial {
    var m: BjLossyMaterial;
    m.eps_r = eps_r;
    m.conductivity = conductivity;
    return m;
}

# A lossy material into *out: Ok(0), or with out untouched Err(InvalidPermittivity) unless ε_r is finite and positive,
# Err(InvalidParameter) "conductivity must be finite and non-negative, got {σ}". Mirrors `LossyMaterial::try_new`.
#must_use
public fn BjLossyMaterial_try_new(eps_r: f64, conductivity: f64, out: *BjLossyMaterial): Result {
    var e = _bj_fm_perm(eps_r);
    if (e == 0) { e = _bj_fm_nonneg("conductivity", conductivity); }
    if (e != 0) { return Err(e); }
    out.eps_r = eps_r;
    out.conductivity = conductivity;
    return Ok(0);
}

impl BjLossyMaterial {
    # The E-update coefficients (C_a, C_b) for steps dt and dx, C_a = (2ε − σΔt)/(2ε + σΔt) and C_b = 2Δt/(Δx·(2ε +
    # σΔt)), ε = ε_rε₀, each rounded once (the file's header); dt > 0, dx > 0 and a valid material assumed. Mirrors
    # `LossyMaterial::update_coefficients`.
    #must_use
    public fn update_coefficients(self, dt: f64, dx: f64): (f64, f64) {
        var eps: f64 = self.eps_r * BJ_EPSILON_0;
        var sdt: f64 = self.conductivity * dt;
        var eps2: f64 = 2.0 * eps;
        var s: f64 = sdt / eps2;
        var num: f64 = 1.0 - s;
        var den: f64 = 1.0 + s;
        var ca: f64 = num / den;
        var edx: f64 = eps * dx;
        var q: f64 = dt / edx;
        var cb: f64 = q / den;
        var v: f64[5];
        v[0] = self.eps_r;
        v[1] = self.conductivity;
        v[2] = dt;
        v[3] = dx;
        v[4] = BJ_EPSILON_0;
        var ok = _bj_fm_fin(self.eps_r) & _bj_fm_fin(self.conductivity) & _bj_fm_fin(dt);
        if (self.eps_r == 0.0) { ok = 0; }
        ca = _bj_fm_rat(ca, ok, &v, 5, 0);
        if (dx == 0.0 || _bj_fm_fin(dx) == 0) { ok = 0; }
        cb = _bj_fm_rat(cb, ok, &v, 5, 1);
        return (ca, cb);
    }
}

# ── the Drude model ─────────────────────────────────────────────────────────────────────────────────────────────────

# The Drude model of metals and plasmas: ε(ω) = ε_∞ − ω_p²/(ω² − jγω) (e^{+jωt}). Its polarization current obeys
# dJ/dt + γJ = ε₀ω_p²E. `eps_inf` is ε_∞, `omega_p` the plasma frequency ω_p and `gamma` the collision frequency γ,
# both in rad/s. Mirrors `DrudeMaterial`.
public struct BjDrudeMaterial {
    eps_inf: f64;
    omega_p: f64;
    gamma: f64;
}

# A Drude material, unchecked (ε_∞ = 0 makes κ infinite; BjDrudeMaterial_try_new checks). Mirrors
# `DrudeMaterial::new`.
#must_use
public fn BjDrudeMaterial_new(eps_inf: f64, omega_p: f64, gamma: f64): BjDrudeMaterial {
    var m: BjDrudeMaterial;
    m.eps_inf = eps_inf;
    m.omega_p = omega_p;
    m.gamma = gamma;
    return m;
}

# A Drude material into *out: Ok(0), or with out untouched Err(InvalidPermittivity) unless ε_∞ is finite and positive,
# Err(InvalidParameter) when ω_p ("plasma frequency omega_p") or γ ("damping gamma") is negative or not finite. Mirrors
# `DrudeMaterial::try_new`.
#must_use
public fn BjDrudeMaterial_try_new(eps_inf: f64, omega_p: f64, gamma: f64, out: *BjDrudeMaterial): Result {
    var e = _bj_fm_perm(eps_inf);
    if (e == 0) { e = _bj_fm_nonneg("plasma frequency omega_p", omega_p); }
    if (e == 0) { e = _bj_fm_nonneg("damping gamma", gamma); }
    if (e != 0) { return Err(e); }
    out.eps_inf = eps_inf;
    out.omega_p = omega_p;
    out.gamma = gamma;
    return Ok(0);
}

# Gold at optical frequencies (approximate). Mirrors `DrudeMaterial::gold`.
#must_use
public fn BjDrudeMaterial_gold(): BjDrudeMaterial {
    var m: BjDrudeMaterial = BjDrudeMaterial_new(_BJ_GOLD_EPS_INF, _BJ_GOLD_OMEGA_P, _BJ_GOLD_GAMMA);
    return m;
}

# Silver at optical frequencies (approximate). Mirrors `DrudeMaterial::silver`.
#must_use
public fn BjDrudeMaterial_silver(): BjDrudeMaterial {
    var m: BjDrudeMaterial = BjDrudeMaterial_new(_BJ_SILVER_EPS_INF, _BJ_SILVER_OMEGA_P, _BJ_SILVER_GAMMA);
    return m;
}

impl BjDrudeMaterial {
    # The ADE coefficients (α, β, κ) of the current J: α = (2 − γΔt)/(2 + γΔt), β = ε₀ω_p²Δt/(2 + γΔt) and
    # κ = Δt/(ε₀ε_∞), for the trapezoidal J^{n+1} = αJ^n + β(E^{n+1} + E^n) and
    # E^{n+1} = E^n + κ[(∇×H)^{n+½} − ½(J^{n+1} + J^n)] (Taflove & Hagness, ch. 9), each rounded once (the file's
    # header); dt > 0 and a valid material assumed. Mirrors `DrudeMaterial::ade_coefficients`.
    #must_use
    public fn ade_coefficients(self, dt: f64): (f64, f64, f64) {
        var gdt: f64 = self.gamma * dt;
        var am: f64 = 2.0 - gdt;
        var ap: f64 = 2.0 + gdt;
        var alpha: f64 = am / ap;
        var b: f64 = BJ_EPSILON_0 * self.omega_p;
        b = b * self.omega_p;
        b = b * dt;
        var beta: f64 = b / ap;
        var ei: f64 = BJ_EPSILON_0 * self.eps_inf;
        var kappa: f64 = dt / ei;
        var v: f64[5];
        v[0] = self.eps_inf;
        v[1] = self.omega_p;
        v[2] = self.gamma;
        v[3] = dt;
        v[4] = BJ_EPSILON_0;
        var fg = _bj_fm_fin(self.gamma) & _bj_fm_fin(dt);
        alpha = _bj_fm_rat(alpha, fg, &v, 5, 2);
        beta = _bj_fm_rat(beta, fg & _bj_fm_fin(self.omega_p), &v, 5, 3);
        kappa = _bj_fm_rat(kappa, _bj_fm_fin(self.eps_inf) & _bj_fm_fin(dt), &v, 5, 4);
        return (alpha, beta, kappa);
    }
}

# ── the Lorentz model ───────────────────────────────────────────────────────────────────────────────────────────────

# The Lorentz oscillator of a dielectric resonance: ε(ω) = ε_∞ + Δε·ω₀²/(ω₀² − ω² + jγω) (e^{+jωt}). Its polarization
# obeys d²P/dt² + γ·dP/dt + ω₀²P = ε₀Δεω₀²E. `eps_inf` is ε_∞, `delta_eps` the oscillator strength Δε, `omega_0` the
# resonance ω₀ and `gamma` the damping γ, in rad/s. Mirrors `LorentzMaterial`.
public struct BjLorentzMaterial {
    eps_inf: f64;
    delta_eps: f64;
    omega_0: f64;
    gamma: f64;
}

# A Lorentz material, unchecked (BjLorentzMaterial_try_new checks). Mirrors `LorentzMaterial::new`.
#must_use
public fn BjLorentzMaterial_new(eps_inf: f64, delta_eps: f64, omega_0: f64, gamma: f64): BjLorentzMaterial {
    var m: BjLorentzMaterial;
    m.eps_inf = eps_inf;
    m.delta_eps = delta_eps;
    m.omega_0 = omega_0;
    m.gamma = gamma;
    return m;
}

# A Lorentz material into *out: Ok(0), or with out untouched Err(InvalidPermittivity) unless ε_∞ is finite and
# positive, Err(InvalidParameter) when Δε ("oscillator strength delta_eps") or γ ("damping gamma") is negative or not
# finite, or ω₀ ("resonance frequency omega_0") not finite and positive. Mirrors `LorentzMaterial::try_new`.
#must_use
public fn BjLorentzMaterial_try_new(eps_inf: f64, delta_eps: f64, omega_0: f64, gamma: f64,
  out: *BjLorentzMaterial): Result {
    var e = _bj_fm_perm(eps_inf);
    if (e == 0) { e = _bj_fm_nonneg("oscillator strength delta_eps", delta_eps); }
    if (e == 0) { e = _bj_fm_positive("resonance frequency omega_0", omega_0); }
    if (e == 0) { e = _bj_fm_nonneg("damping gamma", gamma); }
    if (e != 0) { return Err(e); }
    out.eps_inf = eps_inf;
    out.delta_eps = delta_eps;
    out.omega_0 = omega_0;
    out.gamma = gamma;
    return Ok(0);
}

impl BjLorentzMaterial {
    # The ADE coefficients (α, β, γ_c) of the central-difference P^{n+1} = αP^n + βP^{n−1} + γ_c·E^n:
    # α = (2 − ω₀²Δt²)/(1 + γΔt/2), β = −(1 − γΔt/2)/(1 + γΔt/2), γ_c = ε₀Δεω₀²Δt²/(1 + γΔt/2), each rounded once
    # (the file's header); stable only for ω₀Δt < 2. Mirrors `LorentzMaterial::ade_coefficients`.
    #must_use
    public fn ade_coefficients(self, dt: f64): (f64, f64, f64) {
        var gdt: f64 = self.gamma * dt;
        var w0dt: f64 = self.omega_0 * dt;
        var half: f64 = gdt / 2.0;
        var denom: f64 = 1.0 + half;
        var w2: f64 = w0dt * w0dt;
        var an: f64 = 2.0 - w2;
        var alpha: f64 = an / denom;
        var bn: f64 = 1.0 - half;
        var nb: f64 = -bn;
        var beta: f64 = nb / denom;
        var g: f64 = BJ_EPSILON_0 * self.delta_eps;
        g = g * w0dt;
        g = g * w0dt;
        var gamma_c: f64 = g / denom;
        var v: f64[6];
        v[0] = 0.0;
        v[1] = self.delta_eps;
        v[2] = self.omega_0;
        v[3] = self.gamma;
        v[4] = dt;
        v[5] = BJ_EPSILON_0;
        var fg = _bj_fm_fin(self.gamma) & _bj_fm_fin(dt);
        var fw = fg & _bj_fm_fin(self.omega_0);
        alpha = _bj_fm_rat(alpha, fw, &v, 6, 5);
        beta = _bj_fm_rat(beta, fg, &v, 6, 6);
        gamma_c = _bj_fm_rat(gamma_c, fw & _bj_fm_fin(self.delta_eps), &v, 6, 7);
        return (alpha, beta, gamma_c);
    }
}

# ── the Debye model ─────────────────────────────────────────────────────────────────────────────────────────────────

# The Debye relaxation of polar molecules: ε(ω) = ε_∞ + (ε_s − ε_∞)/(1 + jωτ) (e^{+jωt}). Its polarization obeys
# τ·dP/dt + P = ε₀(ε_s − ε_∞)E. `eps_inf` is ε_∞, `eps_s` the static ε_s and `tau` the relaxation time τ in s. Mirrors
# `DebyeMaterial`.
public struct BjDebyeMaterial {
    eps_inf: f64;
    eps_s: f64;
    tau: f64;
}

# A Debye material, unchecked (BjDebyeMaterial_try_new checks). Mirrors `DebyeMaterial::new`.
#must_use
public fn BjDebyeMaterial_new(eps_inf: f64, eps_s: f64, tau: f64): BjDebyeMaterial {
    var m: BjDebyeMaterial;
    m.eps_inf = eps_inf;
    m.eps_s = eps_s;
    m.tau = tau;
    return m;
}

# A Debye material into *out: Ok(0), or with out untouched Err(InvalidPermittivity) unless ε_∞ and then ε_s are finite
# and positive, Err(InvalidParameter) "Debye eps_s ({ε_s}) must be >= eps_inf ({ε_∞})", or "relaxation time tau must
# be finite and positive, got {τ}". Mirrors `DebyeMaterial::try_new`.
#must_use
public fn BjDebyeMaterial_try_new(eps_inf: f64, eps_s: f64, tau: f64, out: *BjDebyeMaterial): Result {
    var e = _bj_fm_perm(eps_inf);
    if (e == 0) { e = _bj_fm_perm(eps_s); }
    if (e == 0 && eps_s < eps_inf) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "Debye eps_s (");
        _bj_fmt_f64_display(t, eps_s);
        _bj_tx_cstr(t, ") must be >= eps_inf (");
        _bj_fmt_f64_display(t, eps_inf);
        _bj_tx_cstr(t, ")");
        e = BJ_ERR_INVALID_PARAMETER;
    }
    if (e == 0) { e = _bj_fm_positive("relaxation time tau", tau); }
    if (e != 0) { return Err(e); }
    out.eps_inf = eps_inf;
    out.eps_s = eps_s;
    out.tau = tau;
    return Ok(0);
}

# Water at 25 °C, a single-pole Debye fit. Mirrors `DebyeMaterial::water`.
#must_use
public fn BjDebyeMaterial_water(): BjDebyeMaterial {
    var m: BjDebyeMaterial = BjDebyeMaterial_new(_BJ_WATER_EPS_INF, _BJ_WATER_EPS_S, _BJ_WATER_TAU);
    return m;
}

impl BjDebyeMaterial {
    # The ADE coefficients (α, β) of the trapezoidal P^{n+1} = αP^n + β(E^{n+1} + E^n): α = (2τ/Δt − 1)/(2τ/Δt + 1),
    # β = ε₀(ε_s − ε_∞)/(2τ/Δt + 1), each rounded once (the file's header); dt > 0 and a valid material assumed.
    # Mirrors `DebyeMaterial::ade_coefficients`.
    #must_use
    public fn ade_coefficients(self, dt: f64): (f64, f64) {
        var tdt: f64 = self.tau / dt;
        var t2: f64 = 2.0 * tdt;
        var am: f64 = t2 - 1.0;
        var ap: f64 = t2 + 1.0;
        var alpha: f64 = am / ap;
        var de: f64 = self.eps_s - self.eps_inf;
        var b: f64 = BJ_EPSILON_0 * de;
        var beta: f64 = b / ap;
        var v: f64[5];
        v[0] = self.eps_inf;
        v[1] = self.eps_s;
        v[2] = self.tau;
        v[3] = dt;
        v[4] = BJ_EPSILON_0;
        var ft = _bj_fm_fin(self.tau) & _bj_fm_fin(dt);
        if (dt == 0.0) { ft = 0; }
        alpha = _bj_fm_rat(alpha, ft, &v, 5, 8);
        beta = _bj_fm_rat(beta, ft & _bj_fm_fin(self.eps_s) & _bj_fm_fin(self.eps_inf), &v, 5, 9);
        return (alpha, beta);
    }
}

# ── subpixel smoothing ──────────────────────────────────────────────────────────────────────────────────────────────

# 0 when both permittivities are valid and fill_fraction lies in [0, 1], else the error recorded and its code
# (InvalidPermittivity for ε₁, then ε₂; InvalidParameter "fill_fraction must be in [0, 1], got {f}"). Mirrors
# fdtd.rs's `check_subpixel`.
fn _bj_fm_subpixel(eps1: f64, eps2: f64, fill_fraction: f64): i64 {
    var e = _bj_fm_perm(eps1);
    if (e == 0) { e = _bj_fm_perm(eps2); }
    if (e != 0) { return e; }
    if (fill_fraction >= 0.0 && fill_fraction <= 1.0) { return 0; }
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, "fill_fraction must be in [0, 1], got ");
    _bj_fmt_f64_display(t, fill_fraction);
    return BJ_ERR_INVALID_PARAMETER;
}

# The effective permittivity for E parallel to an interface, the arithmetic mean f·ε₂ + (1 − f)·ε₁ (tangential E is
# continuous: capacitors in parallel; Farjadpour et al., Opt. Lett. 31, 2972 (2006)); f is the fraction of the cell
# that ε₂ fills. Rounded once from the exact mean (ADR 0002 row 41, the user's answer of 2026-11-15), so a uniform cell
# (ε₁ = ε₂) gives ε exactly and the mean lies in [ε₁, ε₂]; Rust's chain missed ε in 2.5 % of uniform cells. Ok(⟨ε⟩),
# or Err(InvalidPermittivity) unless both are finite and positive, Err(InvalidParameter) unless f is in [0, 1].
# Mirrors `subpixel_permittivity_parallel`.
#must_use
public fn bj_subpixel_permittivity_parallel(eps1: f64, eps2: f64, fill_fraction: f64): Result {
    var e = _bj_fm_subpixel(eps1, eps2, fill_fraction);
    if (e != 0) { return Err(e); }
    var rv: f64[3];
    rv[0] = eps1;
    rv[1] = eps2;
    rv[2] = fill_fraction;
    var ro: f64[1];
    var r = _bj_cr_rat(&rv, 3, _bj_cr_rat_spec(12), 0, &ro);
    var m: f64 = ro[0];
    return Ok(m);
}

# The effective permittivity for E perpendicular to an interface, the harmonic mean 1/(f/ε₂ + (1 − f)/ε₁) (normal D
# is continuous: capacitors in series), rounded once from the exact ε₁ε₂/((1 − f)ε₂ + f·ε₁) (ADR 0002 row 41): a
# uniform cell gives ε exactly (Rust's chain missed it in 23 % of them), the mean lies in [ε₁, ε₂], and no
# intermediate leaves the range. Unchecked, as Rust's: NaN unless both permittivities are finite and positive; f
# clamped to [0, 1], NaN taken as 0. Mirrors `subpixel_permittivity_perpendicular`.
#must_use
public fn bj_subpixel_permittivity_perpendicular(eps1: f64, eps2: f64, fill_fraction: f64): f64 {
    if (_bj_fm_pos(eps1) == 0 || _bj_fm_pos(eps2) == 0) { return _BJ_FM_NAN; }
    var f: f64 = fill_fraction;
    if (f != f) { f = 0.0; }
    if (f < 0.0) { f = 0.0; }
    if (f > 1.0) { f = 1.0; }
    var rv: f64[3];
    rv[0] = eps1;
    rv[1] = eps2;
    rv[2] = f;
    var ro: f64[1];
    var k = _bj_cr_rat(&rv, 3, _bj_cr_rat_spec(13), 0, &ro);
    var r: f64 = ro[0];
    return r;
}

# The harmonic mean, checked as the parallel one: Ok(⟨ε⁻¹⟩⁻¹), or its errors. Mirrors
# `subpixel_permittivity_perpendicular_checked`.
#must_use
public fn bj_subpixel_permittivity_perpendicular_checked(eps1: f64, eps2: f64, fill_fraction: f64): Result {
    var e = _bj_fm_subpixel(eps1, eps2, fill_fraction);
    if (e != 0) { return Err(e); }
    var r: f64 = bj_subpixel_permittivity_perpendicular(eps1, eps2, fill_fraction);
    return Ok(r);
}

# --- fdtd_util.cyr ---

# fdtd_util.cyr — fdtd.rs's FDTD utilities (M5 part 1d): the non-uniform grid, the fourth-order staggered derivative,
# the CW (single-frequency DFT) accumulator, and the eigenmode search by DFT with half-power quality factors. SI units.
#
# Rust's `Vec<f64>` results are written into the caller's `out` (fourth_order_derivative, graded, amplitude, phase),
# or into a result the caller frees (BjEigenmodeResult). The grid's and the accumulator's arrays are fixed at
# construction (ADR 0002 row 2): addresses and lengths, freed by their Bj*_free. A failed allocation is
# Err(Allocation), where Rust's `vec!` aborts (ADR 0002 row 9).
#
# The accumulator's DFT is F(ω) = Σₙ f(tₙ)·e^{−jωtₙ}·Δt, so its phases are bijli's one convention, e^{+jωt}
# (src/complex.cyr's header): fdtd.rs's CW phasors already were. sin, cos, atan2 and pow are correctly rounded
# (src/crmath.cyr).

private

var _BJ_FU_INF: f64 = 0x7FF0000000000000;
# 2^-1022: the normal range's floor.
var _BJ_FU_DMIN: f64 = 0x0010000000000000;
# 2^-959 and 2^-960: the DFT rotation's and sums' absorption bounds (M5 part 2d-4b-1).
var _BJ_FU_2M959: f64 = 0x0400000000000000;
var _BJ_FU_2M960: f64 = 0x03F0000000000000;
# std::f64::consts::PI and SQRT_2.
var _BJ_FU_PI: f64 = 3.141592653589793;
var _BJ_FU_SQRT_2: f64 = 1.4142135623730951;
# freelist's largest request, 2 GiB: a grid's or a result's block must fit it.
var _BJ_FU_FL_MAX = 2147483648;

# A word as a *f64 (the typed return keeps the binding typed).
#must_use
fn _bj_fu_f64p(a): *f64 {
    return a;
}

# 1 when x is finite and strictly positive (NaN-safe). Mirrors fdtd.rs's `is_positive_finite`.
#must_use
fn _bj_fu_pos(x: f64): i64 {
    if (x > 0.0 && x < _BJ_FU_INF) { return 1; }
    return 0;
}

# Rust's `n as f64` for a usize: the word read unsigned, rounded to nearest even.
#must_use
fn _bj_fu_u2f(n): f64 {
    if (n >= 0) {
        var r: f64 = f64_from(n);
        return r;
    }
    var h: f64 = f64_from((n >> 1) | (n & 1));
    var r2: f64 = h * 2.0;
    return r2;
}

# Records Allocation "<what> of {n} values"; returns its code.
fn _bj_fu_alloc_err(what, n): i64 {
    var t = _bj_err_reason(BJ_ERR_ALLOCATION);
    _bj_tx_cstr(t, what);
    _bj_tx_cstr(t, " of ");
    _bj_tx_u64(t, n);
    _bj_tx_cstr(t, " values");
    return BJ_ERR_ALLOCATION;
}

# ── the non-uniform grid ────────────────────────────────────────────────────────────────────────────────────────────

# A non-uniform grid: the cell widths along x, y and z. `dx`, `dy` and `dz` are the addresses of nx, ny and nz f64 (read
# and write them, as Rust's public vectors), in one freelist block (`block`, 0 when every axis is empty). Mirrors
# `NonUniformGrid`.
public struct BjNonUniformGrid {
    dx;
    nx;
    dy;
    ny;
    dz;
    nz;
    block;
}

# The grid's block for nx + ny + nz values into *out, every value 0: 0, or the Allocation code recorded (out untouched).
fn _bj_fu_grid_alloc(nx, ny, nz, out: *BjNonUniformGrid): i64 {
    var cap = _BJ_FU_FL_MAX / 8;
    if (nx < 0 || ny < 0 || nz < 0 || nx > cap || ny > cap || nz > cap || nx + ny + nz > cap) {
        return _bj_fu_alloc_err("a non-uniform grid", nx + ny + nz);
    }
    var total = nx + ny + nz;
    var b = 0;
    if (total > 0) {
        b = fl_calloc(total * 8);
        if (b == 0) { return _bj_fu_alloc_err("a non-uniform grid", total); }
    }
    out.block = b;
    out.nx = nx;
    out.ny = ny;
    out.nz = nz;
    out.dx = 0;
    out.dy = 0;
    out.dz = 0;
    if (nx > 0) { out.dx = b; }
    if (ny > 0) { out.dy = b + nx * 8; }
    if (nz > 0) { out.dz = b + (nx + ny) * 8; }
    return 0;
}

# Fills n f64 at p with x.
fn _bj_fu_fill(p, n, x: f64) {
    var a: *f64 = _bj_fu_f64p(p);
    for (var i = 0; i < n; i = i + 1) { a[i] = x; }
    return 0;
}

# A uniform grid of nx × ny × nz cells (usize), every width `spacing`, into *out, unchecked as Rust's (an empty axis or
# an invalid spacing makes an invalid grid, whose courant_dt is 0.0): Ok(0), or Err(Allocation) with out untouched
# when the block can't be had (Rust's vec! aborts). Give it back with BjNonUniformGrid_free. Mirrors
# `NonUniformGrid::uniform`.
#must_use
public fn BjNonUniformGrid_uniform(nx, ny, nz, spacing: f64, out: *BjNonUniformGrid): Result {
    var g: BjNonUniformGrid;
    var e = _bj_fu_grid_alloc(nx, ny, nz, &g);
    if (e != 0) { return Err(e); }
    _bj_fu_fill(g.block, nx + ny + nz, spacing);
    memcpy(out, &g, 56);
    return Ok(0);
}

# A uniform grid, checked: Ok(0), or with out untouched Err(InsufficientResolution) (cells 0, domain size 0) when an
# axis has no cell, Err(InvalidParameter) "grid spacing must be finite and positive, got {spacing}", Err(Allocation).
# Mirrors `NonUniformGrid::try_uniform`.
#must_use
public fn BjNonUniformGrid_try_uniform(nx, ny, nz, spacing: f64, out: *BjNonUniformGrid): Result {
    if (nx == 0 || ny == 0 || nz == 0) { return Err(_bj_err_insufficient_resolution(0, 0.0)); }
    if (_bj_fu_pos(spacing) == 0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "grid spacing must be finite and positive, got ");
        _bj_fmt_f64_display(t, spacing);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    return BjNonUniformGrid_uniform(nx, ny, nz, spacing, out);
}

# A grid of the given widths (nx at dx, ny at dy, nz at dz), copied, unchecked: Rust builds one from its public vectors
# (`NonUniformGrid { dx, dy, dz }`, `graded`'s among them). Ok(0), or Err(Allocation) with out untouched. Cyrius only.
#must_use
public fn BjNonUniformGrid_from_axes(dx: *f64, nx, dy: *f64, ny, dz: *f64, nz, out: *BjNonUniformGrid): Result {
    var g: BjNonUniformGrid;
    var e = _bj_fu_grid_alloc(nx, ny, nz, &g);
    if (e != 0) { return Err(e); }
    if (nx > 0) { memcpy(g.dx, dx, nx * 8); }
    if (ny > 0) { memcpy(g.dy, dy, ny * 8); }
    if (nz > 0) { memcpy(g.dz, dz, nz * 8); }
    memcpy(out, &g, 56);
    return Ok(0);
}

# Gives a grid's block back and empties it (every axis 0); a second call does nothing.
public fn BjNonUniformGrid_free(g: *BjNonUniformGrid): i64 {
    if (g.block != 0) { fl_free(g.block); }
    g.block = 0;
    g.dx = 0;
    g.dy = 0;
    g.dz = 0;
    g.nx = 0;
    g.ny = 0;
    g.nz = 0;
    return 0;
}

# Cell i of a geometric grading, d_min·ratio^i (Rust's powi, on the whole usize i: Rust's `i as i32` wrapped past 2³¹
# cells, ADR 0002 row 42). Public for tests/fdtd_util.tcyr, which can't build a grid of 2³¹ cells.
#must_use
public fn _bj_fu_graded_cell(d_min: f64, ratio: f64, i): f64 {
    var p: f64 = _bj_powi(ratio, i);
    var d: f64 = d_min * p;
    return d;
}

# Cell i of the grading with an unbounded exponent (ADR 0002 row 18, M5 part 2d-5): q = d_max/d_min to 53 bits, the
# ratio q^e to 53 bits (_bj_ux_pow: Rust's correctly rounded powf in range), ratio^i by Rust's powi's own products
# each to 53 bits, and d_min·ratio^i rounded once.
#must_use
fn _bj_fu_graded_ux(d_min: f64, d_max: f64, e: f64, i): f64 {
    var as, ae = _bj_k_ux_from(d_max);
    var bs, be = _bj_k_ux_from(d_min);
    var qs, qe = _bj_k_ux_div(as, ae, bs, be);
    var rs, re = _bj_ux_pow(qs, qe, e);
    var ms: f64 = 1.0;
    var me = 0;
    var p = i;
    while (p != 0) {
        if ((p & 1) != 0) {
            var ns, ne = _bj_k_ux_mul(ms, me, rs, re);
            ms = ns;
            me = ne;
        }
        p = p >> 1;
        if (p != 0) {
            var ss, se = _bj_k_ux_mul(rs, re, rs, re);
            rs = ss;
            re = se;
        }
    }
    var d: f64 = _bj_k_ux_mul_f64(bs, be, ms, me);
    return d;
}

# Geometric grading from d_min to d_max over n cells into out[0..n]: d_i = d_min·ratio^i, ratio =
# (d_max/d_min)^(1/(n − 1)) (Rust's powf, correctly rounded, then powi), the last cell exactly d_max and no cell past
# it (ADR 0002 row 42, the user's answers of 2026-11-15 and 2026-11-16: Rust's d_min·ratio^(n − 1) missed d_max in
# 97 % of cases, by up to 270 ulps for n ≤ 200, and for a ratio within about (n − 1)²·2^-53 of 1 its interior passes
# d_max, so the grading stays monotone only with those cells held at d_max). Ok(0), or with out untouched
# Err(InvalidParameter) "need at least 2 cells for grading, got {n}" or "cell sizes must be finite and positive, got
# {d_min}, {d_max}". out holds n f64. A cell whose chain leaves the normal range runs it with an unbounded exponent
# (ADR 0002 row 18, M5 part 2d-5: Rust's d_max/d_min = ∞ or ratio^i past DBL_MAX left those cells at d_max). Mirrors
# `NonUniformGrid::graded`.
#must_use
public fn BjNonUniformGrid_graded(n, d_min: f64, d_max: f64, out: *f64): Result {
    if (n >= 0 && n < 2) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "need at least 2 cells for grading, got ");
        _bj_tx_u64(t, n);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (_bj_fu_pos(d_min) == 0 || _bj_fu_pos(d_max) == 0) {
        var t2 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t2, "cell sizes must be finite and positive, got ");
        _bj_fmt_f64_display(t2, d_min);
        _bj_tx_cstr(t2, ", ");
        _bj_fmt_f64_display(t2, d_max);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var q: f64 = d_max / d_min;
    var nm: f64 = _bj_fu_u2f(n - 1);
    var e: f64 = 1.0 / nm;
    var ratio: f64 = _bj_powf(q, e);
    # The range edges (ADR 0002 row 18, M5 part 2d-5): q = d_max/d_min past either end, or a cell whose powi or product
    # with d_min leaves the normal range, runs the chain with an unbounded exponent (_bj_fu_graded_ux), the cell
    # rounded once. A normal power means no partial of powi left the range: each lies between 1 and the power.
    # q and the power are positive, so a 0 is an underflow: each must be a positive normal value.
    var qok = _bj_fu_pnormal(q);
    var up = 0;
    if (d_max > d_min) { up = 1; }
    for (var i = 0; i != n; i = i + 1) {
        var pw: f64 = _bj_powi(ratio, i);
        var d: f64 = d_min * pw;
        # pw and d positive normal: each exponent field in [1, 2046], so every difference below is ≥ 0 (one test)
        var ep = (load64(&pw) >> 52) & 2047;
        var ed = (load64(&d) >> 52) & 2047;
        if (qok == 0 || ((ep - 1) | (ed - 1) | (2046 - ep) | (2046 - ed)) < 0) {
            d = _bj_fu_graded_ux(d_min, d_max, e, i);
        }
        if (up == 1 && d > d_max) { d = d_max; }
        if (up == 0 && d < d_max) { d = d_max; }
        out[i] = d;
    }
    out[n - 1] = d_max;
    return Ok(0);
}

# The smallest of the n f64 at p, folded from +∞ with Rust's NaN-ignoring f64::min.
#must_use
fn _bj_fu_axis_min(p, n): f64 {
    var a: *f64 = _bj_fu_f64p(p);
    var m: f64 = _BJ_FU_INF;
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = a[i];
        m = _bj_min(m, x);
    }
    return m;
}

# Rust's f64 `Sum` of the n f64 at p: a left fold from −0.0. A partial sum past DBL_MAX stays ∞ (or NaN) to the end;
# where that happens for finite values the fold reruns with an unbounded exponent, each sum to 53 bits and the total
# rounded once (ADR 0002 row 18, M5 part 2d-5: Rust's DBL_MAX + DBL_MAX − DBL_MAX was ∞). Below the range a sum is
# exact.
#must_use
fn _bj_fu_axis_sum(p, n): f64 {
    var a: *f64 = _bj_fu_f64p(p);
    var s: f64 = -0.0;
    for (var i = 0; i < n; i = i + 1) { s = s + a[i]; }
    var z: f64 = s * 0.0;
    if (z == 0.0) { return s; }
    var ss: f64 = -0.0;
    var se = 0;
    for (var j = 0; j < n; j = j + 1) {
        var x: f64 = a[j];
        var zx: f64 = x * 0.0;
        if (zx != 0.0) { return s; }
        var xs, xe = _bj_k_ux_from(x);
        var ts, te = _bj_k_ux_add(ss, se, xs, xe);
        ss = ts;
        se = te;
    }
    var r: f64 = _bj_k_ux_round(ss, se, 0.0);
    return r;
}

# 0 when the axis (its name, n values at p) is valid, else its error recorded and its code.
fn _bj_fu_axis_check(name, p, n): i64 {
    if (n == 0) { return _bj_err_insufficient_resolution(0, 0.0); }
    var a: *f64 = _bj_fu_f64p(p);
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = a[i];
        if (_bj_fu_pos(x) == 0) {
            var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(t, name);
            _bj_tx_cstr(t, " contains invalid cell size ");
            _bj_fmt_f64_display(t, x);
            return BJ_ERR_INVALID_PARAMETER;
        }
    }
    return 0;
}

impl BjNonUniformGrid {
    # Ok(0) when every axis has a cell and every width is finite and positive; else Err(InsufficientResolution)
    # (cells 0, domain size 0) for the first empty axis, or Err(InvalidParameter) "{axis} contains invalid cell size
    # {v}" for the first bad width, axes in the order dx, dy, dz. Mirrors `NonUniformGrid::validate`.
    #must_use
    public fn validate(self): Result {
        var e = _bj_fu_axis_check("dx", self.dx, self.nx);
        if (e == 0) { e = _bj_fu_axis_check("dy", self.dy, self.ny); }
        if (e == 0) { e = _bj_fu_axis_check("dz", self.dz, self.nz); }
        if (e != 0) { return Err(e); }
        return Ok(0);
    }

    # The smallest width over all axes (+∞ when all are empty), Rust's NaN-ignoring min. Mirrors
    # `NonUniformGrid::min_spacing`.
    #must_use
    public fn min_spacing(self): f64 {
        var mx: f64 = _bj_fu_axis_min(self.dx, self.nx);
        var my: f64 = _bj_fu_axis_min(self.dy, self.ny);
        var mz: f64 = _bj_fu_axis_min(self.dz, self.nz);
        var m: f64 = _bj_min(mx, my);
        var m2: f64 = _bj_min(m, mz);
        return m2;
    }

    # Half the 3D Courant limit, d_min/(2√3·c), rounded once (ADR 0002 row 13, M5 part 2b: Rust's d/((2√3)·c) rounded
    # twice), √3 as Rust's correctly rounded double: Ok(dt), or validate's error. Mirrors
    # `NonUniformGrid::try_courant_dt`.
    #must_use
    public fn try_courant_dt(self): Result {
        var t, v = self.validate();
        if (is_err_result(t) == 1) { return Err(v); }
        var num: f64[1];
        var den: f64[2];
        num[0] = self.min_spacing();
        var s3: f64 = f64_sqrt(3.0);
        den[0] = 2.0 * s3;
        den[1] = BJ_SPEED_OF_LIGHT;
        var dt: f64 = _bj_k_cr_mono(&num, 1, &den, 2);
        return Ok(dt);
    }

    # As try_courant_dt, with 0.0 (and a warning) for an invalid grid. Mirrors `NonUniformGrid::courant_dt`.
    #must_use
    public fn courant_dt(self): f64 {
        var t, v = self.try_courant_dt();
        if (is_err_result(t) == 1) {
            if (_bj_log_on(2) == 1) {
                var lb[320];
                var lt[24];
                _bj_tx_init(&lt, &lb, 320);
                _bj_tx_cstr(&lt, "NonUniformGrid::courant_dt on invalid grid, returning 0 e=");
                _bj_tx_cstr(&lt, bj_last_error_display());
                _bj_log_text(2, &lt);
            }
            return 0.0;
        }
        var dt: f64 = v;
        return dt;
    }

    # The total extent along x, y and z: each axis's widths summed from −0.0, as Rust's `Sum` (an empty axis is −0.0).
    # Mirrors `NonUniformGrid::extents`.
    #must_use
    public fn extents(self): (f64, f64, f64) {
        var ex: f64 = _bj_fu_axis_sum(self.dx, self.nx);
        var ey: f64 = _bj_fu_axis_sum(self.dy, self.ny);
        var ez: f64 = _bj_fu_axis_sum(self.dz, self.nz);
        return (ex, ey, ez);
    }
}

# ── the fourth-order derivative ─────────────────────────────────────────────────────────────────────────────────────

# 1/dx to 53 bits with an unbounded exponent: (s, e).
#must_use
fn _bj_fu_inv_ux(dx: f64): (f64, i64) {
    var ds, de = _bj_k_ux_from(dx);
    var s, e = _bj_k_ux_div(1.0, 0, ds, de);
    return (s, e);
}

# out[i] of the fourth-order derivative with an unbounded exponent (ADR 0002 row 18, M5 part 2d-5): the differences,
# c₁Δ, c₂Δ′, their sum and 1/dx to 53 bits, the product rounded once; Rust's r for a non-finite sample.
#must_use
fn _bj_fu_fourth_ux(field: *f64, i, dx: f64, r: f64): f64 {
    var z: f64 = field[i - 1] * 0.0 + field[i] * 0.0 + field[i + 1] * 0.0 + field[i + 2] * 0.0;
    if (z != 0.0) { return r; }
    var as, ae = _bj_k_ux_from(field[i + 1]);
    var bs, be = _bj_k_ux_from(field[i]);
    var cs, ce = _bj_k_ux_from(field[i + 2]);
    var ds, de = _bj_k_ux_from(field[i - 1]);
    var d1s, d1e = _bj_k_ux_sub(as, ae, bs, be);
    var d2s, d2e = _bj_k_ux_sub(cs, ce, ds, de);
    var k1s, k1e = _bj_k_ux_from(BJ_FOURTH_ORDER_C1);
    var k2s, k2e = _bj_k_ux_from(BJ_FOURTH_ORDER_C2);
    var ps, pe = _bj_k_ux_mul(k1s, k1e, d1s, d1e);
    var qs, qe = _bj_k_ux_mul(k2s, k2e, d2s, d2e);
    var ss, se = _bj_k_ux_add(ps, pe, qs, qe);
    var vs, ve = _bj_fu_inv_ux(dx);
    var o: f64 = _bj_k_ux_mul_f64(vs, ve, ss, se);
    return o;
}

# out[i] at an end, (f[i + 1] − f[i])·(1/dx), with an unbounded exponent, the product rounded once; Rust's r for a
# non-finite sample.
#must_use
fn _bj_fu_fourth_end_ux(field: *f64, i, dx: f64, r: f64): f64 {
    var z: f64 = field[i] * 0.0 + field[i + 1] * 0.0;
    if (z != 0.0) { return r; }
    var as, ae = _bj_k_ux_from(field[i + 1]);
    var bs, be = _bj_k_ux_from(field[i]);
    var ds, de = _bj_k_ux_sub(as, ae, bs, be);
    var vs, ve = _bj_fu_inv_ux(dx);
    var o: f64 = _bj_k_ux_mul_f64(ds, de, vs, ve);
    return o;
}

# The fourth-order staggered derivative of the n samples at field into out[0..n] (out must not overlap field): out[i]
# approximates f'(x_{i+½}). For 1 ≤ i ≤ n − 3 it is (1/dx)·(c₁(f[i+1] − f[i]) + c₂(f[i+2] − f[i−1])), c₁ = 9/8,
# c₂ = −1/24, exact for cubics; out[0] and out[n − 2] are (f[i+1] − f[i])·(1/dx), second order; out[n − 1] is 0.0.
# Fewer than two samples, or a dx that isn't finite and positive (with a warning), give all zeros. Where 1/dx (a
# subnormal dx), a difference, a product or the sum leaves the normal range, the cell runs with an unbounded exponent
# and its product is rounded once (ADR 0002 row 18, M5 part 2d-5: Rust's 1/dx = ∞ gave ∞ or NaN). Mirrors
# `fourth_order_derivative`.
public fn bj_fourth_order_derivative(field: *f64, n, dx: f64, out: *f64) {
    for (var z = 0; z < n; z = z + 1) { out[z] = 0.0; }
    if (n < 2) { return 0; }
    if (_bj_fu_pos(dx) == 0) {
        if (_bj_log_on(2) == 1) {
            var lb[160];
            var lt[24];
            _bj_tx_init(&lt, &lb, 160);
            _bj_tx_cstr(&lt, "fourth_order_derivative: invalid dx, returning zeros dx=");
            _bj_fmt_f64_debug(&lt, dx);
            _bj_log_text(2, &lt);
        }
        return 0;
    }
    var inv: f64 = 1.0 / dx;
    var c1: f64 = BJ_FOURTH_ORDER_C1;
    var c2: f64 = BJ_FOURTH_ORDER_C2;
    var iok = _bj_fu_normal(inv);
    for (var i = 1; i < n - 2; i = i + 1) {
        var d1: f64 = field[i + 1] - field[i];
        var d2: f64 = field[i + 2] - field[i - 1];
        var a: f64 = c1 * d1;
        var b: f64 = c2 * d2;
        var s: f64 = a + b;
        var o: f64 = inv * s;
        # a, b and o normal: each exponent field in [1, 2046] (one test); else the exact checks (a zero factor is fine)
        var ea = (load64(&a) >> 52) & 2047;
        var eb = (load64(&b) >> 52) & 2047;
        var eo = (load64(&o) >> 52) & 2047;
        if (iok == 0 || ((ea - 1) | (eb - 1) | (eo - 1) | (2046 - ea) | (2046 - eb) | (2046 - eo)) < 0) {
            var ok = iok & _bj_fu_prod_ok(a, c1, d1) & _bj_fu_prod_ok(b, c2, d2);
            if (ok == 0 || _bj_fu_prod_ok(o, inv, s) == 0) { o = _bj_fu_fourth_ux(field, i, dx, o); }
        }
        out[i] = o;
    }
    var d0: f64 = field[1] - field[0];
    var o0: f64 = d0 * inv;
    if (iok == 0 || _bj_fu_prod_ok(o0, d0, inv) == 0) { o0 = _bj_fu_fourth_end_ux(field, 0, dx, o0); }
    out[0] = o0;
    var dn: f64 = field[n - 1] - field[n - 2];
    var on: f64 = dn * inv;
    if (iok == 0 || _bj_fu_prod_ok(on, dn, inv) == 0) { on = _bj_fu_fourth_end_ux(field, n - 2, dx, on); }
    out[n - 2] = on;
    return 0;
}

# ── the CW accumulator ──────────────────────────────────────────────────────────────────────────────────────────────

# 1 when x is 0, or finite with |x| ≥ 2^-1022.
#must_use
fn _bj_fu_normal(x: f64): i64 {
    if (x == 0.0) { return 1; }
    var a: f64 = f64_abs(x);
    if (a >= _BJ_FU_DMIN && a < _BJ_FU_INF) { return 1; }
    return 0;
}

# 1 when x is a positive normal value: at least 2^-1022 and finite.
#must_use
fn _bj_fu_pnormal(x: f64): i64 {
    if (x >= _BJ_FU_DMIN && x < _BJ_FU_INF) { return 1; }
    return 0;
}

# 1 when the product z = x·y kept the normal range: z normal, or 0 from a zero factor (not an underflow).
#must_use
fn _bj_fu_prod_ok(z: f64, x: f64, y: f64): i64 {
    if (_bj_fu_normal(z) == 0) { return 0; }
    if (z == 0.0 && x != 0.0 && y != 0.0) { return 0; }
    return 1;
}

# d[i] += f[i]·k for i < m, k = ks·2^ke to 53 bits with an unbounded exponent (ke ignored when exact is 1: ks is the
# double). Where k is a double (normal, or 0), src/crmath_edge.cyr's per-cell rule on the packed verbs through the
# scratch row w; where it lies below 2^-1022, every cell's product is the 53-bit f·k, and the sum is rounded once
# (IEEE's specials on a non-finite f or d).
fn _bj_fu_cw_sum(d: *f64, f: *f64, w: *f64, m, ks: f64, ke, exact) {
    var k: f64[1];
    k[0] = ks;
    if (exact == 0) {
        if (ks == 0.0) {
            exact = 1;
        } elif (ke >= 0 - 1022 && ke <= 1023) {
            k[0] = _bj_k_ux_round(ks, ke, 0.0);
            exact = 1;
        }
    }
    if (exact == 1) {
        _bj_e_cell_row(d, &k, 0, f, 0, w, m);
        return 0;
    }
    for (var i = 0; i < m; i = i + 1) {
        var ds, de = _bj_k_ux_from(d[i]);
        var fs, fe = _bj_k_ux_from(f[i]);
        var ps, pe = _bj_k_ux_mul(fs, fe, ks, ke);
        d[i] = _bj_k_ux_add_f64(ds, de, ps, pe);
    }
    return 0;
}

# A running single-frequency DFT, F(ω) = Σₙ f(tₙ)·e^{−jωtₙ}·Δt per grid point, its phases in e^{+jωt}. `real` and
# `imag` are the addresses of field_size f64 each (the cos and sin parts), `n_samples` the samples taken, `omega` 2πf,
# `dt` the time step. `work` is the update's scratch row and `map_bytes` the mapping's length (0 once freed, or for
# field_size 0); `mismatch_warned` is set once a length mismatch has been warned of. `omega_s`·2^`omega_e` is 2πf to 53
# bits with an unbounded exponent, which the phase takes where `omega`, Rust's rounded field, is ∞ (ADR 0002 row 18,
# M5 part 2d-4a); no Rust counterpart. Mirrors `CwAccumulator`.
public struct BjCwAccumulator {
    real;
    imag;
    field_size;
    n_samples;
    omega: f64;
    dt: f64;
    mismatch_warned;
    work;
    map_bytes;
    omega_s: f64;
    omega_e;
}

# An accumulator for field_size points at `frequency` (Hz) with step dt into *out, unchecked as Rust's (a non-finite
# frequency or an invalid dt is accepted with a warning and gives meaningless results): Ok(0), or Err(Allocation)
# with out untouched. Give it back with BjCwAccumulator_free. Mirrors `CwAccumulator::new`.
#must_use
public fn BjCwAccumulator_new(field_size, frequency: f64, dt: f64, out: *BjCwAccumulator): Result {
    var f0: f64 = frequency * 0.0;
    if ((f0 != 0.0 || _bj_fu_pos(dt) == 0) && _bj_log_on(2) == 1) {
        var lb[256];
        var lt[24];
        _bj_tx_init(&lt, &lb, 256);
        _bj_tx_cstr(&lt, "CwAccumulator created with invalid frequency/dt frequency=");
        _bj_fmt_f64_debug(&lt, frequency);
        _bj_tx_cstr(&lt, " dt=");
        _bj_fmt_f64_debug(&lt, dt);
        _bj_log_text(2, &lt);
    }
    var map = 0;
    if (field_size < 0 || field_size > 384307168202282325) {
        return Err(_bj_fu_alloc_err("a CW accumulator", field_size));
    }
    if (field_size > 0) {
        map = mmap_anon(field_size * 24);
        if (map == 0) { return Err(_bj_fu_alloc_err("a CW accumulator", field_size)); }
    }
    if (_bj_log_on(4) == 1) {
        var db[256];
        var dtx[24];
        _bj_tx_init(&dtx, &db, 256);
        _bj_tx_cstr(&dtx, "CW accumulator created field_size=");
        _bj_tx_u64(&dtx, field_size);
        _bj_tx_cstr(&dtx, " frequency=");
        _bj_fmt_f64_debug(&dtx, frequency);
        _bj_tx_cstr(&dtx, " dt=");
        _bj_fmt_f64_debug(&dtx, dt);
        _bj_log_text(4, &dtx);
    }
    var w: f64 = 2.0 * _BJ_FU_PI;
    var om: f64 = w * frequency;
    var ws, we = _bj_k_ux_from(w);
    var fs, fe = _bj_k_ux_from(frequency);
    var os, oe = _bj_k_ux_mul(ws, we, fs, fe);
    out.real = 0;
    out.imag = 0;
    out.work = 0;
    if (map != 0) {
        out.real = map;
        out.imag = map + field_size * 8;
        out.work = map + field_size * 16;
    }
    out.field_size = field_size;
    out.n_samples = 0;
    out.omega = om;
    out.dt = dt;
    out.mismatch_warned = 0;
    out.map_bytes = field_size * 24;
    out.omega_s = os;
    out.omega_e = oe;
    return Ok(0);
}

# An accumulator, checked: Ok(0), or with out untouched Err(InvalidParameter) "CW frequency must be finite and
# non-negative, got {f}" or "dt must be finite and positive, got {dt}", or Err(Allocation). Mirrors
# `CwAccumulator::try_new`.
#must_use
public fn BjCwAccumulator_try_new(field_size, frequency: f64, dt: f64, out: *BjCwAccumulator): Result {
    if (!(frequency >= 0.0 && frequency < _BJ_FU_INF)) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "CW frequency must be finite and non-negative, got ");
        _bj_fmt_f64_display(t, frequency);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (_bj_fu_pos(dt) == 0) {
        var t2 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t2, "dt must be finite and positive, got ");
        _bj_fmt_f64_display(t2, dt);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    return BjCwAccumulator_new(field_size, frequency, dt, out);
}

# Gives an accumulator's mapping back and empties it (field_size 0, every address 0); a second call does nothing.
public fn BjCwAccumulator_free(acc: *BjCwAccumulator): i64 {
    if (acc.map_bytes > 0 && acc.real != 0) { cyr_munmap(acc.real, acc.map_bytes); }
    acc.real = 0;
    acc.imag = 0;
    acc.work = 0;
    acc.field_size = 0;
    acc.map_bytes = 0;
    return 0;
}

impl BjCwAccumulator {
    # Accumulates the len samples at field, taken at t = time_step·dt (time_step a usize): real += f·cos(ωt)·Δt and
    # imag −= f·sin(ωt)·Δt, Rust's chain on the correctly rounded sin_cos. When len differs from field_size only the
    # common prefix is taken, with one warning. The sums run on src/crmath_edge.cyr's per-cell rule (each lane rounding
    # Rust's two operations, a cell at its range edge rerun with an unbounded exponent; imag += f·(−sin(ωt)·Δt), the
    # same bits). Where t, the phase ω·t or either coefficient leaves the normal range for a finite dt and ω (ω past
    # DBL_MAX included), the scalars run with an unbounded exponent, the sine and cosine past DBL_MAX by Payne–Hanek
    # (ADR 0002 row 18, M5 part 2d-4a). Mirrors `CwAccumulator::accumulate`.
    public fn accumulate(self, field: *f64, len, time_step) {
        var m = self.field_size;
        if (len != m && self.mismatch_warned == 0) {
            if (_bj_log_on(2) == 1) {
                var lb[256];
                var lt[24];
                _bj_tx_init(&lt, &lb, 256);
                _bj_tx_cstr(&lt, "CwAccumulator::accumulate length mismatch, using common prefix field_len=");
                _bj_tx_u64(&lt, len);
                _bj_tx_cstr(&lt, " accumulator_len=");
                _bj_tx_u64(&lt, m);
                _bj_log_text(2, &lt);
            }
            self.mismatch_warned = 1;
        }
        if (len < m) { m = len; }
        var sf: f64 = _bj_fu_u2f(time_step);
        var dt: f64 = self.dt;
        var t: f64 = sf * dt;
        var om: f64 = self.omega;
        var arg: f64 = om * t;
        var s, c = _bj_sin_cos(arg);
        var cos_dt: f64 = c * dt;
        var sin_dt: f64 = s * dt;
        var re: *f64 = _bj_fu_f64p(self.real);
        var im: *f64 = _bj_fu_f64p(self.imag);
        var w: *f64 = _bj_fu_f64p(self.work);
        var ok = _bj_fu_prod_ok(t, sf, dt) & _bj_fu_prod_ok(arg, om, t);
        ok = ok & _bj_fu_prod_ok(cos_dt, c, dt) & _bj_fu_prod_ok(sin_dt, s, dt);
        var fin: f64 = dt * 0.0 + self.omega_s * 0.0;
        if (ok == 1 || fin != 0.0) {
            _bj_fu_cw_sum(re, field, w, m, cos_dt, 0, 1);
            var nsd: f64 = -sin_dt;
            _bj_fu_cw_sum(im, field, w, m, nsd, 0, 1);
        } else {
            var ds, de = _bj_k_ux_from(dt);
            var ss0, se0 = _bj_k_ux_from(sf);
            var ts, te = _bj_k_ux_mul(ss0, se0, ds, de);
            var as, ae = _bj_k_ux_mul(self.omega_s, self.omega_e, ts, te);
            var ns, ne = _bj_vx_sin53(as, ae);
            var cs, ce = _bj_vx_cos53(as, ae);
            var kcs, kce = _bj_k_ux_mul(cs, ce, ds, de);
            var kss, kse = _bj_k_ux_mul(ns, ne, ds, de);
            _bj_fu_cw_sum(re, field, w, m, kcs, kce, 0);
            var nks: f64 = -kss;
            _bj_fu_cw_sum(im, field, w, m, nks, kse, 0);
        }
        self.n_samples = self.n_samples + 1;
        return 0;
    }

    # As accumulate, checked: Ok(0), or Err(InvalidParameter) "CwAccumulator expects {field_size} samples, got {len}"
    # with the accumulator untouched. Mirrors `CwAccumulator::try_accumulate`.
    #must_use
    public fn try_accumulate(self, field: *f64, len, time_step): Result {
        if (len != self.field_size) {
            var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(t, "CwAccumulator expects ");
            _bj_tx_u64(t, self.field_size);
            _bj_tx_cstr(t, " samples, got ");
            _bj_tx_u64(t, len);
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        self.accumulate(field, len, time_step);
        return Ok(0);
    }

    # |F(ω)| = √(re² + im²) at each point into out[0..field_size]: Rust's chain, which is BjComplex's abs, so at a range
    # edge (re or im outside [2^-511, 2^511) and not 0) the same unbounded chain, the root rounded once (ADR 0002 row
    # 18, M5 part 2d-4a: Rust's re² past DBL_MAX gave ∞, its underflow 0 or lost bits). Mirrors
    # `CwAccumulator::amplitude`.
    public fn amplitude(self, out: *f64) {
        var re: *f64 = _bj_fu_f64p(self.real);
        var im: *f64 = _bj_fu_f64p(self.imag);
        for (var i = 0; i < self.field_size; i = i + 1) {
            var r: f64 = re[i];
            var q: f64 = im[i];
            if (_bj_cx_plain(r, q) == 1) {
                var s: f64 = r * r + q * q;
                out[i] = f64_sqrt(s);
            } else {
                var us, ue = _bj_cx_ux_sumsq(r, q);
                out[i] = _bj_k_ux_sqrt_f64(us, ue);
            }
        }
        return 0;
    }

    # arg F(ω) = atan2(im, re) at each point into out[0..field_size], correctly rounded. Mirrors
    # `CwAccumulator::phase`.
    public fn phase(self, out: *f64) {
        var re: *f64 = _bj_fu_f64p(self.real);
        var im: *f64 = _bj_fu_f64p(self.imag);
        for (var i = 0; i < self.field_size; i = i + 1) {
            var r: f64 = re[i];
            var q: f64 = im[i];
            var a: f64 = _bj_atan2(q, r);
            out[i] = a;
        }
        return 0;
    }
}

# ── the eigenmode search ────────────────────────────────────────────────────────────────────────────────────────────

# The modes found by find_eigenmodes: `count` of them, their frequencies (Hz), quality factors Q = f₀/Δf from each
# peak's own half-power bandwidth (0.0 when it can't be found) and spectral amplitudes, at the addresses
# `frequencies`, `quality_factors` and `amplitudes` (one freelist block; 0 when count is 0). Give it back with
# BjEigenmodeResult_free. Mirrors `EigenmodeResult`.
public struct BjEigenmodeResult {
    frequencies;
    quality_factors;
    amplitudes;
    count;
}

# Gives a result's block back and empties it; a second call does nothing.
public fn BjEigenmodeResult_free(r: *BjEigenmodeResult): i64 {
    if (r.frequencies != 0) { fl_free(r.frequencies); }
    r.frequencies = 0;
    r.quality_factors = 0;
    r.amplitudes = 0;
    r.count = 0;
    return 0;
}

# ── the DFT magnitude at its range edges (ADR 0002 row 18, M5 part 2d-4b-1) ─────────────────────────────────────
#
# Rust's |Σᵢ sᵢ·e^{−jω·i·dt}|·dt runs a phasor recurrence: w = e^{−jω·dt}, each block of 1024 samples reseeded with
# z = e^{−jω·(1024b)·dt}, then per sample re += s·z_r, im += s·z_i and z ← z·w, and last √(re² + im²)·dt. With an
# unbounded exponent the chain differs from Rust's only where an operation leaves the normal range:
# - ω·dt or a block's (ω·1024b)·dt below 2^-1022 or past DBL_MAX (its sine and cosine then of a 53-bit angle);
# - the rotation z ← z·w, never, when |w_r| and |w_i| are both at least 2^-959 (or w = (1, ±0), ω·dt = 0): |z| and
#   |w| stay within 1 ± 10⁻¹² over a block, so in each of z_r·w_r − z_i·w_i and z_r·w_i + z_i·w_r one product is at
#   least 0.7·2^-959, a normal value whose ulp/4 exceeds 2^-1022, and the other, should it underflow, can't move
#   their sum (RN(P ± p) = P for |p| < ulp(P)/4). That is checked once a call, on w;
# - a product s·z_r or s·z_i that underflows (a nonzero subnormal, or 0 from nonzero factors) while its sum is below
#   2^-960 (above, the same absorption); checked per sample on the products' exponent fields;
# - a product or a sum past DBL_MAX, which leaves re or im non-finite at the end;
# - √(re² + im²) at BjComplex's abs edge, or its product with dt below 2^-1022.
# Where any holds for a finite ω and dt, the whole recurrence runs with an unbounded exponent, each operation to 53
# bits, the sines and cosines of the 53-bit angles (Payne–Hanek past DBL_MAX), the product with dt rounded once.

# (1, x) when the 53-bit x = s·2^e is a double, 0 or normal; else (0, 0.0).
#must_use
fn _bj_fu_exact(s: f64, e): (i64, f64) {
    if (s == 0.0) { return (1, s); }
    if (e < 0 - 1022 || e > 1023) { return (0, 0.0); }
    var x: f64 = _bj_k_ux_round(s, e, 0.0);
    return (1, x);
}

# Rust's dft_magnitude on the double ω, unchecked: for a non-finite ω, dt or sample, where Rust's result stands.
#must_use
fn _bj_fu_dft_rust(signal: *f64, n, omega: f64, dt: f64): f64 {
    var od: f64 = omega * dt;
    var s1, c1 = _bj_sin_cos(od);
    var wr: f64 = c1;
    var wi: f64 = -s1;
    var re: f64 = 0.0;
    var im: f64 = 0.0;
    var start = 0;
    while (start < n) {
        var bf: f64 = _bj_fu_u2f(start);
        var a: f64 = omega * bf;
        var arg: f64 = a * dt;
        var s0, c0 = _bj_sin_cos(arg);
        var zr: f64 = c0;
        var zi: f64 = -s0;
        var end = start + 1024;
        if (end > n) { end = n; }
        for (var i = start; i < end; i = i + 1) {
            var s: f64 = signal[i];
            re = re + s * zr;
            im = im + s * zi;
            var nr: f64 = zr * wr - zi * wi;
            zi = zr * wi + zi * wr;
            zr = nr;
        }
        start = end;
    }
    var m: f64 = re * re + im * im;
    var r: f64 = f64_sqrt(m);
    var r2: f64 = r * dt;
    return r2;
}

# The recurrence with an unbounded exponent throughout (the section comment's slow path), for the 53-bit ω = ws·2^we
# and a finite dt; a non-finite sample keeps Rust's chain.
#must_use
fn _bj_fu_dft_ux(signal: *f64, n, ws: f64, we, dt: f64): f64 {
    for (var k = 0; k < n; k = k + 1) {
        var z0: f64 = signal[k] * 0.0;
        if (z0 != 0.0) {
            var om: f64 = _bj_k_ux_round(ws, we, 0.0);
            var rr: f64 = _bj_fu_dft_rust(signal, n, om, dt);
            return rr;
        }
    }
    var ds, de = _bj_k_ux_from(dt);
    var os, oe = _bj_k_ux_mul(ws, we, ds, de);
    var ws1, we1 = _bj_vx_sin53(os, oe);
    var wrs, wre = _bj_vx_cos53(os, oe);
    var wis: f64 = -ws1;
    var wie = we1;
    var rs: f64 = 0.0;
    var rex = 0;
    var is: f64 = 0.0;
    var iex = 0;
    var start = 0;
    while (start < n) {
        var bs, be = _bj_k_ux_from(_bj_fu_u2f(start));
        var as, ae = _bj_k_ux_mul(ws, we, bs, be);
        var gs, ge = _bj_k_ux_mul(as, ae, ds, de);
        var zs0, ze0 = _bj_vx_sin53(gs, ge);
        var zrs, zre = _bj_vx_cos53(gs, ge);
        var zis: f64 = -zs0;
        var zie = ze0;
        var end = start + 1024;
        if (end > n) { end = n; }
        for (var i = start; i < end; i = i + 1) {
            var ss, se = _bj_k_ux_from(signal[i]);
            var prs, pre = _bj_k_ux_mul(ss, se, zrs, zre);
            var nrs, nre = _bj_k_ux_add(rs, rex, prs, pre);
            rs = nrs;
            rex = nre;
            var pis, pie = _bj_k_ux_mul(ss, se, zis, zie);
            var nis, nie = _bj_k_ux_add(is, iex, pis, pie);
            is = nis;
            iex = nie;
            var p1s, p1e = _bj_k_ux_mul(zrs, zre, wrs, wre);
            var p2s, p2e = _bj_k_ux_mul(zis, zie, wis, wie);
            var p3s, p3e = _bj_k_ux_mul(zrs, zre, wis, wie);
            var p4s, p4e = _bj_k_ux_mul(zis, zie, wrs, wre);
            var qrs, qre = _bj_k_ux_sub(p1s, p1e, p2s, p2e);
            var qis, qie = _bj_k_ux_add(p3s, p3e, p4s, p4e);
            zrs = qrs;
            zre = qre;
            zis = qis;
            zie = qie;
        }
        start = end;
    }
    var r2s, r2e = _bj_k_ux_mul(rs, rex, rs, rex);
    var i2s, i2e = _bj_k_ux_mul(is, iex, is, iex);
    var ms, me = _bj_k_ux_add(r2s, r2e, i2s, i2e);
    var qs, qe = _bj_k_ux_sqrt(ms, me);
    var r: f64 = _bj_k_ux_mul_f64(qs, qe, ds, de);
    return r;
}

# 1 when the product p = s·z, beside its sum's running value acc, is one the unbounded chain would change (the section
# comment): a nonzero subnormal, or ±0 from a nonzero z (s is nonzero here), while |acc| < 2^-960.
#must_use
fn _bj_fu_dft_low(p: f64, z: f64, acc: f64): i64 {
    if (((load64(&p) >> 52) & 2047) != 0) { return 0; }
    if (p == 0.0 && z == 0.0) { return 0; }
    var a: f64 = f64_abs(acc);
    if (a >= _BJ_FU_2M960) { return 0; }
    return 1;
}

# |Σᵢ sᵢ·e^{−jω·i·dt}|·dt over the n samples at signal for the 53-bit ω = ws·2^we, by Rust's phasor recurrence (one
# complex multiply a sample by e^{−jω·dt}, the phasor reseeded from the correctly rounded sin_cos of ω·(1024·b)·dt at
# each block of 1024), at its range edges as the section comment has it; a non-finite ω, dt or sample keeps Rust's.
#must_use
fn _bj_fu_dft(signal: *f64, n, ws: f64, we, dt: f64): f64 {
    var fin: f64 = ws * 0.0 + dt * 0.0;
    if (fin != 0.0) {
        var om: f64 = _bj_k_ux_round(ws, we, 0.0);
        var rr: f64 = _bj_fu_dft_rust(signal, n, om, dt);
        return rr;
    }
    var ds, de = _bj_k_ux_from(dt);
    var os, oe = _bj_k_ux_mul(ws, we, ds, de);
    var ok, od = _bj_fu_exact(os, oe);
    if (ok == 0) {
        var u0: f64 = _bj_fu_dft_ux(signal, n, ws, we, dt);
        return u0;
    }
    var s1, c1 = _bj_sin_cos(od);
    var wr: f64 = c1;
    var wi: f64 = -s1;
    var awr: f64 = f64_abs(wr);
    var awi: f64 = f64_abs(wi);
    if (!((awr >= _BJ_FU_2M959 && awi >= _BJ_FU_2M959) || (wr == 1.0 && wi == 0.0))) {
        var u1: f64 = _bj_fu_dft_ux(signal, n, ws, we, dt);
        return u1;
    }
    var re: f64 = 0.0;
    var im: f64 = 0.0;
    var start = 0;
    while (start < n) {
        var bs, be = _bj_k_ux_from(_bj_fu_u2f(start));
        var as, ae = _bj_k_ux_mul(ws, we, bs, be);
        var gs, ge = _bj_k_ux_mul(as, ae, ds, de);
        var okb, arg = _bj_fu_exact(gs, ge);
        if (okb == 0) {
            var u2: f64 = _bj_fu_dft_ux(signal, n, ws, we, dt);
            return u2;
        }
        var s0, c0 = _bj_sin_cos(arg);
        var zr: f64 = c0;
        var zi: f64 = -s0;
        var end = start + 1024;
        if (end > n) { end = n; }
        for (var i = start; i < end; i = i + 1) {
            var s: f64 = signal[i];
            var pr: f64 = s * zr;
            var pi: f64 = s * zi;
            # either product's exponent field 0 (a subnormal or a zero): (e − 1) is then negative, so one test
            if (((((load64(&pr) >> 52) & 2047) - 1) | (((load64(&pi) >> 52) & 2047) - 1)) < 0) {
                if (s != 0.0 && (_bj_fu_dft_low(pr, zr, re) == 1 || _bj_fu_dft_low(pi, zi, im) == 1)) {
                    var u3: f64 = _bj_fu_dft_ux(signal, n, ws, we, dt);
                    return u3;
                }
            }
            re = re + pr;
            im = im + pi;
            var nr: f64 = zr * wr - zi * wi;
            zi = zr * wi + zi * wr;
            zr = nr;
        }
        start = end;
    }
    var fr: f64 = re * 0.0 + im * 0.0;
    if (fr != 0.0) {
        var u4: f64 = _bj_fu_dft_ux(signal, n, ws, we, dt);
        return u4;
    }
    if (_bj_cx_plain(re, im) == 1) {
        var m: f64 = re * re + im * im;
        var r: f64 = f64_sqrt(m);
        var r2: f64 = r * dt;
        if (_bj_fu_prod_ok(r2, r, dt) == 1) { return r2; }
    }
    var us, ue = _bj_cx_ux_sumsq(re, im);
    var qs, qe = _bj_k_ux_sqrt(us, ue);
    var r3: f64 = _bj_k_ux_mul_f64(qs, qe, ds, de);
    return r3;
}

# The DFT magnitude for a double ω: _bj_fu_dft on its exact value. Public for tests/fdtd_util.tcyr (Rust's test of it
# reaches the private fn). Mirrors fdtd.rs's `dft_magnitude`.
#must_use
public fn _bj_fu_dft_magnitude(signal: *f64, n, omega: f64, dt: f64): f64 {
    var ws, we = _bj_k_ux_from(omega);
    var r: f64 = _bj_fu_dft(signal, n, ws, we, dt);
    return r;
}

# The offset, in units of df (≥ 0), from the peak to its half-power crossing walking in direction dir (±1), linearly
# interpolated; 1 with the offset in *off, or 0 when the spectrum's edge or a rising flank (a neighbouring mode) comes
# first; 2 where the interpolation's quotient leaves the normal range (ADR 0002 row 18: the caller reruns it with an
# unbounded exponent). Mirrors fdtd.rs's `half_power_offset`.
fn _bj_fu_half_power(spec: *f64, n, peak, dir, off: *f64): i64 {
    var hp: f64 = spec[peak] / _BJ_FU_SQRT_2;
    var i = peak;
    while (1 == 1) {
        var next = i + dir;
        if (next < 0 || next >= n) { return 0; }
        var a_next: f64 = spec[next];
        var a_cur: f64 = spec[i];
        if (a_next < hp) {
            var num: f64 = a_cur - hp;
            var den: f64 = a_cur - a_next;
            var frac: f64 = num / den;
            if (_bj_fu_normal(frac) == 0 || (frac == 0.0 && num != 0.0)) { return 2; }
            var d = i - peak;
            if (d < 0) { d = 0 - d; }
            var df: f64 = f64_from(d);
            off[0] = df + frac;
            return 1;
        }
        if (a_next > a_cur) { return 0; }
        i = next;
    }
    return 0;
}

# _bj_fu_half_power with an unbounded exponent (ADR 0002 row 18, M5 part 2d-4b-2): hp = spec[peak]/√2 to 53 bits, the
# walk's a_next < hp decided exactly, the offset |i − peak| + (a_cur − hp)/(a_cur − a_next) to 53 bits into (os[0],
# oe[0]); 1 when found, else 0.
fn _bj_fu_half_power_ux(spec: *f64, n, peak, dir, os: *f64, oe): i64 {
    var ps, pe = _bj_k_ux_from(spec[peak]);
    var rs, re = _bj_k_ux_from(_BJ_FU_SQRT_2);
    var hs, he = _bj_k_ux_div(ps, pe, rs, re);
    var i = peak;
    while (1 == 1) {
        var next = i + dir;
        if (next < 0 || next >= n) { return 0; }
        var a_next: f64 = spec[next];
        var a_cur: f64 = spec[i];
        var ns, ne = _bj_k_ux_from(a_next);
        if (_bj_k_ux_cmp(ns, ne, hs, he) == 0 - 1) {
            var cs, ce = _bj_k_ux_from(a_cur);
            var us, ue = _bj_k_ux_sub(cs, ce, hs, he);
            var vs, ve = _bj_k_ux_sub(cs, ce, ns, ne);
            var qs, qe = _bj_k_ux_div(us, ue, vs, ve);
            var d = i - peak;
            if (d < 0) { d = 0 - d; }
            var ds, de = _bj_k_ux_from(f64_from(d));
            var xs, xe = _bj_k_ux_add(ds, de, qs, qe);
            os[0] = xs;
            store64(oe, xe);
            return 1;
        }
        if (a_next > a_cur) { return 0; }
        i = next;
    }
    return 0;
}

# The quality factor with an unbounded exponent: the offsets from _bj_fu_half_power_ux, bw = l + r (or twice the one),
# and f₀/(bw·df) for the 53-bit f₀ and df, rounded once; 0.0 as Rust's when no offset or no positive bandwidth.
#must_use
fn _bj_fu_quality_ux(spec: *f64, n, i, f0s: f64, f0e, dfs: f64, dfe): f64 {
    var ls: f64[1];
    var rs: f64[1];
    var le = 0;
    var re = 0;
    var hl = _bj_fu_half_power_ux(spec, n, i, 0 - 1, &ls, &le);
    var hr = _bj_fu_half_power_ux(spec, n, i, 1, &rs, &re);
    if (hl == 0 && hr == 0) { return 0.0; }
    var bs: f64 = 0.0;
    var be = 0;
    if (hl == 1 && hr == 1) {
        var ss, se = _bj_k_ux_add(ls[0], le, rs[0], re);
        bs = ss;
        be = se;
    } elif (hl == 1) {
        bs = ls[0];
        be = le + 1;
    } else {
        bs = rs[0];
        be = re + 1;
    }
    if (bs > 0.0) {
        var ps, pe = _bj_k_ux_mul(bs, be, dfs, dfe);
        var q: f64 = _bj_k_ux_div_f64(f0s, f0e, ps, pe);
        return q;
    }
    return 0.0;
}

# The quality factor of the peak at index i: f₀/(Δf·df) from its half-power offsets (both sides, or twice the one
# found), 0.0 when neither is found or the bandwidth isn't positive. f₀ and df are 53-bit values with an unbounded
# exponent: where both are doubles and the chain's every step stays in range (hp, the interpolation, bw·df and the
# quotient normal, or an exact 0), Rust's chain; else _bj_fu_quality_ux (ADR 0002 row 18, M5 part 2d-4b-2).
#must_use
fn _bj_fu_quality(spec: *f64, n, i, f0s: f64, f0e, dfs: f64, dfe): f64 {
    var ok0, f0 = _bj_fu_exact(f0s, f0e);
    var ok1, df = _bj_fu_exact(dfs, dfe);
    var hp: f64 = spec[i] / _BJ_FU_SQRT_2;
    if (ok0 == 0 || ok1 == 0 || _bj_fu_normal(hp) == 0) {
        var u0: f64 = _bj_fu_quality_ux(spec, n, i, f0s, f0e, dfs, dfe);
        return u0;
    }
    var l: f64[1];
    var r: f64[1];
    var hl = _bj_fu_half_power(spec, n, i, 0 - 1, &l);
    var hr = _bj_fu_half_power(spec, n, i, 1, &r);
    if (hl == 2 || hr == 2) {
        var u1: f64 = _bj_fu_quality_ux(spec, n, i, f0s, f0e, dfs, dfe);
        return u1;
    }
    var bw: f64 = 0.0;
    if (hl == 0 && hr == 0) { return 0.0; }
    if (hl == 1 && hr == 1) { bw = l[0] + r[0]; }
    elif (hl == 1) { bw = 2.0 * l[0]; }
    else { bw = 2.0 * r[0]; }
    if (bw > 0.0) {
        var b: f64 = bw * df;
        var q: f64 = f0 / b;
        if (_bj_fu_prod_ok(b, bw, df) == 0 || _bj_fu_normal(q) == 0 || (q == 0.0 && f0 != 0.0)) {
            var u2: f64 = _bj_fu_quality_ux(spec, n, i, f0s, f0e, dfs, dfe);
            return u2;
        }
        return q;
    }
    return 0.0;
}

# f_min + i·df with df = dfs·2^dfe, each operation to 53 bits with an unbounded exponent: (s, e).
#must_use
fn _bj_fu_freq(freq_min: f64, i, dfs: f64, dfe): (f64, i64) {
    var is, ie = _bj_k_ux_from(f64_from(i));
    var xs, xe = _bj_k_ux_mul(is, ie, dfs, dfe);
    var ms, me = _bj_k_ux_from(freq_min);
    var s, e = _bj_k_ux_add(ms, me, xs, xe);
    return (s, e);
}

# 1 when amp passes the 10 % floor: amp > t for the double t (tok 1), else amp above the 53-bit t = ts·2^te exactly.
#must_use
fn _bj_fu_floor(amp: f64, t: f64, tok, ts: f64, te): i64 {
    if (tok == 1) {
        if (amp > t) { return 1; }
        return 0;
    }
    var as, ae = _bj_k_ux_from(amp);
    if (_bj_k_ux_cmp(as, ae, ts, te) == 1) { return 1; }
    return 0;
}

# 1 when freq_max > 1/(2·dt) exactly, freq_max·dt > ½ (ADR 0002 row 17, M5 part 2c; Rust's freq_max > RN(0.5/dt)), for
# finite freq_max ≥ 0 and dt > 0: the rounded product decides outside ±2^-50, the sign of the exact freq_max·dt − ½
# inside (src/crmath_edge.cyr's rational 16). Public for tests/fdtd_util.tcyr: it only gates a warning.
#must_use
public fn _bj_fu_over_nyquist(freq_max: f64, dt: f64): i64 {
    var p: f64 = freq_max * dt;
    var lo: f64 = 0.4999999999999995;
    var hi: f64 = 0.5000000000000005;
    if (p < lo) { return 0; }
    if (p > hi) { return 1; }
    var rv: f64[3];
    rv[0] = freq_max;
    rv[1] = dt;
    rv[2] = 0.5;
    var ro: f64[1];
    var k = _bj_cr_rat(&rv, 3, _bj_cr_rat_spec(16), 0, &ro);
    var s: f64 = ro[0];
    if (s > 0.0) { return 1; }
    return 0;
}

# Records InvalidParameter with a fixed reason; returns its code.
fn _bj_fu_bad(reason): i64 {
    _bj_tx_cstr(_bj_err_reason(BJ_ERR_INVALID_PARAMETER), reason);
    return BJ_ERR_INVALID_PARAMETER;
}

# The resonances in the n samples at signal (step dt): the DFT magnitude at n_freq frequencies spanning [freq_min,
# freq_max] inclusive, then every strict local maximum above 10 % of the strongest, with its half-power Q, into *out
# (free a previous result first). Ok(0), or with out untouched Err(InvalidParameter) for an empty signal, n_freq < 2,
# a dt that isn't finite and positive, a range other than 0 ≤ freq_min < freq_max < ∞, or a non-finite sample (in that
# order, Rust's texts); Err(Allocation) when the spectrum or the result can't be had. A freq_max past Nyquist is
# warned of. Mirrors `find_eigenmodes`.
#must_use
public fn bj_find_eigenmodes(signal: *f64, n, dt: f64, freq_min: f64, freq_max: f64, n_freq,
  out: *BjEigenmodeResult): Result {
    if (n == 0) { return Err(_bj_fu_bad("time signal is empty")); }
    if (n_freq >= 0 && n_freq < 2) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "need at least two frequency points, got ");
        _bj_tx_u64(t, n_freq);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (_bj_fu_pos(dt) == 0) {
        var t2 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t2, "dt must be finite and positive, got ");
        _bj_fmt_f64_display(t2, dt);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (!(freq_min >= 0.0 && freq_min < freq_max && freq_max < _BJ_FU_INF)) {
        var t3 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t3, "need 0 <= freq_min < freq_max < inf, got freq_min = ");
        _bj_fmt_f64_display(t3, freq_min);
        _bj_tx_cstr(t3, ", freq_max = ");
        _bj_fmt_f64_display(t3, freq_max);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var fin: f64 = 0.0;
    for (var k = 0; k < n; k = k + 1) { fin = fin + signal[k] * 0.0; }
    if (fin != 0.0) { return Err(_bj_fu_bad("time signal contains non-finite values")); }
    var nyq: f64 = 0.5 / dt;
    if (_bj_log_on(2) == 1 && _bj_fu_over_nyquist(freq_max, dt) == 1) {
        var lb[256];
        var lt[24];
        _bj_tx_init(&lt, &lb, 256);
        _bj_tx_cstr(&lt, "find_eigenmodes: freq_max above Nyquist, spectrum is aliased freq_max=");
        _bj_fmt_f64_debug(&lt, freq_max);
        _bj_tx_cstr(&lt, " nyquist=");
        _bj_fmt_f64_debug(&lt, nyq);
        _bj_log_text(2, &lt);
    }
    if (_bj_log_on(4) == 1) {
        var db[256];
        var dtx[24];
        _bj_tx_init(&dtx, &db, 256);
        _bj_tx_cstr(&dtx, "finding eigenmodes via DFT n_samples=");
        _bj_tx_u64(&dtx, n);
        _bj_tx_cstr(&dtx, " dt=");
        _bj_fmt_f64_debug(&dtx, dt);
        _bj_tx_cstr(&dtx, " freq_min=");
        _bj_fmt_f64_debug(&dtx, freq_min);
        _bj_tx_cstr(&dtx, " freq_max=");
        _bj_fmt_f64_debug(&dtx, freq_max);
        _bj_tx_cstr(&dtx, " n_freq=");
        _bj_tx_u64(&dtx, n_freq);
        _bj_log_text(4, &dtx);
    }
    if (n_freq < 0 || n_freq > _BJ_FU_FL_MAX / 8) { return Err(_bj_fu_alloc_err("an eigenmode spectrum", n_freq)); }
    var sb = fl_alloc(n_freq * 8);
    if (sb == 0) { return Err(_bj_fu_alloc_err("an eigenmode spectrum", n_freq)); }
    var spec: *f64 = _bj_fu_f64p(sb);
    # Rust's df = (f_max − f_min)/(n − 1), f_i = f_min + i·df and ω_i = 2π·f_i, each to 53 bits with an unbounded
    # exponent (ADR 0002 row 18, M5 part 2d-4b-2): Rust's bits in range; a df below 2^-1022, an f_i past DBL_MAX or an
    # ω_i past it (f past 2.86·10³⁰⁷, where Rust's NaN spectrum hid the peak beside it) keep their values.
    var span: f64 = freq_max - freq_min;
    var nm: f64 = _bj_fu_u2f(n_freq - 1);
    var sps, spe = _bj_k_ux_from(span);
    var nms, nme = _bj_k_ux_from(nm);
    var dfs, dfe = _bj_k_ux_div(sps, spe, nms, nme);
    var w2: f64 = 2.0 * _BJ_FU_PI;
    var w2s, w2e = _bj_k_ux_from(w2);
    for (var fi = 0; fi < n_freq; fi = fi + 1) {
        var fqs, fqe = _bj_fu_freq(freq_min, fi, dfs, dfe);
        var oms, ome = _bj_k_ux_mul(w2s, w2e, fqs, fqe);
        spec[fi] = _bj_fu_dft(signal, n, oms, ome, dt);
    }
    var max_amp: f64 = 0.0;
    for (var j = 0; j < n_freq; j = j + 1) {
        var sj: f64 = spec[j];
        max_amp = _bj_max(max_amp, sj);
    }
    # The 10 % floor max·0.1, its test on the computed value (plan §0.1): Rust's double, or below 2^-1022 the 53-bit
    # value, compared exactly (ADR 0002 row 18, M5 part 2d-4b-2).
    var mxs, mxe = _bj_k_ux_from(max_amp);
    var ps1, pe1 = _bj_k_ux_from(0.1);
    var ths, the = _bj_k_ux_mul(mxs, mxe, ps1, pe1);
    var tok, threshold = _bj_fu_exact(ths, the);
    var count = 0;
    for (var i = 1; i < n_freq - 1; i = i + 1) {
        var amp: f64 = spec[i];
        if (_bj_fu_floor(amp, threshold, tok, ths, the) == 1 && amp > spec[i - 1] && amp > spec[i + 1]) {
            count = count + 1;
        }
    }
    var rb = 0;
    if (count > 0) {
        rb = fl_alloc(count * 24);
        if (rb == 0) {
            fl_free(sb);
            return Err(_bj_fu_alloc_err("an eigenmode result", count * 3));
        }
    }
    var fr: *f64 = _bj_fu_f64p(rb);
    var qs: *f64 = _bj_fu_f64p(rb + count * 8);
    var am: *f64 = _bj_fu_f64p(rb + count * 16);
    var m = 0;
    for (var i2 = 1; i2 < n_freq - 1; i2 = i2 + 1) {
        var a2: f64 = spec[i2];
        if (_bj_fu_floor(a2, threshold, tok, ths, the) == 1 && a2 > spec[i2 - 1] && a2 > spec[i2 + 1]) {
            var f0s, f0e = _bj_fu_freq(freq_min, i2, dfs, dfe);
            fr[m] = _bj_k_ux_round(f0s, f0e, 0.0);
            qs[m] = _bj_fu_quality(spec, n_freq, i2, f0s, f0e, dfs, dfe);
            am[m] = a2;
            m = m + 1;
        }
    }
    fl_free(sb);
    out.count = count;
    out.frequencies = 0;
    out.quality_factors = 0;
    out.amplitudes = 0;
    if (count > 0) {
        out.frequencies = rb;
        out.quality_factors = rb + count * 8;
        out.amplitudes = rb + count * 16;
    }
    return Ok(0);
}

# --- cpml.cyr ---

# cpml.cyr — fdtd.rs's convolutional PML (M6 part 1a): `CpmlParams`, the grading of an absorbing layer, and `Cpml`,
# the layer itself, Roden & Gedney's stretched-coordinate PML with recursive convolution (Taflove & Hagness, 3rd ed.,
# §7.9–7.11). Inside the layer each spatial derivative ∂/∂u normal to it becomes (1/κ_u)·∂/∂u + Ψ_u, with
#
#   Ψ_u ← b_u·Ψ_u + c_u·∂/∂u,  b = exp(−(σ/κ + α)·Δt/ε₀),  c = σ·(b − 1)/(κ·(σ + κα)),
#
# and with ρ ∈ (0, 1] the depth into the layer (1 at the outer wall), σ(ρ) = σ_max·ρ^m, σ_max = sigma_ratio·σ_opt,
# σ_opt = 0.8·(m + 1)/(η₀·Δx), κ(ρ) = 1 + (κ_max − 1)·ρ^m and α(ρ) = α_max·(1 − ρ) (the complex-frequency shift).
# The profiles b, c and 1/κ − 1 are sampled at the integer nodes l cells from the wall and at the half nodes l + ½
# cells from it, l = 0..t; the 2D grid's strip corrections read them (src/fdtd2d.cyr). Ψ is stored only inside the
# PML, the four edge strips of a 2D grid. The powf and the exp are correctly rounded (src/crmath.cyr). The file is
# time-domain only; bijli's one harmonic convention, e^{+jωt}, is stated in src/complex.cyr's header.

private

var _BJ_CPML_INF: f64 = 0x7FF0000000000000;
# The nodes required between opposite layers: a grid needs 2·thickness + 3 ≤ its smallest dimension.
var _BJ_CPML_MIN_INTERIOR = 3;
# freelist's largest request, 2 GiB: the six profiles' block caps the thickness at 2^31/48 layers.
var _BJ_CPML_FL_MAX = 2147483648;

# A word as a *f64 (the typed return keeps the binding typed).
#must_use
fn _bj_cpml_f64p(a): *f64 {
    return a;
}

# 1 when a ≥ b as usize words (a negative word is past 2^63).
#must_use
fn _bj_cpml_uge(a, b): i64 {
    if ((a < 0) == (b < 0)) {
        if (a >= b) { return 1; }
        return 0;
    }
    if (a < 0) { return 1; }
    return 0;
}

# The usize product a·b into *out: 1, or 0 when it overflows 64 bits (Rust's `checked_mul` None).
fn _bj_cpml_umul(a, b, out: *i64): i64 {
    var ah = a >> 32;
    var al = a & 0xFFFFFFFF;
    var bh = b >> 32;
    var bl = b & 0xFFFFFFFF;
    if (ah != 0 && bh != 0) { return 0; }
    var cross = ah * bl + al * bh;
    if ((cross >> 32) != 0) { return 0; }
    var lo = al * bl;
    var hi = cross << 32;
    var s = lo + hi;
    if (_bj_cpml_uge(s, lo) == 0) { return 0; }
    out[0] = s;
    return 1;
}

# 1 when a CPML of `thickness` cells a side fits a grid whose smallest dimension is min_dim nodes: thickness ≥ 1 and
# 2·thickness + 3 ≤ min_dim, the sum checked against overflow. Public for src/fdtd2d.cyr and src/fdtd3d.cyr. Mirrors
# fdtd.rs's `cpml_fits`.
#must_use
public fn _bj_cpml_fits(thickness, min_dim): i64 {
    if (thickness == 0) { return 0; }
    var t2: i64[1];
    if (_bj_cpml_umul(thickness, 2, &t2) == 0) { return 0; }
    var need = t2[0] + _BJ_CPML_MIN_INTERIOR;
    if (_bj_cpml_uge(need, t2[0]) == 0) { return 0; }
    return _bj_cpml_uge(min_dim, need);
}

# A CPML layer's grading: `thickness` PML cells a side (≥ 1, typically 8–20), the polynomial grading order m
# (finite, ≥ 1; typically 3–4), sigma_ratio = σ_max/σ_opt (finite, > 0; typically 0.7–1.5), kappa_max = κ_max
# (finite, ≥ 1) and alpha_max = α_max in S/m (finite, ≥ 0). The classic grading (m = 3, σ_max = σ_opt, κ_max = 1,
# α_max = 0) absorbs propagating waves over a wide range of incidence (about −88 dB for a 10-cell layer around a 2D
# point source, −80 dB in 3D); κ_max of 5–15 and an α_max absorb evanescent and grazing fields better, α_max =
# 2π·ε₀·f_c acting only near and below f_c. σ_opt assumes vacuum: scale sigma_ratio by 1/√(ε_r·μ_r) for a filled
# layer. Mirrors `CpmlParams`.
public struct BjCpmlParams {
    thickness;
    grading_order: f64;
    sigma_ratio: f64;
    kappa_max: f64;
    alpha_max: f64;
}

# The classic grading for a layer `thickness` cells thick: m = 3, σ_max = σ_opt, κ_max = 1, α_max = 0. Mirrors
# `CpmlParams::new`.
#must_use
public fn BjCpmlParams_new(thickness): BjCpmlParams {
    var p: BjCpmlParams;
    p.thickness = thickness;
    p.grading_order = 3.0;
    p.sigma_ratio = 1.0;
    p.kappa_max = 1.0;
    p.alpha_max = 0.0;
    return p;
}

# Records InvalidParameter "{name} must be finite and {rule}, got {x}"; returns its code.
fn _bj_cpml_bad_f(name, rule, x: f64): i64 {
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, name);
    _bj_tx_cstr(t, " must be finite and ");
    _bj_tx_cstr(t, rule);
    _bj_tx_cstr(t, ", got ");
    _bj_fmt_f64_display(t, x);
    return BJ_ERR_INVALID_PARAMETER;
}

# 0 when every parameter is finite and in range, else InvalidParameter recorded (Rust's texts, in Rust's order) and
# its code. Mirrors `CpmlParams::validate`.
fn _bj_cpml_params_validate(p: *BjCpmlParams): i64 {
    if (p.thickness == 0) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_INVALID_PARAMETER), "CPML thickness must be at least 1 cell");
        return BJ_ERR_INVALID_PARAMETER;
    }
    var m: f64 = p.grading_order;
    if (!(m >= 1.0 && m < _BJ_CPML_INF)) { return _bj_cpml_bad_f("CPML grading order", "≥ 1", m); }
    var sr: f64 = p.sigma_ratio;
    if (!(sr > 0.0 && sr < _BJ_CPML_INF)) { return _bj_cpml_bad_f("CPML sigma_ratio", "> 0", sr); }
    var km: f64 = p.kappa_max;
    if (!(km >= 1.0 && km < _BJ_CPML_INF)) { return _bj_cpml_bad_f("CPML kappa_max", "≥ 1", km); }
    var am: f64 = p.alpha_max;
    if (!(am >= 0.0 && am < _BJ_CPML_INF)) { return _bj_cpml_bad_f("CPML alpha_max", "≥ 0", am); }
    return 0;
}

# A convolutional PML layer (the file comment). `thickness` is the cells a side; grading_order, sigma_max (S/m),
# kappa_max and alpha_max (S/m) are read through the accessors. b_node, c_node and km1_node hold b, c and 1/κ − 1 at
# the integer nodes l cells from the outer wall (l = 0 is the wall node), b_half, c_half and km1_half at l + ½ cells,
# each the address of `prof_n` f64 (thickness, or 0 for the inert layer of invalid input), all six in one freelist
# block at `prof_block`. nx × ny is the grid the Ψ fields are allocated for (0 × 0 unattached): psi_fx_y and psi_fz_y
# (Ψ of ∂f_z/∂y in the f_x update and of ∂f_x/∂y in the f_z update, the y-strips, index (side·t + l)·nx + x) hold
# psi_x_len f64 each, psi_fy_x and psi_fz_x (Ψ of ∂f_z/∂x in the f_y update and of ∂f_y/∂x in the f_z update, the
# x-strips, index y·2t + side·t + l) psi_y_len each, all four in one anonymous mapping of psi_bytes (0 when none).
# Give it back with BjCpml_free. Mirrors `Cpml`.
public struct BjCpml {
    thickness;
    grading_order: f64;
    sigma_max: f64;
    kappa_max: f64;
    alpha_max: f64;
    b_node;
    c_node;
    km1_node;
    b_half;
    c_half;
    km1_half;
    prof_n;
    prof_block;
    nx;
    ny;
    psi_fx_y;
    psi_fz_y;
    psi_fy_x;
    psi_fz_x;
    psi_x_len;
    psi_y_len;
    psi_bytes;
}

# An unattached layer of params' grading with sigma_max into *out, its profiles the block `prof` of prof_n layers (0
# and 0: the inert layer). Mirrors `Cpml::from_profiles`.
fn _bj_cpml_from(params: *BjCpmlParams, sigma_max: f64, prof, prof_n, out: *BjCpml) {
    out.thickness = params.thickness;
    out.grading_order = params.grading_order;
    out.sigma_max = sigma_max;
    out.kappa_max = params.kappa_max;
    out.alpha_max = params.alpha_max;
    out.prof_block = prof;
    out.prof_n = prof_n;
    out.b_node = 0;
    out.c_node = 0;
    out.km1_node = 0;
    out.b_half = 0;
    out.c_half = 0;
    out.km1_half = 0;
    if (prof != 0) {
        out.b_node = prof;
        out.c_node = prof + prof_n * 8;
        out.km1_node = prof + 2 * prof_n * 8;
        out.b_half = prof + 3 * prof_n * 8;
        out.c_half = prof + 4 * prof_n * 8;
        out.km1_half = prof + 5 * prof_n * 8;
    }
    out.nx = 0;
    out.ny = 0;
    out.psi_fx_y = 0;
    out.psi_fz_y = 0;
    out.psi_fy_x = 0;
    out.psi_fz_x = 0;
    out.psi_x_len = 0;
    out.psi_y_len = 0;
    out.psi_bytes = 0;
    return 0;
}

# The recursive-convolution coefficients (b, c, 1/κ − 1) at depth rho ∈ [0, 1], in Rust's order of operations:
# grade = ρ^m, σ = σ_max·grade, κ = 1 + (κ_max − 1)·grade, α = α_max·(1 − ρ), b = e^((−(σ/κ + α)·Δt)/ε₀), and c =
# σ·(b − 1)/(κ·(σ + κα)) where σ and that denominator are positive, else 0. Mirrors fdtd.rs's `cpml_coefficients`.
#must_use
fn _bj_cpml_coefficients(rho: f64, params: *BjCpmlParams, sigma_max: f64, dt: f64): (f64, f64, f64) {
    var grade: f64 = _bj_powf(rho, params.grading_order);
    var sigma: f64 = sigma_max * grade;
    var km: f64 = params.kappa_max;
    var kd: f64 = km - 1.0;
    var kg: f64 = kd * grade;
    var kappa: f64 = 1.0 + kg;
    var omr: f64 = 1.0 - rho;
    var alpha: f64 = params.alpha_max * omr;
    var sk: f64 = sigma / kappa;
    var ska: f64 = sk + alpha;
    var nsk: f64 = -ska;
    var arg: f64 = nsk * dt;
    var x: f64 = arg / BJ_EPSILON_0;
    var b: f64 = _bj_exp(x);
    var ka: f64 = kappa * alpha;
    var sa: f64 = sigma + ka;
    var denom: f64 = kappa * sa;
    var c: f64 = 0.0;
    if (sigma > 0.0 && denom > 0.0) {
        var bm1: f64 = b - 1.0;
        var num: f64 = sigma * bm1;
        c = num / denom;
    }
    var ik: f64 = 1.0 / kappa;
    var km1: f64 = ik - 1.0;
    return (b, c, km1);
}

# The profiles of layers l = 0..t, located l + offset cells from the outer wall (depth ρ = (t − l − offset)/t), into
# the three rows of t f64 at b, c and km1. Mirrors `Profile::sample`'s loop.
fn _bj_cpml_sample(b: *f64, c: *f64, km1: *f64, t, offset: f64, params: *BjCpmlParams, sigma_max: f64, dt: f64) {
    var tf: f64 = f64_from(t);
    for (var l = 0; l < t; l = l + 1) {
        var lf: f64 = f64_from(l);
        var d: f64 = tf - lf;
        var e: f64 = d - offset;
        var rho: f64 = e / tf;
        var bv, cv, kv = _bj_cpml_coefficients(rho, params, sigma_max, dt);
        b[l] = bv;
        c[l] = cv;
        km1[l] = kv;
    }
    return 0;
}

# A layer with params' grading for a grid of spacing dx and step dt into *out (unattached): Ok(0), or with out
# untouched Err(InvalidParameter) — a parameter out of range (Rust's texts and order, `CpmlParams`), dx or dt not
# finite and positive, "cannot allocate {t} grid values" where the profiles can't be had, or a coefficient not
# finite. σ_max = sigma_ratio·0.8·(m + 1)/(η₀·dx), η₀ = μ₀·c. Give it back with BjCpml_free. Mirrors
# `Cpml::with_params`.
#must_use
public fn BjCpml_with_params(params: *BjCpmlParams, dx: f64, dt: f64, out: *BjCpml): Result {
    var e = _bj_cpml_params_validate(params);
    if (e != 0) { return Err(e); }
    if (!(dx > 0.0 && dx < _BJ_CPML_INF)) {
        var t1 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t1, "CPML dx must be finite and positive, got ");
        _bj_fmt_f64_display(t1, dx);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (!(dt > 0.0 && dt < _BJ_CPML_INF)) {
        var t2 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t2, "CPML dt must be finite and positive, got ");
        _bj_fmt_f64_display(t2, dt);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var t = params.thickness;
    var m: f64 = params.grading_order;
    var mu0: f64 = BJ_MU_0;
    var eta0: f64 = mu0 * BJ_SPEED_OF_LIGHT;
    var s8: f64 = params.sigma_ratio * 0.8;
    var m1: f64 = m + 1.0;
    var sn: f64 = s8 * m1;
    var sd: f64 = eta0 * dx;
    var sigma_max: f64 = sn / sd;
    var prof = 0;
    if (t > 0 && t <= _BJ_CPML_FL_MAX / 48) { prof = fl_alloc(t * 48); }
    if (prof == 0) {
        var t3 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t3, "cannot allocate ");
        _bj_tx_u64(t3, t);
        _bj_tx_cstr(t3, " grid values");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var pb: *f64 = _bj_cpml_f64p(prof);
    _bj_cpml_sample(_bj_cpml_f64p(prof), _bj_cpml_f64p(prof + t * 8), _bj_cpml_f64p(prof + 2 * t * 8), t, 0.0,
      params, sigma_max, dt);
    _bj_cpml_sample(_bj_cpml_f64p(prof + 3 * t * 8), _bj_cpml_f64p(prof + 4 * t * 8), _bj_cpml_f64p(prof + 5 * t * 8),
      t, 0.5, params, sigma_max, dt);
    var fin = 1;
    var zs: f64 = sigma_max * 0.0;
    if (zs != 0.0) { fin = 0; }
    for (var i = 0; i < 6 * t; i = i + 1) {
        var v: f64 = pb[i];
        var z: f64 = v * 0.0;
        if (z != 0.0) { fin = 0; }
    }
    if (fin == 0) {
        fl_free(prof);
        var t4 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t4, "CPML coefficients are not finite for dx = ");
        _bj_fmt_f64_display(t4, dx);
        _bj_tx_cstr(t4, ", dt = ");
        _bj_fmt_f64_display(t4, dt);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (_bj_log_on(4) == 1) {
        var lb[256];
        var lt[24];
        _bj_tx_init(&lt, &lb, 256);
        _bj_tx_cstr(&lt, "CPML profile computed thickness=");
        _bj_tx_u64(&lt, t);
        _bj_tx_cstr(&lt, " grading_order=");
        _bj_fmt_f64_debug(&lt, m);
        _bj_tx_cstr(&lt, " sigma_max=");
        _bj_fmt_f64_debug(&lt, sigma_max);
        _bj_tx_cstr(&lt, " kappa_max=");
        _bj_fmt_f64_debug(&lt, params.kappa_max);
        _bj_tx_cstr(&lt, " alpha_max=");
        _bj_fmt_f64_debug(&lt, params.alpha_max);
        _bj_log_text(4, &lt);
    }
    _bj_cpml_from(params, sigma_max, prof, t, out);
    return Ok(0);
}

# A layer with the classic grading (BjCpmlParams_new) into *out. Invalid input (zero thickness, dx or dt not finite
# and positive) logs a warning and gives an inert layer that can never be attached; BjCpml_with_params returns the
# error instead. Give it back with BjCpml_free. Mirrors `Cpml::new`.
public fn BjCpml_new(thickness, dx: f64, dt: f64, out: *BjCpml): i64 {
    var p: BjCpmlParams = BjCpmlParams_new(thickness);
    var t, v = BjCpml_with_params(&p, dx, dt, out);
    if (is_err_result(t) == 1) {
        if (_bj_log_on(2) == 1) {
            var lb[512];
            var lt[24];
            _bj_tx_init(&lt, &lb, 512);
            _bj_tx_cstr(&lt, "invalid CPML parameters; layer is inert thickness=");
            _bj_tx_u64(&lt, thickness);
            _bj_tx_cstr(&lt, " dx=");
            _bj_fmt_f64_debug(&lt, dx);
            _bj_tx_cstr(&lt, " dt=");
            _bj_fmt_f64_debug(&lt, dt);
            _bj_tx_cstr(&lt, " error=");
            _bj_tx_cstr(&lt, bj_last_error_display());
            _bj_log_text(2, &lt);
        }
        _bj_cpml_from(&p, 0.0, 0, 0, out);
    }
    return 0;
}

# Gives the Ψ mapping back, unattached (0 × 0, every Ψ empty).
fn _bj_cpml_detach(c: *BjCpml) {
    if (c.psi_bytes > 0) { cyr_munmap(c.psi_fx_y, c.psi_bytes); }
    c.psi_fx_y = 0;
    c.psi_fz_y = 0;
    c.psi_fy_x = 0;
    c.psi_fz_x = 0;
    c.psi_x_len = 0;
    c.psi_y_len = 0;
    c.psi_bytes = 0;
    c.nx = 0;
    c.ny = 0;
    return 0;
}

# 1 when the profiles and Ψ storage are consistent with an nx × ny grid: the layer fits it, is attached to it, has its
# profiles (not the inert layer), and its Ψ fields have 2·thickness·nx and 2·thickness·ny cells. The strip updates
# rely on it (it bounds every index they use). Public for src/fdtd2d.cyr and tests/cpml.tcyr. Mirrors
# `Cpml::is_attached_to`.
#must_use
public fn _bj_cpml_is_attached_to(c: *BjCpml, nx, ny): i64 {
    var t = c.thickness;
    var md = nx;
    if (_bj_cpml_uge(nx, ny) == 1) { md = ny; }
    if (_bj_cpml_fits(t, md) == 0 || c.nx != nx || c.ny != ny || c.prof_n != t || c.prof_block == 0) { return 0; }
    var t2: i64[1];
    var sx: i64[1];
    var sy: i64[1];
    if (_bj_cpml_umul(t, 2, &t2) == 0) { return 0; }
    if (_bj_cpml_umul(t2[0], nx, &sx) == 0 || _bj_cpml_umul(t2[0], ny, &sy) == 0) { return 0; }
    if (c.psi_x_len == sx[0] && c.psi_y_len == sy[0]) { return 1; }
    return 0;
}

impl BjCpml {
    # Allocates (and zeroes) the Ψ fields for an nx × ny 2D grid, in place of any before: 2·thickness rows of nx cells
    # and 2·thickness columns of ny cells a field. Where the sizes overflow or can't be had, logs a warning and leaves
    # the layer unattached. (A 3D grid keeps its own face-slab storage.) Mirrors `Cpml::attach`.
    public fn attach(self, nx, ny): i64 {
        _bj_cpml_detach(self);
        var t2: i64[1];
        var sx: i64[1];
        var sy: i64[1];
        var ok = _bj_cpml_umul(self.thickness, 2, &t2);
        if (ok == 1) { ok = _bj_cpml_umul(t2[0], nx, &sx); }
        if (ok == 1) { ok = _bj_cpml_umul(t2[0], ny, &sy); }
        var tot: i64[1];
        if (ok == 1) { ok = _bj_cpml_umul(sx[0] + sy[0], 16, &tot); }
        if (ok == 1 && (sx[0] < 0 || sy[0] < 0 || _bj_cpml_uge(sx[0] + sy[0], sx[0]) == 0)) { ok = 0; }
        var map = 0;
        if (ok == 1 && tot[0] > 0) { map = mmap_anon(tot[0]); }
        if (ok == 1 && tot[0] == 0) { ok = 2; }
        if (ok == 0 || (ok == 1 && map == 0)) {
            if (_bj_log_on(2) == 1) {
                var lb[256];
                var lt[24];
                _bj_tx_init(&lt, &lb, 256);
                _bj_tx_cstr(&lt, "CPML auxiliary fields could not be allocated; layer left unattached thickness=");
                _bj_tx_u64(&lt, self.thickness);
                _bj_tx_cstr(&lt, " nx=");
                _bj_tx_u64(&lt, nx);
                _bj_tx_cstr(&lt, " ny=");
                _bj_tx_u64(&lt, ny);
                _bj_log_text(2, &lt);
            }
            return 0;
        }
        var x = sx[0];
        var y = sy[0];
        if (map != 0) {
            self.psi_fx_y = map;
            self.psi_fz_y = map + x * 8;
            self.psi_fy_x = map + 2 * x * 8;
            self.psi_fz_x = map + 2 * x * 8 + y * 8;
            self.psi_bytes = tot[0];
        }
        self.psi_x_len = x;
        self.psi_y_len = y;
        self.nx = nx;
        self.ny = ny;
        return 0;
    }

    # The maximum PML conductivity σ_max (S/m). Mirrors `Cpml::sigma_max`.
    #must_use
    public fn sigma_max(self): f64 {
        var x: f64 = self.sigma_max;
        return x;
    }

    # The maximum coordinate stretching κ_max. Mirrors `Cpml::kappa_max`.
    #must_use
    public fn kappa_max(self): f64 {
        var x: f64 = self.kappa_max;
        return x;
    }

    # The maximum CFS shift α_max (S/m). Mirrors `Cpml::alpha_max`.
    #must_use
    public fn alpha_max(self): f64 {
        var x: f64 = self.alpha_max;
        return x;
    }

    # The polynomial grading order m. Mirrors `Cpml::grading_order`.
    #must_use
    public fn grading_order(self): f64 {
        var x: f64 = self.grading_order;
        return x;
    }
}

# Gives a layer's profiles and Ψ back and empties it (no profiles, unattached); a second call does nothing.
public fn BjCpml_free(c: *BjCpml): i64 {
    _bj_cpml_detach(c);
    if (c.prof_block != 0) { fl_free(c.prof_block); }
    c.prof_block = 0;
    c.prof_n = 0;
    c.b_node = 0;
    c.c_node = 0;
    c.km1_node = 0;
    c.b_half = 0;
    c.c_half = 0;
    c.km1_half = 0;
    return 0;
}

# --- fdtd2d.cyr ---

# fdtd2d.cyr — fdtd.rs's 2D solver (M6 part 1b-1): `Fdtd2d`, the Yee algorithm on an nx × ny grid in TM mode (E_z at
# the integer nodes (x, y), H_x at (x, y + ½), H_y at (x + ½, y)) or TE mode (H_z, E_x, E_y at the same places), SI
# units. Fields are row-major, index y·nx + x. The time step is half the 2D Courant limit, dt = dx/(2√2·c), a Courant
# number of 1/(2√2).
#
# The outer walls reflect: the out-of-plane field is held at zero on the outermost ring of nodes, a perfect electric
# conductor in TM (E_z = 0) and a perfect magnetic conductor in TE (H_z = 0). Per-cell ε_r, μ_r and conductivity σ
# (the lossy E update E ← C_a·E + C_b·∇×H, C_a = (1 − σΔt/2ε)/(1 + σΔt/2ε), C_b = (Δt/εΔx)/(1 + σΔt/2ε)) are set by
# region. A CPML absorbing layer (src/cpml.cyr) can replace the walls' reflection: it occupies the outermost `thickness`
# cells, ends on the same wall, and corrects the updates in its strips after each phase (Rust's `correct_fx`,
# `correct_fy`, `correct_fz`, in Rust's order).
#
# A grid's seven arrays (f_z, f_x, f_y, the C_b and H coefficients, ε_r and μ_r) and three scratch rows are one
# anonymous mmap, fixed at construction; the first lossy region maps C_a and σ beside them. BjFdtd2d_free gives both
# back. Rust's public, resizable `Vec` fields and the per-step layout check that guarded them are gone (ADR 0002 row 2):
# the fields are the arrays' addresses and nx·ny their length. No step allocates. The updates run on the packed f64v_*
# verbs, each lane rounding Rust's operations in Rust's order, so the bits are Rust's (port plan §9.3, probe p10), on
# lane multiples with a scalar tail (probe p19). The file is time-domain only; bijli's one harmonic convention,
# e^{+jωt}, is stated in src/complex.cyr's header.

private

var _BJ_FD2_INF: f64 = 0x7FF0000000000000;
# std::f64::consts::PI and SQRT_2.
var _BJ_FD2_PI: f64 = 3.141592653589793;
var _BJ_FD2_SQRT_2: f64 = 1.4142135623730951;
# The grid's arrays, each nx·ny f64, in one mapping: f_z, f_x, f_y, C_b, the H coefficients, ε_r and μ_r (then three
# scratch rows of nx).
var _BJ_FD2_ARRAYS = 7;
# The largest nx·ny whose mapping (under 64 bytes a cell with the scratch rows) a 64-bit length holds.
var _BJ_FD2_MAX_CELLS = 144115188075855871;

# The polarization of a 2D grid. TM: E_z, H_x, H_y (E perpendicular to the plane; the walls PEC, E_z = 0). TE: H_z,
# E_x, E_y (H perpendicular; the walls PMC, H_z = 0). Mirrors `Mode2d`.
public enum BjMode2d {
    BJ_MODE2D_TM = 0;
    BJ_MODE2D_TE = 1;
}

# Rust's `run(steps, None, ..)`: no source. Rust's Some((x, y)) outside the grid injects nothing either, so usize::MAX
# (−1) for x is None exactly.
public var BJ_FDTD2D_NO_SOURCE = 0 - 1;

# A 2D FDTD simulation. `mode` is BJ_MODE2D_TM or BJ_MODE2D_TE; nx × ny the nodes; `dx` (m) the uniform spacing in x
# and y, `dt` (s) the step, `step` the time-step index. `fz` (E_z in TM, H_z in TE), `fx` (H_x, E_x) and `fy` (H_y,
# E_y) are the addresses of nx·ny f64 each (read and write the values, as Rust's public vectors). `ce` holds C_b per
# cell (Δt/(ε₀ε_r·Δx), divided by 1 + σΔt/2ε where lossy), `ch` Δt/(μ₀μ_r·Δx), `ca` C_a and `conductivity` σ (S/m),
# both 0 while every cell is lossless (Rust's empty vectors), `permittivity` ε_r and `permeability` μ_r. `cpml` is the
# attached layer's address (a freelist block holding a BjCpml, attached to this grid), 0 for none; read it through
# `cpml()`. `work` holds the update's three scratch rows, `map_bytes` and `lossy_bytes` the mappings' lengths (0 once
# freed). Mirrors `Fdtd2d`.
public struct BjFdtd2d {
    mode;
    nx;
    ny;
    dx: f64;
    dt: f64;
    step;
    fz;
    fx;
    fy;
    ce;
    ch;
    ca;
    permittivity;
    permeability;
    conductivity;
    cpml;
    work;
    map_bytes;
    lossy_bytes;
}

# The helpers below marked public are shared with src/fdtd3d.cyr (`_bj_` names stay out of the API).

# A word as a *f64 (the typed return keeps the binding typed).
#must_use
public fn _bj_fd2_f64p(a): *f64 {
    return a;
}

# A word as a *BjCpml.
#must_use
fn _bj_fd2_cpmlp(a): *BjCpml {
    return a;
}

# 1 when a ≥ b as usize words (a negative word is past 2^63).
#must_use
public fn _bj_fd2_uge(a, b): i64 {
    if ((a < 0) == (b < 0)) {
        if (a >= b) { return 1; }
        return 0;
    }
    if (a < 0) { return 1; }
    return 0;
}

# The usize product a·b into *out: 1, or 0 when it overflows 64 bits (Rust's `checked_mul` None).
public fn _bj_fd2_umul(a, b, out: *i64): i64 {
    var ah = a >> 32;
    var al = a & 0xFFFFFFFF;
    var bh = b >> 32;
    var bl = b & 0xFFFFFFFF;
    if (ah != 0 && bh != 0) { return 0; }
    var cross = ah * bl + al * bh;
    if ((cross >> 32) != 0) { return 0; }
    var lo = al * bl;
    var hi = cross << 32;
    var s = lo + hi;
    if (_bj_fd2_uge(s, lo) == 0) { return 0; }
    out[0] = s;
    return 1;
}

# Rust's `n as f64` for a usize: the word read unsigned, rounded to nearest even.
#must_use
public fn _bj_fd2_u2f(n): f64 {
    if (n >= 0) {
        var r: f64 = f64_from(n);
        return r;
    }
    var h: f64 = f64_from((n >> 1) | (n & 1));
    var r2: f64 = h * 2.0;
    return r2;
}

# 1 when x is finite and strictly positive (NaN-safe). Mirrors fdtd.rs's `is_positive_finite`.
#must_use
public fn _bj_fd2_pos(x: f64): i64 {
    if (x > 0.0 && x < _BJ_FD2_INF) { return 1; }
    return 0;
}

# Records InvalidParameter "cannot allocate {n} grid values" (Rust's `try_filled`); returns its code.
public fn _bj_fd2_alloc_err(n): i64 {
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, "cannot allocate ");
    _bj_tx_u64(t, n);
    _bj_tx_cstr(t, " grid values");
    return BJ_ERR_INVALID_PARAMETER;
}

# The E-update coefficients (C_a, C_b) for ε_r and σ: C_a = (1 − σΔt/2ε)/(1 + σΔt/2ε), C_b = (Δt/(εΔx))/(1 +
# σΔt/2ε), ε = ε_rε₀; the lossless case exactly (1, Δt/(ε₀Δx)/ε_r). Mirrors fdtd.rs's `e_update_coefficients`.
#must_use
public fn _bj_fd2_e_coefficients(dt: f64, dx: f64, eps_r: f64, sigma: f64): (f64, f64) {
    if (sigma > 0.0) {
        var eps: f64 = eps_r * BJ_EPSILON_0;
        var sdt: f64 = sigma * dt;
        var e2: f64 = 2.0 * eps;
        var hl: f64 = sdt / e2;
        var num: f64 = 1.0 - hl;
        var den: f64 = 1.0 + hl;
        var ca: f64 = num / den;
        var edx: f64 = eps * dx;
        var q: f64 = dt / edx;
        var cb: f64 = q / den;
        return (ca, cb);
    }
    var e0dx: f64 = BJ_EPSILON_0 * dx;
    var q0: f64 = dt / e0dx;
    var cb0: f64 = q0 / eps_r;
    return (1.0, cb0);
}

# d[i] ± k[i]·(a[i] − b[i]) into d for i < n (add 1: `+=`, 0: `-=`), Rust's `row_diff`: the packed f64v_sub, f64v_mul
# and f64v_add or f64v_sub through the scratch row w on the largest multiple of 4, then a scalar tail (probe p19).
public fn _bj_fd2_diff(d: *f64, k: *f64, a: *f64, b: *f64, w: *f64, n, add) {
    var m = n & (0 - 4);
    if (m > 0) {
        f64v_sub(w, a, b, m);
        f64v_mul(w, k, w, m);
        if (add == 1) { f64v_add(d, d, w, m); }
        else { f64v_sub(d, d, w, m); }
    }
    for (var i = m; i < n; i = i + 1) {
        var ab: f64 = a[i] - b[i];
        var v: f64 = k[i] * ab;
        if (add == 1) { d[i] = d[i] + v; }
        else { d[i] = d[i] - v; }
    }
    return 0;
}

# One row's interior curl update, x ∈ 1..n − 1: d[x] ± k[x]·((a[x] − a[x − 1]) − (b[x] − bp[x])) (add 1: `+=`, 0:
# `-=`), Rust's `row_curl`, on the packed verbs through the scratch rows w and w2 (lane multiples, a scalar tail).
public fn _bj_fd2_curl(d: *f64, k: *f64, a: *f64, b: *f64, bp: *f64, w: *f64, w2: *f64, n, add) {
    if (n < 3) { return 0; }
    var c = n - 2;
    var m = c & (0 - 4);
    if (m > 0) {
        f64v_sub(w, a + 1, a, m);
        f64v_sub(w2, b + 1, bp + 1, m);
        f64v_sub(w, w, w2, m);
        f64v_mul(w, k + 1, w, m);
        if (add == 1) { f64v_add(d + 1, d + 1, w, m); }
        else { f64v_sub(d + 1, d + 1, w, m); }
    }
    for (var x = m + 1; x < n - 1; x = x + 1) {
        var da: f64 = a[x] - a[x - 1];
        var db: f64 = b[x] - bp[x];
        var dd: f64 = da - db;
        var v: f64 = k[x] * dd;
        if (add == 1) { d[x] = d[x] + v; }
        else { d[x] = d[x] - v; }
    }
    return 0;
}

# f[i] ·= factor[i] for i < n (lossy cells' C_a; the packed f64v_mul on lane multiples, a scalar tail). Mirrors
# fdtd.rs's `scale_by`.
public fn _bj_fd2_scale(f: *f64, factor: *f64, n) {
    var m = n & (0 - 4);
    if (m > 0) { f64v_mul(f, f, factor, m); }
    for (var i = m; i < n; i = i + 1) { f[i] = f[i] * factor[i]; }
    return 0;
}

# Zeroes the outermost ring of a row-major nx-wide field of nx·ny cells (the PEC or PMC wall). Mirrors fdtd.rs's
# `zero_walls`.
public fn _bj_fd2_walls(f: *f64, nx, ny) {
    var n = nx * ny;
    for (var x = 0; x < nx; x = x + 1) {
        f[x] = 0.0;
        f[n - nx + x] = 0.0;
    }
    for (var y = 0; y < ny; y = y + 1) {
        f[y * nx] = 0.0;
        f[y * nx + nx - 1] = 0.0;
    }
    return 0;
}

# Records InvalidParameter "region {axis} range {lo}..{hi} is invalid for a grid of {n} cells" when lo ≥ n or hi < lo
# (usize compares) and returns its code; else 0 with the range clamped to n in r[0..2]. Mirrors fdtd.rs's
# `region_range`.
public fn _bj_fd2_range(axis, lo, hi, n, r: *i64): i64 {
    if (_bj_fd2_uge(lo, n) == 1 || _bj_fd2_uge(hi, lo) == 0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "region ");
        _bj_tx_cstr(t, axis);
        _bj_tx_cstr(t, " range ");
        _bj_tx_u64(t, lo);
        _bj_tx_cstr(t, "..");
        _bj_tx_u64(t, hi);
        _bj_tx_cstr(t, " is invalid for a grid of ");
        _bj_tx_u64(t, n);
        _bj_tx_cstr(t, " cells");
        return BJ_ERR_INVALID_PARAMETER;
    }
    r[0] = lo;
    r[1] = hi;
    if (_bj_fd2_uge(hi, n) == 1) { r[1] = n; }
    return 0;
}

# 0 for a finite and strictly positive ε_r, else InvalidPermittivity { value } recorded and its code. Mirrors
# fdtd.rs's `validate_eps_r`.
public fn _bj_fd2_check_eps(eps_r: f64): i64 {
    if (_bj_fd2_pos(eps_r) == 1) { return 0; }
    return _bj_err_invalid_permittivity(eps_r);
}

# 0 for a finite and strictly positive μ_r, else InvalidPermeability { value } recorded and its code. Mirrors
# fdtd.rs's `validate_mu_r`.
public fn _bj_fd2_check_mu(mu_r: f64): i64 {
    if (_bj_fd2_pos(mu_r) == 1) { return 0; }
    return _bj_err_invalid_permeability(mu_r);
}

# 0 for a finite σ ≥ 0, else InvalidParameter "conductivity must be finite and ≥ 0 S/m, got {σ}" recorded and its
# code. Mirrors fdtd.rs's `validate_conductivity`.
public fn _bj_fd2_check_sigma(sigma: f64): i64 {
    if (sigma >= 0.0 && sigma < _BJ_FD2_INF) { return 0; }
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, "conductivity must be finite and ≥ 0 S/m, got ");
    _bj_fmt_f64_display(t, sigma);
    return BJ_ERR_INVALID_PARAMETER;
}

# One CPML strip row on the packed verbs: for i < n, d = hi[i] − lo[i], Ψ ← b·Ψ + c·d, and f ± (sign·k)·((1/κ − 1)·d +
# Ψ) (sub 0: `+=`, 1: `-=`), Rust's `*psi = b * *psi + c * d; *f += sign * kk * (km1 * d + *psi)` lane by lane (IEEE's
# products and sums are commutative, so each lane's operands may swap), through the scratch rows w1, w2, w3 on lane
# multiples, then a scalar tail.
public fn _bj_fd2_strip(f: *f64, hi: *f64, lo: *f64, k: *f64, psi: *f64, n, pr: *f64, w: *f64, sub) {
    var b: f64 = pr[0];
    var c: f64 = pr[1];
    var km1: f64 = pr[2];
    var sign: f64 = pr[3];
    var w1: *f64 = w;
    var w2: *f64 = w + n;
    var w3: *f64 = w + 2 * n;
    var m = n & (0 - 4);
    if (m > 0) {
        f64v_sub(w1, hi, lo, m);
        f64v_scale(w2, psi, b, m);
        f64v_scale(w3, w1, c, m);
        f64v_add(psi, w2, w3, m);
        f64v_scale(w2, w1, km1, m);
        f64v_add(w2, w2, psi, m);
        f64v_scale(w3, k, sign, m);
        f64v_mul(w2, w3, w2, m);
        if (sub == 0) { f64v_add(f, f, w2, m); }
        else { f64v_sub(f, f, w2, m); }
    }
    for (var i = m; i < n; i = i + 1) {
        var d: f64 = hi[i] - lo[i];
        var pv: f64 = b * psi[i] + c * d;
        psi[i] = pv;
        var v: f64 = sign * k[i] * (km1 * d + pv);
        if (sub == 0) { f[i] = f[i] + v; }
        else { f[i] = f[i] - v; }
    }
    return 0;
}

# The CPML term for f_x at (x, y + ½) in the y-strips (rows y = l and ny − 2 − l, the half-node profiles):
# Ψ ← b·Ψ + c·Δ_y f_z, f_x += sign·k·((1/κ − 1)·Δ + Ψ). The layer is attached to this grid. Mirrors `Cpml::correct_fx`.
fn _bj_fd2_cpml_fx(c: *BjCpml, fx: *f64, fz: *f64, k: *f64, nx, ny, sign: f64, w: *f64) {
    var t = c.thickness;
    var bh: *f64 = _bj_fd2_f64p(c.b_half);
    var chf: *f64 = _bj_fd2_f64p(c.c_half);
    var kh: *f64 = _bj_fd2_f64p(c.km1_half);
    var psi: *f64 = _bj_fd2_f64p(c.psi_fx_y);
    var pr: f64[4];
    pr[3] = sign;
    for (var side = 0; side < 2; side = side + 1) {
        for (var l = 0; l < t; l = l + 1) {
            var y = l;
            if (side == 1) { y = ny - 2 - l; }
            pr[0] = bh[l];
            pr[1] = chf[l];
            pr[2] = kh[l];
            var r0 = y * nx;
            _bj_fd2_strip(fx + r0, fz + r0 + nx, fz + r0, k + r0, psi + (side * t + l) * nx, nx, &pr, w, 0);
        }
    }
    return 0;
}

# The CPML term for f_y at (x + ½, y) in the x-strips (columns x = l and nx − 2 − l on every row, the half-node
# profiles): Ψ ← b·Ψ + c·Δ_x f_z, f_y += sign·k·((1/κ − 1)·Δ + Ψ). Mirrors `Cpml::correct_fy`.
fn _bj_fd2_cpml_fy(c: *BjCpml, fy: *f64, fz: *f64, k: *f64, nx, ny, sign: f64) {
    var t = c.thickness;
    var bh: *f64 = _bj_fd2_f64p(c.b_half);
    var chf: *f64 = _bj_fd2_f64p(c.c_half);
    var kh: *f64 = _bj_fd2_f64p(c.km1_half);
    for (var y = 0; y < ny; y = y + 1) {
        var r = y * nx;
        var fr: *f64 = fy + r;
        var zr: *f64 = fz + r;
        var kr: *f64 = k + r;
        var pp: *f64 = _bj_fd2_f64p(c.psi_fy_x + y * 2 * t * 8);
        for (var l = 0; l < t; l = l + 1) {
            var d: f64 = zr[l + 1] - zr[l];
            var pv: f64 = bh[l] * pp[l] + chf[l] * d;
            pp[l] = pv;
            fr[l] = fr[l] + sign * kr[l] * (kh[l] * d + pv);
            var x = nx - 2 - l;
            var d2: f64 = zr[x + 1] - zr[x];
            var pv2: f64 = bh[l] * pp[t + l] + chf[l] * d2;
            pp[t + l] = pv2;
            fr[x] = fr[x] + sign * kr[x] * (kh[l] * d2 + pv2);
        }
    }
    return 0;
}

# The CPML terms for f_z at the integer nodes, the node profiles, layers l = 1..t (the wall node l = 0 is reset by the
# boundary): first the x-strips on the interior rows (columns l and nx − 1 − l: Ψ ← b·Ψ + c·Δ_x f_y, f_z +=
# sign·k·((1/κ − 1)·Δ + Ψ)), then the y-strips on the interior columns (rows l and ny − 1 − l: Ψ ← b·Ψ + c·Δ_y f_x,
# f_z −= sign·k·((1/κ − 1)·Δ + Ψ)); a corner cell takes both, in that order. Mirrors `Cpml::correct_fz`.
fn _bj_fd2_cpml_fz(c: *BjCpml, fz: *f64, fx: *f64, fy: *f64, k: *f64, nx, ny, sign: f64, w: *f64) {
    var t = c.thickness;
    var bn: *f64 = _bj_fd2_f64p(c.b_node);
    var cn: *f64 = _bj_fd2_f64p(c.c_node);
    var kn: *f64 = _bj_fd2_f64p(c.km1_node);
    for (var y = 1; y < ny - 1; y = y + 1) {
        var r = y * nx;
        var fr: *f64 = fz + r;
        var yr: *f64 = fy + r;
        var kr: *f64 = k + r;
        var pp: *f64 = _bj_fd2_f64p(c.psi_fz_x + y * 2 * t * 8);
        for (var l = 1; l < t; l = l + 1) {
            var d: f64 = yr[l] - yr[l - 1];
            var pv: f64 = bn[l] * pp[l] + cn[l] * d;
            pp[l] = pv;
            fr[l] = fr[l] + sign * kr[l] * (kn[l] * d + pv);
            var x = nx - 1 - l;
            var d2: f64 = yr[x] - yr[x - 1];
            var pv2: f64 = bn[l] * pp[t + l] + cn[l] * d2;
            pp[t + l] = pv2;
            fr[x] = fr[x] + sign * kr[x] * (kn[l] * d2 + pv2);
        }
    }
    var psi: *f64 = _bj_fd2_f64p(c.psi_fz_y);
    var pr: f64[4];
    pr[3] = sign;
    for (var side = 0; side < 2; side = side + 1) {
        for (var l2 = 1; l2 < t; l2 = l2 + 1) {
            var y2 = l2;
            if (side == 1) { y2 = ny - 1 - l2; }
            pr[0] = bn[l2];
            pr[1] = cn[l2];
            pr[2] = kn[l2];
            var r0 = y2 * nx + 1;
            _bj_fd2_strip(fz + r0, fx + r0, fx + r0 - nx, k + r0, psi + (side * t + l2) * nx + 1, nx - 2, &pr, w, 1);
        }
    }
    return 0;
}

# A vacuum grid of nx × ny nodes at spacing dx in `mode` into *out, the walls reflecting: Ok(0), or with out untouched
# Err(InsufficientResolution) when nx < 3 or ny < 3 (cells min(nx, ny), domain min(nx, ny)·dx), Err(InvalidParameter)
# "dx must be finite and positive, got {dx}", "grid [{nx}, {ny}] is too large" (nx·ny past 2^64) or "cannot allocate
# {n} grid values", in Rust's order. A mode word that is no BjMode2d (Rust's enum has no other) is refused first,
# InvalidParameter "unknown 2D mode {mode}", as bj_try_write_touchstone's format. dt = dx/(2√2·c). Give it back with
# BjFdtd2d_free. Mirrors `Fdtd2d::new`.
#must_use
public fn BjFdtd2d_new(nx, ny, dx: f64, mode, out: *BjFdtd2d): Result {
    if (mode != BJ_MODE2D_TM && mode != BJ_MODE2D_TE) {
        var tm = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(tm, "unknown 2D mode ");
        _bj_tx_i64(tm, mode);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if ((nx >= 0 && nx < 3) || (ny >= 0 && ny < 3)) {
        var mn = nx;
        if (_bj_fd2_uge(nx, ny) == 1) { mn = ny; }
        var mf: f64 = _bj_fd2_u2f(mn);
        var size: f64 = mf * dx;
        return Err(_bj_err_insufficient_resolution(mn, size));
    }
    if (_bj_fd2_pos(dx) == 0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "dx must be finite and positive, got ");
        _bj_fmt_f64_display(t, dx);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var cells: i64[1];
    if (_bj_fd2_umul(nx, ny, &cells) == 0) {
        var tg = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(tg, "grid [");
        _bj_tx_u64(tg, nx);
        _bj_tx_cstr(tg, ", ");
        _bj_tx_u64(tg, ny);
        _bj_tx_cstr(tg, "] is too large");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var n = cells[0];
    var c: f64 = BJ_SPEED_OF_LIGHT;
    var r2: f64 = 2.0 * _BJ_FD2_SQRT_2;
    var r2c: f64 = r2 * c;
    var dt: f64 = dx / r2c;
    var map = 0;
    var bytes = 0;
    if (n >= 0 && n <= _BJ_FD2_MAX_CELLS) {
        bytes = (n * _BJ_FD2_ARRAYS + 3 * nx) * 8;
        map = mmap_anon(bytes);
    }
    if (map == 0) { return Err(_bj_fd2_alloc_err(n)); }
    var e0dx: f64 = BJ_EPSILON_0 * dx;
    var ce: f64 = dt / e0dx;
    var m0dx: f64 = BJ_MU_0 * dx;
    var ch: f64 = dt / m0dx;
    var cep: *f64 = _bj_fd2_f64p(map + 3 * n * 8);
    var chp: *f64 = _bj_fd2_f64p(map + 4 * n * 8);
    var eps: *f64 = _bj_fd2_f64p(map + 5 * n * 8);
    var mu: *f64 = _bj_fd2_f64p(map + 6 * n * 8);
    for (var i = 0; i < n; i = i + 1) {
        cep[i] = ce;
        chp[i] = ch;
        eps[i] = 1.0;
        mu[i] = 1.0;
    }
    out.mode = mode;
    out.nx = nx;
    out.ny = ny;
    out.dx = dx;
    out.dt = dt;
    out.step = 0;
    out.fz = map;
    out.fx = map + n * 8;
    out.fy = map + 2 * n * 8;
    out.ce = map + 3 * n * 8;
    out.ch = map + 4 * n * 8;
    out.permittivity = map + 5 * n * 8;
    out.permeability = map + 6 * n * 8;
    out.work = map + 7 * n * 8;
    out.ca = 0;
    out.conductivity = 0;
    out.cpml = 0;
    out.map_bytes = bytes;
    out.lossy_bytes = 0;
    if (_bj_log_on(4) == 1) {
        var lb[256];
        var lt[24];
        _bj_tx_init(&lt, &lb, 256);
        _bj_tx_cstr(&lt, "2D FDTD simulation created nx=");
        _bj_tx_u64(&lt, nx);
        _bj_tx_cstr(&lt, " ny=");
        _bj_tx_u64(&lt, ny);
        _bj_tx_cstr(&lt, " dx=");
        _bj_fmt_f64_debug(&lt, dx);
        _bj_tx_cstr(&lt, " dt=");
        _bj_fmt_f64_debug(&lt, dt);
        _bj_tx_cstr(&lt, " mode=");
        if (mode == BJ_MODE2D_TE) { _bj_tx_cstr(&lt, "Te"); }
        else { _bj_tx_cstr(&lt, "Tm"); }
        _bj_log_text(4, &lt);
    }
    return Ok(0);
}

# Gives a grid's mappings and its CPML back and empties it (nx = ny = 0, every address 0); a second call does nothing.
public fn BjFdtd2d_free(sim: *BjFdtd2d): i64 {
    if (sim.cpml != 0) {
        BjCpml_free(sim.cpml);
        fl_free(sim.cpml);
    }
    sim.cpml = 0;
    if (sim.map_bytes > 0) { cyr_munmap(sim.fz, sim.map_bytes); }
    if (sim.lossy_bytes > 0) { cyr_munmap(sim.ca, sim.lossy_bytes); }
    sim.fz = 0;
    sim.fx = 0;
    sim.fy = 0;
    sim.ce = 0;
    sim.ch = 0;
    sim.ca = 0;
    sim.permittivity = 0;
    sim.permeability = 0;
    sim.conductivity = 0;
    sim.work = 0;
    sim.nx = 0;
    sim.ny = 0;
    sim.map_bytes = 0;
    sim.lossy_bytes = 0;
    return 0;
}

impl BjFdtd2d {
    # The linear index of node (x, y): y·nx + x. Mirrors `Fdtd2d::idx`.
    #must_use
    public fn idx(self, x, y): i64 {
        return y * self.nx + x;
    }

    # Writes material values to an already validated region [x0, x1) × [y0, y1) and refreshes the update coefficients;
    # a flag of 0 leaves that property as it is (Rust's None). The first region with σ > 0 maps C_a (1) and σ (0) for
    # every cell: Ok(0), or Err(InvalidParameter) "cannot allocate {n} grid values" with nothing written. Mirrors
    # `Fdtd2d::apply_region`.
    fn apply_region(self, r: *i64, has_eps, eps_r: f64, has_mu, mu_r: f64, has_sigma, sigma: f64): Result {
        var nx = self.nx;
        var n = nx * self.ny;
        if (has_sigma == 1 && sigma > 0.0 && self.ca == 0) {
            var map = mmap_anon(2 * n * 8);
            if (map == 0) { return Err(_bj_fd2_alloc_err(n)); }
            var cap: *f64 = _bj_fd2_f64p(map);
            for (var i = 0; i < n; i = i + 1) { cap[i] = 1.0; }
            self.ca = map;
            self.conductivity = map + n * 8;
            self.lossy_bytes = 2 * n * 8;
        }
        if (_bj_log_on(4) == 1) {
            var lb[256];
            var lt[24];
            _bj_tx_init(&lt, &lb, 256);
            _bj_tx_cstr(&lt, "2D FDTD material region set xs=");
            _bj_tx_u64(&lt, r[0]);
            _bj_tx_cstr(&lt, "..");
            _bj_tx_u64(&lt, r[1]);
            _bj_tx_cstr(&lt, " ys=");
            _bj_tx_u64(&lt, r[2]);
            _bj_tx_cstr(&lt, "..");
            _bj_tx_u64(&lt, r[3]);
            _bj_log_text(4, &lt);
        }
        var dt: f64 = self.dt;
        var dx: f64 = self.dx;
        var m0dx: f64 = BJ_MU_0 * dx;
        var base_h: f64 = dt / m0dx;
        var eps: *f64 = _bj_fd2_f64p(self.permittivity);
        var mu: *f64 = _bj_fd2_f64p(self.permeability);
        var ce: *f64 = _bj_fd2_f64p(self.ce);
        var ch: *f64 = _bj_fd2_f64p(self.ch);
        var ca: *f64 = _bj_fd2_f64p(self.ca);
        var cond: *f64 = _bj_fd2_f64p(self.conductivity);
        for (var y = r[2]; y < r[3]; y = y + 1) {
            for (var x = r[0]; x < r[1]; x = x + 1) {
                var i = y * nx + x;
                if (has_mu == 1) {
                    mu[i] = mu_r;
                    var hm: f64 = base_h / mu_r;
                    ch[i] = hm;
                }
                if (has_eps == 1 || has_sigma == 1) {
                    if (has_eps == 1) { eps[i] = eps_r; }
                    if (has_sigma == 1 && self.conductivity != 0) { cond[i] = sigma; }
                    var s: f64 = 0.0;
                    if (self.conductivity != 0) { s = cond[i]; }
                    var cav, cbv = _bj_fd2_e_coefficients(dt, dx, eps[i], s);
                    ce[i] = cbv;
                    if (self.ca != 0) { ca[i] = cav; }
                }
            }
        }
        return Ok(0);
    }

    # The validated region [x0, x1) × [y0, y1) into r[0..4] (x0, x1, y0, y1, each end clamped to the grid): 0, or
    # InvalidParameter (x's first) recorded and its code. Mirrors `Fdtd2d::region`.
    fn region(self, x0, y0, x1, y1, r: *i64): i64 {
        var rx: i64[2];
        var ry: i64[2];
        var e = _bj_fd2_range("x", x0, x1, self.nx, &rx);
        if (e != 0) { return e; }
        e = _bj_fd2_range("y", y0, y1, self.ny, &ry);
        if (e != 0) { return e; }
        r[0] = rx[0];
        r[1] = rx[1];
        r[2] = ry[0];
        r[3] = ry[1];
        return 0;
    }

    # Sets ε_r over [x0, x1) × [y0, y1), the ends clamped to the grid; σ already set there is kept. Ok(0), or with
    # nothing modified Err(InvalidPermittivity) for an ε_r not finite and positive, Err(InvalidParameter) for a region
    # that starts outside the grid or is inverted. Mirrors `Fdtd2d::set_permittivity`.
    public fn set_permittivity(self, x0, y0, x1, y1, eps_r: f64): Result {
        var e = _bj_fd2_check_eps(eps_r);
        if (e != 0) { return Err(e); }
        var r: i64[4];
        e = self.region(x0, y0, x1, y1, &r);
        if (e != 0) { return Err(e); }
        return self.apply_region(&r, 1, eps_r, 0, 1.0, 0, 0.0);
    }

    # Sets μ_r over [x0, x1) × [y0, y1), the ends clamped. Ok(0), or with nothing modified Err(InvalidPermeability) for
    # a μ_r not finite and positive, Err(InvalidParameter) for a bad region. Mirrors `Fdtd2d::set_permeability`.
    public fn set_permeability(self, x0, y0, x1, y1, mu_r: f64): Result {
        var e = _bj_fd2_check_mu(mu_r);
        if (e != 0) { return Err(e); }
        var r: i64[4];
        e = self.region(x0, y0, x1, y1, &r);
        if (e != 0) { return Err(e); }
        return self.apply_region(&r, 0, 1.0, 1, mu_r, 0, 0.0);
    }

    # Sets σ (S/m) over [x0, x1) × [y0, y1), the ends clamped: lossy cells take E ← C_a·E + C_b·∇×H (the file
    # comment); the first lossy region maps C_a and σ, and a lossless grid keeps the cheaper lossless update. Ok(0), or
    # with nothing modified Err(InvalidParameter) for a σ negative or not finite, or a bad region. Mirrors
    # `Fdtd2d::set_conductivity`.
    public fn set_conductivity(self, x0, y0, x1, y1, sigma: f64): Result {
        var e = _bj_fd2_check_sigma(sigma);
        if (e != 0) { return Err(e); }
        var r: i64[4];
        e = self.region(x0, y0, x1, y1, &r);
        if (e != 0) { return Err(e); }
        return self.apply_region(&r, 0, 1.0, 0, 1.0, 1, sigma);
    }

    # Sets ε_r, μ_r and σ over [x0, x1) × [y0, y1) from a material, every input validated (ε_r, μ_r, σ, then the
    # region) before anything is written. Mirrors `Fdtd2d::set_material`.
    public fn set_material(self, x0, y0, x1, y1, mat: *BjMaterial): Result {
        var e = _bj_fd2_check_eps(mat.eps_r);
        if (e == 0) { e = _bj_fd2_check_mu(mat.mu_r); }
        if (e == 0) { e = _bj_fd2_check_sigma(mat.conductivity); }
        if (e != 0) { return Err(e); }
        var r: i64[4];
        e = self.region(x0, y0, x1, y1, &r);
        if (e != 0) { return Err(e); }
        return self.apply_region(&r, 1, mat.eps_r, 1, mat.mu_r, 1, mat.conductivity);
    }

    # Adds `value` to the out-of-plane field (E_z in TM, H_z in TE) at node (x, y), a soft source; a node outside the
    # grid is ignored (usize compares), and one on the outermost ring is cleared by the wall on the next step. Mirrors
    # `Fdtd2d::add_source`.
    public fn add_source(self, x, y, value: f64) {
        if (_bj_fd2_uge(x, self.nx) == 1 || _bj_fd2_uge(y, self.ny) == 1) { return 0; }
        var f: *f64 = _bj_fd2_f64p(self.fz);
        var i = y * self.nx + x;
        f[i] = f[i] + value;
        return 0;
    }

    # Replaces the reflecting walls by a CPML of the classic grading (BjCpmlParams_new) `thickness` cells a side;
    # calling it again replaces the layer (Ψ restarts at zero). Ok(0), or with the boundaries unchanged
    # Err(InvalidParameter) as try_enable_cpml_with. Mirrors `Fdtd2d::try_enable_cpml`.
    public fn try_enable_cpml(self, thickness): Result {
        var p: BjCpmlParams = BjCpmlParams_new(thickness);
        return self.try_enable_cpml_with(&p);
    }

    # Replaces the reflecting walls by a CPML of params' grading (κ and CFS-α profiles, grading order, σ_max's scale),
    # occupying the outermost thickness cells; calling it again replaces the layer. Ok(0), or with the boundaries
    # unchanged Err(InvalidParameter): "CPML thickness {t} is invalid for a {nx}×{ny} grid (need thickness ≥ 1 and
    # 2·thickness + 3 ≤ min(nx, ny))", any refusal of BjCpml_with_params, or "cannot allocate CPML auxiliary fields for
    # a {nx}×{ny} grid". Mirrors `Fdtd2d::try_enable_cpml_with`.
    public fn try_enable_cpml_with(self, params: *BjCpmlParams): Result {
        var nx = self.nx;
        var ny = self.ny;
        var t = params.thickness;
        var md = nx;
        if (_bj_fd2_uge(nx, ny) == 1) { md = ny; }
        if (_bj_cpml_fits(t, md) == 0) {
            var e1 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(e1, "CPML thickness ");
            _bj_tx_u64(e1, t);
            _bj_tx_cstr(e1, " is invalid for a ");
            _bj_tx_u64(e1, nx);
            _bj_tx_cstr(e1, "×");
            _bj_tx_u64(e1, ny);
            _bj_tx_cstr(e1, " grid (need thickness ≥ 1 and 2·thickness + 3 ≤ min(nx, ny))");
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        var blk = fl_alloc(sizeof(BjCpml));
        if (blk != 0) {
            var t2, v2 = BjCpml_with_params(params, self.dx, self.dt, blk);
            if (is_err_result(t2) == 1) {
                fl_free(blk);
                return Err(v2);
            }
            var c: *BjCpml = _bj_fd2_cpmlp(blk);
            c.attach(nx, ny);
            if (_bj_cpml_is_attached_to(blk, nx, ny) == 0) {
                BjCpml_free(blk);
                fl_free(blk);
                blk = 0;
            }
        }
        if (blk == 0) {
            var e3 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(e3, "cannot allocate CPML auxiliary fields for a ");
            _bj_tx_u64(e3, nx);
            _bj_tx_cstr(e3, "×");
            _bj_tx_u64(e3, ny);
            _bj_tx_cstr(e3, " grid");
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        if (_bj_log_on(4) == 1) {
            var cl: *BjCpml = _bj_fd2_cpmlp(blk);
            var lb[256];
            var lt[24];
            _bj_tx_init(&lt, &lb, 256);
            _bj_tx_cstr(&lt, "2D CPML enabled thickness=");
            _bj_tx_u64(&lt, t);
            _bj_tx_cstr(&lt, " sigma_max=");
            _bj_fmt_f64_debug(&lt, cl.sigma_max);
            _bj_tx_cstr(&lt, " kappa_max=");
            _bj_fmt_f64_debug(&lt, cl.kappa_max);
            _bj_tx_cstr(&lt, " alpha_max=");
            _bj_fmt_f64_debug(&lt, cl.alpha_max);
            _bj_tx_cstr(&lt, " mode=");
            if (self.mode == BJ_MODE2D_TE) { _bj_tx_cstr(&lt, "Te"); }
            else { _bj_tx_cstr(&lt, "Tm"); }
            _bj_log_text(4, &lt);
        }
        if (self.cpml != 0) {
            BjCpml_free(self.cpml);
            fl_free(self.cpml);
        }
        self.cpml = blk;
        return Ok(0);
    }

    # try_enable_cpml without the error: on invalid input (thickness 0, or 2·thickness + 3 > min(nx, ny)) logs a
    # warning and leaves the boundaries as they are. Mirrors `Fdtd2d::enable_cpml`.
    public fn enable_cpml(self, thickness) {
        var t, v = self.try_enable_cpml(thickness);
        if (is_err_result(t) == 1 && _bj_log_on(2) == 1) {
            var lb[512];
            var lt[24];
            _bj_tx_init(&lt, &lb, 512);
            _bj_tx_cstr(&lt, "enable_cpml ignored; boundaries unchanged thickness=");
            _bj_tx_u64(&lt, thickness);
            _bj_tx_cstr(&lt, " error=");
            _bj_tx_cstr(&lt, bj_last_error_display());
            _bj_log_text(2, &lt);
        }
        return 0;
    }

    # Removes the CPML (giving its storage back) and returns to the reflecting PEC (TM) or PMC (TE) walls. Mirrors
    # `Fdtd2d::disable_cpml`.
    public fn disable_cpml(self) {
        if (self.cpml != 0) {
            BjCpml_free(self.cpml);
            fl_free(self.cpml);
            self.cpml = 0;
            _bj_log(4, "2D CPML disabled");
        }
        return 0;
    }

    # The active CPML layer's address (a *BjCpml), or 0 (Rust's None). Mirrors `Fdtd2d::cpml`.
    #must_use
    public fn cpml(self): i64 {
        return self.cpml;
    }

    # The TM update, E_z, H_x, H_y, in Rust's order: H_x −= C_h·(E_z[y + 1] − E_z[y]) on rows 0..ny − 1, H_y +=
    # C_h·(E_z[x + 1] − E_z[x]) for x < nx − 1 on every row (each cell's update reads only E_z, so the rows
    # interleave), the CPML's H terms, E_z ← C_a·E_z where lossy, E_z += C_b·((H_y[x] − H_y[x − 1]) − (H_x[y] −
    # H_x[y − 1])) on the interior, the CPML's E_z terms, the PEC wall. Mirrors `Fdtd2d::step_tm`.
    fn step_tm(self) {
        var nx = self.nx;
        var ny = self.ny;
        var n = nx * ny;
        var fz: *f64 = _bj_fd2_f64p(self.fz);
        var fx: *f64 = _bj_fd2_f64p(self.fx);
        var fy: *f64 = _bj_fd2_f64p(self.fy);
        var ce: *f64 = _bj_fd2_f64p(self.ce);
        var ch: *f64 = _bj_fd2_f64p(self.ch);
        var w: *f64 = _bj_fd2_f64p(self.work);
        var w2: *f64 = _bj_fd2_f64p(self.work + nx * 8);
        for (var y = 0; y < ny; y = y + 1) {
            var r = y * nx;
            if (y < ny - 1) { _bj_fd2_diff(fx + r, ch + r, fz + r + nx, fz + r, w, nx, 0); }
            _bj_fd2_diff(fy + r, ch + r, fz + r + 1, fz + r, w, nx - 1, 1);
        }
        if (self.cpml != 0) {
            _bj_fd2_cpml_fx(self.cpml, fx, fz, ch, nx, ny, -1.0, w);
            _bj_fd2_cpml_fy(self.cpml, fy, fz, ch, nx, ny, 1.0);
        }
        if (self.ca != 0) { _bj_fd2_scale(fz, _bj_fd2_f64p(self.ca), n); }
        for (var y2 = 1; y2 < ny - 1; y2 = y2 + 1) {
            var r2 = y2 * nx;
            _bj_fd2_curl(fz + r2, ce + r2, fy + r2, fx + r2, fx + r2 - nx, w, w2, nx, 1);
        }
        if (self.cpml != 0) { _bj_fd2_cpml_fz(self.cpml, fz, fx, fy, ce, nx, ny, 1.0, w); }
        _bj_fd2_walls(fz, nx, ny);
        return 0;
    }

    # The TE update, H_z, E_x, E_y, in Rust's order: E ← C_a·E where lossy, E_x += C_b·(H_z[y + 1] − H_z[y]) on rows
    # 0..ny − 1, E_y −= C_b·(H_z[x + 1] − H_z[x]) for x < nx − 1 on every row, the CPML's E terms, H_z −=
    # C_h·((E_y[x] − E_y[x − 1]) − (E_x[y] − E_x[y − 1])) on the interior, the CPML's H_z terms, the PMC wall. Mirrors
    # `Fdtd2d::step_te`.
    fn step_te(self) {
        var nx = self.nx;
        var ny = self.ny;
        var n = nx * ny;
        var fz: *f64 = _bj_fd2_f64p(self.fz);
        var fx: *f64 = _bj_fd2_f64p(self.fx);
        var fy: *f64 = _bj_fd2_f64p(self.fy);
        var ce: *f64 = _bj_fd2_f64p(self.ce);
        var ch: *f64 = _bj_fd2_f64p(self.ch);
        var w: *f64 = _bj_fd2_f64p(self.work);
        var w2: *f64 = _bj_fd2_f64p(self.work + nx * 8);
        if (self.ca != 0) {
            var ca: *f64 = _bj_fd2_f64p(self.ca);
            _bj_fd2_scale(fx, ca, n);
            _bj_fd2_scale(fy, ca, n);
        }
        for (var y = 0; y < ny; y = y + 1) {
            var r = y * nx;
            if (y < ny - 1) { _bj_fd2_diff(fx + r, ce + r, fz + r + nx, fz + r, w, nx, 1); }
            _bj_fd2_diff(fy + r, ce + r, fz + r + 1, fz + r, w, nx - 1, 0);
        }
        if (self.cpml != 0) {
            _bj_fd2_cpml_fx(self.cpml, fx, fz, ce, nx, ny, 1.0, w);
            _bj_fd2_cpml_fy(self.cpml, fy, fz, ce, nx, ny, -1.0);
        }
        for (var y2 = 1; y2 < ny - 1; y2 = y2 + 1) {
            var r2 = y2 * nx;
            _bj_fd2_curl(fz + r2, ch + r2, fy + r2, fx + r2, fx + r2 - nx, w, w2, nx, 0);
        }
        if (self.cpml != 0) { _bj_fd2_cpml_fz(self.cpml, fz, fx, fy, ch, nx, ny, -1.0, w); }
        _bj_fd2_walls(fz, nx, ny);
        return 0;
    }

    # Advances the simulation one time step: the mode's update, the outermost ring always the PEC (TM) or PMC (TE)
    # wall. Mirrors `Fdtd2d::step_once`.
    public fn step_once(self) {
        if (self.mode == BJ_MODE2D_TE) { self.step_te(); }
        else { self.step_tm(); }
        self.step = self.step + 1;
        return 0;
    }

    # Runs `steps` time steps (a usize). Before each, when (sx, sy) is in the grid, adds amplitude·sin(2π·frequency·t)
    # at it as a soft source, t = step·dt; BJ_FDTD2D_NO_SOURCE for sx (or any node outside the grid) injects nothing,
    # as Rust's None. Mirrors `Fdtd2d::run`.
    public fn run(self, steps, sx, sy, frequency: f64, amplitude: f64) {
        if (_bj_log_on(4) == 1) {
            var lb[256];
            var lt[24];
            _bj_tx_init(&lt, &lb, 256);
            _bj_tx_cstr(&lt, "2D FDTD run started steps=");
            _bj_tx_u64(&lt, steps);
            _bj_tx_cstr(&lt, " source=");
            if (sx == BJ_FDTD2D_NO_SOURCE) {
                _bj_tx_cstr(&lt, "None");
            } else {
                _bj_tx_cstr(&lt, "Some((");
                _bj_tx_u64(&lt, sx);
                _bj_tx_cstr(&lt, ", ");
                _bj_tx_u64(&lt, sy);
                _bj_tx_cstr(&lt, "))");
            }
            _bj_tx_cstr(&lt, " frequency=");
            _bj_fmt_f64_debug(&lt, frequency);
            _bj_tx_cstr(&lt, " amplitude=");
            _bj_fmt_f64_debug(&lt, amplitude);
            if (self.cpml == 0) { _bj_tx_cstr(&lt, " cpml=None"); }
            else {
                var lc: *BjCpml = _bj_fd2_cpmlp(self.cpml);
                _bj_tx_cstr(&lt, " cpml=Some(");
                _bj_tx_u64(&lt, lc.thickness);
                _bj_tx_cstr(&lt, ")");
            }
            _bj_log_text(4, &lt);
        }
        var w2pi: f64 = 2.0 * _BJ_FD2_PI;
        var wf: f64 = w2pi * frequency;
        for (var k = 0; _bj_fd2_uge(k, steps) == 0; k = k + 1) {
            if (sx != BJ_FDTD2D_NO_SOURCE) {
                var sf: f64 = _bj_fd2_u2f(self.step);
                var t: f64 = sf * self.dt;
                var arg: f64 = wf * t;
                var sv: f64 = _bj_sin(arg);
                var value: f64 = amplitude * sv;
                self.add_source(sx, sy, value);
            }
            self.step_once();
        }
        return 0;
    }

    # The simulation time step·dt in seconds. Mirrors `Fdtd2d::time`.
    #must_use
    public fn time(self): f64 {
        var sf: f64 = _bj_fd2_u2f(self.step);
        var t: f64 = sf * self.dt;
        return t;
    }

    # The total electromagnetic energy in the grid, Σ ½·m_z·k_z·f_z² + ½·m_xy·k_xy·(f_x² + f_y²) times dx², in Rust's
    # order from +0: TM's (ε_r, ε₀) for f_z and (μ_r, μ₀) for f_x, f_y; TE's the other way. Mirrors
    # `Fdtd2d::total_energy`.
    #must_use
    public fn total_energy(self): f64 {
        var n = self.nx * self.ny;
        var dx: f64 = self.dx;
        var area: f64 = dx * dx;
        var zm: *f64 = _bj_fd2_f64p(self.permittivity);
        var zc: f64 = BJ_EPSILON_0;
        var xym: *f64 = _bj_fd2_f64p(self.permeability);
        var xyc: f64 = BJ_MU_0;
        if (self.mode == BJ_MODE2D_TE) {
            zm = _bj_fd2_f64p(self.permeability);
            zc = BJ_MU_0;
            xym = _bj_fd2_f64p(self.permittivity);
            xyc = BJ_EPSILON_0;
        }
        var fz: *f64 = _bj_fd2_f64p(self.fz);
        var fx: *f64 = _bj_fd2_f64p(self.fx);
        var fy: *f64 = _bj_fd2_f64p(self.fy);
        var energy: f64 = 0.0;
        for (var i = 0; i < n; i = i + 1) {
            var z: f64 = fz[i];
            var a: f64 = 0.5 * zm[i];
            var b: f64 = a * zc;
            var c: f64 = b * z;
            var d: f64 = c * z;
            energy = energy + d;
            var x: f64 = fx[i];
            var y: f64 = fy[i];
            var xx: f64 = x * x;
            var yy: f64 = y * y;
            var s: f64 = xx + yy;
            var a2: f64 = 0.5 * xym[i];
            var b2: f64 = a2 * xyc;
            var c2: f64 = b2 * s;
            energy = energy + c2;
        }
        var e: f64 = energy * area;
        return e;
    }
}

# --- fdtd3d.cyr ---

# fdtd3d.cyr — fdtd.rs's 3D solver (M6 part 2a): `Fdtd3d`, the full vector Yee algorithm on an nx × ny × nz grid, all
# six components E_x, E_y, E_z, H_x, H_y, H_z, SI units. Fields are stored z-major, index z·nx·ny + y·nx + x. The
# time step is half the 3D Courant limit, dt = dx/(2√3·c), a Courant number of 1/(2√3).
#
# The outer faces are perfect electric conductors: tangential E is held at zero on all six faces (E_y and E_z on the x
# faces, E_x and E_z on the y faces, E_x and E_y on the z faces), so outgoing waves reflect. A CPML (M6 part 2b) can
# absorb them instead: a layer of src/cpml.cyr's grading occupies the outermost `thickness` cells on every face, edges
# and corners included, ends on the same wall, and corrects each curl term in the two face slabs normal to its
# derivative axis after each phase (Rust's `Cpml3d`, `correct_slabs`). Its twelve Ψ fields, named `<component>_<axis>`
# (hx_z is Ψ of ∂E_y/∂z in the H_x update), live in one mapping owned by the grid. Per-cell ε_r, μ_r and
# conductivity σ (the lossy E update E ← C_a·E + C_b·∇×H, C_a = (1 − σΔt/2ε)/(1 + σΔt/2ε), C_b = (Δt/εΔx)/(1 +
# σΔt/2ε)) are set by box region.
#
# A grid's ten arrays (E_x, E_y, E_z, H_x, H_y, H_z, the C_b and H coefficients, ε_r and μ_r) and three scratch rows
# are one anonymous mmap, fixed at construction; the first lossy region maps C_a and σ beside them. BjFdtd3d_free gives
# both back. Rust's public, resizable `Vec` fields and the per-step layout check that guarded them are gone (ADR 0002
# row 2), as the 2D grid's: the fields are the arrays' addresses and nx·ny·nz their length. No step allocates. Each
# component's update is one row kernel on the packed f64v_* verbs, every lane rounding Rust's operations in Rust's
# order (port plan §9.3, probe p10), on lane multiples with a scalar tail (probe p19). The H components read only E and
# the E components only H, so each phase's rows run in one pass over the grid. The file is time-domain only; bijli's
# one harmonic convention, e^{+jωt}, is stated in src/complex.cyr's header. The shared helpers (the usize compares,
# the E coefficients, the region and material checks) are src/fdtd2d.cyr's.

private

# std::f64::consts::PI, and 3.0_f64.sqrt() (correctly rounded).
var _BJ_FD3_PI: f64 = 3.141592653589793;
var _BJ_FD3_SQRT_3: f64 = 1.7320508075688772;
# The grid's arrays, each nx·ny·nz f64, in one mapping: E_x, E_y, E_z, H_x, H_y, H_z, C_b, the H coefficients, ε_r and
# μ_r (then three scratch rows of max(nx, 1024)).
var _BJ_FD3_ARRAYS = 10;
# The scratch rows' least length: the energy's chunk.
var _BJ_FD3_CHUNK = 1024;
# The largest nx·ny·nz whose mapping (under 104 bytes a cell with the scratch rows) a 64-bit length holds: 2^56 − 1.
var _BJ_FD3_MAX_CELLS = 72057594037927935;

# Rust's `run(steps, None, ..)`: no source. Rust's Some((x, y, z)) outside the grid injects nothing either, so
# usize::MAX (−1) for x is None exactly.
public var BJ_FDTD3D_NO_SOURCE = 0 - 1;

# A 3D FDTD simulation. nx × ny × nz are the nodes, `dx` (m) the uniform spacing, `dt` (s) the step, `step` the
# time-step index. `ex`, `ey`, `ez`, `hx`, `hy` and `hz` are the addresses of nx·ny·nz f64 each (read and write the
# values, as Rust's public vectors). `ce` holds C_b per cell (Δt/(ε₀ε_r·Δx), divided by 1 + σΔt/2ε where lossy), `ch`
# Δt/(μ₀μ_r·Δx), `ca` C_a and `conductivity` σ (S/m), both 0 while every cell is lossless (Rust's empty vectors),
# `permittivity` ε_r and `permeability` μ_r. `cpml` is the attached layer's address (a freelist block holding an
# unattached BjCpml: its grading and profiles), 0 for none; read it through `cpml()`. `psi` is the mapping of its
# twelve Ψ slabs (`psi_bytes` long): four x-slabs of `slab_x` = 2·thickness·ny·nz f64 (hy_x, hz_x, ey_x, ez_x), four
# y-slabs of `slab_y` = 2·thickness·nx·nz (hx_y, hz_y, ex_y, ez_y) and four z-slabs of `slab_z` = 2·thickness·nx·ny
# (hx_z, hy_z, ex_z, ey_z), each the grid's shape with its axis cut to the 2·thickness layers, x fastest. `work` holds
# three scratch rows of `wlen` (max(nx, 1024)) f64, the updates' and the energy's, `map_bytes` and `lossy_bytes`
# the mappings' lengths (0 once freed). Mirrors `Fdtd3d`.
public struct BjFdtd3d {
    nx;
    ny;
    nz;
    dx: f64;
    dt: f64;
    step;
    ex;
    ey;
    ez;
    hx;
    hy;
    hz;
    ce;
    ch;
    ca;
    permittivity;
    permeability;
    conductivity;
    work;
    wlen;
    map_bytes;
    lossy_bytes;
    cpml;
    psi;
    psi_bytes;
    slab_x;
    slab_y;
    slab_z;
}

# One row of a curl update: d[i] += k[i]·((a[i] − ap[i]) − (b[i] − bp[i])) for i < n, Rust's `f[i] += c[i] * (da −
# db)` for each of the six components, on the packed f64v_sub, f64v_mul and f64v_add through the scratch rows w and w2
# on the largest multiple of 4, then a scalar tail (probe p19).
fn _bj_fd3_curl(d: *f64, k: *f64, a: *f64, ap: *f64, b: *f64, bp: *f64, w: *f64, w2: *f64, n) {
    var m = n & (0 - 4);
    if (m > 0) {
        f64v_sub(w, a, ap, m);
        f64v_sub(w2, b, bp, m);
        f64v_sub(w, w, w2, m);
        f64v_mul(w, k, w, m);
        f64v_add(d, d, w, m);
    }
    for (var i = m; i < n; i = i + 1) {
        var da: f64 = a[i] - ap[i];
        var db: f64 = b[i] - bp[i];
        var dd: f64 = da - db;
        var v: f64 = k[i] * dd;
        d[i] = d[i] + v;
    }
    return 0;
}

# A word as a *BjCpml.
#must_use
fn _bj_fd3_cpmlp(a): *BjCpml {
    return a;
}

# Writes a pass's update ranges [x0, x1) × [y0, y1) × [z0, z1) into g[3..9] (g[0..3] holds the grid's nx, ny, nz).
fn _bj_fd3_ranges(g: *i64, x0, x1, y0, y1, z0, z1) {
    g[3] = x0;
    g[4] = x1;
    g[5] = y0;
    g[6] = y1;
    g[7] = z0;
    g[8] = z1;
    return 0;
}

# One 3D CPML derivative term over both face slabs normal to `axis` (0 x, 1 y, 2 z): Ψ ← b·Ψ + c·Δ, f += sign·k·((1/κ −
# 1)·Δ + Ψ), Δ the source field's difference along the axis. With half 1 the corrected field sits half a cell off the
# nodes along the axis (the H update): Δ = src[u + 1] − src[u], layer l = 0..t lies l + ½ cells from the wall (the
# half-node profiles). With half 0 (the E update) Δ = src[u] − src[u − 1], layer l = 1..t on the integer node l cells
# from the wall (l = 0 is the wall, reset after the update). g holds the grid's nx, ny, nz, then the main loop's update
# ranges (x0, x1, y0, y1, z0, z1), the axis's replaced by the two slabs'; psi has the grid's shape with the axis cut to
# 2·t layers, indexed side·t + l, x fastest. A y- or z-slab row is one layer on contiguous x, run on the packed strip
# (src/fdtd2d.cyr's, through the scratch rows w); an x-slab row crosses the layers cell by cell, ascending on the low
# side and descending on the high side. The layer is attached to this grid. Mirrors `Cpml::correct_slabs`.
fn _bj_fd3_slabs(c: *BjCpml, axis, half, psi: *f64, f: *f64, src: *f64, k: *f64, g: *i64, sign: f64, w: *f64) {
    var nx = g[0];
    var nxy = nx * g[1];
    var n = g[axis];
    var t = c.thickness;
    var stride = 1;
    if (axis == 1) { stride = nx; }
    if (axis == 2) { stride = nxy; }
    var bp: *f64 = _bj_fd2_f64p(c.b_node);
    var cp: *f64 = _bj_fd2_f64p(c.c_node);
    var kp: *f64 = _bj_fd2_f64p(c.km1_node);
    var l0 = 1;
    var off = 1;
    if (half == 1) {
        bp = _bj_fd2_f64p(c.b_half);
        cp = _bj_fd2_f64p(c.c_half);
        kp = _bj_fd2_f64p(c.km1_half);
        l0 = 0;
        off = 2;
    }
    var pd0 = nx;
    var pd1 = g[1];
    if (axis == 0) { pd0 = 2 * t; }
    if (axis == 1) { pd1 = 2 * t; }
    var pr: f64[4];
    pr[3] = sign;
    var lo: i64[3];
    var hi: i64[3];
    for (var side = 0; side < 2; side = side + 1) {
        for (var a = 0; a < 3; a = a + 1) {
            lo[a] = g[3 + 2 * a];
            hi[a] = g[4 + 2 * a];
        }
        if (side == 0) {
            lo[axis] = l0;
            hi[axis] = t;
        } else {
            lo[axis] = n + 1 - off - t;
            hi[axis] = n + 1 - off - l0;
        }
        for (var z = lo[2]; z < hi[2]; z = z + 1) {
            for (var y = lo[1]; y < hi[1]; y = y + 1) {
                var row = z * nxy + y * nx;
                if (axis == 0) {
                    var prow = (z * pd1 + y) * pd0 + side * t;
                    for (var x = lo[0]; x < hi[0]; x = x + 1) {
                        var l = x;
                        if (side == 1) { l = n - off - x; }
                        var i = row + x;
                        var d: f64 = src[i + 1] - src[i];
                        if (half == 0) { d = src[i] - src[i - 1]; }
                        var pv: f64 = bp[l] * psi[prow + l] + cp[l] * d;
                        psi[prow + l] = pv;
                        f[i] = f[i] + sign * k[i] * (kp[l] * d + pv);
                    }
                } else {
                    var u = y;
                    if (axis == 2) { u = z; }
                    var l2 = u;
                    if (side == 1) { l2 = n - off - u; }
                    var sl = side * t + l2;
                    var py = y;
                    var pz = sl;
                    if (axis == 1) {
                        py = sl;
                        pz = z;
                    }
                    var prow2 = (pz * pd1 + py) * pd0;
                    var up = row;
                    var down = row - stride;
                    if (half == 1) {
                        up = row + stride;
                        down = row;
                    }
                    pr[0] = bp[l2];
                    pr[1] = cp[l2];
                    pr[2] = kp[l2];
                    var x0 = lo[0];
                    _bj_fd2_strip(f + row + x0, src + up + x0, src + down + x0, k + row + x0, psi + prow2 + x0,
                      hi[0] - x0, &pr, w, 0);
                }
            }
        }
    }
    return 0;
}

# Zeroes n f64 at f.
fn _bj_fd3_zero(f: *f64, n) {
    for (var i = 0; i < n; i = i + 1) { f[i] = 0.0; }
    return 0;
}

# A vacuum grid of nx × ny × nz nodes at spacing dx into *out, the faces PEC: Ok(0), or with out untouched
# Err(InsufficientResolution) when a dimension is below 3 (cells min(nx, ny, nz), domain that min·dx),
# Err(InvalidParameter) "dx must be finite and positive, got {dx}", "grid [{nx}, {ny}, {nz}] is too large" (the cell
# count past 2^64) or "cannot allocate {n} grid values", in Rust's order. dt = dx/(2√3·c). Give it back with
# BjFdtd3d_free. Mirrors `Fdtd3d::new`.
#must_use
public fn BjFdtd3d_new(nx, ny, nz, dx: f64, out: *BjFdtd3d): Result {
    if ((nx >= 0 && nx < 3) || (ny >= 0 && ny < 3) || (nz >= 0 && nz < 3)) {
        var mn = nx;
        if (_bj_fd2_uge(mn, ny) == 1) { mn = ny; }
        if (_bj_fd2_uge(mn, nz) == 1) { mn = nz; }
        var mf: f64 = _bj_fd2_u2f(mn);
        var size: f64 = mf * dx;
        return Err(_bj_err_insufficient_resolution(mn, size));
    }
    if (_bj_fd2_pos(dx) == 0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "dx must be finite and positive, got ");
        _bj_fmt_f64_display(t, dx);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var plane: i64[1];
    var cells: i64[1];
    if (_bj_fd2_umul(nx, ny, &plane) == 0 || _bj_fd2_umul(plane[0], nz, &cells) == 0) {
        var tg = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(tg, "grid [");
        _bj_tx_u64(tg, nx);
        _bj_tx_cstr(tg, ", ");
        _bj_tx_u64(tg, ny);
        _bj_tx_cstr(tg, ", ");
        _bj_tx_u64(tg, nz);
        _bj_tx_cstr(tg, "] is too large");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var n = cells[0];
    var c: f64 = BJ_SPEED_OF_LIGHT;
    var r3: f64 = 2.0 * _BJ_FD3_SQRT_3;
    var r3c: f64 = r3 * c;
    var dt: f64 = dx / r3c;
    var map = 0;
    var bytes = 0;
    var wl = nx;
    if (_bj_fd2_uge(wl, _BJ_FD3_CHUNK) == 0) { wl = _BJ_FD3_CHUNK; }
    if (n >= 0 && n <= _BJ_FD3_MAX_CELLS) {
        bytes = (n * _BJ_FD3_ARRAYS + 3 * wl) * 8;
        map = mmap_anon(bytes);
    }
    if (map == 0) { return Err(_bj_fd2_alloc_err(n)); }
    var e0dx: f64 = BJ_EPSILON_0 * dx;
    var ce: f64 = dt / e0dx;
    var m0dx: f64 = BJ_MU_0 * dx;
    var ch: f64 = dt / m0dx;
    var cep: *f64 = _bj_fd2_f64p(map + 6 * n * 8);
    var chp: *f64 = _bj_fd2_f64p(map + 7 * n * 8);
    var eps: *f64 = _bj_fd2_f64p(map + 8 * n * 8);
    var mu: *f64 = _bj_fd2_f64p(map + 9 * n * 8);
    for (var i = 0; i < n; i = i + 1) {
        cep[i] = ce;
        chp[i] = ch;
        eps[i] = 1.0;
        mu[i] = 1.0;
    }
    out.nx = nx;
    out.ny = ny;
    out.nz = nz;
    out.dx = dx;
    out.dt = dt;
    out.step = 0;
    out.ex = map;
    out.ey = map + n * 8;
    out.ez = map + 2 * n * 8;
    out.hx = map + 3 * n * 8;
    out.hy = map + 4 * n * 8;
    out.hz = map + 5 * n * 8;
    out.ce = map + 6 * n * 8;
    out.ch = map + 7 * n * 8;
    out.permittivity = map + 8 * n * 8;
    out.permeability = map + 9 * n * 8;
    out.work = map + 10 * n * 8;
    out.wlen = wl;
    out.ca = 0;
    out.conductivity = 0;
    out.map_bytes = bytes;
    out.lossy_bytes = 0;
    out.cpml = 0;
    out.psi = 0;
    out.psi_bytes = 0;
    out.slab_x = 0;
    out.slab_y = 0;
    out.slab_z = 0;
    if (_bj_log_on(4) == 1) {
        var lb[256];
        var lt[24];
        _bj_tx_init(&lt, &lb, 256);
        _bj_tx_cstr(&lt, "3D FDTD simulation created nx=");
        _bj_tx_u64(&lt, nx);
        _bj_tx_cstr(&lt, " ny=");
        _bj_tx_u64(&lt, ny);
        _bj_tx_cstr(&lt, " nz=");
        _bj_tx_u64(&lt, nz);
        _bj_tx_cstr(&lt, " dx=");
        _bj_fmt_f64_debug(&lt, dx);
        _bj_tx_cstr(&lt, " dt=");
        _bj_fmt_f64_debug(&lt, dt);
        _bj_tx_cstr(&lt, " n=");
        _bj_tx_u64(&lt, n);
        _bj_log_text(4, &lt);
    }
    return Ok(0);
}

# Gives a CPML's layer and Ψ slabs back and detaches it from the grid (cpml = psi = 0).
fn _bj_fd3_drop_cpml(sim: *BjFdtd3d) {
    if (sim.cpml != 0) {
        BjCpml_free(sim.cpml);
        fl_free(sim.cpml);
    }
    if (sim.psi_bytes > 0) { cyr_munmap(sim.psi, sim.psi_bytes); }
    sim.cpml = 0;
    sim.psi = 0;
    sim.psi_bytes = 0;
    sim.slab_x = 0;
    sim.slab_y = 0;
    sim.slab_z = 0;
    return 0;
}

# Gives a grid's mappings and its CPML back and empties it (nx = ny = nz = 0, every address 0); a second call does
# nothing.
public fn BjFdtd3d_free(sim: *BjFdtd3d): i64 {
    _bj_fd3_drop_cpml(sim);
    if (sim.map_bytes > 0) { cyr_munmap(sim.ex, sim.map_bytes); }
    if (sim.lossy_bytes > 0) { cyr_munmap(sim.ca, sim.lossy_bytes); }
    sim.ex = 0;
    sim.ey = 0;
    sim.ez = 0;
    sim.hx = 0;
    sim.hy = 0;
    sim.hz = 0;
    sim.ce = 0;
    sim.ch = 0;
    sim.ca = 0;
    sim.permittivity = 0;
    sim.permeability = 0;
    sim.conductivity = 0;
    sim.work = 0;
    sim.wlen = 0;
    sim.nx = 0;
    sim.ny = 0;
    sim.nz = 0;
    sim.map_bytes = 0;
    sim.lossy_bytes = 0;
    return 0;
}

impl BjFdtd3d {
    # The linear index of node (x, y, z): z·(nx·ny) + y·nx + x. Mirrors `Fdtd3d::idx`.
    #must_use
    public fn idx(self, x, y, z): i64 {
        return z * (self.nx * self.ny) + y * self.nx + x;
    }

    # Writes material values to an already validated box r[0..6] (x0, x1, y0, y1, z0, z1) and refreshes the update
    # coefficients; a flag of 0 leaves that property as it is (Rust's None). The first region with σ > 0 maps C_a (1)
    # and σ (0) for every cell: Ok(0), or Err(InvalidParameter) "cannot allocate {n} grid values" with nothing written.
    # Mirrors `Fdtd3d::apply_region`.
    fn apply_region(self, r: *i64, has_eps, eps_r: f64, has_mu, mu_r: f64, has_sigma, sigma: f64): Result {
        var nx = self.nx;
        var nxy = nx * self.ny;
        var n = nxy * self.nz;
        if (has_sigma == 1 && sigma > 0.0 && self.ca == 0) {
            var map = mmap_anon(2 * n * 8);
            if (map == 0) { return Err(_bj_fd2_alloc_err(n)); }
            var cap: *f64 = _bj_fd2_f64p(map);
            for (var i = 0; i < n; i = i + 1) { cap[i] = 1.0; }
            self.ca = map;
            self.conductivity = map + n * 8;
            self.lossy_bytes = 2 * n * 8;
        }
        if (_bj_log_on(4) == 1) {
            var lb[256];
            var lt[24];
            _bj_tx_init(&lt, &lb, 256);
            _bj_tx_cstr(&lt, "3D FDTD material region set xs=");
            _bj_tx_u64(&lt, r[0]);
            _bj_tx_cstr(&lt, "..");
            _bj_tx_u64(&lt, r[1]);
            _bj_tx_cstr(&lt, " ys=");
            _bj_tx_u64(&lt, r[2]);
            _bj_tx_cstr(&lt, "..");
            _bj_tx_u64(&lt, r[3]);
            _bj_tx_cstr(&lt, " zs=");
            _bj_tx_u64(&lt, r[4]);
            _bj_tx_cstr(&lt, "..");
            _bj_tx_u64(&lt, r[5]);
            _bj_log_text(4, &lt);
        }
        var dt: f64 = self.dt;
        var dx: f64 = self.dx;
        var m0dx: f64 = BJ_MU_0 * dx;
        var base_h: f64 = dt / m0dx;
        var eps: *f64 = _bj_fd2_f64p(self.permittivity);
        var mu: *f64 = _bj_fd2_f64p(self.permeability);
        var ce: *f64 = _bj_fd2_f64p(self.ce);
        var ch: *f64 = _bj_fd2_f64p(self.ch);
        var ca: *f64 = _bj_fd2_f64p(self.ca);
        var cond: *f64 = _bj_fd2_f64p(self.conductivity);
        for (var z = r[4]; z < r[5]; z = z + 1) {
            for (var y = r[2]; y < r[3]; y = y + 1) {
                for (var x = r[0]; x < r[1]; x = x + 1) {
                    var i = z * nxy + y * nx + x;
                    if (has_mu == 1) {
                        mu[i] = mu_r;
                        var hm: f64 = base_h / mu_r;
                        ch[i] = hm;
                    }
                    if (has_eps == 1 || has_sigma == 1) {
                        if (has_eps == 1) { eps[i] = eps_r; }
                        if (has_sigma == 1 && self.conductivity != 0) { cond[i] = sigma; }
                        var s: f64 = 0.0;
                        if (self.conductivity != 0) { s = cond[i]; }
                        var cav, cbv = _bj_fd2_e_coefficients(dt, dx, eps[i], s);
                        ce[i] = cbv;
                        if (self.ca != 0) { ca[i] = cav; }
                    }
                }
            }
        }
        return Ok(0);
    }

    # The validated box [x0, x1) × [y0, y1) × [z0, z1) into r[0..6] (x0, x1, y0, y1, z0, z1, each end clamped to the
    # grid): 0, or InvalidParameter (x's first, then y's, then z's) recorded and its code. Mirrors `Fdtd3d::region`.
    fn region(self, x0, y0, z0, x1, y1, z1, r: *i64): i64 {
        var e = _bj_fd2_range("x", x0, x1, self.nx, r);
        if (e != 0) { return e; }
        e = _bj_fd2_range("y", y0, y1, self.ny, r + 2);
        if (e != 0) { return e; }
        return _bj_fd2_range("z", z0, z1, self.nz, r + 4);
    }

    # Sets ε_r over [x0, x1) × [y0, y1) × [z0, z1), the ends clamped to the grid; σ already set there is kept. Ok(0),
    # or with nothing modified Err(InvalidPermittivity) for an ε_r not finite and positive, Err(InvalidParameter) for a
    # region that starts outside the grid or is inverted. Mirrors `Fdtd3d::set_permittivity`.
    public fn set_permittivity(self, x0, y0, z0, x1, y1, z1, eps_r: f64): Result {
        var e = _bj_fd2_check_eps(eps_r);
        if (e != 0) { return Err(e); }
        var r: i64[6];
        e = self.region(x0, y0, z0, x1, y1, z1, &r);
        if (e != 0) { return Err(e); }
        return self.apply_region(&r, 1, eps_r, 0, 1.0, 0, 0.0);
    }

    # Sets μ_r over [x0, x1) × [y0, y1) × [z0, z1), the ends clamped. Ok(0), or with nothing modified
    # Err(InvalidPermeability) for a μ_r not finite and positive, Err(InvalidParameter) for a bad region. Mirrors
    # `Fdtd3d::set_permeability`.
    public fn set_permeability(self, x0, y0, z0, x1, y1, z1, mu_r: f64): Result {
        var e = _bj_fd2_check_mu(mu_r);
        if (e != 0) { return Err(e); }
        var r: i64[6];
        e = self.region(x0, y0, z0, x1, y1, z1, &r);
        if (e != 0) { return Err(e); }
        return self.apply_region(&r, 0, 1.0, 1, mu_r, 0, 0.0);
    }

    # Sets σ (S/m) over [x0, x1) × [y0, y1) × [z0, z1), the ends clamped: lossy cells take E ← C_a·E + C_b·∇×H (the
    # file comment); the first lossy region maps C_a and σ, and a lossless grid keeps the cheaper lossless update.
    # Ok(0), or with nothing modified Err(InvalidParameter) for a σ negative or not finite, or a bad region. Mirrors
    # `Fdtd3d::set_conductivity`.
    public fn set_conductivity(self, x0, y0, z0, x1, y1, z1, sigma: f64): Result {
        var e = _bj_fd2_check_sigma(sigma);
        if (e != 0) { return Err(e); }
        var r: i64[6];
        e = self.region(x0, y0, z0, x1, y1, z1, &r);
        if (e != 0) { return Err(e); }
        return self.apply_region(&r, 0, 1.0, 0, 1.0, 1, sigma);
    }

    # Sets ε_r, μ_r and σ over [x0, x1) × [y0, y1) × [z0, z1) from a material, every input validated (ε_r, μ_r, σ,
    # then the region) before anything is written. Mirrors `Fdtd3d::set_material`.
    public fn set_material(self, x0, y0, z0, x1, y1, z1, mat: *BjMaterial): Result {
        var e = _bj_fd2_check_eps(mat.eps_r);
        if (e == 0) { e = _bj_fd2_check_mu(mat.mu_r); }
        if (e == 0) { e = _bj_fd2_check_sigma(mat.conductivity); }
        if (e != 0) { return Err(e); }
        var r: i64[6];
        e = self.region(x0, y0, z0, x1, y1, z1, &r);
        if (e != 0) { return Err(e); }
        return self.apply_region(&r, 1, mat.eps_r, 1, mat.mu_r, 1, mat.conductivity);
    }

    # Adds `value` to E_z at node (x, y, z), a soft source; a node outside the grid is ignored (usize compares), and
    # one where E_z is tangential to a wall (an x or y face) is cleared on the next step. Mirrors
    # `Fdtd3d::add_source_ez`.
    public fn add_source_ez(self, x, y, z, value: f64) {
        if (_bj_fd2_uge(x, self.nx) == 1 || _bj_fd2_uge(y, self.ny) == 1 || _bj_fd2_uge(z, self.nz) == 1) {
            return 0;
        }
        var f: *f64 = _bj_fd2_f64p(self.ez);
        var i = z * (self.nx * self.ny) + y * self.nx + x;
        f[i] = f[i] + value;
        return 0;
    }

    # Replaces the reflecting walls by a CPML of the classic grading (BjCpmlParams_new) `thickness` cells on every face;
    # calling it again replaces the layer (Ψ restarts at zero). Ok(0), or with the boundaries unchanged
    # Err(InvalidParameter) as try_enable_cpml_with. Mirrors `Fdtd3d::try_enable_cpml`.
    public fn try_enable_cpml(self, thickness): Result {
        var p: BjCpmlParams = BjCpmlParams_new(thickness);
        return self.try_enable_cpml_with(&p);
    }

    # Replaces the reflecting walls by a CPML of params' grading (κ and CFS-α profiles, grading order, σ_max's scale),
    # occupying the outermost thickness cells on every face; calling it again replaces the layer. Ok(0), or with the
    # boundaries unchanged Err(InvalidParameter), in Rust's order: "CPML thickness {t} is invalid for a {nx}×{ny}×{nz}
    # grid (need thickness ≥ 1 and 2·thickness + 3 ≤ min(nx, ny, nz))", any refusal of BjCpml_with_params, "CPML slabs
    # for a [{nx}, {ny}, {nz}] grid are too large" (the slab lengths past 2^64) or "cannot allocate {n} grid values"
    # (n the first slab Rust allocates, hx_y's). Rust's last check, that the new slabs fit the grid, holds by
    # construction. Mirrors `Fdtd3d::try_enable_cpml_with`.
    public fn try_enable_cpml_with(self, params: *BjCpmlParams): Result {
        var nx = self.nx;
        var ny = self.ny;
        var nz = self.nz;
        var t = params.thickness;
        var md = nx;
        if (_bj_fd2_uge(md, ny) == 1) { md = ny; }
        if (_bj_fd2_uge(md, nz) == 1) { md = nz; }
        if (_bj_cpml_fits(t, md) == 0) {
            var e1 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(e1, "CPML thickness ");
            _bj_tx_u64(e1, t);
            _bj_tx_cstr(e1, " is invalid for a ");
            _bj_tx_u64(e1, nx);
            _bj_tx_cstr(e1, "×");
            _bj_tx_u64(e1, ny);
            _bj_tx_cstr(e1, "×");
            _bj_tx_u64(e1, nz);
            _bj_tx_cstr(e1, " grid (need thickness ≥ 1 and 2·thickness + 3 ≤ min(nx, ny, nz))");
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        var blk = fl_alloc(sizeof(BjCpml));
        if (blk == 0) { return Err(_bj_fd2_alloc_err(t)); }
        var t2, v2 = BjCpml_with_params(params, self.dx, self.dt, blk);
        if (is_err_result(t2) == 1) {
            fl_free(blk);
            return Err(v2);
        }
        var tt: i64[1];
        var p: i64[1];
        var sx: i64[1];
        var sy: i64[1];
        var sz: i64[1];
        var ok = _bj_fd2_umul(t, 2, &tt);
        if (ok == 1) { ok = _bj_fd2_umul(tt[0], ny, &p); }
        if (ok == 1) { ok = _bj_fd2_umul(p[0], nz, &sx); }
        if (ok == 1) { ok = _bj_fd2_umul(tt[0], nx, &p); }
        if (ok == 1) { ok = _bj_fd2_umul(p[0], nz, &sy); }
        if (ok == 1) { ok = _bj_fd2_umul(p[0], ny, &sz); }
        if (ok == 0) {
            BjCpml_free(blk);
            fl_free(blk);
            var e2 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(e2, "CPML slabs for a [");
            _bj_tx_u64(e2, nx);
            _bj_tx_cstr(e2, ", ");
            _bj_tx_u64(e2, ny);
            _bj_tx_cstr(e2, ", ");
            _bj_tx_u64(e2, nz);
            _bj_tx_cstr(e2, "] grid are too large");
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        var map = 0;
        var bytes = 0;
        if (sx[0] >= 0 && sy[0] >= 0 && sz[0] >= 0 && sx[0] <= _BJ_FD3_MAX_CELLS && sy[0] <= _BJ_FD3_MAX_CELLS
          && sz[0] <= _BJ_FD3_MAX_CELLS) {
            bytes = 4 * (sx[0] + sy[0] + sz[0]) * 8;
            map = mmap_anon(bytes);
        }
        if (map == 0) {
            BjCpml_free(blk);
            fl_free(blk);
            return Err(_bj_fd2_alloc_err(sy[0]));
        }
        if (_bj_log_on(4) == 1) {
            var cl: *BjCpml = _bj_fd3_cpmlp(blk);
            var lb[256];
            var lt[24];
            _bj_tx_init(&lt, &lb, 256);
            _bj_tx_cstr(&lt, "3D CPML enabled thickness=");
            _bj_tx_u64(&lt, t);
            _bj_tx_cstr(&lt, " sigma_max=");
            _bj_fmt_f64_debug(&lt, cl.sigma_max);
            _bj_tx_cstr(&lt, " kappa_max=");
            _bj_fmt_f64_debug(&lt, cl.kappa_max);
            _bj_tx_cstr(&lt, " alpha_max=");
            _bj_fmt_f64_debug(&lt, cl.alpha_max);
            _bj_tx_cstr(&lt, " dims=[");
            _bj_tx_u64(&lt, nx);
            _bj_tx_cstr(&lt, ", ");
            _bj_tx_u64(&lt, ny);
            _bj_tx_cstr(&lt, ", ");
            _bj_tx_u64(&lt, nz);
            _bj_tx_cstr(&lt, "]");
            _bj_log_text(4, &lt);
        }
        _bj_fd3_drop_cpml(self);
        self.cpml = blk;
        self.psi = map;
        self.psi_bytes = bytes;
        self.slab_x = sx[0];
        self.slab_y = sy[0];
        self.slab_z = sz[0];
        return Ok(0);
    }

    # Removes the CPML (giving its layer and Ψ slabs back) and returns to the reflecting PEC faces. Mirrors
    # `Fdtd3d::disable_cpml`.
    public fn disable_cpml(self) {
        if (self.cpml != 0) {
            _bj_fd3_drop_cpml(self);
            _bj_log(4, "3D CPML disabled");
        }
        return 0;
    }

    # The active CPML layer's address (a *BjCpml: its thickness and grading), or 0 (Rust's None). Mirrors
    # `Fdtd3d::cpml`.
    #must_use
    public fn cpml(self): i64 {
        return self.cpml;
    }

    # Ψ slab k's address: 0–3 the x-slabs (hy_x, hz_x, ey_x, ez_x), 4–7 the y-slabs (hx_y, hz_y, ex_y, ez_y), 8–11 the
    # z-slabs (hx_z, hy_z, ex_z, ey_z).
    #must_use
    fn slab(self, k): *f64 {
        var at = k * self.slab_x;
        if (k >= 4) { at = 4 * self.slab_x + (k - 4) * self.slab_y; }
        if (k >= 8) { at = 4 * self.slab_x + 4 * self.slab_y + (k - 8) * self.slab_z; }
        return _bj_fd2_f64p(self.psi + at * 8);
    }

    # The CPML's terms of the H update (the half-node profiles), after the main H loops on their update ranges, in
    # Rust's order: H_x's z then y terms, H_y's x then z, H_z's y then x. Mirrors `Cpml3d::correct_h`.
    fn cpml_h(self) {
        var g: i64[9];
        var nx = self.nx;
        var ny = self.ny;
        var nz = self.nz;
        g[0] = nx;
        g[1] = ny;
        g[2] = nz;
        var c: *BjCpml = _bj_fd3_cpmlp(self.cpml);
        var ex: *f64 = _bj_fd2_f64p(self.ex);
        var ey: *f64 = _bj_fd2_f64p(self.ey);
        var ez: *f64 = _bj_fd2_f64p(self.ez);
        var ch: *f64 = _bj_fd2_f64p(self.ch);
        var w: *f64 = _bj_fd2_f64p(self.work);
        _bj_fd3_ranges(&g, 0, nx, 0, ny - 1, 0, nz - 1);
        _bj_fd3_slabs(c, 2, 1, self.slab(8), self.hx, ey, ch, &g, 1.0, w);
        _bj_fd3_slabs(c, 1, 1, self.slab(4), self.hx, ez, ch, &g, -1.0, w);
        _bj_fd3_ranges(&g, 0, nx - 1, 0, ny, 0, nz - 1);
        _bj_fd3_slabs(c, 0, 1, self.slab(0), self.hy, ez, ch, &g, 1.0, w);
        _bj_fd3_slabs(c, 2, 1, self.slab(9), self.hy, ex, ch, &g, -1.0, w);
        _bj_fd3_ranges(&g, 0, nx - 1, 0, ny - 1, 0, nz);
        _bj_fd3_slabs(c, 1, 1, self.slab(5), self.hz, ex, ch, &g, 1.0, w);
        _bj_fd3_slabs(c, 0, 1, self.slab(1), self.hz, ey, ch, &g, -1.0, w);
        return 0;
    }

    # The CPML's terms of the E update (the integer-node profiles), after the main E loops and before the PEC faces, in
    # Rust's order: E_x's y then z terms, E_y's z then x, E_z's x then y. Mirrors `Cpml3d::correct_e`.
    fn cpml_e(self) {
        var g: i64[9];
        var nx = self.nx;
        var ny = self.ny;
        var nz = self.nz;
        g[0] = nx;
        g[1] = ny;
        g[2] = nz;
        var c: *BjCpml = _bj_fd3_cpmlp(self.cpml);
        var hx: *f64 = _bj_fd2_f64p(self.hx);
        var hy: *f64 = _bj_fd2_f64p(self.hy);
        var hz: *f64 = _bj_fd2_f64p(self.hz);
        var ce: *f64 = _bj_fd2_f64p(self.ce);
        var w: *f64 = _bj_fd2_f64p(self.work);
        _bj_fd3_ranges(&g, 0, nx, 1, ny - 1, 1, nz - 1);
        _bj_fd3_slabs(c, 1, 0, self.slab(6), self.ex, hz, ce, &g, 1.0, w);
        _bj_fd3_slabs(c, 2, 0, self.slab(10), self.ex, hy, ce, &g, -1.0, w);
        _bj_fd3_ranges(&g, 1, nx - 1, 0, ny, 1, nz - 1);
        _bj_fd3_slabs(c, 2, 0, self.slab(11), self.ey, hx, ce, &g, 1.0, w);
        _bj_fd3_slabs(c, 0, 0, self.slab(2), self.ey, hz, ce, &g, -1.0, w);
        _bj_fd3_ranges(&g, 1, nx - 1, 1, ny - 1, 0, nz);
        _bj_fd3_slabs(c, 0, 0, self.slab(3), self.ez, hy, ce, &g, 1.0, w);
        _bj_fd3_slabs(c, 1, 0, self.slab(7), self.ez, hx, ce, &g, -1.0, w);
        return 0;
    }

    # The H update from curl E: H_x += C_h·((E_y[z + 1] − E_y) − (E_z[y + 1] − E_z)) on z < nz − 1, y < ny − 1, every
    # x; H_y += C_h·((E_z[x + 1] − E_z) − (E_x[z + 1] − E_x)) on z < nz − 1, x < nx − 1; H_z += C_h·((E_x[y + 1] − E_x)
    # − (E_y[x + 1] − E_y)) on y < ny − 1, x < nx − 1. Each reads only E, so one pass over the rows does all three.
    fn update_h(self) {
        var nx = self.nx;
        var ny = self.ny;
        var nz = self.nz;
        var nxy = nx * ny;
        var ex: *f64 = _bj_fd2_f64p(self.ex);
        var ey: *f64 = _bj_fd2_f64p(self.ey);
        var ez: *f64 = _bj_fd2_f64p(self.ez);
        var hx: *f64 = _bj_fd2_f64p(self.hx);
        var hy: *f64 = _bj_fd2_f64p(self.hy);
        var hz: *f64 = _bj_fd2_f64p(self.hz);
        var ch: *f64 = _bj_fd2_f64p(self.ch);
        var w: *f64 = _bj_fd2_f64p(self.work);
        var w2: *f64 = _bj_fd2_f64p(self.work + nx * 8);
        for (var z = 0; z < nz; z = z + 1) {
            for (var y = 0; y < ny; y = y + 1) {
                var r = z * nxy + y * nx;
                if (z < nz - 1) {
                    if (y < ny - 1) {
                        _bj_fd3_curl(hx + r, ch + r, ey + r + nxy, ey + r, ez + r + nx, ez + r, w, w2, nx);
                    }
                    _bj_fd3_curl(hy + r, ch + r, ez + r + 1, ez + r, ex + r + nxy, ex + r, w, w2, nx - 1);
                }
                if (y < ny - 1) {
                    _bj_fd3_curl(hz + r, ch + r, ex + r + nx, ex + r, ey + r + 1, ey + r, w, w2, nx - 1);
                }
            }
        }
        return 0;
    }

    # The E update from curl H (after E ← C_a·E where lossy): E_x += C_b·((H_z − H_z[y − 1]) − (H_y − H_y[z − 1])) on
    # 1 ≤ z ≤ nz − 2, 1 ≤ y ≤ ny − 2, every x; E_y += C_b·((H_x − H_x[z − 1]) − (H_z − H_z[x − 1])) on 1 ≤ z ≤ nz − 2,
    # 1 ≤ x ≤ nx − 2; E_z += C_b·((H_y − H_y[x − 1]) − (H_x − H_x[y − 1])) on 1 ≤ y ≤ ny − 2, 1 ≤ x ≤ nx − 2. Each
    # reads only H, so one pass over the rows does all three.
    fn update_e(self) {
        var nx = self.nx;
        var ny = self.ny;
        var nz = self.nz;
        var nxy = nx * ny;
        var ex: *f64 = _bj_fd2_f64p(self.ex);
        var ey: *f64 = _bj_fd2_f64p(self.ey);
        var ez: *f64 = _bj_fd2_f64p(self.ez);
        var hx: *f64 = _bj_fd2_f64p(self.hx);
        var hy: *f64 = _bj_fd2_f64p(self.hy);
        var hz: *f64 = _bj_fd2_f64p(self.hz);
        var ce: *f64 = _bj_fd2_f64p(self.ce);
        var w: *f64 = _bj_fd2_f64p(self.work);
        var w2: *f64 = _bj_fd2_f64p(self.work + nx * 8);
        for (var z = 0; z < nz; z = z + 1) {
            var zi = 0;
            if (z > 0 && z < nz - 1) { zi = 1; }
            for (var y = 0; y < ny; y = y + 1) {
                var r = z * nxy + y * nx;
                var r1 = r + 1;
                var yi = 0;
                if (y > 0 && y < ny - 1) { yi = 1; }
                if (zi == 1 && yi == 1) {
                    _bj_fd3_curl(ex + r, ce + r, hz + r, hz + r - nx, hy + r, hy + r - nxy, w, w2, nx);
                }
                if (zi == 1) { _bj_fd3_curl(ey + r1, ce + r1, hx + r1, hx + r1 - nxy, hz + r1, hz + r, w, w2, nx - 2); }
                if (yi == 1) { _bj_fd3_curl(ez + r1, ce + r1, hy + r1, hy + r, hx + r1, hx + r1 - nx, w, w2, nx - 2); }
            }
        }
        return 0;
    }

    # The PEC faces: tangential E zeroed, E_y and E_z on the x faces, E_x and E_z on the y faces, E_x and E_y on the z
    # faces.
    fn walls(self) {
        var nx = self.nx;
        var ny = self.ny;
        var nz = self.nz;
        var nxy = nx * ny;
        var ex: *f64 = _bj_fd2_f64p(self.ex);
        var ey: *f64 = _bj_fd2_f64p(self.ey);
        var ez: *f64 = _bj_fd2_f64p(self.ez);
        for (var z = 0; z < nz; z = z + 1) {
            var p = z * nxy;
            for (var y = 0; y < ny; y = y + 1) {
                var i0 = p + y * nx;
                var i1 = i0 + nx - 1;
                ey[i0] = 0.0;
                ey[i1] = 0.0;
                ez[i0] = 0.0;
                ez[i1] = 0.0;
            }
            var top = p + (ny - 1) * nx;
            _bj_fd3_zero(ex + p, nx);
            _bj_fd3_zero(ex + top, nx);
            _bj_fd3_zero(ez + p, nx);
            _bj_fd3_zero(ez + top, nx);
        }
        var last = (nz - 1) * nxy;
        _bj_fd3_zero(ex, nxy);
        _bj_fd3_zero(ex + last, nxy);
        _bj_fd3_zero(ey, nxy);
        _bj_fd3_zero(ey + last, nxy);
        return 0;
    }

    # Advances the simulation one time step by the 3D Yee algorithm, in Rust's order: H from curl E, the CPML's H terms,
    # E ← C_a·E where lossy, E from curl H, the CPML's E terms, then the PEC faces. Mirrors `Fdtd3d::step_once`.
    public fn step_once(self) {
        self.update_h();
        if (self.cpml != 0) { self.cpml_h(); }
        if (self.ca != 0) {
            var n = self.nx * self.ny * self.nz;
            var ca: *f64 = _bj_fd2_f64p(self.ca);
            _bj_fd2_scale(self.ex, ca, n);
            _bj_fd2_scale(self.ey, ca, n);
            _bj_fd2_scale(self.ez, ca, n);
        }
        self.update_e();
        if (self.cpml != 0) { self.cpml_e(); }
        self.walls();
        self.step = self.step + 1;
        return 0;
    }

    # Runs `steps` time steps (a usize). Before each, when (sx, sy, sz) is in the grid, adds
    # amplitude·sin(2π·frequency·t) to E_z there as a soft source, t = step·dt; BJ_FDTD3D_NO_SOURCE for sx (or any node
    # outside the grid) injects nothing, as Rust's None. Mirrors `Fdtd3d::run`.
    public fn run(self, steps, sx, sy, sz, frequency: f64, amplitude: f64) {
        if (_bj_log_on(4) == 1) {
            var lb[256];
            var lt[24];
            _bj_tx_init(&lt, &lb, 256);
            _bj_tx_cstr(&lt, "3D FDTD run started steps=");
            _bj_tx_u64(&lt, steps);
            _bj_tx_cstr(&lt, " source=");
            if (sx == BJ_FDTD3D_NO_SOURCE) {
                _bj_tx_cstr(&lt, "None");
            } else {
                _bj_tx_cstr(&lt, "Some((");
                _bj_tx_u64(&lt, sx);
                _bj_tx_cstr(&lt, ", ");
                _bj_tx_u64(&lt, sy);
                _bj_tx_cstr(&lt, ", ");
                _bj_tx_u64(&lt, sz);
                _bj_tx_cstr(&lt, "))");
            }
            _bj_tx_cstr(&lt, " frequency=");
            _bj_fmt_f64_debug(&lt, frequency);
            _bj_tx_cstr(&lt, " amplitude=");
            _bj_fmt_f64_debug(&lt, amplitude);
            if (self.cpml == 0) { _bj_tx_cstr(&lt, " cpml=None"); }
            else {
                var lc: *BjCpml = _bj_fd3_cpmlp(self.cpml);
                _bj_tx_cstr(&lt, " cpml=Some(");
                _bj_tx_u64(&lt, lc.thickness);
                _bj_tx_cstr(&lt, ")");
            }
            _bj_log_text(4, &lt);
        }
        var w2pi: f64 = 2.0 * _BJ_FD3_PI;
        var wf: f64 = w2pi * frequency;
        for (var k = 0; _bj_fd2_uge(k, steps) == 0; k = k + 1) {
            if (sx != BJ_FDTD3D_NO_SOURCE) {
                var sf: f64 = _bj_fd2_u2f(self.step);
                var t: f64 = sf * self.dt;
                var arg: f64 = wf * t;
                var sv: f64 = _bj_sin(arg);
                var value: f64 = amplitude * sv;
                self.add_source_ez(sx, sy, sz, value);
            }
            self.step_once();
        }
        return 0;
    }

    # The simulation time step·dt in seconds. Mirrors `Fdtd3d::time`.
    #must_use
    public fn time(self): f64 {
        var sf: f64 = _bj_fd2_u2f(self.step);
        var t: f64 = sf * self.dt;
        return t;
    }

    # The total electromagnetic energy in the grid, Σ (½·ε_r·ε₀·|E|² + ½·μ_r·μ₀·|H|²) times dx³, each square summed
    # x, y, z and each cell's two terms added before the running sum, in Rust's order from +0. The cell terms run on
    # the packed verbs over the flat arrays in chunks of `wlen` through the scratch rows (each lane Rust's operations
    # in Rust's order; IEEE products commute), the running sum cell by cell, a scalar tail past the last lane multiple.
    # Mirrors `Fdtd3d::total_energy`.
    #must_use
    public fn total_energy(self): f64 {
        var wl = self.wlen;
        var n = self.nx * self.ny * self.nz;
        var dx: f64 = self.dx;
        var dx2: f64 = dx * dx;
        var vol: f64 = dx2 * dx;
        var ex: *f64 = _bj_fd2_f64p(self.ex);
        var ey: *f64 = _bj_fd2_f64p(self.ey);
        var ez: *f64 = _bj_fd2_f64p(self.ez);
        var hx: *f64 = _bj_fd2_f64p(self.hx);
        var hy: *f64 = _bj_fd2_f64p(self.hy);
        var hz: *f64 = _bj_fd2_f64p(self.hz);
        var eps: *f64 = _bj_fd2_f64p(self.permittivity);
        var mu: *f64 = _bj_fd2_f64p(self.permeability);
        var w1: *f64 = _bj_fd2_f64p(self.work);
        var w2: *f64 = _bj_fd2_f64p(self.work + wl * 8);
        var w3: *f64 = _bj_fd2_f64p(self.work + 2 * wl * 8);
        var e0: f64 = BJ_EPSILON_0;
        var m0: f64 = BJ_MU_0;
        var packed = n & (0 - 4);
        var chunk = wl & (0 - 4);
        var energy: f64 = 0.0;
        var r = 0;
        while (r < packed) {
            var m = packed - r;
            if (m > chunk) { m = chunk; }
            f64v_mul(w1, ex + r, ex + r, m);
            f64v_mul(w2, ey + r, ey + r, m);
            f64v_add(w1, w1, w2, m);
            f64v_mul(w2, ez + r, ez + r, m);
            f64v_add(w1, w1, w2, m);
            f64v_scale(w2, eps + r, 0.5, m);
            f64v_scale(w2, w2, e0, m);
            f64v_mul(w1, w2, w1, m);
            f64v_mul(w2, hx + r, hx + r, m);
            f64v_mul(w3, hy + r, hy + r, m);
            f64v_add(w2, w2, w3, m);
            f64v_mul(w3, hz + r, hz + r, m);
            f64v_add(w2, w2, w3, m);
            f64v_scale(w3, mu + r, 0.5, m);
            f64v_scale(w3, w3, m0, m);
            f64v_mul(w2, w3, w2, m);
            f64v_add(w1, w1, w2, m);
            for (var j = 0; j < m; j = j + 1) { energy = energy + w1[j]; }
            r = r + m;
        }
        for (var i = packed; i < n; i = i + 1) {
            var a: f64 = ex[i];
            var b: f64 = ey[i];
            var c: f64 = ez[i];
            var e_sq: f64 = a * a + b * b + c * c;
            var p: f64 = hx[i];
            var q: f64 = hy[i];
            var t: f64 = hz[i];
            var h_sq: f64 = p * p + q * q + t * t;
            var ke: f64 = 0.5 * eps[i];
            var ke0: f64 = ke * e0;
            var te: f64 = ke0 * e_sq;
            var kh: f64 = 0.5 * mu[i];
            var kh0: f64 = kh * m0;
            var th: f64 = kh0 * h_sq;
            var cell: f64 = te + th;
            energy = energy + cell;
        }
        var en: f64 = energy * vol;
        return en;
    }
}

# --- compute.cyr ---

# compute.cyr — compute.rs's generic compute backend (M6 Part 3): the BjComputeBackend trait, the CPU reference
# backend BjCpuBackend, the backend-agnostic 2D TM solver BjGpuFdtd2d<B> and the BjWgpuBackend scaffold.
#
# A backend owns field buffers and runs the FDTD stencils on them. Rust's trait has an associated `Buffer` type; here a
# buffer is an opaque word each backend defines (BjCpuBackend's is the address of a block holding its length, then
# its values). Host slices are a pointer and a length. Cyrius has no Drop, so the trait adds `free_buffer`, which gives
# a buffer back (BjGpuFdtd2d_free calls it for every buffer it made). Fields are 2D, row-major (index y·nx + x), in
# src/fdtd2d.cyr's TM Yee layout: E_z at (x, y), H_x at (x, y + ½), H_y at (x + ½, y). A refused request returns an
# error value; nothing aborts.
#
# Cyrius refuses a generic impl header (`impl<B> T<B>`, cyrius 6.7.17; probe p20), so BjGpuFdtd2d<B>'s methods are
# generic functions over a `*BjGpuFdtd2d<B>`: `BjGpuFdtd2d_step_once(&sim)` is Rust's `sim.step_once()`, the backend
# inferred from the grid's type. The grid holds its backend by value, as Rust's (`backend: B`). With BjCpuBackend
# its arithmetic is src/fdtd2d.cyr's TM update (the same row kernels, the same order), so its fields are BjFdtd2d's
# bit for bit. The file is time-domain only; bijli's one harmonic convention, e^{+jωt}, is stated in src/complex.cyr's
# header.

private

# std::f64::consts::PI and SQRT_2.
var _BJ_CB_PI: f64 = 3.141592653589793;
var _BJ_CB_SQRT_2: f64 = 1.4142135623730951;
# The kernels' stack scratch: rows are run in chunks of this many cells.
var _BJ_CB_CHUNK = 256;
# The largest buffer length whose block (8 bytes a value and a header) a 64-bit length holds.
var _BJ_CB_MAX_LEN = 1152921504606846974;

# A compute backend (CPU or GPU) that holds FDTD field buffers and runs the TM stencils on them. A buffer is an opaque
# word the backend defines; a host array is a pointer and its length n. Every fallible member returns Ok or an error
# value, never aborts. Mirrors `ComputeBackend`.
public trait BjComputeBackend {
    # A new buffer holding the n values at data: Ok(the buffer). Mirrors `ComputeBackend::create_buffer`.
    fn create_buffer(self, data: *f64, n): Result;
    # Copies the buffer's values to the n f64 at dst (n must be the buffer's length): Ok(0). Mirrors
    # `ComputeBackend::read_buffer`.
    fn read_buffer(self, buffer, dst: *f64, n): Result;
    # Copies the n f64 at src into the buffer (n must be its length): Ok(0). Mirrors `ComputeBackend::write_buffer`.
    fn write_buffer(self, buffer, src: *f64, n): Result;
    # The TM H update from E_z for one in-plane component: axis 0, H_x[x, y] −= coeff[x, y]·(E[x, y + 1] − E[x, y]) for
    # y < ny − 1; axis 1, H_y[x, y] += coeff[x, y]·(E[x + 1, y] − E[x, y]) for x < nx − 1; any other axis an error.
    # Mirrors `ComputeBackend::fdtd_update_h`.
    fn fdtd_update_h(self, h, e, coeff, nx, ny, axis): Result;
    # The E update from curl H on the interior nodes: E[x, y] += coeff·((Hy[x, y] − Hy[x − 1, y]) − (Hx[x, y] −
    # Hx[x, y − 1])). Mirrors `ComputeBackend::fdtd_update_e`.
    fn fdtd_update_e(self, e, hx, hy, coeff, nx, ny): Result;
    # Zeroes the outermost ring of an nx × ny field. Mirrors `ComputeBackend::apply_zero_boundary`.
    fn apply_zero_boundary(self, field, nx, ny): Result;
    # Waits for every queued operation. Mirrors `ComputeBackend::synchronize`.
    fn synchronize(self): Result;
    # Gives a buffer back (Rust drops it; Cyrius has no Drop). A second call on the same buffer is the caller's error.
    fn free_buffer(self, buffer): i64;
    # Adds value to element index of the buffer (a point source). scratch is host memory of the buffer's length n; this
    # default round-trips the whole buffer through it (read, modify, write), and a backend that can update one element
    # in place overrides it. Ok(0), or Err(InvalidParameter) "element index {index} out of range for buffer of {n}",
    # or a transfer's error. Mirrors `ComputeBackend::add_to_element`.
    fn add_to_element(self, buffer, index, value: f64, scratch: *f64, n): Result {
        var t, v = self.read_buffer(buffer, scratch, n);
        if (is_err_result(t) == 1) { return Err(v); }
        if (_bj_fd2_uge(index, n) == 1) {
            var r = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(r, "element index ");
            _bj_tx_u64(r, index);
            _bj_tx_cstr(r, " out of range for buffer of ");
            _bj_tx_u64(r, n);
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        scratch[index] = scratch[index] + value;
        return self.write_buffer(buffer, scratch, n);
    }
}

# backend.add_to_element(..) from any file: the trait's default, instantiated for a backend of another file, is private
# to this one (cyrius 6.7.18, probe p20; to file upstream), so a backend defined elsewhere that inherits it reaches it
# here. Public for tests/compute.tcyr and for consumers' backends.
#must_use
public fn _bj_compute_add_to_element<B: BjComputeBackend>(backend: *B, buffer, index, value: f64,
  scratch: *f64, n): Result {
    return backend.add_to_element(buffer, index, value, scratch, n);
}

# A CPU buffer's values (after its length word).
#must_use
fn _bj_cb_data(buffer): *f64 {
    return buffer + 8;
}

# Records InvalidParameter "invalid grid dimensions {nx}x{ny}" (nx·ny zero or past 2^64) or "buffer length {len} does
# not match grid {nx}x{ny} = {n}" for the first of the k CPU buffers at bufs whose length isn't nx·ny, and returns its
# code; 0 when all match. Mirrors compute.rs's `check_grid`.
fn _bj_cb_check(nx, ny, bufs: *i64, k): i64 {
    var cells: i64[1];
    if (_bj_fd2_umul(nx, ny, &cells) == 0 || cells[0] == 0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "invalid grid dimensions ");
        _bj_tx_u64(t, nx);
        _bj_tx_cstr(t, "x");
        _bj_tx_u64(t, ny);
        return BJ_ERR_INVALID_PARAMETER;
    }
    var n = cells[0];
    for (var j = 0; j < k; j = j + 1) {
        var len = load64(bufs[j]);
        if (len != n) {
            var t2 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(t2, "buffer length ");
            _bj_tx_u64(t2, len);
            _bj_tx_cstr(t2, " does not match grid ");
            _bj_tx_u64(t2, nx);
            _bj_tx_cstr(t2, "x");
            _bj_tx_u64(t2, ny);
            _bj_tx_cstr(t2, " = ");
            _bj_tx_u64(t2, n);
            return BJ_ERR_INVALID_PARAMETER;
        }
    }
    return 0;
}

# Records InvalidParameter "host slice length {host_len} does not match buffer length {buffer_len}" and returns its
# code when the two differ; else 0. Mirrors compute.rs's `check_transfer`.
fn _bj_cb_transfer(buffer_len, host_len): i64 {
    if (buffer_len == host_len) { return 0; }
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, "host slice length ");
    _bj_tx_u64(t, host_len);
    _bj_tx_cstr(t, " does not match buffer length ");
    _bj_tx_u64(t, buffer_len);
    return BJ_ERR_INVALID_PARAMETER;
}

# d ± k·(a − b) over n cells (add 1: +=, 0: −=), src/fdtd2d.cyr's packed row kernel in chunks through a stack scratch.
fn _bj_cb_diff(d: *f64, k: *f64, a: *f64, b: *f64, n, add) {
    var w: f64[256];
    for (var s = 0; s < n; s = s + _BJ_CB_CHUNK) {
        var m = n - s;
        if (m > _BJ_CB_CHUNK) { m = _BJ_CB_CHUNK; }
        _bj_fd2_diff(d + s, k + s, a + s, b + s, &w, m, add);
    }
    return 0;
}

# One row's interior curl update, x ∈ 1..n − 1: d[x] += k[x]·((a[x] − a[x − 1]) − (b[x] − bp[x])), src/fdtd2d.cyr's
# packed kernel on chunks of the interior (each chunk with the cell before it) through stack scratch rows.
fn _bj_cb_curl(d: *f64, k: *f64, a: *f64, b: *f64, bp: *f64, n) {
    var w: f64[256];
    var w2: f64[256];
    for (var s = 1; s < n - 1; s = s + _BJ_CB_CHUNK) {
        var e = s + _BJ_CB_CHUNK;
        if (e > n - 1) { e = n - 1; }
        var o = s - 1;
        _bj_fd2_curl(d + o, k + o, a + o, b + o, bp + o, &w, &w2, e - s + 2, 1);
    }
    return 0;
}

# The CPU reference backend: a buffer is the address of an anonymous mapping holding its length, then its values.
# Suitable for testing, small grids and machines without a GPU. Mirrors `CpuBackend`.
public struct BjCpuBackend { }

impl BjComputeBackend for BjCpuBackend {
    # A new buffer holding the n values at data: Ok(it), or Err(BJ_ERR_ALLOCATION) "a compute buffer of {n} values"
    # when its mapping can't be had, where Rust's `to_vec` aborts (ADR 0002 row 9). Mirrors `CpuBackend::create_buffer`.
    public fn create_buffer(self, data: *f64, n): Result {
        var map = 0;
        if (n >= 0 && n <= _BJ_CB_MAX_LEN) { map = mmap_anon((n + 1) * 8); }
        if (map == 0) {
            var t = _bj_err_reason(BJ_ERR_ALLOCATION);
            _bj_tx_cstr(t, "a compute buffer of ");
            _bj_tx_u64(t, n);
            _bj_tx_cstr(t, " values");
            return Err(BJ_ERR_ALLOCATION);
        }
        store64(map, n);
        if (n > 0) { memcpy(map + 8, data, n * 8); }
        return Ok(map);
    }

    # Copies the buffer's values to dst: Ok(0), or Err(InvalidParameter) "host slice length {n} does not match buffer
    # length {len}" with dst untouched. Mirrors `CpuBackend::read_buffer`.
    public fn read_buffer(self, buffer, dst: *f64, n): Result {
        var e = _bj_cb_transfer(load64(buffer), n);
        if (e != 0) { return Err(e); }
        if (n > 0) { memcpy(dst, buffer + 8, n * 8); }
        return Ok(0);
    }

    # Copies src into the buffer: Ok(0), or Err(InvalidParameter) as read_buffer with the buffer untouched. Mirrors
    # `CpuBackend::write_buffer`.
    public fn write_buffer(self, buffer, src: *f64, n): Result {
        var e = _bj_cb_transfer(load64(buffer), n);
        if (e != 0) { return Err(e); }
        if (n > 0) { memcpy(buffer + 8, src, n * 8); }
        return Ok(0);
    }

    # The H update (the trait's comment): Ok(0), or Err(InvalidParameter) "axis must be 0 or 1, got {axis}" first, then
    # check_grid's records, with nothing written. Mirrors `CpuBackend::fdtd_update_h`.
    public fn fdtd_update_h(self, h, e, coeff, nx, ny, axis): Result {
        if (axis != 0 && axis != 1) {
            var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(t, "axis must be 0 or 1, got ");
            _bj_tx_i64(t, axis);
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        var bufs: i64[3];
        bufs[0] = h;
        bufs[1] = e;
        bufs[2] = coeff;
        var c = _bj_cb_check(nx, ny, &bufs, 3);
        if (c != 0) { return Err(c); }
        var hp: *f64 = _bj_cb_data(h);
        var ep: *f64 = _bj_cb_data(e);
        var kp: *f64 = _bj_cb_data(coeff);
        if (axis == 0) {
            for (var y = 0; y < ny - 1; y = y + 1) {
                var r = y * nx;
                _bj_cb_diff(hp + r, kp + r, ep + r + nx, ep + r, nx, 0);
            }
        } else {
            for (var y2 = 0; y2 < ny; y2 = y2 + 1) {
                var r2 = y2 * nx;
                _bj_cb_diff(hp + r2, kp + r2, ep + r2 + 1, ep + r2, nx - 1, 1);
            }
        }
        return Ok(0);
    }

    # The E update (the trait's comment): Ok(0), or check_grid's records with nothing written. Mirrors
    # `CpuBackend::fdtd_update_e`.
    public fn fdtd_update_e(self, e, hx, hy, coeff, nx, ny): Result {
        var bufs: i64[4];
        bufs[0] = e;
        bufs[1] = hx;
        bufs[2] = hy;
        bufs[3] = coeff;
        var c = _bj_cb_check(nx, ny, &bufs, 4);
        if (c != 0) { return Err(c); }
        var ep: *f64 = _bj_cb_data(e);
        var xp: *f64 = _bj_cb_data(hx);
        var yp: *f64 = _bj_cb_data(hy);
        var kp: *f64 = _bj_cb_data(coeff);
        for (var y = 1; y < ny - 1; y = y + 1) {
            var r = y * nx;
            _bj_cb_curl(ep + r, kp + r, yp + r, xp + r, xp + r - nx, nx);
        }
        return Ok(0);
    }

    # Zeroes the outermost ring: Ok(0), or check_grid's records. Mirrors `CpuBackend::apply_zero_boundary`.
    public fn apply_zero_boundary(self, field, nx, ny): Result {
        var bufs: i64[1];
        bufs[0] = field;
        var c = _bj_cb_check(nx, ny, &bufs, 1);
        if (c != 0) { return Err(c); }
        _bj_fd2_walls(_bj_cb_data(field), nx, ny);
        return Ok(0);
    }

    # Ok(0): the CPU is synchronous. Mirrors `CpuBackend::synchronize`.
    public fn synchronize(self): Result {
        return Ok(0);
    }

    # Gives the buffer's mapping back.
    public fn free_buffer(self, buffer): i64 {
        if (buffer != 0) { cyr_munmap(buffer, (load64(buffer) + 1) * 8); }
        return 0;
    }

    # Adds value to element index in place (scratch unused): Ok(0), or Err(InvalidParameter) "element index {index} out
    # of range for buffer of {len}". Mirrors `CpuBackend::add_to_element`.
    public fn add_to_element(self, buffer, index, value: f64, scratch: *f64, n): Result {
        var len = load64(buffer);
        if (_bj_fd2_uge(index, len) == 1) {
            var r = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(r, "element index ");
            _bj_tx_u64(r, index);
            _bj_tx_cstr(r, " out of range for buffer of ");
            _bj_tx_u64(r, len);
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        var p: *f64 = _bj_cb_data(buffer);
        p[index] = p[index] + value;
        return Ok(0);
    }
}

# A backend-agnostic 2D FDTD simulation, TM mode (E_z, H_x, H_y): BjFdtd2d's physics with the fields and the stencils
# delegated to `backend`. nx × ny are the nodes, `dx` (m) the spacing, `dt` (s) the step, `step` the time-step index.
# fz, fx, fy (E_z, H_x, H_y) and ce, ch (the E and H coefficients) are the backend's buffers; `scratch` is host memory
# of nx·ny f64 for add_to_element (mapped on first use; scratch_len its length, 0 before). Give it back with
# BjGpuFdtd2d_free. Mirrors `GpuFdtd2d`.
public struct BjGpuFdtd2d<B: BjComputeBackend> {
    backend: B;
    nx;
    ny;
    dx: f64;
    dt: f64;
    step;
    fz;
    fx;
    fy;
    ce;
    ch;
    scratch;
    scratch_len;
}

# A host block of n f64, each v: its address, or 0 with Allocation recorded ("the grid's host values").
fn _bj_cb_host(n, v: f64): i64 {
    var map = 0;
    if (n > 0 && n <= _BJ_CB_MAX_LEN) { map = mmap_anon(n * 8); }
    if (map == 0) {
        var t = _bj_err_reason(BJ_ERR_ALLOCATION);
        _bj_tx_cstr(t, "the grid's host values (");
        _bj_tx_u64(t, n);
        _bj_tx_cstr(t, ")");
        return 0;
    }
    var p: *f64 = _bj_fd2_f64p(map);
    if (v != 0.0) {
        for (var i = 0; i < n; i = i + 1) { p[i] = v; }
    }
    return map;
}

# A vacuum TM grid of nx × ny nodes at spacing dx on `backend` into *out (the backend copied in): Ok(0), or with out
# untouched Err(InsufficientResolution) when nx < 3 or ny < 3 (cells min(nx, ny), domain min·dx),
# Err(InvalidParameter) "dx must be finite and positive, got {dx}" or "grid {nx}x{ny} is too large", in Rust's order,
# or a buffer's creation error (the buffers made so far given back). dt = dx/(2√2·c), half the 2D Courant limit.
# Mirrors `GpuFdtd2d::new`.
#must_use
public fn BjGpuFdtd2d_new<B: BjComputeBackend>(nx, ny, dx: f64, backend: B, out: *BjGpuFdtd2d<B>): Result {
    if ((nx >= 0 && nx < 3) || (ny >= 0 && ny < 3)) {
        var mn = nx;
        if (_bj_fd2_uge(nx, ny) == 1) { mn = ny; }
        var mf: f64 = _bj_fd2_u2f(mn);
        var size: f64 = mf * dx;
        return Err(_bj_err_insufficient_resolution(mn, size));
    }
    if (_bj_fd2_pos(dx) == 0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "dx must be finite and positive, got ");
        _bj_fmt_f64_display(t, dx);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var cells: i64[1];
    if (_bj_fd2_umul(nx, ny, &cells) == 0) {
        var tg = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(tg, "grid ");
        _bj_tx_u64(tg, nx);
        _bj_tx_cstr(tg, "x");
        _bj_tx_u64(tg, ny);
        _bj_tx_cstr(tg, " is too large");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var n = cells[0];
    var c: f64 = BJ_SPEED_OF_LIGHT;
    var r2: f64 = 2.0 * _BJ_CB_SQRT_2;
    var r2c: f64 = r2 * c;
    var dt: f64 = dx / r2c;
    var e0dx: f64 = BJ_EPSILON_0 * dx;
    var ce: f64 = dt / e0dx;
    var m0dx: f64 = BJ_MU_0 * dx;
    var ch: f64 = dt / m0dx;
    var zeros = _bj_cb_host(n, 0.0);
    if (zeros == 0) { return Err(BJ_ERR_ALLOCATION); }
    var vals = _bj_cb_host(n, ce);
    if (vals == 0) {
        cyr_munmap(zeros, n * 8);
        return Err(BJ_ERR_ALLOCATION);
    }
    var bufs: i64[5];
    var made = 0;
    var code = 0;
    out.backend = backend;
    while (made < 5 && code == 0) {
        var src = zeros;
        if (made == 3) { src = vals; }
        if (made == 4) {
            var vp: *f64 = _bj_fd2_f64p(vals);
            for (var i = 0; i < n; i = i + 1) { vp[i] = ch; }
        }
        if (made == 4) { src = vals; }
        var tb, vb = out.backend.create_buffer(src, n);
        if (is_err_result(tb) == 1) { code = vb; }
        else {
            bufs[made] = vb;
            made = made + 1;
        }
    }
    cyr_munmap(zeros, n * 8);
    cyr_munmap(vals, n * 8);
    if (code != 0) {
        for (var j = 0; j < made; j = j + 1) { out.backend.free_buffer(bufs[j]); }
        return Err(code);
    }
    out.nx = nx;
    out.ny = ny;
    out.dx = dx;
    out.dt = dt;
    out.step = 0;
    out.fz = bufs[0];
    out.fx = bufs[1];
    out.fy = bufs[2];
    out.ce = bufs[3];
    out.ch = bufs[4];
    out.scratch = 0;
    out.scratch_len = 0;
    if (_bj_log_on(4) == 1) {
        var lb[256];
        var lt[24];
        _bj_tx_init(&lt, &lb, 256);
        _bj_tx_cstr(&lt, "GpuFdtd2d created nx=");
        _bj_tx_u64(&lt, nx);
        _bj_tx_cstr(&lt, " ny=");
        _bj_tx_u64(&lt, ny);
        _bj_tx_cstr(&lt, " dx=");
        _bj_fmt_f64_debug(&lt, dx);
        _bj_tx_cstr(&lt, " dt=");
        _bj_fmt_f64_debug(&lt, dt);
        _bj_log_text(4, &lt);
    }
    return Ok(0);
}

# Gives the grid's five buffers back through its backend, and its host scratch; empties it (nx = ny = 0, every handle
# 0). A second call does nothing.
public fn BjGpuFdtd2d_free<B: BjComputeBackend>(sim: *BjGpuFdtd2d<B>): i64 {
    if (sim.fz != 0) { sim.backend.free_buffer(sim.fz); }
    if (sim.fx != 0) { sim.backend.free_buffer(sim.fx); }
    if (sim.fy != 0) { sim.backend.free_buffer(sim.fy); }
    if (sim.ce != 0) { sim.backend.free_buffer(sim.ce); }
    if (sim.ch != 0) { sim.backend.free_buffer(sim.ch); }
    if (sim.scratch_len > 0) { cyr_munmap(sim.scratch, sim.scratch_len * 8); }
    sim.fz = 0;
    sim.fx = 0;
    sim.fy = 0;
    sim.ce = 0;
    sim.ch = 0;
    sim.scratch = 0;
    sim.scratch_len = 0;
    sim.nx = 0;
    sim.ny = 0;
    return 0;
}

# Advances one TM time step through the backend: H_x and H_y from E_z, E_z from curl H, the zero boundary. Ok(0), or
# the first kernel's error (the step not counted). Mirrors `GpuFdtd2d::step_once`.
public fn BjGpuFdtd2d_step_once<B: BjComputeBackend>(sim: *BjGpuFdtd2d<B>): Result {
    var nx = sim.nx;
    var ny = sim.ny;
    if (_bj_log_on(5) == 1) {
        var lb[96];
        var lt[24];
        _bj_tx_init(&lt, &lb, 96);
        _bj_tx_cstr(&lt, "GpuFdtd2d step step=");
        _bj_tx_u64(&lt, sim.step);
        _bj_log_text(5, &lt);
    }
    var t1, v1 = sim.backend.fdtd_update_h(sim.fx, sim.fz, sim.ch, nx, ny, 0);
    if (is_err_result(t1) == 1) { return Err(v1); }
    var t2, v2 = sim.backend.fdtd_update_h(sim.fy, sim.fz, sim.ch, nx, ny, 1);
    if (is_err_result(t2) == 1) { return Err(v2); }
    var t3, v3 = sim.backend.fdtd_update_e(sim.fz, sim.fx, sim.fy, sim.ce, nx, ny);
    if (is_err_result(t3) == 1) { return Err(v3); }
    var t4, v4 = sim.backend.apply_zero_boundary(sim.fz, nx, ny);
    if (is_err_result(t4) == 1) { return Err(v4); }
    sim.step = sim.step + 1;
    return Ok(0);
}

# Adds value to E_z at node (x, y), a soft source; a node outside the grid is ignored (usize compares), as BjFdtd2d's
# add_source. The host scratch is mapped on first use. Ok(0), Err(BJ_ERR_ALLOCATION) when the scratch can't be had, or
# the backend's error. Mirrors `GpuFdtd2d::add_source`.
public fn BjGpuFdtd2d_add_source<B: BjComputeBackend>(sim: *BjGpuFdtd2d<B>, x, y, value: f64): Result {
    if (_bj_fd2_uge(x, sim.nx) == 1 || _bj_fd2_uge(y, sim.ny) == 1) { return Ok(0); }
    var n = sim.nx * sim.ny;
    if (sim.scratch_len != n) {
        var s = _bj_cb_host(n, 0.0);
        if (s == 0) { return Err(BJ_ERR_ALLOCATION); }
        if (sim.scratch_len > 0) { cyr_munmap(sim.scratch, sim.scratch_len * 8); }
        sim.scratch = s;
        sim.scratch_len = n;
    }
    return sim.backend.add_to_element(sim.fz, y * sim.nx + x, value, _bj_fd2_f64p(sim.scratch), n);
}

# Runs `steps` time steps (a usize). Before each, when (sx, sy) is in the grid, adds amplitude·sin(2π·frequency·t) to
# E_z there, t = step·dt; BJ_FDTD2D_NO_SOURCE for sx (or any node outside the grid) injects nothing, as Rust's None.
# Then synchronizes the backend. Ok(0), or the first error (the steps before it taken). Mirrors `GpuFdtd2d::run`.
public fn BjGpuFdtd2d_run<B: BjComputeBackend>(sim: *BjGpuFdtd2d<B>, steps, sx, sy, frequency: f64,
  amplitude: f64): Result {
    if (_bj_log_on(4) == 1) {
        var lb[256];
        var lt[24];
        _bj_tx_init(&lt, &lb, 256);
        _bj_tx_cstr(&lt, "GpuFdtd2d run started steps=");
        _bj_tx_u64(&lt, steps);
        _bj_tx_cstr(&lt, " source=");
        if (sx == BJ_FDTD2D_NO_SOURCE) {
            _bj_tx_cstr(&lt, "None");
        } else {
            _bj_tx_cstr(&lt, "Some((");
            _bj_tx_u64(&lt, sx);
            _bj_tx_cstr(&lt, ", ");
            _bj_tx_u64(&lt, sy);
            _bj_tx_cstr(&lt, "))");
        }
        _bj_tx_cstr(&lt, " frequency=");
        _bj_fmt_f64_debug(&lt, frequency);
        _bj_tx_cstr(&lt, " amplitude=");
        _bj_fmt_f64_debug(&lt, amplitude);
        _bj_log_text(4, &lt);
    }
    var w2pi: f64 = 2.0 * _BJ_CB_PI;
    var wf: f64 = w2pi * frequency;
    for (var k = 0; _bj_fd2_uge(k, steps) == 0; k = k + 1) {
        if (sx != BJ_FDTD2D_NO_SOURCE) {
            var sf: f64 = _bj_fd2_u2f(sim.step);
            var t: f64 = sf * sim.dt;
            var arg: f64 = wf * t;
            var sv: f64 = _bj_sin(arg);
            var value: f64 = amplitude * sv;
            var ta, va = BjGpuFdtd2d_add_source(sim, sx, sy, value);
            if (is_err_result(ta) == 1) { return Err(va); }
        }
        var ts, vs = BjGpuFdtd2d_step_once(sim);
        if (is_err_result(ts) == 1) { return Err(vs); }
    }
    return sim.backend.synchronize();
}

# The simulation time step·dt in seconds. Mirrors `GpuFdtd2d::time`.
#must_use
public fn BjGpuFdtd2d_time<B: BjComputeBackend>(sim: *BjGpuFdtd2d<B>): f64 {
    var sf: f64 = _bj_fd2_u2f(sim.step);
    var t: f64 = sf * sim.dt;
    return t;
}

# Reads E_z back to the n f64 at dst: Ok(0), or the backend's error (BjCpuBackend: InvalidParameter when n isn't
# nx·ny). Mirrors `GpuFdtd2d::read_ez`.
public fn BjGpuFdtd2d_read_ez<B: BjComputeBackend>(sim: *BjGpuFdtd2d<B>, dst: *f64, n): Result {
    return sim.backend.read_buffer(sim.fz, dst, n);
}

# Reads H_x back to the n f64 at dst, as read_ez. Mirrors `GpuFdtd2d::read_hx`.
public fn BjGpuFdtd2d_read_hx<B: BjComputeBackend>(sim: *BjGpuFdtd2d<B>, dst: *f64, n): Result {
    return sim.backend.read_buffer(sim.fx, dst, n);
}

# Reads H_y back to the n f64 at dst, as read_ez. Mirrors `GpuFdtd2d::read_hy`.
public fn BjGpuFdtd2d_read_hy<B: BjComputeBackend>(sim: *BjGpuFdtd2d<B>, dst: *f64, n): Result {
    return sim.backend.read_buffer(sim.fy, dst, n);
}

# **A scaffold, not functional yet**: the placeholder of a wgpu GPU backend. It does not implement BjComputeBackend
# and holds no device, queue or buffers, so it can't run a simulation; use BjCpuBackend. It exists so the API keeps
# its shape while a GPU backend is developed (plan §11: a mabda backend behind it, in a `[lib.gpu]` profile). Mirrors
# `WgpuBackend` (Rust's `compute-wgpu` feature; here it has no dependency to gate).
public struct BjWgpuBackend { }

# The placeholder backend into *out: no GPU initialization (no adapter or device is requested), so Ok(0) always;
# reserved for adapter and device failures once implemented. Mirrors `WgpuBackend::new`.
#must_use
public fn BjWgpuBackend_new(out: *BjWgpuBackend): Result {
    _bj_log(4, "WgpuBackend scaffold created (no GPU initialization performed)");
    return Ok(0);
}

# --- nf2ff.cyr ---

# nf2ff.cyr — fdtd.rs's 2D near-field to far-field transform: `nf2ff_2d_phasor` (M5 part 1e), Love's equivalence on a
# rectangular contour of a TM-mode Yee grid, from CW phasors, and `nf2ff_2d` (M6 part 1c), the same transform of one
# time snapshot of a BjFdtd2d, on the same core.
#
# The phasors are e^{+jωt}, bijli's one convention (src/complex.cyr's header), as the CW accumulator's are: fdtd.rs's
# NF2FF already was. The complex arithmetic is fdtd.rs's own `Cplx`, written out on f64 locals in Rust's order; sin_cos
# and hypot are correctly rounded (src/crmath.cyr).
#
# The range edges (ADR 0002 row 18, M5 part 2d-6). Rust's chain (the frequency ω/2π, k = 2π·frequency/c, the rotation
# e^{+jω·dt/2}, the contour's samples, each angle's sums and √(k/8π)·|η·N_z − L_φ|) differs from its value with an
# unbounded exponent (each operation to 53 bits, the last rounded once) only where an operation leaves the normal
# range. The port keeps Rust's chain wherever it is that value and runs the unbounded one elsewhere:
# - the scalars come from ω to 53 bits (the accumulator's omega_s, omega_e, ADR 0002 row 18's M5 part 2d-4a), which
#   the accumulators' agreement and the frequency's test also read. Where k, the rotation's parts, dx/2, the sides'
#   starts, k/8π and k·dx are doubles (normal, or an exact 0), the transform runs on Rust's chain, else wholly
#   unbounded;
# - a contour sample: each product normal, or 0 from a zero factor, or an underflow beside its sum's other product of
#   at least 2^-960 (which absorbs it in both chains: |x·y| < 2^-1022 is under a quarter of that product's ulp); each
#   sum finite. Else the transform runs wholly unbounded;
# - an angle: each side's ρ̂·ρ' products as a sample's, k·ρ̂·ρ' and k·dx·(d̂·ρ̂) normal or exact zeros; the step
#   e^{jk·dx·(d̂·ρ̂)} with both parts at least 2^-959 (or (1, ±0)), which keeps the rotation's recurrence Rust's, as the
#   DFT's (src/fdtd_util.cyr's _bj_fu_dft); a sample's eight products normal, decided once a sample by the rotation's
#   exponent fields against the samples' smallest (one test; |x·r| ≥ 2^(e_x + e_r − 2046) for biased fields e), and
#   where that fails by each product (an underflow its partner absorbs is kept); the sums finite; the tail's products
#   as a sample's, |η·N_z − L_φ| normal or 0 and finite (its product with √(k/8π) is the last operation). Else that
#   angle runs unbounded (_bj_nf_angle_ux).
# A non-finite field value on the contour keeps Rust's chain throughout, on the scalars rounded into binary64.

private

var _BJ_NF_INF: f64 = 0x7FF0000000000000;
# std::f64::consts::PI, and 10⁻¹² (the accumulators' agreement test).
var _BJ_NF_PI: f64 = 3.141592653589793;
var _BJ_NF_REL12: f64 = 0.000000000001;
# freelist's largest request, 2 GiB.
var _BJ_NF_FL_MAX = 2147483648;
# 2^-1022, and 2^-959 and 2^-960: the rotation step's and the sums' absorption bounds (M5 part 2d-6).
var _BJ_NF_DMIN: f64 = 0x0010000000000000;
var _BJ_NF_2M959: f64 = 0x0400000000000000;
var _BJ_NF_2M960: f64 = 0x03F0000000000000;

# A word as a *f64 (the typed return keeps the binding typed).
#must_use
fn _bj_nf_f64p(a): *f64 {
    return a;
}

# A word as a *i64.
#must_use
fn _bj_nf_i64p(a): *i64 {
    return a;
}

# 1 when the product (or quotient) p of x and y is its 53-bit value: normal, or 0 from a zero operand.
#must_use
fn _bj_nf_kept(p: f64, x: f64, y: f64): i64 {
    var a: f64 = f64_abs(p);
    if (a >= _BJ_NF_DMIN && a < _BJ_NF_INF) { return 1; }
    if (p == 0.0 && (x == 0.0 || y == 0.0)) { return 1; }
    return 0;
}

# _bj_nf_kept, or p an underflow (a nonzero subnormal, or 0 from nonzero factors) beside its sum's other term o with
# |o| ≥ 2^-960, which absorbs it in Rust's chain and the unbounded one alike (the section comment).
#must_use
fn _bj_nf_kept2(p: f64, x: f64, y: f64, o: f64): i64 {
    if (_bj_nf_kept(p, x, y) == 1) { return 1; }
    var a: f64 = f64_abs(p);
    if (!(a < _BJ_NF_DMIN)) { return 0; }
    var b: f64 = f64_abs(o);
    if (b >= _BJ_NF_2M960) { return 1; }
    return 0;
}

# 1 when x is finite.
#must_use
fn _bj_nf_fin(x: f64): i64 {
    var z: f64 = x * 0.0;
    if (z == 0.0) { return 1; }
    return 0;
}

# 1 when the 53-bit x = s·2^e (finite) is a double: 0, or normal.
#must_use
fn _bj_nf_dbl(s: f64, e): i64 {
    if (s == 0.0) { return 1; }
    if (e < 0 - 1022 || e > 1023) { return 0; }
    return 1;
}

# 1 when the rotation step (c, s) = e^{jθ} keeps Rust's recurrence its 53-bit value: |c| and |s| at least 2^-959, or
# (1, ±0) (the section comment; src/fdtd_util.cyr's _bj_fu_dft has the argument).
#must_use
fn _bj_nf_step_ok(c: f64, s: f64): i64 {
    var ac: f64 = f64_abs(c);
    var an: f64 = f64_abs(s);
    if (ac >= _BJ_NF_2M959 && an >= _BJ_NF_2M959) { return 1; }
    if (c == 1.0 && s == 0.0) { return 1; }
    return 0;
}

# 1 when x is finite and strictly positive (NaN-safe). Mirrors fdtd.rs's `is_positive_finite`.
#must_use
fn _bj_nf_pos(x: f64): i64 {
    if (x > 0.0 && x < _BJ_NF_INF) { return 1; }
    return 0;
}

# 1 when a ≥ b as usize words (a negative word is past 2^63).
#must_use
fn _bj_nf_uge(a, b): i64 {
    if ((a < 0) == (b < 0)) {
        if (a >= b) { return 1; }
        return 0;
    }
    if (a < 0) { return 1; }
    return 0;
}

# The usize product a·b into *out: 1, or 0 when it overflows 64 bits (Rust's `checked_mul` None).
fn _bj_nf_umul(a, b, out: *i64): i64 {
    var ah = a >> 32;
    var al = a & 0xFFFFFFFF;
    var bh = b >> 32;
    var bl = b & 0xFFFFFFFF;
    if (ah != 0 && bh != 0) { return 0; }
    var cross = ah * bl + al * bh;
    if ((cross >> 32) != 0) { return 0; }
    var lo = al * bl;
    var hi = cross << 32;
    var s = lo + hi;
    if (_bj_nf_uge(s, lo) == 0) { return 0; }
    out[0] = s;
    return 1;
}

# Rust's `n as f64` for a usize: the word read unsigned, rounded to nearest even.
#must_use
fn _bj_nf_u2f(n): f64 {
    if (n >= 0) {
        var r: f64 = f64_from(n);
        return r;
    }
    var h: f64 = f64_from((n >> 1) | (n & 1));
    var r2: f64 = h * 2.0;
    return r2;
}

# A far-field pattern: `count` observation angles φ (radians, 0 to 2π from +x towards +y) at `angles`, and the pattern
# lim_{ρ→∞} √ρ·|E_z(ρ, φ)| (≥ 0; V·m^{−½} for phasors in V/m, linear in the inputs) at `pattern`, in one freelist
# block (0 when count is 0). Give it back with BjNf2ffResult_free. Mirrors `Nf2ffResult`.
public struct BjNf2ffResult {
    pattern;
    angles;
    count;
}

# Gives a result's block back and empties it; a second call does nothing.
public fn BjNf2ffResult_free(r: *BjNf2ffResult): i64 {
    if (r.pattern != 0) { fl_free(r.pattern); }
    r.pattern = 0;
    r.angles = 0;
    r.count = 0;
    return 0;
}

# Records InvalidParameter with a fixed reason; returns its code.
fn _bj_nf_bad(reason): i64 {
    _bj_tx_cstr(_bj_err_reason(BJ_ERR_INVALID_PARAMETER), reason);
    return BJ_ERR_INVALID_PARAMETER;
}

# The shared parameter checks, in Rust's order (n_angles, the margin, dx, the frequency): 0 with k = 2πf/c to 53 bits
# with an unbounded exponent in ks[0]·2^ke[0], or the error recorded and its code. The frequency is tested on its
# 53-bit value f = fs·2^fe (ADR 0002 row 18, M5 part 2d-6: past DBL_MAX where ω was) and printed as Rust's double
# `frequency`. Mirrors fdtd.rs's `nf2ff_validate`.
fn _bj_nf_validate(nx, ny, dx: f64, frequency: f64, fs: f64, fe, box_margin, n_angles, ks: *f64, ke: *i64): i64 {
    if (n_angles == 0) { return _bj_nf_bad("need at least one observation angle"); }
    if (box_margin == 0 || _bj_nf_uge(box_margin, nx >> 1) == 1 || _bj_nf_uge(box_margin, ny >> 1) == 1) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "NF2FF box margin must be in 1..min(nx, ny)/2 for a ");
        _bj_tx_u64(t, nx);
        _bj_tx_cstr(t, "x");
        _bj_tx_u64(t, ny);
        _bj_tx_cstr(t, " grid, got ");
        _bj_tx_u64(t, box_margin);
        return BJ_ERR_INVALID_PARAMETER;
    }
    if (_bj_nf_pos(dx) == 0) {
        var t2 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t2, "dx must be finite and positive, got ");
        _bj_fmt_f64_display(t2, dx);
        return BJ_ERR_INVALID_PARAMETER;
    }
    if (_bj_k_ux_is_positive(fs, fe) == 0) {
        var t3 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t3, "NF2FF frequency must be finite and positive, got ");
        _bj_fmt_f64_display(t3, frequency);
        return BJ_ERR_INVALID_PARAMETER;
    }
    var w: f64 = 2.0 * _BJ_NF_PI;
    var ws, we = _bj_k_ux_from(w);
    var wfs, wfe = _bj_k_ux_mul(ws, we, fs, fe);
    var cs, ce = _bj_k_ux_from(BJ_SPEED_OF_LIGHT);
    var qs, qe = _bj_k_ux_div(wfs, wfe, cs, ce);
    ks[0] = qs;
    ke[0] = qe;
    return 0;
}

# 0 when a field of len samples covers the nx·ny grid, else InvalidParameter "NF2FF field `{name}` has {len} samples,
# need {nx}x{ny}" recorded and its code (also when nx·ny overflows). Mirrors fdtd.rs's `nf2ff_check_len`.
fn _bj_nf_check_len(name, len, nx, ny): i64 {
    var n: i64[1];
    if (_bj_nf_umul(nx, ny, &n) == 1 && _bj_nf_uge(len, n[0]) == 1) { return 0; }
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, "NF2FF field `");
    _bj_tx_cstr(t, name);
    _bj_tx_cstr(t, "` has ");
    _bj_tx_u64(t, len);
    _bj_tx_cstr(t, " samples, need ");
    _bj_tx_u64(t, nx);
    _bj_tx_cstr(t, "x");
    _bj_tx_u64(t, ny);
    return BJ_ERR_INVALID_PARAMETER;
}

# The phasor at index i of a field held as real parts at re and imaginary parts at im (0: all zero, a snapshot).
fn _bj_nf_at(re, im, i): (f64, f64) {
    var rp: *f64 = _bj_nf_f64p(re);
    var r: f64 = rp[i];
    var q: f64 = 0.0;
    if (im != 0) {
        var ip: *f64 = _bj_nf_f64p(im);
        q = ip[i];
    }
    return (r, q);
}

# One contour sample's weighted currents into s[0..4]: J_z = (h_t·rot)·(sign·w) with h_t = (a + b)·½, then the side's
# magnetic current, the E sample e·(sign·w) (M_x on a horizontal side, M_y on a vertical one). Rust's `Cplx` add, scale
# and mul in order. Rust also keeps the other component, zero, and multiplies it by the phasor; that product is ±0 (or
# NaN only where the phasor is NaN, when N_z is NaN as well), so it can't reach the pattern, |η·N_z − L_φ|, and the
# core skips it. 0 when every operation is its 53-bit value (the section comment), 1 where one isn't, 2 for a
# non-finite field value.
fn _bj_nf_sample(s: *f64, ar: f64, ai: f64, br: f64, bi: f64, er: f64, ei: f64, rot_r: f64, rot_i: f64, sw: f64): i64 {
    var sr: f64 = ar + br;
    var si: f64 = ai + bi;
    var hr: f64 = sr * 0.5;
    var hi: f64 = si * 0.5;
    var p1: f64 = hr * rot_r;
    var p2: f64 = hi * rot_i;
    var jr: f64 = p1 - p2;
    var p3: f64 = hr * rot_i;
    var p4: f64 = hi * rot_r;
    var ji: f64 = p3 + p4;
    var s0: f64 = jr * sw;
    var s1: f64 = ji * sw;
    var s2: f64 = er * sw;
    var s3: f64 = ei * sw;
    s[0] = s0;
    s[1] = s1;
    s[2] = s2;
    s[3] = s3;
    var z: f64 = ar * 0.0 + ai * 0.0 + br * 0.0 + bi * 0.0 + er * 0.0 + ei * 0.0;
    if (z != 0.0) { return 2; }
    if (_bj_nf_kept(hr, sr, 0.5) == 0 || _bj_nf_kept(hi, si, 0.5) == 0) { return 1; }
    if (_bj_nf_kept2(p1, hr, rot_r, p2) == 0 || _bj_nf_kept2(p2, hi, rot_i, p1) == 0) { return 1; }
    if (_bj_nf_kept2(p3, hr, rot_i, p4) == 0 || _bj_nf_kept2(p4, hi, rot_r, p3) == 0) { return 1; }
    if (_bj_nf_fin(jr) == 0 || _bj_nf_fin(ji) == 0) { return 1; }
    if (_bj_nf_kept(s0, jr, sw) == 0 || _bj_nf_kept(s1, ji, sw) == 0) { return 1; }
    if (_bj_nf_kept(s2, er, sw) == 0 || _bj_nf_kept(s3, ei, sw) == 0) { return 1; }
    return 0;
}

# _bj_nf_sample with an unbounded exponent (the section comment's slow path): J_z's then M's real and imaginary parts
# as s·2^e, the four significands into the 32 bytes at ps and the four exponents into those at pe, each operation to
# 53 bits. u and ue hold H's rotation (cos at 0, sin at 1) and the weight sign·w (at 4).
fn _bj_nf_sample_ux(ps, pe, ar: f64, ai: f64, br: f64, bi: f64, er: f64, ei: f64, u: *f64, ue: *i64) {
    var xs: *f64 = _bj_nf_f64p(ps);
    var xe: *i64 = _bj_nf_i64p(pe);
    var ars, are = _bj_k_ux_from(ar);
    var brs, bre = _bj_k_ux_from(br);
    var srs, sre = _bj_k_ux_add(ars, are, brs, bre);
    var hrs, hre = _bj_k_ux_mul(srs, sre, 1.0, 0 - 1);
    var ais, aie = _bj_k_ux_from(ai);
    var bis, bie = _bj_k_ux_from(bi);
    var sis, sie = _bj_k_ux_add(ais, aie, bis, bie);
    var his, hie = _bj_k_ux_mul(sis, sie, 1.0, 0 - 1);
    var p1s, p1e = _bj_k_ux_mul(hrs, hre, u[0], ue[0]);
    var p2s, p2e = _bj_k_ux_mul(his, hie, u[1], ue[1]);
    var jrs, jre = _bj_k_ux_sub(p1s, p1e, p2s, p2e);
    var p3s, p3e = _bj_k_ux_mul(hrs, hre, u[1], ue[1]);
    var p4s, p4e = _bj_k_ux_mul(his, hie, u[0], ue[0]);
    var jis, jie = _bj_k_ux_add(p3s, p3e, p4s, p4e);
    var o0s, o0e = _bj_k_ux_mul(jrs, jre, u[4], ue[4]);
    var o1s, o1e = _bj_k_ux_mul(jis, jie, u[4], ue[4]);
    var ers, ere = _bj_k_ux_from(er);
    var o2s, o2e = _bj_k_ux_mul(ers, ere, u[4], ue[4]);
    var eis, eie = _bj_k_ux_from(ei);
    var o3s, o3e = _bj_k_ux_mul(eis, eie, u[4], ue[4]);
    xs[0] = o0s;
    xe[0] = o0e;
    xs[1] = o1s;
    xe[1] = o1e;
    xs[2] = o2s;
    xe[2] = o2e;
    xs[3] = o3s;
    xe[3] = o3e;
    return 0;
}

# The contour's samples in the order the sides run (bottom y₀ and top y₁ along +x, left x₀ and right x₁ along +y; the
# signs +1, −1, −1, +1): as doubles into sb (32 bytes each, by _bj_nf_sample; the result is the worst status, 0, 1
# or 2) when sms is 0, else with an unbounded exponent into sms and sme (32 bytes each, by _bj_nf_sample_ux; 0). The
# fields are
# re/im address pairs at f[0..6] (E_z, H_x, H_y; an im of 0 reads as zero); g holds x₀, x₁, y₀, y₁ and nx; d H's
# rotation (cos, sin), dx and dx/2 as Rust's doubles; u and ue the same with an unbounded exponent (u[4] is scratch).
fn _bj_nf_samples(f: *i64, g: *i64, d: *f64, u: *f64, ue: *i64, sb, sms, sme): i64 {
    var x0 = g[0];
    var x1 = g[1];
    var y0 = g[2];
    var y1 = g[3];
    var nx = g[4];
    var st = 0;
    var at = 0;
    for (var side = 0; side < 4; side = side + 1) {
        var vertical = 0;
        var line = y0;
        var sign: f64 = 1.0;
        if (side == 1) {
            line = y1;
            sign = -1.0;
        }
        if (side == 2) {
            vertical = 1;
            line = x0;
            sign = -1.0;
        }
        if (side == 3) {
            vertical = 1;
            line = x1;
        }
        var n = x1 - x0 + 1;
        if (vertical == 1) { n = y1 - y0 + 1; }
        var last = n - 1;
        for (var i = 0; i < n; i = i + 1) {
            var ia = 0;
            var ib = 0;
            var ha = f[2];
            var hai = f[3];
            if (vertical == 0) {
                ia = (line - 1) * nx + x0 + i;
                ib = line * nx + x0 + i;
            } else {
                ia = (y0 + i) * nx + line - 1;
                ib = (y0 + i) * nx + line;
                ha = f[4];
                hai = f[5];
            }
            var ar, ai = _bj_nf_at(ha, hai, ia);
            var br, bi = _bj_nf_at(ha, hai, ib);
            var er, ei = _bj_nf_at(f[0], f[1], ib);
            if (sms == 0) {
                var w: f64 = d[2];
                if (i == 0 || i == last) { w = d[3]; }
                var sw: f64 = sign * w;
                var r = _bj_nf_sample(_bj_nf_f64p(sb + (at + i) * 32), ar, ai, br, bi, er, ei, d[0], d[1], sw);
                if (r > st) { st = r; }
            } else {
                u[4] = u[2];
                ue[4] = ue[2];
                if (i == 0 || i == last) {
                    u[4] = u[3];
                    ue[4] = ue[3];
                }
                if (sign < 0.0) {
                    var nw: f64 = u[4];
                    u[4] = -nw;
                }
                _bj_nf_sample_ux(sms + (at + i) * 32, sme + (at + i) * 32, ar, ai, br, bi, er, ei, u, ue);
            }
        }
        at = at + n;
    }
    return st;
}

# 1 when one of a sample's eight products, J_z·rot and M·rot, leaves the normal range unabsorbed: not
# _bj_nf_kept2 against its partner in the same sum.
#must_use
fn _bj_nf_low8(jzr: f64, jzi: f64, mxr: f64, mxi: f64, rr: f64, ri: f64): i64 {
    var p1: f64 = jzr * rr;
    var p2: f64 = jzi * ri;
    if (_bj_nf_kept2(p1, jzr, rr, p2) == 0 || _bj_nf_kept2(p2, jzi, ri, p1) == 0) { return 1; }
    var p3: f64 = jzr * ri;
    var p4: f64 = jzi * rr;
    if (_bj_nf_kept2(p3, jzr, ri, p4) == 0 || _bj_nf_kept2(p4, jzi, rr, p3) == 0) { return 1; }
    var p5: f64 = mxr * rr;
    var p6: f64 = mxi * ri;
    if (_bj_nf_kept2(p5, mxr, rr, p6) == 0 || _bj_nf_kept2(p6, mxi, ri, p5) == 0) { return 1; }
    var p7: f64 = mxr * ri;
    var p8: f64 = mxi * rr;
    if (_bj_nf_kept2(p7, mxr, ri, p8) == 0 || _bj_nf_kept2(p8, mxi, rr, p7) == 0) { return 1; }
    return 0;
}

# One side's sums for an angle by Rust's recurrence (N_z += J_z·rot, M += M·rot, rot ← rot·step) over the n samples at
# smp, from rot = (rr, ri) and step = (sc, ss), into acc[0], acc[1] (N_z) and acc[mo], acc[mo + 1] (the side's L
# component): 1, or 0 where a product leaves the normal range unabsorbed (acc is then partial; the angle reruns). t is
# 1024 less the samples' smallest exponent field (the section comment): a sample whose rotation parts' fields are both
# at least t has its eight products normal or exact zeros, else _bj_nf_low8 judges them (−1023: never).
fn _bj_nf_side(smp: *f64, n, rr: f64, ri: f64, sc: f64, ss: f64, t, acc: *f64, mo): i64 {
    var nzr: f64 = acc[0];
    var nzi: f64 = acc[1];
    var mr: f64 = acc[mo];
    var mi: f64 = acc[mo + 1];
    for (var j = 0; j < n; j = j + 1) {
        var q = j * 4;
        var jzr: f64 = smp[q];
        var jzi: f64 = smp[q + 1];
        var mxr: f64 = smp[q + 2];
        var mxi: f64 = smp[q + 3];
        # either rotation part's exponent field below t: (e − t) is then negative, so one test
        if (((((load64(&rr) >> 52) & 2047) - t) | (((load64(&ri) >> 52) & 2047) - t)) < 0) {
            if (_bj_nf_low8(jzr, jzi, mxr, mxi, rr, ri) == 1) { return 0; }
        }
        nzr = nzr + (jzr * rr - jzi * ri);
        nzi = nzi + (jzr * ri + jzi * rr);
        mr = mr + (mxr * rr - mxi * ri);
        mi = mi + (mxr * ri + mxi * rr);
        var nr: f64 = rr * sc - ri * ss;
        ri = rr * ss + ri * sc;
        rr = nr;
    }
    acc[0] = nzr;
    acc[1] = nzi;
    acc[mo] = mr;
    acc[mo + 1] = mi;
    return 1;
}

# An angle's pattern value √(k/8π)·|η·N_z − L_φ| from its sums acc[0..6] (N_z, L_x, L_y), L_φ = −L_x sin φ + L_y cos φ,
# into *out: 1 where every operation before the last product is its 53-bit value (each product as a sample's against
# its sum's other term, the sums finite, the magnitude normal or 0 and finite), else 0 (*out is then Rust's value).
fn _bj_nf_tail(acc: *f64, cp: f64, sp: f64, eta0: f64, norm: f64, out: *f64): i64 {
    var nzr: f64 = acc[0];
    var nzi: f64 = acc[1];
    var lxr: f64 = acc[2];
    var lxi: f64 = acc[3];
    var lyr: f64 = acc[4];
    var lyi: f64 = acc[5];
    var nsp: f64 = -sp;
    var q1: f64 = lyr * cp;
    var q2: f64 = lxr * nsp;
    var lpr: f64 = q1 + q2;
    var q3: f64 = lyi * cp;
    var q4: f64 = lxi * nsp;
    var lpi: f64 = q3 + q4;
    var q5: f64 = nzr * eta0;
    var nlr: f64 = lpr * -1.0;
    var tr: f64 = q5 + nlr;
    var q6: f64 = nzi * eta0;
    var nli: f64 = lpi * -1.0;
    var ti: f64 = q6 + nli;
    var mag: f64 = _bj_hypot(tr, ti);
    var pat: f64 = norm * mag;
    out[0] = pat;
    var z: f64 = nzr * 0.0 + nzi * 0.0 + lxr * 0.0 + lxi * 0.0 + lyr * 0.0 + lyi * 0.0;
    if (z != 0.0) { return 0; }
    if (_bj_nf_kept2(q1, lyr, cp, q2) == 0 || _bj_nf_kept2(q2, lxr, nsp, q1) == 0) { return 0; }
    if (_bj_nf_kept2(q3, lyi, cp, q4) == 0 || _bj_nf_kept2(q4, lxi, nsp, q3) == 0) { return 0; }
    if (_bj_nf_kept2(q5, nzr, eta0, nlr) == 0 || _bj_nf_kept2(q6, nzi, eta0, nli) == 0) { return 0; }
    if (_bj_nf_fin(lpr) == 0 || _bj_nf_fin(lpi) == 0 || _bj_nf_fin(tr) == 0 || _bj_nf_fin(ti) == 0) { return 0; }
    if (_bj_nf_kept(mag, tr, ti) == 0) { return 0; }
    return 1;
}

# One angle's pattern value with an unbounded exponent throughout (the section comment's slow path): Rust's operations
# in its order, each to 53 bits, the sines and cosines of the 53-bit angles (Payne–Hanek past DBL_MAX), the magnitude
# by _bj_vx_hypot_ux and its product with √(k/8π) rounded once. us and ue hold k, k·dx, √(k/8π) and the four sides'
# starts, x then y (at 0, 1, 2, 3–6 and 7–10); dir the sides' unit steps (x at 0–3, y at 4–7) and cnt their sample
# counts. The samples are sms's and sme's (_bj_nf_sample_ux's layout) or, where sms is 0, sb's doubles.
#must_use
fn _bj_nf_angle_ux(cp: f64, sp: f64, us: *f64, ue: *i64, dir: *f64, cnt: *i64, sb, sms, sme, eta0: f64): f64 {
    var cps, cpe = _bj_k_ux_from(cp);
    var sps, spe = _bj_k_ux_from(sp);
    var a: f64[6];
    var ae: i64[6];
    for (var i = 0; i < 6; i = i + 1) {
        a[i] = 0.0;
        ae[i] = 0;
    }
    var base = 0;
    for (var s = 0; s < 4; s = s + 1) {
        var pas, pae = _bj_k_ux_mul(us[3 + s], ue[3 + s], cps, cpe);
        var pbs, pbe = _bj_k_ux_mul(us[7 + s], ue[7 + s], sps, spe);
        var prs, pre = _bj_k_ux_add(pas, pae, pbs, pbe);
        var gs, ge = _bj_k_ux_mul(us[0], ue[0], prs, pre);
        var ris, rie = _bj_vx_sin53(gs, ge);
        var rrs, rre = _bj_vx_cos53(gs, ge);
        var dp: f64 = dir[s] * cp + dir[4 + s] * sp;
        var dps, dpe = _bj_k_ux_from(dp);
        var hs, he = _bj_k_ux_mul(us[1], ue[1], dps, dpe);
        var sss, sse = _bj_vx_sin53(hs, he);
        var scs, sce = _bj_vx_cos53(hs, he);
        var mo = 2;
        if (s >= 2) { mo = 4; }
        var nrs: f64 = a[0];
        var nre = ae[0];
        var nis: f64 = a[1];
        var nie = ae[1];
        var mrs: f64 = a[mo];
        var mre = ae[mo];
        var mis: f64 = a[mo + 1];
        var mie = ae[mo + 1];
        for (var j = 0; j < cnt[s]; j = j + 1) {
            var w = base + j;
            var jrs: f64 = 0.0;
            var jre = 0;
            var jis: f64 = 0.0;
            var jie = 0;
            var xrs: f64 = 0.0;
            var xre = 0;
            var xis: f64 = 0.0;
            var xie = 0;
            if (sms != 0) {
                var xs: *f64 = _bj_nf_f64p(sms + w * 32);
                var xe: *i64 = _bj_nf_i64p(sme + w * 32);
                jrs = xs[0];
                jre = xe[0];
                jis = xs[1];
                jie = xe[1];
                xrs = xs[2];
                xre = xe[2];
                xis = xs[3];
                xie = xe[3];
            } else {
                var dpp: *f64 = _bj_nf_f64p(sb + w * 32);
                var c0s, c0e = _bj_k_ux_from(dpp[0]);
                var c1s, c1e = _bj_k_ux_from(dpp[1]);
                var c2s, c2e = _bj_k_ux_from(dpp[2]);
                var c3s, c3e = _bj_k_ux_from(dpp[3]);
                jrs = c0s;
                jre = c0e;
                jis = c1s;
                jie = c1e;
                xrs = c2s;
                xre = c2e;
                xis = c3s;
                xie = c3e;
            }
            var t1s, t1e = _bj_k_ux_mul(jrs, jre, rrs, rre);
            var t2s, t2e = _bj_k_ux_mul(jis, jie, ris, rie);
            var t3s, t3e = _bj_k_ux_sub(t1s, t1e, t2s, t2e);
            var n1s, n1e = _bj_k_ux_add(nrs, nre, t3s, t3e);
            nrs = n1s;
            nre = n1e;
            var t4s, t4e = _bj_k_ux_mul(jrs, jre, ris, rie);
            var t5s, t5e = _bj_k_ux_mul(jis, jie, rrs, rre);
            var t6s, t6e = _bj_k_ux_add(t4s, t4e, t5s, t5e);
            var n2s, n2e = _bj_k_ux_add(nis, nie, t6s, t6e);
            nis = n2s;
            nie = n2e;
            var v1s, v1e = _bj_k_ux_mul(xrs, xre, rrs, rre);
            var v2s, v2e = _bj_k_ux_mul(xis, xie, ris, rie);
            var v3s, v3e = _bj_k_ux_sub(v1s, v1e, v2s, v2e);
            var m1s, m1e = _bj_k_ux_add(mrs, mre, v3s, v3e);
            mrs = m1s;
            mre = m1e;
            var v4s, v4e = _bj_k_ux_mul(xrs, xre, ris, rie);
            var v5s, v5e = _bj_k_ux_mul(xis, xie, rrs, rre);
            var v6s, v6e = _bj_k_ux_add(v4s, v4e, v5s, v5e);
            var m2s, m2e = _bj_k_ux_add(mis, mie, v6s, v6e);
            mis = m2s;
            mie = m2e;
            var u1s, u1e = _bj_k_ux_mul(rrs, rre, scs, sce);
            var u2s, u2e = _bj_k_ux_mul(ris, rie, sss, sse);
            var u3s, u3e = _bj_k_ux_mul(rrs, rre, sss, sse);
            var u4s, u4e = _bj_k_ux_mul(ris, rie, scs, sce);
            var r1s, r1e = _bj_k_ux_sub(u1s, u1e, u2s, u2e);
            var r2s, r2e = _bj_k_ux_add(u3s, u3e, u4s, u4e);
            rrs = r1s;
            rre = r1e;
            ris = r2s;
            rie = r2e;
        }
        a[0] = nrs;
        ae[0] = nre;
        a[1] = nis;
        ae[1] = nie;
        a[mo] = mrs;
        ae[mo] = mre;
        a[mo + 1] = mis;
        ae[mo + 1] = mie;
        base = base + cnt[s];
    }
    var nsps: f64 = -sps;
    var q1s, q1e = _bj_k_ux_mul(a[4], ae[4], cps, cpe);
    var q2s, q2e = _bj_k_ux_mul(a[2], ae[2], nsps, spe);
    var lrs, lre = _bj_k_ux_add(q1s, q1e, q2s, q2e);
    var q3s, q3e = _bj_k_ux_mul(a[5], ae[5], cps, cpe);
    var q4s, q4e = _bj_k_ux_mul(a[3], ae[3], nsps, spe);
    var lis, lie = _bj_k_ux_add(q3s, q3e, q4s, q4e);
    var hts, hte = _bj_k_ux_from(eta0);
    var q5s, q5e = _bj_k_ux_mul(a[0], ae[0], hts, hte);
    var trs, tre = _bj_k_ux_sub(q5s, q5e, lrs, lre);
    var q6s, q6e = _bj_k_ux_mul(a[1], ae[1], hts, hte);
    var tis, tie = _bj_k_ux_sub(q6s, q6e, lis, lie);
    var ms, me = _bj_vx_hypot_ux(trs, tre, tis, tie);
    var r: f64 = _bj_k_ux_mul_f64(us[2], ue[2], ms, me);
    return r;
}

# The TM-mode NF2FF core (2D Love equivalence, e^{+jωt} phasors) into *out: 0, or the Allocation code recorded. The
# fields are re/im address pairs at f[0..6] (E_z, H_x, H_y; an im of 0 reads as zero); sv and se hold, each s·2^e to
# 53 bits with an unbounded exponent, the rotation of H onto E's time (cos at 0, sin at 1) and k (at 2). The contour
# runs through the E_z nodes x₀ = y₀ = margin, x₁ = nx − 1 − margin, y₁ = ny − 1 − margin; tangential H is the mean of
# the two Yee samples beside it; J = n̂×H, M = −n̂×E, trapezoid weights (half at each side's corners). The pattern is
# √(k/8π)·|η·N_z − L_φ|, N_z and L = (L_x, L_y) summed with e^{jk ρ̂·ρ'} advanced by a constant phasor along each side,
# L_φ = −L_x sin φ + L_y cos φ, at its range edges as the section comment has it (mode 0 Rust's chain, checked; 1
# wholly unbounded; 2 Rust's, for a non-finite field). Callers have validated the arguments. Mirrors fdtd.rs's
# `nf2ff_tm_core`.
fn _bj_nf_core(f: *i64, sv: *f64, se: *i64, nx, ny, dx: f64, margin, n_angles, out: *BjNf2ffResult): i64 {
    var x0 = margin;
    var x1 = nx - 1 - margin;
    var y0 = margin;
    var y1 = ny - 1 - margin;
    var xs: f64 = _bj_nf_u2f(x0 + x1);
    var xc: f64 = 0.5 * xs;
    var ys: f64 = _bj_nf_u2f(y0 + y1);
    var yc: f64 = 0.5 * ys;
    var nhs = x1 - x0 + 1;
    var nvs = y1 - y0 + 1;
    var total = 2 * nhs + 2 * nvs;
    if (n_angles < 0 || n_angles > _BJ_NF_FL_MAX / 16 || total > _BJ_NF_FL_MAX / 32) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "an NF2FF result");
        return BJ_ERR_ALLOCATION;
    }
    var sb = fl_alloc(total * 32);
    var rb = fl_alloc(n_angles * 16);
    if (sb == 0 || rb == 0) {
        if (sb != 0) { fl_free(sb); }
        if (rb != 0) { fl_free(rb); }
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "an NF2FF result");
        return BJ_ERR_ALLOCATION;
    }
    # The scalars: Rust's doubles (from k and the rotation rounded into binary64), and with an unbounded exponent.
    var mode = 0;
    if (_bj_nf_dbl(sv[0], se[0]) == 0 || _bj_nf_dbl(sv[1], se[1]) == 0 || _bj_nf_dbl(sv[2], se[2]) == 0) { mode = 1; }
    var rot_r: f64 = _bj_k_ux_round(sv[0], se[0], 0.0);
    var rot_i: f64 = _bj_k_ux_round(sv[1], se[1], 0.0);
    var k: f64 = _bj_k_ux_round(sv[2], se[2], 0.0);
    var half: f64 = 0.5 * dx;
    var pi8: f64 = 8.0 * _BJ_NF_PI;
    var kn: f64 = k / pi8;
    var norm: f64 = f64_sqrt(kn);
    var kdx: f64 = k * dx;
    if (_bj_nf_kept(half, 0.5, dx) == 0 || _bj_nf_kept(kn, k, pi8) == 0 || _bj_nf_kept(kdx, k, dx) == 0) { mode = 1; }
    var us: f64[11];
    var ue: i64[11];
    var dxs, dxe = _bj_k_ux_from(dx);
    us[0] = sv[2];
    ue[0] = se[2];
    var kxs, kxe = _bj_k_ux_mul(sv[2], se[2], dxs, dxe);
    us[1] = kxs;
    ue[1] = kxe;
    var p8s, p8e = _bj_k_ux_from(pi8);
    var kns, kne = _bj_k_ux_div(sv[2], se[2], p8s, p8e);
    var nms, nme = _bj_k_ux_sqrt(kns, kne);
    us[2] = nms;
    ue[2] = nme;
    # The four sides: bottom (y₀) and top (y₁) along +x; left (x₀) and right (x₁) along +y.
    var start_x: f64[4];
    var start_y: f64[4];
    var dir: f64[8];
    var cnt: i64[4];
    for (var side = 0; side < 4; side = side + 1) {
        var ox: f64 = _bj_nf_u2f(x0);
        var oy: f64 = _bj_nf_u2f(y0);
        dir[side] = 1.0;
        dir[4 + side] = 0.0;
        cnt[side] = nhs;
        if (side == 1) { oy = _bj_nf_u2f(y1); }
        if (side >= 2) {
            dir[side] = 0.0;
            dir[4 + side] = 1.0;
            cnt[side] = nvs;
        }
        if (side == 3) { ox = _bj_nf_u2f(x1); }
        var rx: f64 = ox - xc;
        var ry: f64 = oy - yc;
        var sx: f64 = rx * dx;
        var sy: f64 = ry * dx;
        start_x[side] = sx;
        start_y[side] = sy;
        if (_bj_nf_kept(sx, rx, dx) == 0 || _bj_nf_kept(sy, ry, dx) == 0) { mode = 1; }
        var rxs, rxe = _bj_k_ux_from(rx);
        var sxs, sxe = _bj_k_ux_mul(rxs, rxe, dxs, dxe);
        us[3 + side] = sxs;
        ue[3 + side] = sxe;
        var rys, rye = _bj_k_ux_from(ry);
        var sys, sye = _bj_k_ux_mul(rys, rye, dxs, dxe);
        us[7 + side] = sys;
        ue[7 + side] = sye;
    }
    # The samples (a non-finite field keeps Rust's chain: mode 2).
    var g: i64[5];
    g[0] = x0;
    g[1] = x1;
    g[2] = y0;
    g[3] = y1;
    g[4] = nx;
    var d: f64[4];
    d[0] = rot_r;
    d[1] = rot_i;
    d[2] = dx;
    d[3] = half;
    var u: f64[5];
    var uxe: i64[5];
    u[0] = sv[0];
    uxe[0] = se[0];
    u[1] = sv[1];
    uxe[1] = se[1];
    u[2] = dxs;
    uxe[2] = dxe;
    var hfs, hfe = _bj_k_ux_mul(dxs, dxe, 1.0, 0 - 1);
    u[3] = hfs;
    uxe[3] = hfe;
    var st = _bj_nf_samples(f, &g, &d, &u, &uxe, sb, 0, 0);
    if (st == 2) {
        mode = 2;
    } elif (st == 1) {
        mode = 1;
    }
    var sms = 0;
    var sme = 0;
    if (mode == 1) {
        sms = fl_alloc(total * 32);
        sme = fl_alloc(total * 32);
        if (sms == 0 || sme == 0) {
            if (sms != 0) { fl_free(sms); }
            if (sme != 0) { fl_free(sme); }
            fl_free(sb);
            fl_free(rb);
            _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "an NF2FF result");
            return BJ_ERR_ALLOCATION;
        }
        _bj_nf_samples(f, &g, &d, &u, &uxe, sb, sms, sme);
    }
    var smp: *f64 = _bj_nf_f64p(sb);
    var t = 0 - 1023;
    if (mode == 0) {
        var emin = 2047;
        for (var q = 0; q < total * 4; q = q + 1) {
            var x: f64 = smp[q];
            var ex = (load64(&x) >> 52) & 2047;
            if (x != 0.0 && ex < emin) { emin = ex; }
        }
        t = 1024 - emin;
    }
    var mu0: f64 = BJ_MU_0;
    var me: f64 = mu0 / BJ_EPSILON_0;
    var eta0: f64 = f64_sqrt(me);
    var nf: f64 = _bj_nf_u2f(n_angles);
    var w2: f64 = 2.0 * _BJ_NF_PI;
    var pat: *f64 = _bj_nf_f64p(rb);
    var ang: *f64 = _bj_nf_f64p(rb + n_angles * 8);
    var acc: f64[6];
    var po: f64[1];
    for (var a = 0; a < n_angles; a = a + 1) {
        var af: f64 = _bj_nf_u2f(a);
        var wa: f64 = w2 * af;
        var phi: f64 = wa / nf;
        ang[a] = phi;
        var sp, cp = _bj_sin_cos(phi);
        var ok = 1;
        if (mode == 1) { ok = 0; }
        for (var i = 0; i < 6; i = i + 1) { acc[i] = 0.0; }
        var base = 0;
        for (var s = 0; s < 4; s = s + 1) {
            if (ok == 1) {
                var pa: f64 = start_x[s] * cp;
                var pb: f64 = start_y[s] * sp;
                var pr: f64 = pa + pb;
                var rarg: f64 = k * pr;
                var rs, rc = _bj_sin_cos(rarg);
                var dp: f64 = dir[s] * cp + dir[4 + s] * sp;
                var sarg: f64 = kdx * dp;
                var ss, sc = _bj_sin_cos(sarg);
                if (mode == 0) {
                    var sx0: f64 = start_x[s];
                    var sy0: f64 = start_y[s];
                    if (_bj_nf_kept2(pa, sx0, cp, pb) == 0 || _bj_nf_kept2(pb, sy0, sp, pa) == 0) { ok = 0; }
                    if (_bj_nf_fin(pr) == 0 || _bj_nf_kept(rarg, k, pr) == 0) { ok = 0; }
                    if (_bj_nf_kept(sarg, kdx, dp) == 0 || _bj_nf_step_ok(sc, ss) == 0) { ok = 0; }
                }
                if (ok == 1) {
                    var mo = 2;
                    if (s >= 2) { mo = 4; }
                    ok = _bj_nf_side(_bj_nf_f64p(sb + base * 32), cnt[s], rc, rs, sc, ss, t, &acc, mo);
                }
            }
            base = base + cnt[s];
        }
        if (ok == 1) {
            var tk = _bj_nf_tail(&acc, cp, sp, eta0, norm, &po);
            if (mode == 0 && tk == 0) { ok = 0; }
        }
        if (ok == 1) {
            pat[a] = po[0];
        } else {
            var pu: f64 = _bj_nf_angle_ux(cp, sp, &us, &ue, &dir, &cnt, sb, sms, sme, eta0);
            pat[a] = pu;
        }
    }
    fl_free(sb);
    if (sms != 0) {
        fl_free(sms);
        fl_free(sme);
    }
    out.pattern = rb;
    out.angles = rb + n_angles * 8;
    out.count = n_angles;
    return 0;
}

# |a − b| ≤ 10⁻¹²·max(|a|, |b|): for finite a and b decided exactly, the decimal 10⁻¹² (src/crmath_edge.cyr's
# _bj_e_within12, z0_equal's: ADR 0002 row 17, M5 part 2c); otherwise Rust's test with its NaN-ignoring max (a NaN
# difference fails, and ∞ against a finite value passes: ez's ∞ is refused afterwards as an invalid frequency or dt,
# hx's or hy's is not).
#must_use
fn _bj_nf_same(a: f64, b: f64): i64 {
    var za: f64 = a * 0.0;
    var zb: f64 = b * 0.0;
    if (za == 0.0 && zb == 0.0) {
        var fa: f64 = f64_abs(a);
        var fb: f64 = f64_abs(b);
        var fm: f64 = fa;
        if (fb > fa) { fm = fb; }
        return _bj_e_within12(a, b, fm);
    }
    var d: f64 = a - b;
    var ad: f64 = f64_abs(d);
    var aa: f64 = f64_abs(a);
    var ab: f64 = f64_abs(b);
    var m: f64 = _bj_max(aa, ab);
    var lim: f64 = _BJ_NF_REL12 * m;
    if (ad <= lim) { return 1; }
    return 0;
}

# _bj_nf_same on two 53-bit values a = as·2^ae and b = bs·2^be with an unbounded exponent (ω's, kept past DBL_MAX and
# below 2^-1022: ADR 0002 row 18, M5 part 2d-6): for finite ones, the exact test on both scaled by one power of two,
# the larger into [1, 2) (the test is homogeneous; a smaller one scaled below 2^-1022 fails it, as its exact value
# does: |a − b| > (1 − 2^-1021)·|a| then); otherwise _bj_nf_same on Rust's doubles ad and bd.
#must_use
fn _bj_nf_same53(av: f64, ae, bv: f64, be, ad: f64, bd: f64): i64 {
    var za: f64 = av * 0.0;
    var zb: f64 = bv * 0.0;
    if (za == 0.0 && zb == 0.0) {
        if (av == 0.0 || bv == 0.0) {
            if (av == 0.0 && bv == 0.0) { return 1; }
            return 0;
        }
        var m = ae;
        if (be > m) { m = be; }
        var a: f64 = _bj_k_ux_round(av, ae - m, 0.0);
        var b: f64 = _bj_k_ux_round(bv, be - m, 0.0);
        var fa: f64 = f64_abs(a);
        var fb: f64 = f64_abs(b);
        var fm: f64 = fa;
        if (fb > fa) { fm = fb; }
        return _bj_e_within12(a, b, fm);
    }
    var r = _bj_nf_same(ad, bd);
    return r;
}

# The 2D TM NF2FF transform of CW phasors into *out (free a previous result first): ez, hx and hy are accumulators of
# E_z, H_x and H_y on an nx × ny Yee grid laid out as Fdtd2d's TM mode (index y·nx + x; E_z at (x, y), H_x at
# (x, y + ½), H_y at (x + ½, y)), fed after each step with the same time-step index, so H is rotated by e^{+jω·dt/2}
# onto E. The pattern is √ρ·|E_z(ρ, φ)| as ρ → ∞ at n_angles angles from 0, linear in the inputs (a CW steady state's
# running DFT is about the phasor times n_samples·dt/2). Ok(0), or with out untouched Err(InvalidParameter), Rust's
# texts in Rust's order: the accumulators disagree on ω or dt (relative 10⁻¹²); n_angles is 0; the margin is 0 or at
# least nx/2 or ny/2; dx isn't finite and positive; the frequency isn't; an accumulator holds fewer than nx·ny
# samples; dt isn't finite. Err(Allocation) when the result can't be had. ω is read to 53 bits with an unbounded
# exponent (omega_s, omega_e) for the agreement, the frequency, k and the rotation, and the transform runs at its
# range edges (ADR 0002 row 18, M5 part 2d-6; the section comment). Mirrors `nf2ff_2d_phasor`.
#must_use
public fn bj_nf2ff_2d_phasor(ez: *BjCwAccumulator, hx: *BjCwAccumulator, hy: *BjCwAccumulator, nx, ny, dx: f64,
  box_margin, n_angles, out: *BjNf2ffResult): Result {
    var ok = _bj_nf_same53(ez.omega_s, ez.omega_e, hx.omega_s, hx.omega_e, ez.omega, hx.omega);
    if (ok == 1) { ok = _bj_nf_same53(ez.omega_s, ez.omega_e, hy.omega_s, hy.omega_e, ez.omega, hy.omega); }
    if (ok == 1) { ok = _bj_nf_same(ez.dt, hx.dt); }
    if (ok == 1) { ok = _bj_nf_same(ez.dt, hy.dt); }
    if (ok == 0) { return Err(_bj_nf_bad("NF2FF phasor accumulators must share frequency and dt")); }
    var w: f64 = 2.0 * _BJ_NF_PI;
    var frequency: f64 = ez.omega / w;
    var ws, we = _bj_k_ux_from(w);
    var fs, fe = _bj_k_ux_div(ez.omega_s, ez.omega_e, ws, we);
    var sv: f64[3];
    var se: i64[3];
    var kv: f64[1];
    var kx: i64[1];
    var e = _bj_nf_validate(nx, ny, dx, frequency, fs, fe, box_margin, n_angles, &kv, &kx);
    if (e == 0) { e = _bj_nf_check_len("ez", ez.field_size, nx, ny); }
    if (e == 0) { e = _bj_nf_check_len("hx", hx.field_size, nx, ny); }
    if (e == 0) { e = _bj_nf_check_len("hy", hy.field_size, nx, ny); }
    if (e != 0) { return Err(e); }
    var dt: f64 = ez.dt;
    var z: f64 = dt * 0.0;
    if (z != 0.0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "accumulator dt must be finite, got ");
        _bj_fmt_f64_display(t, dt);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (_bj_log_on(4) == 1) {
        var lb[256];
        var lt[24];
        _bj_tx_init(&lt, &lb, 256);
        _bj_tx_cstr(&lt, "NF2FF (phasor) transform nx=");
        _bj_tx_u64(&lt, nx);
        _bj_tx_cstr(&lt, " ny=");
        _bj_tx_u64(&lt, ny);
        _bj_tx_cstr(&lt, " box_margin=");
        _bj_tx_u64(&lt, box_margin);
        _bj_tx_cstr(&lt, " n_angles=");
        _bj_tx_u64(&lt, n_angles);
        _bj_tx_cstr(&lt, " frequency=");
        var fd: f64 = _bj_k_ux_round(fs, fe, 0.0);
        _bj_fmt_f64_debug(&lt, fd);
        _bj_tx_cstr(&lt, " n_samples=");
        _bj_tx_u64(&lt, ez.n_samples);
        _bj_log_text(4, &lt);
    }
    # ω·dt/2 to 53 bits, Rust's (0.5·ω)·dt, and the rotation e^{+jω·dt/2} of H onto E's time from it.
    var hws, hwe = _bj_k_ux_mul(ez.omega_s, ez.omega_e, 1.0, 0 - 1);
    var ds, de = _bj_k_ux_from(dt);
    var gs, ge = _bj_k_ux_mul(hws, hwe, ds, de);
    var rcs, rce = _bj_vx_cos53(gs, ge);
    var rss, rse = _bj_vx_sin53(gs, ge);
    sv[0] = rcs;
    se[0] = rce;
    sv[1] = rss;
    se[1] = rse;
    sv[2] = kv[0];
    se[2] = kx[0];
    var f: i64[6];
    f[0] = ez.real;
    f[1] = ez.imag;
    f[2] = hx.real;
    f[3] = hx.imag;
    f[4] = hy.real;
    f[5] = hy.imag;
    var r: BjNf2ffResult;
    var ce = _bj_nf_core(&f, &sv, &se, nx, ny, dx, box_margin, n_angles, &r);
    if (ce != 0) { return Err(ce); }
    out.pattern = r.pattern;
    out.angles = r.angles;
    out.count = r.count;
    return Ok(0);
}

# The 2D TM NF2FF transform of one time snapshot of sim into *out (free a previous result first): the contour
# `box_margin` cells inside the grid's edge, J = n̂×H and M = −n̂×E integrated by Love's equivalence, the pattern
# √ρ·|E_z(ρ, φ)| as ρ → ∞ at n_angles angles from 0 (BjNf2ffResult). A monochromatic approximation: the snapshot is
# real, so the fields are taken as the phasor's real part and H (half a step behind E on the Yee grid) as it is, and the
# result depends on the instant; for accurate patterns accumulate E_z, H_x and H_y in BjCwAccumulators and use
# bj_nf2ff_2d_phasor. Ok(0), or with out untouched Err(InvalidParameter), Rust's texts in Rust's order: the grid isn't
# TM ("NF2FF requires a TM-mode simulation, got Te"), n_angles is 0, the margin is 0 or at least nx/2 or ny/2, dx isn't
# finite and positive, the frequency isn't. Rust's check that each field holds nx·ny samples goes (ADR 0002 row 2: the
# arrays are fixed at construction). Err(Allocation) when the result can't be had. The core runs at its range edges as
# the phasor form's (ADR 0002 row 18, M5 part 2d-6), its rotation (1, 0) and k = 2π·frequency/c to 53 bits. Mirrors
# `nf2ff_2d`.
#must_use
public fn bj_nf2ff_2d(sim: *BjFdtd2d, box_margin, n_angles, frequency: f64, out: *BjNf2ffResult): Result {
    if (sim.mode != BJ_MODE2D_TM) {
        var tm = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(tm, "NF2FF requires a TM-mode simulation, got ");
        if (sim.mode == BJ_MODE2D_TE) { _bj_tx_cstr(tm, "Te"); }
        else { _bj_tx_i64(tm, sim.mode); }
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var nx = sim.nx;
    var ny = sim.ny;
    var dx: f64 = sim.dx;
    var fs, fe = _bj_k_ux_from(frequency);
    var kv: f64[1];
    var kx: i64[1];
    var e = _bj_nf_validate(nx, ny, dx, frequency, fs, fe, box_margin, n_angles, &kv, &kx);
    if (e != 0) { return Err(e); }
    if (_bj_log_on(4) == 1) {
        var lb[256];
        var lt[24];
        _bj_tx_init(&lt, &lb, 256);
        _bj_tx_cstr(&lt, "NF2FF (snapshot) transform nx=");
        _bj_tx_u64(&lt, nx);
        _bj_tx_cstr(&lt, " ny=");
        _bj_tx_u64(&lt, ny);
        _bj_tx_cstr(&lt, " box_margin=");
        _bj_tx_u64(&lt, box_margin);
        _bj_tx_cstr(&lt, " n_angles=");
        _bj_tx_u64(&lt, n_angles);
        _bj_tx_cstr(&lt, " frequency=");
        _bj_fmt_f64_debug(&lt, frequency);
        _bj_log_text(4, &lt);
    }
    var sv: f64[3];
    var se: i64[3];
    sv[0] = 1.0;
    se[0] = 0;
    sv[1] = 0.0;
    se[1] = 0;
    sv[2] = kv[0];
    se[2] = kx[0];
    var f: i64[6];
    f[0] = sim.fz;
    f[1] = 0;
    f[2] = sim.fx;
    f[3] = 0;
    f[4] = sim.fy;
    f[5] = 0;
    var r: BjNf2ffResult;
    var ce = _bj_nf_core(&f, &sv, &se, nx, ny, dx, box_margin, n_angles, &r);
    if (ce != 0) { return Err(ce); }
    out.pattern = r.pattern;
    out.angles = r.angles;
    out.count = r.count;
    return Ok(0);
}

# --- json.cyr ---

# json.cyr — JSON for the serializable types: BjComplex (Rust hisab 1.4.0's `Complex`), BjFieldVector,
# BjPointCharge, (M2 part 1a) BjMaterial, (M3 part 1a-2) polarization's BjJonesVector, BjJonesMatrix,
# BjStokesVector and BjMuellerMatrix, (M3 part 1b-2) scattering's BjMieResult, (M3 part 1c-2) beam's
# BjGaussianBeam, BjAbcdMatrix and BjResonatorStability, (M4 part 1d) rf's BjSMatrix, BjTouchstoneFormat and
# BjTouchstoneData, and (M5 part 1f) the FDTD's BjLossyMaterial, BjDrudeMaterial, BjLorentzMaterial, BjDebyeMaterial,
# BjNonUniformGrid and BjEigenmodeResult, and (M6 part 1d) the 2D FDTD's BjCpmlParams and BjMode2d, as serde_json
# 1.0.154 writes and reads them (port plan D5, M1 part 4; ADR 0002 rows 10–12, 36). An EigenmodeResult's three vectors
# share one count, so a document whose vectors differ in length is refused (row 36); a NonUniformGrid's axes have any
# lengths. A usize (an SMatrix's or TouchstoneData's ports, a CpmlParams' thickness) is read from 0 to 2^63 − 1 (row
# 36: bayan's tree keeps no exact integer past it) and written as Rust's whole u64.
#
# Writers append serde's document to a `str_builder`: the fields in Rust declaration order, no spaces, a Rust array
# (`[f64; 3]`, a Jones matrix's `m: [[Complex; 2]; 2]`, a Mueller matrix's `m: [[f64; 4]; 4]`) as nested arrays row by
# row, an inner Complex as its own object, a bool (BjResonatorStability's `is_stable`, 1 or 0) as `true` or `false`,
# every f64 through bayan's printer (`bayan_f64_to_json`, the printer `#derive(Serialize)` uses): the shortest
# round-trip digits, `null` for NaN and ±∞ as serde_json writes them. The notation is bayan's, not ryu's
# (`10000000000000000.0` where serde_json writes `1e16`); each parses to the same bits, which is what the golden rows
# compare (D5). The document is built on the stack (a BjMieResult's, whose two `Vec<Complex>` have any length, in one
# fl_alloc block sized for the longest numbers) and appended in one grow, so a refused allocation leaves the builder as
# it was and returns BJ_ERR_ALLOCATION (the builder's own grow would exit the process). Hand-written, not derived: on
# cyrius 6.7.18 a `#derive(Serialize)` in a second `private` file fails to compile (the derive's shared helper is
# private to the first one), and the derive would export its scanner decoders as bijli API (probe p16).
#
# Readers parse the text with bayan's value tree and apply serde's derive semantics:
# - a struct reads from an object, by field name, or from an array, by position (serde's sequence form), which must
#   hold exactly its fields, at every level (a Jones vector's x is a Complex in either form); a Rust `[T; n]` reads
#   from an array of exactly n T, a `Vec<T>` from an array of any length;
# - a field missing, a value of the wrong JSON type, or an array of the wrong length is BJ_ERR_DESERIALIZE;
# - unknown fields are ignored, whatever their value (it must still be valid JSON);
# - a bool takes only JSON's `true` or `false`, as serde reads one: never a number (0 or 1), a string or null;
# - an f64 takes any JSON number, correctly rounded (ADR 0002 row 11: serde_json's default parse is best-effort, and
#   the golden rows compare against the correctly rounded value), and never `null` (serde_json writes NaN and ±∞ as
#   `null` and can't read them back, nor can the port); a number whose correctly rounded value overflows is refused,
#   as serde_json refuses `1e400`;
# - the whole document is checked, unknown values included (ADR 0002 row 12): a key repeated in any object, a lone
#   surrogate escape in any string, or containers nested past 128 levels refuse it. serde_json checks only what it
#   deserializes: it refuses those in the struct's own fields and keys, and skips an unknown value unchecked;
# - a mass that `BjPointCharge_new` would refuse is read as written, and so are a beam that `BjGaussianBeam_new`
#   would refuse (its z_R as given, not recomputed) and a ResonatorStability whose `is_stable` disagrees with its
#   g₁g₂: Rust's fields are public, serde's derive calls no constructor, and the readers read back every document
#   the writers write.
# Where bayan reads the text otherwise than serde_json, one pass before bayan sees it puts that right: the integer
# `-0` (an integer 0 in bayan's tree, so an f64 field would lose the sign; serde_json reads -0.0) and an integer
# outside i64 (refused by bayan; a number to serde_json) each get `.0` appended, which bayan reads as a float,
# correctly rounded; a raw control character in a string (taken by bayan; refused by serde_json and RFC 8259 §7) and
# bytes that are not UTF-8 in a string (which a Rust `&str` can't hold) refuse the document. A document with no such
# integer is parsed in place.
#
# A failed read fills the calling thread's last-error record: BJ_ERR_DESERIALIZE, Display
# `deserialization failed: <reason>`, with serde's wording where it applies (`missing field `y``) and bayan's for a
# syntax error, at its byte offset in the caller's text. `out` is written only on success.
#
# Memory. Every node of the tree comes from a decode region on the reader's stack: freelist chunks, chained and given
# back when the read ends, so a read leaves the heap as it found it (nothing on the bump heap) and two threads reading
# at once share nothing.

private

# ── writers ─────────────────────────────────────────────────────────────────────────

# Appends the C string s at buf + n; the new length.
fn _bj_jw_cstr(buf, n, s): i64 {
    var k = strlen(s);
    memcpy(buf + n, s, k);
    return n + k;
}

# Appends the f64 with bits x in bayan's JSON form (at most 25 bytes; `null` for NaN and ±∞); the new length.
fn _bj_jw_f64(buf, n, x): i64 {
    return n + bayan_f64_to_json(x, buf + n);
}

# Appends `[a,b,c]` for the three f64 at p; the new length.
fn _bj_jw_triple(buf, n, a, b, c): i64 {
    var m = n;
    store8(buf + m, 91);
    m = _bj_jw_f64(buf, m + 1, a);
    store8(buf + m, 44);
    m = _bj_jw_f64(buf, m + 1, b);
    store8(buf + m, 44);
    m = _bj_jw_f64(buf, m + 1, c);
    store8(buf + m, 93);
    return m + 1;
}

# Appends `{"re":<re>,"im":<im>}` for the two f64 at p; the new length.
fn _bj_jw_cx(buf, n, p): i64 {
    var m = _bj_jw_cstr(buf, n, "{\"re\":");
    m = _bj_jw_f64(buf, m, load64(p));
    m = _bj_jw_cstr(buf, m, ",\"im\":");
    m = _bj_jw_f64(buf, m, load64(p + 8));
    store8(buf + m, 125);
    return m + 1;
}

# Appends `[a,b,c,d]` for the four f64 at p; the new length.
fn _bj_jw_quad(buf, n, p): i64 {
    var m = n;
    for (var k = 0; k < 4; k = k + 1) {
        if (k == 0) { store8(buf + m, 91); } else { store8(buf + m, 44); }
        m = _bj_jw_f64(buf, m + 1, load64(p + k * 8));
    }
    store8(buf + m, 93);
    return m + 1;
}

# Appends the document [buf, buf + n) to the builder sb in one grow: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it
# was.
#must_use
fn _bj_jw_put(sb, buf, n): Result {
    store8(buf + n, 0);
    if (str_builder_add_cstr_a(default_alloc(), sb, buf) != 0) {
        var t = _bj_err_reason(BJ_ERR_ALLOCATION);
        _bj_tx_cstr(t, "the JSON document's builder can't grow");
        return Err(BJ_ERR_ALLOCATION);
    }
    return Ok(0);
}

# Appends `{"re":<re>,"im":<im>}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors
# `serde_json::to_string(&c)` for Rust hisab's `Complex`.
#must_use
public fn BjComplex_to_json(c: *BjComplex, sb): Result {
    var buf[80];
    var n = _bj_jw_cstr(&buf, 0, "{\"re\":");
    n = _bj_jw_f64(&buf, n, c.re);
    n = _bj_jw_cstr(&buf, n, ",\"im\":");
    n = _bj_jw_f64(&buf, n, c.im);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"x":<x>,"y":<y>,"z":<z>}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors
# `serde_json::to_string(&v)` for `field::FieldVector`.
#must_use
public fn BjFieldVector_to_json(v: *BjFieldVector, sb): Result {
    var buf[112];
    var n = _bj_jw_cstr(&buf, 0, "{\"x\":");
    n = _bj_jw_f64(&buf, n, v.x);
    n = _bj_jw_cstr(&buf, n, ",\"y\":");
    n = _bj_jw_f64(&buf, n, v.y);
    n = _bj_jw_cstr(&buf, n, ",\"z\":");
    n = _bj_jw_f64(&buf, n, v.z);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"charge":<q>,"mass":<m>,"position":[<x>,<y>,<z>],"velocity":[<vx>,<vy>,<vz>]}` to the builder sb: Ok(0),
# or Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors `serde_json::to_string(&p)` for `charge::PointCharge`.
#must_use
public fn BjPointCharge_to_json(p: *BjPointCharge, sb): Result {
    var buf[320];
    var n = _bj_jw_cstr(&buf, 0, "{\"charge\":");
    n = _bj_jw_f64(&buf, n, p.charge);
    n = _bj_jw_cstr(&buf, n, ",\"mass\":");
    n = _bj_jw_f64(&buf, n, p.mass);
    n = _bj_jw_cstr(&buf, n, ",\"position\":");
    var x: f64 = p.position.0;
    var y: f64 = p.position.1;
    var z: f64 = p.position.2;
    n = _bj_jw_triple(&buf, n, x, y, z);
    n = _bj_jw_cstr(&buf, n, ",\"velocity\":");
    var vx: f64 = p.velocity.0;
    var vy: f64 = p.velocity.1;
    var vz: f64 = p.velocity.2;
    n = _bj_jw_triple(&buf, n, vx, vy, vz);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"eps_r":<ε_r>,"mu_r":<μ_r>,"conductivity":<σ>}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with
# sb as it was. Mirrors `serde_json::to_string(&m)` for `material::Material`.
#must_use
public fn BjMaterial_to_json(m: *BjMaterial, sb): Result {
    var buf[128];
    var n = _bj_jw_cstr(&buf, 0, "{\"eps_r\":");
    n = _bj_jw_f64(&buf, n, m.eps_r);
    n = _bj_jw_cstr(&buf, n, ",\"mu_r\":");
    n = _bj_jw_f64(&buf, n, m.mu_r);
    n = _bj_jw_cstr(&buf, n, ",\"conductivity\":");
    n = _bj_jw_f64(&buf, n, m.conductivity);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"x":{"re":..,"im":..},"y":{"re":..,"im":..}}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb
# as it was. Mirrors `serde_json::to_string(&j)` for `polarization::JonesVector`.
#must_use
public fn BjJonesVector_to_json(j: *BjJonesVector, sb): Result {
    var w: f64[4];
    memcpy(&w, j, 32);
    var buf[160];
    var n = _bj_jw_cstr(&buf, 0, "{\"x\":");
    n = _bj_jw_cx(&buf, n, &w);
    n = _bj_jw_cstr(&buf, n, ",\"y\":");
    n = _bj_jw_cx(&buf, n, &w + 16);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"m":[[<m00>,<m01>],[<m10>,<m11>]]}`, each element a Complex object, to the builder sb: Ok(0), or
# Err(BJ_ERR_ALLOCATION) with sb as it was. Rust's `m[r][c]` is BjJonesMatrix's field m<r><c>. Mirrors
# `serde_json::to_string(&j)` for `polarization::JonesMatrix`.
#must_use
public fn BjJonesMatrix_to_json(j: *BjJonesMatrix, sb): Result {
    var w: f64[8];
    memcpy(&w, j, 64);
    var buf[320];
    var n = _bj_jw_cstr(&buf, 0, "{\"m\":[[");
    n = _bj_jw_cx(&buf, n, &w);
    n = _bj_jw_cstr(&buf, n, ",");
    n = _bj_jw_cx(&buf, n, &w + 16);
    n = _bj_jw_cstr(&buf, n, "],[");
    n = _bj_jw_cx(&buf, n, &w + 32);
    n = _bj_jw_cstr(&buf, n, ",");
    n = _bj_jw_cx(&buf, n, &w + 48);
    n = _bj_jw_cstr(&buf, n, "]]}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"s":[<S₀>,<S₁>,<S₂>,<S₃>]}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was.
# Mirrors `serde_json::to_string(&s)` for `polarization::StokesVector`.
#must_use
public fn BjStokesVector_to_json(s: *BjStokesVector, sb): Result {
    var w: f64[4];
    memcpy(&w, s, 32);
    var buf[128];
    var n = _bj_jw_cstr(&buf, 0, "{\"s\":");
    n = _bj_jw_quad(&buf, n, &w);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"m":[[..],[..],[..],[..]]}`, the matrix row by row, to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION)
# with sb as it was. Mirrors `serde_json::to_string(&m)` for `polarization::MuellerMatrix`.
#must_use
public fn BjMuellerMatrix_to_json(m: *BjMuellerMatrix, sb): Result {
    var w: f64[16];
    memcpy(&w, m, 128);
    var buf[512];
    var n = _bj_jw_cstr(&buf, 0, "{\"m\":[");
    for (var r = 0; r < 4; r = r + 1) {
        if (r > 0) { n = _bj_jw_cstr(&buf, n, ","); }
        n = _bj_jw_quad(&buf, n, &w + r * 32);
    }
    n = _bj_jw_cstr(&buf, n, "]}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"q_sca":..,"q_ext":..,"q_abs":..,"g":..,"a":[<Complex>,..],"b":[<Complex>,..]}` to the builder sb, each
# coefficient a Complex object: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was. The document is built in one
# fl_alloc block of 160 + 64 bytes a coefficient (an f64 is at most 25 bytes, a Complex with its comma at most 64).
# Mirrors `serde_json::to_string(&r)` for `scattering::MieResult`.
#must_use
public fn BjMieResult_to_json(r: *BjMieResult, sb): Result {
    var na = r.a_len;
    var nb = r.b_len;
    var buf = fl_alloc(160 + (na + nb) * 64);
    if (buf == 0) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "the JSON document's buffer");
        return Err(BJ_ERR_ALLOCATION);
    }
    var n = _bj_jw_cstr(buf, 0, "{\"q_sca\":");
    n = _bj_jw_f64(buf, n, r.q_sca);
    n = _bj_jw_cstr(buf, n, ",\"q_ext\":");
    n = _bj_jw_f64(buf, n, r.q_ext);
    n = _bj_jw_cstr(buf, n, ",\"q_abs\":");
    n = _bj_jw_f64(buf, n, r.q_abs);
    n = _bj_jw_cstr(buf, n, ",\"g\":");
    n = _bj_jw_f64(buf, n, r.g);
    n = _bj_jw_cstr(buf, n, ",\"a\":[");
    n = _bj_jw_cvec(buf, n, r.a, na);
    n = _bj_jw_cstr(buf, n, "],\"b\":[");
    n = _bj_jw_cvec(buf, n, r.b, nb);
    n = _bj_jw_cstr(buf, n, "]}");
    var t, v = _bj_jw_put(sb, buf, n);
    fl_free(buf);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(0);
}

# Appends the k Complex at p as objects separated by commas; the new length.
fn _bj_jw_cvec(buf, n, p, k): i64 {
    var m = n;
    for (var j = 0; j < k; j = j + 1) {
        if (j > 0) {
            store8(buf + m, 44);
            m = m + 1;
        }
        m = _bj_jw_cx(buf, m, p + j * 16);
    }
    return m;
}

# Appends `{"wavelength":<λ>,"waist":<w₀>,"rayleigh_range":<z_R>}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION)
# with sb as it was. Mirrors `serde_json::to_string(&b)` for `beam::GaussianBeam`.
#must_use
public fn BjGaussianBeam_to_json(b: *BjGaussianBeam, sb): Result {
    var buf[128];
    var n = _bj_jw_cstr(&buf, 0, "{\"wavelength\":");
    n = _bj_jw_f64(&buf, n, b.wavelength);
    n = _bj_jw_cstr(&buf, n, ",\"waist\":");
    n = _bj_jw_f64(&buf, n, b.waist);
    n = _bj_jw_cstr(&buf, n, ",\"rayleigh_range\":");
    n = _bj_jw_f64(&buf, n, b.rayleigh_range);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"a":<A>,"b":<B>,"c":<C>,"d":<D>}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was.
# Mirrors `serde_json::to_string(&m)` for `beam::AbcdMatrix`.
#must_use
public fn BjAbcdMatrix_to_json(m: *BjAbcdMatrix, sb): Result {
    var buf[128];
    var n = _bj_jw_cstr(&buf, 0, "{\"a\":");
    n = _bj_jw_f64(&buf, n, m.a);
    n = _bj_jw_cstr(&buf, n, ",\"b\":");
    n = _bj_jw_f64(&buf, n, m.b);
    n = _bj_jw_cstr(&buf, n, ",\"c\":");
    n = _bj_jw_f64(&buf, n, m.c);
    n = _bj_jw_cstr(&buf, n, ",\"d\":");
    n = _bj_jw_f64(&buf, n, m.d);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"g1":<g₁>,"g2":<g₂>,"g_product":<g₁g₂>,"is_stable":<true|false>}` to the builder sb: Ok(0), or
# Err(BJ_ERR_ALLOCATION) with sb as it was. `is_stable` is written `true` when it is not 0, as
# bj_resonator_beam_waist reads it. Mirrors `serde_json::to_string(&s)` for `beam::ResonatorStability`.
#must_use
public fn BjResonatorStability_to_json(s: *BjResonatorStability, sb): Result {
    var buf[128];
    var n = _bj_jw_cstr(&buf, 0, "{\"g1\":");
    n = _bj_jw_f64(&buf, n, s.g1);
    n = _bj_jw_cstr(&buf, n, ",\"g2\":");
    n = _bj_jw_f64(&buf, n, s.g2);
    n = _bj_jw_cstr(&buf, n, ",\"g_product\":");
    n = _bj_jw_f64(&buf, n, s.g_product);
    if (s.is_stable != 0) { n = _bj_jw_cstr(&buf, n, ",\"is_stable\":true}"); }
    else { n = _bj_jw_cstr(&buf, n, ",\"is_stable\":false}"); }
    return _bj_jw_put(sb, &buf, n);
}

# ── rf's three types (M4 part 1d) ───────────────────────────────────────────────────────────────────────────────

# Appends the unsigned decimal digits of the 64-bit word v (a usize); the new length.
fn _bj_jw_u64(buf, n, v): i64 {
    var d[24];
    var k = 0;
    var x = v;
    if (x == 0) {
        store8(buf + n, 48);
        return n + 1;
    }
    # Above 2^63 the word is negative here: its first digit is the unsigned quotient by 10, taken via a halving.
    if (x < 0) {
        var q = ((x >> 1) / 5);
        store8(&d, 48 + (x - q * 10));
        k = 1;
        x = q;
    }
    while (x > 0) {
        store8(&d + k, 48 + x % 10);
        x = x / 10;
        k = k + 1;
    }
    for (var j = 0; j < k; j = j + 1) { store8(buf + n + j, load8(&d + k - 1 - j)); }
    return n + k;
}

# Appends an SMatrix's object `{"ports":<n>,"s":[[<Complex>,..],..],"z0":[..]}`; the new length. The buffer holds
# 64 bytes, 64 a Complex and 28 an impedance.
fn _bj_jw_sm(buf, n, m: *BjSMatrix): i64 {
    var p = m.ports;
    var k = _bj_jw_cstr(buf, n, "{\"ports\":");
    k = _bj_jw_u64(buf, k, p);
    k = _bj_jw_cstr(buf, k, ",\"s\":[");
    for (var r = 0; r < p; r = r + 1) {
        if (r > 0) { k = _bj_jw_cstr(buf, k, ","); }
        k = _bj_jw_cstr(buf, k, "[");
        k = _bj_jw_cvec(buf, k, m.s + r * p * 16, p);
        k = _bj_jw_cstr(buf, k, "]");
    }
    k = _bj_jw_cstr(buf, k, "],\"z0\":[");
    for (var j = 0; j < p; j = j + 1) {
        if (j > 0) { k = _bj_jw_cstr(buf, k, ","); }
        k = _bj_jw_f64(buf, k, load64(m.z0 + j * 8));
    }
    return _bj_jw_cstr(buf, k, "]}");
}

# The bytes an SMatrix of p ports needs in _bj_jw_sm's buffer, or -1 past 2^40.
#must_use
fn _bj_jw_sm_size(p): i64 {
    if (p < 0 || p > 131072) { return 0 - 1; }
    return 64 + p * p * 64 + p * 28;
}

# Appends `{"ports":<n>,"s":[[<Complex>,..],..],"z0":[..]}` to the builder sb (ports as an integer, each entry a
# Complex object, row by row): Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was. Built in one fl_alloc block.
# Mirrors `serde_json::to_string(&m)` for `rf::SMatrix`.
#must_use
public fn BjSMatrix_to_json(m: *BjSMatrix, sb): Result {
    var size = _bj_jw_sm_size(m.ports);
    var buf = 0;
    if (size > 0) { buf = fl_alloc(size); }
    if (buf == 0) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "the JSON document's buffer");
        return Err(BJ_ERR_ALLOCATION);
    }
    var n = _bj_jw_sm(buf, 0, m);
    var t, v = _bj_jw_put(sb, buf, n);
    fl_free(buf);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(0);
}

# Appends the format's document, its variant's name in quotes (`"MagnitudeAngle"`, `"RealImag"`, `"DbAngle"`), to the
# builder sb: Ok(0), Err(BJ_ERR_ALLOCATION) with sb as it was, or Err(BJ_ERR_INVALID_PARAMETER) for a value that is no
# BjTouchstoneFormat (Rust's enum has no other). Mirrors `serde_json::to_string(&f)` for `rf::TouchstoneFormat`.
#must_use
public fn BjTouchstoneFormat_to_json(format, sb): Result {
    if (format < 0 || format > 2) {
        var t0 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t0, "unknown Touchstone format ");
        _bj_tx_i64(t0, format);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var buf[24];
    var n = _bj_jw_cstr(&buf, 0, "\"");
    n = _bj_jw_cstr(&buf, n, _bj_ts_format_name(format));
    n = _bj_jw_cstr(&buf, n, "\"");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"ports":<n>,"z0":<R>,"frequencies":[..],"s_matrices":[<SMatrix>,..]}` to the builder sb: Ok(0), or
# Err(BJ_ERR_ALLOCATION) with sb as it was. Built in one fl_alloc block. Mirrors `serde_json::to_string(&d)` for
# `rf::TouchstoneData`.
#must_use
public fn BjTouchstoneData_to_json(d: *BjTouchstoneData, sb): Result {
    var per = _bj_jw_sm_size(d.ports);
    var buf = 0;
    if (per > 0 && d.points >= 0 && d.points < 1099511627776 / (per + 32)) {
        buf = fl_alloc(128 + d.points * (per + 32));
    }
    if (buf == 0) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "the JSON document's buffer");
        return Err(BJ_ERR_ALLOCATION);
    }
    var n = _bj_jw_cstr(buf, 0, "{\"ports\":");
    n = _bj_jw_u64(buf, n, d.ports);
    n = _bj_jw_cstr(buf, n, ",\"z0\":");
    n = _bj_jw_f64(buf, n, _bj_bits(d.z0));
    n = _bj_jw_cstr(buf, n, ",\"frequencies\":[");
    for (var k = 0; k < d.points; k = k + 1) {
        if (k > 0) { n = _bj_jw_cstr(buf, n, ","); }
        n = _bj_jw_f64(buf, n, load64(d.frequencies + k * 8));
    }
    n = _bj_jw_cstr(buf, n, "],\"s_matrices\":[");
    for (var j = 0; j < d.points; j = j + 1) {
        if (j > 0) { n = _bj_jw_cstr(buf, n, ","); }
        n = _bj_jw_sm(buf, n, d.matrix_at(j));
    }
    n = _bj_jw_cstr(buf, n, "]}");
    var t, v = _bj_jw_put(sb, buf, n);
    fl_free(buf);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(0);
}

# ── the decode region ───────────────────────────────────────────────────────────────
# A region on the reader's stack, 64 bytes: +0 the chunk chain (each chunk's first word links the next), +8 the next
# free byte, +16 the current chunk's end, +24 the 40-byte allocator bayan calls (lib/alloc.cyr's vtable: alloc,
# realloc, free, reset, state). Chunks are freelist blocks of one 4,096-byte class; a request larger than a chunk
# gets a block of its own. Nothing is freed before the read ends, when _bj_jr_close gives every chunk back.

const _BJ_JR_REGION = 64;
const _BJ_JR_CHUNK = 4080;

# A block of `size` bytes, 16-byte aligned, or 0 when the freelist refuses.
fn _bj_jr_alloc(st, size): i64 {
    var n = (size + 15) & (0 - 16);
    if (n <= 0) { n = 16; }
    var cur = load64(st + 8);
    if (cur != 0 && cur + n <= load64(st + 16)) {
        store64(st + 8, cur + n);
        return cur;
    }
    var cap = _BJ_JR_CHUNK - 16;
    var own = 0;
    if (n > cap) {
        cap = n;
        own = 1;
    }
    var c = fl_alloc(cap + 16);
    if (c == 0) { return 0; }
    store64(c, load64(st));
    store64(st, c);
    if (own == 0) {
        store64(st + 8, c + 16 + n);
        store64(st + 16, c + 16 + cap);
    }
    return c + 16;
}

# A block of new_size bytes holding the first min(old_size, new_size) bytes at old, or 0.
fn _bj_jr_realloc(st, old, old_size, new_size): i64 {
    var p = _bj_jr_alloc(st, new_size);
    if (p == 0) { return 0; }
    var k = old_size;
    if (new_size < k) { k = new_size; }
    if (old != 0 && k > 0) { memcpy(p, old, k); }
    return p;
}

# A block is freed with its region.
fn _bj_jr_free(st, p): i64 {
    return 0;
}

# Gives every chunk back; the region is empty and usable again.
fn _bj_jr_reset(st): i64 {
    var c = load64(st);
    while (c != 0) {
        var next = load64(c);
        fl_free(c);
        c = next;
    }
    store64(st, 0);
    store64(st + 8, 0);
    store64(st + 16, 0);
    return 0;
}

# Makes the region at rg empty; its allocator is rg + 24.
fn _bj_jr_open(rg): i64 {
    store64(rg, 0);
    store64(rg + 8, 0);
    store64(rg + 16, 0);
    store64(rg + 24, &_bj_jr_alloc);
    store64(rg + 32, &_bj_jr_realloc);
    store64(rg + 40, &_bj_jr_free);
    store64(rg + 48, &_bj_jr_reset);
    store64(rg + 56, rg);
    return rg + 24;
}

# Gives the region's memory back.
fn _bj_jr_close(rg): i64 {
    return _bj_jr_reset(rg);
}

# ── the document ────────────────────────────────────────────────────────────────────

# 1 when the integer token [p, p + n), its digits from offset ds, is one bayan reads otherwise than serde_json: `-0`,
# or a magnitude outside i64 (more than 19 digits, or 19 above i64's bound; leading zeros, which both refuse, count
# as digits).
#must_use
fn _bj_jr_int_odd(p, n, ds): i64 {
    if (n == 2 && load8(p) == 45 && load8(p + 1) == 48) { return 1; }
    var digits = n - ds;
    if (digits < 19) { return 0; }
    if (digits > 19) { return 1; }
    var bound = "9223372036854775807";
    if (ds == 1) { bound = "9223372036854775808"; }
    for (var k = 0; k < 19; k = k + 1) {
        var d = load8(p + ds + k);
        var b = load8(bound + k);
        if (d < b) { return 0; }
        if (d > b) { return 1; }
    }
    return 0;
}

# The length of the well-formed UTF-8 sequence (RFC 3629: no overlong form, no surrogate, nothing past U+10FFFF) at
# p, whose first byte is 0x80 or above and which has n bytes left, or 0.
#must_use
fn _bj_jr_utf8(p, n): i64 {
    var b0 = load8(p);
    var need = 0;
    var lo = 128;
    var hi = 191;
    if (b0 >= 194 && b0 <= 223) { need = 1; }
    elif (b0 == 224) {
        need = 2;
        lo = 160;
    } elif (b0 >= 225 && b0 <= 236) { need = 2; }
    elif (b0 == 237) {
        need = 2;
        hi = 159;
    } elif (b0 >= 238 && b0 <= 239) { need = 2; }
    elif (b0 == 240) {
        need = 3;
        lo = 144;
    } elif (b0 >= 241 && b0 <= 243) { need = 3; }
    elif (b0 == 244) {
        need = 3;
        hi = 143;
    } else { return 0; }
    if (need >= n) { return 0; }
    var b1 = load8(p + 1);
    if (b1 < lo || b1 > hi) { return 0; }
    for (var k = 2; k <= need; k = k + 1) {
        var b = load8(p + k);
        if (b < 128 || b > 191) { return 0; }
    }
    return need + 1;
}

# Notes the defect `msg` at byte `pos` in flaw[0..2] (its offset, its message), unless an earlier one is noted.
fn _bj_jr_flaw(flaw, pos, msg) {
    if (load64(flaw) < 0) {
        store64(flaw, pos);
        store64(flaw + 8, msg);
    }
    return 0;
}

# One read-only pass over the JSON text [buf, buf + len) for what bayan's tree reads otherwise than serde_json:
# - the integer tokens outside strings that _bj_jr_int_odd names: their count is returned, and when `ends` is not 0
#   each one's end offset goes to ends[0..] (a number with a fraction or an exponent is bayan's to read as it is);
# - inside strings, a raw control character (U+0000..U+001F, which RFC 8259 §7 and serde_json refuse and bayan
#   takes) or bytes that are not UTF-8 (which a Rust `&str` can't hold): the first is noted in flaw[0..2].
# On a malformed document the pass may misread where strings are, but `.0` after a run of digits can't make a
# malformed document well formed, and bayan's own error comes first when it is earlier in the text.
fn _bj_jr_scan(buf, len, ends, flaw): i64 {
    var count = 0;
    var i = 0;
    while (i < len) {
        var c = load8(buf + i);
        if (c == 34) {
            i = i + 1;
            while (i < len) {
                var d = load8(buf + i);
                if (d == 34) { break; }
                if (d == 92) { i = i + 2; }
                elif (d < 32) {
                    _bj_jr_flaw(flaw, i, "a control character (U+0000..U+001F) in a string");
                    i = i + 1;
                } elif (d < 128) { i = i + 1; }
                else {
                    var u = _bj_jr_utf8(buf + i, len - i);
                    if (u == 0) {
                        _bj_jr_flaw(flaw, i, "invalid UTF-8 in a string");
                        u = 1;
                    }
                    i = i + u;
                }
            }
            i = i + 1;
        } elif (c == 45 || (c >= 48 && c <= 57)) {
            var s = i;
            if (c == 45) { i = i + 1; }
            var ds = i - s;
            while (i < len && load8(buf + i) >= 48 && load8(buf + i) <= 57) { i = i + 1; }
            var e = i;
            var g = 0;
            if (i < len) { g = load8(buf + i); }
            if (g == 46 || g == 101 || g == 69) {
                while (i < len) {
                    var h = load8(buf + i);
                    if ((h >= 48 && h <= 57) || h == 46 || h == 101 || h == 69 || h == 43 || h == 45) { i = i + 1; }
                    else { break; }
                }
            } elif (e > s + ds && _bj_jr_int_odd(buf + s, e - s, ds) == 1) {
                if (ends != 0) { store64(ends + count * 8, e); }
                count = count + 1;
            }
        } else {
            i = i + 1;
        }
    }
    return count;
}

# Records a syntax error: bayan's message at byte `pos` of the caller's text. Returns BJ_ERR_DESERIALIZE.
fn _bj_jr_syntax(msg, pos): i64 {
    var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
    _bj_tx_cstr(t, msg);
    _bj_tx_cstr(t, " at byte ");
    _bj_tx_i64(t, pos);
    return BJ_ERR_DESERIALIZE;
}

# The value tree of the JSON text [buf, buf + len), on the region whose allocator is `a`, or 0 with the error
# recorded (BJ_ERR_DESERIALIZE; BJ_ERR_ALLOCATION when the region can't grow). Of a string defect the scan noted and
# bayan's own error, the earlier in the text is reported.
fn _bj_jr_doc(a, buf, len): i64 {
    if (buf == 0 || len < 0) {
        _bj_jr_syntax("no document", 0);
        return 0;
    }
    var flaw: i64[2];
    flaw[0] = 0 - 1;
    flaw[1] = 0;
    var text = buf;
    var tlen = len;
    var ends = 0;
    var odd = _bj_jr_scan(buf, len, 0, &flaw);
    if (odd > 0) {
        ends = alloc_via(a, odd * 8);
        tlen = len + odd * 2;
        text = alloc_via(a, tlen);
        if (ends == 0 || text == 0) {
            var t = _bj_err_reason(BJ_ERR_ALLOCATION);
            _bj_tx_cstr(t, "the JSON reader's decode region can't grow");
            return 0;
        }
        _bj_jr_scan(buf, len, ends, &flaw);
        var from = 0;
        var to = 0;
        for (var k = 0; k < odd; k = k + 1) {
            var e = load64(ends + k * 8);
            memcpy(text + to, buf + from, e - from);
            to = to + e - from;
            store8(text + to, 46);
            store8(text + to + 1, 48);
            to = to + 2;
            from = e;
        }
        memcpy(text + to, buf + from, len - from);
    }
    var ps[48];
    var v = bayan_json_v_parse_ctx_a(a, &ps, text, tlen);
    if (v != 0) {
        if (flaw[0] < 0) { return v; }
        _bj_jr_syntax(flaw[1], flaw[0]);
        return 0;
    }
    var msg = bayan_json_state_error(&ps);
    var pos = bayan_json_state_error_pos(&ps);
    # A position in the rewritten text, back in the caller's: two bytes fewer for each `.0` before it.
    if (odd > 0) {
        var shift = 0;
        for (var j = 0; j < odd; j = j + 1) {
            if (load64(ends + j * 8) + shift + 2 <= pos) { shift = shift + 2; }
        }
        pos = pos - shift;
    }
    if (_bj_jr_starts(msg, "out of memory") == 1) {
        var t2 = _bj_err_reason(BJ_ERR_ALLOCATION);
        _bj_tx_cstr(t2, "the JSON reader's decode region can't grow");
        return 0;
    }
    if (flaw[0] >= 0 && flaw[0] < pos) {
        _bj_jr_syntax(flaw[1], flaw[0]);
        return 0;
    }
    _bj_jr_syntax(msg, pos);
    return 0;
}

# 1 when the C string s starts with the C string p.
#must_use
fn _bj_jr_starts(s, p): i64 {
    var k = 0;
    while (load8(p + k) != 0) {
        if (load8(s + k) != load8(p + k)) { return 0; }
        k = k + 1;
    }
    return 1;
}

# ── values ──────────────────────────────────────────────────────────────────────────

# serde's name for the JSON type of node v, as its "invalid type" message gives it.
#must_use
fn _bj_jr_kind(v): i64 {
    var tag = bayan_json_v_tag(v);
    if (tag == JTAG_NULL) { return "null"; }
    if (tag == JTAG_BOOL) { return "boolean"; }
    if (tag == JTAG_INT) { return "integer"; }
    if (tag == JTAG_FLOAT) { return "floating point"; }
    if (tag == JTAG_STR) { return "string"; }
    if (tag == JTAG_ARR) { return "sequence"; }
    return "map";
}

# Records `invalid type: <kind of v>, expected <what>`. Returns BJ_ERR_DESERIALIZE.
fn _bj_jr_type(v, what): i64 {
    var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
    _bj_tx_cstr(t, "invalid type: ");
    _bj_tx_cstr(t, _bj_jr_kind(v));
    _bj_tx_cstr(t, ", expected ");
    _bj_tx_cstr(t, what);
    return BJ_ERR_DESERIALIZE;
}

# Records `invalid length <n>, expected <what>`. Returns BJ_ERR_DESERIALIZE.
fn _bj_jr_length(n, what): i64 {
    var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
    _bj_tx_cstr(t, "invalid length ");
    _bj_tx_i64(t, n);
    _bj_tx_cstr(t, ", expected ");
    _bj_tx_cstr(t, what);
    return BJ_ERR_DESERIALIZE;
}

# Records `missing field `<name>``. Returns BJ_ERR_DESERIALIZE.
fn _bj_jr_missing(name): i64 {
    var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
    _bj_tx_cstr(t, "missing field `");
    _bj_tx_cstr(t, name);
    _bj_tx_putc(t, 96);
    return BJ_ERR_DESERIALIZE;
}

# Node v as an f64 into *out: 0, or BJ_ERR_DESERIALIZE recorded. An integer converts to the nearest f64 (exact below
# 2^53, as serde's `n as f64`); a float is bayan's correctly rounded parse, refused when it overflowed.
fn _bj_jr_f64(v, out): i64 {
    var tag = bayan_json_v_tag(v);
    if (tag != JTAG_INT && tag != JTAG_FLOAT) { return _bj_jr_type(v, "f64"); }
    var bits = bayan_json_v_float(v);
    if ((bits & 0x7FF0000000000000) == 0x7FF0000000000000) {
        var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
        _bj_tx_cstr(t, "number out of range");
        return BJ_ERR_DESERIALIZE;
    }
    store64(out, bits);
    return 0;
}

# Node v as a Rust `[T; n]`: 0 when it is an array of exactly n elements, or BJ_ERR_DESERIALIZE recorded (`what` is
# serde's "an array of length n").
fn _bj_jr_array(v, n, what): i64 {
    if (bayan_json_v_tag(v) != JTAG_ARR) { return _bj_jr_type(v, what); }
    var k = bayan_json_v_arr_len(v);
    if (k != n) { return _bj_jr_length(k, what); }
    return 0;
}

# Node v as a `[f64; n]` into out[0..n]: an array of exactly n numbers. 0, or BJ_ERR_DESERIALIZE recorded.
fn _bj_jr_f64s(v, n, what, out): i64 {
    var c = _bj_jr_array(v, n, what);
    if (c != 0) { return c; }
    for (var k = 0; k < n; k = k + 1) {
        c = _bj_jr_f64(bayan_json_v_arr_get(v, k), out + k * 8);
        if (c != 0) { return c; }
    }
    return 0;
}

# The form of struct node v with n fields: 1 an object, 2 an array of exactly n elements (serde's sequence form), or
# 0 with BJ_ERR_DESERIALIZE recorded (`what` names the struct: "struct FieldVector").
fn _bj_jr_form(v, n, what): i64 {
    var tag = bayan_json_v_tag(v);
    if (tag == JTAG_OBJ) { return 1; }
    if (tag != JTAG_ARR) {
        _bj_jr_type(v, what);
        return 0;
    }
    var k = bayan_json_v_arr_len(v);
    if (k != n) {
        var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
        _bj_tx_cstr(t, "invalid length ");
        _bj_tx_i64(t, k);
        _bj_tx_cstr(t, ", expected ");
        _bj_tx_cstr(t, what);
        _bj_tx_cstr(t, " with ");
        _bj_tx_i64(t, n);
        _bj_tx_cstr(t, " elements");
        return 0;
    }
    return 2;
}

# Field i, named `name`, of struct node v in `form`: its node, or 0 with `missing field` recorded.
fn _bj_jr_field(v, form, i, name): i64 {
    var f = 0;
    if (form == 1) { f = bayan_json_v_obj_get_by_cstr(v, name); }
    else { f = bayan_json_v_arr_get(v, i); }
    if (f == 0) { _bj_jr_missing(name); }
    return f;
}

# Struct node v whose n fields, named names[0..n], are all f64, into out[0..n]. 0, or the code recorded.
fn _bj_jr_f64_struct(v, names, n, what, out): i64 {
    var form = _bj_jr_form(v, n, what);
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    for (var k = 0; k < n; k = k + 1) {
        var f = _bj_jr_field(v, form, k, load64(names + k * 8));
        if (f == 0) { return BJ_ERR_DESERIALIZE; }
        var c = _bj_jr_f64(f, out + k * 8);
        if (c != 0) { return c; }
    }
    return 0;
}

# Reads the document [buf, buf + len) with decoder `dec(node, words)` into the n words at w: 0, or the code recorded.
fn _bj_jr_read(buf, len, dec, w): i64 {
    var rg[64];
    var a = _bj_jr_open(&rg);
    var code = BJ_ERR_DESERIALIZE;
    var v = _bj_jr_doc(a, buf, len);
    if (v != 0) { code = fncall2(dec, v, w); }
    else { code = bj_last_error(); }
    _bj_jr_close(&rg);
    return code;
}

# The decoders, each from a node into words.
fn _bj_jr_complex(v, w): i64 {
    var names: i64[2];
    names[0] = "re";
    names[1] = "im";
    return _bj_jr_f64_struct(v, &names, 2, "struct Complex", w);
}

fn _bj_jr_field_vector(v, w): i64 {
    var names: i64[3];
    names[0] = "x";
    names[1] = "y";
    names[2] = "z";
    return _bj_jr_f64_struct(v, &names, 3, "struct FieldVector", w);
}

fn _bj_jr_material(v, w): i64 {
    var names: i64[3];
    names[0] = "eps_r";
    names[1] = "mu_r";
    names[2] = "conductivity";
    return _bj_jr_f64_struct(v, &names, 3, "struct Material", w);
}

fn _bj_jr_point_charge(v, w): i64 {
    var form = _bj_jr_form(v, 4, "struct PointCharge");
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    var f = _bj_jr_field(v, form, 0, "charge");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    var c = _bj_jr_f64(f, w);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 1, "mass");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    c = _bj_jr_f64(f, w + 8);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 2, "position");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    c = _bj_jr_f64s(f, 3, "an array of length 3", w + 16);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 3, "velocity");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    return _bj_jr_f64s(f, 3, "an array of length 3", w + 40);
}

# The one field, named `name`, of struct node v (`what` names the struct): its node, or 0 with the reason recorded.
fn _bj_jr_only(v, name, what): i64 {
    var form = _bj_jr_form(v, 1, what);
    if (form == 0) { return 0; }
    return _bj_jr_field(v, form, 0, name);
}

fn _bj_jr_jones_vector(v, w): i64 {
    var form = _bj_jr_form(v, 2, "struct JonesVector");
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    var f = _bj_jr_field(v, form, 0, "x");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    var c = _bj_jr_complex(f, w);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 1, "y");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    return _bj_jr_complex(f, w + 16);
}

# `m: [[Complex; 2]; 2]` into w row by row, as BjJonesMatrix's m00, m01, m10, m11.
fn _bj_jr_jones_matrix(v, w): i64 {
    var m = _bj_jr_only(v, "m", "struct JonesMatrix");
    if (m == 0) { return BJ_ERR_DESERIALIZE; }
    var c = _bj_jr_array(m, 2, "an array of length 2");
    if (c != 0) { return c; }
    for (var r = 0; r < 2; r = r + 1) {
        var row = bayan_json_v_arr_get(m, r);
        c = _bj_jr_array(row, 2, "an array of length 2");
        if (c != 0) { return c; }
        for (var k = 0; k < 2; k = k + 1) {
            c = _bj_jr_complex(bayan_json_v_arr_get(row, k), w + (r * 2 + k) * 16);
            if (c != 0) { return c; }
        }
    }
    return 0;
}

fn _bj_jr_stokes(v, w): i64 {
    var s = _bj_jr_only(v, "s", "struct StokesVector");
    if (s == 0) { return BJ_ERR_DESERIALIZE; }
    return _bj_jr_f64s(s, 4, "an array of length 4", w);
}

# Node v as a `Vec<Complex>` into out[0] (the address of its elements, from fl_alloc; 0 when empty) and out[1] (its
# length): an array of any length. The block is stored before its elements are read, so the caller frees it on a
# failure. 0, or the code recorded (BJ_ERR_ALLOCATION when the block can't be had).
fn _bj_jr_cvec(v, out): i64 {
    if (bayan_json_v_tag(v) != JTAG_ARR) { return _bj_jr_type(v, "a sequence"); }
    var n = bayan_json_v_arr_len(v);
    var p = 0;
    if (n > 0) {
        p = fl_alloc(n * 16);
        if (p == 0) {
            _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "the Mie coefficients read");
            return BJ_ERR_ALLOCATION;
        }
    }
    store64(out, p);
    store64(out + 8, n);
    for (var k = 0; k < n; k = k + 1) {
        var c = _bj_jr_complex(bayan_json_v_arr_get(v, k), p + k * 16);
        if (c != 0) { return c; }
    }
    return 0;
}

# A MieResult into w: q_sca, q_ext, q_abs, g, then a's block and length, then b's (w[4] and w[6] are 0 on entry).
fn _bj_jr_mie(v, w): i64 {
    var form = _bj_jr_form(v, 6, "struct MieResult");
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    var names: i64[4];
    names[0] = "q_sca";
    names[1] = "q_ext";
    names[2] = "q_abs";
    names[3] = "g";
    for (var k = 0; k < 4; k = k + 1) {
        var f = _bj_jr_field(v, form, k, names[k]);
        if (f == 0) { return BJ_ERR_DESERIALIZE; }
        var c = _bj_jr_f64(f, w + k * 8);
        if (c != 0) { return c; }
    }
    var fa = _bj_jr_field(v, form, 4, "a");
    if (fa == 0) { return BJ_ERR_DESERIALIZE; }
    var ca = _bj_jr_cvec(fa, w + 32);
    if (ca != 0) { return ca; }
    var fb = _bj_jr_field(v, form, 5, "b");
    if (fb == 0) { return BJ_ERR_DESERIALIZE; }
    return _bj_jr_cvec(fb, w + 48);
}

# `m: [[f64; 4]; 4]` into w row by row, as BjMuellerMatrix's row-major m.
fn _bj_jr_mueller(v, w): i64 {
    var m = _bj_jr_only(v, "m", "struct MuellerMatrix");
    if (m == 0) { return BJ_ERR_DESERIALIZE; }
    var c = _bj_jr_array(m, 4, "an array of length 4");
    if (c != 0) { return c; }
    for (var r = 0; r < 4; r = r + 1) {
        c = _bj_jr_f64s(bayan_json_v_arr_get(m, r), 4, "an array of length 4", w + r * 32);
        if (c != 0) { return c; }
    }
    return 0;
}

fn _bj_jr_gaussian_beam(v, w): i64 {
    var names: i64[3];
    names[0] = "wavelength";
    names[1] = "waist";
    names[2] = "rayleigh_range";
    return _bj_jr_f64_struct(v, &names, 3, "struct GaussianBeam", w);
}

fn _bj_jr_abcd(v, w): i64 {
    var names: i64[4];
    names[0] = "a";
    names[1] = "b";
    names[2] = "c";
    names[3] = "d";
    return _bj_jr_f64_struct(v, &names, 4, "struct AbcdMatrix", w);
}

# Node v as a bool into *out, 1 for `true` and 0 for `false`: JSON's two literals only, as serde reads a bool (never
# a number, a string or null). 0, or BJ_ERR_DESERIALIZE recorded.
fn _bj_jr_bool(v, out): i64 {
    if (bayan_json_v_tag(v) != JTAG_BOOL) { return _bj_jr_type(v, "a boolean"); }
    store64(out, bayan_json_v_bool(v));
    return 0;
}

# A ResonatorStability into w: g1, g2, g_product, then is_stable as 1 or 0.
fn _bj_jr_resonator(v, w): i64 {
    var form = _bj_jr_form(v, 4, "struct ResonatorStability");
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    var names: i64[3];
    names[0] = "g1";
    names[1] = "g2";
    names[2] = "g_product";
    for (var k = 0; k < 3; k = k + 1) {
        var f = _bj_jr_field(v, form, k, names[k]);
        if (f == 0) { return BJ_ERR_DESERIALIZE; }
        var c = _bj_jr_f64(f, w + k * 8);
        if (c != 0) { return c; }
    }
    var fs = _bj_jr_field(v, form, 3, "is_stable");
    if (fs == 0) { return BJ_ERR_DESERIALIZE; }
    return _bj_jr_bool(fs, w + 24);
}

# ── readers ─────────────────────────────────────────────────────────────────────────

# Reads a `Complex` document from [buf, buf + len) into *out: Ok(0), or Err(BJ_ERR_DESERIALIZE) (BJ_ERR_ALLOCATION
# when the decode region can't grow) with the reason recorded and out untouched. Mirrors
# `serde_json::from_str::<Complex>` for Rust hisab's `Complex`.
#must_use
public fn BjComplex_from_json(buf, len, out: *BjComplex): Result {
    var w: f64[2];
    var code = _bj_jr_read(buf, len, &_bj_jr_complex, &w);
    if (code != 0) { return Err(code); }
    out.re = w[0];
    out.im = w[1];
    return Ok(0);
}

# Reads a `FieldVector` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched,
# as BjComplex_from_json. Mirrors `serde_json::from_str::<FieldVector>`.
#must_use
public fn BjFieldVector_from_json(buf, len, out: *BjFieldVector): Result {
    var w: f64[3];
    var code = _bj_jr_read(buf, len, &_bj_jr_field_vector, &w);
    if (code != 0) { return Err(code); }
    out.x = w[0];
    out.y = w[1];
    out.z = w[2];
    return Ok(0);
}

# Reads a `PointCharge` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched,
# as BjComplex_from_json. Mirrors `serde_json::from_str::<PointCharge>`.
#must_use
public fn BjPointCharge_from_json(buf, len, out: *BjPointCharge): Result {
    var w: f64[8];
    var code = _bj_jr_read(buf, len, &_bj_jr_point_charge, &w);
    if (code != 0) { return Err(code); }
    out.charge = w[0];
    out.mass = w[1];
    out.position = (w[2], w[3], w[4]);
    out.velocity = (w[5], w[6], w[7]);
    return Ok(0);
}

# Reads a `Material` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched, as
# BjComplex_from_json. Any ε_r, μ_r and σ are read as written, as serde's derive reads Rust's public fields. Mirrors
# `serde_json::from_str::<Material>`.
#must_use
public fn BjMaterial_from_json(buf, len, out: *BjMaterial): Result {
    var w: f64[3];
    var code = _bj_jr_read(buf, len, &_bj_jr_material, &w);
    if (code != 0) { return Err(code); }
    out.eps_r = w[0];
    out.mu_r = w[1];
    out.conductivity = w[2];
    return Ok(0);
}

# Reads a `JonesVector` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched, as
# BjComplex_from_json. Each of x and y is a Complex in either of serde's forms. Mirrors
# `serde_json::from_str::<JonesVector>`.
#must_use
public fn BjJonesVector_from_json(buf, len, out: *BjJonesVector): Result {
    var w: f64[4];
    var code = _bj_jr_read(buf, len, &_bj_jr_jones_vector, &w);
    if (code != 0) { return Err(code); }
    memcpy(out, &w, 32);
    return Ok(0);
}

# Reads a `JonesMatrix` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched, as
# BjComplex_from_json. `m` is two rows of two Complex; Rust's `m[r][c]` is out's m<r><c>. Mirrors
# `serde_json::from_str::<JonesMatrix>`.
#must_use
public fn BjJonesMatrix_from_json(buf, len, out: *BjJonesMatrix): Result {
    var w: f64[8];
    var code = _bj_jr_read(buf, len, &_bj_jr_jones_matrix, &w);
    if (code != 0) { return Err(code); }
    memcpy(out, &w, 64);
    return Ok(0);
}

# Reads a `StokesVector` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched,
# as BjComplex_from_json. Any four numbers are read as written, as serde's derive reads Rust's public field. Mirrors
# `serde_json::from_str::<StokesVector>`.
#must_use
public fn BjStokesVector_from_json(buf, len, out: *BjStokesVector): Result {
    var w: f64[4];
    var code = _bj_jr_read(buf, len, &_bj_jr_stokes, &w);
    if (code != 0) { return Err(code); }
    memcpy(out, &w, 32);
    return Ok(0);
}

# Reads a `MuellerMatrix` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched,
# as BjComplex_from_json. `m` is four rows of four numbers. Mirrors `serde_json::from_str::<MuellerMatrix>`.
#must_use
public fn BjMuellerMatrix_from_json(buf, len, out: *BjMuellerMatrix): Result {
    var w: f64[16];
    var code = _bj_jr_read(buf, len, &_bj_jr_mueller, &w);
    if (code != 0) { return Err(code); }
    memcpy(out, &w, 128);
    return Ok(0);
}

# Reads a `MieResult` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched, as
# BjComplex_from_json (and any coefficients read so far given back). `a` and `b` are arrays of any length, each
# element a Complex in either of serde's forms, so out's lengths may differ, as Rust's public fields may. out gets new
# coefficient blocks and is never read: free a previous result first (BjMieResult_free). Mirrors
# `serde_json::from_str::<MieResult>`.
#must_use
public fn BjMieResult_from_json(buf, len, out: *BjMieResult): Result {
    var w: i64[8];
    w[4] = 0;
    w[5] = 0;
    w[6] = 0;
    w[7] = 0;
    var code = _bj_jr_read(buf, len, &_bj_jr_mie, &w);
    if (code != 0) {
        if (w[4] != 0) { fl_free(w[4]); }
        if (w[6] != 0) { fl_free(w[6]); }
        return Err(code);
    }
    memcpy(out, &w, 64);
    return Ok(0);
}

# Reads a `GaussianBeam` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched, as
# BjComplex_from_json. The three fields are read as written, as serde's derive reads Rust's public fields: a beam
# BjGaussianBeam_new would refuse is read, and z_R is the document's, not recomputed from λ and w₀. Mirrors
# `serde_json::from_str::<GaussianBeam>`.
#must_use
public fn BjGaussianBeam_from_json(buf, len, out: *BjGaussianBeam): Result {
    var w: f64[3];
    var code = _bj_jr_read(buf, len, &_bj_jr_gaussian_beam, &w);
    if (code != 0) { return Err(code); }
    memcpy(out, &w, 24);
    return Ok(0);
}

# Reads an `AbcdMatrix` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched, as
# BjComplex_from_json. Any four numbers are read as written. Mirrors `serde_json::from_str::<AbcdMatrix>`.
#must_use
public fn BjAbcdMatrix_from_json(buf, len, out: *BjAbcdMatrix): Result {
    var w: f64[4];
    var code = _bj_jr_read(buf, len, &_bj_jr_abcd, &w);
    if (code != 0) { return Err(code); }
    memcpy(out, &w, 32);
    return Ok(0);
}

# Reads a `ResonatorStability` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out
# untouched, as BjComplex_from_json. `is_stable` must be `true` (read as 1) or `false` (0); the fields are read as
# written, so an `is_stable` that disagrees with g₁g₂ is kept, as serde's derive keeps Rust's public fields. Mirrors
# `serde_json::from_str::<ResonatorStability>`.
#must_use
public fn BjResonatorStability_from_json(buf, len, out: *BjResonatorStability): Result {
    var w: i64[4];
    var code = _bj_jr_read(buf, len, &_bj_jr_resonator, &w);
    if (code != 0) { return Err(code); }
    memcpy(out, &w, 32);
    return Ok(0);
}

# ── rf's three types (M4 part 1d) ───────────────────────────────────────────────────────────────────────────────

# Node v as a usize into *out: an integer node, 0 or above. serde reads an integer of ASCII digits up to u64::MAX; the
# port's word is an i64, so a count past 2^63 − 1 (a float node after the pre-pass) is refused with a float, which no
# matrix could hold (ADR 0002 row 36). 0, or BJ_ERR_DESERIALIZE recorded.
fn _bj_jr_usize(v, out): i64 {
    if (bayan_json_v_tag(v) != JTAG_INT) { return _bj_jr_type(v, "usize"); }
    var x = bayan_json_v_int(v);
    if (x < 0) {
        var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
        _bj_tx_cstr(t, "invalid value: integer `");
        _bj_tx_i64(t, x);
        _bj_tx_cstr(t, "`, expected usize");
        return BJ_ERR_DESERIALIZE;
    }
    store64(out, x);
    return 0;
}

# Records the ADR 0002 row 36 refusal: a shape the port's fixed structs can't hold. Returns BJ_ERR_DESERIALIZE.
fn _bj_jr_shape(what): i64 {
    var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
    _bj_tx_cstr(t, what);
    _bj_tx_cstr(t, " (its shape is fixed: ADR 0002 row 36)");
    return BJ_ERR_DESERIALIZE;
}

# An SMatrix node's port count and its `s` and `z0` nodes into w[0..3], with its shape checked: s an array of ports
# arrays of ports elements, z0 an array of ports elements, and the port count `want` unless want is -1. 0, or
# BJ_ERR_DESERIALIZE recorded (a wrong type, or row 36's shape).
fn _bj_jr_sm_check(v, want, w: *i64): i64 {
    var form = _bj_jr_form(v, 3, "struct SMatrix");
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    var fp = _bj_jr_field(v, form, 0, "ports");
    if (fp == 0) { return BJ_ERR_DESERIALIZE; }
    var c = _bj_jr_usize(fp, w);
    if (c != 0) { return c; }
    var fs = _bj_jr_field(v, form, 1, "s");
    if (fs == 0) { return BJ_ERR_DESERIALIZE; }
    var fz = _bj_jr_field(v, form, 2, "z0");
    if (fz == 0) { return BJ_ERR_DESERIALIZE; }
    if (bayan_json_v_tag(fs) != JTAG_ARR) { return _bj_jr_type(fs, "a sequence"); }
    if (bayan_json_v_tag(fz) != JTAG_ARR) { return _bj_jr_type(fz, "a sequence"); }
    var p = w[0];
    var rows = bayan_json_v_arr_len(fs);
    for (var r = 0; r < rows; r = r + 1) {
        var row = bayan_json_v_arr_get(fs, r);
        if (bayan_json_v_tag(row) != JTAG_ARR) { return _bj_jr_type(row, "a sequence"); }
        if (bayan_json_v_arr_len(row) != p) { return _bj_jr_shape("an SMatrix row is not ports long"); }
    }
    if (rows != p) { return _bj_jr_shape("an SMatrix's s does not have ports rows"); }
    if (bayan_json_v_arr_len(fz) != p) { return _bj_jr_shape("an SMatrix's z0 is not ports long"); }
    if (want >= 0 && p != want) { return _bj_jr_shape("a TouchstoneData matrix's ports differ from the data's"); }
    w[1] = fs;
    w[2] = fz;
    return 0;
}

# The entries and impedances of a checked SMatrix node (its s and z0 nodes) into the matrix m: 0, or the code
# recorded.
fn _bj_jr_sm_fill(fs, fz, m: *BjSMatrix): i64 {
    var p = m.ports;
    for (var r = 0; r < p; r = r + 1) {
        var row = bayan_json_v_arr_get(fs, r);
        for (var c = 0; c < p; c = c + 1) {
            var e = _bj_jr_complex(bayan_json_v_arr_get(row, c), m.s + (r * p + c) * 16);
            if (e != 0) { return e; }
        }
    }
    for (var k = 0; k < p; k = k + 1) {
        var e2 = _bj_jr_f64(bayan_json_v_arr_get(fz, k), m.z0 + k * 8);
        if (e2 != 0) { return e2; }
    }
    return 0;
}

# A whole SMatrix document's node into a new matrix at w (a BjSMatrix): 0, or the code recorded with nothing kept.
fn _bj_jr_smatrix(v, w): i64 {
    var nodes: i64[3];
    var c = _bj_jr_sm_check(v, 0 - 1, &nodes);
    if (c != 0) { return c; }
    var t, e = BjSMatrix_new(nodes[0], 0.0, w);
    if (is_err_result(t) == 1) { return e; }
    var f = _bj_jr_sm_fill(nodes[1], nodes[2], w);
    if (f != 0) { BjSMatrix_free(w); }
    return f;
}

# A TouchstoneFormat node into w[0]: a string, or a one-member object whose value is null (serde's two forms of a
# unit variant), naming one of the three variants. 0, or BJ_ERR_DESERIALIZE recorded.
fn _bj_jr_ts_format(v, w): i64 {
    var tag = bayan_json_v_tag(v);
    var name = 0;
    if (tag == JTAG_STR) { name = bayan_json_v_str(v); }
    elif (tag == JTAG_OBJ && bayan_json_v_obj_len(v) == 1) {
        if (bayan_json_v_tag(bayan_json_v_obj_val(v, 0)) != JTAG_NULL) {
            return _bj_jr_type(bayan_json_v_obj_val(v, 0), "unit");
        }
        name = bayan_json_v_obj_key(v, 0);
    } else {
        return _bj_jr_type(v, "enum TouchstoneFormat");
    }
    for (var k = 0; k < 3; k = k + 1) {
        var lit = _bj_ts_format_name(k);
        if (str_len(name) == strlen(lit) && memeq(str_data(name), lit, strlen(lit)) == 1) {
            store64(w, k);
            return 0;
        }
    }
    var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
    _bj_tx_cstr(t, "unknown variant, expected one of `MagnitudeAngle`, `RealImag`, `DbAngle`");
    return BJ_ERR_DESERIALIZE;
}

# The address a as a *BjTouchstoneData (an untyped word stored into a typed pointer warns; a typed return does not).
#must_use
fn _bj_jr_tdp(a): *BjTouchstoneData {
    return a;
}

# A TouchstoneData document's node into new data at w (a BjTouchstoneData): its fields, then row 36's shape (as many
# matrices as frequencies, each a checked ports-port matrix), then the block, filled. 0, or the code recorded with
# nothing kept.
fn _bj_jr_ts_data(v, w): i64 {
    var form = _bj_jr_form(v, 4, "struct TouchstoneData");
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    var hdr: i64[1];
    var fp = _bj_jr_field(v, form, 0, "ports");
    if (fp == 0) { return BJ_ERR_DESERIALIZE; }
    var c = _bj_jr_usize(fp, &hdr);
    if (c != 0) { return c; }
    var fz = _bj_jr_field(v, form, 1, "z0");
    if (fz == 0) { return BJ_ERR_DESERIALIZE; }
    var zb: i64[1];
    c = _bj_jr_f64(fz, &zb);
    if (c != 0) { return c; }
    var ff = _bj_jr_field(v, form, 2, "frequencies");
    if (ff == 0) { return BJ_ERR_DESERIALIZE; }
    if (bayan_json_v_tag(ff) != JTAG_ARR) { return _bj_jr_type(ff, "a sequence"); }
    var fm = _bj_jr_field(v, form, 3, "s_matrices");
    if (fm == 0) { return BJ_ERR_DESERIALIZE; }
    if (bayan_json_v_tag(fm) != JTAG_ARR) { return _bj_jr_type(fm, "a sequence"); }
    var points = bayan_json_v_arr_len(ff);
    var junk: f64[1];
    for (var k = 0; k < points; k = k + 1) {
        c = _bj_jr_f64(bayan_json_v_arr_get(ff, k), &junk);
        if (c != 0) { return c; }
    }
    var nodes: i64[3];
    var mats = bayan_json_v_arr_len(fm);
    for (var j = 0; j < mats; j = j + 1) {
        c = _bj_jr_sm_check(bayan_json_v_arr_get(fm, j), hdr[0], &nodes);
        if (c != 0) { return c; }
    }
    if (mats != points) { return _bj_jr_shape("a TouchstoneData's frequencies and matrices differ in number"); }
    var z0: f64 = _bj_from_bits(zb[0]);
    var t, e = BjTouchstoneData_new(hdr[0], z0, points, w);
    if (is_err_result(t) == 1) { return e; }
    var d: *BjTouchstoneData = _bj_jr_tdp(w);
    for (var q = 0; q < points; q = q + 1) {
        _bj_jr_f64(bayan_json_v_arr_get(ff, q), d.frequencies + q * 8);
        _bj_jr_sm_check(bayan_json_v_arr_get(fm, q), hdr[0], &nodes);
        c = _bj_jr_sm_fill(nodes[1], nodes[2], d.matrix_at(q));
        if (c != 0) {
            BjTouchstoneData_free(d);
            return c;
        }
    }
    return 0;
}

# Reads an `SMatrix` document from [buf, buf + len) into a new matrix in *out: Ok(0), or Err with the reason recorded
# and out untouched (and never read), as BjComplex_from_json. Its shape is fixed (ADR 0002 row 36): `s` must be
# ports rows of ports entries and `z0` ports long, where serde reads any lengths (and a port count past 2^63 − 1, which
# no matrix holds, is refused). Give the matrix back with BjSMatrix_free. Mirrors `serde_json::from_str::<SMatrix>`.
#must_use
public fn BjSMatrix_from_json(buf, len, out: *BjSMatrix): Result {
    var m: BjSMatrix;
    var code = _bj_jr_read(buf, len, &_bj_jr_smatrix, &m);
    if (code != 0) { return Err(code); }
    out.ports = m.ports;
    out.s = m.s;
    out.z0 = m.z0;
    return Ok(0);
}

# Reads a `TouchstoneFormat` document from [buf, buf + len) into *out (BJ_TOUCHSTONE_FORMAT_*): Ok(0), or Err with
# the reason recorded and out untouched. serde's two forms of a unit variant: its name as a string, or a one-member
# object mapping the name to null. Mirrors `serde_json::from_str::<TouchstoneFormat>`.
#must_use
public fn BjTouchstoneFormat_from_json(buf, len, out: *i64): Result {
    var w: i64[1];
    var code = _bj_jr_read(buf, len, &_bj_jr_ts_format, &w);
    if (code != 0) { return Err(code); }
    out[0] = w[0];
    return Ok(0);
}

# Reads a `TouchstoneData` document from [buf, buf + len) into new data in *out: Ok(0), or Err with the reason
# recorded and out untouched (and never read), as BjComplex_from_json. Its shape is fixed (ADR 0002 row 36): as many
# matrices as frequencies, each a ports-port SMatrix of the data's ports, where serde reads any. Give the data back
# with BjTouchstoneData_free. Mirrors `serde_json::from_str::<TouchstoneData>`.
#must_use
public fn BjTouchstoneData_from_json(buf, len, out: *BjTouchstoneData): Result {
    var d: BjTouchstoneData;
    var code = _bj_jr_read(buf, len, &_bj_jr_ts_data, &d);
    if (code != 0) { return Err(code); }
    out.ports = d.ports;
    out.z0 = d.z0;
    out.points = d.points;
    out.frequencies = d.frequencies;
    out.s_matrices = d.s_matrices;
    return Ok(0);
}

# ── the FDTD types (M5 part 1f) ──────────────────────────────────────────────────────────────────────────────────

# Appends the n f64 at p as `[a,b,..]`; the new length.
fn _bj_jw_f64_vec(buf, n, p, k): i64 {
    var m = n;
    store8(buf + m, 91);
    m = m + 1;
    for (var j = 0; j < k; j = j + 1) {
        if (j > 0) {
            store8(buf + m, 44);
            m = m + 1;
        }
        m = _bj_jw_f64(buf, m, load64(p + j * 8));
    }
    store8(buf + m, 93);
    return m + 1;
}

# Appends `{"<k0>":[..],"<k1>":[..],"<k2>":[..]}` (three Vec<f64>, the keys' text with their quotes and colons at
# keys[0..3]) to sb, built in one fl_alloc block of 64 + 26 bytes a value (an f64 at most 25, and its comma): Ok(0), or
# Err(BJ_ERR_ALLOCATION) with sb as it was.
fn _bj_jw_three_vecs(sb, keys: *i64, p: *i64, k: *i64): Result {
    var buf = fl_alloc(64 + (k[0] + k[1] + k[2]) * 26);
    if (buf == 0) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "the JSON document's buffer");
        return Err(BJ_ERR_ALLOCATION);
    }
    var n = _bj_jw_cstr(buf, 0, "{");
    for (var f = 0; f < 3; f = f + 1) {
        if (f > 0) { n = _bj_jw_cstr(buf, n, ","); }
        n = _bj_jw_cstr(buf, n, keys[f]);
        n = _bj_jw_f64_vec(buf, n, p[f], k[f]);
    }
    n = _bj_jw_cstr(buf, n, "}");
    var t, v = _bj_jw_put(sb, buf, n);
    fl_free(buf);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(0);
}

# Appends `{"eps_r":<ε_r>,"conductivity":<σ>}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was.
# Mirrors `serde_json::to_string(&m)` for `fdtd::LossyMaterial`.
#must_use
public fn BjLossyMaterial_to_json(m: *BjLossyMaterial, sb): Result {
    var buf[96];
    var n = _bj_jw_cstr(&buf, 0, "{\"eps_r\":");
    n = _bj_jw_f64(&buf, n, m.eps_r);
    n = _bj_jw_cstr(&buf, n, ",\"conductivity\":");
    n = _bj_jw_f64(&buf, n, m.conductivity);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"eps_inf":<ε_∞>,"omega_p":<ω_p>,"gamma":<γ>}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb
# as it was. Mirrors `serde_json::to_string(&m)` for `fdtd::DrudeMaterial`.
#must_use
public fn BjDrudeMaterial_to_json(m: *BjDrudeMaterial, sb): Result {
    var buf[128];
    var n = _bj_jw_cstr(&buf, 0, "{\"eps_inf\":");
    n = _bj_jw_f64(&buf, n, m.eps_inf);
    n = _bj_jw_cstr(&buf, n, ",\"omega_p\":");
    n = _bj_jw_f64(&buf, n, m.omega_p);
    n = _bj_jw_cstr(&buf, n, ",\"gamma\":");
    n = _bj_jw_f64(&buf, n, m.gamma);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"eps_inf":<ε_∞>,"delta_eps":<Δε>,"omega_0":<ω₀>,"gamma":<γ>}` to the builder sb: Ok(0), or
# Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors `serde_json::to_string(&m)` for `fdtd::LorentzMaterial`.
#must_use
public fn BjLorentzMaterial_to_json(m: *BjLorentzMaterial, sb): Result {
    var buf[160];
    var n = _bj_jw_cstr(&buf, 0, "{\"eps_inf\":");
    n = _bj_jw_f64(&buf, n, m.eps_inf);
    n = _bj_jw_cstr(&buf, n, ",\"delta_eps\":");
    n = _bj_jw_f64(&buf, n, m.delta_eps);
    n = _bj_jw_cstr(&buf, n, ",\"omega_0\":");
    n = _bj_jw_f64(&buf, n, m.omega_0);
    n = _bj_jw_cstr(&buf, n, ",\"gamma\":");
    n = _bj_jw_f64(&buf, n, m.gamma);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"eps_inf":<ε_∞>,"eps_s":<ε_s>,"tau":<τ>}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it
# was. Mirrors `serde_json::to_string(&m)` for `fdtd::DebyeMaterial`.
#must_use
public fn BjDebyeMaterial_to_json(m: *BjDebyeMaterial, sb): Result {
    var buf[128];
    var n = _bj_jw_cstr(&buf, 0, "{\"eps_inf\":");
    n = _bj_jw_f64(&buf, n, m.eps_inf);
    n = _bj_jw_cstr(&buf, n, ",\"eps_s\":");
    n = _bj_jw_f64(&buf, n, m.eps_s);
    n = _bj_jw_cstr(&buf, n, ",\"tau\":");
    n = _bj_jw_f64(&buf, n, m.tau);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"dx":[..],"dy":[..],"dz":[..]}` to the builder sb, each axis's widths in order: Ok(0), or
# Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors `serde_json::to_string(&g)` for `fdtd::NonUniformGrid`.
#must_use
public fn BjNonUniformGrid_to_json(g: *BjNonUniformGrid, sb): Result {
    var keys: i64[3];
    var p: i64[3];
    var k: i64[3];
    keys[0] = "\"dx\":";
    keys[1] = "\"dy\":";
    keys[2] = "\"dz\":";
    p[0] = g.dx;
    p[1] = g.dy;
    p[2] = g.dz;
    k[0] = g.nx;
    k[1] = g.ny;
    k[2] = g.nz;
    return _bj_jw_three_vecs(sb, &keys, &p, &k);
}

# Appends `{"frequencies":[..],"quality_factors":[..],"amplitudes":[..]}` to the builder sb, each of the result's count
# values: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors `serde_json::to_string(&r)` for
# `fdtd::EigenmodeResult`.
#must_use
public fn BjEigenmodeResult_to_json(r: *BjEigenmodeResult, sb): Result {
    var keys: i64[3];
    var p: i64[3];
    var k: i64[3];
    keys[0] = "\"frequencies\":";
    keys[1] = "\"quality_factors\":";
    keys[2] = "\"amplitudes\":";
    p[0] = r.frequencies;
    p[1] = r.quality_factors;
    p[2] = r.amplitudes;
    k[0] = r.count;
    k[1] = r.count;
    k[2] = r.count;
    return _bj_jw_three_vecs(sb, &keys, &p, &k);
}

# The decoders of the four materials, each an all-f64 struct.
fn _bj_jr_lossy(v, w): i64 {
    var names: i64[2];
    names[0] = "eps_r";
    names[1] = "conductivity";
    return _bj_jr_f64_struct(v, &names, 2, "struct LossyMaterial", w);
}

fn _bj_jr_drude(v, w): i64 {
    var names: i64[3];
    names[0] = "eps_inf";
    names[1] = "omega_p";
    names[2] = "gamma";
    return _bj_jr_f64_struct(v, &names, 3, "struct DrudeMaterial", w);
}

fn _bj_jr_lorentz(v, w): i64 {
    var names: i64[4];
    names[0] = "eps_inf";
    names[1] = "delta_eps";
    names[2] = "omega_0";
    names[3] = "gamma";
    return _bj_jr_f64_struct(v, &names, 4, "struct LorentzMaterial", w);
}

fn _bj_jr_debye(v, w): i64 {
    var names: i64[3];
    names[0] = "eps_inf";
    names[1] = "eps_s";
    names[2] = "tau";
    return _bj_jr_f64_struct(v, &names, 3, "struct DebyeMaterial", w);
}

# The three `Vec<f64>` fields, named names[0..3], of struct node v (`what` names it): their array nodes into
# nodes[0..3], each checked to be an array. 0, or the code recorded.
fn _bj_jr_three_vecs(v, names: *i64, what, nodes: *i64): i64 {
    var form = _bj_jr_form(v, 3, what);
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    for (var f = 0; f < 3; f = f + 1) {
        var node = _bj_jr_field(v, form, f, names[f]);
        if (node == 0) { return BJ_ERR_DESERIALIZE; }
        if (bayan_json_v_tag(node) != JTAG_ARR) { return _bj_jr_type(node, "a sequence"); }
        nodes[f] = node;
    }
    return 0;
}

# Array node v's n numbers into out[0..n]. 0, or the code recorded.
fn _bj_jr_f64_elems(v, n, out): i64 {
    for (var k = 0; k < n; k = k + 1) {
        var c = _bj_jr_f64(bayan_json_v_arr_get(v, k), out + k * 8);
        if (c != 0) { return c; }
    }
    return 0;
}

# A NonUniformGrid into w (a BjNonUniformGrid, its block allocated here, so the caller frees it on a failure; w's
# block is 0 on entry): three arrays of any lengths.
fn _bj_jr_nonuniform(v, w): i64 {
    var names: i64[3];
    var nodes: i64[3];
    names[0] = "dx";
    names[1] = "dy";
    names[2] = "dz";
    var c = _bj_jr_three_vecs(v, &names, "struct NonUniformGrid", &nodes);
    if (c != 0) { return c; }
    var nx = bayan_json_v_arr_len(nodes[0]);
    var ny = bayan_json_v_arr_len(nodes[1]);
    var nz = bayan_json_v_arr_len(nodes[2]);
    var g: BjNonUniformGrid;
    var t, e = BjNonUniformGrid_uniform(nx, ny, nz, 0.0, &g);
    if (is_err_result(t) == 1) { return e; }
    memcpy(w, &g, 56);
    c = _bj_jr_f64_elems(nodes[0], nx, g.dx);
    if (c == 0) { c = _bj_jr_f64_elems(nodes[1], ny, g.dy); }
    if (c == 0) { c = _bj_jr_f64_elems(nodes[2], nz, g.dz); }
    return c;
}

# An EigenmodeResult into w (a BjEigenmodeResult, its block allocated here, so the caller frees it on a failure; w's
# frequencies are 0 on entry): three arrays, which must be equally long (ADR 0002 row 36: the port's result has one
# count, where serde reads any lengths).
fn _bj_jr_eigen(v, w): i64 {
    var names: i64[3];
    var nodes: i64[3];
    names[0] = "frequencies";
    names[1] = "quality_factors";
    names[2] = "amplitudes";
    var c = _bj_jr_three_vecs(v, &names, "struct EigenmodeResult", &nodes);
    if (c != 0) { return c; }
    var n = bayan_json_v_arr_len(nodes[0]);
    if (bayan_json_v_arr_len(nodes[1]) != n || bayan_json_v_arr_len(nodes[2]) != n) {
        return _bj_jr_shape("an EigenmodeResult whose three arrays differ in length");
    }
    var b = 0;
    if (n > 0) {
        b = fl_alloc(n * 24);
        if (b == 0) {
            _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "the eigenmode result read");
            return BJ_ERR_ALLOCATION;
        }
    }
    store64(w, b);
    store64(w + 8, b + n * 8);
    store64(w + 16, b + n * 16);
    store64(w + 24, n);
    if (n == 0) {
        store64(w + 8, 0);
        store64(w + 16, 0);
    }
    for (var f = 0; f < 3; f = f + 1) {
        c = _bj_jr_f64_elems(nodes[f], n, b + f * n * 8);
        if (c != 0) { return c; }
    }
    return 0;
}

# Reads a `LossyMaterial` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched,
# as BjComplex_from_json. The fields are read as written, as serde's derive reads Rust's public fields. Mirrors
# `serde_json::from_str::<LossyMaterial>`.
#must_use
public fn BjLossyMaterial_from_json(buf, len, out: *BjLossyMaterial): Result {
    var w: f64[2];
    var code = _bj_jr_read(buf, len, &_bj_jr_lossy, &w);
    if (code != 0) { return Err(code); }
    out.eps_r = w[0];
    out.conductivity = w[1];
    return Ok(0);
}

# Reads a `DrudeMaterial` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched,
# as BjComplex_from_json; the fields as written. Mirrors `serde_json::from_str::<DrudeMaterial>`.
#must_use
public fn BjDrudeMaterial_from_json(buf, len, out: *BjDrudeMaterial): Result {
    var w: f64[3];
    var code = _bj_jr_read(buf, len, &_bj_jr_drude, &w);
    if (code != 0) { return Err(code); }
    out.eps_inf = w[0];
    out.omega_p = w[1];
    out.gamma = w[2];
    return Ok(0);
}

# Reads a `LorentzMaterial` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched,
# as BjComplex_from_json; the fields as written. Mirrors `serde_json::from_str::<LorentzMaterial>`.
#must_use
public fn BjLorentzMaterial_from_json(buf, len, out: *BjLorentzMaterial): Result {
    var w: f64[4];
    var code = _bj_jr_read(buf, len, &_bj_jr_lorentz, &w);
    if (code != 0) { return Err(code); }
    out.eps_inf = w[0];
    out.delta_eps = w[1];
    out.omega_0 = w[2];
    out.gamma = w[3];
    return Ok(0);
}

# Reads a `DebyeMaterial` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched,
# as BjComplex_from_json; the fields as written (an ε_s below ε_∞ too). Mirrors `serde_json::from_str::<DebyeMaterial>`.
#must_use
public fn BjDebyeMaterial_from_json(buf, len, out: *BjDebyeMaterial): Result {
    var w: f64[3];
    var code = _bj_jr_read(buf, len, &_bj_jr_debye, &w);
    if (code != 0) { return Err(code); }
    out.eps_inf = w[0];
    out.eps_s = w[1];
    out.tau = w[2];
    return Ok(0);
}

# Reads a `NonUniformGrid` document from [buf, buf + len) into a new grid in *out: Ok(0), or the error recorded with
# out untouched (and never read), as BjComplex_from_json; each axis an array of any length, its widths as written (a
# grid validate refuses too). Give it back with BjNonUniformGrid_free. Mirrors `serde_json::from_str::<NonUniformGrid>`.
#must_use
public fn BjNonUniformGrid_from_json(buf, len, out: *BjNonUniformGrid): Result {
    var g: BjNonUniformGrid;
    g.block = 0;
    g.nx = 0;
    g.ny = 0;
    g.nz = 0;
    var code = _bj_jr_read(buf, len, &_bj_jr_nonuniform, &g);
    if (code != 0) {
        BjNonUniformGrid_free(&g);
        return Err(code);
    }
    memcpy(out, &g, 56);
    return Ok(0);
}

# Reads an `EigenmodeResult` document from [buf, buf + len) into a new result in *out: Ok(0), or the error recorded
# with out untouched (and never read), as BjComplex_from_json. Its three arrays must be equally long (ADR 0002 row 36),
# where serde reads any. Give it back with BjEigenmodeResult_free. Mirrors `serde_json::from_str::<EigenmodeResult>`.
#must_use
public fn BjEigenmodeResult_from_json(buf, len, out: *BjEigenmodeResult): Result {
    var r: BjEigenmodeResult;
    r.frequencies = 0;
    r.count = 0;
    var code = _bj_jr_read(buf, len, &_bj_jr_eigen, &r);
    if (code != 0) {
        BjEigenmodeResult_free(&r);
        return Err(code);
    }
    out.frequencies = r.frequencies;
    out.quality_factors = r.quality_factors;
    out.amplitudes = r.amplitudes;
    out.count = r.count;
    return Ok(0);
}

# ── the 2D FDTD types (M6 part 1d) ───────────────────────────────────────────────────────────────────────────────

# Appends `{"thickness":<n>,"grading_order":<m>,"sigma_ratio":<r>,"kappa_max":<κ>,"alpha_max":<α>}` to the builder sb,
# the thickness as an unsigned 64-bit integer (Rust's usize), the fields as held (parameters BjCpml_with_params would
# refuse too): Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors `serde_json::to_string(&p)` for
# `fdtd::CpmlParams`.
#must_use
public fn BjCpmlParams_to_json(p: *BjCpmlParams, sb): Result {
    var buf[224];
    var n = _bj_jw_cstr(&buf, 0, "{\"thickness\":");
    n = _bj_jw_u64(&buf, n, p.thickness);
    n = _bj_jw_cstr(&buf, n, ",\"grading_order\":");
    n = _bj_jw_f64(&buf, n, p.grading_order);
    n = _bj_jw_cstr(&buf, n, ",\"sigma_ratio\":");
    n = _bj_jw_f64(&buf, n, p.sigma_ratio);
    n = _bj_jw_cstr(&buf, n, ",\"kappa_max\":");
    n = _bj_jw_f64(&buf, n, p.kappa_max);
    n = _bj_jw_cstr(&buf, n, ",\"alpha_max\":");
    n = _bj_jw_f64(&buf, n, p.alpha_max);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends the mode's document, its variant's name in quotes (`"Tm"`, `"Te"`), to the builder sb: Ok(0),
# Err(BJ_ERR_ALLOCATION) with sb as it was, or Err(BJ_ERR_INVALID_PARAMETER) "unknown 2D mode {mode}" for a word that
# is no BjMode2d (Rust's enum has no other), as BjFdtd2d_new refuses it. Mirrors `serde_json::to_string(&m)` for
# `fdtd::Mode2d`.
#must_use
public fn BjMode2d_to_json(mode, sb): Result {
    if (mode != BJ_MODE2D_TM && mode != BJ_MODE2D_TE) {
        var t0 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t0, "unknown 2D mode ");
        _bj_tx_i64(t0, mode);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var buf[8];
    var n = 0;
    if (mode == BJ_MODE2D_TE) { n = _bj_jw_cstr(&buf, 0, "\"Te\""); }
    else { n = _bj_jw_cstr(&buf, 0, "\"Tm\""); }
    return _bj_jw_put(sb, &buf, n);
}

# A CpmlParams node into the BjCpmlParams at w: `thickness` a usize (_bj_jr_usize: an integer from 0 to 2^63 − 1,
# since bayan's tree keeps no exact integer past it, ADR 0002 row 36), the four f64 as written. 0, or
# BJ_ERR_DESERIALIZE recorded.
fn _bj_jr_cpml_params(v, w): i64 {
    var form = _bj_jr_form(v, 5, "struct CpmlParams");
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    var names: i64[5];
    names[0] = "thickness";
    names[1] = "grading_order";
    names[2] = "sigma_ratio";
    names[3] = "kappa_max";
    names[4] = "alpha_max";
    for (var k = 0; k < 5; k = k + 1) {
        var f = _bj_jr_field(v, form, k, names[k]);
        if (f == 0) { return BJ_ERR_DESERIALIZE; }
        var c = 0;
        if (k == 0) { c = _bj_jr_usize(f, w); }
        else { c = _bj_jr_f64(f, w + k * 8); }
        if (c != 0) { return c; }
    }
    return 0;
}

# A Mode2d node into w[0]: a string, or a one-member object whose value is null (serde's two forms of a unit variant),
# naming `Tm` or `Te`. 0, or BJ_ERR_DESERIALIZE recorded.
fn _bj_jr_mode2d(v, w): i64 {
    var tag = bayan_json_v_tag(v);
    var name = 0;
    if (tag == JTAG_STR) { name = bayan_json_v_str(v); }
    elif (tag == JTAG_OBJ && bayan_json_v_obj_len(v) == 1) {
        if (bayan_json_v_tag(bayan_json_v_obj_val(v, 0)) != JTAG_NULL) {
            return _bj_jr_type(bayan_json_v_obj_val(v, 0), "unit");
        }
        name = bayan_json_v_obj_key(v, 0);
    } else {
        return _bj_jr_type(v, "enum Mode2d");
    }
    if (str_len(name) == 2 && memeq(str_data(name), "Tm", 2) == 1) {
        store64(w, BJ_MODE2D_TM);
        return 0;
    }
    if (str_len(name) == 2 && memeq(str_data(name), "Te", 2) == 1) {
        store64(w, BJ_MODE2D_TE);
        return 0;
    }
    _bj_tx_cstr(_bj_err_reason(BJ_ERR_DESERIALIZE), "unknown variant, expected `Tm` or `Te`");
    return BJ_ERR_DESERIALIZE;
}

# Reads a `CpmlParams` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched, as
# BjComplex_from_json. The fields are read as written, as serde's derive reads Rust's public fields: parameters
# BjCpml_with_params refuses (a zero thickness, a grading order below 1) are read, and refused when used. A thickness
# past 2^63 − 1, which serde reads, is refused (ADR 0002 row 36): no grid fits it and no profile can be allocated for
# it. Mirrors `serde_json::from_str::<CpmlParams>`.
#must_use
public fn BjCpmlParams_from_json(buf, len, out: *BjCpmlParams): Result {
    var p: BjCpmlParams;
    var code = _bj_jr_read(buf, len, &_bj_jr_cpml_params, &p);
    if (code != 0) { return Err(code); }
    out.thickness = p.thickness;
    out.grading_order = p.grading_order;
    out.sigma_ratio = p.sigma_ratio;
    out.kappa_max = p.kappa_max;
    out.alpha_max = p.alpha_max;
    return Ok(0);
}

# Reads a `Mode2d` document from [buf, buf + len) into *out (BJ_MODE2D_TM or BJ_MODE2D_TE): Ok(0), or Err with the
# reason recorded and out untouched. serde's two forms of a unit variant: its name as a string, or a one-member object
# mapping the name to null. Mirrors `serde_json::from_str::<Mode2d>`.
#must_use
public fn BjMode2d_from_json(buf, len, out: *i64): Result {
    var w: i64[1];
    var code = _bj_jr_read(buf, len, &_bj_jr_mode2d, &w);
    if (code != 0) { return Err(code); }
    out[0] = w[0];
    return Ok(0);
}
