# The fast core of asin |x| for 2^-26 ≤ |x| < 1: (hi, lo, err) from the atan core. asin |x| = atan2(|x|, s) with
# s = √(1 − x²): θ = atan(|x|/s) when |x| ≤ s (oct 0), else π/2 − atan(s/|x|) (oct 2). 1 − x² and s exactly as
# kimiya's acos core computes them (a double-double, s by one Newton step, 2^-104 relative); the denominator is
# max(|x|, s) ≥ 1/√2 and the numerator at least 2^-26.5, inside the core's domain, and its 2^-69.44 bound absorbs
# s's error as it does for acos.
#must_use
fn _bj_k_asin_core(x: f64): (f64, f64, f64) {
    var ax: f64 = f64_abs(x);
    var wh: f64 = 0.0;
    var wl: f64 = 0.0;
