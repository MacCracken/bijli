# --- crmath_ux.cyr ---

# crmath_ux.cyr — e^x, cosh, sinh, ln(s·2^E), (s·2^E)^y, and sin and cos past DBL_MAX, each with an unbounded
# exponent (bijli, M1 part 5c-2), for BjComplex's transcendental range edges (ADR 0002 row 16).
#
# At a range edge hisab's chain runs with an unbounded exponent (the user's decision of 2026-11-12, ADR 0002 rows 14 and
# 16): every operation rounded to 53 bits, the last one once into binary64. The transcendental operations of that chain
# that can leave binary64's normal range are e^re in complex exp, cosh and sinh of im in complex sin and cos, ln and pow
# of an |z| (or a power) past DBL_MAX or below 2^-1022, and sin and cos of an angle past DBL_MAX (powf's n·arg z; the
# Green's function's k·R, M1 part 5d-3). Each returns its 53-bit value as kimiya's _bj_k_ux_* pair (s in [1, 2), an i64
# exponent), or ln, sin and cos their final binary64 value (always normal). Every one runs on src/crmath.cyr's 364-bit
# fixed point (impetus's slow paths, error below 2^-290 relative): e^x by _bj_cr_exp_fx_parts (x = k·ln 2 + r, e^r by
# its series), ln by _bj_cr_log_fx plus E·ln 2, pow as pow's own slow path (an exactness test, then |y|·|ln x| and e^±),
# sin and cos by Payne–Hanek against a longer table of the same 2/π (src/crmath_ux_data.cyr). They are slow (tens of
# microseconds), and only the edges reach them.
#
# The rounding. _bj_cr_round_ux takes the fixed point's 53 leading bits, the round bit and the sticky bit, ties to
# even, with no exponent range. A value within 2^-290 of a rounding boundary would need an argument far harder than
# any known: the hardest double arguments of exp, log, sin and cos need about 2^-120 (Lefèvre–Muller), and the
# arguments here differ only in their exponent (s·2^E, or a 53-bit angle), for which no search is published; the
# 170-bit margin is what crmath's pow already relies on. Exact midpoints: e^x, ln x, sin and cos of a nonzero
# rational are transcendental (Lindemann–Weierstrass), and a dyadic power is caught exactly by _bj_ux_pow_exact.
# scripts/oracle/cr_verify.py's ux_* families check every function here against MPFR at 53 bits with its widest
# exponent range, on x86_64 and aarch64.
#
# Far past the range the value is (1, ±_BJ_UX_HUGE): a stand-in whose products with every factor the chain can give it
# overflow, or round to zero, exactly as the true value's do. For e^x, cosh and sinh that is beyond |x| = 1500: their
# factors are doubles (cos and sin of a part), at least 2^-1074 in magnitude, and e^1500·2^-1074 > 2^1090. For a power
# it is beyond |y·ln x| = 10000: its factor can be the sine of an angle n·arg z far below 2^-1074, but never below
# 2^-2098·|n| (arg z ≥ 2^-1074/2^1024), and a power past e^1500 needs |n| ≥ 2 (|ln |z|| < 745), while e^10000 is
# 2^14426. Every real exponent here stays below 2^15, far from the stand-in's 2^20. The circuit transients (M2 part
# 2d-3b) multiply e^x by an amplitude V/R that reaches 2^-2098, so _bj_ux_exp_lim takes e^x on to |x| = 2300.

# The exponent of the stand-in for a value beyond every product's range (2^20).
const _BJ_UX_HUGE = 1048576;

# The fixed-point a·2^k (a ≥ 0, its integer part below 2^28) rounded to 53 bits, ties to even, with an unbounded
# exponent: (s, e), s in [1, 2) (negated when neg is 1), so that the value is s·2^e; (±0, 0) for a = 0. _bj_cr_round
# without its subnormal and overflow ends.
#must_use
fn _bj_cr_round_ux(a, k, neg): (f64, i64) {
    var sign = 0;
    if (neg == 1) { sign = 0 - 9223372036854775807 - 1; }
    var j0 = 0;
    while (j0 < _BJ_CR_L && load64(a + j0 * 8) == 0) { j0 = j0 + 1; }
    if (j0 == _BJ_CR_L) {
        var z: f64 = _bj_cr_from_word(sign);
        return (z, 0);
    }
    var v = load64(a + j0 * 8);
    var b = 0;
    while ((v >> (b + 1)) != 0) { b = b + 1; }
    var top = b - 28 * j0;
    var mant = 0;
    for (var i = 0; i < 53; i = i + 1) { mant = (mant << 1) | _bj_cr_bit(a, top - i); }
    var rb = _bj_cr_bit(a, top - 53);
    var st = _bj_cr_sticky(a, top - 53);
    if (rb == 1 && (st == 1 || (mant & 1) == 1)) { mant = mant + 1; }
    var ex = top + k;
    if (mant == 9007199254740992) {
        mant = 4503599627370496;
        ex = ex + 1;
    }
    var s: f64 = _bj_cr_from_word(sign | (1023 << 52) | (mant - 4503599627370496));
    return (s, ex);
}

# e^x rounded to 53 bits with an unbounded exponent, for finite x with |x| ≥ 2^-300: (s, e); (1, ±_BJ_UX_HUGE)
# beyond |x| = 1500 (the section comment).
#must_use
fn _bj_ux_exp(x: f64): (f64, i64) {
    var s, e = _bj_ux_exp_lim(x, 1500.0);
    return (s, e);
}

# e^x as _bj_ux_exp, the stand-in beyond |x| = lim, for lim ≤ 2300 (M2 part 2d-3b: the transients' amplitude V/R
# reaches 2^-2098, so a product with e^x is representable up to x ≈ 2147). The reduction holds there: k ≤ 3319 times
# the fixed-point ln 2 errs below 2^-352, and e^2300 is about 2^3318, far from the stand-in's 2^20.
#must_use
fn _bj_ux_exp_lim(x: f64, lim: f64): (f64, i64) {
    if (x > lim) { return (1.0, _BJ_UX_HUGE); }
    var nl: f64 = -lim;
    if (x < nl) { return (1.0, 0 - _BJ_UX_HUGE); }
    _bj_cr_load();
    var X[112];
    var S[112];
    var ax: f64 = f64_abs(x);
    _bj_cr_set(&X, ax);
    var q: f64 = x * _BJ_CR_INVLN2;
    var neg = 0;
    if (x < 0.0) { neg = 1; }
    var k = _bj_cr_exp_fx_parts(&S, &X, neg, q);
    var s, e = _bj_cr_round_ux(&S, k, 0);
    return (s, e);
}

# cosh x rounded to 53 bits with an unbounded exponent, for finite |x| > 710: e^|x|/2. e^-|x| is below 2^-2048 of it,
# so far below the fixed point's 2^-364 that the exact sum and e^|x| round alike (as _bj_cr_hyp_slow_exp truncates
# it); (1, _BJ_UX_HUGE) beyond 1500.
#must_use
fn _bj_ux_cosh(x: f64): (f64, i64) {
    var ax: f64 = f64_abs(x);
    var s, e = _bj_ux_exp(ax);
    if (e == _BJ_UX_HUGE) { return (s, e); }
    return (s, e - 1);
}

# sinh x rounded to 53 bits with an unbounded exponent, for finite |x| > 710: ±e^|x|/2, as _bj_ux_cosh.
#must_use
fn _bj_ux_sinh(x: f64): (f64, i64) {
    var s, e = _bj_ux_cosh(x);
    if (x < 0.0) {
        var ns: f64 = -s;
        return (ns, e);
    }
    return (s, e);
}

# |ln(s·2^E)| into L, and its sign (1 for a value below 1), for a positive normal double s and |E| < 2^26.
fn _bj_ux_log_fx(L, s: f64, ex): i64 {
    _bj_cr_load();
    var ls = _bj_cr_log_fx(L, s);
    var E[112];
    var ae = ex;
    var es = 0;
    if (ex < 0) {
        ae = 0 - ex;
        es = 1;
    }
    _bj_cr_mul_small(&E, &_bj_cr_ln2, ae);
    var sg = _bj_cr_sadd(L, &E, es, L, ls);
    return sg;
}

# ln(s·2^E), correctly rounded into binary64, for a positive normal double s and |E| < 2^26 (the section comment).
#must_use
fn _bj_ux_ln(s: f64, ex): f64 {
    var L[112];
    var sg = _bj_ux_log_fx(&L, s, ex);
    var r: f64 = _bj_cr_round(&L, 0, sg);
    return r;
}

# The exactness test of the pow slow path for x = s·2^E (a positive normal double s, |E| < 2^26) and a finite y ≠ 0:
# when x^y is a dyadic rational whose odd part is below 2^63, its 53-bit rounding into out (s, then e) and 1;
# otherwise 0. _bj_cr_pow_exact's body with the base's exponent unbounded and the rounding _bj_cr_round_ux's
# (src/crmath.cyr is impetus's copy, kept in step with it, so the variant is bijli's and lives here). A power this
# test rejects is irrational, or has an odd part of at least 2^63, which no 53-bit midpoint has.
fn _bj_ux_pow_exact(s: f64, ex, y: f64, out): i64 {
    var w = _bj_cr_word(s);
    var a = (w & 4503599627370495) | 4503599627370496;
    var u = ((w >> 52) & 2047) - 1075 + ex;
    while ((a & 1) == 0) {
        a = a >> 1;
        u = u + 1;
    }
    var wy = _bj_cr_word(y) & 9223372036854775807;
    var ey = (wy >> 52) & 2047;
    var yy = wy & 4503599627370495;
    var v = 0 - 1074;
    if (ey != 0) {
        yy = yy | 4503599627370496;
        v = ey - 1075;
    }
    while ((yy & 1) == 0) {
        yy = yy >> 1;
        v = v + 1;
    }
    var yn = yy;
    if (y < 0.0) { yn = 0 - yy; }
    var n = 1;
    var e = 0;
    if (v >= 0) {
        if (v > 20 || yy > 1048576) { return 0; }
        var ni = yn << v;
        if (a == 1) {
            e = u * ni;
        } else {
            if (ni < 0 || ni > 63) { return 0; }
            n = _bj_cr_ipow(a, ni);
            if (n == 0) { return 0; }
            e = u * ni;
        }
    } else {
        var sh = 0 - v;
        if (sh > 30) { return 0; }
        var p2 = 1 << sh;
        if (u % p2 != 0) { return 0; }
        var us = u / p2;
        if (a == 1) {
            e = us * yn;
        } else {
            if (yn < 0 || sh > 5) { return 0; }
            var c = a;
            for (var j = 0; j < sh; j = j + 1) {
                var r = _bj_cr_isqrt(c);
                if (r * r != c) { return 0; }
                c = r;
            }
            if (yn > 63) { return 0; }
            n = _bj_cr_ipow(c, yn);
            if (n == 0) { return 0; }
            e = us * yn;
        }
    }
    # n·2^e with n < 2^63, as n/2^60 in fixed point, rounded to 53 bits.
    var A[112];
    _bj_cr_zero(&A);
    store64(&A, n >> 60);
    store64(&A + 8, (n >> 32) & _BJ_CR_MASK);
    store64(&A + 16, (n >> 4) & _BJ_CR_MASK);
    store64(&A + 24, (n & 15) << 24);
    var rs, re = _bj_cr_round_ux(&A, e + 60, 0);
    store64(out, _bj_cr_word(rs));
    store64(out + 8, re);
    return 1;
}

# (s·2^E)^y rounded to 53 bits with an unbounded exponent, for a positive normal double s, |E| < 2^26 and a finite y:
# (r, e). y = 0 gives 1 (pow's rule); |y·ln x| below 2^-60 gives 1 (the power is within 2^-60 of 1); past 10000 the
# stand-in (1, ±_BJ_UX_HUGE) (the section comment). Then an exact dyadic power exactly, else the fixed point (where
# |y·ln x| ≤ 10000 keeps every value below 2^27).
#must_use
fn _bj_ux_pow(s: f64, ex, y: f64): (f64, i64) {
    if (y == 0.0) { return (1.0, 0); }
    var ls0: f64 = _bj_k_cr_ln(s);
    var ef: f64 = f64_from(ex);
    var lnv: f64 = ls0 + ef * 0.6931471805599453;
    var t: f64 = y * lnv;
    if (t > 10000.0) { return (1.0, _BJ_UX_HUGE); }
    if (t < -10000.0) { return (1.0, 0 - _BJ_UX_HUGE); }
    var at: f64 = f64_abs(t);
    if (at < 0.000000000000000000867361737988403547205962240695953369140625) { return (1.0, 0); }   # 2^-60
    var o[16];
    if (_bj_ux_pow_exact(s, ex, y, &o) == 1) {
        var xs: f64 = load64(&o);
        var xe = load64(&o + 8);
        return (xs, xe);
    }
    _bj_cr_load();
    var L[112];
    var M[112];
    var P[112];
    var S[112];
    var ls = _bj_ux_log_fx(&L, s, ex);
    # |y| = my·2^q with 1 ≤ my < 2 (y is normal: |y·ln x| ≥ 2^-60 and |ln x| < 2^25).
    var wy = _bj_cr_word(y) & 9223372036854775807;
    var q = ((wy >> 52) & 2047) - 1023;
    var my: f64 = _bj_cr_from_word((wy & 4503599627370495) | (1023 << 52));
    _bj_cr_set(&M, my);
    _bj_cr_mul(&P, &M, &L);
    _bj_cr_shift(&P, &P, q);
    var rs = ls;
    if (y < 0.0) { rs = 1 - ls; }
    var qe: f64 = t * _BJ_CR_INVLN2;
    var k = _bj_cr_exp_fx_parts(&S, &P, rs, qe);
    var r, re = _bj_cr_round_ux(&S, k, 0);
    return (r, re);
}

# Y = (t·2/π mod 1)·π/2 in fixed point, and the quadrant floor(t·2/π) mod 4, for t = m·2^e with m < 2^54 and
# e ≤ 2000 (a 53-bit value below 2^2054): _bj_cr_reduce's body with m and e given, for an angle past DBL_MAX (powf's
# n·arg z, the Green's function's k·R), against src/crmath_ux_data.cyr's 96 chunks of 2/π (_bj_cr_reduce takes a
# double and impetus's 56 chunks; src/crmath.cyr is impetus's copy). The chunks it reads end at index 88.
fn _bj_ux_reduce(Y, m, e): i64 {
    _bj_ux_load();
    var u = ((e - 2) % 28 + 28) % 28;
    var t = e - 2 - u;
    var d = e - t;
    var mk[24];
    store64(&mk, (m << d) & _BJ_CR_MASK);
    if (d >= 28) {
        store64(&mk + 8, (m << (d - 28)) & _BJ_CR_MASK);
    } else {
        store64(&mk + 8, (m >> (28 - d)) & _BJ_CR_MASK);
    }
    store64(&mk + 16, (m >> (56 - d)) & _BJ_CR_MASK);
    var base = t / 28;
    var ncol = _BJ_CR_L + 2;
    var col[128];
    for (var f = 0; f < ncol; f = f + 1) {
        var sum = 0;
        for (var kk = 0; kk < 3; kk = kk + 1) {
            var jj = kk + f - 1;
            var idx = base + jj;
            if (jj >= 0 && idx >= 0 && idx < 96) {
                sum = sum + load64(&mk + kk * 8) * load64(&_bj_ux_2opi + idx * 8);
            }
        }
        store64(&col + f * 8, sum);
    }
    var p = ncol - 1;
    while (p > 0) {
        var v = load64(&col + p * 8);
        store64(&col + (p - 1) * 8, load64(&col + (p - 1) * 8) + (v >> 28));
        store64(&col + p * 8, v & _BJ_CR_MASK);
        p = p - 1;
    }
    var quad = load64(&col) & 3;
    store64(Y, 0);
    for (var j = 1; j < _BJ_CR_L; j = j + 1) { store64(Y + j * 8, load64(&col + j * 8)); }
    _bj_cr_mul(Y, Y, &_bj_cr_pio2);
    return quad;
}

# sin t (want_sin 1) or cos t (0), correctly rounded into binary64, for the 53-bit t = ts·2^te past DBL_MAX
# (1 ≤ |ts| < 2, 1024 ≤ te ≤ 2052): _bj_cr_sin_cos_slow on _bj_ux_reduce.
#must_use
fn _bj_ux_sin_cos(ts: f64, te, want_sin): f64 {
    _bj_cr_load();
    var Y[112];
    var D[112];
    var w = _bj_cr_word(ts);
    var m = (w & 4503599627370495) | 4503599627370496;
    var quad = _bj_ux_reduce(&Y, m, te - 52);
    # sin(y + qπ/2) is sin y, cos y, −sin y, −cos y; cos(y + qπ/2) is cos y, −sin y, −cos y, sin y.
    var use_sin = want_sin;
    if ((quad & 1) == 1) { use_sin = 1 - want_sin; }
    var neg = 0;
    if (want_sin == 1 && quad >= 2) { neg = 1; }
    if (want_sin == 0 && (quad == 1 || quad == 2)) { neg = 1; }
    if (want_sin == 1 && ts < 0.0) { neg = 1 - neg; }
    _bj_cr_sin_cos_series(&D, &Y, use_sin);
    var r: f64 = _bj_cr_round(&D, 0, neg);
    return r;
}

# --- crmath_cmp.cyr ---

# crmath_cmp.cyr — the exact Singularity threshold (bijli, M1 part 5d-1, ADR 0002 row 17).
#
# field.rs and charge.rs refuse a field point closer to its source than √(1e-30) m by testing the rounded
# r² = dx² + dy² + dz² against the double nearest 10^-30, and the Green's functions test the rounded R = √r² the same
# way. The user's decision of 2026-11-12 makes the test exact: the exact Σ (aᵢ − bᵢ)² of the inputs themselves against
# 10^-30, or against 10^-60 for R < 10^-30.
#
# The band. The rounded r² is within a few ulps of the exact one: each difference, square and sum is rounded once
# (five roundings, each within half an ulp), and a square that underflows costs at most 2^-1074 absolute, nothing at
# this scale (10^-30 is about 2^-100). R adds one correctly rounded root. A non-finite input makes the rounded value NaN
# or +∞, and Rust's comparison stands. So outside 64 ulps of the double nearest 10^-30 the rounded comparison is the
# exact one, and only inside that band (_bj_x_band's 2) does _bj_x_r2_below run.
#
# The exact test. Each difference is s + t exactly (TwoSum, exact in binary64 with gradual underflow), so
# r² = Σ (s² + 2st + t²): nine products of two doubles, each ±m·2^k with m < 2^107. Times 10^p the sum is compared with
# 1 in integers: Σ ±m·5^p·2^(k + p − b) against 2^(−b), b the least exponent (or 0). In the band no term exceeds
# about 2^-98 (r² is near 10^-30) and none has a bit below 2^-2148 (t² of a subnormal t), so the integers span at most
# about 2,300 bits, inside the 2,560 the 80 limbs of 32 bits hold.

const _BJ_XN_L = 80;
const _BJ_XN_M = 4294967295;

# The origin, for a test of |a|² (b = 0).
var _bj_x_origin[24];

# a = 0.
fn _bj_xn_zero(a) {
    for (var i = 0; i < _BJ_XN_L; i = i + 1) { store64(a + i * 8, 0); }
    return 0;
}

# a = m, for 0 ≤ m < 2^63.
fn _bj_xn_set(a, m) {
    _bj_xn_zero(a);
    store64(a, m & _BJ_XN_M);
    store64(a + 8, m >> 32);
    return 0;
}

# a = a·v, for 0 < v < 2^30: no limb product or carry leaves 2^62.
fn _bj_xn_mul_small(a, v) {
    var carry = 0;
    for (var i = 0; i < _BJ_XN_L; i = i + 1) {
        var t = load64(a + i * 8) * v + carry;
        store64(a + i * 8, t & _BJ_XN_M);
        carry = t >> 32;
    }
    return 0;
}

# acc = acc + a·2^sh, for sh ≥ 0, the sum below 2^2560.
fn _bj_xn_add_shl(acc, a, sh) {
    var q = sh / 32;
    var r = sh % 32;
    var carry = 0;
    for (var i = 0; i + q < _BJ_XN_L; i = i + 1) {
        var x = load64(a + i * 8);
        var lo = (x << r) & _BJ_XN_M;
        var hi = 0;
        if (r > 0) { hi = x >> (32 - r); }
        var t = load64(acc + (i + q) * 8) + lo + carry;
        store64(acc + (i + q) * 8, t & _BJ_XN_M);
        carry = (t >> 32) + hi;
    }
    return 0;
}

# −1, 0 or 1 as a <, =, > b.
#must_use
fn _bj_xn_cmp(a, b): i64 {
    var i = _BJ_XN_L - 1;
    while (i >= 0) {
        var x = load64(a + i * 8);
        var y = load64(b + i * 8);
        if (x < y) { return 0 - 1; }
        if (x > y) { return 1; }
        i = i - 1;
    }
    return 0;
}

# dst = m1·m2·c·5^p, for m1, m2 < 2^53, c 1 or 2, p ≥ 0: m2 in two parts below 2^27, 5^p twelve fives at a time.
fn _bj_xn_term(dst, m1, m2, c, p) {
    var lo[640];
    var hi[640];
    _bj_xn_set(&lo, m1);
    _bj_xn_mul_small(&lo, m2 & 67108863);
    _bj_xn_set(&hi, m1);
    _bj_xn_mul_small(&hi, m2 >> 26);
    _bj_xn_zero(dst);
    _bj_xn_add_shl(dst, &lo, 0);
    _bj_xn_add_shl(dst, &hi, 26);
    if (c == 2) { _bj_xn_mul_small(dst, 2); }
    var f12 = 1;
    for (var k = 0; k < 12; k = k + 1) { f12 = f12 * 5; }
    var q = p;
    while (q >= 12) {
        _bj_xn_mul_small(dst, f12);
        q = q - 12;
    }
    var f = 1;
    for (var j = 0; j < q; j = j + 1) { f = f * 5; }
    if (f > 1) { _bj_xn_mul_small(dst, f); }
    return 0;
}

# The finite double x ≠ 0 as ±m·2^k: m (below 2^53) into out[0], k into out[1]; returns 1 for a negative x.
fn _bj_x_split(x: f64, out): i64 {
    var w = _bj_cr_word(x);
    var a = w & 9223372036854775807;
    var be = a >> 52;
    var m = a & 4503599627370495;
    var k = 0 - 1074;
    if (be != 0) {
        m = m | 4503599627370496;
        k = be - 1075;
    }
    store64(out, m);
    store64(out + 8, k);
    if (w < 0) { return 1; }
    return 0;
}

# 1 when the exact Σᵢ (aᵢ − bᵢ)² (i < 3) is below 10^-p, for finite aᵢ, bᵢ whose differences don't overflow and
# 0 < p ≤ 60 (the section comment).
#must_use
fn _bj_x_r2_below(a: *f64, b: *f64, p): i64 {
    var tm: i64[54];                                         # per term: m1, k1, m2, k2, c, negative
    var nt = 0;
    var sp: i64[2];
    var tp: i64[2];
    for (var i = 0; i < 3; i = i + 1) {
        var ai: f64 = a[i];
        var nb: f64 = -b[i];
        var s, t = _bj_cr_two_sum(ai, nb);
        var sv: f64 = s;
        var tv: f64 = t;
        var sn = 0;
        var tn = 0;
        if (sv != 0.0) { sn = _bj_x_split(sv, &sp); }
        if (tv != 0.0) { tn = _bj_x_split(tv, &tp); }
        if (sv != 0.0) {
            tm[nt * 6] = sp[0];
            tm[nt * 6 + 1] = sp[1];
            tm[nt * 6 + 2] = sp[0];
            tm[nt * 6 + 3] = sp[1];
            tm[nt * 6 + 4] = 1;
            tm[nt * 6 + 5] = 0;
            nt = nt + 1;
        }
        if (sv != 0.0 && tv != 0.0) {
            tm[nt * 6] = sp[0];
            tm[nt * 6 + 1] = sp[1];
            tm[nt * 6 + 2] = tp[0];
            tm[nt * 6 + 3] = tp[1];
            tm[nt * 6 + 4] = 2;
            tm[nt * 6 + 5] = sn ^ tn;
            nt = nt + 1;
        }
        if (tv != 0.0) {
            tm[nt * 6] = tp[0];
            tm[nt * 6 + 1] = tp[1];
            tm[nt * 6 + 2] = tp[0];
            tm[nt * 6 + 3] = tp[1];
            tm[nt * 6 + 4] = 1;
            tm[nt * 6 + 5] = 0;
            nt = nt + 1;
        }
    }
    var base = 0;
    for (var j = 0; j < nt; j = j + 1) {
        var e = tm[j * 6 + 1] + tm[j * 6 + 3] + p;
        if (e < base) { base = e; }
    }
    var P[640];
    var N[640];
    var T[640];
    _bj_xn_zero(&P);
    _bj_xn_zero(&N);
    for (var u = 0; u < nt; u = u + 1) {
        _bj_xn_term(&T, tm[u * 6], tm[u * 6 + 2], tm[u * 6 + 4], p);
        var sh = tm[u * 6 + 1] + tm[u * 6 + 3] + p - base;
        if (tm[u * 6 + 5] == 1) { _bj_xn_add_shl(&N, &T, sh); } else { _bj_xn_add_shl(&P, &T, sh); }
    }
    _bj_xn_set(&T, 1);
    _bj_xn_add_shl(&N, &T, 0 - base);
    if (_bj_xn_cmp(&P, &N) < 0) { return 1; }
    return 0;
}

# The band test for a rounded value v (r² against the double t nearest 10^-30, or R against it): 0 when v is NaN or
# more than 64 ulps above t (not singular), 1 when more than 64 ulps below (singular), 2 inside the band (the exact
# test decides). v is non-negative or NaN.
#must_use
fn _bj_x_band(v: f64, t: f64): i64 {
    if (v != v) { return 0; }
    var w = _bj_cr_word(v) - _bj_cr_word(t);
    if (w > 64) { return 0; }
    if (w < -64) { return 1; }
    return 2;
}

# ── M2's exact thresholds (M2 part 2c-1, ADR 0002 row 17's rule) ────────────────────────────────────────────────────

# M2's tests against 10^-30 of one rounded product, quotient or sum of two inputs (|R·C|, |L/R|, |μ_r·μ₀|,
# |n₁ + n₂|): that value is rounded once, within half an ulp of the exact one, so outside _bj_x_band's 64 ulps the
# rounded comparison is the exact one, and inside it the exact sign below decides. In the band the terms lie within a
# few hundred bits of each other (the value is near 10^-30, so its parts are), well inside the 2,560 bits.

# The sign (−1, 0 or 1) of Σ ±cᵢ·m₁ᵢ·m₂ᵢ·2^(k₁ᵢ + k₂ᵢ)·10^(qᵢ) over the nt terms at tm, seven words each (m₁, k₁, m₂,
# k₂, c, negative, q; m₁, m₂ < 2^53, c 1 or 2, 0 ≤ q ≤ 60), exactly: each term times 5^q in integers, aligned on the
# least exponent of 2 (the callers keep the span inside the capacity).
#must_use
fn _bj_x_sign(tm: *i64, nt): i64 {
    var base = 0;
    for (var j = 0; j < nt; j = j + 1) {
        var e = tm[j * 7 + 1] + tm[j * 7 + 3] + tm[j * 7 + 6];
        if (j == 0 || e < base) { base = e; }
    }
    var P[640];
    var N[640];
    var T[640];
    _bj_xn_zero(&P);
    _bj_xn_zero(&N);
    for (var u = 0; u < nt; u = u + 1) {
        _bj_xn_term(&T, tm[u * 7], tm[u * 7 + 2], tm[u * 7 + 4], tm[u * 7 + 6]);
        var sh = tm[u * 7 + 1] + tm[u * 7 + 3] + tm[u * 7 + 6] - base;
        if (tm[u * 7 + 5] == 1) { _bj_xn_add_shl(&N, &T, sh); } else { _bj_xn_add_shl(&P, &T, sh); }
    }
    var r = _bj_xn_cmp(&P, &N);
    return r;
}

# tm's term j := ±x·y·10^q for finite nonzero x and y (y = 1 for a single double), its sign flipped when flip is 1.
fn _bj_x_put2(tm: *i64, j, x: f64, y: f64, q, flip) {
    var sx: i64[2];
    var sy: i64[2];
    var nx = _bj_x_split(x, &sx);
    var ny = _bj_x_split(y, &sy);
    tm[j * 7] = sx[0];
    tm[j * 7 + 1] = sx[1];
    tm[j * 7 + 2] = sy[0];
    tm[j * 7 + 3] = sy[1];
    tm[j * 7 + 4] = 1;
    tm[j * 7 + 5] = nx ^ ny ^ flip;
    tm[j * 7 + 6] = q;
    return 0;
}

# 1 when the exact |x·y| < 10^-p, else 0, for finite nonzero x and y (0 < p ≤ 60).
#must_use
fn _bj_x_prod_below(x: f64, y: f64, p): i64 {
    var tm: i64[14];
    var ax: f64 = f64_abs(x);
    var ay: f64 = f64_abs(y);
    _bj_x_put2(&tm, 0, ax, ay, p, 0);
    _bj_x_put2(&tm, 1, 1.0, 1.0, 0, 1);
    if (_bj_x_sign(&tm, 2) < 0) { return 1; }
    return 0;
}

# 1 when the exact |x/y| < 10^-p (|x|·10^p < |y|), else 0, for finite nonzero x and y (0 < p ≤ 60).
#must_use
fn _bj_x_quot_below(x: f64, y: f64, p): i64 {
    var tm: i64[14];
    var ax: f64 = f64_abs(x);
    var ay: f64 = f64_abs(y);
    _bj_x_put2(&tm, 0, ax, 1.0, p, 0);
    _bj_x_put2(&tm, 1, ay, 1.0, 0, 1);
    if (_bj_x_sign(&tm, 2) < 0) { return 1; }
    return 0;
}

# 1 when the exact |x + y| < 10^-p, else 0, for finite x and y (0 < p ≤ 60): x + y = s + t exactly (TwoSum), and
# |s + t| = sign(s)·(s + t) since |t| ≤ half an ulp of s.
#must_use
fn _bj_x_sum_below(x: f64, y: f64, p): i64 {
    var s, t = _bj_cr_two_sum(x, y);
    var sv: f64 = s;
    var tv: f64 = t;
    if (sv == 0.0) { return 1; }
    var tm: i64[21];
    var flip = 0;
    if (sv < 0.0) { flip = 1; }
    _bj_x_put2(&tm, 0, sv, 1.0, p, flip);
    var nt = 1;
    if (tv != 0.0) {
        _bj_x_put2(&tm, 1, tv, 1.0, p, flip);
        nt = 2;
    }
    _bj_x_put2(&tm, nt, 1.0, 1.0, 0, 1);
    if (_bj_x_sign(&tm, nt + 1) < 0) { return 1; }
    return 0;
}

# --- mathx.cyr ---

# mathx.cyr — bijli's math helpers: Rust std semantics on top of the Cyrius builtins.
#
# Port plan §9.1 and §6 step 4. Each helper mirrors one std f64 method as rustc 1.99.1 compiles
# it, and is pinned by tests/golden/math.tsv:
# - min / max / clamp ignore a NaN operand as Rust does (the stdlib f64_min / f64_max return the
#   second operand when the first is NaN, and NaN when the second is);
# - the predicates and copysign have no public stdlib counterpart;
# - to_radians and to_degrees are one multiply by Rust's folded constant;
# - powi is compiler-rt's `__powidf2`, which Rust calls for bijli's run-time exponents.
# - exp, sin, cos, sin_cos, hypot, pow, atan2 and atan are correctly rounded (src/crmath.cyr, impetus's ADR 0011
#   adopted by bijli's ADR 0001), and so are tan (bijli's, on impetus's sin and cos), acos, log10 (kimiya's) and
#   asin (src/crmath_k.cyr): the same bits on every target, matching the corrected oracle. cbrt is ganita's,
#   already correctly rounded.
# Adapted from impetus's src/mathx.cyr (its `_im_` helpers).

# `std::f64::consts::PI`, the double nearest π (0x400921FB54442D18). Rust folds `4.0 * PI * EPSILON_0` and the like at
# compile time; the port computes the same IEEE products at run time, which gives the same bits.
var _BJ_PI: f64 = 3.141592653589793;

# π/180 as Rust folds `consts::PI / 180.0`: the double nearest, pinned by the to_radians rows.
var _BJ_RADS_PER_DEG: f64 = 0.017453292519943295;

# 180/π as Rust folds `180.0f64 / consts::PI`: pinned by the to_degrees rows.
var _BJ_DEGS_PER_RAD: f64 = 57.29577951308232;

# The bits of an f64 as an integer word: an untyped parameter, an i64 return.
#must_use
fn _bj_bits(x): i64 {
    return x;
}

# The f64 whose bit pattern is the word `w`.
#must_use
fn _bj_from_bits(w): f64 {
    var r: f64 = w;
    return r;
}

# 1 when x is NaN. Mirrors `f64::is_nan`.
#must_use
fn _bj_is_nan(x: f64): i64 {
    if (x != x) { return 1; }
    return 0;
}

# 1 when x is neither infinite nor NaN (x − x is 0 only then). Mirrors `f64::is_finite`.
#must_use
fn _bj_is_finite(x: f64): i64 {
    var d: f64 = x - x;
    if (d == 0.0) { return 1; }
    return 0;
}

# The smaller of x and y, ignoring a NaN operand (NaN only when both are). Equal operands, +0 and
# −0 included, give y, as rustc 1.99.1's `x.min(y)` does (minsd). Mirrors `f64::min`.
#must_use
fn _bj_min(x: f64, y: f64): f64 {
    if (x != x) { return y; }
    if (y != y) { return x; }
    if (x < y) { return x; }
    return y;
}

# The larger of x and y, ignoring a NaN operand (NaN only when both are). Equal operands give y
# (maxsd). Mirrors `f64::max`.
#must_use
fn _bj_max(x: f64, y: f64): f64 {
    if (x != x) { return y; }
    if (y != y) { return x; }
    if (x > y) { return x; }
    return y;
}

# x restricted to [lo, hi]: lo when x < lo, hi when x > hi, else x (a NaN x stays NaN). Rust
# panics on lo > hi or a NaN bound; every caller passes valid bounds. Mirrors `f64::clamp`.
#must_use
fn _bj_clamp(x: f64, lo: f64, hi: f64): f64 {
    var r: f64 = x;
    if (r < lo) { r = lo; }
    if (r > hi) { r = hi; }
    return r;
}

# x's magnitude with y's sign bit (NaN payloads kept; a NaN y gives its own sign). Mirrors
# `f64::copysign`.
#must_use
fn _bj_copysign(x: f64, y: f64): f64 {
    var mag = _bj_bits(x) & 0x7FFFFFFFFFFFFFFF;
    var sign = _bj_bits(y) & 0x8000000000000000;
    var r: f64 = _bj_from_bits(mag | sign);
    return r;
}

# Degrees to radians: one multiply by the folded π/180. Mirrors `f64::to_radians`.
#must_use
fn _bj_to_radians(x: f64): f64 {
    var r: f64 = x * _BJ_RADS_PER_DEG;
    return r;
}

# Radians to degrees: one multiply by the folded 180/π. Mirrors `f64::to_degrees`.
#must_use
fn _bj_to_degrees(x: f64): f64 {
    var r: f64 = x * _BJ_DEGS_PER_RAD;
    return r;
}

# x^n for an integer n, as compiler-rt's `__powidf2` computes it (Rust's `x.powi(n)` with a
# run-time exponent): square-and-multiply over |n|, then 1 / result for a negative n. `n` is an
# i32 value; |i32::MIN| = 2^31 fits the i64 loop counter.
#must_use
fn _bj_powi(x: f64, n): f64 {
    var a: f64 = x;
    var p = n;
    var recip = 0;
    if (n < 0) {
        recip = 1;
        p = 0 - n;
    }
    var mul: f64 = 1.0;
    loop {
        if ((p & 1) != 0) { mul = mul * a; }
        p = p >> 1;
        if (p == 0) { break; }
        a = a * a;
    }
    if (recip == 1) {
        var q: f64 = 1.0 / mul;
        return q;
    }
    return mul;
}

# e^x, correctly rounded (src/crmath.cyr). Stands for `f64::exp`.
#must_use
fn _bj_exp(x: f64): f64 {
    var r: f64 = _bj_cr_exp(x);
    return r;
}

# e^x − 1, correctly rounded (src/crmath_kx.cyr, kimiya's; M2's range-edge Part, ADR 0002 row 29). Stands for
# `f64::exp_m1`.
#must_use
fn _bj_expm1(x: f64): f64 {
    var r: f64 = _bj_k_cr_expm1(x);
    return r;
}

# √(x² + y²), correctly rounded. Stands for `f64::hypot`.
#must_use
fn _bj_hypot(x: f64, y: f64): f64 {
    var r: f64 = _bj_cr_hypot(x, y);
    return r;
}

# x^y, correctly rounded. Stands for `f64::powf`.
#must_use
fn _bj_powf(x: f64, y: f64): f64 {
    var r: f64 = _bj_cr_pow(x, y);
    return r;
}

# (sin x, cos x), each correctly rounded. Stands for `f64::sin_cos`. Read as `var s, c = _bj_sin_cos(x);` and
# bind each to an f64 local.
#must_use
fn _bj_sin_cos(x: f64): (f64, f64) {
    var s, c = _bj_cr_sin_cos(x);
    var sv: f64 = s;
    var cv: f64 = c;
    return (sv, cv);
}

# sin x, correctly rounded. Stands for `f64::sin`.
#must_use
fn _bj_sin(x: f64): f64 {
    var r: f64 = _bj_cr_sin(x);
    return r;
}

# cos x, correctly rounded. Stands for `f64::cos`.
#must_use
fn _bj_cos(x: f64): f64 {
    var r: f64 = _bj_cr_cos(x);
    return r;
}

# The angle of (x, y) in [−π, π], correctly rounded, C99 Annex F's specials and signs of zero included. Stands for
# `y.atan2(x)`.
#must_use
fn _bj_atan2(y: f64, x: f64): f64 {
    var r: f64 = _bj_cr_atan2(y, x);
    return r;
}

# atan x, correctly rounded: atan2(x, 1) is the same real number, so its correctly rounded value is atan's. The
# specials agree too: atan(±0) = ±0 (atan2(±0, 1)), atan(±∞) = ±π/2, atan(NaN) = NaN. Stands for `f64::atan`.
#must_use
fn _bj_atan(x: f64): f64 {
    var r: f64 = _bj_cr_atan2(x, 1.0);
    return r;
}

# tan x, correctly rounded (src/crmath.cyr's tan section, bijli's). Stands for `f64::tan`.
#must_use
fn _bj_tan(x: f64): f64 {
    var r: f64 = _bj_cr_tan(x);
    return r;
}

# acos x, correctly rounded (src/crmath_k.cyr, kimiya's). Stands for `f64::acos`.
#must_use
fn _bj_acos(x: f64): f64 {
    var r: f64 = _bj_k_cr_acos(x);
    return r;
}

# asin x, correctly rounded (src/crmath_k.cyr). Stands for `f64::asin`.
#must_use
fn _bj_asin(x: f64): f64 {
    var r: f64 = _bj_k_cr_asin(x);
    return r;
}

# sinh x, correctly rounded (src/crmath.cyr's sinh and cosh section, bijli's). Stands for `f64::sinh`.
#must_use
fn _bj_sinh(x: f64): f64 {
    var r: f64 = _bj_cr_sinh(x);
    return r;
}

# cosh x, correctly rounded (src/crmath.cyr's sinh and cosh section, bijli's). Stands for `f64::cosh`.
#must_use
fn _bj_cosh(x: f64): f64 {
    var r: f64 = _bj_cr_cosh(x);
    return r;
}

# ln x, correctly rounded (src/crmath_k.cyr, kimiya's). Stands for `f64::ln`.
#must_use
fn _bj_ln(x: f64): f64 {
    var r: f64 = _bj_k_cr_ln(x);
    return r;
}

# log10 x, correctly rounded (src/crmath_k.cyr, kimiya's): log10(10^k) = k exactly for k = 0 … 22. Stands for
# `f64::log10`.
#must_use
fn _bj_log10(x: f64): f64 {
    var r: f64 = _bj_k_cr_log10(x);
    return r;
}

# --- crmath_vx.cyr ---

# crmath_vx.cyr — 3-vector chains with an unbounded exponent (bijli, M1 part 5d-2, ADR 0002 row 18).
#
# At a range edge field.rs's and charge.rs's chains run with an unbounded exponent, as BjComplex's do (ADR 0002 row
# 14): every operation rounded to 53 bits (kimiya's _bj_k_ux_*, src/crmath_kx.cyr), the last one once into binary64.
# These are the helpers field.cyr, charge.cyr and (M2 part 2d-2a, its ratio chains) wave.cyr share (all `private`
# files, so the helpers live in a file of internals).
#
# The guard: Rust's chain, then a test of what it computed. A chain of products and sums of doubles differs from the
# unbounded one only where a product leaves the normal range. One past DBL_MAX makes the sums it enters ±∞ or NaN. One
# below 2^-1022 (subnormal, or 0 from nonzero factors) is u, |u| < 2^-1022, and its 53-bit value differs. Where u meets
# an operand o with |o| ≥ 2^-968 it lies below half the gap next to o (at least 2^(-968-54) = 2^-1022), so both chains
# give o. Where |o| < 2^-968 the sum is below 2^-967, and a later term t with |t| ≥ 2^-913 absorbs it the same way;
# otherwise the final value is below 2^-912 in magnitude. Every product of normal values, and every sum of them, rounds
# alike in both (a difference below 2^-1022 is exact). So when the chain's sum (or difference) S has
# |S| ∈ [2^-900, DBL_MAX], the two chains agree on S: _BJ_VX_LO and _BJ_VX_HI. An exact 0 agrees when every product is
# exact (a zero factor, or normal): _bj_vx_exact. Anything else takes the unbounded chain, which gives Rust's bits
# wherever they were right. A non-finite input keeps Rust's chain.

# 2^-900, DBL_MAX and 2^-1022, the guards' bounds (bit patterns into f64 variables).
var _BJ_VX_LO: f64 = 0x07B0000000000000;
var _BJ_VX_HI: f64 = 0x7FEFFFFFFFFFFFFF;
var _BJ_VX_MN: f64 = 0x0010000000000000;

# 1 when |s| ∈ [2^-900, DBL_MAX] (the section comment); NaN gives 0.
#must_use
fn _bj_vx_band(s: f64): i64 {
    var a: f64 = f64_abs(s);
    if (a >= _BJ_VX_LO && a <= _BJ_VX_HI) { return 1; }
    return 0;
}

# 1 when the binary64 product p = a·b is its exact value for the chain: a zero factor, or |p| in (2^-1022, DBL_MAX].
#must_use
fn _bj_vx_exact(a: f64, b: f64, p: f64): i64 {
    if (a == 0.0 || b == 0.0) { return 1; }
    var ap: f64 = f64_abs(p);
    if (ap > _BJ_VX_MN && ap <= _BJ_VX_HI) { return 1; }
    return 0;
}

# 1 when none of a, b, c, d is NaN or infinite.
#must_use
fn _bj_vx_finite4(a: f64, b: f64, c: f64, d: f64): i64 {
    var s: f64 = (a - a) + (b - b) + (c - c) + (d - d);
    if (s == 0.0) { return 1; }
    return 0;
}

# x·y with an unbounded exponent, rounded to 53 bits: (s, e).
#must_use
fn _bj_vx_mul(x: f64, y: f64): (f64, i64) {
    var xs, xe = _bj_k_ux_from(x);
    var ys, ye = _bj_k_ux_from(y);
    var s, e = _bj_k_ux_mul(xs, xe, ys, ye);
    return (s, e);
}

# (x² + y²) + z², each operation with an unbounded exponent and rounded to 53 bits: (s, e).
#must_use
fn _bj_vx_sumsq(x: f64, y: f64, z: f64): (f64, i64) {
    var as2, ae2 = _bj_vx_mul(x, x);
    var bs2, be2 = _bj_vx_mul(y, y);
    var cs2, ce2 = _bj_vx_mul(z, z);
    var ss, se = _bj_k_ux_add(as2, ae2, bs2, be2);
    var ts, te = _bj_k_ux_add(ss, se, cs2, ce2);
    return (ts, te);
}

# 1 when Rust's (x² + y²) + z² = s is the unbounded chain's: |s| in the band, or every part 0, or a part not finite.
#must_use
fn _bj_vx_sumsq_plain(x: f64, y: f64, z: f64, s: f64): i64 {
    if (s >= _BJ_VX_LO && s <= _BJ_VX_HI) { return 1; }
    if (x == 0.0 && y == 0.0 && z == 0.0) { return 1; }
    var d: f64 = (x - x) + (y - y) + (z - z);
    if (d != 0.0) { return 1; }
    return 0;
}

# a·b − c·d with an unbounded exponent, to 53 bits: (s, e).
#must_use
fn _bj_vx_cross1(a: f64, b: f64, c: f64, d: f64): (f64, i64) {
    var ps, pe = _bj_vx_mul(a, b);
    var qs, qe = _bj_vx_mul(c, d);
    var s, e = _bj_k_ux_sub(ps, pe, qs, qe);
    return (s, e);
}

# One cross-product component, a·b − c·d rounded once into binary64, given Rust's r = a·b − c·d: r itself where Rust's
# chain is the unbounded one (r in the band, an exact 0, or a factor not finite), else the unbounded chain.
#must_use
fn _bj_vx_cross1_f64(a: f64, b: f64, c: f64, d: f64, r: f64): f64 {
    if (_bj_vx_band(r) == 1 || _bj_vx_finite4(a, b, c, d) == 0) { return r; }
    if (r == 0.0) {
        var p: f64 = a * b;
        var q: f64 = c * d;
        if (_bj_vx_exact(a, b, p) == 1 && _bj_vx_exact(c, d, q) == 1) { return r; }
    }
    var ps, pe = _bj_vx_mul(a, b);
    var qs, qe = _bj_vx_mul(c, d);
    var u: f64 = _bj_k_ux_sub_f64(ps, pe, qs, qe);
    return u;
}

# ── an angle with an unbounded exponent (M1 part 5c-2's, shared by complex powf and the Green's function) ──

# cos t to 53 bits, for the 53-bit t = ts·2^te: 1 below 2^-1022 (and at 0); past DBL_MAX by _bj_ux_sin_cos; else the
# double t's correctly rounded cosine (binary64's rounding of a normal value is the 53-bit one).
#must_use
fn _bj_vx_cos53(ts: f64, te): (f64, i64) {
    if (ts == 0.0 || te < 0 - 1022) { return (1.0, 0); }
    if (te > 1023) {
        var cb: f64 = _bj_ux_sin_cos(ts, te, 0);
        var bs, be = _bj_k_ux_from(cb);
        return (bs, be);
    }
    var t: f64 = _bj_k_ux_round(ts, te, 0.0);
    var c: f64 = _bj_cos(t);
    var s, e = _bj_k_ux_from(c);
    return (s, e);
}

# sin t to 53 bits, for the 53-bit t = ts·2^te: t itself below 2^-1022 (sin t = t(1 − t²/6) rounds to t; ±0 keeps
# its sign); past DBL_MAX by _bj_ux_sin_cos; else the double t's correctly rounded sine.
#must_use
fn _bj_vx_sin53(ts: f64, te): (f64, i64) {
    if (ts == 0.0 || te < 0 - 1022) { return (ts, te); }
    if (te > 1023) {
        var sb: f64 = _bj_ux_sin_cos(ts, te, 1);
        var bs, be = _bj_k_ux_from(sb);
        return (bs, be);
    }
    var t: f64 = _bj_k_ux_round(ts, te, 0.0);
    var sn: f64 = _bj_sin(t);
    var s, e = _bj_k_ux_from(sn);
    return (s, e);
}

# ── the point charges' chains (M1 part 5d-3), shared by field.cyr and charge.cyr ─────────────────────────────────

# The address a as a *f64 (a typed return binds an untyped word without a warning).
#must_use
fn _bj_vx_f64p(a): *f64 {
    return a;
}

# 1 when none of the n doubles at p is NaN or infinite.
#must_use
fn _bj_vx_finite_n(p: *f64, n): i64 {
    var s: f64 = 0.0;
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = p[i];
        s = s + (x - x);
    }
    if (s == 0.0) { return 1; }
    return 0;
}

# The unbounded chain's offset d = f − c, |d| and 1/|d|, each to 53 bits: d into s[0..2] and e[0..2], |d| into s[3]
# and e[3], 1/|d| into s[4] and e[4].
fn _bj_vx_offset_ux(f: *f64, c: *f64, s: *f64, e: *i64) {
    for (var i = 0; i < 3; i = i + 1) {
        var a: f64 = f[i];
        var b: f64 = c[i];
        var as, ae = _bj_k_ux_from(a);
        var bs, be = _bj_k_ux_from(b);
        var ds, de = _bj_k_ux_sub(as, ae, bs, be);
        s[i] = ds;
        e[i] = de;
    }
    var xs, xe = _bj_k_ux_mul(s[0], e[0], s[0], e[0]);
    var ys, ye = _bj_k_ux_mul(s[1], e[1], s[1], e[1]);
    var zs, ze = _bj_k_ux_mul(s[2], e[2], s[2], e[2]);
    var ps, pe = _bj_k_ux_add(xs, xe, ys, ye);
    var r2s, r2e = _bj_k_ux_add(ps, pe, zs, ze);
    var rs, re = _bj_k_ux_sqrt(r2s, r2e);
    s[3] = rs;
    e[3] = re;
    var is, ie = _bj_k_ux_div(1.0, 0, rs, re);
    s[4] = is;
    e[4] = ie;
    return 0;
}

# The unbounded chain of k·q₁·q₂·(1/r)³ for the offset f − c (Rust's left-to-right products; q₂ = 1 for one charge):
# the offset and 1/r as _bj_vx_offset_ux, the factor into s[5] and e[5].
fn _bj_vx_coulomb_ux(k: f64, q1: f64, q2: f64, f: *f64, c: *f64, s: *f64, e: *i64) {
    _bj_vx_offset_ux(f, c, s, e);
    var ks, ke = _bj_k_ux_from(k);
    var as, ae = _bj_k_ux_from(q1);
    var bs, be = _bj_k_ux_from(q2);
    var m1s, m1e = _bj_k_ux_mul(ks, ke, as, ae);
    var m2s, m2e = _bj_k_ux_mul(m1s, m1e, bs, be);
    var f1s, f1e = _bj_k_ux_mul(m2s, m2e, s[4], e[4]);
    var f2s, f2e = _bj_k_ux_mul(f1s, f1e, s[4], e[4]);
    var f3s, f3e = _bj_k_ux_mul(f2s, f2e, s[4], e[4]);
    s[5] = f3s;
    e[5] = f3e;
    return 0;
}

# k·q₁·q₂·(1/r)³·(f − c) at a range edge, into the three f64 at out (a BjFieldVector's x, y, z): _bj_vx_coulomb_ux,
# each component's product rounded once.
fn _bj_vx_coulomb_edge(k: f64, q1: f64, q2: f64, f: *f64, c: *f64, out) {
    var s: f64[6];
    var e: i64[6];
    _bj_vx_coulomb_ux(k, q1, q2, f, c, &s, &e);
    var o: *f64 = _bj_vx_f64p(out);
    var ox: f64 = _bj_k_ux_mul_f64(s[5], e[5], s[0], e[0]);
    var oy: f64 = _bj_k_ux_mul_f64(s[5], e[5], s[1], e[1]);
    var oz: f64 = _bj_k_ux_mul_f64(s[5], e[5], s[2], e[2]);
    o[0] = ox;
    o[1] = oy;
    o[2] = oz;
    return 0;
}

# 1 when the point-charge chain k·q₁·q₂·(1/r)³·d that Rust evaluated (r² = rsq, its first product kq = k·q₁, then
# kq2 = kq·q₂, the factor fct) is the unbounded one: the fast test of field.cyr's section comment, else a zero charge
# with r² finite (the offset exact, so 0·d has the unbounded chain's signs), or a non-finite input among the n at p.
#must_use
fn _bj_vx_coulomb_plain(rsq: f64, kq: f64, kq2: f64, fct: f64, q1: f64, q2: f64, p: *f64, n): i64 {
    var e1 = (load64(&rsq) >> 52) & 0x7FF;
    var e2 = (load64(&kq) >> 52) & 0x7FF;
    var e3 = (load64(&kq2) >> 52) & 0x7FF;
    var e4 = (load64(&fct) >> 52) & 0x7FF;
    if (((2046 - e1) | (e2 - 2) | (2046 - e2) | (e3 - 2) | (2046 - e3) | (e4 - 2) | (2046 - e4)) >= 0) { return 1; }
    if ((q1 == 0.0 || q2 == 0.0) && e1 <= 2046) { return 1; }               # an exact 0 factor, the offset exact
    if (_bj_vx_finite_n(p, n) == 0) { return 1; }
    return 0;
}

# ── ratio chains (M2 part 2d-2a) ─────────────────────────────────────────────────────────────────────────────────────
# wave's Fresnel ratios (a·x − b·y)/(a·x + b·y), and reflectance_normal's and Schlick's (n₁ − n₂)/(n₁ + n₂) (x = y = 1):
# Rust's p = a·x, q = b·y, num = p − q, den = p + q, then num/den. The file's guard: both products exact for the chain
# (a zero factor, or normal) and both sums finite, since a sum or difference of normal values that lands below 2^-1022
# is exact; then Rust's chain is the unbounded one, bit for bit. Otherwise (a sum past DBL_MAX, or a product below
# 2^-1022 or 0 from nonzero factors) each step runs with an unbounded exponent to 53 bits, the quotient rounded once.
# A ratio's square needs nothing more: a quotient rounded once into binary64 is its 53-bit value unless it lies below
# 2^-1022, where its square underflows to 0 either way.

# 1 when Rust's p = a·x, q = b·y, num = p − q and den = p + q are the unbounded chain's (the section comment), or an
# operand is not finite (Rust's chain stays).
#must_use
fn _bj_vx_ratio_plain(a: f64, x: f64, b: f64, y: f64, p: f64, q: f64, num: f64, den: f64): i64 {
    if (_bj_vx_finite4(a, x, b, y) == 0) { return 1; }
    if (_bj_vx_exact(a, x, p) == 0 || _bj_vx_exact(b, y, q) == 0) { return 0; }
    var an: f64 = f64_abs(num);
    var ad: f64 = f64_abs(den);
    if (an > _BJ_VX_HI || ad > _BJ_VX_HI) { return 0; }
    return 1;
}

# (a·x − b·y)/(a·x + b·y) with an unbounded exponent (the section comment): the products, the difference and the sum
# to 53 bits, the quotient rounded once into binary64 (a zero difference gives IEEE's ±0). st[0] := 1 when the sum is
# 0, 2 when its magnitude lies below the double 1e-30 (the angle forms' test on this sum), else 0.
#must_use
fn _bj_vx_ratio_ux(a: f64, x: f64, b: f64, y: f64, st: *i64): f64 {
    var ps, pe = _bj_vx_mul(a, x);
    var qs, qe = _bj_vx_mul(b, y);
    var ns, ne = _bj_k_ux_sub(ps, pe, qs, qe);
    var ds, de = _bj_k_ux_add(ps, pe, qs, qe);
    st[0] = 0;
    if (ds == 0.0) {
        st[0] = 1;
        return 0.0;
    }
    var ads: f64 = f64_abs(ds);
    var lim: f64 = 0.000000000000000000000000000001;
    var ts, te = _bj_k_ux_from(lim);
    if (_bj_k_ux_cmp(ads, de, ts, te) < 0) { st[0] = 2; }
    var r: f64 = _bj_k_ux_div_f64(ns, ne, ds, de);
    return r;
}

# ── the materials' roots and Γ (M2 part 2d-2c) ───────────────────────────────────────────────────────────────────────
# A lossless material's η = √(μ_r/ε_r) and n = √(ε_r μ_r) are correctly rounded (ADR 0002 row 13), but η passes DBL_MAX
# for μ_r/ε_r above about 2^2048 and both go subnormal (coarse) at the other end, while Γ = (η₂ − η₁)/(η₂ + η₁), the
# Fresnel ratios and cos θ_t depend only on the ratios η₂/η₁ and n₁/n₂. At those edges the roots are taken to 53 bits
# with an unbounded exponent and the chains run on them (row 18's rule).

# √(x/y) (mode 0) or √(x·y) (mode 1) rounded to 53 bits with an unbounded exponent, for positive finite x and y: the
# correctly rounded root of the significands' quotient or product (kimiya's _bj_k_cr_sqrt_div, src/crmath_mono.cyr's
# _bj_cr_sqrt_mono), the exponents' difference or sum made even first (doubling one significand), half of it added back
# exactly (rounding commutes with scaling by a power of two when the exponent is unbounded).
#must_use
fn _bj_vx_sqrt_ux(x: f64, y: f64, mode): (f64, i64) {
    var xs, xe = _bj_k_ux_from(x);
    var ys, ye = _bj_k_ux_from(y);
    var d = xe - ye;
    if (mode == 1) { d = xe + ye; }
    var xv: f64 = xs;
    if ((d & 1) != 0) {
        xv = xs * 2.0;
        d = d - 1;
    }
    var yv: f64 = ys;
    var q: f64 = 0.0;
    if (mode == 0) {
        q = _bj_k_cr_sqrt_div(xv, yv);
    } else {
        var num: f64[2];
        num[0] = xv;
        num[1] = yv;
        q = _bj_cr_sqrt_mono(&num, 2, 0, 0);
    }
    var qs, qe = _bj_k_ux_from(q);
    return (qs, qe + d / 2);
}

# Γ = (η₂ − η₁)/(η₂ + η₁) between two lossless materials, from their correctly rounded η's and their ε_r and μ_r: Rust's
# quotient where both η's lie in (2^-1022, DBL_MAX] and their sum is finite (each η is then its 53-bit value, and a
# difference of normal values below 2^-1022 is exact; an η of exactly 2^-1022 may be a subnormal root rounded up, so it
# takes the other branch); otherwise the chain on η's rounded to 53 bits with an unbounded exponent, the quotient
# rounded once (an η of ∞ had made Γ NaN, a sum past DBL_MAX 0, a subnormal η coarse).
#must_use
fn _bj_vx_gamma(eta1: f64, eta2: f64, e1: f64, m1: f64, e2: f64, m2: f64): f64 {
    var den: f64 = eta2 + eta1;
    var lo: f64 = _BJ_VX_MN;
    var hi: f64 = _BJ_VX_HI;
    if (eta1 > lo && eta1 <= hi && eta2 > lo && eta2 <= hi && den <= hi) {
        var d: f64 = eta2 - eta1;
        var g: f64 = d / den;
        return g;
    }
    var as1, ae1 = _bj_vx_sqrt_ux(m1, e1, 0);
    var as2, ae2 = _bj_vx_sqrt_ux(m2, e2, 0);
    var ns, ne = _bj_k_ux_sub(as2, ae2, as1, ae1);
    var ds, de = _bj_k_ux_add(as2, ae2, as1, ae1);
    var g2: f64 = _bj_k_ux_div_f64(ns, ne, ds, de);
    return g2;
}

# (a·x − b·y)/(a·x + b·y) as _bj_vx_ratio_ux, for a = as·2^ae and b = bs·2^be given as 53-bit pairs.
#must_use
fn _bj_vx_ratio_ux2(as: f64, ae, x: f64, bs: f64, be, y: f64, st: *i64): f64 {
    var xs, xe = _bj_k_ux_from(x);
    var ys, ye = _bj_k_ux_from(y);
    var ps, pe = _bj_k_ux_mul(as, ae, xs, xe);
    var qs, qe = _bj_k_ux_mul(bs, be, ys, ye);
    var ns, ne = _bj_k_ux_sub(ps, pe, qs, qe);
    var ds, de = _bj_k_ux_add(ps, pe, qs, qe);
    st[0] = 0;
    if (ds == 0.0) {
        st[0] = 1;
        return 0.0;
    }
    var r: f64 = _bj_k_ux_div_f64(ns, ne, ds, de);
    return r;
}

# --- fmtf.cyr ---

# fmtf.cyr — f64 to text: the shortest round-trip digits, in Rust's Display and serde_json's forms.
#
# Copied from impetus's src/fmtf.cyr (its ADR 0010) with the prefixes renamed (_im_ → _bj_): the bignum and the
# digit generator are impetus's, line for line (keep the two in step). Both Rust printers bijli's text comes from
# print the SHORTEST digits that parse back to the same double, choosing the closest to the exact value among them:
# Rust's `Display` (core's Grisu with a Dragon fallback) and serde_json 1.0.154's zmij (Schubfach). They differ only
# on an exact tie between two closest candidates: core rounds it up, zmij to the even digit. The digits come from
# Burger & Dybvig's free-format algorithm ("Printing Floating-Point Numbers Quickly and Accurately", 1996) on a
# small bignum: exact, with no tables. tests/golden/fmtf.tsv pins both forms against Rust over every binade, the
# powers of ten, the ties and a seeded sweep.
#
# bijli's change is the output: a bounded text buffer (BjText below) instead of a growing string builder, so the
# error record (src/error.cyr) and the log lines (src/log.cyr) format into fixed storage and nothing allocates.
# One f64 needs at most 327 bytes in either form (the smallest subnormal is "0." + 323 zeros + "5" in Display).
#
# Forms:
# - `_bj_fmt_f64_debug` (bijli's, M1 part 3c): Rust's `{:?}` — exponential below 1e-4 and from 1e16, else positional
#   with a fractional digit (`1.0`, `1e-5`, `1e16`), for the `{pos:?}` in trace_field_line's errors.
# - `_bj_fmt_f64_display`: Rust's `{}` — always positional, no ".0" (`100`, `0.1`, `-0`), `NaN`, `inf`, `-inf`.
# - `_bj_fmt_f64_json`: serde_json — positional while the decimal exponent is in −5..=15, with ".0" on an integer
#   (`100.0`, `0.00001`); otherwise `d.ddde±x` (`1e+16`, `1.5e-7`); `null` for NaN and ±∞.
# - `_bj_fmt_f64_fixed` (bijli's, M2 part 1b): Rust's `{:.p}` — not the shortest digits but the exact value rounded
#   half to even at p decimals (`1.0312` for 1.03125), for wave.rs's and beam.rs's `{ratio:.4}`. Its digits come from
#   the same bignum: x·10^p, shifted, rounded, then divided down by 10^9.

# ── BjText: a bounded text buffer ───────────────────────────────────────────────────
# Three words: the buffer's address, its capacity in bytes, and the length written so far. The text is kept
# NUL-terminated; bytes past capacity − 1 are dropped and counted in the length, so `_bj_tx_overflowed` tells.

# t = an empty text over [buf, buf + cap), cap ≥ 1.
fn _bj_tx_init(t, buf, cap) {
    store64(t, buf);
    store64(t + 8, cap);
    store64(t + 16, 0);
    store8(buf, 0);
    return 0;
}

# The text's address (NUL-terminated).
#must_use
fn _bj_tx_ptr(t): i64 {
    return load64(t);
}

# The number of bytes kept (below the capacity).
#must_use
fn _bj_tx_len(t): i64 {
    var n = load64(t + 16);
    var cap = load64(t + 8);
    if (n > cap - 1) { return cap - 1; }
    return n;
}

# 1 when bytes were dropped for want of room.
#must_use
fn _bj_tx_overflowed(t): i64 {
    if (load64(t + 16) > load64(t + 8) - 1) { return 1; }
    return 0;
}

# Appends byte c.
fn _bj_tx_putc(t, c) {
    var n = load64(t + 16);
    var buf = load64(t);
    if (n < load64(t + 8) - 1) {
        store8(buf + n, c);
        store8(buf + n + 1, 0);
    }
    store64(t + 16, n + 1);
    return 0;
}

# Appends the C string s (one loop over its bytes, the same result as a _bj_tx_putc per byte).
fn _bj_tx_cstr(t, s) {
    var n = load64(t + 16);
    var room = load64(t + 8) - 1;
    var buf = load64(t);
    var i = 0;
    var c = load8(s);
    while (c != 0) {
        if (n + i < room) { store8(buf + n + i, c); }
        i = i + 1;
        c = load8(s + i);
    }
    var end = n + i;
    if (end < room) { store8(buf + end, 0); } else { store8(buf + room, 0); }
    store64(t + 16, end);
    return 0;
}

# Appends n as an unsigned decimal (a Rust `usize` or `u64`: the word's 64 bits, so 2^63 and above print as
# themselves).
fn _bj_tx_u64(t, n) {
    var d[24];
    var k = 0;
    var v = n;
    if (v < 0) {
        # The top bit set: split off the last digit with an unsigned divide by 10 (v = 2q + r).
        var q = (v >> 1) & 0x7FFFFFFFFFFFFFFF;
        var hi = q / 5;
        var lo = v - hi * 10;
        store8(&d, 48 + lo);
        k = 1;
        v = hi;
    }
    if (v == 0 && k == 0) {
        _bj_tx_putc(t, 48);
        return 0;
    }
    while (v != 0) {
        store8(&d + k, 48 + v % 10);
        v = v / 10;
        k = k + 1;
    }
    while (k > 0) {
        k = k - 1;
        _bj_tx_putc(t, load8(&d + k));
    }
    return 0;
}

# Appends n as a signed decimal (a Rust `i64` or `i32`).
fn _bj_tx_i64(t, n) {
    if (n < 0) {
        _bj_tx_putc(t, 45);
        if (n == 0 - 9223372036854775807 - 1) {
            _bj_tx_cstr(t, "9223372036854775808");
            return 0;
        }
        _bj_tx_u64(t, 0 - n);
        return 0;
    }
    _bj_tx_u64(t, n);
    return 0;
}

# ── bignum ──────────────────────────────────────────────────────────────────────────
# A non-negative integer in 32-bit limbs, little-endian: word 0 the limb count, words 1..40 the limbs.
# 40 limbs hold 2^1280; the algorithm's values stay below 2^1140. No leading zero limbs.
var _BJ_BN_WORDS = 41;

# a := v, for 0 <= v < 2^63.
fn _bj_bn_set(a, v) {
    var n = 0;
    var x = v;
    while (x != 0) {
        store64(a + 8 + n * 8, x & 0xFFFFFFFF);
        x = x >> 32;
        n = n + 1;
    }
    store64(a, n);
    return 0;
}

# dst := src.
fn _bj_bn_copy(dst, src) {
    var n = load64(src);
    for (var i = 0; i <= n; i = i + 1) { store64(dst + i * 8, load64(src + i * 8)); }
    return 0;
}

# a := a × m, for 0 < m < 2^31.
fn _bj_bn_mul_small(a, m) {
    var n = load64(a);
    var carry = 0;
    for (var i = 0; i < n; i = i + 1) {
        var t = load64(a + 8 + i * 8) * m + carry;
        store64(a + 8 + i * 8, t & 0xFFFFFFFF);
        carry = t >> 32;
    }
    while (carry != 0) {
        store64(a + 8 + n * 8, carry & 0xFFFFFFFF);
        carry = carry >> 32;
        n = n + 1;
    }
    store64(a, n);
    return 0;
}

# a := a × 10^k, for k >= 0 (in steps of 10^9).
fn _bj_bn_mul_pow10(a, k) {
    var left = k;
    while (left >= 9) {
        _bj_bn_mul_small(a, 1000000000);
        left = left - 9;
    }
    var m = 1;
    for (var i = 0; i < left; i = i + 1) { m = m * 10; }
    if (m > 1) { _bj_bn_mul_small(a, m); }
    return 0;
}

# a := a × 2^k, for k >= 0.
fn _bj_bn_shl(a, k) {
    var n = load64(a);
    if (n == 0) { return 0; }
    var q = k / 32;
    var b = k % 32;
    if (b != 0) {
        var carry = 0;
        for (var i = 0; i < n; i = i + 1) {
            var t = (load64(a + 8 + i * 8) << b) | carry;
            store64(a + 8 + i * 8, t & 0xFFFFFFFF);
            carry = t >> 32;
        }
        if (carry != 0) {
            store64(a + 8 + n * 8, carry);
            n = n + 1;
        }
    }
    if (q > 0) {
        var i = n - 1;
        while (i >= 0) {
            store64(a + 8 + (i + q) * 8, load64(a + 8 + i * 8));
            i = i - 1;
        }
        for (var j = 0; j < q; j = j + 1) { store64(a + 8 + j * 8, 0); }
        n = n + q;
    }
    store64(a, n);
    return 0;
}

# dst := a + b (dst distinct from both).
fn _bj_bn_sum(dst, a, b) {
    var na = load64(a);
    var nb = load64(b);
    var n = na;
    if (nb > n) { n = nb; }
    var carry = 0;
    for (var i = 0; i < n; i = i + 1) {
        var x = 0;
        var y = 0;
        if (i < na) { x = load64(a + 8 + i * 8); }
        if (i < nb) { y = load64(b + 8 + i * 8); }
        var t = x + y + carry;
        store64(dst + 8 + i * 8, t & 0xFFFFFFFF);
        carry = t >> 32;
    }
    if (carry != 0) {
        store64(dst + 8 + n * 8, carry);
        n = n + 1;
    }
    store64(dst, n);
    return 0;
}

# -1, 0 or 1 as a < b, a = b, a > b.
#must_use
fn _bj_bn_cmp(a, b): i64 {
    var na = load64(a);
    var nb = load64(b);
    if (na != nb) {
        if (na < nb) { return 0 - 1; }
        return 1;
    }
    var i = na - 1;
    while (i >= 0) {
        var x = load64(a + 8 + i * 8);
        var y = load64(b + 8 + i * 8);
        if (x != y) {
            if (x < y) { return 0 - 1; }
            return 1;
        }
        i = i - 1;
    }
    return 0;
}

# a := a − b, for a >= b.
fn _bj_bn_sub(a, b) {
    var na = load64(a);
    var nb = load64(b);
    var borrow = 0;
    for (var i = 0; i < na; i = i + 1) {
        var y = 0;
        if (i < nb) { y = load64(b + 8 + i * 8); }
        var t = load64(a + 8 + i * 8) - y - borrow;
        borrow = 0;
        if (t < 0) {
            t = t + 0x100000000;
            borrow = 1;
        }
        store64(a + 8 + i * 8, t);
    }
    while (na > 0 && load64(a + na * 8) == 0) { na = na - 1; }
    store64(a, na);
    return 0;
}

# a := ⌊a / 2^k⌋, for k >= 0 (bijli's, for _bj_fmt_f64_fixed).
fn _bj_bn_shr(a, k) {
    var n = load64(a);
    var q = k / 32;
    var b = k % 32;
    if (q >= n) {
        store64(a, 0);
        return 0;
    }
    var m = n - q;
    for (var i = 0; i < m; i = i + 1) {
        var lo = load64(a + 8 + (i + q) * 8) >> b;
        var hi = 0;
        if (b != 0 && i + q + 1 < n) { hi = (load64(a + 8 + (i + q + 1) * 8) << (32 - b)) & 0xFFFFFFFF; }
        store64(a + 8 + i * 8, lo | hi);
    }
    while (m > 0 && load64(a + m * 8) == 0) { m = m - 1; }
    store64(a, m);
    return 0;
}

# Bit i of a, 0 or 1 (bijli's).
#must_use
fn _bj_bn_bit(a, i): i64 {
    var w = i / 32;
    if (w >= load64(a)) { return 0; }
    return (load64(a + 8 + w * 8) >> (i % 32)) & 1;
}

# 1 when a bit of a below bit i is set, else 0 (bijli's).
#must_use
fn _bj_bn_any_below(a, i): i64 {
    var w = i / 32;
    var n = load64(a);
    for (var j = 0; j < w && j < n; j = j + 1) {
        if (load64(a + 8 + j * 8) != 0) { return 1; }
    }
    if (w < n) {
        var mask = (1 << (i % 32)) - 1;
        if ((load64(a + 8 + w * 8) & mask) != 0) { return 1; }
    }
    return 0;
}

# a := ⌊a / d⌋, returning a mod d, for 0 < d < 2^31 (bijli's).
fn _bj_bn_divmod_small(a, d): i64 {
    var n = load64(a);
    var rem = 0;
    var i = n - 1;
    while (i >= 0) {
        var cur = (rem << 32) | load64(a + 8 + i * 8);
        store64(a + 8 + i * 8, cur / d);
        rem = cur % d;
        i = i - 1;
    }
    while (n > 0 && load64(a + n * 8) == 0) { n = n - 1; }
    store64(a, n);
    return rem;
}

# The number of bits in x > 0.
#must_use
fn _bj_bitlen(x): i64 {
    var n = 0;
    var v = x;
    while (v != 0) {
        v = v >> 1;
        n = n + 1;
    }
    return n;
}

# ── shortest digits (Burger & Dybvig, free format) ──────────────────────────────────

# The shortest decimal digits of the positive finite double with bits `bits` that read back to it,
# the closest to its exact value among them: writes the ASCII digits to `digits` (17 bytes is
# enough) and returns (n, k) with value = 0.d1d2…dn × 10^k. When the exact value lies exactly
# halfway between the two closest candidates, `tie_even` 0 takes the upper one (Rust's core
# printer: 2^-25 is 2.9802322387695313e-8) and 1 the even one (serde_json's zmij: …5312e-8).
fn _bj_shortest(bits, digits, tie_even) {
    var be = (bits >> 52) & 0x7FF;
    var f = bits & 0xFFFFFFFFFFFFF;
    var e = 0 - 1074;
    if (be != 0) {
        f = f | 0x10000000000000;
        e = be - 1075;
    }
    # IEEE round-half-even on reading: the interval's ends belong to it when f is even.
    var even = 1 - (f & 1);
    var r[328];
    var s[328];
    var mp[328];
    var mm[328];
    var t[328];
    if (e >= 0) {
        if (f != 0x10000000000000) {
            _bj_bn_set(&r, f);
            _bj_bn_shl(&r, e + 1);
            _bj_bn_set(&s, 2);
            _bj_bn_set(&mp, 1);
            _bj_bn_shl(&mp, e);
            _bj_bn_copy(&mm, &mp);
        } else {
            _bj_bn_set(&r, f);
            _bj_bn_shl(&r, e + 2);
            _bj_bn_set(&s, 4);
            _bj_bn_set(&mp, 1);
            _bj_bn_shl(&mp, e + 1);
            _bj_bn_set(&mm, 1);
            _bj_bn_shl(&mm, e);
        }
    } else {
        if (e == 0 - 1074 || f != 0x10000000000000) {
            _bj_bn_set(&r, f);
            _bj_bn_shl(&r, 1);
            _bj_bn_set(&s, 1);
            _bj_bn_shl(&s, 1 - e);
            _bj_bn_set(&mp, 1);
            _bj_bn_set(&mm, 1);
        } else {
            _bj_bn_set(&r, f);
            _bj_bn_shl(&r, 2);
            _bj_bn_set(&s, 1);
            _bj_bn_shl(&s, 2 - e);
            _bj_bn_set(&mp, 2);
            _bj_bn_set(&mm, 1);
        }
    }
    # k = ⌈log10(v) − 1e-10⌉ from the binary exponent: never too large, at most one too small
    # (the fixup below adds the one).
    var lg: f64 = f64_from(e + _bj_bitlen(f) - 1);
    var est: f64 = lg * 0.30102999566398114 - 0.0000000001;
    var k = f64_to(f64_ceil(est));
    if (k >= 0) {
        _bj_bn_mul_pow10(&s, k);
    } else {
        _bj_bn_mul_pow10(&r, 0 - k);
        _bj_bn_mul_pow10(&mp, 0 - k);
        _bj_bn_mul_pow10(&mm, 0 - k);
    }
    _bj_bn_sum(&t, &r, &mp);
    var c = _bj_bn_cmp(&t, &s);
    if ((even == 1 && c >= 0) || (even == 0 && c > 0)) {
        _bj_bn_mul_small(&s, 10);
        k = k + 1;
    }
    var n = 0;
    while (1) {
        _bj_bn_mul_small(&r, 10);
        _bj_bn_mul_small(&mp, 10);
        _bj_bn_mul_small(&mm, 10);
        var d = 0;
        while (_bj_bn_cmp(&r, &s) >= 0) {
            _bj_bn_sub(&r, &s);
            d = d + 1;
        }
        var lo = _bj_bn_cmp(&r, &mm);
        var tc1 = 0;
        if (lo < 0 || (even == 1 && lo == 0)) { tc1 = 1; }
        _bj_bn_sum(&t, &r, &mp);
        var hi = _bj_bn_cmp(&t, &s);
        var tc2 = 0;
        if (hi > 0 || (even == 1 && hi == 0)) { tc2 = 1; }
        if (tc1 == 0 && tc2 == 0) {
            store8(digits + n, 48 + d);
            n = n + 1;
        } else {
            if (tc1 == 1 && tc2 == 1) {
                # Both neighbours read back: the closer one, 2r against s; a tie per `tie_even`.
                _bj_bn_copy(&t, &r);
                _bj_bn_shl(&t, 1);
                var half = _bj_bn_cmp(&t, &s);
                if (half > 0) { d = d + 1; }
                if (half == 0 && (tie_even == 0 || (d & 1) == 1)) { d = d + 1; }
            } elif (tc2 == 1) {
                d = d + 1;
            }
            store8(digits + n, 48 + d);
            n = n + 1;
            return (n, k);
        }
    }
    return (n, k);
}

# ── formatting ──────────────────────────────────────────────────────────────────────

# Appends `count` copies of byte c.
fn _bj_tx_repeat(t, c, count) {
    for (var i = 0; i < count; i = i + 1) { _bj_tx_putc(t, c); }
    return 0;
}

# Appends digits [from, to) of `digits`.
fn _bj_tx_digits(t, digits, from, to) {
    for (var i = from; i < to; i = i + 1) { _bj_tx_putc(t, load8(digits + i)); }
    return 0;
}

# Appends 0.d1…dn × 10^k positionally: "123.45", "0.00012", "12300". With `int_suffix` 1, an integer gets ".0"
# (serde_json's form).
fn _bj_tx_positional(t, digits, n, k, int_suffix) {
    if (k <= 0) {
        _bj_tx_putc(t, 48);
        _bj_tx_putc(t, 46);
        _bj_tx_repeat(t, 48, 0 - k);
        _bj_tx_digits(t, digits, 0, n);
        return 0;
    }
    if (k >= n) {
        _bj_tx_digits(t, digits, 0, n);
        _bj_tx_repeat(t, 48, k - n);
        if (int_suffix == 1) {
            _bj_tx_putc(t, 46);
            _bj_tx_putc(t, 48);
        }
        return 0;
    }
    _bj_tx_digits(t, digits, 0, k);
    _bj_tx_putc(t, 46);
    _bj_tx_digits(t, digits, k, n);
    return 0;
}

# Appends x as Rust's `Display` (`{}`) writes an f64. Mirrors `<f64 as Display>::fmt`.
fn _bj_fmt_f64_display(t, x: f64) {
    var bits = _bj_bits(x);
    if (x != x) {
        _bj_tx_cstr(t, "NaN");
        return 0;
    }
    if (bits < 0) { _bj_tx_putc(t, 45); }
    var mag = bits & 0x7FFFFFFFFFFFFFFF;
    if (mag == 0x7FF0000000000000) {
        _bj_tx_cstr(t, "inf");
        return 0;
    }
    if (mag == 0) {
        _bj_tx_putc(t, 48);
        return 0;
    }
    var digits[24];
    var n, k = _bj_shortest(mag, &digits, 0);
    _bj_tx_positional(t, &digits, n, k, 0);
    return 0;
}

# Appends x as Rust's `Debug` (`{:?}`) writes an f64 (core's `float_to_general_debug`): the shortest digits as Display,
# but exponential (`1e-5`, `1.5e16`, no `+`) when |x| is non-zero and below 1e-4, or at least 1e16, and otherwise
# positional with at least one fractional digit (`1.0`, `0.1`); `NaN`, `inf`, `-inf`, `0.0`, `-0.0`. Mirrors
# `<f64 as Debug>::fmt`.
fn _bj_fmt_f64_debug(t, x: f64) {
    var bits = _bj_bits(x);
    if (x != x) {
        _bj_tx_cstr(t, "NaN");
        return 0;
    }
    if (bits < 0) { _bj_tx_putc(t, 45); }
    var mag = bits & 0x7FFFFFFFFFFFFFFF;
    if (mag == 0x7FF0000000000000) {
        _bj_tx_cstr(t, "inf");
        return 0;
    }
    if (mag == 0) {
        _bj_tx_cstr(t, "0.0");
        return 0;
    }
    var digits[24];
    var n, k = _bj_shortest(mag, &digits, 0);
    var ax: f64 = _bj_from_bits(mag);
    var lo: f64 = 0.0001;
    var hi: f64 = 10000000000000000.0;
    if (ax < lo || ax >= hi) {
        _bj_tx_putc(t, load8(&digits));
        if (n > 1) {
            _bj_tx_putc(t, 46);
            _bj_tx_digits(t, &digits, 1, n);
        }
        _bj_tx_putc(t, 101);
        _bj_tx_i64(t, k - 1);
        return 0;
    }
    _bj_tx_positional(t, &digits, n, k, 1);
    return 0;
}

# Appends a Rust `[f64; 3]` as its Debug writes it: "[a, b, c]", each element in f64 Debug form. Mirrors
# `<[f64; 3] as Debug>::fmt`.
fn _bj_fmt_f64x3_debug(t, p: *f64) {
    _bj_tx_putc(t, 91);
    _bj_fmt_f64_debug(t, p[0]);
    _bj_tx_cstr(t, ", ");
    _bj_fmt_f64_debug(t, p[1]);
    _bj_tx_cstr(t, ", ");
    _bj_fmt_f64_debug(t, p[2]);
    _bj_tx_putc(t, 93);
    return 0;
}

# Appends x as Rust's `{x:.p}` writes an f64 (core's `float_to_decimal_common_exact`), for 0 ≤ p ≤ 17: x = m·2^e
# exactly, so N = m·10^p·2^e rounded half to even is an integer, written with a point p digits from its right and at
# least one digit before it (`0.0001`, `10.0000`, `1000000000000000052504760255204420248704468581108159154915854115…`).
# The sign stays on a zero and on a value that rounds to zero (`-0.0000`); `NaN`, `inf`, `-inf`. Mirrors
# `format!("{x:.p}")`.
fn _bj_fmt_f64_fixed(t, x: f64, prec) {
    var bits = _bj_bits(x);
    if (x != x) {
        _bj_tx_cstr(t, "NaN");
        return 0;
    }
    if (bits < 0) { _bj_tx_putc(t, 45); }
    var mag = bits & 0x7FFFFFFFFFFFFFFF;
    if (mag == 0x7FF0000000000000) {
        _bj_tx_cstr(t, "inf");
        return 0;
    }
    var be = mag >> 52;
    var m = mag & 0xFFFFFFFFFFFFF;
    var e = 0 - 1074;
    if (be != 0) {
        m = m | 0x10000000000000;
        e = be - 1075;
    }
    var a[328];
    _bj_bn_set(&a, m);
    _bj_bn_mul_pow10(&a, prec);
    if (e >= 0) { _bj_bn_shl(&a, e); }
    if (e < 0) {
        var s = 0 - e;
        var half = _bj_bn_bit(&a, s - 1);
        var below = _bj_bn_any_below(&a, s - 1);
        _bj_bn_shr(&a, s);
        if (half == 1 && (below == 1 || _bj_bn_bit(&a, 0) == 1)) {
            var one[328];
            var up[328];
            _bj_bn_set(&one, 1);
            _bj_bn_sum(&up, &a, &one);
            _bj_bn_copy(&a, &up);
        }
    }
    # N's digits, least significant first, at least p + 1 of them.
    var rev[352];
    var n = 0;
    while (load64(&a) != 0) {
        var r = _bj_bn_divmod_small(&a, 1000000000);
        for (var j = 0; j < 9; j = j + 1) {
            store8(&rev + n, 48 + r % 10);
            r = r / 10;
            n = n + 1;
        }
    }
    while (n > 0 && load8(&rev + n - 1) == 48) { n = n - 1; }
    while (n < prec + 1) {
        store8(&rev + n, 48);
        n = n + 1;
    }
    var i = n - 1;
    while (i >= prec) {
        _bj_tx_putc(t, load8(&rev + i));
        i = i - 1;
    }
    if (prec > 0) {
        _bj_tx_putc(t, 46);
        while (i >= 0) {
            _bj_tx_putc(t, load8(&rev + i));
            i = i - 1;
        }
    }
    return 0;
}

# The number of non-finite values _bj_fmt_f64_json has written as `null`, as serde_json does. A caller that must
# not lose one zeroes it, writes, and checks it.
var _bj_json_nonfinite = 0;

# Appends x as serde_json 1.0.154 writes an f64 (zmij's format). Mirrors `serde_json::to_string(&x)`.
fn _bj_fmt_f64_json(t, x: f64) {
    var bits = _bj_bits(x);
    var mag = bits & 0x7FFFFFFFFFFFFFFF;
    if (mag >= 0x7FF0000000000000) {
        _bj_json_nonfinite = _bj_json_nonfinite + 1;
        _bj_tx_cstr(t, "null");
        return 0;
    }
    if (bits < 0) { _bj_tx_putc(t, 45); }
    if (mag == 0) {
        _bj_tx_cstr(t, "0.0");
        return 0;
    }
    var digits[24];
    var n, k = _bj_shortest(mag, &digits, 1);
    var ex = k - 1;
    if (ex >= 0 - 5 && ex <= 15) {
        _bj_tx_positional(t, &digits, n, k, 1);
        return 0;
    }
    _bj_tx_putc(t, load8(&digits));
    if (n > 1) {
        _bj_tx_putc(t, 46);
        _bj_tx_digits(t, &digits, 1, n);
    }
    _bj_tx_putc(t, 101);
    if (ex >= 0) {
        _bj_tx_putc(t, 43);
        _bj_tx_i64(t, ex);
    } else {
        _bj_tx_putc(t, 45);
        _bj_tx_i64(t, 0 - ex);
    }
    return 0;
}

# --- crmath_gamma.cyr ---

# crmath_gamma.cyr — bijli's correctly rounded Lorentz factor (M2's range-edge Part, ADR 0002 row 30, the user's answer
# of 2026-11-12): γ = c/√(c² − Σvᵢ²) (mode 0) and γ² = c²/(c² − Σvᵢ²) (mode 1), each rounded once (to nearest, ties to
# even, +∞ past DBL_MAX), from the exact difference D = c² − Σvᵢ² of the inputs' squares. relativity.rs's
# 1/√(1 − v²/c²) cancels near c, a relative error of about 2^-53/(1 − β²); here the validity test |v| < c is exact
# too (D > 0).
#
# Fast path, one nonzero component a: D = (c − a)(c + a) in double-double, within 2^-103 (the common case: a speed,
# or a velocity along an axis). Several: D as a nonoverlapping expansion of the eight doubles c² = C2H + C2L and
# −vᵢ² = −(pᵢ + eᵢ) (TwoProduct, exact for |vᵢ| ≥ 2^-450; Shewchuk's Grow-Expansion, exact), its sign the largest
# component's. Shewchuk's Compress makes it nonadjacent, so its top two components are D within 2^-104 relative (a
# nonoverlapping expansion's lower components need not be small: 64 + (−7.43…) is one, which is why summing them in
# double is not enough). c lies in [2^-30, 2^30] (bijli passes the speed of light, or 1; any other c is refused), so D
# stays in [2^-790, 2^60], √D in [2^-395, 2^30], γ below 2^425 and γ² below 2^850: inside every range of TwoProduct
# and kimiya's rounding test, with no term subnormal, so the fast paths work on D unscaled (a scaling by 4^j would
# change no bit). γ = c/√D (the double-double square root adds 2^-103.4) or γ² = c²/D go through that test
# (_bj_k_dd_div_cr, src/crmath_kx.cyr: an input error up to 32·2^-106). Slow path, when the test fails (a value within
# about 2^-100 of a midpoint) or a component below 2^-450 leaves D under 2^-790: D exact as a bignum in units of 2^K,
# K the smallest 2E of the inputs (src/fmtf.cyr's bignum, in buffers of 82 words: D_u ≤ 2^2208, the midpoint products
# below 2^2320), normalised to D_n = D·2^-2j in [1, 4), the candidate from its top 104 bits, then the exact signs of
# value − μ at the neighbouring midpoints μ (c² against μ²·D_n, or μ·D_n), ties to even. `cr_verify.py`'s gamma
# families check both paths against Python's Fraction and an integer square root, on x86_64 and aarch64.

# A bignum buffer's size in words (src/fmtf.cyr's layout: the limb count, then 32-bit limbs).
var _BJ_G_WORDS = 82;

# The exponent offset of part i in _bj_cr_lorentz's offset form, 0 without one (M2 part 2d-3i).
#must_use
fn _bj_g_off(vo, i): i64 {
    if (vo == 0) { return 0; }
    return load64(vo + 8 * i);
}

# 2^k, for −1022 ≤ k ≤ 1023.
#must_use
fn _bj_g_pow2(k): f64 {
    var x: f64 = _bj_from_bits((k + 1023) << 52);
    return x;
}

# x·2^k for any k, by steps of at most 2^1000: exact unless the result overflows (+∞; every caller's x·2^k ≥ 1/4).
#must_use
fn _bj_g_scale(x: f64, k): f64 {
    var r: f64 = x;
    var left = k;
    while (left > 1000) {
        var p: f64 = _bj_g_pow2(1000);
        r = r * p;
        left = left - 1000;
    }
    while (left < 0 - 1000) {
        var q: f64 = _bj_g_pow2(0 - 1000);
        r = r * q;
        left = left + 1000;
    }
    var s: f64 = _bj_g_pow2(left);
    r = r * s;
    return r;
}

# ⌊k/2⌋ for any integer k.
#must_use
fn _bj_g_half_floor(k): i64 {
    if (k >= 0) { return k / 2; }
    return 0 - ((1 - k) / 2);
}

# me[0], me[1] := (M, E) with |x| = M·2^E, for a finite nonzero x: 2^52 ≤ M < 2^53, or a subnormal's significand and
# E = −1074.
fn _bj_g_split(x: f64, me) {
    var b = _bj_bits(x) & 0x7FFFFFFFFFFFFFFF;
    var ex = b >> 52;
    var m = b & 0xFFFFFFFFFFFFF;
    if (ex == 0) {
        store64(me, m);
        store64(me + 8, 0 - 1074);
        return 0;
    }
    store64(me, m | 0x10000000000000);
    store64(me + 8, ex - 1075);
    return 0;
}

# a := a·m for 0 ≤ m < 2^31, the count trimmed when m = 0 (src/fmtf.cyr's _bj_bn_mul_small keeps it).
fn _bj_g_mul_small(a, m) {
    if (m == 0) {
        store64(a, 0);
        return 0;
    }
    _bj_bn_mul_small(a, m);
    return 0;
}

# a := a + b in place.
fn _bj_g_add_to(a, b) {
    var na = load64(a);
    var nb = load64(b);
    var n = na;
    if (nb > n) { n = nb; }
    var carry = 0;
    for (var i = 0; i < n; i = i + 1) {
        var x = 0;
        var y = 0;
        if (i < na) { x = load64(a + 8 + i * 8); }
        if (i < nb) { y = load64(b + 8 + i * 8); }
        var s = x + y + carry;
        store64(a + 8 + i * 8, s & 0xFFFFFFFF);
        carry = s >> 32;
    }
    if (carry != 0) {
        store64(a + 8 + n * 8, carry);
        n = n + 1;
    }
    store64(a, n);
    return 0;
}

# a := a·m for 0 ≤ m < 2^62, in two 31-bit chunks; t a scratch bignum.
fn _bj_g_mul(a, m, t) {
    var hi = m >> 31;
    var lo = m & 0x7FFFFFFF;
    _bj_bn_copy(t, a);
    _bj_g_mul_small(t, hi);
    _bj_bn_shl(t, 31);
    _bj_g_mul_small(a, lo);
    _bj_g_add_to(a, t);
    return 0;
}

# The bit length of a (0 for zero).
#must_use
fn _bj_g_bitlen(a): i64 {
    var n = load64(a);
    if (n == 0) { return 0; }
    var top = load64(a + 8 + (n - 1) * 8);
    var b = _bj_bitlen(top);
    return (n - 1) * 32 + b;
}

# Limb i of a (0 past its count).
#must_use
fn _bj_g_limb(a, i): i64 {
    if (i >= load64(a)) { return 0; }
    return load64(a + 8 + i * 8);
}

# Adds b to the nonoverlapping expansion ex[0..k), increasing magnitude, exactly (Shewchuk's Grow-Expansion with zero
# elimination); returns its new length.
#must_use
fn _bj_g_grow(ex: *f64, k, b: f64): i64 {
    var q: f64 = b;
    var m = 0;
    for (var i = 0; i < k; i = i + 1) {
        var e: f64 = ex[i];
        var ss: f64 = q + e;                        # TwoSum, inline
        var bb: f64 = ss - q;
        var hh: f64 = (q - (ss - bb)) + (e - bb);
        if (hh != 0.0) {
            ex[m] = hh;
            m = m + 1;
        }
        q = ss;
    }
    if (q != 0.0) {
        ex[m] = q;
        m = m + 1;
    }
    return m;
}

# (h, l) := the top two components of the nonoverlapping expansion ex[0..k) (1 ≤ k ≤ 16, increasing magnitude) after
# Shewchuk's Compress, renormalised: within 2^-104 of the sum, relative (the rest of a nonadjacent expansion is below
# ulp of its second component). ex is overwritten.
#must_use
fn _bj_g_compress(ex: *f64, k): (f64, f64) {
    var g: f64[16];
    var q0: f64 = ex[k - 1];
    var bottom = k - 1;
    var i = k - 2;
    while (i >= 0) {
        var e: f64 = ex[i];
        var s, r = _bj_cr_fast_two_sum(q0, e);
        var ss: f64 = s;
        var rr: f64 = r;
        if (rr != 0.0) {
            g[bottom] = ss;
            bottom = bottom - 1;
            q0 = rr;
        } else {
            q0 = ss;
        }
        i = i - 1;
    }
    g[bottom] = q0;
    var top = 0;
    var q1: f64 = g[bottom];
    for (var m = bottom + 1; m < k; m = m + 1) {
        var gm: f64 = g[m];
        var s2, r2 = _bj_cr_fast_two_sum(gm, q1);
        var ss2: f64 = s2;
        var rr2: f64 = r2;
        if (rr2 != 0.0) {
            ex[top] = rr2;
            top = top + 1;
        }
        q1 = ss2;
    }
    var lo: f64 = 0.0;
    if (top > 0) { lo = ex[top - 1]; }
    var h, l = _bj_cr_fast_two_sum(q1, lo);
    return (h, l);
}

# (h, l) ≈ √(dh + dl) as a double-double, for dh in [2^-800, 2^800]: one Newton correction on RN(√dh), within 2^-103.4
# (the bound is scale-free: in that range no term is subnormal and TwoProduct is exact).
#must_use
fn _bj_g_sqrt_dd(dh: f64, dl: f64): (f64, f64) {
    var sh: f64 = f64_sqrt(dh);
    var p, e = _bj_cr_two_prod(sh, sh);
    var pp: f64 = p;
    var pe: f64 = e;
    var r0: f64 = dh - pp;
    var r1: f64 = r0 - pe;
    var r: f64 = r1 + dl;
    var den: f64 = 2.0 * sh;
    var sl: f64 = r / den;
    var h, l = _bj_cr_fast_two_sum(sh, sl);
    return (h, l);
}

# The expansion of D = c² − Σvᵢ² into ex (eight f64), exact but for the components below 2^-450 (|vᵢ|² < 2^-900),
# which are left out: their presence in *tiny (1). An offset part (vo, _bj_cr_lorentz's) is one of them. Returns its
# length (0 for D = 0).
fn _bj_g_expansion(v: *f64, vo, n, c: f64, ex: *f64, tiny): i64 {
    var k = 0;
    store64(tiny, 0);
    var tiny_cut: f64 = _bj_g_pow2(0 - 450);
    var c2h, c2l = _bj_cr_two_prod(c, c);
    var ch: f64 = c2h;
    var cl: f64 = c2l;
    k = _bj_g_grow(ex, k, cl);
    k = _bj_g_grow(ex, k, ch);
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = v[i];
        var ax: f64 = f64_abs(x);
        if (ax == 0.0) { continue; }
        var off = 0;
        if (vo != 0) { off = load64(vo + 8 * i); }
        if (ax < tiny_cut || off != 0) {
            store64(tiny, 1);
            continue;
        }
        var p, e = _bj_cr_two_prod(x, x);
        var pp: f64 = p;
        var pe: f64 = e;
        var np: f64 = -pp;
        var ne: f64 = -pe;
        k = _bj_g_grow(ex, k, ne);
        k = _bj_g_grow(ex, k, np);
    }
    return k;
}

# The fast path: 1 with the result in out[0], 0 when D ≤ 0 (|v| ≥ c), −1 when undecided (the slow path's).
fn _bj_g_fast(v: *f64, vo, n, c: f64, mode, out: *f64): i64 {
    var ex: f64[8];
    var tw[8];
    var k = _bj_g_expansion(v, vo, n, c, &ex, &tw);
    if (k == 0) { return 0; }
    var top: f64 = ex[k - 1];
    if (top < 0.0) { return 0; }
    var dh, dl = _bj_g_compress(&ex, k);
    var d_h: f64 = dh;
    var d_l: f64 = dl;
    var floor_d: f64 = _bj_g_pow2(0 - 790);
    if (d_h < floor_d) { return 0 - 1; }
    if (mode == 0) {
        var sh, sl = _bj_g_sqrt_dd(d_h, d_l);
        var s_h: f64 = sh;
        var s_l: f64 = sl;
        var y, ok = _bj_k_dd_div_cr(c, 0.0, s_h, s_l);
        if (ok == 0) { return 0 - 1; }
        out[0] = y;
        return 1;
    }
    var c2h, c2l = _bj_cr_two_prod(c, c);
    var ch: f64 = c2h;
    var cl: f64 = c2l;
    var y2, ok2 = _bj_k_dd_div_cr(ch, cl, d_h, d_l);
    if (ok2 == 0) { return 0 - 1; }
    out[0] = y2;
    return 1;
}

# The fast path for one nonzero component a = |v| (< c): D = (c − a)(c + a) from two exact TwoSums and one double-double
# product (within 8.01·2^-106 relative, the product's bound in src/crmath_kx.cyr's _bj_k_dd_mul), then as _bj_g_fast.
# 1 with the result in out[0], or −1 when the rounding test fails.
fn _bj_g_fast1(a: f64, c: f64, mode, out: *f64): i64 {
    var s1: f64 = c - a;                            # c − a = s1 + e1 and c + a = s2 + e2, TwoSum
    var b1: f64 = s1 - c;
    var na: f64 = -a;
    var e1: f64 = (c - (s1 - b1)) + (na - b1);
    var s2: f64 = c + a;
    var b2: f64 = s2 - c;
    var e2: f64 = (c - (s2 - b2)) + (a - b2);
    var sp: f64 = 134217729.0;                      # (s1 + e1)(s2 + e2), the double-double product, TwoProduct inline
    var p: f64 = s1 * s2;
    var cs1: f64 = sp * s1;
    var h1: f64 = cs1 - (cs1 - s1);
    var l1: f64 = s1 - h1;
    var cs2: f64 = sp * s2;
    var h2: f64 = cs2 - (cs2 - s2);
    var l2: f64 = s2 - h2;
    var pe: f64 = (l1 * l2) - (((p - (h1 * h2)) - (l1 * h2)) - (h1 * l2));
    var cross: f64 = (s1 * e2) + (e1 * s2);
    var pe1: f64 = pe + cross;
    var d_h: f64 = p + pe1;
    var d_l: f64 = pe1 - (d_h - p);
    if (mode == 0) {
        var sh, sl = _bj_g_sqrt_dd(d_h, d_l);
        var s_h: f64 = sh;
        var s_l: f64 = sl;
        var y, ok = _bj_k_dd_div_cr(c, 0.0, s_h, s_l);
        if (ok == 0) { return 0 - 1; }
        out[0] = y;
        return 1;
    }
    var c2h, c2l = _bj_cr_two_prod(c, c);
    var ch: f64 = c2h;
    var cl: f64 = c2l;
    var y2, ok2 = _bj_k_dd_div_cr(ch, cl, d_h, d_l);
    if (ok2 == 0) { return 0 - 1; }
    out[0] = y2;
    return 1;
}

# me[0], me[1] := (mm, f) with (a + b)/2 = mm·2^f, for positive normal doubles a < b, adjacent.
fn _bj_g_mid(a: f64, b: f64, me) {
    var ab[16];
    _bj_g_split(a, &ab);
    var ma = load64(&ab);
    var ea = load64(&ab + 8);
    _bj_g_split(b, &ab);
    var mb = load64(&ab);
    var eb = load64(&ab + 8);
    var e0 = ea;
    if (eb < e0) { e0 = eb; }
    var mm = (ma << (ea - e0)) + (mb << (eb - e0));
    store64(me, mm);
    store64(me + 8, e0 - 1);
    return 0;
}

# The sign of value − μ in the normalised domain, μ = mm·2^f: value = c/√D_n (mode 0, against c² vs μ²·D_n) or
# c²/D_n (mode 1, c² vs μ·D_n), D_n = D_u·2^(kmin − 2j), c² = mc²·2^(2ec). a, b, t: scratch bignums.
#must_use
fn _bj_g_cmp_mid(du, mc, ec, kmin, j, mode, mm, f, a, b, t): i64 {
    _bj_bn_copy(b, du);
    _bj_g_mul(b, mm, t);
    var s = f + kmin - 2 * j - 2 * ec;
    if (mode == 0) {
        _bj_g_mul(b, mm, t);
        s = s + f;
    }
    _bj_bn_set(a, mc);
    _bj_g_mul(a, mc, t);
    if (s >= 0) { _bj_bn_shl(b, s); } else { _bj_bn_shl(a, 0 - s); }
    var r = _bj_bn_cmp(a, b);
    return r;
}

# The double next to the positive normal y: up (dir 1) or down (dir −1).
#must_use
fn _bj_g_step(y: f64, dir): f64 {
    var b = _bj_bits(y) + dir;
    var r: f64 = _bj_from_bits(b);
    return r;
}

# Of two adjacent doubles, the one with an even significand (ties to even).
#must_use
fn _bj_g_even(a: f64, b: f64): f64 {
    if ((_bj_bits(a) & 1) == 0) { return a; }
    return b;
}

# The slow path: 1 with the result in out[0], or 0 when D ≤ 0. Exact, each part's exponent with its offset (vo).
fn _bj_g_slow(v: *f64, vo, n, c: f64, mode, out: *f64): i64 {
    var me[16];
    _bj_g_split(c, &me);
    var mc = load64(&me);
    var ec = load64(&me + 8);
    var kmin = 2 * ec;
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = v[i];
        if (x == 0.0) { continue; }
        _bj_g_split(x, &me);
        var e2 = 2 * (load64(&me + 8) + _bj_g_off(vo, i));
        if (e2 < kmin) { kmin = e2; }
    }
    var cu[656];
    var su[656];
    var w[656];
    var t[656];
    var a[656];
    _bj_bn_set(&cu, mc);
    _bj_g_mul(&cu, mc, &t);
    _bj_bn_shl(&cu, 2 * ec - kmin);
    store64(&su, 0);
    for (var i2 = 0; i2 < n; i2 = i2 + 1) {
        var x2: f64 = v[i2];
        if (x2 == 0.0) { continue; }
        _bj_g_split(x2, &me);
        var m2 = load64(&me);
        var e22 = load64(&me + 8) + _bj_g_off(vo, i2);
        _bj_bn_set(&w, m2);
        _bj_g_mul(&w, m2, &t);
        _bj_bn_shl(&w, 2 * e22 - kmin);
        _bj_g_add_to(&su, &w);
    }
    if (_bj_bn_cmp(&cu, &su) <= 0) { return 0; }
    _bj_bn_sub(&cu, &su);
    # D = D_u·2^kmin, D_u in cu: its top 104 bits, normalised to D_n in [1, 4).
    var len = _bj_g_bitlen(&cu);
    var sh = len - 104;
    if (sh < 0) { sh = 0; }
    _bj_bn_copy(&w, &cu);
    _bj_bn_shr(&w, sh);
    var l0 = _bj_g_limb(&w, 0);
    var l1 = _bj_g_limb(&w, 1);
    var l2 = _bj_g_limb(&w, 2);
    var l3 = _bj_g_limb(&w, 3);
    var xlo = l0 + ((l1 & 0xFFFFF) << 32);
    var xhi = (l1 >> 20) + (l2 << 12) + (l3 << 44);
    var j = _bj_g_half_floor(len - 1 + kmin);
    var sc = sh + kmin - 2 * j;
    var fh: f64 = f64_from(xhi);
    var fl: f64 = f64_from(xlo);
    var p52: f64 = _bj_g_pow2(52 + sc);
    var p0: f64 = _bj_g_pow2(sc);
    var hh: f64 = fh * p52;
    var ll: f64 = fl * p0;
    var dnh, dnl = _bj_cr_fast_two_sum(hh, ll);
    var d_h: f64 = dnh;
    var d_l: f64 = dnl;
    # The candidate: z₁ of the double-double quotient's two ends (_bj_k_dd_div_ends, the rounding test's steps without
    # its verdict, which would give 0 exactly when this path is needed): the value lies within 2^-98 of points that
    # round to z₁ and z₂, so RN(value) is z₁ or the double above it, and the loop below moves it.
    var y: f64 = 0.0;
    if (mode == 0) {
        var s_h, s_l = _bj_g_sqrt_dd(d_h, d_l);
        var q1h: f64 = s_h;
        var q1l: f64 = s_l;
        var y1, z1 = _bj_k_dd_div_ends(c, 0.0, q1h, q1l);
        y = y1;
    } else {
        var c2h, c2l = _bj_cr_two_prod(c, c);
        var ch: f64 = c2h;
        var cl: f64 = c2l;
        var y2, z2 = _bj_k_dd_div_ends(ch, cl, d_h, d_l);
        y = y2;
    }
    var mm[16];
    for (var it = 0; it < 4; it = it + 1) {
        var up: f64 = _bj_g_step(y, 1);
        _bj_g_mid(y, up, &mm);
        var c1 = _bj_g_cmp_mid(&cu, mc, ec, kmin, j, mode, load64(&mm), load64(&mm + 8), &a, &w, &t);
        if (c1 > 0) {
            y = up;
            continue;
        }
        if (c1 == 0) {
            y = _bj_g_even(y, up);
            break;
        }
        var dn: f64 = _bj_g_step(y, 0 - 1);
        _bj_g_mid(dn, y, &mm);
        var c2 = _bj_g_cmp_mid(&cu, mc, ec, kmin, j, mode, load64(&mm), load64(&mm + 8), &a, &w, &t);
        if (c2 < 0) {
            y = dn;
            continue;
        }
        if (c2 == 0) { y = _bj_g_even(dn, y); }
        break;
    }
    var k = 0 - j;
    if (mode == 1) { k = 0 - 2 * j; }
    var r: f64 = _bj_g_scale(y, k);
    out[0] = r;
    return 1;
}

# 1 when c lies in [2^-30, 2^30], the range the fast paths' error bounds and the slow path's buffers allow (c² ≤ 2^60,
# so D_u ≤ 2^2208), else 0 (NaN included).
#must_use
fn _bj_g_c_ok(c: f64): i64 {
    var lo: f64 = 0.000000000931322574615478515625;
    var hi: f64 = 1073741824.0;
    if (c >= lo) {
        if (c <= hi) { return 1; }
    }
    return 0;
}

# 1 when every vᵢ is a number and c² − Σvᵢ² > 0 exactly (|v| < c), else 0: the validity test of _bj_cr_lorentz alone,
# for a Liénard–Wiechert potential's β (c = 1). c as _bj_cr_lorentz's.
#must_use
fn _bj_cr_lorentz_ok(v: *f64, n, c: f64): i64 {
    if (_bj_g_c_ok(c) == 0) { return 0; }
    var cut: f64 = c * 0.0000000037252902984619140625;
    var small = 1;
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = v[i];
        if (x != x) { return 0; }
        var ax: f64 = f64_abs(x);
        if (ax >= c) { return 0; }
        if (ax >= cut) { small = 0; }
    }
    if (small == 1) { return 1; }
    var nz = 0;
    for (var i2 = 0; i2 < n; i2 = i2 + 1) {
        var x2: f64 = v[i2];
        if (x2 != 0.0) { nz = nz + 1; }
    }
    if (nz <= 1) { return 1; }                      # one component: |v| < c, tested exactly above
    var ex: f64[8];
    var tw[8];
    var k = _bj_g_expansion(v, 0, n, c, &ex, &tw);
    if (k == 0) { return 0; }
    var top: f64 = ex[k - 1];
    if (top < 0.0) { return 0; }
    if (load64(&tw) == 0) { return 1; }
    var floor_d: f64 = _bj_g_pow2(0 - 790);
    if (top >= floor_d) { return 1; }
    var o: f64[1];
    var s = _bj_g_slow(v, 0, n, c, 1, &o);
    return s;
}

# _bj_cr_lorentz's offset form (M2 part 2d-3i), c in range: an offset part is tiny, below c and every cut, so the
# validity and γ = 1 tests skip it, the fast path's expansion leaves it out (it marks the expansion inexact) and the
# slow path takes it exactly.
fn _bj_g_offset(v: *f64, vo, n, c: f64, mode, slow, out: *f64): i64 {
    var cut: f64 = c * 0.0000000037252902984619140625;
    var small = 1;
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = v[i];
        if (x != x) { return 0; }
        if (load64(vo + 8 * i) != 0) { continue; }
        var ax: f64 = f64_abs(x);
        if (ax >= c) { return 0; }
        if (ax >= cut) { small = 0; }
    }
    if (small == 1) {
        out[0] = 1.0;
        return 1;
    }
    if (slow == 0) {
        var f = _bj_g_fast(v, vo, n, c, mode, out);
        if (f >= 0) { return f; }
    }
    var s = _bj_g_slow(v, vo, n, c, mode, out);
    return s;
}

# The correctly rounded γ = c/√(c² − Σvᵢ²) (mode 0) or γ² = c²/(c² − Σvᵢ²) (mode 1) of the n components at v (1 ≤ n ≤ 3)
# into out[0]: 1, or 0 when some vᵢ is NaN or c² − Σvᵢ² ≤ 0 exactly (|v| ≥ c), out untouched. c lies in [2^-30, 2^30]
# (bijli passes the speed of light, or 1 for a β; any other c gives 0). |vᵢ| < 2^-28·c for every i gives exactly 1.
# `slow` 1 skips the fast path (for cr_verify.py). vo is 0, or the offset form's n exponents (M2 part 2d-3i, for
# lienard_wiechert_fields' β = v/c on the 53-bit grid): vᵢ = v[i]·2^vo[i], an offset part's double normal and its
# value in [2^-1110, 2^-1022). Such a part is below every cut, so only the slow path sees it: there 2E ≥ −2324 widens
# K by 176 bits, D_u ≤ 2^2384 and the midpoint products below 2^2496, inside the 81 limbs (2,592 bits).
fn _bj_cr_lorentz(v: *f64, vo, n, c: f64, mode, slow, out: *f64): i64 {
    if (_bj_g_c_ok(c) == 0) { return 0; }
    if (vo != 0) {
        var r = _bj_g_offset(v, vo, n, c, mode, slow, out);
        return r;
    }
    var cut: f64 = c * 0.0000000037252902984619140625;
    var small = 1;
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = v[i];
        if (x != x) { return 0; }
        var ax: f64 = f64_abs(x);
        if (ax >= c) { return 0; }
        if (ax >= cut) { small = 0; }
    }
    if (small == 1) {
        out[0] = 1.0;
        return 1;
    }
    if (slow == 0) {
        var nz = 0;
        var one: f64 = 0.0;
        for (var i2 = 0; i2 < n; i2 = i2 + 1) {
            var x2: f64 = v[i2];
            if (x2 != 0.0) {
                nz = nz + 1;
                one = f64_abs(x2);
            }
        }
        var f = 0 - 1;
        if (nz == 1) { f = _bj_g_fast1(one, c, mode, out); } else { f = _bj_g_fast(v, 0, n, c, mode, out); }
        if (f >= 0) { return f; }
    }
    var s = _bj_g_slow(v, 0, n, c, mode, out);
    return s;
}

# --- crmath_edge.cyr ---

# crmath_edge.cyr — bijli's values at their own pole or zero (M2 part 2c, ADR 0002 row 17, the user's answer of
# 2026-11-12: exact tests, accurate values). A test that decides where its value has a pole or a zero is made on the
# exact quantity, and the value beside it comes from exact differences, correctly rounded, so the two agree: an input
# the exact test accepts never gets a value of ∞, 0 or NaN from a cancellation, and one it refuses carries the exact
# value's sign. Clausius–Mossotti's ε_r (M2 part 2c-2), the trig-free Fresnel cosine (2c-3), the Liénard–Wiechert
# R_eff and κ (2c-4) and n̂ − β (2d-1), and the parallel combinations (2c-5) are here.
#
# Clausius–Mossotti (M2 part 2c-2). ε_r = (1 + 2X)/(1 − X) with X = Nα/(3ε₀) is (3ε₀ + 2P)/(3ε₀ − P), P = Nα exactly
# and ε₀ its double. X ≥ 1 is 3ε₀ − P ≤ 0, and below it ε_r ≤ 0 is 3ε₀ + 2P ≤ 0. The value ε_r is rounded once (to
# nearest, ties to even). The parts: 3ε₀ = t_h + t_l (FastTwoSum(2ε₀, ε₀)) and P = b_h + b_l (TwoProduct) exactly, so
# num = t_h + t_l + 2b_h + 2b_l and den = t_h + t_l − b_h − b_l, four doubles each.
#
# The rough X. χ = RN(RN(Nα)/RN(3ε₀)) is within 3.02u of X (u = 2^-53) when Nα doesn't under- or overflow. |χ| < 2^-60
# (Nα underflowing included) puts |ε_r − 1| = 3|X|/(1 − X) below 2^-57, inside 1's rounding interval: ε_r rounds to
# 1. |χ| ≥ 2^136 (Nα overflowing included) puts |X| above 2^135: X ≥ 1 for α > 0, and for α < 0 ε_r = −2 + 3/(1 − X)
# lies within 2^-133 above −2, so it rounds to −2. Between, |P| lies in [2^-95.4, 2^101.6], so its exponent sum is in
# [−97, 101], b_h in [2^-97, 2^103], and b_l a multiple of 2^-201: no part under- or overflows, and every step is
# exact. With both exponents in [−500, 500], TwoProduct runs on α and N themselves (inline; Veltkamp's split doesn't
# overflow, and every partial product's least bit is at least lsb(α)·lsb(N) = 2^(e_N + e_α − 104) ≥ 2^-201, so each
# is exact); otherwise on α and N scaled to [1, 2), its parts then scaled by 2^(e_N + e_α). Both give the same
# b_h = RN(P) and b_l.
#
# Fast region, χ ∈ [−0.24, 0.49] (X ∈ [−¼, ½], no cancellation): (s, e) = TwoSum(t_h, 2b_h) exactly, then
# RN(RN(e + t_l) + 2b_l), then FastTwoSum: within 5.02u²·(|t_h| + 2|b_h|), relative 5.02u²·(1 + 2|X|)/(1 + 2X)
# ≤ 15.06u²; likewise den within 5.02u²·(1 + |X|)/(1 − X) ≤ 15.06u², and the two together never above 20.1u² (at
# X = −¼ or ½).
# Elsewhere num and den are Shewchuk expansions of their four parts (src/crmath_gamma.cyr's _bj_g_grow, exact): the
# largest component's sign is the sum's, which decides X ≥ 1 and ε_r ≤ 0 exactly, and Compress gives each within
# 2^-104. kimiya's rounding test (_bj_k_dd_div_cr, src/crmath_kx.cyr: inputs within 32u² together) then rounds
# |num|/den.
#
# The range. A nonzero num is a multiple of 2^min(−89, e − 103) and den of 2^min(−89, e − 104), e the exponent sum, and
# they cancel only when |P| is near 1.5ε₀ or 3ε₀ (e in [−38, −35]), so a nonzero |ε_r| lies in [2^-109, 2^110].
#
# The exact check, when the test fails (a value within about 2^-99 of a midpoint, relative; or always, for slow = 1):
# the candidate y = z₁ of _bj_k_dd_div_ends lies within an ulp of RN(v), v = |num|/den, so the signs of v − μ at the
# midpoints μ = y ± ulp/2 decide it, ties to even. With den > 0, v − μ has the sign of |num| − y·den − h·den
# (h = ±ulp/2, a power of two): sixteen doubles (num's four; y·dᵢ by TwoProduct, eight; h·dᵢ exactly, four), summed
# exactly by kimiya's _bj_k_exp_sign. Their least bit is 2^-362 or above (y ≥ 2^-109, dᵢ a multiple of 2^-201), and
# their sum below 2^215: no product under- or overflows. cr_verify.py's cm and cm_slow families check every path
# against Python's Fraction, on x86_64 and aarch64.

# (s, e) with x = s·2^e and 1 ≤ |s| < 2, s keeping x's sign, exactly, for a finite nonzero x (a subnormal is scaled by
# 2^54 first).
#must_use
fn _bj_e_frexp(x: f64): (f64, i64) {
    var b = _bj_bits(x);
    var ex = (b >> 52) & 0x7FF;
    var adj = 0;
    if (ex == 0) {
        var k54: f64 = 0x4350000000000000;          # 2^54
        var y: f64 = x * k54;
        b = _bj_bits(y);
        ex = (b >> 52) & 0x7FF;
        adj = 54;
    }
    var sg = b - (b & 0x7FFFFFFFFFFFFFFF);
    var s: f64 = _bj_from_bits(sg | (b & 0xFFFFFFFFFFFFF) | 0x3FF0000000000000);
    var e = ex - 1023 - adj;
    return (s, e);
}

# The sign (−1, 0 or 1) of g·num − (y + h)·den, exactly, for the parts c = (t_h, t_l, b_h, b_l) (num = t_h + t_l + 2b_h
# + 2b_l, den = t_h + t_l − b_h − b_l), g = ±1, y ≥ 2^-110 and h ±(a power of two) (the header's exact check).
#must_use
fn _bj_e_side(c: *f64, g: f64, y: f64, h: f64): i64 {
    var t: f64[16];
    var th: f64 = c[0];
    var tl: f64 = c[1];
    var bh: f64 = c[2];
    var bl: f64 = c[3];
    t[0] = g * th;
    t[1] = g * tl;
    var bh2: f64 = bh * 2.0;
    var bl2: f64 = bl * 2.0;
    t[2] = g * bh2;
    t[3] = g * bl2;
    var d: f64[4];
    d[0] = th;
    d[1] = tl;
    d[2] = -bh;
    d[3] = -bl;
    for (var i = 0; i < 4; i = i + 1) {
        var di: f64 = d[i];
        var p, e = _bj_k_two_prod(y, di);
        var pp: f64 = p;
        var pe: f64 = e;
        t[4 + 2 * i] = -pp;
        t[5 + 2 * i] = -pe;
        var hd: f64 = h * di;
        t[12 + i] = -hd;
    }
    return _bj_k_exp_sign(&t, 16);
}

# RN(v) for v = g·num/den > 0, from a candidate y within an ulp of it (the header's exact check).
#must_use
fn _bj_e_settle(c: *f64, g: f64, y: f64): f64 {
    var up: f64 = _bj_g_step(y, 1);
    var hu: f64 = (up - y) * 0.5;
    var su = _bj_e_side(c, g, y, hu);
    if (su > 0) { return up; }
    if (su == 0) {
        var eu: f64 = _bj_g_even(y, up);
        return eu;
    }
    var dn: f64 = _bj_g_step(y, 0 - 1);
    var hd: f64 = (dn - y) * 0.5;
    var sd = _bj_e_side(c, g, y, hd);
    if (sd < 0) { return dn; }
    if (sd == 0) {
        var ed: f64 = _bj_g_even(dn, y);
        return ed;
    }
    return y;
}

# Clausius–Mossotti (the header): 1 when X = Nα/(3ε₀) ≥ 1 exactly; otherwise 0, with out[0] := RN(ε_r) for
# ε_r = (3ε₀ + 2Nα)/(3ε₀ − Nα), which is ≤ 0 exactly when ε_r is. For finite α and N ≥ 0. slow = 1 skips the rounding
# test, so the exact check always runs (cr_verify.py's cm_slow).
#must_use
fn _bj_cr_clausius(alpha: f64, n: f64, slow, out: *f64): i64 {
    var na: f64 = n * alpha;
    var three: f64 = 3.0 * BJ_EPSILON_0;
    var chi: f64 = na / three;
    var ac: f64 = f64_abs(chi);
    var lo60: f64 = 0x3C30000000000000;             # 2^-60
    if (ac < lo60) {
        out[0] = 1.0;
        return 0;
    }
    var hi136: f64 = 0x4870000000000000;            # 2^136
    if (ac >= hi136) {
        if (chi > 0.0) { return 1; }
        out[0] = -2.0;
        return 0;
    }
    var t_h: f64 = three;
    var two: f64 = 2.0 * BJ_EPSILON_0;
    var t_l: f64 = BJ_EPSILON_0 - (three - two);   # FastTwoSum(2ε₀, ε₀)'s error: 3ε₀ = t_h + t_l
    var bh: f64 = na;
    var bl: f64 = 0.0;
    var xn = (_bj_bits(n) >> 52) - 1023;            # n > 0 here
    var xa = ((_bj_bits(alpha) >> 52) & 0x7FF) - 1023;
    if (xn >= 0 - 500 && xn <= 500 && xa >= 0 - 500 && xa <= 500) {
        var sp: f64 = 134217729.0;                  # n·α = b_h + b_l: TwoProduct, inline (Veltkamp's 2^27 + 1 split)
        var cn: f64 = sp * n;
        var nhh: f64 = cn - (cn - n);
        var nhl: f64 = n - nhh;
        var ca: f64 = sp * alpha;
        var ahh: f64 = ca - (ca - alpha);
        var ahl: f64 = alpha - ahh;
        bl = (nhl * ahl) - (((na - (nhh * ahh)) - (nhl * ahh)) - (nhh * ahl));
    } else {
        var sn, en = _bj_e_frexp(n);
        var sa, ea = _bj_e_frexp(alpha);
        var fn1: f64 = sn;
        var fa1: f64 = sa;
        var ph, pl = _bj_k_two_prod(fn1, fa1);
        var k: f64 = _bj_g_pow2(en + ea);
        var p_h: f64 = ph;
        var p_l: f64 = pl;
        bh = p_h * k;
        bl = p_l * k;
    }
    var c: f64[4];
    c[0] = t_h;
    c[1] = t_l;
    c[2] = bh;
    c[3] = bl;
    var nh: f64 = 0.0;
    var nl: f64 = 0.0;
    var dh: f64 = 0.0;
    var dl: f64 = 0.0;
    var g: f64 = 1.0;
    if (chi >= -0.24 && chi <= 0.49) {
        var bh2: f64 = bh * 2.0;
        var bl2: f64 = bl * 2.0;
        var s1: f64 = t_h + bh2;                    # num: TwoSum(t_h, 2b_h), inline
        var v1: f64 = s1 - t_h;
        var e1: f64 = (t_h - (s1 - v1)) + (bh2 - v1);
        var r1: f64 = (e1 + t_l) + bl2;
        nh = s1 + r1;                               # FastTwoSum(s1, r1)
        nl = r1 - (nh - s1);
        var mbh: f64 = -bh;
        var s2: f64 = t_h + mbh;                    # den: TwoSum(t_h, −b_h), inline
        var v2: f64 = s2 - t_h;
        var e2: f64 = (t_h - (s2 - v2)) + (mbh - v2);
        var r2: f64 = (e2 + t_l) - bl;
        dh = s2 + r2;                               # FastTwoSum(s2, r2)
        dl = r2 - (dh - s2);
    } else {
        var de: f64[4];
        var kd = 0;
        var mbl: f64 = -bl;
        var mbh2: f64 = -bh;
        kd = _bj_g_grow(&de, kd, t_l);
        kd = _bj_g_grow(&de, kd, t_h);
        kd = _bj_g_grow(&de, kd, mbl);
        kd = _bj_g_grow(&de, kd, mbh2);
        if (kd == 0) { return 1; }
        var dtop: f64 = de[kd - 1];
        if (dtop < 0.0) { return 1; }
        var ne: f64[4];
        var kn = 0;
        var nbl: f64 = bl * 2.0;
        var nbh: f64 = bh * 2.0;
        kn = _bj_g_grow(&ne, kn, t_l);
        kn = _bj_g_grow(&ne, kn, t_h);
        kn = _bj_g_grow(&ne, kn, nbl);
        kn = _bj_g_grow(&ne, kn, nbh);
        if (kn == 0) {
            out[0] = 0.0;
            return 0;
        }
        var ntop: f64 = ne[kn - 1];
        if (ntop < 0.0) { g = -1.0; }
        var ch, cl = _bj_g_compress(&ne, kn);
        var c_h: f64 = ch;
        var c_l: f64 = cl;
        nh = g * c_h;
        nl = g * c_l;
        var gh, gl = _bj_g_compress(&de, kd);
        dh = gh;
        dl = gl;
    }
    if (slow == 0) {
        var q, ok = _bj_k_dd_div_cr(nh, nl, dh, dl);
        if (ok == 1) {
            var qq: f64 = q;
            var r: f64 = g * qq;
            out[0] = r;
            return 0;
        }
    }
    var z1, z2 = _bj_k_dd_div_ends(nh, nl, dh, dl);
    var zz: f64 = z1;
    var y: f64 = _bj_e_settle(&c, g, zz);
    var ry: f64 = g * y;
    out[0] = ry;
    return 0;
}

# ── the trig-free Fresnel cosine (M2 part 2c-3) ──────────────────────────────────────────────────────────────────────
#
# cos θ_t = √(1 − (n₁/n₂)²(1 − c²)) for c = cos θ_i in [0, 1] is √D/b with D = b² − a²(1 − c²) = b² − a² + (ac)²,
# where a = n₁·2^-k and b = n₂·2^-k ∈ [1, 2) (k n₂'s exponent: the scaling is exact and changes nothing). Total
# internal reflection, sin²θ_t > 1, is D < 0 exactly, and cos θ_t is √D/b rounded once.
#
# Shortcuts. n₁ = n₂ gives D = (ac)², so cos θ_t = |c| exactly (+0 for c = −0); c = 1 gives cos θ_t = 1. Otherwise
# c < 1, so 1 − c² ≥ 2^-52: a ratio n₁/n₂ above 2^27 (exponent difference d ≥ 28) is TIR, and one below 2^-61
# (d ≤ −62) leaves cos θ_t within 2^-122 of 1, which rounds to 1. Between, a lies in (2^-62, 2^29), and every square
# below is exact.
#
# A c below 2^-300 is taken as 0 in D. With c = 0, D = b² − a² is a nonzero multiple of 2^-228 (a ≠ b), and D − μ²b² is
# never 0 at a dyadic μ: μb = p and a² + p² = b² would make a Pythagorean triple whose hypotenuse b·2^j has an odd part
# dividing p's, so the odd part is 1 and a or p is 0. So D − μ²b² is a nonzero multiple of 2^-442 at every midpoint μ
# (μ ≥ 2^-115 there), far above (ac)² < 2^-542: dropping c moves neither the sign of D nor any midpoint comparison.
#
# The range. A nonzero D lies in [2^-620, 4]: if (ac)² < 2^-229, |D| ≥ |b² − a²| − (ac)² ≥ 2^-229; otherwise
# c ≥ 2^-143.5, and every part of D is a multiple of 2^-620. So cos θ_t ≥ 2^-311.
#
# Fast region, M = a²(1 − c²) ≤ b²/2 (sin²θ_t ≤ ½): 1 − c² = s_h + s_l from TwoProduct(c, c) and FastTwoSum(1, −c²)
# (exact for c² ≥ ½, within 1.5u² relative below), M by kimiya's _bj_k_dd_mul (8.01u²), D = b² − M by TwoSum within
# 9.05u², so 18.6u² with M's error carried (D ≥ M); √D by src/crmath_gamma.cyr's _bj_g_sqrt_dd (half of that, plus
# 6.06u²): 15.4u², inside _bj_k_dd_div_cr's 32u². Near the critical angle (M > b²/2) D is the Shewchuk expansion of
# its ten parts (b², −a², (ac)² = t_h² + 2t_h·t_l + t_l², TwoProducts), whose top component's sign decides TIR,
# compressed to within 2^-104 (with the root's 6.06u²: 8.06u²). The exact check, when a rounding test fails (or always,
# for slow = 1): at the candidate y's two neighbouring midpoints μ = y ± h, D − (μb)² is exactly the sum of D's ten
# parts and the twelve of −(g₁ + g₂ + w)² (y·b = g₁ + g₂ by TwoProduct, w = h·b exactly: three squares and three
# doubled products), whose least bits are at or above 2^-834 (y ≥ 2^-311), ties to even. cr_verify.py's cos_t and
# cos_t_slow families check it against Python's Fraction and an integer square root, on x86_64 and aarch64.

# D's parts into t (b², −a², and (ac)²'s six when c ≠ 0, each by TwoProduct); returns their count.
#must_use
fn _bj_e_dparts(a: f64, b: f64, c: f64, t: *f64): i64 {
    var bh, bl = _bj_k_two_prod(b, b);
    var ah, al = _bj_k_two_prod(a, a);
    var b_h: f64 = bh;
    var b_l: f64 = bl;
    var a_h: f64 = ah;
    var a_l: f64 = al;
    t[0] = b_h;
    t[1] = b_l;
    t[2] = -a_h;
    t[3] = -a_l;
    if (c == 0.0) { return 4; }
    var th, tl = _bj_k_two_prod(a, c);
    var t_h: f64 = th;
    var t_l: f64 = tl;
    var p1, e1 = _bj_k_two_prod(t_h, t_h);
    var p2, e2 = _bj_k_two_prod(t_h, t_l);
    var p3, e3 = _bj_k_two_prod(t_l, t_l);
    var q1: f64 = p1;
    var r1: f64 = e1;
    var q2: f64 = p2;
    var r2: f64 = e2;
    var q3: f64 = p3;
    var r3: f64 = e3;
    t[4] = q1;
    t[5] = r1;
    t[6] = q2 * 2.0;
    t[7] = r2 * 2.0;
    t[8] = q3;
    t[9] = r3;
    return 10;
}

# The sign (−1, 0 or 1) of the exact sum of the n ≤ 24 doubles at t (Shewchuk's Grow-Expansion: the top component's).
#must_use
fn _bj_e_sum_sign(t: *f64, n): i64 {
    var ex: f64[24];
    var k = 0;
    for (var i = 0; i < n; i = i + 1) {
        var ti: f64 = t[i];
        k = _bj_g_grow(&ex, k, ti);
    }
    if (k == 0) { return 0; }
    var top: f64 = ex[k - 1];
    if (top > 0.0) { return 1; }
    return 0 - 1;
}

# The sign of D − ((y + h)·b)², exactly (the section comment's exact check).
#must_use
fn _bj_e_cos_side(a: f64, b: f64, c: f64, y: f64, h: f64): i64 {
    var t: f64[24];
    var n = _bj_e_dparts(a, b, c, &t);
    var g1, g2 = _bj_k_two_prod(y, b);
    var x: f64[3];
    var gg1: f64 = g1;
    var gg2: f64 = g2;
    x[0] = gg1;
    x[1] = gg2;
    x[2] = h * b;
    for (var i = 0; i < 3; i = i + 1) {
        for (var j = i; j < 3; j = j + 1) {
            var xi: f64 = x[i];
            var xj: f64 = x[j];
            var p, e = _bj_k_two_prod(xi, xj);
            var pp: f64 = p;
            var pe: f64 = e;
            if (j != i) {
                pp = pp * 2.0;
                pe = pe * 2.0;
            }
            t[n] = -pp;
            t[n + 1] = -pe;
            n = n + 2;
        }
    }
    return _bj_e_sum_sign(&t, n);
}

# RN(√D/b) from a candidate y within an ulp of it (the section comment's exact check).
#must_use
fn _bj_e_cos_settle(a: f64, b: f64, c: f64, y: f64): f64 {
    var up: f64 = _bj_g_step(y, 1);
    var hu: f64 = (up - y) * 0.5;
    var su = _bj_e_cos_side(a, b, c, y, hu);
    if (su > 0) { return up; }
    if (su == 0) {
        var eu: f64 = _bj_g_even(y, up);
        return eu;
    }
    var dn: f64 = _bj_g_step(y, 0 - 1);
    var hd: f64 = (dn - y) * 0.5;
    var sd = _bj_e_cos_side(a, b, c, y, hd);
    if (sd < 0) { return dn; }
    if (sd == 0) {
        var ed: f64 = _bj_g_even(dn, y);
        return ed;
    }
    return y;
}

# The trig-free Fresnel cosine (the section comment): 1 under total internal reflection (n₁²(1 − c²) > n₂² exactly);
# otherwise 0, with out[0] := RN(cos θ_t), cos θ_t = √(n₂² − n₁²(1 − c²))/n₂. For positive finite n₁, n₂ and c in
# [0, 1]. slow = 1 skips the rounding tests, so the exact check always runs (cr_verify.py's cos_t_slow).
#must_use
fn _bj_cr_cos_t(n1: f64, n2: f64, c: f64, slow, out: *f64): i64 {
    if (n1 == n2) {
        var ac: f64 = f64_abs(c);
        out[0] = ac;
        return 0;
    }
    if (c == 1.0) {
        out[0] = 1.0;
        return 0;
    }
    var w1 = _bj_bits(n1);
    var w2 = _bj_bits(n2);
    var f1 = w1 >> 52;
    var f2 = w2 >> 52;
    var a: f64 = 0.0;
    var b: f64 = 0.0;
    var d = 0;
    if (f1 != 0 && f2 != 0) {
        d = f1 - f2;
        if (d >= 28) { return 1; }
        if (d <= 0 - 62) {
            out[0] = 1.0;
            return 0;
        }
        b = _bj_from_bits((w2 & 0xFFFFFFFFFFFFF) | 0x3FF0000000000000);
        a = _bj_from_bits(w1 - ((f2 - 1023) << 52));
    } else {
        var s1, x1 = _bj_e_frexp(n1);
        var s2, x2 = _bj_e_frexp(n2);
        d = x1 - x2;
        if (d >= 28) { return 1; }
        if (d <= 0 - 62) {
            out[0] = 1.0;
            return 0;
        }
        var ss1: f64 = s1;
        var ss2: f64 = s2;
        b = ss2;
        a = _bj_from_bits(_bj_bits(ss1) + (d << 52));
    }
    var cc: f64 = c;
    var lo300: f64 = 0x2D30000000000000;            # 2^-300
    if (cc < lo300) { cc = 0.0; }
    var sp: f64 = 134217729.0;                      # TwoProducts inline (Veltkamp's 2^27 + 1 split)
    var p: f64 = cc * cc;
    var kc: f64 = sp * cc;
    var ch: f64 = kc - (kc - cc);
    var cl: f64 = cc - ch;
    var pe: f64 = (cl * cl) - (((p - (ch * ch)) - (cl * ch)) - (ch * cl));
    var s1f: f64 = 1.0 - p;                         # 1 − c² = s_h + s_l: FastTwoSum(1, −p), then −pe
    var zf: f64 = s1f - 1.0;
    var mp: f64 = -p;
    var er: f64 = mp - zf;
    var sr: f64 = er - pe;
    var s_h: f64 = s1f + sr;
    var s_l: f64 = sr - (s_h - s1f);
    var a2: f64 = a * a;
    var ka: f64 = sp * a;
    var ahh: f64 = ka - (ka - a);
    var ahl: f64 = a - ahh;
    var a2e: f64 = (ahl * ahl) - (((a2 - (ahh * ahh)) - (ahl * ahh)) - (ahh * ahl));
    var b2: f64 = b * b;
    var kb: f64 = sp * b;
    var bhh: f64 = kb - (kb - b);
    var bhl: f64 = b - bhh;
    var b2e: f64 = (bhl * bhl) - (((b2 - (bhh * bhh)) - (bhl * bhh)) - (bhh * bhl));
    var mh, ml = _bj_k_dd_mul(a2, a2e, s_h, s_l);
    var m_h: f64 = mh;
    var m_l: f64 = ml;
    var half: f64 = 0.5 * b2;
    var rh: f64 = 0.0;
    var rl: f64 = 0.0;
    if (m_h <= half) {
        var mmh: f64 = -m_h;
        var t0: f64 = b2 + mmh;                     # D = b² − M: TwoSum(b², −M_h), inline
        var v0: f64 = t0 - b2;
        var t1: f64 = (b2 - (t0 - v0)) + (mmh - v0);
        var w0: f64 = (t1 + b2e) - m_l;
        var dh: f64 = t0 + w0;                      # FastTwoSum(t0, w0)
        var dl: f64 = w0 - (dh - t0);
        var qh, ql = _bj_g_sqrt_dd(dh, dl);
        rh = qh;
        rl = ql;
    } else {
        var dp: f64[10];
        var nd = _bj_e_dparts(a, b, cc, &dp);
        var ex: f64[16];
        var k = 0;
        for (var i = 0; i < nd; i = i + 1) {
            var di: f64 = dp[i];
            k = _bj_g_grow(&ex, k, di);
        }
        if (k == 0) {
            out[0] = 0.0;
            return 0;
        }
        var top: f64 = ex[k - 1];
        if (top < 0.0) { return 1; }
        var gh, gl = _bj_g_compress(&ex, k);
        var g_h: f64 = gh;
        var g_l: f64 = gl;
        var uh, ul = _bj_g_sqrt_dd(g_h, g_l);
        rh = uh;
        rl = ul;
    }
    if (slow == 0) {
        var y, ok = _bj_k_dd_div_cr(rh, rl, b, 0.0);
        if (ok == 1) {
            var yy: f64 = y;
            out[0] = yy;
            return 0;
        }
    }
    var z1, z2 = _bj_k_dd_div_ends(rh, rl, b, 0.0);
    var zz: f64 = z1;
    var r: f64 = _bj_e_cos_settle(a, b, cc, zz);
    out[0] = r;
    return 0;
}

# ── the Liénard–Wiechert R_eff and κ (M2 part 2c-4) ──────────────────────────────────────────────────────────────────
#
# R_eff = |R| − R⋅β = √S − P and κ = 1 − n̂⋅β = R_eff/√S, S = ΣRᵢ² and P = ΣRᵢβᵢ exactly, for a finite R ≠ 0 and
# |β| < 1 exactly (the callers' checks). Each is rounded once, and κ < 10^-30 (lienard_wiechert_e's DivisionByZero)
# is decided exactly. Rust's |R| − R⋅β and 1 − n̂⋅β cancel as n̂⋅β → 1, a relative error of about 2^-53/κ.
#
# The range. D = 1 − Σβᵢ² ≥ 2^-266 for doubles with |β| < 1. Order |β₁| ≥ |β₂| ≥ |β₃|; |β₁| < ½ gives D > ¼.
# Otherwise T₁ = 1 − β₁² ≥ 2^-53 is a multiple of 2^-106. D < T₁/2 needs β₂² ≥ T₁/4, so |β₂| ≥ 2^-28 and
# T₂ = T₁ − β₂² is a positive multiple of 2^-160. D < T₂/2 needs |β₃| ≥ 2^-81, so D is a positive multiple of 2^-266.
# κ ≥ 1 − |β| > D/2 and κ < 2, so κ lies in (2^-267, 2), and R_eff = κ|R| is never under 2^-367 (|R| ≥ 10^-30).
#
# Scaling. Both are scale-free in R, R_eff but for its factor. R' = R·2^-k, with k the largest component's exponent
# (at most 1022), puts the largest |R'ᵢ| in [1, 4). A component that falls under 2^-1022 rounds, an absolute error
# below 2^-1075.
#
# The parts (u = 2^-53). Each R'ᵢ and βᵢ is split once (Veltkamp), and every product is Dekker's TwoProduct on the
# halves, exact. The double-word sums are AccurateDWPlusDW (Joldes, Muller and Popescu, "Tight and rigorous error
# bounds for basic building blocks of double-word arithmetic", ACM TOMS 44 (2017), Algorithm 6): within 3u²/(1 − 4u)
# of the exact sum of two double-words, whatever their signs.
#   - S: two TwoSums of the squares' heads, then their errors and the squares' lows added in turn, within 12.04u².
#   - P: the same, with a last TwoSum, within 12.05u²·Σ|R'ᵢβᵢ|, at most 12.05u²·√S' (Cauchy–Schwarz, |β| < 1).
#   - √S': _bj_g_sqrt_dd's steps (6.06u²) inline, within 12.08u².
#   - An underflowing term's absolute error stays below 2^-1060, under 2^-790 of every quantity it reaches (each is
#     at least 2^-267).
#
# Far from the cone's edge (P ≤ √S/2, so R_eff ≥ 0.4999√S). R_eff = √S − P by AccurateDWPlusDW, within 51.3u², and
# κ = R_eff/√S, with 63.4u² in its operands.
#
# Near the edge (P > √S/2). Lagrange's identity gives N = S − P² = S·D + |R × β|², a sum of non-negative terms, so N
# comes without cancellation from two pieces:
#   - D: the expansion of 1 − Σβᵢ² (Shewchuk's Grow-Expansion, src/crmath_gamma.cyr's), compressed, within 4u².
#   - The cross components Rⱼβₖ − Rₖβⱼ: two TwoProducts and two TwoSums each, exact, joined by AccurateDWPlusDW
#     (3.01u²) and squared by _bj_k_dd_mul (8.01u²).
# N is within 27.1u² (S·D 24.05u², the squares' sum 20.05u²). √S + P is within 19.1u². Then R_eff = N/(√S + P),
# with 46.2u² in its operands, and κ = N/(√S·(√S + P)), with 66.3u².
#
# The rounding test is kimiya's _bj_k_dd_div_cr, with ε = 2^-98 (256u²) in place of 2^-100. It rounds correctly any
# quotient whose operands carry up to 239u² together, and fails about once in 2^44 (_bj_e_round_ends does the same
# for the far R_eff, a double-word within 254u²).
#
# The exact check runs when the test fails (or always, for slow = 1). The candidate's two neighbouring midpoints μ
# decide exactly, ties to even.
#   - Ties occur: R along (1, 2, 2) with β = (½ − 3·2^-54, ½, 0) puts κ on the midpoint ½ + 2^-54.
#   - R_eff − μ has the sign of S − (P + μ)² when P + μ > 0; otherwise it is positive.
#   - κ − μ has the sign of (1 − μ)√S − P: from the signs of 1 − μ and P, or else of (1 − μ)²S − P².
#   - κ < 10^-30 is decided by the test's ends where they clear 10^-30 by 2^-40 (always exactly for slow = 1).
#     Otherwise it is (10^30 − 1)²S < 10^60·P², with P > 0.
# These signs are bignum comparisons (src/fmtf.cyr's bignum, with a product here) in units of 2^m, m the terms' least
# exponent: below 2^6,560, in buffers of 216 words. cr_verify.py's lw_* families check them against Python's
# Fraction and an integer square root, on x86_64 and aarch64.

# AccurateDWPlusDW (the section comment): (x_h + x_l) + (y_h + y_l) as a double-word within 3u²/(1 − 4u) of the exact
# sum, for double-words x and y (x_h = RN(x_h + x_l), likewise y).
#must_use
fn _bj_e_dw_add(xh: f64, xl: f64, yh: f64, yl: f64): (f64, f64) {
    var sh: f64 = xh + yh;                          # TwoSum(x_h, y_h)
    var b1: f64 = sh - xh;
    var sl: f64 = (xh - (sh - b1)) + (yh - b1);
    var th: f64 = xl + yl;                          # TwoSum(x_l, y_l)
    var b2: f64 = th - xl;
    var tl: f64 = (xl - (th - b2)) + (yl - b2);
    var c: f64 = sl + th;
    var vh: f64 = sh + c;                           # FastTwoSum(s_h, c)
    var vl: f64 = c - (vh - sh);
    var w: f64 = tl + vl;
    var zh: f64 = vh + w;                           # FastTwoSum(v_h, w)
    var zl: f64 = w - (zh - vh);
    return (zh, zl);
}

# kimiya's _bj_k_dd_div_cr steps (src/crmath_kx.cyr) with ε = 2^-98·y₀ (256u²) in place of 2^-100: (z₁, z₂), z₁ = z₂
# being RN(n/d) of the exact value whenever the operands' relative errors total at most 239u² (the steps' own 16.2u²
# on top). Otherwise RN of the exact value is z₁ or the double above it. kimiya's conditions on n and d.
#must_use
fn _bj_e_div_ends(nh: f64, nl: f64, dh: f64, dl: f64): (f64, f64) {
    var y0: f64 = nh / dh;
    var a: f64 = y0 * dh;                           # y0·d_h = a + b: TwoProduct, inline (Veltkamp's 2^27 + 1 split)
    var sp: f64 = 134217729.0;
    var cy: f64 = sp * y0;
    var yh: f64 = cy - (cy - y0);
    var yl: f64 = y0 - yh;
    var cd: f64 = sp * dh;
    var dhh: f64 = cd - (cd - dh);
    var dhl: f64 = dh - dhh;
    var b: f64 = (yl * dhl) - (((a - (yh * dhh)) - (yl * dhh)) - (yh * dhl));
    var s: f64 = nh - a;
    var s1: f64 = s - b;
    var s2: f64 = s1 + nl;
    var s3: f64 = y0 * dl;
    var r: f64 = s2 - s3;
    var d: f64 = r / dh;
    var k98: f64 = 0x39D0000000000000;              # 2^-98
    var eps: f64 = y0 * k98;
    var lo: f64 = d - eps;
    var hi: f64 = d + eps;
    var z1: f64 = y0 + lo;
    var z2: f64 = y0 + hi;
    return (z1, z2);
}

# d := a·b for bignums (src/fmtf.cyr's layout), schoolbook on 32-bit limbs with a's limbs in 16-bit halves (every
# partial sum below 2^49). d is distinct from a and b and holds both counts.
fn _bj_e_bn_mul(d, a, b) {
    var na = load64(a);
    var nb = load64(b);
    if (na == 0 || nb == 0) {
        store64(d, 0);
        return 0;
    }
    var n = na + nb;
    for (var i = 0; i < n; i = i + 1) { store64(d + 8 + i * 8, 0); }
    for (var i2 = 0; i2 < na; i2 = i2 + 1) {
        var x = load64(a + 8 + i2 * 8);
        if (x == 0) { continue; }
        var xl = x & 0xFFFF;
        var xh = x >> 16;
        var carry = 0;
        for (var j = 0; j < nb; j = j + 1) {
            var yv = load64(b + 8 + j * 8);
            var lo = xl * yv;
            var hi = xh * yv;
            var at = d + 8 + (i2 + j) * 8;
            var tt = load64(at) + lo + ((hi & 0xFFFF) << 16) + carry;
            store64(at, tt & 0xFFFFFFFF);
            carry = (tt >> 32) + (hi >> 16);
        }
        var kk = i2 + nb;
        while (carry != 0) {
            var at2 = d + 8 + kk * 8;
            var t2 = load64(at2) + carry;
            store64(at2, t2 & 0xFFFFFFFF);
            carry = t2 >> 32;
            kk = kk + 1;
        }
    }
    while (n > 0 && load64(d + n * 8) == 0) { n = n - 1; }
    store64(d, n);
    return 0;
}

# The exact parts as bignums (the section comment), for R' = R·2^-k: s := S_int and pa := |P|_int, with
# S' = S_int·2^u[0] and P' = sgn·|P|_int·2^u[1]; returns sgn (−1, 0 or 1). ng, w and t are scratch bignums.
fn _bj_e_lw_parts(r: *f64, b: *f64, xo, k, s, pa, ng, w, t, u: *i64): i64 {
    var me[16];
    var rm: i64[3];
    var re: i64[3];
    var bm: i64[3];
    var be: i64[3];
    var us = 0;
    var have = 0;
    for (var i = 0; i < 3; i = i + 1) {
        var x: f64 = r[i];
        rm[i] = 0;
        if (x == 0.0) { continue; }
        _bj_g_split(x, &me);
        rm[i] = load64(&me);
        re[i] = load64(&me + 8) - k + _bj_e_off(xo, i);
        if (have == 0 || 2 * re[i] < us) {
            us = 2 * re[i];
            have = 1;
        }
    }
    for (var i2 = 0; i2 < 3; i2 = i2 + 1) {
        var y: f64 = b[i2];
        bm[i2] = 0;
        if (y == 0.0) { continue; }
        _bj_g_split(y, &me);
        bm[i2] = load64(&me);
        be[i2] = load64(&me + 8) + _bj_e_off(xo, 3 + i2);
    }
    store64(s, 0);
    for (var i3 = 0; i3 < 3; i3 = i3 + 1) {
        if (rm[i3] == 0) { continue; }
        _bj_bn_set(w, rm[i3]);
        _bj_g_mul(w, rm[i3], t);
        _bj_bn_shl(w, 2 * re[i3] - us);
        _bj_g_add_to(s, w);
    }
    var up = 0;
    have = 0;
    for (var i4 = 0; i4 < 3; i4 = i4 + 1) {
        if (rm[i4] == 0 || bm[i4] == 0) { continue; }
        var e = re[i4] + be[i4];
        if (have == 0 || e < up) {
            up = e;
            have = 1;
        }
    }
    store64(pa, 0);
    store64(ng, 0);
    for (var i5 = 0; i5 < 3; i5 = i5 + 1) {
        if (rm[i5] == 0 || bm[i5] == 0) { continue; }
        _bj_bn_set(w, rm[i5]);
        _bj_g_mul(w, bm[i5], t);
        _bj_bn_shl(w, re[i5] + be[i5] - up);
        var neg = ((_bj_bits(r[i5]) ^ _bj_bits(b[i5])) >> 63) & 1;
        if (neg == 1) { _bj_g_add_to(ng, w); } else { _bj_g_add_to(pa, w); }
    }
    u[0] = us;
    u[1] = up;
    var c = _bj_bn_cmp(pa, ng);
    if (c >= 0) {
        _bj_bn_sub(pa, ng);
        return c;
    }
    _bj_bn_sub(ng, pa);
    _bj_bn_copy(pa, ng);
    return 0 - 1;
}

# The exact sign (−1, 0 or 1), for R' = R·2^-k and μ = mm·2^f > 0 (the section comment): of R_eff' − μ (mode 0), of
# κ − μ (mode 1, f < 0), or of κ − 10^-30 (mode 2; mm and f unused).
#must_use
fn _bj_e_lw_sign(r: *f64, b: *f64, xo, k, mode, mm, f): i64 {
    var s[1728];
    var pa[1728];
    var x[1728];
    var y[1728];
    var w[1728];
    var t[1728];
    var u: i64[2];
    var sp = _bj_e_lw_parts(r, b, xo, k, &s, &pa, &x, &w, &t, &u);
    var us = u[0];
    var up = u[1];
    if (mode == 0) {
        var ub = f;                                 # B = P' + μ in units of 2^ub
        if (sp != 0 && up < ub) { ub = up; }
        _bj_bn_set(&x, mm);
        _bj_bn_shl(&x, f - ub);
        if (sp != 0) {
            _bj_bn_copy(&y, &pa);
            _bj_bn_shl(&y, up - ub);
        }
        if (sp > 0) { _bj_g_add_to(&x, &y); }
        if (sp < 0) {
            if (_bj_bn_cmp(&x, &y) <= 0) { return 1; }
            _bj_bn_sub(&x, &y);
        }
        _bj_e_bn_mul(&y, &x, &x);
        var d = us - 2 * ub;
        if (d >= 0) { _bj_bn_shl(&s, d); } else { _bj_bn_shl(&y, 0 - d); }
        var c0 = _bj_bn_cmp(&s, &y);
        return c0;
    }
    var sa = 1;                                     # A = 1 − μ = ±|A_int|·2^ua, or (10^30 − 1)·10^-30 (mode 2)
    var ua = 0;
    if (mode == 1) {
        _bj_bn_set(&x, 1);
        _bj_bn_shl(&x, 0 - f);
        _bj_bn_set(&y, mm);
        var ca = _bj_bn_cmp(&x, &y);
        if (ca > 0) { _bj_bn_sub(&x, &y); }
        if (ca < 0) {
            _bj_bn_sub(&y, &x);
            _bj_bn_copy(&x, &y);
            sa = 0 - 1;
        }
        if (ca == 0) { sa = 0; }
        ua = f;
    } else {
        _bj_bn_set(&x, 1);
        _bj_bn_mul_pow10(&x, 30);
        _bj_bn_set(&y, 1);
        _bj_bn_sub(&x, &y);
    }
    if (sa >= 0 && sp <= 0) {
        if (sa == 0 && sp == 0) { return 0; }
        return 1;
    }
    if (sa <= 0 && sp >= 0) { return 0 - 1; }
    _bj_e_bn_mul(&y, &x, &x);                       # A² in units of 2^(2ua)
    _bj_e_bn_mul(&w, &y, &s);                       # A²S', 2^(2ua + us)
    _bj_e_bn_mul(&y, &pa, &pa);                     # P'², 2^(2up)
    if (mode == 2) { _bj_bn_mul_pow10(&y, 60); }
    var dd = 2 * ua + us - 2 * up;
    if (dd >= 0) { _bj_bn_shl(&w, dd); } else { _bj_bn_shl(&y, 0 - dd); }
    var c2 = _bj_bn_cmp(&w, &y);
    if (sa > 0) { return c2; }
    return 0 - c2;
}

# RN of R_eff' (mode 0) or κ (mode 1) from a candidate y within an ulp of it (the section comment's exact check).
#must_use
fn _bj_e_lw_settle(r: *f64, b: *f64, xo, k, mode, y: f64): f64 {
    var me[16];
    var up: f64 = _bj_g_step(y, 1);
    _bj_g_mid(y, up, &me);
    var su = _bj_e_lw_sign(r, b, xo, k, mode, load64(&me), load64(&me + 8));
    if (su > 0) { return up; }
    if (su == 0) {
        var eu: f64 = _bj_g_even(y, up);
        return eu;
    }
    var dn: f64 = _bj_g_step(y, 0 - 1);
    _bj_g_mid(dn, y, &me);
    var sd = _bj_e_lw_sign(r, b, xo, k, mode, load64(&me), load64(&me + 8));
    if (sd < 0) { return dn; }
    if (sd == 0) {
        var ed: f64 = _bj_g_even(dn, y);
        return ed;
    }
    return y;
}

# z₁ = RN(h + RN(l − ε)) and z₂ = RN(h + RN(l + ε)), ε = 2^-98·h, for a positive double-word h + l within 254u² of an
# exact value v: z₁ = z₂ is RN(v) (RN(l ∓ ε) is within 1.01u²·h of l ∓ ε, so h + RN(l − ε) < v < h + RN(l + ε));
# otherwise RN(v) is z₁ or the double above it.
#must_use
fn _bj_e_round_ends(h: f64, l: f64): (f64, f64) {
    var k98: f64 = 0x39D0000000000000;              # 2^-98
    var eps: f64 = h * k98;
    var lo: f64 = l - eps;
    var hi: f64 = l + eps;
    var z1: f64 = h + lo;
    var z2: f64 = h + hi;
    return (z1, z2);
}

# The cross component x₁y₂ − x₂y₁ as a double-word within 3.01u², from the four doubles and their Veltkamp halves
# (two TwoProducts and two TwoSums, exact, then AccurateDWPlusDW).
#must_use
fn _bj_e_cross_dw(x1: f64, x1h: f64, x1l: f64, y2: f64, y2h: f64, y2l: f64, x2: f64, x2h: f64, x2l: f64, y1: f64,
  y1h: f64, y1l: f64): (f64, f64) {
    var pa: f64 = x1 * y2;                          # x₁y₂ = pa + ea, x₂y₁ = pb + eb (Dekker's, on the halves)
    var ea: f64 = ((((x1h * y2h) - pa) + (x1h * y2l)) + (x1l * y2h)) + (x1l * y2l);
    var pb: f64 = x2 * y1;
    var eb: f64 = ((((x2h * y1h) - pb) + (x2h * y1l)) + (x2l * y1h)) + (x2l * y1l);
    var mb: f64 = -pb;
    var sh: f64 = pa + mb;                          # TwoSum(pa, −pb)
    var b1: f64 = sh - pa;
    var sl: f64 = (pa - (sh - b1)) + (mb - b1);
    var meb: f64 = -eb;
    var th: f64 = ea + meb;                         # TwoSum(ea, −eb)
    var b2: f64 = th - ea;
    var tl: f64 = (ea - (th - b2)) + (meb - b2);
    var zh, zl = _bj_e_dw_add(sh, sl, th, tl);
    return (zh, zl);
}

# ── n̂ − β (M2 part 2d-1, the user's answer of 2026-11-13) ─────────────────────────────────────────────────────────
#
# dᵢ = n̂ᵢ − βᵢ = R'ᵢ/√S' − βᵢ, rounded once, for E's velocity term (|n̂ − β|² = 2κ − (1 − |β|²): it vanishes with κ).
# A zero R'ᵢ keeps Rust's ±0 − βᵢ, exact. Otherwise, fast: R'ᵢ/(q_h + q_l) by kimiya's quotient steps (13.12u² on top
# of √S' 's 12.08u²), βᵢ subtracted by TwoSum and the lows added once: within E = 27.4u²|n̂ᵢ| + 1.01u²|dᵢ| + 2^-1060
# (an underflowing step's absolute error). Its ends at ε = (E + 2.02u²|d_h|)(1 + 2^-40) + 2^-1074 bracket dᵢ, so equal
# nonzero ends are RN(dᵢ). Else exact (bignums, src/fmtf.cyr's with the products here): the sign of sg·dᵢ − μ is that
# of R̃ − B√S', R̃ = sg·R'ᵢ, B = sg·βᵢ + μ, by the signs of R̃ and B or of R̃² − B²S'. The candidate is the fast
# estimate when its ends are adjacent, otherwise (a cancellation, R'ᵢ and βᵢ of one sign) N/(√S'(|R'ᵢ| + |βᵢ|√S')) with
# N = R'ᵢ² − βᵢ²S' exact; sg its sign. A tie would need R'ᵢ/√S' dyadic, which (x² + y² = (4^q − p²)w² has no solution,
# 4^q − p² ≡ 3 mod 4) only an axis gives, where dᵢ = ±1 − βᵢ; the exact check handles it anyway, ties to even.

# The fast dᵢ's ends (z₁, z₂) for x = R'ᵢ ≠ 0, √S' = q_h + q_l and y = βᵢ (the section comment).
#must_use
fn _bj_e_nb_fast(x: f64, qh: f64, ql: f64, y: f64): (f64, f64) {
    var y0: f64 = x / qh;                           # x/(q_h + q_l): kimiya's steps, inline
    var a: f64 = y0 * qh;
    var sp: f64 = 134217729.0;
    var cy: f64 = sp * y0;
    var yh: f64 = cy - (cy - y0);
    var yl: f64 = y0 - yh;
    var cq: f64 = sp * qh;
    var qhh: f64 = cq - (cq - qh);
    var qhl: f64 = qh - qhh;
    var bb: f64 = (yl * qhl) - (((a - (yh * qhh)) - (yl * qhh)) - (yh * qhl));
    var s0: f64 = x - a;
    var s1: f64 = s0 - bb;
    var s3: f64 = y0 * ql;
    var rr: f64 = s1 - s3;
    var dd: f64 = rr / qh;
    var nh: f64 = y0 + dd;                          # FastTwoSum(y0, dd)
    var nl: f64 = dd - (nh - y0);
    var my: f64 = -y;
    var sh: f64 = nh + my;                          # TwoSum(n_h, −y)
    var b1: f64 = sh - nh;
    var st: f64 = (nh - (sh - b1)) + (my - b1);
    var v: f64 = st + nl;
    var dh: f64 = sh + v;                           # TwoSum(sh, v)
    var b2: f64 = dh - sh;
    var dl: f64 = (sh - (dh - b2)) + (v - b2);
    var u2: f64 = 0x3950000000000000;               # 2^-106
    var anh: f64 = f64_abs(nh);
    var adh: f64 = f64_abs(dh);
    var t60: f64 = _bj_from_bits(16384);            # 2^-1060
    var eab: f64 = ((27.4 * u2 * anh) + (1.01 * u2 * adh)) + t60;
    var g40: f64 = 0x3D70000000000000;              # 2^-40
    var tiny: f64 = _bj_from_bits(1);               # 2^-1074
    var eps: f64 = ((eab + (2.02 * u2 * adh)) * (1.0 + g40)) + tiny;
    var lo: f64 = dl - eps;
    var hi: f64 = dl + eps;
    var z1: f64 = dh + lo;
    var z2: f64 = dh + hi;
    return (z1, z2);
}

# Bignum scratch for dᵢ's exact path: S' and |R'ᵢ| and |βᵢ| as integers (the parts at r and b, R scaled by 2^-k).
# s := S_int with S' = S_int·2^u[0]; returns 0. w and t are scratch.
fn _bj_e_nb_s(r: *f64, xo, k, s, w, t, u: *i64) {
    var me[16];
    var us = 0;
    var have = 0;
    store64(s, 0);
    for (var j = 0; j < 3; j = j + 1) {
        var x: f64 = r[j];
        if (x == 0.0) { continue; }
        _bj_g_split(x, &me);
        var e2 = 2 * (load64(&me + 8) - k + _bj_e_off(xo, j));
        if (have == 0 || e2 < us) {
            us = e2;
            have = 1;
        }
    }
    for (var j2 = 0; j2 < 3; j2 = j2 + 1) {
        var x2: f64 = r[j2];
        if (x2 == 0.0) { continue; }
        _bj_g_split(x2, &me);
        var m = load64(&me);
        _bj_bn_set(w, m);
        _bj_g_mul(w, m, t);
        _bj_bn_shl(w, 2 * (load64(&me + 8) - k + _bj_e_off(xo, j2)) - us);
        _bj_g_add_to(s, w);
    }
    u[0] = us;
    return 0;
}

# The exact sign (−1, 0 or 1) of sg·dᵢ − μ, μ = mm·2^f ≥ 0 (mm = 0 for μ = 0), dᵢ = R'ᵢ/√S' − βᵢ with R'ᵢ ≠ 0 (the
# section comment).
#must_use
fn _bj_e_nb_sign(r: *f64, b: *f64, xo, k, i, sg, mm, f): i64 {
    var s[1728];
    var x[1728];
    var y[1728];
    var w[1728];
    var t[1728];
    var u: i64[1];
    _bj_e_nb_s(r, xo, k, &s, &w, &t, &u);
    var us = u[0];
    var me[16];
    var ri: f64 = r[i];
    _bj_g_split(ri, &me);
    var rm = load64(&me);
    var re = load64(&me + 8) - k + _bj_e_off(xo, i);
    var sr = sg;                                    # the sign of R̃ = sg·R'ᵢ
    if (ri < 0.0) { sr = 0 - sg; }
    var bi: f64 = b[i];
    var ub = f;                                     # B = sg·βᵢ + μ in units of 2^ub: positive part x, negative part y
    var be = 0;
    var bm = 0;
    if (bi != 0.0) {
        _bj_g_split(bi, &me);
        bm = load64(&me);
        be = load64(&me + 8) + _bj_e_off(xo, 3 + i);
        if (mm == 0 || be < ub) { ub = be; }
    }
    store64(&x, 0);
    store64(&y, 0);
    if (mm != 0) {
        _bj_bn_set(&x, mm);
        _bj_bn_shl(&x, f - ub);
    }
    if (bi != 0.0) {
        _bj_bn_set(&w, bm);
        _bj_bn_shl(&w, be - ub);
        var sb = sg;
        if (bi < 0.0) { sb = 0 - sg; }
        if (sb > 0) { _bj_g_add_to(&x, &w); } else { _bj_g_add_to(&y, &w); }
    }
    var cb = _bj_bn_cmp(&x, &y);                    # the sign of B, and |B| into x
    if (cb > 0) { _bj_bn_sub(&x, &y); }
    if (cb < 0) {
        _bj_bn_sub(&y, &x);
        _bj_bn_copy(&x, &y);
    }
    if (sr > 0 && cb <= 0) { return 1; }
    if (sr < 0 && cb >= 0) { return 0 - 1; }
    _bj_e_bn_mul(&y, &x, &x);                       # B², 2^(2ub)
    _bj_e_bn_mul(&w, &y, &s);                       # B²S', 2^(2ub + us)
    _bj_bn_set(&y, rm);                             # R̃², 2^(2re)
    _bj_g_mul(&y, rm, &t);
    var d = 2 * re - 2 * ub - us;
    if (d >= 0) { _bj_bn_shl(&y, d); } else { _bj_bn_shl(&w, 0 - d); }
    var c = _bj_bn_cmp(&y, &w);
    if (sr > 0) { return c; }
    return 0 - c;
}

# A candidate for |dᵢ| with its sign into sg[0], for R'ᵢ ≠ 0 (q_h ≈ √S'), when the fast estimate's ends are not
# adjacent (the section comment). Signs and magnitudes come from R itself, scaled through its exponent: R'ᵢ's double
# may have underflowed.
#must_use
fn _bj_e_nb_cand(r: *f64, b: *f64, xo, k, i, qh: f64, sg: *i64): f64 {
    var y: f64 = b[i];
    var ri: f64 = r[i];
    var yb: f64 = f64_abs(y);
    var bo = _bj_e_off(xo, 3 + i);
    var ay: f64 = _bj_g_scale(yb, bo);              # |βᵢ| (rounded, for the estimate)
    var ar: f64 = f64_abs(ri);
    var rs, rex = _bj_e_frexp(ar);                  # |R'ᵢ| = rs·2^(rex − k), rs in [1, 2)
    var rsv: f64 = rs;
    var ex = rex - k + _bj_e_off(xo, i);
    sg[0] = 1;
    if (ri < 0.0) { sg[0] = 0 - 1; }
    if (y == 0.0 || (ri < 0.0) != (y < 0.0)) {
        var q: f64 = rsv / qh;
        var qn: f64 = _bj_g_scale(q, ex);
        var c0: f64 = qn + ay;
        return c0;
    }
    var yn: f64 = _bj_g_scale(yb, bo - ex);         # |βᵢ| on R'ᵢ's scale
    if (!(yn < 1152921504606846976.0)) {
        # |βᵢ| above 2^59·|R'ᵢ| ≥ 2^59·|n̂ᵢ| (√S' ≥ 1): nothing cancels, so |dᵢ| = |βᵢ| − |n̂ᵢ| lies within an ulp of
        # RN(|βᵢ|) − RN(|n̂ᵢ|), of −βᵢ's sign. (On R'ᵢ's scale |βᵢ| would overflow: R'ᵢ near 2^-2097, M2 part 2d-3i.)
        var q2: f64 = rsv / qh;
        var qn2: f64 = _bj_g_scale(q2, ex);
        sg[0] = 0 - sg[0];
        var c2: f64 = ay - qn2;
        return c2;
    }
    var s[1728];
    var nn[1728];
    var w[1728];
    var t[1728];
    var u: i64[1];
    _bj_e_nb_s(r, xo, k, &s, &w, &t, &u);
    var us = u[0];
    var me[16];
    _bj_g_split(ri, &me);
    var rm = load64(&me);
    var re = load64(&me + 8) - k + _bj_e_off(xo, i);
    _bj_g_split(y, &me);
    var bm = load64(&me);
    var be = load64(&me + 8) + bo;
    _bj_bn_set(&nn, rm);                            # R'ᵢ², 2^(2re)
    _bj_g_mul(&nn, rm, &t);
    _bj_bn_set(&w, bm);                             # βᵢ²S', 2^(2be + us)
    _bj_g_mul(&w, bm, &t);
    _bj_e_bn_mul(&t, &w, &s);
    var un = 2 * re;
    var d = 2 * re - 2 * be - us;
    if (d >= 0) {
        _bj_bn_shl(&nn, d);
        un = 2 * be + us;
    } else {
        _bj_bn_shl(&t, 0 - d);
    }
    var c = _bj_bn_cmp(&nn, &t);                    # N = R'ᵢ² − βᵢ²S' = ±|N|·2^un
    if (c < 0) {
        sg[0] = 0 - sg[0];
        _bj_bn_sub(&t, &nn);
        _bj_bn_copy(&nn, &t);
    } else {
        _bj_bn_sub(&nn, &t);
    }
    if (load64(&nn) == 0) { return 0.0; }
    var sh: i64[1];
    var top = _bj_e_par_top(&nn, &w, &sh);
    var ft: f64 = f64_from(top);
    var den: f64 = qh * (rsv + (yn * qh));          # (√S'(|R'ᵢ| + |βᵢ|√S'))·2^-ex
    var c1: f64 = ft / den;
    var res: f64 = _bj_g_scale(c1, sh[0] + un - ex);
    return res;
}

# RN(dᵢ) by the exact path, from the fast ends z₁, z₂ (the section comment).
#must_use
fn _bj_e_nb_exact(r: *f64, b: *f64, xo, k, i, x: f64, qh: f64, z1: f64, z2: f64): f64 {
    var sg: i64[1];
    sg[0] = 1;
    var y: f64 = 0.0;
    var b1 = _bj_bits(z1);
    var b2 = _bj_bits(z2);
    var near = 0;
    if (z1 != 0.0 && z2 != 0.0 && (z1 < 0.0) == (z2 < 0.0)) {
        var dbits = b2 - b1;
        if (dbits >= 0 - 1 && dbits <= 1) { near = 1; }
    }
    if (near == 1) {
        if (z1 < 0.0) { sg[0] = 0 - 1; }
        y = f64_abs(z1);
    } else {
        y = _bj_e_nb_cand(r, b, xo, k, i, qh, &sg);
    }
    var g = sg[0];
    var me[16];
    for (var it = 0; it < 10; it = it + 1) {
        var up: f64 = _bj_g_step(y, 1);
        _bj_g_mid(y, up, &me);
        var su = _bj_e_nb_sign(r, b, xo, k, i, g, load64(&me), load64(&me + 8));
        if (su > 0) {
            y = up;
            continue;
        }
        if (su == 0) {
            y = _bj_g_even(y, up);
            break;
        }
        if (y == 0.0) { break; }
        var dn: f64 = _bj_g_step(y, 0 - 1);
        _bj_g_mid(dn, y, &me);
        var sd = _bj_e_nb_sign(r, b, xo, k, i, g, load64(&me), load64(&me + 8));
        if (sd < 0) {
            y = dn;
            continue;
        }
        if (sd == 0) { y = _bj_g_even(dn, y); }
        break;
    }
    if (g < 0) { y = -y; }
    return y;
}

# The exponent offset of part i (R's 0 to 2, β's 3 to 5) in _bj_cr_lw's offset form, 0 without one (M2 part 2d-3i).
#must_use
fn _bj_e_off(xo, i): i64 {
    if (xo == 0) { return 0; }
    return load64(xo + 8 * i);
}

# The offset form's k: the largest ⌊log₂|Rᵢ|⌋ (each part's significand bits and exponent with its offset), at most
# 1023, so the largest |R'ᵢ| lies in [1, 4) for |Rᵢ| ≤ 2·DBL_MAX. R ≠ 0.
#must_use
fn _bj_e_lw_k(r: *f64, xo): i64 {
    var me[16];
    var k = 0;
    var have = 0;
    for (var i = 0; i < 3; i = i + 1) {
        var x: f64 = r[i];
        if (x == 0.0) { continue; }
        _bj_g_split(x, &me);
        var e = load64(&me + 8) + _bj_bitlen(load64(&me)) - 1 + load64(xo + 8 * i);
        if (have == 0 || e > k) {
            k = e;
            have = 1;
        }
    }
    if (k > 1023) { k = 1023; }
    return k;
}

# The Liénard–Wiechert R_eff (mode 0) or κ (mode 1), the section comment's, for a finite R ≠ 0 at r and |β| < 1
# exactly at b. Mode 0: out[0] := RN(|R| − R⋅β), returning 0. Mode 1: 1 when κ < 10^-30 exactly; otherwise 0, with
# out[0] := RN(1 − R⋅β/|R|). Mode 2: as mode 1, and out[1..3] := RN(R'ᵢ/|R'| − βᵢ), n̂ − β (M2 part 2d-1). Mode 3:
# R_eff to 53 bits with an unbounded exponent (M2 part 2d-3e: an R_eff past DBL_MAX, for the potentials): out[0] := the
# rounded R_eff' = R_eff·2^-k (normal) and out[1] := k, so R_eff = out[0]·2^k. slow = 1 skips the rounding tests, so the
# exact checks always run (cr_verify.py's lw_*_slow). xo is 0, or the offset form's six exponents (M2 part 2d-3i, for
# lienard_wiechert_fields' chain): Rᵢ = r[i]·2^xo[i] and βᵢ = b[i]·2^xo[3 + i], each offset part's double normal, with
# |Rᵢ| ≤ 2·DBL_MAX (a difference of two doubles) and an offset βᵢ in [2^-1110, 2^-1022) (a quotient v/c on the 53-bit
# grid). The fast path takes R' and β rounded (an underflowing part's absolute error below 2^-1074, inside the section
# comment's 2^-1060), and the exact checks take each part's significand and exponent with its offset.
#must_use
fn _bj_cr_lw(r: *f64, b: *f64, xo, mode_in, slow, out: *f64): i64 {
    var mode = mode_in;
    if (mode_in == 3) { mode = 0; }
    var w0 = _bj_bits(r[0]);
    var w1 = _bj_bits(r[1]);
    var w2 = _bj_bits(r[2]);
    var emax = (w0 >> 52) & 0x7FF;
    var e1x = (w1 >> 52) & 0x7FF;
    var e2x = (w2 >> 52) & 0x7FF;
    if (e1x > emax) { emax = e1x; }
    if (e2x > emax) { emax = e2x; }
    var k = emax - 1023;
    if (k > 1022) { k = 1022; }
    var sc: f64 = _bj_from_bits((1023 - k) << 52);  # 2^-k
    var sp: f64 = 134217729.0;                      # Veltkamp's 2^27 + 1: each part split once
    var rr0: f64 = r[0];
    var rr1: f64 = r[1];
    var rr2: f64 = r[2];
    var x0: f64 = rr0 * sc;
    var x1: f64 = rr1 * sc;
    var x2: f64 = rr2 * sc;
    var y0: f64 = b[0];
    var y1: f64 = b[1];
    var y2: f64 = b[2];
    if (xo != 0) {
        k = _bj_e_lw_k(r, xo);
        x0 = _bj_g_scale(rr0, load64(xo) - k);
        x1 = _bj_g_scale(rr1, load64(xo + 8) - k);
        x2 = _bj_g_scale(rr2, load64(xo + 16) - k);
        y0 = _bj_g_scale(y0, load64(xo + 24));
        y1 = _bj_g_scale(y1, load64(xo + 32));
        y2 = _bj_g_scale(y2, load64(xo + 40));
    }
    var cx0: f64 = sp * x0;
    var x0h: f64 = cx0 - (cx0 - x0);
    var x0l: f64 = x0 - x0h;
    var cx1: f64 = sp * x1;
    var x1h: f64 = cx1 - (cx1 - x1);
    var x1l: f64 = x1 - x1h;
    var cx2: f64 = sp * x2;
    var x2h: f64 = cx2 - (cx2 - x2);
    var x2l: f64 = x2 - x2h;
    var cy0: f64 = sp * y0;
    var y0h: f64 = cy0 - (cy0 - y0);
    var y0l: f64 = y0 - y0h;
    var cy1: f64 = sp * y1;
    var y1h: f64 = cy1 - (cy1 - y1);
    var y1l: f64 = y1 - y1h;
    var cy2: f64 = sp * y2;
    var y2h: f64 = cy2 - (cy2 - y2);
    var y2l: f64 = y2 - y2h;
    var a0: f64 = x0 * x0;                          # R'ᵢ² = aᵢ + eᵢ, R'ᵢβᵢ = cᵢ + fᵢ (Dekker's, on the halves)
    var m0: f64 = x0h * x0l;
    var e0: f64 = ((((x0h * x0h) - a0) + m0) + m0) + (x0l * x0l);
    var a1: f64 = x1 * x1;
    var m1: f64 = x1h * x1l;
    var e1: f64 = ((((x1h * x1h) - a1) + m1) + m1) + (x1l * x1l);
    var a2: f64 = x2 * x2;
    var m2: f64 = x2h * x2l;
    var e2: f64 = ((((x2h * x2h) - a2) + m2) + m2) + (x2l * x2l);
    var c0: f64 = x0 * y0;
    var f0: f64 = ((((x0h * y0h) - c0) + (x0h * y0l)) + (x0l * y0h)) + (x0l * y0l);
    var c1: f64 = x1 * y1;
    var f1: f64 = ((((x1h * y1h) - c1) + (x1h * y1l)) + (x1l * y1h)) + (x1l * y1l);
    var c2: f64 = x2 * y2;
    var f2: f64 = ((((x2h * y2h) - c2) + (x2h * y2l)) + (x2l * y2h)) + (x2l * y2l);
    var u1: f64 = a0 + a1;                          # S = s_h + s_l within 12.04u² (TwoSums, then the lows)
    var w1v: f64 = u1 - a0;
    var t1: f64 = (a0 - (u1 - w1v)) + (a1 - w1v);
    var u2: f64 = u1 + a2;
    var w2v: f64 = u2 - u1;
    var t2: f64 = (u1 - (u2 - w2v)) + (a2 - w2v);
    var lo: f64 = (((t1 + t2) + e0) + e1) + e2;
    var s_h: f64 = u2 + lo;                         # FastTwoSum(u2, lo)
    var s_l: f64 = lo - (s_h - u2);
    var v1: f64 = c0 + c1;                          # P = p_h + p_l within 12.05u²·√S' (TwoSums, the lows, TwoSum)
    var z1v: f64 = v1 - c0;
    var g1: f64 = (c0 - (v1 - z1v)) + (c1 - z1v);
    var v2: f64 = v1 + c2;
    var z2v: f64 = v2 - v1;
    var g2: f64 = (v1 - (v2 - z2v)) + (c2 - z2v);
    var plo: f64 = (((g1 + g2) + f0) + f1) + f2;
    var p_h: f64 = v2 + plo;                        # TwoSum(v2, plo)
    var zp: f64 = p_h - v2;
    var p_l: f64 = (v2 - (p_h - zp)) + (plo - zp);
    var q0: f64 = f64_sqrt(s_h);                    # √S = q_h + q_l within 12.08u² (_bj_g_sqrt_dd's steps, inline)
    var cq: f64 = sp * q0;
    var qh0: f64 = cq - (cq - q0);
    var ql0: f64 = q0 - qh0;
    var qq: f64 = q0 * q0;
    var qhl: f64 = qh0 * ql0;
    var qe: f64 = ((((qh0 * qh0) - qq) + qhl) + qhl) + (ql0 * ql0);
    var qr: f64 = ((s_h - qq) - qe) + s_l;
    var q2: f64 = 2.0 * q0;
    var qs: f64 = qr / q2;
    var q_h: f64 = q0 + qs;                         # FastTwoSum(q0, qs)
    var q_l: f64 = qs - (q_h - q0);
    var near = 0;
    if (p_h > 0.0) {
        var p4: f64 = 4.0 * p_h * p_h;
        if (p4 > s_h) { near = 1; }
    }
    var y: f64 = 0.0;
    var zz: f64 = 0.0;
    if (near == 0) {
        var mph: f64 = -p_h;
        var mpl: f64 = -p_l;
        var fh, fl = _bj_e_dw_add(q_h, q_l, mph, mpl);
        var f_h: f64 = fh;
        var f_l: f64 = fl;
        if (mode == 0) {
            var e1z, e2z = _bj_e_round_ends(f_h, f_l);
            y = e1z;
            zz = e2z;
        } else {
            var k1z, k2z = _bj_e_div_ends(f_h, f_l, q_h, q_l);
            y = k1z;
            zz = k2z;
        }
    } else {
        var pb0: f64 = y0 * y0;                     # D = 1 − Σβᵢ² exactly: βᵢ² by TwoProduct on the halves, grown
        var n0: f64 = y0h * y0l;
        var eb0: f64 = ((((y0h * y0h) - pb0) + n0) + n0) + (y0l * y0l);
        var pb1: f64 = y1 * y1;
        var n1: f64 = y1h * y1l;
        var eb1: f64 = ((((y1h * y1h) - pb1) + n1) + n1) + (y1l * y1l);
        var pb2: f64 = y2 * y2;
        var n2: f64 = y2h * y2l;
        var eb2: f64 = ((((y2h * y2h) - pb2) + n2) + n2) + (y2l * y2l);
        var ex: f64[8];
        ex[0] = 1.0;
        var kd = _bj_g_grow(&ex, 1, -eb2);
        kd = _bj_g_grow(&ex, kd, -eb1);
        kd = _bj_g_grow(&ex, kd, -eb0);
        kd = _bj_g_grow(&ex, kd, -pb2);
        kd = _bj_g_grow(&ex, kd, -pb1);
        kd = _bj_g_grow(&ex, kd, -pb0);
        var dxh, dxl = _bj_g_compress(&ex, kd);
        var d_h: f64 = dxh;
        var d_l: f64 = dxl;
        var c1h, c1l = _bj_e_cross_dw(x1, x1h, x1l, y2, y2h, y2l, x2, x2h, x2l, y1, y1h, y1l);
        var c2h, c2l = _bj_e_cross_dw(x2, x2h, x2l, y0, y0h, y0l, x0, x0h, x0l, y2, y2h, y2l);
        var c3h, c3l = _bj_e_cross_dw(x0, x0h, x0l, y1, y1h, y1l, x1, x1h, x1l, y0, y0h, y0l);
        var u1h, u1l = _bj_k_dd_mul(c1h, c1l, c1h, c1l);
        var u2h, u2l = _bj_k_dd_mul(c2h, c2l, c2h, c2l);
        var u3h, u3l = _bj_k_dd_mul(c3h, c3l, c3h, c3l);
        var vh, vl = _bj_e_dw_add(u1h, u1l, u2h, u2l);
        var ch, cl = _bj_e_dw_add(vh, vl, u3h, u3l);
        var mh, ml = _bj_k_dd_mul(s_h, s_l, d_h, d_l);
        var nh, nl = _bj_e_dw_add(mh, ml, ch, cl);
        var n_h: f64 = nh;
        var n_l: f64 = nl;
        var wh, wl = _bj_e_dw_add(q_h, q_l, p_h, p_l);
        var w_h: f64 = wh;
        var w_l: f64 = wl;
        if (mode >= 1) {
            var th, tl = _bj_k_dd_mul(q_h, q_l, w_h, w_l);
            w_h = th;
            w_l = tl;
        }
        var n1z, n2z = _bj_e_div_ends(n_h, n_l, w_h, w_l);
        y = n1z;
        zz = n2z;
    }
    var km = mode;
    if (km > 1) { km = 1; }
    if (km == 1) {
        var lo_t: f64 = 0x39B4484BFEEBAE57;          # 1e-30·(1 − 2^-40), rounded down
        var hi_t: f64 = 0x39B4484BFEEBD6E9;          # 1e-30·(1 + 2^-40), rounded up
        var band = slow;
        if (zz >= lo_t && y <= hi_t) { band = 1; }
        if (band == 1) {
            if (_bj_e_lw_sign(r, b, xo, k, 2, 0, 0) < 0) { return 1; }
        }
        if (band == 0 && zz < lo_t) { return 1; }
    }
    if (slow == 1 || y != zz) { y = _bj_e_lw_settle(r, b, xo, k, km, y); }
    if (mode_in == 3) {
        out[0] = y;                                 # R_eff' (normal), R_eff = y·2^k
        out[1] = f64_from(k);
        return 0;
    }
    if (mode == 0) { y = _bj_g_scale(y, k); }
    out[0] = y;
    if (mode == 2) {
        var xv: f64[3];
        xv[0] = x0;
        xv[1] = x1;
        xv[2] = x2;
        for (var j = 0; j < 3; j = j + 1) {
            var xj: f64 = xv[j];
            var bj: f64 = b[j];
            if (xo != 0) { bj = _bj_g_scale(bj, load64(xo + 24 + 8 * j)); }     # βᵢ rounded once
            var rj: f64 = r[j];
            if (rj == 0.0) {
                var dz: f64 = rj - bj;              # Rust's ±0 − βᵢ, exact
                if (b[j] != 0.0) { dz = -bj; }      # −RN(βᵢ): an offset βᵢ that rounds to 0 keeps −βᵢ's sign
                out[1 + j] = dz;
                continue;
            }
            var z1, z2 = _bj_e_nb_fast(xj, q_h, q_l, bj);
            var zl: f64 = z1;
            var zh: f64 = z2;
            var dj: f64 = zl;
            if (slow == 1 || zl != zh || zl == 0.0) { dj = _bj_e_nb_exact(r, b, xo, k, j, xj, q_h, zl, zh); }
            out[1 + j] = dj;
        }
    }
    return 0;
}

# ── the parallel combinations (M2 part 2c-5) ─────────────────────────────────────────────────────────────────────────
#
# S = Σ 1/xᵢ exactly, for n values none of which is NaN, each finite one with |xᵢ| ≥ 10^-30 (the callers' checks; an
# ±∞ adds 1/±∞ = ±0, exactly as IEEE's). |S| < 10^-30 (the DivisionByZero "sum of inverse … is zero") is decided
# exactly, and the combination 1/S is rounded once. Rust's 1/(Σ RN(1/xᵢ)) rounds n + 1 times and cancels when the
# values' signs differ, so it refused sums above 10^-30 and returned values far from 1/S.
#
# The terms (u = 2^-53). Each 1/xᵢ is q + l: q = RN(1/xᵢ), and below |xᵢ| = 2^900 the remainder r = 1 − q·xᵢ is exact
# (TwoProduct, then (1 − p) − e: 1 − p by Sterbenz, and the remainder of a correctly rounded quotient is a double), so
# l = RN(r·q) is within 2.01u|r/xᵢ| ≤ 2.02u²|q| of r/xᵢ (q's own error, then the product's: a multiplication where a
# second division would do), and exactly it when r = 0. Above 2^900, l = 0 and the term is within u|q| + 2^-1074 of
# 1/xᵢ (q may be subnormal).
#
# Three tiers, each with a rigorous bound E on |S − S_dd|; the first that decides answers.
#   - T1, a compensated sum: TwoSums of the heads into σ, their errors t and the lows added into c (w = t + l, then
#     c + w, each rounded once), S_dd = TwoSum(σ, c). E = 1.01u·Σ(|w| + |c|) + 2.03u²·Σ|q| (inexact l) +
#     1.01(u·Σ|q| + k·2^-1074) (the k terms above 2^900); the hundredths cover the bounds' own roundings for n < 2^43.
#     E/|S| grows as n²u²/2 for like-signed values (12.5u² at n = 5).
#   - T2, the exact Shewchuk expansion of every q and l (Grow-Expansion, at most 252 components, else T3), compressed
#     to a double-word within 2^-104: E = 2.03u²·Σ|q| + the same tail terms + 4.01u²·|S_dd|, about 6u² of S for
#     like-signed values whatever n is, and exact when every reciprocal is (sums that cancel to 0 included).
#   - A tier decides: |S| < 10^-30 when |S_dd| + E, rounded up, lies at or below the double below 1e-30; |S| > 10^-30
#     when |S_dd| − E, rounded down, reaches the double 1e-30 (above 10^-30 by 0.476 ulp); then, with E/|S| ≤ 2^-60,
#     1/S by kimiya's quotient steps (13.12u² on 1/S_dd), whose ends at ε = y₀·(E_rel·(1 + 2^-30) + 2^-101) bracket
#     1/S: equal ends are RN(1/S). Otherwise the next tier runs.
#   - T3, the exact path, takes what neither decides: a sum near 10^-30, a cancellation below the bounds, a value within
#     about 2^-101 of a midpoint (ties among them), or slow = 1.
#
# Exact path. Each finite xᵢ is ±Mᵢ·2^Eᵢ with Mᵢ odd, so S = 2^-G·Σ ±2^(G−Eᵢ)/Mᵢ, G the largest Eᵢ. The terms are sorted
# by M (a heapsort: the order is total, the result exact and so deterministic), each group's dyadic sum A_g (positive
# and negative parts) is formed in integers, and the groups fold into one fraction N/D, D = Π M_g over the distinct
# M_g: N/D + A_g/M_g = (N·M_g + A_g·D)/(D·M_g), N kept as its positive and negative parts. A group of equal Mᵢ adds
# no factor, so [3, −3, 3, −3, …] stays small; n distinct significands make D 53n bits and the fold quadratic in n (a
# finding, recorded; only sums the fast path cannot decide come here). |S| = X/(D·2^G) with X = |N|, so |S| < 10^-30
# is X·5^30·2^30 < D·2^G, and the candidate for 1/|S| = D·2^G/X comes from the two integers' top 62 bits (within 3.1u);
# the neighbouring midpoints μ = m·2^f then decide, D·2^G against m·X·2^f, ties to even. The buffers, sized from n and
# the group count, come from fl_calloc and go back by fl_free; a refused allocation returns 2 (BJ_ERR_ALLOCATION).
# cr_verify.py's par and par_slow families check both paths against Python's Fraction, on x86_64 and aarch64.

# Word i of the sort's triples (M, E, sign) at t.
#must_use
fn _bj_e_par_key(t, i): i64 { return load64(t + 24 * i); }

# Swaps triples i and j at t.
fn _bj_e_par_swap(t, i, j) {
    for (var k = 0; k < 3; k = k + 1) {
        var a = load64(t + 24 * i + 8 * k);
        store64(t + 24 * i + 8 * k, load64(t + 24 * j + 8 * k));
        store64(t + 24 * j + 8 * k, a);
    }
    return 0;
}

# Sifts triple `root` down the max-heap t[0..end) on M.
fn _bj_e_par_sift(t, root, end) {
    var r = root;
    while (2 * r + 1 < end) {
        var c = 2 * r + 1;
        if (c + 1 < end && _bj_e_par_key(t, c) < _bj_e_par_key(t, c + 1)) { c = c + 1; }
        if (_bj_e_par_key(t, r) >= _bj_e_par_key(t, c)) { return 0; }
        _bj_e_par_swap(t, r, c);
        r = c;
    }
    return 0;
}

# Heapsorts the m triples at t by M, ascending.
fn _bj_e_par_sort(t, m) {
    var s = m / 2 - 1;
    while (s >= 0) {
        _bj_e_par_sift(t, s, m);
        s = s - 1;
    }
    var e = m - 1;
    while (e > 0) {
        _bj_e_par_swap(t, 0, e);
        _bj_e_par_sift(t, 0, e);
        e = e - 1;
    }
    return 0;
}

# The top 62 bits of the nonzero bignum a as an integer, its shift into sh[0] (a = top·2^sh, truncated); t scratch.
#must_use
fn _bj_e_par_top(a, t, sh: *i64): i64 {
    _bj_bn_copy(t, a);
    var b = _bj_g_bitlen(t);
    var s = 0;
    if (b > 62) {
        s = b - 62;
        _bj_bn_shr(t, s);
    }
    sh[0] = s;
    return _bj_g_limb(t, 0) + (_bj_g_limb(t, 1) << 32);
}

# The sign of D·2^G − m·2^f·X (the exact path's midpoint test); t1, t2 and t3 scratch bignums.
#must_use
fn _bj_e_par_mid(d, x, g, mm, f, t1, t2, t3): i64 {
    _bj_bn_copy(t1, x);
    _bj_g_mul(t1, mm, t3);
    _bj_bn_copy(t2, d);
    if (g >= f) { _bj_bn_shl(t2, g - f); } else { _bj_bn_shl(t1, f - g); }
    var c = _bj_bn_cmp(t2, t1);
    return c;
}

# The exact path (the section comment): 1 when |Σ 1/xᵢ| < 10^-30, 0 with out[0] := RN(1/Σ 1/xᵢ), 2 when a buffer is
# refused.
fn _bj_e_par_exact(xs: *f64, n, out: *f64): i64 {
    var m = 0;
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = xs[i];
        if (_bj_is_finite(x) == 1) { m = m + 1; }
    }
    if (m == 0) { return 1; }
    var tr = fl_calloc(24 * m);
    if (tr == 0) { return 2; }
    var me[16];
    var j = 0;
    var gmax = 0 - 2000;
    for (var i2 = 0; i2 < n; i2 = i2 + 1) {
        var x2: f64 = xs[i2];
        if (_bj_is_finite(x2) == 0) { continue; }
        _bj_g_split(x2, &me);
        var mm = load64(&me);
        var ee = load64(&me + 8);
        while ((mm & 1) == 0) {
            mm = mm >> 1;
            ee = ee + 1;
        }
        store64(tr + 24 * j, mm);
        store64(tr + 24 * j + 8, ee);
        store64(tr + 24 * j + 16, (_bj_bits(x2) >> 63) & 1);
        if (ee > gmax) { gmax = ee; }
        j = j + 1;
    }
    _bj_e_par_sort(tr, m);
    var ng = 1;
    for (var i3 = 1; i3 < m; i3 = i3 + 1) {
        if (_bj_e_par_key(tr, i3) != _bj_e_par_key(tr, i3 - 1)) { ng = ng + 1; }
    }
    var wb = 8 * ((53 * ng + 3700) / 32 + 8);      # bytes of a big buffer: D, the parts, their shifts and products
    var wa = 8 * (2300 / 32 + 8);                    # a group's dyadic sum (below 2^2100·n)
    var pp = fl_calloc(wb);
    var qq = fl_calloc(wb);
    var dd = fl_calloc(wb);
    var t1 = fl_calloc(wb);
    var t2 = fl_calloc(wb);
    var t3 = fl_calloc(wb);
    var ap = fl_calloc(wa);
    var an = fl_calloc(wa);
    var w = fl_calloc(wa);
    var res = 0;
    if (pp == 0 || qq == 0 || dd == 0 || t1 == 0 || t2 == 0 || t3 == 0 || ap == 0 || an == 0 || w == 0) { res = 2; }
    if (res == 0) {
        _bj_bn_set(dd, 1);
        store64(pp, 0);
        store64(qq, 0);
        var k = 0;
        while (k < m) {
            var mg = _bj_e_par_key(tr, k);
            store64(ap, 0);
            store64(an, 0);
            while (k < m && _bj_e_par_key(tr, k) == mg) {
                _bj_bn_set(w, 1);
                _bj_bn_shl(w, gmax - load64(tr + 24 * k + 8));
                if (load64(tr + 24 * k + 16) == 0) { _bj_g_add_to(ap, w); } else { _bj_g_add_to(an, w); }
                k = k + 1;
            }
            _bj_g_mul(pp, mg, t1);                   # N/D + A/M = (N·M + A·D)/(D·M)
            _bj_g_mul(qq, mg, t1);
            if (load64(ap) != 0) {
                _bj_e_bn_mul(t2, ap, dd);
                _bj_g_add_to(pp, t2);
            }
            if (load64(an) != 0) {
                _bj_e_bn_mul(t2, an, dd);
                _bj_g_add_to(qq, t2);
            }
            _bj_g_mul(dd, mg, t1);
        }
        var c = _bj_bn_cmp(pp, qq);
        var neg = 0;
        var xx = pp;
        if (c > 0) { _bj_bn_sub(pp, qq); }
        if (c < 0) {
            _bj_bn_sub(qq, pp);
            xx = qq;
            neg = 1;
        }
        if (c == 0) { res = 1; }
        if (res == 0) {
            _bj_bn_copy(t1, xx);                     # |S| < 10^-30: X·5^30·2^30 < D·2^G
            _bj_g_mul(t1, 30517578125, t3);
            _bj_g_mul(t1, 30517578125, t3);
            _bj_bn_copy(t2, dd);
            if (gmax >= 30) { _bj_bn_shl(t2, gmax - 30); } else { _bj_bn_shl(t1, 30 - gmax); }
            if (_bj_bn_cmp(t1, t2) < 0) { res = 1; }
        }
        if (res == 0) {
            var sd: i64[1];
            var sx: i64[1];
            var td = _bj_e_par_top(dd, t1, &sd);
            var tx = _bj_e_par_top(xx, t1, &sx);
            var fd: f64 = f64_from(td);
            var fx: f64 = f64_from(tx);
            var y0: f64 = fd / fx;
            var y: f64 = _bj_g_scale(y0, gmax + sd[0] - sx[0]);
            var mid[16];
            for (var it = 0; it < 6; it = it + 1) {
                var up: f64 = _bj_g_step(y, 1);
                _bj_g_mid(y, up, &mid);
                var c1 = _bj_e_par_mid(dd, xx, gmax, load64(&mid), load64(&mid + 8), t1, t2, t3);
                if (c1 > 0) {
                    y = up;
                    continue;
                }
                if (c1 == 0) {
                    y = _bj_g_even(y, up);
                    break;
                }
                var dn: f64 = _bj_g_step(y, 0 - 1);
                _bj_g_mid(dn, y, &mid);
                var c2 = _bj_e_par_mid(dd, xx, gmax, load64(&mid), load64(&mid + 8), t1, t2, t3);
                if (c2 < 0) {
                    y = dn;
                    continue;
                }
                if (c2 == 0) { y = _bj_g_even(dn, y); }
                break;
            }
            if (neg == 1) { y = -y; }
            out[0] = y;
        }
    }
    if (pp != 0) { fl_free(pp); }
    if (qq != 0) { fl_free(qq); }
    if (dd != 0) { fl_free(dd); }
    if (t1 != 0) { fl_free(t1); }
    if (t2 != 0) { fl_free(t2); }
    if (t3 != 0) { fl_free(t3); }
    if (ap != 0) { fl_free(ap); }
    if (an != 0) { fl_free(an); }
    if (w != 0) { fl_free(w); }
    fl_free(tr);
    return res;
}

# (h, l) := the top two components of the nonoverlapping expansion ex[0..k) (k ≥ 1, increasing magnitude) after
# Shewchuk's Compress, within 2^-104 of the sum, relative: src/crmath_gamma.cyr's _bj_g_compress with the caller's
# scratch g (k doubles) in place of its sixteen. ex is overwritten.
#must_use
fn _bj_e_compress(ex: *f64, k, g: *f64): (f64, f64) {
    var q0: f64 = ex[k - 1];
    var bottom = k - 1;
    var i = k - 2;
    while (i >= 0) {
        var e: f64 = ex[i];
        var ss: f64 = q0 + e;                       # FastTwoSum(q0, e)
        var rr: f64 = e - (ss - q0);
        if (rr != 0.0) {
            g[bottom] = ss;
            bottom = bottom - 1;
            q0 = rr;
        } else {
            q0 = ss;
        }
        i = i - 1;
    }
    g[bottom] = q0;
    var top = 0;
    var q1: f64 = g[bottom];
    for (var m = bottom + 1; m < k; m = m + 1) {
        var gm: f64 = g[m];
        var s2: f64 = gm + q1;                      # FastTwoSum(gm, q1)
        var r2: f64 = q1 - (s2 - gm);
        if (r2 != 0.0) {
            ex[top] = r2;
            top = top + 1;
        }
        q1 = s2;
    }
    var lo: f64 = 0.0;
    if (top > 0) { lo = ex[top - 1]; }
    var h: f64 = q1 + lo;
    var l: f64 = lo - (h - q1);
    return (h, l);
}

# A tier's verdict from S_dd = s_h + s_l within E of S (the section comment): 1 when |S| < 10^-30, 0 with out[0] :=
# RN(1/S), −1 when the bound cannot decide.
#must_use
fn _bj_e_par_decide(s_h: f64, s_l: f64, eab: f64, out: *f64): i64 {
    var a: f64 = f64_abs(s_h);
    var em: f64 = eab * 1.0000001;
    var m48: f64 = 0x3CF0000000000000;              # 2^-48
    var hiv: f64 = (a + em) * (1.0 + m48);
    var lov: f64 = (a - em) * (1.0 - m48);
    var c_lo: f64 = 0x39B4484BFEEBC29F;             # the double below 1e-30 (below 10^-30)
    var c_hi: f64 = 0x39B4484BFEEBC2A0;             # 1e-30 (above 10^-30)
    if (hiv <= c_lo) { return 1; }
    if (lov < c_hi) { return 0 - 1; }
    var erel: f64 = (em / lov) * (1.0 + m48);
    var l60: f64 = 0x3C30000000000000;              # 2^-60
    if (erel > l60) { return 0 - 1; }
    var ah: f64 = a;                                # |S_dd| = a_h + a_l
    var al: f64 = s_l;
    if (s_h < 0.0) { al = -s_l; }
    var sp: f64 = 134217729.0;
    var y0: f64 = 1.0 / ah;                         # kimiya's quotient steps for 1/(a_h + a_l), inline
    var pa: f64 = y0 * ah;
    var cy: f64 = sp * y0;
    var yh: f64 = cy - (cy - y0);
    var yl: f64 = y0 - yh;
    var ca: f64 = sp * ah;
    var ahh: f64 = ca - (ca - ah);
    var ahl: f64 = ah - ahh;
    var pb: f64 = (yl * ahl) - (((pa - (yh * ahh)) - (yl * ahh)) - (yh * ahl));
    var s0: f64 = 1.0 - pa;
    var s1: f64 = s0 - pb;
    var s3: f64 = y0 * al;
    var rr: f64 = s1 - s3;
    var d: f64 = rr / ah;
    var g30: f64 = 0x3E10000000000000;              # 2^-30
    var k101: f64 = 0x39A0000000000000;             # 2^-101
    var eps: f64 = y0 * ((erel * (1.0 + g30)) + k101);
    var lo: f64 = d - eps;
    var hi: f64 = d + eps;
    var z1: f64 = y0 + lo;
    var z2: f64 = y0 + hi;
    if (z1 != z2) { return 0 - 1; }
    var res: f64 = z1;
    if (s_h < 0.0) { res = -z1; }
    out[0] = res;
    return 0;
}

# The parallel combination (the section comment) of the n values at xs (none NaN; each finite one |xᵢ| ≥ 10^-30): 1
# when |Σ 1/xᵢ| < 10^-30 exactly; 0 with out[0] := RN(1/Σ 1/xᵢ); 2 when the exact path's buffers are refused. slow = 1
# runs the exact path alone, slow = 2 the expansion and then the exact path (cr_verify.py's par_slow and par_x).
#must_use
fn _bj_cr_parallel(xs: *f64, n, slow, out: *f64): i64 {
    var sp: f64 = 134217729.0;                      # Veltkamp's 2^27 + 1
    var big: f64 = 0x7830000000000000;              # 2^900
    var u2: f64 = 0x3950000000000000;               # 2^-106
    var u1: f64 = 0x3CA0000000000000;               # 2^-53
    var tiny: f64 = _bj_from_bits(1);               # 2^-1074
    if (slow == 0) {
        var sg: f64 = 0.0;                          # Σ (qᵢ + lᵢ) = σ + c: TwoSums of the heads, their errors and the
        var cc: f64 = 0.0;                          # lows added to c, g = Σ(|w| + |c|) bounding c's roundings
        var gb: f64 = 0.0;
        var lsum: f64 = 0.0;
        var tsum: f64 = 0.0;
        var tcnt = 0;
        for (var i = 0; i < n; i = i + 1) {
            var x: f64 = xs[i];
            var dz: f64 = x - x;
            if (dz != 0.0) { continue; }            # ±∞: 1/x = ±0
            var q: f64 = 1.0 / x;
            var ax: f64 = f64_abs(x);
            var l: f64 = 0.0;
            if (ax < big) {
                var p: f64 = q * x;                 # q·x = p + e (TwoProduct, inline), r = (1 − p) − e exactly
                var cq: f64 = sp * q;
                var qh: f64 = cq - (cq - q);
                var ql: f64 = q - qh;
                var cx: f64 = sp * x;
                var xh: f64 = cx - (cx - x);
                var xl: f64 = x - xh;
                var e: f64 = ((((qh * xh) - p) + (qh * xl)) + (ql * xh)) + (ql * xl);
                var r0: f64 = 1.0 - p;
                var r: f64 = r0 - e;
                if (r != 0.0) {
                    l = r * q;
                    var aq: f64 = f64_abs(q);
                    lsum = lsum + aq;
                }
            } else {
                var aq2: f64 = f64_abs(q);
                tsum = tsum + aq2;
                tcnt = tcnt + 1;
            }
            var s1: f64 = sg + q;                   # TwoSum(σ, q)
            var bb: f64 = s1 - sg;
            var t: f64 = (sg - (s1 - bb)) + (q - bb);
            sg = s1;
            var w: f64 = t + l;
            cc = cc + w;
            var aw: f64 = f64_abs(w);
            var ac: f64 = f64_abs(cc);
            gb = (gb + aw) + ac;
        }
        var fh: f64 = sg + cc;                      # TwoSum(σ, c): S_dd
        var fb: f64 = fh - sg;
        var fl: f64 = (sg - (fh - fb)) + (cc - fb);
        var tc: f64 = f64_from(tcnt);
        var e1: f64 = 1.01 * u1 * gb;
        var e2: f64 = 2.03 * u2 * lsum;
        var e3: f64 = 1.01 * ((u1 * tsum) + (tc * tiny));
        var eab: f64 = (e1 + e2) + e3;
        var v1 = _bj_e_par_decide(fh, fl, eab, out);
        if (v1 >= 0) { return v1; }
    }
    if (slow != 1) {
        var ex: f64[256];                           # the expansion of every qᵢ and lᵢ, exact (Grow-Expansion)
        var k = 0;
        var lsum2: f64 = 0.0;
        var tsum2: f64 = 0.0;
        var tcnt2 = 0;
        var room = 1;
        for (var i2 = 0; i2 < n && room == 1; i2 = i2 + 1) {
            var x2: f64 = xs[i2];
            var dz2: f64 = x2 - x2;
            if (dz2 != 0.0) { continue; }
            var q2: f64 = 1.0 / x2;
            var ax2: f64 = f64_abs(x2);
            var l2: f64 = 0.0;
            if (ax2 < big) {
                var p2: f64 = q2 * x2;
                var cq2: f64 = sp * q2;
                var qh2: f64 = cq2 - (cq2 - q2);
                var ql2: f64 = q2 - qh2;
                var cx2: f64 = sp * x2;
                var xh2: f64 = cx2 - (cx2 - x2);
                var xl2: f64 = x2 - xh2;
                var e2x: f64 = ((((qh2 * xh2) - p2) + (qh2 * xl2)) + (ql2 * xh2)) + (ql2 * xl2);
                var r2: f64 = (1.0 - p2) - e2x;
                if (r2 != 0.0) {
                    l2 = r2 * q2;
                    var aq3: f64 = f64_abs(q2);
                    lsum2 = lsum2 + aq3;
                }
            } else {
                var aq4: f64 = f64_abs(q2);
                tsum2 = tsum2 + aq4;
                tcnt2 = tcnt2 + 1;
            }
            if (k > 252) {
                room = 0;
                continue;
            }
            k = _bj_g_grow(&ex, k, q2);
            if (l2 != 0.0) { k = _bj_g_grow(&ex, k, l2); }
        }
        if (room == 1) {
            var gh: f64 = 0.0;
            var gl: f64 = 0.0;
            if (k > 0) {
                var gs: f64[256];
                var ch, cl = _bj_e_compress(&ex, k, &gs);
                gh = ch;
                gl = cl;
            }
            var tc2: f64 = f64_from(tcnt2);
            var f2: f64 = 2.03 * u2 * lsum2;
            var f3: f64 = 1.01 * ((u1 * tsum2) + (tc2 * tiny));
            var agh: f64 = f64_abs(gh);
            var f4: f64 = 4.01 * u2 * agh;          # Compress's 2^-104
            var eab2: f64 = (f2 + f3) + f4;
            var v2 = _bj_e_par_decide(gh, gl, eab2, out);
            if (v2 >= 0) { return v2; }
        }
    }
    var rx = _bj_e_par_exact(xs, n, out);
    return rx;
}

# --- log.cyr ---

# log.cyr — bijli's logging: Rust's `tracing` sites and `logging::init` on sakshi (port of rust-old/src/logging.rs).
#
# Rust 1.2.0 emits through `tracing` (39 debug!, 15 warn!, 4 error!, 4 trace!), which prints nothing until the
# consumer installs a subscriber; `bijli::logging::init()` installs one filtered by the `BIJLI_LOG` environment
# variable, else "info". The port keeps that:
# - bijli's own gate, `_bj_log_level`, starts OFF (−1): a consumer that never calls bj_log_init sees nothing, as a
#   Rust consumer with no subscriber;
# - bj_log_init sets the gate from BIJLI_LOG, else from its default, once (Rust's `try_init`: the first
#   subscriber stays), and raises sakshi's process-wide level to it when sakshi's is lower, so bijli's events
#   reach sakshi's output. It never lowers sakshi's level: other libraries' logging is not bijli's to silence
#   (Rust's subscriber filters every crate; ADR 0002 row 8);
# - BIJLI_LOG takes a level (`off`, `error`, `warn`, `info`, `debug`, `trace`, any case, or `0`–`5`) or a
#   comma-separated list of directives, of which bare levels and `bijli=<level>` apply, the last one winning.
#   Other targets' directives are ignored, and a value with none that applies falls back to the default, as
#   `EnvFilter::try_from_env` falls back on an invalid value (ADR 0002 row 8: not EnvFilter's whole grammar).
# Each helper tests the gate before it touches the message, so a disabled site costs one compare (prakash measured
# strlen first at 28–37 ns and the level first at 7 ns). Sites that format values test `_bj_log_on(level)`, then
# write into a stack BjText (src/fmtf.cyr) and emit it with `_bj_log_text`.
# The levels are sakshi's: SK_ERROR 1, SK_WARN 2, SK_INFO 3, SK_DEBUG 4, SK_TRACE 5; −1 is off.

private

# bijli's gate: events above it are dropped before sakshi sees them. −1: off.
var _bj_log_level = 0 - 1;

# 1 once bj_log_init has run (the first call decides, as Rust's `try_init`).
var _bj_log_inited = 0;

# The lowercase of ASCII byte c.
#must_use
fn _bj_log_lower(c): i64 {
    if (c >= 65 && c <= 90) { return c + 32; }
    return c;
}

# 1 when [p, p + n) is the lowercase word w, compared without case.
#must_use
fn _bj_log_word_is(p, n, w): i64 {
    if (n != strlen(w)) { return 0; }
    for (var i = 0; i < n; i = i + 1) {
        if (_bj_log_lower(load8(p + i)) != load8(w + i)) { return 0; }
    }
    return 1;
}

# The level a level name [p, p + n) names: −1 for off, 1–5 for error … trace, −2 for no level.
#must_use
fn _bj_log_level_of(p, n): i64 {
    if (n == 1) {
        var c = load8(p);
        if (c == 48) { return 0 - 1; }
        if (c >= 49 && c <= 53) { return c - 48; }
        return 0 - 2;
    }
    if (_bj_log_word_is(p, n, "off") == 1) { return 0 - 1; }
    if (_bj_log_word_is(p, n, "error") == 1) { return 1; }
    if (_bj_log_word_is(p, n, "warn") == 1) { return 2; }
    if (_bj_log_word_is(p, n, "info") == 1) { return 3; }
    if (_bj_log_word_is(p, n, "debug") == 1) { return 4; }
    if (_bj_log_word_is(p, n, "trace") == 1) { return 5; }
    return 0 - 2;
}

# The level a filter string sets for bijli (see the header), or −2 when none of its directives applies or s is 0.
#must_use
public fn _bj_log_parse(s): i64 {
    if (s == 0) { return 0 - 2; }
    var lv = 0 - 2;
    var n = strlen(s);
    var at = 0;
    while (at <= n) {
        var end = at;
        while (end < n && load8(s + end) != 44) { end = end + 1; }
        var a = at;
        var b = end;
        while (a < b && load8(s + a) == 32) { a = a + 1; }
        while (b > a && load8(s + b - 1) == 32) { b = b - 1; }
        var eq = a;
        while (eq < b && load8(s + eq) != 61) { eq = eq + 1; }
        if (eq == b) {
            var l1 = _bj_log_level_of(s + a, b - a);
            if (l1 != 0 - 2) { lv = l1; }
        } elif (eq - a == 5 && memeq(s + a, "bijli", 5) == 1) {
            var l2 = _bj_log_level_of(s + eq + 1, b - eq - 1);
            if (l2 != 0 - 2) { lv = l2; }
        }
        at = end + 1;
    }
    return lv;
}

# Installs bijli's logging with `default_level` (a level name, as BIJLI_LOG takes) when BIJLI_LOG is unset or
# sets nothing for bijli; an unreadable default is "info". Once only: a later call changes nothing. Mirrors
# `bijli::logging::init_with_level`.
public fn bj_log_init_with_level(default_level): i64 {
    if (_bj_log_inited == 1) { return 0; }
    _bj_log_inited = 1;
    var lv = _bj_log_parse(getenv("BIJLI_LOG"));
    if (lv == 0 - 2) { lv = _bj_log_parse(default_level); }
    if (lv == 0 - 2) { lv = 3; }
    _bj_log_level = lv;
    if (lv > sakshi_get_level()) { sakshi_set_level(lv); }
    return 0;
}

# Installs bijli's logging at BIJLI_LOG's level, else "info". Mirrors `bijli::logging::init`.
public fn bj_log_init(): i64 {
    return bj_log_init_with_level("info");
}

# Sets bijli's gate directly (−1 off, 1 error … 5 trace), leaving sakshi's own level alone: for a consumer that
# configures sakshi itself.
public fn bj_set_log_level(level): i64 {
    _bj_log_level = level;
    return 0;
}

# bijli's gate (−1 off, 1 error … 5 trace).
#must_use
public fn bj_log_level(): i64 {
    return _bj_log_level;
}

# 1 when an event at `level` passes bijli's gate: test it before formatting a message.
#must_use
public fn _bj_log_on(level): i64 {
    if (level <= _bj_log_level) { return 1; }
    return 0;
}

# Emits the C string msg at `level` through sakshi, when the gate passes it.
public fn _bj_log(level, msg): i64 {
    if (level > _bj_log_level) { return 0; }
    var n = strlen(msg);
    if (level == 1) { sakshi_error(msg, n); }
    elif (level == 2) { sakshi_warn(msg, n); }
    elif (level == 3) { sakshi_info(msg, n); }
    elif (level == 4) { sakshi_debug(msg, n); }
    else { sakshi_trace(msg, n); }
    return 0;
}

# Emits a BjText's contents at `level` (the gate tested again, so a caller may skip `_bj_log_on`).
public fn _bj_log_text(level, t): i64 {
    if (level > _bj_log_level) { return 0; }
    return _bj_log(level, _bj_tx_ptr(t));
}

# Rust's `tracing::error!` with a fixed message.
public fn _bj_error(msg): i64 {
    if (_bj_log_level < 1) { return 0; }
    return _bj_log(1, msg);
}

# Rust's `tracing::warn!` with a fixed message.
public fn _bj_warn(msg): i64 {
    if (_bj_log_level < 2) { return 0; }
    return _bj_log(2, msg);
}

# Rust's `tracing::debug!` with a fixed message.
public fn _bj_debug(msg): i64 {
    if (_bj_log_level < 4) { return 0; }
    return _bj_log(4, msg);
}

# Rust's `tracing::trace!` with a fixed message.
public fn _bj_trace(msg): i64 {
    if (_bj_log_level < 5) { return 0; }
    return _bj_log(5, msg);
}

# --- error.cyr ---

# error.cyr — bijli's error codes and the per-thread last-error record (port of rust-old/src/error.rs).
#
# A fallible bijli function returns a value-form Result whose Err payload is one of the BJ_ERR_* codes:
# `var t, v = f(..); if (is_err_result(t) == 1) { .. v is the code .. }`. The golden token `E:InvalidParameter`
# is BJ_ERR_INVALID_PARAMETER: BJ_ERR_ + snake(variant). The values follow the Rust variant order and are
# append-only (the Cyrius form of #[non_exhaustive]); BJ_ERR_TRANSPORT (ADR 0002 row 7), BJ_ERR_ALLOCATION (row 9:
# where Rust aborts on a failed allocation, the port returns this) and BJ_ERR_DESERIALIZE (row 10: a JSON document
# the readers refuse, where Rust's serde_json returns its own error type) are Cyrius-only.
#
# Rust's variants carry data (`DimensionMismatch { expected, got }`, `InvalidPermittivity { value }`, the
# `reason` and `context` strings, mostly `format!`ed with the caller's values). A one-word Result can't hold it,
# so the code that makes an error also fills the calling thread's LAST-ERROR RECORD (ADR 0002 row 4): the code,
# the variant's fields, and Rust's Display text of the error byte for byte (`e.to_string()`, with f64 fields in
# Rust's shortest form through src/fmtf.cyr). bj_last_error_* read it back. A later error on the same thread
# replaces it; a success leaves it alone (as errno). Nothing is lost, nothing is logged (Rust logs no error),
# and nothing allocates per error.
#
# Where the record lives. Cyrius has no thread-local variables; lib/thread_local.cyr gives slots in a per-thread
# block, which on Linux the main thread has only once someone calls thread_local_init, and whose slot numbers are
# claimed once (thread_local_alloc). So:
# - on Linux the main thread (tid = pid) uses a static record, and needs no block; elsewhere (Windows, macOS) every
#   thread has a block, the main one included, and keeps its record in the slot like the others;
# - every other thread keeps a pointer to its own record, from fl_alloc (thread-safe since 6.5.19), in one slot
#   bijli claims on first use; bj_init claims it early, on the main thread before any worker starts, as
#   thread_local.cyr's contract asks of a library; bj_thread_done gives a worker's record back;
# - without a slot (the 112 library slots used up), or in thread_local.cyr's foreign mode (one slot array for
#   one glibc thread), every thread shares the static record.
#
# Making an error, inside bijli: `return Err(_bj_err_singularity());`, or for a formatted reason
#     var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
#     _bj_tx_cstr(t, "frequency must be positive, got ");
#     _bj_fmt_f64_display(t, frequency);
#     return Err(BJ_ERR_INVALID_PARAMETER);

private

public enum BjError {
    BJ_ERR_NONE = 0;
    BJ_ERR_DIMENSION_MISMATCH = 1;
    BJ_ERR_ZERO_CHARGE = 2;
    BJ_ERR_SINGULARITY = 3;
    BJ_ERR_INSUFFICIENT_RESOLUTION = 4;
    BJ_ERR_INVALID_PERMITTIVITY = 5;
    BJ_ERR_INVALID_PERMEABILITY = 6;
    BJ_ERR_DIVISION_BY_ZERO = 7;
    BJ_ERR_INVALID_PARAMETER = 8;
    BJ_ERR_TRANSPORT = 9;
    BJ_ERR_ALLOCATION = 10;
    BJ_ERR_DESERIALIZE = 11;
}

# ── the record ──────────────────────────────────────────────────────────────────────
# Words: 0 the code; 8 and 16 the integer fields (expected and got, or cells); 24 the f64 field (value, or
# domain_size) as bits; 32 the byte offset of the reason or context inside the text, −1 when the variant has
# none; 40–56 the text's BjText header (src/fmtf.cyr). The text, NUL-terminated, from byte 64.
const _BJ_ERR_REC = 2112;
const _BJ_ERR_TEXT = 64;
const _BJ_ERR_CAP = 2048;

# The static record: the Linux main thread's, and every thread's when there is no slot.
var _bj_err_static[2112];

# The thread_local slot holding a thread's record pointer: −1 until claimed, and −1 for good when none was left.
var _bj_err_slot = 0 - 1;

# The claim's once-gate (0 unclaimed, 1 claiming) and its published flag.
var _bj_err_gate = 0;
var _bj_err_ready = 0;

# Claims the slot once, from whichever thread gets there first; the others wait for it to be published.
fn _bj_err_claim(): i64 {
    if (_bj_err_ready == 1) { return _bj_err_slot; }
    if (atomic_cas(&_bj_err_gate, 0, 1) == 1) {
        _bj_err_slot = thread_local_alloc();
        atomic_store(&_bj_err_ready, 1);
    }
    while (atomic_load(&_bj_err_ready) == 0) { }
    return _bj_err_slot;
}

# r = an empty record: no error.
fn _bj_err_reset(r) {
    store64(r, BJ_ERR_NONE);
    store64(r + 8, 0);
    store64(r + 16, 0);
    store64(r + 24, 0);
    store64(r + 32, 0 - 1);
    _bj_tx_init(r + 40, r + _BJ_ERR_TEXT, _BJ_ERR_CAP);
    return 0;
}

# 1 when the calling thread uses the static record (see the header). On Linux, until thread_create has run
# (lib/atomic.cyr's `_threads_active`, armed before any child starts), the caller can only be the main thread, whose
# record is the static one whatever happens later: no slot, no syscall. Elsewhere the main thread keeps its record
# in the slot like any other, from the first call on, so the shortcut would switch records under it (the PE run
# of tests/error.tcyr's last_error_per_thread caught that).
#must_use
fn _bj_err_uses_static(): i64 {
    #ifdef CYRIUS_TARGET_LINUX
    if (_threads_active == 0) { return 1; }
    #endif
    if (_bj_err_claim() < 0) { return 1; }
    if (_tlocal_foreign == 1) { return 1; }
    #ifdef CYRIUS_TARGET_LINUX
    if (syscall(SYS_GETTID) == sys_getpid()) { return 1; }
    #endif
    return 0;
}

# The calling thread's record, made on first use.
#must_use
fn _bj_err_rec(): i64 {
    if (_bj_err_uses_static() == 1) {
        if (load64(&_bj_err_static + 40) == 0) { _bj_err_reset(&_bj_err_static); }
        return &_bj_err_static;
    }
    var r = thread_local_get(_bj_err_slot);
    if (r == 0) {
        r = fl_alloc(_BJ_ERR_REC);
        if (r == 0) {
            # No memory for this thread's record: share the static one rather than lose the error.
            if (load64(&_bj_err_static + 40) == 0) { _bj_err_reset(&_bj_err_static); }
            return &_bj_err_static;
        }
        _bj_err_reset(r);
        thread_local_set(_bj_err_slot, r);
    }
    return r;
}

# Starts recording error `code` on the calling thread: the record emptied, the code set, and the text's BjText
# returned for the Display text to be written into.
fn _bj_err_begin(code): i64 {
    var r = _bj_err_rec();
    _bj_err_reset(r);
    store64(r, code);
    return r + 40;
}

# ── making errors (bijli-internal) ──────────────────────────────────────────────────

# Records DimensionMismatch { expected, got } (usize fields); returns its code. Rust's text:
# "invalid field dimensions: expected {expected}D, got {got}D".
public fn _bj_err_dimension_mismatch(expected, got): i64 {
    var t = _bj_err_begin(BJ_ERR_DIMENSION_MISMATCH);
    store64(t - 32, expected);
    store64(t - 24, got);
    _bj_tx_cstr(t, "invalid field dimensions: expected ");
    _bj_tx_u64(t, expected);
    _bj_tx_cstr(t, "D, got ");
    _bj_tx_u64(t, got);
    _bj_tx_putc(t, 68);
    return BJ_ERR_DIMENSION_MISMATCH;
}

# Records ZeroCharge; returns its code.
public fn _bj_err_zero_charge(): i64 {
    var t = _bj_err_begin(BJ_ERR_ZERO_CHARGE);
    _bj_tx_cstr(t, "charge magnitude is zero — cannot compute field direction");
    return BJ_ERR_ZERO_CHARGE;
}

# Records Singularity; returns its code.
public fn _bj_err_singularity(): i64 {
    var t = _bj_err_begin(BJ_ERR_SINGULARITY);
    _bj_tx_cstr(t, "singularity: field evaluation at source point (distance = 0)");
    return BJ_ERR_SINGULARITY;
}

# Records InsufficientResolution { cells, domain_size }; returns its code. Rust's text:
# "grid resolution too coarse: {cells} cells for domain size {domain_size}".
public fn _bj_err_insufficient_resolution(cells, domain_size: f64): i64 {
    var t = _bj_err_begin(BJ_ERR_INSUFFICIENT_RESOLUTION);
    store64(t - 32, cells);
    store64(t - 16, _bj_bits(domain_size));
    _bj_tx_cstr(t, "grid resolution too coarse: ");
    _bj_tx_u64(t, cells);
    _bj_tx_cstr(t, " cells for domain size ");
    _bj_fmt_f64_display(t, domain_size);
    return BJ_ERR_INSUFFICIENT_RESOLUTION;
}

# Records InvalidPermittivity { value }; returns its code. Rust's text: "invalid permittivity: {value} (must be > 0)".
public fn _bj_err_invalid_permittivity(value: f64): i64 {
    var t = _bj_err_begin(BJ_ERR_INVALID_PERMITTIVITY);
    store64(t - 16, _bj_bits(value));
    _bj_tx_cstr(t, "invalid permittivity: ");
    _bj_fmt_f64_display(t, value);
    _bj_tx_cstr(t, " (must be > 0)");
    return BJ_ERR_INVALID_PERMITTIVITY;
}

# Records InvalidPermeability { value }; returns its code. Rust's text: "invalid permeability: {value} (must be > 0)".
public fn _bj_err_invalid_permeability(value: f64): i64 {
    var t = _bj_err_begin(BJ_ERR_INVALID_PERMEABILITY);
    store64(t - 16, _bj_bits(value));
    _bj_tx_cstr(t, "invalid permeability: ");
    _bj_fmt_f64_display(t, value);
    _bj_tx_cstr(t, " (must be > 0)");
    return BJ_ERR_INVALID_PERMEABILITY;
}

# Starts an error whose payload is a string, DivisionByZero { context }, InvalidParameter { reason } or the
# Cyrius-only Transport { reason }, Allocation { reason } and Deserialize { reason }: writes the Display text's prefix,
# marks where the string starts, and returns the BjText for the caller to write the string into. A code with no
# string payload gets no prefix.
public fn _bj_err_reason(code): i64 {
    var t = _bj_err_begin(code);
    if (code == BJ_ERR_DIVISION_BY_ZERO) { _bj_tx_cstr(t, "division by zero in EM calculation: "); }
    elif (code == BJ_ERR_INVALID_PARAMETER) { _bj_tx_cstr(t, "invalid parameter: "); }
    elif (code == BJ_ERR_TRANSPORT) { _bj_tx_cstr(t, "transport error: "); }
    elif (code == BJ_ERR_ALLOCATION) { _bj_tx_cstr(t, "allocation failed: "); }
    elif (code == BJ_ERR_DESERIALIZE) { _bj_tx_cstr(t, "deserialization failed: "); }
    else { return t; }
    store64(t - 8, _bj_tx_len(t));
    return t;
}

# Records DivisionByZero { context } with a fixed context; returns its code.
public fn _bj_err_division_by_zero(context): i64 {
    var t = _bj_err_reason(BJ_ERR_DIVISION_BY_ZERO);
    _bj_tx_cstr(t, context);
    return BJ_ERR_DIVISION_BY_ZERO;
}

# Records InvalidParameter { reason } with a fixed reason; returns its code.
public fn _bj_err_invalid_parameter(reason): i64 {
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, reason);
    return BJ_ERR_INVALID_PARAMETER;
}

# Records the Cyrius-only Transport { reason } (ADR 0002 row 7) with a fixed reason; returns its code.
public fn _bj_err_transport(reason): i64 {
    var t = _bj_err_reason(BJ_ERR_TRANSPORT);
    _bj_tx_cstr(t, reason);
    return BJ_ERR_TRANSPORT;
}

# ── the public API ──────────────────────────────────────────────────────────────────

# Claims bijli's thread-local slot now. Call it once on the main thread before starting threads that call
# bijli, as lib/thread_local.cyr asks of a library; without it the slot is claimed on the first error. Returns 1
# when threads get records of their own, 0 when they will share one (no slot was left).
public fn bj_init(): i64 {
    if (_bj_err_claim() < 0) { return 0; }
    return 1;
}

# Gives the calling worker thread's record back (call it before the thread ends, so a thread pool that churns
# threads does not keep one record per thread ever started). Its last error is forgotten. No effect on a thread
# that uses the static record.
public fn bj_thread_done(): i64 {
    if (_bj_err_uses_static() == 1) { return 0; }
    var r = thread_local_get(_bj_err_slot);
    if (r != 0) {
        thread_local_set(_bj_err_slot, 0);
        fl_free(r);
    }
    return 0;
}

# The calling thread's last error code, or BJ_ERR_NONE.
#must_use
public fn bj_last_error(): i64 {
    return load64(_bj_err_rec());
}

# The calling thread's last error as Rust's Display writes it (`e.to_string()`), NUL-terminated; "" for none.
# Valid until the thread's next error.
#must_use
public fn bj_last_error_display(): i64 {
    return _bj_err_rec() + _BJ_ERR_TEXT;
}

# The reason or context string of the last error when it has one (DivisionByZero, InvalidParameter, Transport,
# Allocation),
# NUL-terminated; "" otherwise.
#must_use
public fn bj_last_error_detail(): i64 {
    var r = _bj_err_rec();
    var at = load64(r + 32);
    if (at < 0) { return ""; }
    return r + _BJ_ERR_TEXT + at;
}

# DimensionMismatch's `expected` (0 for another error).
#must_use
public fn bj_last_error_expected(): i64 {
    var r = _bj_err_rec();
    if (load64(r) != BJ_ERR_DIMENSION_MISMATCH) { return 0; }
    return load64(r + 8);
}

# DimensionMismatch's `got` (0 for another error).
#must_use
public fn bj_last_error_got(): i64 {
    var r = _bj_err_rec();
    if (load64(r) != BJ_ERR_DIMENSION_MISMATCH) { return 0; }
    return load64(r + 16);
}

# InsufficientResolution's `cells` (0 for another error).
#must_use
public fn bj_last_error_cells(): i64 {
    var r = _bj_err_rec();
    if (load64(r) != BJ_ERR_INSUFFICIENT_RESOLUTION) { return 0; }
    return load64(r + 8);
}

# InsufficientResolution's `domain_size` (0 for another error).
#must_use
public fn bj_last_error_domain_size(): f64 {
    var r = _bj_err_rec();
    var v: f64 = 0.0;
    if (load64(r) == BJ_ERR_INSUFFICIENT_RESOLUTION) { v = load64(r + 24); }
    return v;
}

# InvalidPermittivity's or InvalidPermeability's `value` (0 for another error).
#must_use
public fn bj_last_error_value(): f64 {
    var r = _bj_err_rec();
    var c = load64(r);
    var v: f64 = 0.0;
    if (c == BJ_ERR_INVALID_PERMITTIVITY || c == BJ_ERR_INVALID_PERMEABILITY) { v = load64(r + 24); }
    return v;
}

# Forgets the calling thread's last error.
public fn bj_last_error_clear(): i64 {
    _bj_err_reset(_bj_err_rec());
    return 0;
}

# The Rust variant name of an error code (`"InvalidParameter"`), "None" for BJ_ERR_NONE, "Transport", "Allocation"
# and "Deserialize" for the Cyrius-only codes, or "Unknown" for a value that is no code.
#must_use
public fn bj_error_name(code): i64 {
    if (code == BJ_ERR_NONE) { return "None"; }
    if (code == BJ_ERR_DIMENSION_MISMATCH) { return "DimensionMismatch"; }
    if (code == BJ_ERR_ZERO_CHARGE) { return "ZeroCharge"; }
    if (code == BJ_ERR_SINGULARITY) { return "Singularity"; }
    if (code == BJ_ERR_INSUFFICIENT_RESOLUTION) { return "InsufficientResolution"; }
    if (code == BJ_ERR_INVALID_PERMITTIVITY) { return "InvalidPermittivity"; }
    if (code == BJ_ERR_INVALID_PERMEABILITY) { return "InvalidPermeability"; }
    if (code == BJ_ERR_DIVISION_BY_ZERO) { return "DivisionByZero"; }
    if (code == BJ_ERR_INVALID_PARAMETER) { return "InvalidParameter"; }
    if (code == BJ_ERR_TRANSPORT) { return "Transport"; }
    if (code == BJ_ERR_ALLOCATION) { return "Allocation"; }
    if (code == BJ_ERR_DESERIALIZE) { return "Deserialize"; }
    return "Unknown";
}

# The Rust error's Display text without its payload: thiserror's message up to the first field
# (`"invalid parameter"` for `invalid parameter: negative frequency`), the whole message for ZeroCharge and
# Singularity. "no error" for BJ_ERR_NONE and "unknown error" for a value that is no code.
#must_use
public fn bj_error_message(code): i64 {
    if (code == BJ_ERR_NONE) { return "no error"; }
    if (code == BJ_ERR_DIMENSION_MISMATCH) { return "invalid field dimensions"; }
    if (code == BJ_ERR_ZERO_CHARGE) { return "charge magnitude is zero — cannot compute field direction"; }
    if (code == BJ_ERR_SINGULARITY) { return "singularity: field evaluation at source point (distance = 0)"; }
    if (code == BJ_ERR_INSUFFICIENT_RESOLUTION) { return "grid resolution too coarse"; }
    if (code == BJ_ERR_INVALID_PERMITTIVITY) { return "invalid permittivity"; }
    if (code == BJ_ERR_INVALID_PERMEABILITY) { return "invalid permeability"; }
    if (code == BJ_ERR_DIVISION_BY_ZERO) { return "division by zero in EM calculation"; }
    if (code == BJ_ERR_INVALID_PARAMETER) { return "invalid parameter"; }
    if (code == BJ_ERR_TRANSPORT) { return "transport error"; }
    if (code == BJ_ERR_ALLOCATION) { return "allocation failed"; }
    if (code == BJ_ERR_DESERIALIZE) { return "deserialization failed"; }
    return "unknown error";
}

# --- complex.cyr ---

# complex.cyr — BjComplex, complex numbers by value, and bijli's one time convention.
#
# ── The time convention (ADR 0002 row 5, port plan §4.4) ────────────────────────────────────────────────────────
# Stated here once: every module's doc points here instead of carrying its own.
# - A time-harmonic quantity is the real part of a phasor times e^{+jωt}: a(t) = Re{A·e^{+jωt}}, with j = √−1
#   written as an engineer writes it. So a wave travelling toward +z is A·e^{−jkz}; an inductor's impedance is
#   +jωL and a capacitor's 1/(jωC); a lossy permittivity is ε' − jε'', and an absorbing index is n − jκ
#   (Im < 0). This is the convention of FDTD (Taflove & Hagness), RF (Pozar), antennas (Balanis) and Gaussian
#   beams (Siegman), and the one Touchstone files and Smith charts are defined in.
# - Circular polarization is named with IEEE handedness (IEEE Std 145): right-hand circular rotates with the
#   fingers of a right hand whose thumb points along the propagation (clockwise when the wave is viewed receding
#   from the observer). For a wave along +z, the right-hand circular Jones vector is (1, −j)/√2: at z = 0 its field
#   is x̂·cos ωt + ŷ·sin ωt, turning from x̂ to ŷ.
# - Rust bijli 1.2.0 mixed this with e^{−iωt} in polarization, beam, the field Green's function and the FDTD media.
#   The port uses the one convention everywhere: those modules' complex amplitudes are the oracle's conjugates
#   and their phases its negations, mapped exactly in the parity harness (ADR 0002 row 5).
#
# ── BjComplex ────────────────────────────────────────────────────────────────────────────────────────────────────
# Port of Rust hisab 1.4.0's `num::Complex`, which bijli 1.2.0 re-exports (`bijli::polarization::Complex`), and of
# polarization.rs's `complex_real` / `complex_zero` / `complex_from_polar` and `ComplexExt::norm`. Every operation
# is hisab's formula in hisab's order of operations (port plan §9.2), so each golden row compares bit for bit:
# no hypot rescue in `abs`, the textbook division, `sqrt` through polar form.
#
# Range edges (ADR 0002 row 14, the user's decision of 2026-11-12, kimiya ADR 0002 #20). Where a component leaves
# [2^-511, 2^511), re², a cross product or their sum can over- or underflow although the result is representable:
# abs(1e160, 1e160) is ∞, (1e200, 1e200)² has a real part ∞ − ∞ = NaN for 0, 1/(1e160, 0) is 0 for 1e-160. There hisab's
# chain is evaluated with an unbounded exponent (src/crmath_kx.cyr's _bj_k_ux_*: every operation rounded to 53 bits,
# nothing over- or underflowing) and its last operation rounded once into binary64 — abs, norm_sq, the product, inv, the
# quotient, is_zero's comparison, and sqrt's root and polar products. When every nonzero component lies in [2^-511,
# 2^511) no square or product leaves the normal range, so that evaluation IS hisab's in binary64, and the rows keep
# Rust's bits; a NaN or infinite component keeps hisab's chain as it is. ln and powf take |z| from the same evaluation
# (row 14). The chain's transcendental steps follow the same rule (ADR 0002 row 16, M1 part 5c-2): where e^re (exp),
# cosh and sinh of im (sin, cos), ln or pow of |z|, the power |z|^n, or an angle (sqrt's arg z / 2, powf's n·arg z)
# is not a normal double, it is taken to 53 bits with an unbounded exponent (src/crmath_ux.cyr) and each final product
# rounded once: exp(710 + j0) is (∞, 0) where hisab's is (∞, NaN), sin(j800) (0, ∞) for (NaN, ∞). powf has no cutoff
# (row 15): hisab returned 0 for every |z|² < 1e-300, whatever the exponent. The transcendentals are bijli's correctly
# rounded ones (src/mathx.cyr, src/crmath_ux.cyr), so the results are the same on every target and match the corrected
# oracle where glibc misrounds.
#
# A BjComplex is a 16-byte struct value: returned in two registers, passed by address and copied on entry. Rust's
# operators are the operator fns, `a + b`, `a - b`, `a * b`, `a / b`; with an f64 operand, `a.scale(s)` (Rust's
# `a * s` and `s * a`: the same two products) and `a.div_f64(s)`. A compound assignment is `a = a + b` (Cyrius
# refuses `+=` on a struct value; hisab's `+=` computes the same). `From<f64>` is BjComplex_from_real, `From<(f64,
# f64)>` is BjComplex_new, `Default` is BjComplex_default. `sin` and `cos` take bijli's correctly rounded sinh and
# cosh (src/crmath.cyr, M1 part 2d).

private

public struct BjComplex {
    re: f64;
    im: f64;
}

# ── the range edges (ADR 0002 row 14) ─────────────────────────────────────────────────────────────────────────────

# 1 when x is ±0 or 2^-511 ≤ |x| < 2^511: its square, and its product with any other such value, is normal (or
# exactly 0), and so is a sum of two of them, unless it is past DBL_MAX: < 2^1023.
#must_use
fn _bj_cx_ok(x: f64): i64 {
    var b = _bj_bits(x) & 0x7FFFFFFFFFFFFFFF;
    if (b == 0) { return 1; }
    var be = b >> 52;
    if (be >= 512 && be < 1534) { return 1; }
    return 0;
}

# 1 when hisab's chain on x and y is the unbounded one (both components in range), or must stay hisab's (one not
# finite); 0 at a range edge.
#must_use
fn _bj_cx_plain(x: f64, y: f64): i64 {
    var ex = (load64(&x) >> 52) & 0x7FF;
    var ey = (load64(&y) >> 52) & 0x7FF;
    if (((ex - 512) | (ey - 512) | (1533 - ex) | (1533 - ey)) >= 0) { return 1; }   # the common case: one test
    if (ex == 2047 || ey == 2047) { return 1; }
    if (_bj_cx_ok(x) == 1 && _bj_cx_ok(y) == 1) { return 1; }
    return 0;
}

# _bj_cx_plain for an operation on two complex values: hisab's chain when any of the four parts is not finite, or
# all are in range.
#must_use
fn _bj_cx_plain4(a: f64, b: f64, c: f64, d: f64): i64 {
    var ea = (load64(&a) >> 52) & 0x7FF;
    var eb = (load64(&b) >> 52) & 0x7FF;
    var ec = (load64(&c) >> 52) & 0x7FF;
    var ed = (load64(&d) >> 52) & 0x7FF;
    # the common case, every biased exponent in [512, 1533]: each difference below is ≥ 0, so their OR is (one test)
    var lo = (ea - 512) | (eb - 512) | (ec - 512) | (ed - 512);
    var hi = (1533 - ea) | (1533 - eb) | (1533 - ec) | (1533 - ed);
    if ((lo | hi) >= 0) { return 1; }
    if (ea == 2047 || eb == 2047 || ec == 2047 || ed == 2047) { return 1; }
    if (_bj_cx_ok(a) + _bj_cx_ok(b) + _bj_cx_ok(c) + _bj_cx_ok(d) == 4) { return 1; }
    return 0;
}

# x·y with an unbounded exponent, rounded to 53 bits: (s, e).
#must_use
fn _bj_cx_ux_mul(x: f64, y: f64): (f64, i64) {
    var xs, xe = _bj_k_ux_from(x);
    var ys, ye = _bj_k_ux_from(y);
    var s, e = _bj_k_ux_mul(xs, xe, ys, ye);
    return (s, e);
}

# x² + y², each operation with an unbounded exponent and rounded to 53 bits: (s, e).
#must_use
fn _bj_cx_ux_sumsq(x: f64, y: f64): (f64, i64) {
    var as2, ae2 = _bj_cx_ux_mul(x, x);
    var bs2, be2 = _bj_cx_ux_mul(y, y);
    var s, e = _bj_k_ux_add(as2, ae2, bs2, be2);
    return (s, e);
}

# |x + jy| with an unbounded exponent, to 53 bits: (s, e).
#must_use
fn _bj_cx_ux_abs(x: f64, y: f64): (f64, i64) {
    var s, e = _bj_cx_ux_sumsq(x, y);
    var rs, re2 = _bj_k_ux_sqrt(s, e);
    return (rs, re2);
}

# ── the transcendental range edges (ADR 0002 row 16) ──────────────────────────────────────────────────────────────

# arg z with an unbounded exponent, to 53 bits, given its binary64 value g: g itself when it is exact (im = ±0: ±0 or
# ±π) or normal and above 2^-1022 (binary64's rounding is then the 53-bit one); else im/re to 53 bits. An arg that
# small has re > 0 and |im/re| < 2^-1021, where atan2(im, re) = (im/re)(1 − δ) with δ < 2^-2042, while a quotient of
# two doubles that is not a 53-bit value lies at least 2^-107 (relative) from every 53-bit midpoint: both round alike.
#must_use
fn _bj_cx_arg_ux(g: f64, re: f64, im: f64): (f64, i64) {
    var gb = _bj_bits(g) & 0x7FFFFFFFFFFFFFFF;
    if (im == 0.0 || gb > 0x0010000000000000) {
        var s, e = _bj_k_ux_from(g);
        return (s, e);
    }
    var ys, ye = _bj_k_ux_from(im);
    var xs, xe = _bj_k_ux_from(re);
    var qs, qe = _bj_k_ux_div(ys, ye, xs, xe);
    return (qs, qe);
}

# z^n = from_polar(|z|^n, n·arg z) with an unbounded exponent, for the 53-bit |z| = as·2^ae (positive, normal) and a
# finite n: |z|^n by _bj_ux_pow, arg z by _bj_cx_arg_ux, their product n·arg to 53 bits, its cosine and sine, each
# polar product rounded once.
#must_use
fn _bj_cx_powf_edge(as: f64, ae, n: f64, g: f64, re: f64, im: f64): BjComplex {
    var ps, pe = _bj_ux_pow(as, ae, n);
    var gs, ge = _bj_cx_arg_ux(g, re, im);
    var ns, ne = _bj_k_ux_from(n);
    var ts, te = _bj_k_ux_mul(gs, ge, ns, ne);
    var cs, ce = _bj_vx_cos53(ts, te);
    var ss, se = _bj_vx_sin53(ts, te);
    var wr: f64 = _bj_k_ux_mul_f64(ps, pe, cs, ce);
    var wi: f64 = _bj_k_ux_mul_f64(ps, pe, ss, se);
    var w: BjComplex;
    w.re = wr;
    w.im = wi;
    return w;
}

# 1 when complex sin and cos keep hisab's chain: |im| ≤ 710 (cosh and sinh are normal, or sinh is im itself), or a part
# is not finite; 0 at an edge.
#must_use
fn _bj_cx_hyp_plain(re: f64, im: f64): i64 {
    var ib = _bj_bits(im) & 0x7FFFFFFFFFFFFFFF;
    if (ib <= 0x4086300000000000) { return 1; }                                 # |im| ≤ 710
    if (ib >= 0x7FF0000000000000) { return 1; }
    if ((_bj_bits(re) & 0x7FF0000000000000) == 0x7FF0000000000000) { return 1; }
    return 0;
}

# 1 when powf's binary64 chain is the unbounded one: |z|^n = r normal and above 2^-1022, arg z = g exact or above
# 2^-1022, and θ = g·n exactly 0 or normal and above 2^-1022 (every intermediate's rounding is then the 53-bit one);
# 0 at an edge.
#must_use
fn _bj_cx_powf_plain(r: f64, g: f64, theta: f64, n: f64, im: f64): i64 {
    var rb = _bj_bits(r) & 0x7FFFFFFFFFFFFFFF;
    if (rb <= 0x0010000000000000 || rb >= 0x7FF0000000000000) { return 0; }
    var gb = _bj_bits(g) & 0x7FFFFFFFFFFFFFFF;
    if (im != 0.0 && gb <= 0x0010000000000000) { return 0; }
    var tb = _bj_bits(theta) & 0x7FFFFFFFFFFFFFFF;
    if (tb == 0) {
        if (gb == 0 || n == 0.0) { return 1; }
        return 0;
    }
    if (tb <= 0x0010000000000000 || tb >= 0x7FF0000000000000) { return 0; }
    return 1;
}

# The product (ar + j·ai)(br + j·bi) at a range edge: hisab's chain with an unbounded exponent, each sum rounded once.
#must_use
fn _bj_cx_mul_edge(ar: f64, ai: f64, br: f64, bi: f64): BjComplex {
    var ps, pe = _bj_cx_ux_mul(ar, br);
    var qs, qe = _bj_cx_ux_mul(ai, bi);
    var r: f64 = _bj_k_ux_sub_f64(ps, pe, qs, qe);
    var us, ue = _bj_cx_ux_mul(ar, bi);
    var vs, ve = _bj_cx_ux_mul(ai, br);
    var i: f64 = _bj_k_ux_add_f64(us, ue, vs, ve);
    var z: BjComplex;
    z.re = r;
    z.im = i;
    return z;
}

# The quotient (ar + j·ai)/(br + j·bi) at a range edge: hisab's chain with an unbounded exponent, each quotient rounded
# once.
#must_use
fn _bj_cx_div_edge(ar: f64, ai: f64, br: f64, bi: f64): BjComplex {
    var ds, de = _bj_cx_ux_sumsq(br, bi);
    var ps, pe = _bj_cx_ux_mul(ar, br);
    var qs, qe = _bj_cx_ux_mul(ai, bi);
    var ns, ne = _bj_k_ux_add(ps, pe, qs, qe);
    var us, ue = _bj_cx_ux_mul(ai, br);
    var vs, ve = _bj_cx_ux_mul(ar, bi);
    var ms, me = _bj_k_ux_sub(us, ue, vs, ve);
    var r: f64 = _bj_k_ux_div_f64(ns, ne, ds, de);
    var i: f64 = _bj_k_ux_div_f64(ms, me, ds, de);
    var z: BjComplex;
    z.re = r;
    z.im = i;
    return z;
}

# re + j·im. Mirrors `Complex::new` (and `From<(f64, f64)>`).
#must_use
#pure
public fn BjComplex_new(re: f64, im: f64): BjComplex {
    var z: BjComplex;
    z.re = re;
    z.im = im;
    return z;
}

# re + j·0. Mirrors `Complex::from_real` (and `From<f64>`).
#must_use
#pure
public fn BjComplex_from_real(re: f64): BjComplex {
    var z: BjComplex;
    z.re = re;
    z.im = 0.0;
    return z;
}

# 0 + j·0. Mirrors `Complex::default`.
#must_use
#pure
public fn BjComplex_default(): BjComplex {
    var z: BjComplex;
    z.re = 0.0;
    z.im = 0.0;
    return z;
}

# r·e^{jθ} = (r·cos θ, r·sin θ). Mirrors `Complex::from_polar`.
#must_use
#pure
public fn BjComplex_from_polar(r: f64, theta: f64): BjComplex {
    var c: f64 = _bj_cos(theta);
    var s: f64 = _bj_sin(theta);
    var z: BjComplex;
    z.re = r * c;
    z.im = r * s;
    return z;
}

# a + b. Mirrors `Add for Complex` (and `+=`).
#must_use
#pure
public fn BjComplex_add(a: BjComplex, b: BjComplex): BjComplex {
    var z: BjComplex;
    z.re = a.re + b.re;
    z.im = a.im + b.im;
    return z;
}

# a − b. Mirrors `Sub for Complex` (and `-=`).
#must_use
#pure
public fn BjComplex_sub(a: BjComplex, b: BjComplex): BjComplex {
    var z: BjComplex;
    z.re = a.re - b.re;
    z.im = a.im - b.im;
    return z;
}

# a·b = (a.re·b.re − a.im·b.im, a.re·b.im + a.im·b.re), each product rounded (no fused multiply-add, as rustc
# compiles it); at a range edge with an unbounded exponent, the sum rounded once (ADR 0002 row 14). Mirrors
# `Mul for Complex` (and `*=`).
#must_use
#pure
public fn BjComplex_mul(a: BjComplex, b: BjComplex): BjComplex {
    if (_bj_cx_plain4(a.re, a.im, b.re, b.im) == 0) {
        var w: BjComplex = _bj_cx_mul_edge(a.re, a.im, b.re, b.im);
        return w;
    }
    var z: BjComplex;
    z.re = a.re * b.re - a.im * b.im;
    z.im = a.re * b.im + a.im * b.re;
    return z;
}

# a / b by the textbook formula: ((a.re·b.re + a.im·b.im)/d, (a.im·b.re − a.re·b.im)/d), d = b.re² + b.im²; at a
# range edge with an unbounded exponent, each quotient rounded once (ADR 0002 row 14). Mirrors `Div for Complex`.
#must_use
#pure
public fn BjComplex_div(a: BjComplex, b: BjComplex): BjComplex {
    if (_bj_cx_plain4(a.re, a.im, b.re, b.im) == 0) {
        var w: BjComplex = _bj_cx_div_edge(a.re, a.im, b.re, b.im);
        return w;
    }
    var d: f64 = b.re * b.re + b.im * b.im;
    var z: BjComplex;
    z.re = (a.re * b.re + a.im * b.im) / d;
    z.im = (a.im * b.re - a.re * b.im) / d;
    return z;
}

# −a. Mirrors `Neg for Complex`.
#must_use
#pure
public fn BjComplex_neg(a: BjComplex): BjComplex {
    var z: BjComplex;
    z.re = -a.re;
    z.im = -a.im;
    return z;
}

impl BjComplex {
    # √(re² + im²), no rescaling; at a range edge with an unbounded exponent, the root rounded once (see the header,
    # ADR 0002 row 14). Mirrors `Complex::abs`.
    #must_use
    #pure
    public fn abs(self): f64 {
        if (_bj_cx_plain(self.re, self.im) == 1) {
            var s: f64 = self.re * self.re + self.im * self.im;
            var r: f64 = f64_sqrt(s);
            return r;
        }
        var us, ue = _bj_cx_ux_sumsq(self.re, self.im);
        var u: f64 = _bj_k_ux_sqrt_f64(us, ue);
        return u;
    }

    # |z|, the same as abs. Mirrors bijli's `ComplexExt::norm`.
    #must_use
    #pure
    public fn norm(self): f64 {
        var r: f64 = BjComplex_abs(self);
        return r;
    }

    # re − j·im. Mirrors `Complex::conj`.
    #must_use
    #pure
    public fn conj(self): BjComplex {
        var z: BjComplex;
        z.re = self.re;
        z.im = -self.im;
        return z;
    }

    # re² + im²; at a range edge with an unbounded exponent, the sum rounded once (ADR 0002 row 14). Mirrors
    # `Complex::norm_sq` (and `ComplexExt::norm_sq`).
    #must_use
    #pure
    public fn norm_sq(self): f64 {
        if (_bj_cx_plain(self.re, self.im) == 1) {
            var r: f64 = self.re * self.re + self.im * self.im;
            return r;
        }
        var as2, ae2 = _bj_cx_ux_mul(self.re, self.re);
        var bs2, be2 = _bj_cx_ux_mul(self.im, self.im);
        var u: f64 = _bj_k_ux_add_f64(as2, ae2, bs2, be2);
        return u;
    }

    # atan2(im, re), in [−π, π]. Mirrors `Complex::arg` (and `ComplexExt::arg`).
    #must_use
    #pure
    public fn arg(self): f64 {
        var r: f64 = _bj_atan2(self.im, self.re);
        return r;
    }

    # e^re·(cos im, sin im); for a finite z with re outside [−708, 709] (e^re past DBL_MAX or below 2^-1022) e^re
    # with an unbounded exponent and each product rounded once (ADR 0002 row 16). Mirrors `Complex::exp`.
    #must_use
    #pure
    public fn exp(self): BjComplex {
        var c: f64 = _bj_cos(self.im);
        var s: f64 = _bj_sin(self.im);
        var z: BjComplex;
        var dr: f64 = self.re - self.re;
        var di: f64 = self.im - self.im;
        if ((self.re >= -708.0 && self.re <= 709.0) || dr != 0.0 || di != 0.0) {
            var r: f64 = _bj_exp(self.re);
            z.re = r * c;
            z.im = r * s;
            return z;
        }
        var es, ee = _bj_ux_exp(self.re);
        var cs, ce = _bj_k_ux_from(c);
        var ss, se = _bj_k_ux_from(s);
        var wr: f64 = _bj_k_ux_mul_f64(es, ee, cs, ce);
        var wi: f64 = _bj_k_ux_mul_f64(es, ee, ss, se);
        z.re = wr;
        z.im = wi;
        return z;
    }

    # (ln |z|, arg z), the principal branch; at a range edge |z| with an unbounded exponent (ADR 0002 row 14), and its
    # logarithm with one where it is past DBL_MAX or below 2^-1022 (row 16). Mirrors `Complex::ln`.
    #must_use
    #pure
    public fn ln(self): BjComplex {
        var g: f64 = BjComplex_arg(self);
        var z: BjComplex;
        z.im = g;
        if (_bj_cx_plain(self.re, self.im) == 1) {
            var p: f64 = self.re * self.re + self.im * self.im;
            var a: f64 = f64_sqrt(p);
            var l: f64 = _bj_ln(a);
            z.re = l;
            return z;
        }
        var as, ae = _bj_cx_ux_abs(self.re, self.im);
        if (ae < 0 - 1022 || ae > 1023) {
            var lu: f64 = _bj_ux_ln(as, ae);
            z.re = lu;
            return z;
        }
        var a2: f64 = _bj_k_ux_round(as, ae, 0.0);
        var l2: f64 = _bj_ln(a2);
        z.re = l2;
        return z;
    }

    # from_polar(√|z|, arg z / 2), the principal branch; at a range edge |z| and its root with an unbounded exponent,
    # the polar products rounded once (ADR 0002 row 14). Where im ≠ 0 and |arg z| < 2^-1020, so that arg z / 2 is not
    # a normal double, the angle with an unbounded exponent too (row 16): its cosine is 1 and its sine itself.
    # Mirrors `Complex::sqrt`.
    #must_use
    #pure
    public fn sqrt(self): BjComplex {
        var g: f64 = BjComplex_arg(self);
        var theta: f64 = g / 2.0;
        var tiny = 0;
        if ((_bj_bits(g) & 0x7FFFFFFFFFFFFFFF) < 0x0030000000000000 && self.im != 0.0) {
            var dr: f64 = self.re - self.re;
            if (dr == 0.0) { tiny = 1; }                    # re = +∞ (arg ±0) keeps hisab's chain
        }
        var plain = _bj_cx_plain(self.re, self.im);
        if (plain == 1 && tiny == 0) {
            var a: f64 = BjComplex_abs(self);
            var r: f64 = f64_sqrt(a);
            var z: BjComplex = BjComplex_from_polar(r, theta);
            return z;
        }
        var as2, ae2 = _bj_cx_ux_abs(self.re, self.im);
        var rs, re2 = _bj_k_ux_sqrt(as2, ae2);
        if (tiny == 1) {
            var gs, ge = _bj_cx_arg_ux(g, self.re, self.im);
            var t: BjComplex;
            var tr: f64 = _bj_k_ux_mul_f64(rs, re2, 1.0, 0);
            var ti: f64 = _bj_k_ux_mul_f64(rs, re2, gs, ge - 1);
            t.re = tr;
            t.im = ti;
            return t;
        }
        var c: f64 = _bj_cos(theta);
        var sn: f64 = _bj_sin(theta);
        var cs, ce = _bj_k_ux_from(c);
        var ss, se = _bj_k_ux_from(sn);
        var w: BjComplex;
        var wr: f64 = _bj_k_ux_mul_f64(rs, re2, cs, ce);
        var wi: f64 = _bj_k_ux_mul_f64(rs, re2, ss, se);
        w.re = wr;
        w.im = wi;
        return w;
    }

    # z^n = from_polar(|z|^n, n·arg z) for every z ≠ 0; at a range edge |z| with an unbounded exponent (ADR 0002 row
    # 14), and where |z|, |z|^n, arg z or n·arg z is not a normal double (past DBL_MAX, below 2^-1022), the whole chain
    # with one, each polar product rounded once (row 16, _bj_cx_powf_edge). z = 0 follows pow's rules for a zero base:
    # 0 for n > 0, 1 for n = 0, +∞ for n < 0 (each with im +0), NaN for a NaN n. hisab returned 0 for every |z|² <
    # 1e-300 (row 15: z⁰ was 0, z⁻¹ 0). A non-finite z or n keeps hisab's chain. Mirrors `Complex::powf`.
    #must_use
    #pure
    public fn powf(self, n: f64): BjComplex {
        if (self.re == 0.0 && self.im == 0.0) {
            var zz: BjComplex;
            zz.im = 0.0;
            if (n != n) {
                zz.re = n;
                zz.im = n;
            } elif (n > 0.0) {
                zz.re = 0.0;
            } elif (n == 0.0) {
                zz.re = 1.0;
            } else {
                zz.re = _BJ_K_INF;
            }
            return zz;
        }
        var g: f64 = BjComplex_arg(self);
        var theta: f64 = g * n;
        var dn: f64 = n - n;
        if (_bj_cx_plain(self.re, self.im) == 1 || dn != 0.0) {
            var p: f64 = self.re * self.re + self.im * self.im;
            var a: f64 = f64_sqrt(p);                       # hisab's |z| (a non-finite n gives NaN whatever |z| is)
            var r: f64 = _bj_powf(a, n);
            var da: f64 = a - a;
            if (da != 0.0 || dn != 0.0 || _bj_cx_powf_plain(r, g, theta, n, self.im) == 1) {
                var z: BjComplex = BjComplex_from_polar(r, theta);
                return z;
            }
            var ps, pe = _bj_k_ux_from(a);
            var w: BjComplex = _bj_cx_powf_edge(ps, pe, n, g, self.re, self.im);
            return w;
        }
        var as, ae = _bj_cx_ux_abs(self.re, self.im);
        if (ae >= 0 - 1022 && ae <= 1023) {
            var a2: f64 = _bj_k_ux_round(as, ae, 0.0);
            var r2: f64 = _bj_powf(a2, n);
            if (_bj_cx_powf_plain(r2, g, theta, n, self.im) == 1) {
                var z2: BjComplex = BjComplex_from_polar(r2, theta);
                return z2;
            }
        }
        var w2: BjComplex = _bj_cx_powf_edge(as, ae, n, g, self.re, self.im);
        return w2;
    }

    # sin z = (sin re·cosh im, cos re·sinh im); for a finite z with |im| > 710 (cosh and sinh past DBL_MAX) cosh and
    # sinh with an unbounded exponent and each product rounded once (ADR 0002 row 16). Mirrors `Complex::sin`.
    #must_use
    #pure
    public fn sin(self): BjComplex {
        var s: f64 = _bj_sin(self.re);
        var c: f64 = _bj_cos(self.re);
        var z: BjComplex;
        if (_bj_cx_hyp_plain(self.re, self.im) == 1) {
            var ch: f64 = _bj_cosh(self.im);
            var sh: f64 = _bj_sinh(self.im);
            z.re = s * ch;
            z.im = c * sh;
            return z;
        }
        var hs, he = _bj_ux_cosh(self.im);
        var ks, ke = _bj_ux_sinh(self.im);
        var ss, se = _bj_k_ux_from(s);
        var cs, ce = _bj_k_ux_from(c);
        var wr: f64 = _bj_k_ux_mul_f64(ss, se, hs, he);
        var wi: f64 = _bj_k_ux_mul_f64(cs, ce, ks, ke);
        z.re = wr;
        z.im = wi;
        return z;
    }

    # cos z = (cos re·cosh im, (−sin re)·sinh im); for a finite z with |im| > 710 as sin. Mirrors `Complex::cos`.
    #must_use
    #pure
    public fn cos(self): BjComplex {
        var c: f64 = _bj_cos(self.re);
        var s: f64 = _bj_sin(self.re);
        var ns: f64 = -s;
        var z: BjComplex;
        if (_bj_cx_hyp_plain(self.re, self.im) == 1) {
            var ch: f64 = _bj_cosh(self.im);
            var sh: f64 = _bj_sinh(self.im);
            z.re = c * ch;
            z.im = ns * sh;
            return z;
        }
        var hs, he = _bj_ux_cosh(self.im);
        var ks, ke = _bj_ux_sinh(self.im);
        var cs, ce = _bj_k_ux_from(c);
        var ns2, nse = _bj_k_ux_from(ns);
        var wr: f64 = _bj_k_ux_mul_f64(cs, ce, hs, he);
        var wi: f64 = _bj_k_ux_mul_f64(ns2, nse, ks, ke);
        z.re = wr;
        z.im = wi;
        return z;
    }

    # 1/z = (re/d, −im/d), d = re² + im²; at a range edge d with an unbounded exponent and each quotient rounded once
    # (ADR 0002 row 14). Mirrors `Complex::inv`.
    #must_use
    #pure
    public fn inv(self): BjComplex {
        var nim: f64 = -self.im;
        var z: BjComplex;
        if (_bj_cx_plain(self.re, self.im) == 1) {
            var d: f64 = self.re * self.re + self.im * self.im;
            z.re = self.re / d;
            z.im = nim / d;
            return z;
        }
        var ds, de = _bj_cx_ux_sumsq(self.re, self.im);
        var xs, xe = _bj_k_ux_from(self.re);
        var ys, ye = _bj_k_ux_from(nim);
        var r: f64 = _bj_k_ux_div_f64(xs, xe, ds, de);
        var i: f64 = _bj_k_ux_div_f64(ys, ye, ds, de);
        z.re = r;
        z.im = i;
        return z;
    }

    # 1 when re² + im² < tol² (0 for NaN); at a range edge both sides with an unbounded exponent, compared exactly
    # (ADR 0002 row 14). Mirrors `Complex::is_zero`.
    #must_use
    #pure
    public fn is_zero(self, tol: f64): i64 {
        if (_bj_cx_plain4(self.re, self.im, tol, 0.0) == 1) {
            var ns: f64 = self.re * self.re + self.im * self.im;
            var t2: f64 = tol * tol;
            if (ns < t2) { return 1; }
            return 0;
        }
        var ns2, ne2 = _bj_cx_ux_sumsq(self.re, self.im);
        var ts, te = _bj_cx_ux_mul(tol, tol);
        if (_bj_k_ux_cmp(ns2, ne2, ts, te) == 0 - 1) { return 1; }
        return 0;
    }

    # (re·s, im·s). Mirrors `Mul<f64> for Complex`, `*=` with an f64, and `Mul<Complex> for f64` (s·re is re·s).
    #must_use
    #pure
    public fn scale(self, s: f64): BjComplex {
        var z: BjComplex;
        z.re = self.re * s;
        z.im = self.im * s;
        return z;
    }

    # (re/s, im/s). Mirrors `Div<f64> for Complex`.
    #must_use
    #pure
    public fn div_f64(self, s: f64): BjComplex {
        var z: BjComplex;
        z.re = self.re / s;
        z.im = self.im / s;
        return z;
    }

    # Writes z as Rust's Display does (`format!("{z}")`): "{re}+{im}i" when im ≥ 0 (−0 included, so 1 − j0 is
    # "1+-0i"), else "{re}{im}i" (a NaN im too), each part in Rust's f64 Display form (src/fmtf.cyr). Mirrors
    # `Display for Complex`.
    public fn display(self, t): i64 {
        _bj_fmt_f64_display(t, self.re);
        var im: f64 = self.im;
        if (im >= 0.0) { _bj_tx_putc(t, 43); }
        _bj_fmt_f64_display(t, im);
        _bj_tx_putc(t, 105);
        return 0;
    }
}

# re + j·0. Mirrors `bijli::polarization::complex_real`.
#must_use
#pure
public fn bj_complex_real(re: f64): BjComplex {
    var z: BjComplex = BjComplex_from_real(re);
    return z;
}

# 0 + j·0. Mirrors `bijli::polarization::complex_zero`.
#must_use
#pure
public fn bj_complex_zero(): BjComplex {
    var z: BjComplex = BjComplex_new(0.0, 0.0);
    return z;
}

# magnitude·e^{j·phase}. Mirrors `bijli::polarization::complex_from_polar`.
#must_use
#pure
public fn bj_complex_from_polar(magnitude: f64, phase: f64): BjComplex {
    var z: BjComplex = BjComplex_from_polar(magnitude, phase);
    return z;
}

# --- field.cyr ---

# field.cyr — electric and magnetic fields (port of rust-old/src/field.rs). M1 part 3a: BjFieldVector, point charges,
# superposition, energy densities and dipoles; part 3b: the Gauss's-law fields, multipoles, images, Green's functions
# and the stress tensor; part 3c: trace_field_line, into a BjPolyline.
#
# SI units: metres, coulombs, volts per metre, tesla. The harmonic time convention is src/complex.cyr's.
#
# Shapes. A Rust position `[f64; 3]` is the address of three consecutive f64 (`var p: f64[3];`, passed as `&p`). A
# Rust `Result<FieldVector>` writes the vector through `out: *BjFieldVector` and returns a value-form Result: `Ok(0)`,
# or `Err(code)` with the error in the last-error record (src/error.cyr), `out` untouched. A `Result<f64>` stays a
# Result with the f64 payload. Every formula is Rust's in Rust's order of operations, so the golden rows compare bit
# for bit (class A); constants are src/constants.cyr's (generated), and `1e-30`, the singular cutoff on r², is its
# literal written out (pinned by the rows either side of it). The cutoff is tested exactly (ADR 0002 row 17, the
# user's decision of 2026-11-12): the exact r² of the inputs against 10^-30, and the exact R against 10^-30, through
# src/crmath_cmp.cyr, whose band test leaves Rust's comparison wherever the rounded value is more than 64 ulps from
# the cutoff. A radial distance is a double, and the double nearest 10^-30 lies above it, so `distance < 1e-30` is
# already exact.

private

# Rust's `1e-30`, the double nearest 10^-30: field points closer to the source than 10^-15 m are singular.
public var _BJ_FIELD_R2_MIN: f64 = 0.000000000000000000000000000001;

# ── BjFieldVector ───────────────────────────────────────────────────────────────────────────────────────────────

# A 3D vector field value at a point. Mirrors `FieldVector` (24 bytes, by value).
public struct BjFieldVector {
    x: f64;
    y: f64;
    z: f64;
}

# (x, y, z). Mirrors `FieldVector::new`.
#must_use
#pure
public fn BjFieldVector_new(x: f64, y: f64, z: f64): BjFieldVector {
    var v: BjFieldVector;
    v.x = x;
    v.y = y;
    v.z = z;
    return v;
}

# (0, 0, 0). Mirrors `FieldVector::zero`.
#must_use
#pure
public fn BjFieldVector_zero(): BjFieldVector {
    var v: BjFieldVector;
    v.x = 0.0;
    v.y = 0.0;
    v.z = 0.0;
    return v;
}

# (0, 0, 0). Mirrors `Default for FieldVector`.
#must_use
#pure
public fn BjFieldVector_default(): BjFieldVector {
    var v: BjFieldVector = BjFieldVector_zero();
    return v;
}

# The vector of the three f64 at p. Mirrors `From<[f64; 3]> for FieldVector`.
#must_use
#pure
public fn BjFieldVector_from_array(p: *f64): BjFieldVector {
    var v: BjFieldVector;
    v.x = p[0];
    v.y = p[1];
    v.z = p[2];
    return v;
}

# a + b. Mirrors `Add for FieldVector` (and `+=`: write `a = a + b`).
#must_use
#pure
public fn BjFieldVector_add(a: BjFieldVector, b: BjFieldVector): BjFieldVector {
    var v: BjFieldVector;
    v.x = a.x + b.x;
    v.y = a.y + b.y;
    v.z = a.z + b.z;
    return v;
}

# a − b. Mirrors `Sub for FieldVector` (and `-=`).
#must_use
#pure
public fn BjFieldVector_sub(a: BjFieldVector, b: BjFieldVector): BjFieldVector {
    var v: BjFieldVector;
    v.x = a.x - b.x;
    v.y = a.y - b.y;
    v.z = a.z - b.z;
    return v;
}

# a·s. Mirrors `Mul<f64> for FieldVector` (and `*=` with an f64): `v * 2.0`.
#must_use
#pure
public fn BjFieldVector_mul(a: BjFieldVector, s: f64): BjFieldVector {
    var v: BjFieldVector;
    v.x = a.x * s;
    v.y = a.y * s;
    v.z = a.z * s;
    return v;
}

# s·a, each product s·component in that order. Mirrors `Mul<FieldVector> for f64` (`2.0 * v`).
#must_use
#pure
public fn BjFieldVector_scale_left(s: f64, a: BjFieldVector): BjFieldVector {
    var v: BjFieldVector;
    v.x = s * a.x;
    v.y = s * a.y;
    v.z = s * a.z;
    return v;
}

# −a. Mirrors `Neg for FieldVector`.
#must_use
#pure
public fn BjFieldVector_neg(a: BjFieldVector): BjFieldVector {
    var v: BjFieldVector;
    v.x = -a.x;
    v.y = -a.y;
    v.z = -a.z;
    return v;
}

# Rust's u·v in binary64, with no range-edge path: for the chains that keep Rust's evaluation until their own part
# of M1 part 5d (the dipoles, the Poynting flux).
#must_use
fn _bj_fv_dot_rust(u: BjFieldVector, v: BjFieldVector): f64 {
    var r: f64 = u.x * v.x + u.y * v.y + u.z * v.z;
    return r;
}

# Rust's u × v in binary64, with no range-edge path (the Poynting flux, until its part of 5d).
#must_use
fn _bj_fv_cross_rust(u: BjFieldVector, v: BjFieldVector): BjFieldVector {
    var w: BjFieldVector;
    w.x = u.y * v.z - u.z * v.y;
    w.y = u.z * v.x - u.x * v.z;
    w.z = u.x * v.y - u.y * v.x;
    return w;
}

# |(x, y, z)| at a range edge: the sum of squares with an unbounded exponent, the root rounded once.
#must_use
fn _bj_fv_mag_edge(x: f64, y: f64, z: f64): f64 {
    var us, ue = _bj_vx_sumsq(x, y, z);
    var u: f64 = _bj_k_ux_sqrt_f64(us, ue);
    return u;
}

# |(x, y, z)|² at a range edge: the chain with an unbounded exponent, the last sum rounded once.
#must_use
fn _bj_fv_msq_edge(x: f64, y: f64, z: f64): f64 {
    var as2, ae2 = _bj_vx_mul(x, x);
    var bs2, be2 = _bj_vx_mul(y, y);
    var cs2, ce2 = _bj_vx_mul(z, z);
    var ss, se = _bj_k_ux_add(as2, ae2, bs2, be2);
    var u: f64 = _bj_k_ux_add_f64(ss, se, cs2, ce2);
    return u;
}

# (x, y, z)/|(x, y, z)| at a range edge into out: |v| to 53 bits with an unbounded exponent, each quotient rounded once.
fn _bj_fv_norm_edge(x: f64, y: f64, z: f64, out: *BjFieldVector) {
    var ms2, me2 = _bj_vx_sumsq(x, y, z);
    var mg, mge = _bj_k_ux_sqrt(ms2, me2);
    var xs, xe = _bj_k_ux_from(x);
    var ys, ye = _bj_k_ux_from(y);
    var zs, ze = _bj_k_ux_from(z);
    var ox: f64 = _bj_k_ux_div_f64(xs, xe, mg, mge);
    var oy: f64 = _bj_k_ux_div_f64(ys, ye, mg, mge);
    var oz: f64 = _bj_k_ux_div_f64(zs, ze, mg, mge);
    out.x = ox;
    out.y = oy;
    out.z = oz;
    return 0;
}

# u·v at a range edge: the chain with an unbounded exponent, the last sum rounded once; Rust's s where its chain is
# the unbounded one (an exact 0, or a part not finite: the band test is the caller's).
#must_use
fn _bj_fv_dot_edge(u: BjFieldVector, v: BjFieldVector, s: f64): f64 {
    if (_bj_vx_finite4(u.x, u.y, u.z, v.x) == 0 || _bj_vx_finite4(v.y, v.z, 0.0, 0.0) == 0) { return s; }
    if (s == 0.0) {
        var p: f64 = u.x * v.x;
        var q: f64 = u.y * v.y;
        var r: f64 = u.z * v.z;
        var e = _bj_vx_exact(u.x, v.x, p) + _bj_vx_exact(u.y, v.y, q) + _bj_vx_exact(u.z, v.z, r);
        if (e == 3) { return s; }
    }
    var ps, pe = _bj_vx_mul(u.x, v.x);
    var qs, qe = _bj_vx_mul(u.y, v.y);
    var rs, re = _bj_vx_mul(u.z, v.z);
    var ss, se = _bj_k_ux_add(ps, pe, qs, qe);
    var w: f64 = _bj_k_ux_add_f64(ss, se, rs, re);
    return w;
}

impl BjFieldVector {
    # √(x² + y² + z²), no rescaling; at a range edge (a square past DBL_MAX or below 2^-1022 that the result can
    # see) with an unbounded exponent, the root rounded once (ADR 0002 row 18, src/crmath_vx.cyr's guard). Mirrors
    # `FieldVector::magnitude`.
    #must_use
    #pure
    public fn magnitude(self): f64 {
        var x: f64 = self.x;
        var y: f64 = self.y;
        var z: f64 = self.z;
        var s: f64 = x * x + y * y + z * z;
        if ((s >= _BJ_VX_LO && s <= _BJ_VX_HI) || _bj_vx_sumsq_plain(x, y, z, s) == 1) {
            var r: f64 = f64_sqrt(s);
            return r;
        }
        var u: f64 = _bj_fv_mag_edge(x, y, z);
        return u;
    }

    # x² + y² + z²; at a range edge with an unbounded exponent, the last sum rounded once (ADR 0002 row 18). Mirrors
    # `FieldVector::magnitude_sq`.
    #must_use
    #pure
    public fn magnitude_sq(self): f64 {
        var x: f64 = self.x;
        var y: f64 = self.y;
        var z: f64 = self.z;
        var s: f64 = x * x + y * y + z * z;
        if ((s >= _BJ_VX_LO && s <= _BJ_VX_HI) || _bj_vx_sumsq_plain(x, y, z, s) == 1) { return s; }
        var u: f64 = _bj_fv_msq_edge(x, y, z);
        return u;
    }

    # The unit vector in this direction, into out: each part over |v|. Errors: DivisionByZero for the zero vector,
    # InvalidParameter for a NaN or infinite component. In range (every part ±0 or in [2^-511, 2^511)) this is Rust's
    # code. At a range edge, where Rust rescales by the largest part first (two more roundings), its first branch runs
    # with an unbounded exponent instead: |v| to 53 bits, each quotient rounded once (ADR 0002 row 18). So the result
    # is exactly scale-invariant, the same bits for 2^k·v wherever the parts stay exact. Mirrors
    # `FieldVector::normalized`.
    public fn normalized(self, out: *BjFieldVector): Result {
        var ms: f64 = self.x * self.x + self.y * self.y + self.z * self.z;
        if (_bj_vx_sumsq_plain(self.x, self.y, self.z, ms) == 0) {
            _bj_fv_norm_edge(self.x, self.y, self.z, out);
            return Ok(0);
        }
        var tiny: f64 = _bj_from_bits(0x0010000000000000);        # f64::MIN_POSITIVE
        if (_bj_is_finite(ms) == 1 && ms >= tiny) {
            var mag: f64 = f64_sqrt(ms);
            out.x = self.x / mag;
            out.y = self.y / mag;
            out.z = self.z / mag;
            return Ok(0);
        }
        var x: f64 = self.x;
        var y: f64 = self.y;
        var z: f64 = self.z;
        if (_bj_is_finite(x) == 0 || _bj_is_finite(y) == 0 || _bj_is_finite(z) == 0) {
            var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(t, "cannot normalize non-finite vector ");
            BjFieldVector_display(self, t);
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        # Rust's chain stands and |v|² is below 2^-1022 or not finite: every part is ±0 (a non-finite one was refused
        # above). Rust's rescale by the largest part, which only the range edges reach, is the unbounded path above.
        return Err(_bj_err_division_by_zero("zero vector cannot be normalized"));
    }

    # self·o; at a range edge with an unbounded exponent, the last sum rounded once (ADR 0002 row 18). Mirrors
    # `FieldVector::dot`.
    #must_use
    #pure
    public fn dot(self, o: BjFieldVector): f64 {
        var r: f64 = self.x * o.x + self.y * o.y + self.z * o.z;
        var a: f64 = f64_abs(r);
        if (a >= _BJ_VX_LO && a <= _BJ_VX_HI) { return r; }
        var u: f64 = _bj_fv_dot_edge(self, o, r);
        return u;
    }

    # self × o; at a range edge with an unbounded exponent, each difference rounded once (ADR 0002 row 18). Mirrors
    # `FieldVector::cross`.
    #must_use
    #pure
    public fn cross(self, o: BjFieldVector): BjFieldVector {
        var v: BjFieldVector;
        var cx: f64 = self.y * o.z - self.z * o.y;
        var cy: f64 = self.z * o.x - self.x * o.z;
        var cz: f64 = self.x * o.y - self.y * o.x;
        v.x = cx;
        v.y = cy;
        v.z = cz;
        # Every component's biased exponent in [123, 2046] is |c| ∈ [2^-900, DBL_MAX] (src/crmath_vx.cyr's band).
        var ex = (load64(&cx) >> 52) & 0x7FF;
        var ey = (load64(&cy) >> 52) & 0x7FF;
        var ez = (load64(&cz) >> 52) & 0x7FF;
        if (((ex - 123) | (ey - 123) | (ez - 123) | (2046 - ex) | (2046 - ey) | (2046 - ez)) >= 0) { return v; }
        # A component that is 0 through zero factors is exact; so is one in the band.
        var hard = 0;
        if (((ex - 123) | (2046 - ex)) < 0 && !(cx == 0.0 && (self.y == 0.0 || o.z == 0.0) && (self.z == 0.0
              || o.y == 0.0))) { hard = 1; }
        if (((ey - 123) | (2046 - ey)) < 0 && !(cy == 0.0 && (self.z == 0.0 || o.x == 0.0) && (self.x == 0.0
              || o.z == 0.0))) { hard = 1; }
        if (((ez - 123) | (2046 - ez)) < 0 && !(cz == 0.0 && (self.x == 0.0 || o.y == 0.0) && (self.y == 0.0
              || o.x == 0.0))) { hard = 1; }
        if (hard == 0) { return v; }
        if (_bj_vx_finite4(self.x, self.y, self.z, o.x) == 0 || _bj_vx_finite4(o.y, o.z, 0.0, 0.0) == 0) {
            return v;                                       # a non-finite part keeps Rust's chain
        }
        var ux: f64 = _bj_vx_cross1_f64(self.y, o.z, self.z, o.y, cx);
        var uy: f64 = _bj_vx_cross1_f64(self.z, o.x, self.x, o.z, cy);
        var uz: f64 = _bj_vx_cross1_f64(self.x, o.y, self.y, o.x, cz);
        v.x = ux;
        v.y = uy;
        v.z = uz;
        return v;
    }

    # self·s. Mirrors `FieldVector::scale`.
    #must_use
    #pure
    public fn scale(self, s: f64): BjFieldVector {
        var v: BjFieldVector;
        v.x = self.x * s;
        v.y = self.y * s;
        v.z = self.z * s;
        return v;
    }

    # 1 when every component equals o's (IEEE: −0 equals +0, NaN equals nothing). Mirrors the derived `PartialEq`.
    #must_use
    #pure
    public fn eq(self, o: BjFieldVector): i64 {
        var a: f64 = self.x;
        var b: f64 = self.y;
        var c: f64 = self.z;
        if (a == o.x && b == o.y && c == o.z) { return 1; }
        return 0;
    }

    # Writes the three components to the f64 at p. Mirrors `From<FieldVector> for [f64; 3]`.
    public fn to_array(self, p: *f64): i64 {
        p[0] = self.x;
        p[1] = self.y;
        p[2] = self.z;
        return 0;
    }

    # Writes "(x, y, z)" as Rust's Display does, each component in Rust's f64 Display form (src/fmtf.cyr). Mirrors
    # `Display for FieldVector`.
    public fn display(self, t): i64 {
        _bj_tx_putc(t, 40);
        _bj_fmt_f64_display(t, self.x);
        _bj_tx_cstr(t, ", ");
        _bj_fmt_f64_display(t, self.y);
        _bj_tx_cstr(t, ", ");
        _bj_fmt_f64_display(t, self.z);
        _bj_tx_putc(t, 41);
        return 0;
    }
}

# ── point charges ───────────────────────────────────────────────────────────────────────────────────────────────
#
# Range edges (ADR 0002 row 18, M1 part 5d-3): where the offset overflows, or k·q, the factor k·q·(1/r)³ (or
# μ₀q/(4πr²)), a unit-vector part or a cross component leaves the normal range, the chain runs with an unbounded
# exponent and each output component's last product rounds once (src/crmath_vx.cyr). The guard tests Rust's own values:
# past the Singularity cutoff r² ≥ 10^-30 (2^-100), so r² finite keeps the squares' sum the unbounded chain's
# (crmath_vx's band argument), and a chain of products by 1/r is the unbounded one when its first and last values are
# normal and above 2^-1022 (the ones between lie between them). Biased exponents in [2, 2046] are that test. A zero
# charge passes when r² is finite (then the offset, and so the signs of the zero products, are the unbounded chain's),
# and a non-finite input keeps Rust's chain.

# E = kq/r²·r̂ (V/m) at field_pos from a point charge at charge_pos, as k·q·(1/r)³ times the offset; at a range edge
# with an unbounded exponent, each component rounded once (ADR 0002 row 18). Singularity when the exact r² < 10^-30
# (row 17). Mirrors `field::electric_field_point_charge`.
public fn bj_electric_field_point_charge(charge_q: f64, charge_pos: *f64, field_pos: *f64,
  out: *BjFieldVector): Result {
    var dx: f64 = field_pos[0] - charge_pos[0];
    var dy: f64 = field_pos[1] - charge_pos[1];
    var dz: f64 = field_pos[2] - charge_pos[2];
    var r_sq: f64 = dx * dx + dy * dy + dz * dz;
    var band = _bj_x_band(r_sq, _BJ_FIELD_R2_MIN);
    if (band == 2) { band = _bj_x_r2_below(field_pos, charge_pos, 30); }
    if (band == 1) {
        return Err(_bj_err_singularity());
    }
    var rt: f64 = f64_sqrt(r_sq);
    var inv_r: f64 = 1.0 / rt;
    var kq: f64 = BJ_COULOMB_K * charge_q;
    var factor: f64 = kq * inv_r * inv_r * inv_r;
    out.x = factor * dx;
    out.y = factor * dy;
    out.z = factor * dz;
    # k·q and the factor normal (an overflowed offset makes 1/r and so the factor 0, so r² needs no test of its own).
    var e2 = (load64(&kq) >> 52) & 0x7FF;
    var e3 = (load64(&factor) >> 52) & 0x7FF;
    if (((e2 - 2) | (2046 - e2) | (e3 - 2) | (2046 - e3)) >= 0) { return Ok(0); }
    _bj_fv_point_e_slow(charge_q, charge_pos, field_pos, r_sq, kq, factor, out);
    return Ok(0);
}

# The point charge's field past its fast test, into out (which holds Rust's): Rust's chain stands for a zero charge
# with r² finite or a non-finite input, else the unbounded chain.
fn _bj_fv_point_e_slow(q: f64, c: *f64, f: *f64, r_sq: f64, kq: f64, factor: f64, out: *BjFieldVector) {
    var p: f64[7];
    p[0] = q;
    p[1] = c[0];
    p[2] = c[1];
    p[3] = c[2];
    p[4] = f[0];
    p[5] = f[1];
    p[6] = f[2];
    if (_bj_vx_coulomb_plain(r_sq, kq, kq, factor, q, 1.0, &p, 7) == 1) { return 0; }
    _bj_vx_coulomb_edge(BJ_COULOMB_K, q, 1.0, f, c, out);
    return 0;
}

# V = kq/r (volts) at a range edge: the offset and |d| with an unbounded exponent, k·q to 53 bits, the quotient rounded
# once.
#must_use
fn _bj_fv_potential_edge(q: f64, f: *f64, c: *f64): f64 {
    var s: f64[5];
    var e: i64[5];
    _bj_vx_offset_ux(f, c, &s, &e);
    var ks, ke = _bj_k_ux_from(BJ_COULOMB_K);
    var qs, qe = _bj_k_ux_from(q);
    var ms, me = _bj_k_ux_mul(ks, ke, qs, qe);
    var v: f64 = _bj_k_ux_div_f64(ms, me, s[3], e[3]);
    return v;
}

# V = kq/r (volts); at a range edge with an unbounded exponent, the quotient rounded once (ADR 0002 row 18).
# Singularity when the exact r² < 10^-30 (row 17). Mirrors `field::electric_potential_point_charge`.
public fn bj_electric_potential_point_charge(charge_q: f64, charge_pos: *f64, field_pos: *f64): Result {
    var dx: f64 = field_pos[0] - charge_pos[0];
    var dy: f64 = field_pos[1] - charge_pos[1];
    var dz: f64 = field_pos[2] - charge_pos[2];
    var r_sq: f64 = dx * dx + dy * dy + dz * dz;
    var band = _bj_x_band(r_sq, _BJ_FIELD_R2_MIN);
    if (band == 2) { band = _bj_x_r2_below(field_pos, charge_pos, 30); }
    if (band == 1) {
        return Err(_bj_err_singularity());
    }
    var rt: f64 = f64_sqrt(r_sq);
    var kq: f64 = BJ_COULOMB_K * charge_q;
    var v: f64 = kq / rt;
    var e1 = (load64(&r_sq) >> 52) & 0x7FF;
    var e2 = (load64(&kq) >> 52) & 0x7FF;
    if (((2046 - e1) | (e2 - 2) | (2046 - e2)) >= 0) { return Ok(v); }
    var p: f64[7];
    p[0] = charge_q;
    p[1] = charge_pos[0];
    p[2] = charge_pos[1];
    p[3] = charge_pos[2];
    p[4] = field_pos[0];
    p[5] = field_pos[1];
    p[6] = field_pos[2];
    if ((charge_q == 0.0 && e1 <= 2046) || _bj_vx_finite_n(&p, 7) == 0) { return Ok(v); }
    var u: f64 = _bj_fv_potential_edge(charge_q, field_pos, charge_pos);
    return Ok(u);
}

# B = (μ₀/4π)·q(v × r̂)/r² at a range edge, into out: the offset, 1/r and r̂ with an unbounded exponent, v × r̂ and the
# factor ((μ₀/4π)·q)·(1/r)² to 53 bits, each component's product rounded once.
fn _bj_fv_moving_b_edge(q: f64, c: *f64, vel: *f64, f: *f64, mu4: f64, out: *BjFieldVector) {
    var s: f64[5];
    var e: i64[5];
    _bj_vx_offset_ux(f, c, &s, &e);
    var hxs, hxe = _bj_k_ux_mul(s[0], e[0], s[4], e[4]);
    var hys, hye = _bj_k_ux_mul(s[1], e[1], s[4], e[4]);
    var hzs, hze = _bj_k_ux_mul(s[2], e[2], s[4], e[4]);
    var v0s, v0e = _bj_k_ux_from(vel[0]);
    var v1s, v1e = _bj_k_ux_from(vel[1]);
    var v2s, v2e = _bj_k_ux_from(vel[2]);
    var a1s, a1e = _bj_k_ux_mul(v1s, v1e, hzs, hze);
    var a2s, a2e = _bj_k_ux_mul(v2s, v2e, hys, hye);
    var cxs, cxe = _bj_k_ux_sub(a1s, a1e, a2s, a2e);
    var b1s, b1e = _bj_k_ux_mul(v2s, v2e, hxs, hxe);
    var b2s, b2e = _bj_k_ux_mul(v0s, v0e, hzs, hze);
    var cys, cye = _bj_k_ux_sub(b1s, b1e, b2s, b2e);
    var c1s, c1e = _bj_k_ux_mul(v0s, v0e, hys, hye);
    var c2s, c2e = _bj_k_ux_mul(v1s, v1e, hxs, hxe);
    var czs, cze = _bj_k_ux_sub(c1s, c1e, c2s, c2e);
    var ms, me = _bj_k_ux_from(mu4);
    var qs, qe = _bj_k_ux_from(q);
    var mqs, mqe = _bj_k_ux_mul(ms, me, qs, qe);
    var f1s, f1e = _bj_k_ux_mul(mqs, mqe, s[4], e[4]);
    var f2s, f2e = _bj_k_ux_mul(f1s, f1e, s[4], e[4]);
    var ox: f64 = _bj_k_ux_mul_f64(f2s, f2e, cxs, cxe);
    var oy: f64 = _bj_k_ux_mul_f64(f2s, f2e, cys, cye);
    var oz: f64 = _bj_k_ux_mul_f64(f2s, f2e, czs, cze);
    out.x = ox;
    out.y = oy;
    out.z = oz;
    return 0;
}

# 1 when a moving charge's unit-vector part h = d·(1/r) is its 53-bit value: normal and above 2^-1022, or d = 0.
#must_use
fn _bj_fv_unit_ok(h: f64, d: f64): i64 {
    if (d == 0.0) { return 1; }
    var b = (load64(&h) >> 52) & 0x7FF;
    if (b >= 2 && b <= 2046) { return 1; }
    return 0;
}

# 1 when a cross component c = a·b − x·y of the moving charge's v × r̂ is its 53-bit value: in the band, or 0 through
# zero factors.
#must_use
fn _bj_fv_cross_ok(c: f64, a: f64, b: f64, x: f64, y: f64): i64 {
    if (_bj_vx_band(c) == 1) { return 1; }
    if (c == 0.0 && (a == 0.0 || b == 0.0) && (x == 0.0 || y == 0.0)) { return 1; }
    return 0;
}

# B = (μ₀/4π)·q(v × r̂)/r² (tesla) at field_pos from a charge at charge_pos moving with `velocity` (Biot–Savart); at a
# range edge with an unbounded exponent, each component rounded once (ADR 0002 row 18). Singularity when the exact
# r² < 10^-30 (row 17). Mirrors `field::magnetic_field_moving_charge`.
public fn bj_magnetic_field_moving_charge(charge_q: f64, charge_pos: *f64, velocity: *f64, field_pos: *f64,
  out: *BjFieldVector): Result {
    var dx: f64 = field_pos[0] - charge_pos[0];
    var dy: f64 = field_pos[1] - charge_pos[1];
    var dz: f64 = field_pos[2] - charge_pos[2];
    var r_sq: f64 = dx * dx + dy * dy + dz * dz;
    var band = _bj_x_band(r_sq, _BJ_FIELD_R2_MIN);
    if (band == 2) { band = _bj_x_r2_below(field_pos, charge_pos, 30); }
    if (band == 1) {
        return Err(_bj_err_singularity());
    }
    var rt: f64 = f64_sqrt(r_sq);
    var inv_r: f64 = 1.0 / rt;
    var rx: f64 = dx * inv_r;
    var ry: f64 = dy * inv_r;
    var rz: f64 = dz * inv_r;
    var cross_x: f64 = velocity[1] * rz - velocity[2] * ry;
    var cross_y: f64 = velocity[2] * rx - velocity[0] * rz;
    var cross_z: f64 = velocity[0] * ry - velocity[1] * rx;
    var four_pi: f64 = 4.0 * _BJ_PI;
    var mu4: f64 = BJ_MU_0 / four_pi;
    var mq: f64 = mu4 * charge_q;
    var factor: f64 = mq * inv_r * inv_r;
    out.x = factor * cross_x;
    out.y = factor * cross_y;
    out.z = factor * cross_z;
    var e1 = (load64(&r_sq) >> 52) & 0x7FF;
    var e2 = (load64(&mq) >> 52) & 0x7FF;
    var e3 = (load64(&factor) >> 52) & 0x7FF;
    var hx = (load64(&rx) >> 52) & 0x7FF;
    var hy = (load64(&ry) >> 52) & 0x7FF;
    var hz = (load64(&rz) >> 52) & 0x7FF;
    var cx = (load64(&cross_x) >> 52) & 0x7FF;
    var cy = (load64(&cross_y) >> 52) & 0x7FF;
    var cz = (load64(&cross_z) >> 52) & 0x7FF;
    # One test, branch-free: each term is negative when out of range, and masked to 0 when the part is an exact 0 (an
    # offset part 0 for r̂; zero factors in both products for a cross component). z(x) = 1 when x = ±0.
    var v0: f64 = velocity[0];
    var v1: f64 = velocity[1];
    var v2: f64 = velocity[2];
    var zdx = ((load64(&dx) & 0x7FFFFFFFFFFFFFFF) - 1) >> 63;
    var zdy = ((load64(&dy) & 0x7FFFFFFFFFFFFFFF) - 1) >> 63;
    var zdz = ((load64(&dz) & 0x7FFFFFFFFFFFFFFF) - 1) >> 63;
    var zv0 = ((load64(&v0) & 0x7FFFFFFFFFFFFFFF) - 1) >> 63;
    var zv1 = ((load64(&v1) & 0x7FFFFFFFFFFFFFFF) - 1) >> 63;
    var zv2 = ((load64(&v2) & 0x7FFFFFFFFFFFFFFF) - 1) >> 63;
    var w = (2046 - e1) | (e2 - 2) | (2046 - e2) | (e3 - 2) | (2046 - e3);
    w = w | (((hx - 2) | (2046 - hx)) & (zdx - 1)) | (((hy - 2) | (2046 - hy)) & (zdy - 1));
    w = w | (((hz - 2) | (2046 - hz)) & (zdz - 1));
    w = w | (((cx - 123) | (2046 - cx)) & ((((zv1 | zdz) & (zv2 | zdy))) - 1));
    w = w | (((cy - 123) | (2046 - cy)) & ((((zv2 | zdx) & (zv0 | zdz))) - 1));
    w = w | (((cz - 123) | (2046 - cz)) & ((((zv0 | zdy) & (zv1 | zdx))) - 1));
    if (w >= 0) { return Ok(0); }
    _bj_fv_moving_b_slow(charge_q, charge_pos, velocity, field_pos, mu4, out);
    return Ok(0);
}

# The moving charge's field past both tiers, into out (which holds Rust's): Rust's chain stands for a non-finite input,
# else the unbounded chain.
fn _bj_fv_moving_b_slow(q: f64, c: *f64, vel: *f64, f: *f64, mu4: f64, out: *BjFieldVector) {
    var p: f64[10];
    p[0] = q;
    for (var i = 0; i < 3; i = i + 1) {
        p[1 + i] = c[i];
        p[4 + i] = vel[i];
        p[7 + i] = f[i];
    }
    if (_bj_vx_finite_n(&p, 10) == 0) { return 0; }
    _bj_fv_moving_b_edge(q, c, vel, f, mu4, out);
    return 0;
}

# 1 when one charge's field in a superposition is its 53-bit value with Rust's chain the unbounded one: the point
# charge's fast test, and each component normal and above 2^-1022 or exactly 0 (a zero offset part); a zero charge
# with r² finite makes every product an exact 0 with the unbounded chain's signs.
#must_use
fn _bj_fv_super_plain(r_sq: f64, kq: f64, factor: f64, ex: f64, ey: f64, ez: f64, dx: f64, dy: f64, dz: f64,
  q: f64): i64 {
    var e1 = (load64(&r_sq) >> 52) & 0x7FF;
    if (q == 0.0 && e1 <= 2046) { return 1; }
    var e2 = (load64(&kq) >> 52) & 0x7FF;
    var e3 = (load64(&factor) >> 52) & 0x7FF;
    if (((2046 - e1) | (e2 - 2) | (2046 - e2) | (e3 - 2) | (2046 - e3)) < 0) { return 0; }
    if (_bj_fv_unit_ok(ex, dx) + _bj_fv_unit_ok(ey, dy) + _bj_fv_unit_ok(ez, dz) == 3) { return 1; }
    return 0;
}

# The superposition at a range edge, into out: each charge's field to 53 bits (_bj_vx_coulomb_ux, its products with an
# unbounded exponent), summed in order from zero with an unbounded exponent, the last addition rounded once.
fn _bj_fv_super_edge(charges: *f64, n, field_pos: *f64, out: *BjFieldVector) {
    var s: f64[6];
    var e: i64[6];
    var acs: f64[3];
    var ace: i64[3];
    var fin: f64[3];
    for (var k = 0; k < 3; k = k + 1) {
        acs[k] = 0.0;
        ace[k] = 0;
    }
    for (var i = 0; i < n; i = i + 1) {
        var c: *f64 = charges + i * 4;
        var q: f64 = c[0];
        _bj_vx_coulomb_ux(BJ_COULOMB_K, q, 1.0, field_pos, c + 1, &s, &e);
        for (var j = 0; j < 3; j = j + 1) {
            var gs, ge = _bj_k_ux_mul(s[5], e[5], s[j], e[j]);
            if (i == n - 1) {
                var r: f64 = _bj_k_ux_add_f64(acs[j], ace[j], gs, ge);
                fin[j] = r;
            } else {
                var ns, ne = _bj_k_ux_add(acs[j], ace[j], gs, ge);
                acs[j] = ns;
                ace[j] = ne;
            }
        }
    }
    out.x = fin[0];
    out.y = fin[1];
    out.z = fin[2];
    return 0;
}

# The sum of the point-charge fields of n charges at field_pos, each charge 32 bytes at `charges` (q, then its
# position: Rust's `(f64, [f64; 3])`), accumulated in order from zero. The first singular charge's error is returned.
# At a range edge (a field or a partial sum Rust rounded outside the normal range) the whole sum runs with an
# unbounded exponent, each field kept to 53 bits and the last addition rounded once (ADR 0002 row 18). Mirrors
# `field::electric_field_superposition`.
public fn bj_electric_field_superposition(charges: *f64, n, field_pos: *f64, out: *BjFieldVector): Result {
    var tx: f64 = 0.0;
    var ty: f64 = 0.0;
    var tz: f64 = 0.0;
    var plain = 1;
    for (var i = 0; i < n; i = i + 1) {
        var c: *f64 = charges + i * 4;
        var q: f64 = c[0];
        var cp: *f64 = c + 1;
        var dx: f64 = field_pos[0] - cp[0];
        var dy: f64 = field_pos[1] - cp[1];
        var dz: f64 = field_pos[2] - cp[2];
        var r_sq: f64 = dx * dx + dy * dy + dz * dz;
        var band = _bj_x_band(r_sq, _BJ_FIELD_R2_MIN);
        if (band == 2) { band = _bj_x_r2_below(field_pos, cp, 30); }
        if (band == 1) { return Err(_bj_err_singularity()); }
        var rt: f64 = f64_sqrt(r_sq);
        var inv_r: f64 = 1.0 / rt;
        var kq: f64 = BJ_COULOMB_K * q;
        var factor: f64 = kq * inv_r * inv_r * inv_r;
        var ex: f64 = factor * dx;
        var ey: f64 = factor * dy;
        var ez: f64 = factor * dz;
        tx = tx + ex;
        ty = ty + ey;
        tz = tz + ez;
        if (plain == 1) {
            # k·q, the factor and each field component normal (a zero component with a zero offset part is exact).
            var b2 = (load64(&kq) >> 52) & 0x7FF;
            var b3 = (load64(&factor) >> 52) & 0x7FF;
            var g1 = (load64(&ex) >> 52) & 0x7FF;
            var g2 = (load64(&ey) >> 52) & 0x7FF;
            var g3 = (load64(&ez) >> 52) & 0x7FF;
            var w = (b2 - 2) | (2046 - b2) | (b3 - 2) | (2046 - b3);
            var w2 = w;
            if (dx != 0.0) { w2 = w2 | (g1 - 2) | (2046 - g1); }
            if (dy != 0.0) { w2 = w2 | (g2 - 2) | (2046 - g2); }
            if (dz != 0.0) { w2 = w2 | (g3 - 2) | (2046 - g3); }
            if (w2 < 0) { plain = _bj_fv_super_plain(r_sq, kq, factor, ex, ey, ez, dx, dy, dz, q); }
        }
    }
    var b1 = (load64(&tx) >> 52) & 0x7FF;
    var b2 = (load64(&ty) >> 52) & 0x7FF;
    var b3 = (load64(&tz) >> 52) & 0x7FF;
    if (plain == 1 && b1 != 2047 && b2 != 2047 && b3 != 2047) {
        out.x = tx;
        out.y = ty;
        out.z = tz;
        return Ok(0);
    }
    var all: f64 = 0.0;
    for (var j = 0; j < 4 * n; j = j + 1) {
        var y: f64 = charges[j];
        all = all + (y - y);
    }
    if (all != 0.0 || _bj_vx_finite_n(field_pos, 3) == 0) {
        out.x = tx;                                         # a non-finite input keeps Rust's chain
        out.y = ty;
        out.z = tz;
        return Ok(0);
    }
    _bj_fv_super_edge(charges, n, field_pos, out);
    return Ok(0);
}

# u = ε₀E²/2 (J/m³), correctly rounded (ADR 0002 row 13; a non-finite E keeps Rust's 0.5·ε₀·E·E). Mirrors
# `field::electric_energy_density`.
#must_use
#pure
public fn bj_electric_energy_density(e_magnitude: f64): f64 {
    if (_bj_is_finite(e_magnitude) == 0) {
        var u: f64 = 0.5 * BJ_EPSILON_0 * e_magnitude * e_magnitude;
        return u;
    }
    var cr: f64 = _bj_k_cr_mul4(0.5, BJ_EPSILON_0, e_magnitude, e_magnitude);
    return cr;
}

# u = B²/(2μ₀) (J/m³), correctly rounded (ADR 0002 row 13; a non-finite B keeps Rust's B·B/(2μ₀)). Mirrors
# `field::magnetic_energy_density`.
#must_use
#pure
public fn bj_magnetic_energy_density(b_magnitude: f64): f64 {
    var two_mu: f64 = 2.0 * BJ_MU_0;
    if (_bj_is_finite(b_magnitude) == 0) {
        var u: f64 = b_magnitude * b_magnitude / two_mu;
        return u;
    }
    var cr: f64 = _bj_k_cr_mul_div(b_magnitude, b_magnitude, two_mu);
    return cr;
}

# ── dipoles ─────────────────────────────────────────────────────────────────────────────────────────────────────

# The unit vector toward p and 1/|p| for a field position p with |p|² ≥ 10^-30 exactly, into r_hat; returns 1/|p|, or
# −1 when the exact |p|² < 10^-30 (singular: ADR 0002 row 17).
fn _bj_field_rhat(p: *f64, r_hat: *BjFieldVector): f64 {
    var r_sq: f64 = p[0] * p[0] + p[1] * p[1] + p[2] * p[2];
    var band = _bj_x_band(r_sq, _BJ_FIELD_R2_MIN);
    if (band == 2) { band = _bj_x_r2_below(p, &_bj_x_origin, 30); }
    if (band == 1) { return -1.0; }
    var rt: f64 = f64_sqrt(r_sq);
    var inv_r: f64 = 1.0 / rt;
    r_hat.x = p[0] * inv_r;
    r_hat.y = p[1] * inv_r;
    r_hat.z = p[2] * inv_r;
    return inv_r;
}

# ── the dipoles at a range edge (ADR 0002 row 18, M1 part 5d-4) ───────────────────────────────────────────────
#
# The dipole fields' chain: r̂ = p·(1/r), m·r̂, (1/r)³, the factor f ((1/r)³/(4πε₀), or μ₀(1/r)³/(4π)), 3(m·r̂), k =
# 3(m·r̂)·f, then each component r̂·k − m·f, the last operation. Rust's chain is the unbounded one when each of those is
# normal and above 2^-1022 (r̂, (1/r)³, the factor, 3(m·r̂), k), m·r̂ lies in src/crmath_vx.cyr's band, and each output
# component does; a value that is an exact 0 passes too: r̂ᵢ for pᵢ = 0, m·r̂ (and so 3(m·r̂) and k) when every product
# has a zero factor, an output component when both its products do. One fold, branch-free; anything else takes the
# unbounded chain, and a non-finite part keeps Rust's.

# 1 when the dipole field Rust evaluated is the unbounded chain's (the section comment): m and p the moment and the
# field point, h = r̂, and v = [m·r̂, (1/r)³, the factor, 3(m·r̂), k, then the three output components].
#must_use
fn _bj_fv_dipole_plain(m: *f64, p: *f64, h: *f64, v: *f64): i64 {
    # Each value into a local, then its bits: z* = 1 for an exact 0, r* a range term (negative out of range).
    var m0: f64 = m[0];
    var zm0 = ((load64(&m0) & 0x7FFFFFFFFFFFFFFF) - 1) >> 63;
    var m1: f64 = m[1];
    var zm1 = ((load64(&m1) & 0x7FFFFFFFFFFFFFFF) - 1) >> 63;
    var m2: f64 = m[2];
    var zm2 = ((load64(&m2) & 0x7FFFFFFFFFFFFFFF) - 1) >> 63;
    var p0: f64 = p[0];
    var zp0 = ((load64(&p0) & 0x7FFFFFFFFFFFFFFF) - 1) >> 63;
    var p1: f64 = p[1];
    var zp1 = ((load64(&p1) & 0x7FFFFFFFFFFFFFFF) - 1) >> 63;
    var p2: f64 = p[2];
    var zp2 = ((load64(&p2) & 0x7FFFFFFFFFFFFFFF) - 1) >> 63;
    var zd = (zm0 | zp0) & (zm1 | zp1) & (zm2 | zp2);
    var h0: f64 = h[0];
    var bh0 = (load64(&h0) >> 52) & 0x7FF;
    var rh0 = (bh0 - 2) | (2046 - bh0);
    var h1: f64 = h[1];
    var bh1 = (load64(&h1) >> 52) & 0x7FF;
    var rh1 = (bh1 - 2) | (2046 - bh1);
    var h2: f64 = h[2];
    var bh2 = (load64(&h2) >> 52) & 0x7FF;
    var rh2 = (bh2 - 2) | (2046 - bh2);
    var pd: f64 = v[0];
    var bpd = (load64(&pd) >> 52) & 0x7FF;
    var rpd = (bpd - 123) | (2046 - bpd);
    var i3: f64 = v[1];
    var bi3 = (load64(&i3) >> 52) & 0x7FF;
    var ri3 = (bi3 - 2) | (2046 - bi3);
    var fc: f64 = v[2];
    var bfc = (load64(&fc) >> 52) & 0x7FF;
    var rfc = (bfc - 2) | (2046 - bfc);
    var t3: f64 = v[3];
    var bt3 = (load64(&t3) >> 52) & 0x7FF;
    var rt3 = (bt3 - 2) | (2046 - bt3);
    var kk: f64 = v[4];
    var bkk = (load64(&kk) >> 52) & 0x7FF;
    var rkk = (bkk - 2) | (2046 - bkk);
    var e0: f64 = v[5];
    var be0 = (load64(&e0) >> 52) & 0x7FF;
    var re0 = (be0 - 123) | (2046 - be0);
    var e1: f64 = v[6];
    var be1 = (load64(&e1) >> 52) & 0x7FF;
    var re1 = (be1 - 123) | (2046 - be1);
    var e2: f64 = v[7];
    var be2 = (load64(&e2) >> 52) & 0x7FF;
    var re2 = (be2 - 123) | (2046 - be2);
    var w = (rh0 & (zp0 - 1)) | (rh1 & (zp1 - 1)) | (rh2 & (zp2 - 1)) | (rpd & (zd - 1)) | ri3 | rfc;
    w = w | (rt3 & (zd - 1)) | (rkk & (zd - 1)) | (re0 & (((zp0 | zd) & zm0) - 1));
    w = w | (re1 & (((zp1 | zd) & zm1) - 1)) | (re2 & (((zp2 | zd) & zm2) - 1));
    if (w >= 0) { return 1; }
    var q: f64[6];
    for (var i = 0; i < 3; i = i + 1) {
        q[i] = m[i];
        q[3 + i] = p[i];
    }
    if (_bj_vx_finite_n(&q, 6) == 0) { return 1; }
    return 0;
}

# The unbounded chain's r̂ (three pairs), m·r̂ and 1/r for a dipole m at the origin and the field point p: into s[0..2]
# and e[0..2], s[3] and e[3], s[4] and e[4].
fn _bj_fv_dipole_ux(m: *f64, p: *f64, s: *f64, e: *i64) {
    var o: f64[5];
    var oe: i64[5];
    _bj_vx_offset_ux(p, &_bj_x_origin, &o, &oe);
    for (var i = 0; i < 3; i = i + 1) {
        var hs, he = _bj_k_ux_mul(o[i], oe[i], o[4], oe[4]);
        s[i] = hs;
        e[i] = he;
    }
    var m0s, m0e = _bj_k_ux_from(m[0]);
    var m1s, m1e = _bj_k_ux_from(m[1]);
    var m2s, m2e = _bj_k_ux_from(m[2]);
    var a0s, a0e = _bj_k_ux_mul(m0s, m0e, s[0], e[0]);
    var a1s, a1e = _bj_k_ux_mul(m1s, m1e, s[1], e[1]);
    var a2s, a2e = _bj_k_ux_mul(m2s, m2e, s[2], e[2]);
    var ps, pe = _bj_k_ux_add(a0s, a0e, a1s, a1e);
    var ds, de = _bj_k_ux_add(ps, pe, a2s, a2e);
    s[3] = ds;
    e[3] = de;
    s[4] = o[4];
    e[4] = oe[4];
    return 0;
}

# A dipole field at a range edge into out: r̂, m·r̂ and (1/r)³ with an unbounded exponent; the factor (1/r)³/(4πε₀), or
# μ₀(1/r)³/(4π) (magnetic 1); 3(m·r̂), k; each component r̂·k − m·f rounded once.
fn _bj_fv_dipole_edge(m: *f64, p: *f64, magnetic, out: *BjFieldVector) {
    var s: f64[5];
    var e: i64[5];
    _bj_fv_dipole_ux(m, p, &s, &e);
    var i2s, i2e = _bj_k_ux_mul(s[4], e[4], s[4], e[4]);
    var i3s, i3e = _bj_k_ux_mul(i2s, i2e, s[4], e[4]);
    var fs: f64 = 0.0;
    var fe = 0;
    if (magnetic == 1) {
        var mus, mue = _bj_k_ux_from(BJ_MU_0);
        var ns, ne = _bj_k_ux_mul(mus, mue, i3s, i3e);
        var four_pi: f64 = 4.0 * _BJ_PI;
        var cs, ce = _bj_k_ux_from(four_pi);
        var gs, ge = _bj_k_ux_div(ns, ne, cs, ce);
        fs = gs;
        fe = ge;
    } else {
        var d: f64 = 4.0 * _BJ_PI * BJ_EPSILON_0;
        var cs2, ce2 = _bj_k_ux_from(d);
        var gs2, ge2 = _bj_k_ux_div(i3s, i3e, cs2, ce2);
        fs = gs2;
        fe = ge2;
    }
    var ts, te = _bj_k_ux_mul(3.0, 0, s[3], e[3]);
    var ks, ke = _bj_k_ux_mul(ts, te, fs, fe);
    var o: f64[3];
    for (var i = 0; i < 3; i = i + 1) {
        var as, ae = _bj_k_ux_mul(s[i], e[i], ks, ke);
        var mis, mie = _bj_k_ux_from(m[i]);
        var bs, be = _bj_k_ux_mul(mis, mie, fs, fe);
        var r: f64 = _bj_k_ux_sub_f64(as, ae, bs, be);
        o[i] = r;
    }
    out.x = o[0];
    out.y = o[1];
    out.z = o[2];
    return 0;
}

# The shared dipole field: Rust's chain with the factor f, then its guard, then the unbounded chain at an edge.
fn _bj_fv_dipole_field(moment: BjFieldVector, field_pos: *f64, magnetic, out: *BjFieldVector): Result {
    var r_hat: BjFieldVector;
    var inv_r: f64 = _bj_field_rhat(field_pos, &r_hat);
    if (inv_r < 0.0) { return Err(_bj_err_singularity()); }
    var inv_r3: f64 = inv_r * inv_r * inv_r;
    var p_dot: f64 = _bj_fv_dot_rust(moment, r_hat);
    var factor: f64 = 0.0;
    if (magnetic == 1) {
        var four_pi: f64 = 4.0 * _BJ_PI;
        factor = BJ_MU_0 * inv_r3 / four_pi;
    } else {
        var d: f64 = 4.0 * _BJ_PI * BJ_EPSILON_0;
        factor = inv_r3 / d;
    }
    var t3: f64 = 3.0 * p_dot;
    var k: f64 = t3 * factor;
    var hx: f64 = r_hat.x;
    var hy: f64 = r_hat.y;
    var hz: f64 = r_hat.z;
    var m0: f64 = moment.x;
    var m1: f64 = moment.y;
    var m2: f64 = moment.z;
    var e0: f64 = hx * k - m0 * factor;
    var e1: f64 = hy * k - m1 * factor;
    var e2: f64 = hz * k - m2 * factor;
    out.x = e0;
    out.y = e1;
    out.z = e2;
    # The guard (the section comment), inline: z* = 1 for an exact 0, r* a range term (negative out of range).
    var p0: f64 = field_pos[0];
    var p1: f64 = field_pos[1];
    var p2: f64 = field_pos[2];
    var zm0 = ((load64(&m0) & 0x7FFFFFFFFFFFFFFF) - 1) >> 63;
    var zm1 = ((load64(&m1) & 0x7FFFFFFFFFFFFFFF) - 1) >> 63;
    var zm2 = ((load64(&m2) & 0x7FFFFFFFFFFFFFFF) - 1) >> 63;
    var zp0 = ((load64(&p0) & 0x7FFFFFFFFFFFFFFF) - 1) >> 63;
    var zp1 = ((load64(&p1) & 0x7FFFFFFFFFFFFFFF) - 1) >> 63;
    var zp2 = ((load64(&p2) & 0x7FFFFFFFFFFFFFFF) - 1) >> 63;
    var zd = (zm0 | zp0) & (zm1 | zp1) & (zm2 | zp2);
    var b_hx = (load64(&hx) >> 52) & 0x7FF;
    var r_hx = (b_hx - 2) | (2046 - b_hx);
    var b_hy = (load64(&hy) >> 52) & 0x7FF;
    var r_hy = (b_hy - 2) | (2046 - b_hy);
    var b_hz = (load64(&hz) >> 52) & 0x7FF;
    var r_hz = (b_hz - 2) | (2046 - b_hz);
    var b_p_dot = (load64(&p_dot) >> 52) & 0x7FF;
    var r_p_dot = (b_p_dot - 123) | (2046 - b_p_dot);
    var b_inv_r3 = (load64(&inv_r3) >> 52) & 0x7FF;
    var r_inv_r3 = (b_inv_r3 - 2) | (2046 - b_inv_r3);
    var b_factor = (load64(&factor) >> 52) & 0x7FF;
    var r_factor = (b_factor - 2) | (2046 - b_factor);
    var b_t3 = (load64(&t3) >> 52) & 0x7FF;
    var r_t3 = (b_t3 - 2) | (2046 - b_t3);
    var b_k = (load64(&k) >> 52) & 0x7FF;
    var r_k = (b_k - 2) | (2046 - b_k);
    var b_e0 = (load64(&e0) >> 52) & 0x7FF;
    var r_e0 = (b_e0 - 123) | (2046 - b_e0);
    var b_e1 = (load64(&e1) >> 52) & 0x7FF;
    var r_e1 = (b_e1 - 123) | (2046 - b_e1);
    var b_e2 = (load64(&e2) >> 52) & 0x7FF;
    var r_e2 = (b_e2 - 123) | (2046 - b_e2);
    var w = (r_hx & (zp0 - 1)) | (r_hy & (zp1 - 1)) | (r_hz & (zp2 - 1)) | (r_p_dot & (zd - 1)) | r_inv_r3 | r_factor;
    w = w | (r_t3 & (zd - 1)) | (r_k & (zd - 1)) | (r_e0 & (((zp0 | zd) & zm0) - 1));
    w = w | (r_e1 & (((zp1 | zd) & zm1) - 1)) | (r_e2 & (((zp2 | zd) & zm2) - 1));
    if (w >= 0) { return Ok(0); }
    var mm: f64[3];
    mm[0] = m0;
    mm[1] = m1;
    mm[2] = m2;
    if (_bj_vx_finite_n(&mm, 3) == 0 || _bj_vx_finite_n(field_pos, 3) == 0) { return Ok(0); }
    _bj_fv_dipole_edge(&mm, field_pos, magnetic, out);
    return Ok(0);
}

# E = (1/4πε₀r³)·[3(p·r̂)r̂ − p] at field_pos from a dipole p at the origin, as r̂·(3(p·r̂)·f) − p·f with f =
# (1/r)³/(4πε₀); at a range edge with an unbounded exponent, each component rounded once (ADR 0002 row 18).
# Singularity when the exact r² < 10^-30 (row 17). Mirrors `field::electric_dipole_field`.
public fn bj_electric_dipole_field(dipole_moment: BjFieldVector, field_pos: *f64, out: *BjFieldVector): Result {
    var t, v = _bj_fv_dipole_field(dipole_moment, field_pos, 0, out);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(0);
}

# V = p·r̂/(4πε₀r²) at field_pos from a dipole p at the origin, as (p·r̂)·(1/r)·(1/r)/(4πε₀); at a range edge (r̂,
# p·r̂ or (p·r̂)/r² outside the normal range) with an unbounded exponent, the quotient rounded once (ADR 0002 row 18).
# Singularity when the exact r² < 10^-30 (row 17). Mirrors `field::electric_dipole_potential`.
public fn bj_electric_dipole_potential(dipole_moment: BjFieldVector, field_pos: *f64): Result {
    var r_hat: BjFieldVector;
    var inv_r: f64 = _bj_field_rhat(field_pos, &r_hat);
    if (inv_r < 0.0) { return Err(_bj_err_singularity()); }
    var p_dot: f64 = _bj_fv_dot_rust(dipole_moment, r_hat);
    var d: f64 = 4.0 * _BJ_PI * BJ_EPSILON_0;
    var t2: f64 = p_dot * inv_r * inv_r;
    var v: f64 = t2 / d;
    # The guard as the field's (the section comment), with (p·r̂)/r² for its factor terms.
    var w: f64[8];
    w[0] = p_dot;
    w[1] = 1.0;
    w[2] = 1.0;
    w[3] = t2;
    w[4] = t2;
    w[5] = 1.0;
    w[6] = 1.0;
    w[7] = 1.0;
    var mm: f64[3];
    mm[0] = dipole_moment.x;
    mm[1] = dipole_moment.y;
    mm[2] = dipole_moment.z;
    if (_bj_fv_dipole_plain(&mm, field_pos, &r_hat, &w) == 1) { return Ok(v); }
    var s: f64[5];
    var e: i64[5];
    _bj_fv_dipole_ux(&mm, field_pos, &s, &e);
    var t1s, t1e = _bj_k_ux_mul(s[3], e[3], s[4], e[4]);
    var t2s, t2e = _bj_k_ux_mul(t1s, t1e, s[4], e[4]);
    var ds, de = _bj_k_ux_from(d);
    var u: f64 = _bj_k_ux_div_f64(t2s, t2e, ds, de);
    return Ok(u);
}

# B = (μ₀/4πr³)·[3(m·r̂)r̂ − m] at field_pos from a magnetic dipole m at the origin, as r̂·(3(m·r̂)·f) − m·f with
# f = μ₀·(1/r)³/(4π); at a range edge with an unbounded exponent, each component rounded once (ADR 0002 row 18).
# Singularity when the exact r² < 10^-30 (row 17). Mirrors `field::magnetic_dipole_field`.
public fn bj_magnetic_dipole_field(magnetic_moment: BjFieldVector, field_pos: *f64, out: *BjFieldVector): Result {
    var t, v = _bj_fv_dipole_field(magnetic_moment, field_pos, 1, out);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(0);
}

# ── Gauss's-law fields (M1 part 3b) ─────────────────────────────────────────────────────────────────────────────

# |E| = σ/(2ε₀) (V/m) from an infinite plane of surface charge density σ. Mirrors
# `field::electric_field_infinite_plane`.
#must_use
#pure
public fn bj_electric_field_infinite_plane(surface_charge_density: f64): f64 {
    var d: f64 = 2.0 * BJ_EPSILON_0;
    var e: f64 = surface_charge_density / d;
    return e;
}

# A radial distance's errors: InvalidParameter when NaN or negative, Singularity below 10^-30 m (the double nearest
# 10^-30 lies above it, so Rust's `distance < 1e-30` is the exact test); else Ok(0). Mirrors
# field.rs's `pub(crate) check_radial_distance`.
public fn _bj_check_radial_distance(distance: f64): Result {
    if (distance != distance || distance < 0.0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "distance must be non-negative, got ");
        _bj_fmt_f64_display(t, distance);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (distance < _BJ_FIELD_R2_MIN) { return Err(_bj_err_singularity()); }
    return Ok(0);
}

# E_r = kQ/r² (V/m) outside a uniformly charged sphere (r > R), correctly rounded (ADR 0002 row 13; a non-finite
# operand keeps Rust's k·Q/(r·r)). Errors as _bj_check_radial_distance. Mirrors `field::electric_field_charged_sphere`.
public fn bj_electric_field_charged_sphere(total_charge: f64, distance: f64): Result {
    var t, v = _bj_check_radial_distance(distance);
    if (is_err_result(t) == 1) { return Err(v); }
    if (_bj_is_finite(total_charge) == 0 || _bj_is_finite(distance) == 0) {
        var r2: f64 = distance * distance;
        var e: f64 = BJ_COULOMB_K * total_charge / r2;
        return Ok(e);
    }
    var cr: f64 = _bj_k_cr_mul2_div2(BJ_COULOMB_K, total_charge, distance, distance);
    return Ok(cr);
}

# E_r = kQ·(r/R)/R² (V/m) inside a uniformly charged sphere, 0 ≤ r ≤ R: kQr/R³ correctly rounded (ADR 0002 row 13;
# a non-finite Q keeps Rust's chain). InvalidParameter when R is not positive and
# finite, or r is outside [0, R] (or NaN). Mirrors `field::electric_field_inside_sphere`.
public fn bj_electric_field_inside_sphere(total_charge: f64, sphere_radius: f64, distance: f64): Result {
    if (!(sphere_radius > 0.0 && _bj_is_finite(sphere_radius) == 1)) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "sphere radius must be positive and finite, got ");
        _bj_fmt_f64_display(t, sphere_radius);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (!(distance >= 0.0 && distance <= sphere_radius)) {
        var t2 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t2, "distance must lie in [0, R] = [0, ");
        _bj_fmt_f64_display(t2, sphere_radius);
        _bj_tx_cstr(t2, "] for the interior field, got ");
        _bj_fmt_f64_display(t2, distance);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (_bj_is_finite(total_charge) == 0) {
        var frac: f64 = distance / sphere_radius;
        var r2: f64 = sphere_radius * sphere_radius;
        var e: f64 = BJ_COULOMB_K * total_charge * frac / r2;
        return Ok(e);
    }
    var num: f64[3];
    var den: f64[3];
    num[0] = BJ_COULOMB_K;
    num[1] = total_charge;
    num[2] = distance;
    den[0] = sphere_radius;
    den[1] = sphere_radius;
    den[2] = sphere_radius;
    var cr: f64 = _bj_k_cr_mono(&num, 3, &den, 3);
    return Ok(cr);
}

# E_r = λ/(2πε₀r) (V/m) from an infinite line of linear charge density λ, correctly rounded with π as Rust's double
# (ADR 0002 row 13; a non-finite operand keeps Rust's λ/(2·π·ε₀·r)). Errors as _bj_check_radial_distance. Mirrors
# `field::electric_field_infinite_line`.
public fn bj_electric_field_infinite_line(linear_charge_density: f64, distance: f64): Result {
    var t, v = _bj_check_radial_distance(distance);
    if (is_err_result(t) == 1) { return Err(v); }
    if (_bj_is_finite(linear_charge_density) == 0 || _bj_is_finite(distance) == 0) {
        var d: f64 = 2.0 * _BJ_PI * BJ_EPSILON_0 * distance;
        var e: f64 = linear_charge_density / d;
        return Ok(e);
    }
    var two_pi: f64 = 2.0 * _BJ_PI;
    var cr: f64 = _bj_k_cr_div3(linear_charge_density, two_pi, BJ_EPSILON_0, distance);
    return Ok(cr);
}

# E_r = λ/(2πε₀r) outside an infinite uniformly charged cylinder: the line's field and errors. Mirrors
# `field::electric_field_outside_cylinder`.
public fn bj_electric_field_outside_cylinder(linear_charge_density: f64, distance: f64): Result {
    return bj_electric_field_infinite_line(linear_charge_density, distance);
}

# E_r = ρr/(2ε₀) (V/m) inside an infinite uniformly charged cylinder, correctly rounded (ADR 0002 row 13; a non-finite
# operand keeps Rust's ρ·r/(2ε₀)). InvalidParameter when r is NaN or negative.
# Mirrors `field::electric_field_inside_cylinder`.
public fn bj_electric_field_inside_cylinder(volume_charge_density: f64, distance: f64): Result {
    if (distance != distance || distance < 0.0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "distance must be non-negative, got ");
        _bj_fmt_f64_display(t, distance);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var d: f64 = 2.0 * BJ_EPSILON_0;
    if (_bj_is_finite(volume_charge_density) == 0 || _bj_is_finite(distance) == 0) {
        var e: f64 = volume_charge_density * distance / d;
        return Ok(e);
    }
    var cr: f64 = _bj_k_cr_mul_div(volume_charge_density, distance, d);
    return Ok(cr);
}

# E_z = kQz/(z² + R²)^(3/2) (V/m) on the axis of a ring of radius R in the plane z = 0, z signed; 0 at the centre,
# Singularity there only for R = 0 (a point charge). InvalidParameter when R is negative, NaN or infinite, or z is not
# finite. At a range edge the chain runs with an unbounded exponent, the quotient rounded once (ADR 0002 row 18).
# Mirrors `field::electric_field_ring_axis`.
public fn bj_electric_field_ring_axis(total_charge: f64, ring_radius: f64, axial_distance: f64): Result {
    if (!(ring_radius >= 0.0 && _bj_is_finite(ring_radius) == 1)) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "ring radius must be non-negative and finite, got ");
        _bj_fmt_f64_display(t, ring_radius);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (_bj_is_finite(axial_distance) == 0) {
        var t2 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t2, "axial distance must be finite, got ");
        _bj_fmt_f64_display(t2, axial_distance);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (axial_distance == 0.0) {
        if (ring_radius == 0.0) { return Err(_bj_err_singularity()); }
        var zero: f64 = 0.0;
        return Ok(zero);
    }
    var d_sq: f64 = axial_distance * axial_distance + ring_radius * ring_radius;
    var rt: f64 = f64_sqrt(d_sq);
    var denom: f64 = d_sq * rt;
    var kq: f64 = BJ_COULOMB_K * total_charge;
    var kqz: f64 = kq * axial_distance;
    var e: f64 = kqz / denom;
    # Rust's chain is the unbounded one when z² + R² lies in the band and the products (z² + R²)^(3/2), k·Q and k·Q·z
    # are normal and above 2^-1022 (a zero charge makes the numerator an exact 0); ADR 0002 row 18.
    var e1 = (load64(&d_sq) >> 52) & 0x7FF;
    var e2 = (load64(&denom) >> 52) & 0x7FF;
    var e3 = (load64(&kq) >> 52) & 0x7FF;
    var e4 = (load64(&kqz) >> 52) & 0x7FF;
    var w = (e1 - 123) | (2046 - e1) | (e2 - 2) | (2046 - e2);
    if (total_charge != 0.0) { w = w | (e3 - 2) | (2046 - e3) | (e4 - 2) | (2046 - e4); }
    if (w >= 0 || _bj_is_finite(total_charge) == 0) { return Ok(e); }
    var ds, de = _bj_vx_sumsq(axial_distance, ring_radius, 0.0);
    var rs, re = _bj_k_ux_sqrt(ds, de);
    var ns, ne = _bj_k_ux_mul(ds, de, rs, re);
    var ks, ke = _bj_k_ux_from(BJ_COULOMB_K);
    var qs, qe = _bj_k_ux_from(total_charge);
    var zs, ze = _bj_k_ux_from(axial_distance);
    var ms, me = _bj_k_ux_mul(ks, ke, qs, qe);
    var mzs, mze = _bj_k_ux_mul(ms, me, zs, ze);
    var u: f64 = _bj_k_ux_div_f64(mzs, mze, ns, ne);
    return Ok(u);
}

# E_z = sgn(z)·(σ/2ε₀)·(R/r)·(R/(r + |z|)), r = √(z² + R²), on the axis of a disk of radius R in the plane z = 0: the
# cancellation-free form, the one-sided limit at z = ±0 by the sign bit. InvalidParameter when R is not positive and
# finite, or z is not finite. At a range edge the chain runs with an unbounded exponent, the last product rounded once
# (ADR 0002 row 18). Mirrors `field::electric_field_disk_axis`.
public fn bj_electric_field_disk_axis(surface_charge_density: f64, disk_radius: f64, axial_distance: f64): Result {
    if (!(disk_radius > 0.0 && _bj_is_finite(disk_radius) == 1)) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "disk radius must be positive and finite, got ");
        _bj_fmt_f64_display(t, disk_radius);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (_bj_is_finite(axial_distance) == 0) {
        var t2 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t2, "axial distance must be finite, got ");
        _bj_fmt_f64_display(t2, axial_distance);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var abs_z: f64 = f64_abs(axial_distance);
    var s2: f64 = axial_distance * axial_distance + disk_radius * disk_radius;
    var r: f64 = f64_sqrt(s2);
    var g1: f64 = disk_radius / r;
    var rz: f64 = r + abs_z;
    var g2: f64 = disk_radius / rz;
    var geometric: f64 = g1 * g2;
    var sign: f64 = _bj_copysign(1.0, axial_distance);
    var d: f64 = 2.0 * BJ_EPSILON_0;
    var sd: f64 = sign * surface_charge_density / d;
    var e: f64 = sd * geometric;
    # Rust's chain is the unbounded one when z² + R² lies in the band, r + |z| is finite, R/r, R/(r + |z|), their
    # product and σ/(2ε₀) are normal and above 2^-1022 (σ = 0 makes the last an exact 0); ADR 0002 row 18.
    var e1 = (load64(&s2) >> 52) & 0x7FF;
    var e2 = (load64(&g1) >> 52) & 0x7FF;
    var e3 = (load64(&rz) >> 52) & 0x7FF;
    var e4 = (load64(&g2) >> 52) & 0x7FF;
    var e5 = (load64(&geometric) >> 52) & 0x7FF;
    var e6 = (load64(&sd) >> 52) & 0x7FF;
    var w = (e1 - 123) | (2046 - e1) | (e2 - 2) | (2046 - e2) | (2046 - e3) | (e4 - 2) | (2046 - e4) | (e5 - 2);
    w = w | (2046 - e5);
    if (surface_charge_density != 0.0) { w = w | (e6 - 2) | (2046 - e6); }
    if (w >= 0 || _bj_is_finite(surface_charge_density) == 0) { return Ok(e); }
    var u: f64 = _bj_fv_disk_edge(surface_charge_density, disk_radius, axial_distance, sign, d);
    return Ok(u);
}

# The disk's axial field at a range edge: r, R/r, r + |z|, R/(r + |z|), their product and sgn(z)·σ/(2ε₀) with an
# unbounded exponent, the last product rounded once.
#must_use
fn _bj_fv_disk_edge(sigma: f64, rr: f64, z: f64, sign: f64, d: f64): f64 {
    var ss, se = _bj_vx_sumsq(z, rr, 0.0);
    var rs, re = _bj_k_ux_sqrt(ss, se);
    var Rs, Re = _bj_k_ux_from(rr);
    var g1s, g1e = _bj_k_ux_div(Rs, Re, rs, re);
    var az: f64 = f64_abs(z);
    var zs, ze = _bj_k_ux_from(az);
    var ts, te = _bj_k_ux_add(rs, re, zs, ze);
    var g2s, g2e = _bj_k_ux_div(Rs, Re, ts, te);
    var gs, ge = _bj_k_ux_mul(g1s, g1e, g2s, g2e);
    var sg: f64 = sign * sigma;
    var as, ae = _bj_k_ux_from(sg);
    var ds, de = _bj_k_ux_from(d);
    var qs, qe = _bj_k_ux_div(as, ae, ds, de);
    var u: f64 = _bj_k_ux_mul_f64(qs, qe, gs, ge);
    return u;
}

# ── multipoles (M1 part 3b) ─────────────────────────────────────────────────────────────────────────────────────

# V = (1/4πε₀)·½·Σᵢⱼ Qᵢⱼxᵢxⱼ/r⁵ (volts) at field_pos from a quadrupole at the origin: Σ in i-then-j order from 0, over
# 8πε₀r⁵ with r⁵ = r²·r²·r. q_tensor is 9 f64, row-major (Rust's `[[f64; 3]; 3]`). At a range edge the chain runs with
# an unbounded exponent, the quotient rounded once (ADR 0002 row 18). Singularity when the exact r² < 10^-30 (row 17).
# Mirrors `field::electric_quadrupole_potential`.
public fn bj_electric_quadrupole_potential(q_tensor: *f64, field_pos: *f64): Result {
    var r_sq: f64 = field_pos[0] * field_pos[0] + field_pos[1] * field_pos[1] + field_pos[2] * field_pos[2];
    var band = _bj_x_band(r_sq, _BJ_FIELD_R2_MIN);
    if (band == 2) { band = _bj_x_r2_below(field_pos, &_bj_x_origin, 30); }
    if (band == 1) {
        return Err(_bj_err_singularity());
    }
    var r: f64 = f64_sqrt(r_sq);
    var r5: f64 = r_sq * r_sq * r;
    var sum: f64 = 0.0;
    for (var i = 0; i < 3; i = i + 1) {
        for (var j = 0; j < 3; j = j + 1) {
            var term: f64 = q_tensor[i * 3 + j] * field_pos[i] * field_pos[j];
            sum = sum + term;
        }
    }
    var d: f64 = 8.0 * _BJ_PI * BJ_EPSILON_0 * r5;
    var v: f64 = sum / d;
    if (_bj_fv_quad_plain(q_tensor, field_pos, r_sq, r5, d, sum) == 1) { return Ok(v); }
    var u: f64 = _bj_fv_quad_edge(q_tensor, field_pos);
    return Ok(u);
}

# 1 when the quadrupole's binary64 chain is the unbounded one (ADR 0002 row 18): r², r⁵ and 8πε₀r⁵ normal and above
# 2^-1022 (r⁴ lies between r² and r⁵), each Qᵢⱼ·xᵢ and each term Qᵢⱼ·xᵢ·xⱼ normal or an exact 0 (a zero factor), and the
# sum finite (a sum of such terms rounds alike in both; an overflow shows as a non-finite sum); or a part not finite.
#must_use
fn _bj_fv_quad_plain(qt: *f64, p: *f64, r_sq: f64, r5: f64, d: f64, sum: f64): i64 {
    var all: f64[12];
    for (var k = 0; k < 9; k = k + 1) { all[k] = qt[k]; }
    all[9] = p[0];
    all[10] = p[1];
    all[11] = p[2];
    if (_bj_vx_finite_n(&all, 12) == 0) { return 1; }
    var e1 = (load64(&r_sq) >> 52) & 0x7FF;
    var e2 = (load64(&r5) >> 52) & 0x7FF;
    var e3 = (load64(&d) >> 52) & 0x7FF;
    var e4 = (load64(&sum) >> 52) & 0x7FF;
    if (((e1 - 2) | (2046 - e1) | (e2 - 2) | (2046 - e2) | (e3 - 2) | (2046 - e3) | (2046 - e4)) < 0) { return 0; }
    for (var i = 0; i < 3; i = i + 1) {
        for (var j = 0; j < 3; j = j + 1) {
            var qq: f64 = qt[i * 3 + j];
            var xi: f64 = p[i];
            var xj: f64 = p[j];
            var a: f64 = qq * xi;
            var t: f64 = a * xj;
            if (qq != 0.0 && xi != 0.0) {
                var ba = (load64(&a) >> 52) & 0x7FF;
                if (ba < 2 || ba > 2046) { return 0; }
                if (xj != 0.0) {
                    var bt = (load64(&t) >> 52) & 0x7FF;
                    if (bt < 2 || bt > 2046) { return 0; }
                }
            }
        }
    }
    return 1;
}

# The quadrupole potential at a range edge: r², r, r⁵ and 8πε₀r⁵ with an unbounded exponent, the sum of the terms
# (Qᵢⱼ·xᵢ)·xⱼ in i-then-j order from 0 with one, the quotient rounded once.
#must_use
fn _bj_fv_quad_edge(qt: *f64, p: *f64): f64 {
    var r2s, r2e = _bj_vx_sumsq(p[0], p[1], p[2]);
    var rs, re = _bj_k_ux_sqrt(r2s, r2e);
    var r4s, r4e = _bj_k_ux_mul(r2s, r2e, r2s, r2e);
    var r5s, r5e = _bj_k_ux_mul(r4s, r4e, rs, re);
    var c8: f64 = 8.0 * _BJ_PI * BJ_EPSILON_0;
    var cs, ce = _bj_k_ux_from(c8);
    var ds, de = _bj_k_ux_mul(cs, ce, r5s, r5e);
    var acs: f64[1];
    var ace: i64[1];
    acs[0] = 0.0;
    ace[0] = 0;
    for (var i = 0; i < 3; i = i + 1) {
        for (var j = 0; j < 3; j = j + 1) {
            var as, ae = _bj_vx_mul(qt[i * 3 + j], p[i]);
            var js, je = _bj_k_ux_from(p[j]);
            var ts, te = _bj_k_ux_mul(as, ae, js, je);
            var ns, ne = _bj_k_ux_add(acs[0], ace[0], ts, te);
            acs[0] = ns;
            ace[0] = ne;
        }
    }
    var u: f64 = _bj_k_ux_div_f64(acs[0], ace[0], ds, de);
    return u;
}

# ── the multipoles' chains at a range edge (ADR 0002 row 18, M1 part 5d-5) ──────────────────────────────────────
#
# Each moment is a chain of products and sums over the charges: the spherical coordinates, rˡ (powi's square-and-
# multiply, or pow), the Legendre recurrence, the angle's cosine or sine, the term's products, the running sum. Rust's
# chain is the unbounded one when every product, quotient and root it computes is normal and above 2^-1022 or an exact 0
# from a zero operand (a sum or difference of such values always is: exact when it is below 2^-1022), nothing
# overflows, and its origin test agrees (r = 0 only for a point at the origin). The *_k functions evaluate Rust's chain
# and clear a flag where that fails; the _bj_ux_* ones evaluate it with an unbounded exponent; each moment's last
# addition then rounds once. A non-finite part keeps Rust's chain.

# (r, cos θ, sin θ, φ) of a point into out (4 f64); 0 at the origin, else 1. cos θ = z/r and sin θ = ρ/r, clamped,
# straight from the components (no acos round trip); φ = atan2(y, x). Clears *ok where the chain is not the unbounded
# one (the section comment). Mirrors field.rs's `spherical_coords`.
fn _bj_spherical_coords(pos: *f64, out: *f64, ok: *i64): i64 {
    var x: f64 = pos[0];
    var y: f64 = pos[1];
    var z: f64 = pos[2];
    var xx: f64 = x * x;
    var yy: f64 = y * y;
    var zz: f64 = z * z;
    _bj_fv_chk(xx, x, x, ok);
    _bj_fv_chk(yy, y, y, ok);
    _bj_fv_chk(zz, z, z, ok);
    var rho_sq: f64 = xx + yy;
    var s: f64 = rho_sq + zz;
    var r: f64 = f64_sqrt(s);
    var bs = (load64(&s) >> 52) & 0x7FF;
    if (bs == 2047) { ok[0] = 0; }
    if (r == 0.0) {
        if (x != 0.0 || y != 0.0 || z != 0.0) { ok[0] = 0; }
        return 0;
    }
    var c0: f64 = z / r;
    _bj_fv_chk(c0, z, r, ok);
    var rho: f64 = f64_sqrt(rho_sq);
    var s0: f64 = rho / r;
    _bj_fv_chk(s0, rho, r, ok);
    out[0] = r;
    out[1] = _bj_clamp(c0, -1.0, 1.0);
    out[2] = _bj_clamp(s0, 0.0, 1.0);
    var g: f64 = _bj_atan2(y, x);
    out[3] = g;
    var bg = (load64(&g) >> 52) & 0x7FF;
    if (y != 0.0 && bg < 2) { ok[0] = 0; }
    return 1;
}

# rˡ: compiler-rt's powi for l up to 2^31 − 1 (Rust's `r.powi(l as i32)`), powf above. Mirrors field.rs's
# `radial_power`.
#must_use
fn _bj_radial_power(r: f64, l): f64 {
    if (l <= 2147483647) {
        var p: f64 = _bj_powi(r, l);
        return p;
    }
    var lf: f64 = f64_from(l);
    var q: f64 = _bj_powf(r, lf);
    return q;
}

# P_l^m(x), the associated Legendre function with the Condon–Shortley phase, by the upward recurrence; s = √(1 − x²)
# passed in so it stays accurate near |x| = 1. 0 for m > l. Mirrors field.rs's private `associated_legendre`.
#must_use
public fn _bj_associated_legendre(l, m, x: f64, s: f64): f64 {
    var ok = 1;
    var p: f64 = _bj_assoc_legendre_k(l, m, x, s, &ok);
    return p;
}

# _bj_associated_legendre, clearing *ok where a product or quotient is not the unbounded chain's (the section comment).
#must_use
fn _bj_assoc_legendre_k(l, m, x: f64, s: f64, ok: *i64): f64 {
    if (m > l) {
        var z0: f64 = 0.0;
        return z0;
    }
    var pmm: f64 = 1.0;
    var fact: f64 = 1.0;
    for (var k = 0; k < m; k = k + 1) {
        var nf: f64 = -fact;
        var t: f64 = nf * s;
        _bj_fv_chk(t, nf, s, ok);
        var p2: f64 = pmm * t;
        _bj_fv_chk(p2, pmm, t, ok);
        pmm = p2;
        fact = fact + 2.0;
    }
    if (l == m) { return pmm; }
    var m_f: f64 = f64_from(m);
    var c1: f64 = 2.0 * m_f + 1.0;
    var u: f64 = x * c1;
    _bj_fv_chk(u, x, c1, ok);
    var pmmp1: f64 = u * pmm;
    _bj_fv_chk(pmmp1, u, pmm, ok);
    if (l == m + 1) { return pmmp1; }
    var pll: f64 = 0.0;
    for (var ll = m + 2; ll <= l; ll = ll + 1) {
        var ll_f: f64 = f64_from(ll);
        var c2: f64 = 2.0 * ll_f - 1.0;
        var u2: f64 = x * c2;
        _bj_fv_chk(u2, x, c2, ok);
        var a: f64 = u2 * pmmp1;
        _bj_fv_chk(a, u2, pmmp1, ok);
        var c3: f64 = ll_f + m_f - 1.0;
        var b: f64 = c3 * pmm;
        _bj_fv_chk(b, c3, pmm, ok);
        var c4: f64 = ll_f - m_f;
        var dd: f64 = a - b;
        pll = dd / c4;
        _bj_fv_chk(pll, dd, c4, ok);
        pmm = pmmp1;
        pmmp1 = pll;
    }
    return pll;
}

# P̄_l^m(x) = √((2l+1)/(4π)·(l−m)!/(l+m)!)·P_l^m(x), CS phase included, by the stable recurrence (Numerical Recipes
# §6.7, no factorials). 0 for m > l. Clears *ok as _bj_assoc_legendre_k. Mirrors field.rs's private
# `normalized_associated_legendre`.
#must_use
fn _bj_norm_legendre_k(l, m, x: f64, s: f64, ok: *i64): f64 {
    if (m > l) {
        var z0: f64 = 0.0;
        return z0;
    }
    var pmm: f64 = 1.0;
    for (var k = 1; k <= m; k = k + 1) {
        var k_f: f64 = f64_from(k);
        var ratio: f64 = (2.0 * k_f - 1.0) / (2.0 * k_f);
        var sr: f64 = f64_sqrt(ratio);
        var ns: f64 = -s;
        var t: f64 = ns * sr;
        _bj_fv_chk(t, ns, sr, ok);
        var p2: f64 = pmm * t;
        _bj_fv_chk(p2, pmm, t, ok);
        pmm = p2;
    }
    var m_f: f64 = f64_from(m);
    var c0: f64 = (2.0 * m_f + 1.0) / (4.0 * _BJ_PI);
    var c: f64 = f64_sqrt(c0);
    var p3: f64 = pmm * c;
    _bj_fv_chk(p3, pmm, c, ok);
    pmm = p3;
    if (l == m) { return pmm; }
    var c3: f64 = 2.0 * m_f + 3.0;
    var s3: f64 = f64_sqrt(c3);
    var u: f64 = x * s3;
    _bj_fv_chk(u, x, s3, ok);
    var pmmp1: f64 = u * pmm;
    _bj_fv_chk(pmmp1, u, pmm, ok);
    if (l == m + 1) { return pmmp1; }
    var m_sq: f64 = m_f * m_f;
    var mp1: f64 = m_f + 1.0;
    var a0: f64 = (4.0 * mp1 * mp1 - 1.0) / (mp1 * mp1 - m_sq);
    var a_prev: f64 = f64_sqrt(a0);
    var pll: f64 = 0.0;
    for (var ll = m + 2; ll <= l; ll = ll + 1) {
        var ll_f: f64 = f64_from(ll);
        var an: f64 = (4.0 * ll_f * ll_f - 1.0) / (ll_f * ll_f - m_sq);
        var a: f64 = f64_sqrt(an);
        var xa: f64 = x * pmmp1;
        _bj_fv_chk(xa, x, pmmp1, ok);
        var pb: f64 = pmm / a_prev;
        _bj_fv_chk(pb, pmm, a_prev, ok);
        var inner: f64 = xa - pb;
        pll = a * inner;
        _bj_fv_chk(pll, a, inner, ok);
        pmm = pmmp1;
        pmmp1 = pll;
        a_prev = a;
    }
    return pll;
}

# The InvalidParameter of a moment's order: "|m| must be ≤ l, got l={l}, m={m}" (Rust's), and, Cyrius-only, l outside
# a u32 or m outside an i32 (the types Rust's signature gives them).
fn _bj_moment_order_error(l, m): i64 {
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    if (l < 0 || l > 4294967295 || m < 0 - 2147483648 || m > 2147483647) {
        _bj_tx_cstr(t, "l must be a u32 and m an i32, got l=");
    } else {
        _bj_tx_cstr(t, "|m| must be ≤ l, got l=");
    }
    _bj_tx_i64(t, l);
    _bj_tx_cstr(t, ", m=");
    _bj_tx_i64(t, m);
    return BJ_ERR_INVALID_PARAMETER;
}

# ── the multipoles with an unbounded exponent ──

# The spherical coordinates with an unbounded exponent, to 53 bits: r, cos θ, sin θ (clamped as Rust's) and φ (atan2,
# im/re below 2^-1022 as complex's arg) into s[0..3] and e[0..3]; 0 at the origin (every part 0), else 1.
fn _bj_ux_sph(pos: *f64, s: *f64, e: *i64): i64 {
    var x: f64 = pos[0];
    var y: f64 = pos[1];
    var z: f64 = pos[2];
    if (x == 0.0 && y == 0.0 && z == 0.0) { return 0; }
    var xs, xe = _bj_vx_mul(x, x);
    var ys, ye = _bj_vx_mul(y, y);
    var zs, ze = _bj_vx_mul(z, z);
    var r2s, r2e = _bj_k_ux_add(xs, xe, ys, ye);
    var ss, se = _bj_k_ux_add(r2s, r2e, zs, ze);
    var rs, re = _bj_k_ux_sqrt(ss, se);
    s[0] = rs;
    e[0] = re;
    var zps, zpe = _bj_k_ux_from(z);
    var cs, ce = _bj_k_ux_div(zps, zpe, rs, re);
    if (_bj_k_ux_cmp(cs, ce, 1.0, 0) == 1) {
        cs = 1.0;
        ce = 0;
    }
    if (_bj_k_ux_cmp(cs, ce, -1.0, 0) == 0 - 1) {
        cs = -1.0;
        ce = 0;
    }
    s[1] = cs;
    e[1] = ce;
    var hs, he = _bj_k_ux_sqrt(r2s, r2e);
    var ns, ne = _bj_k_ux_div(hs, he, rs, re);
    if (_bj_k_ux_cmp(ns, ne, 1.0, 0) == 1) {
        ns = 1.0;
        ne = 0;
    }
    s[2] = ns;
    e[2] = ne;
    var g: f64 = _bj_atan2(y, x);
    var gb = _bj_bits(g) & 0x7FFFFFFFFFFFFFFF;
    if (y == 0.0 || gb > 0x0010000000000000) {
        var as, ae = _bj_k_ux_from(g);
        s[3] = as;
        e[3] = ae;
    } else {
        var yys, yye = _bj_k_ux_from(y);
        var xxs, xxe = _bj_k_ux_from(x);
        var qs, qe = _bj_k_ux_div(yys, yye, xxs, xxe);
        s[3] = qs;
        e[3] = qe;
    }
    return 1;
}

# rˡ with an unbounded exponent, for r = rs·2^re > 0 and l ≥ 0: powi's square-and-multiply with each product to 53
# bits for l < 2^31, _bj_ux_pow above (as _bj_radial_power).
#must_use
fn _bj_ux_radial(rs: f64, re, l): (f64, i64) {
    if (l > 2147483647) {
        var lf: f64 = f64_from(l);
        var ps, pe = _bj_ux_pow(rs, re, lf);
        return (ps, pe);
    }
    var as: f64 = rs;
    var ae = re;
    var ms: f64 = 1.0;
    var me = 0;
    var p = l;
    loop {
        if ((p & 1) != 0) {
            var ns, ne = _bj_k_ux_mul(ms, me, as, ae);
            ms = ns;
            me = ne;
        }
        p = p >> 1;
        if (p == 0) { break; }
        var ts, te = _bj_k_ux_mul(as, ae, as, ae);
        as = ts;
        ae = te;
    }
    return (ms, me);
}

# P_l^m(x) with an unbounded exponent (x = xs·2^xe, s = ss·2^se): _bj_assoc_legendre_k's operations, each to 53 bits.
#must_use
fn _bj_ux_assoc_legendre(l, m, xs: f64, xe, ss: f64, se): (f64, i64) {
    if (m > l) { return (0.0, 0); }
    var ps: f64 = 1.0;
    var pe = 0;
    var fact: f64 = 1.0;
    for (var k = 0; k < m; k = k + 1) {
        var nf: f64 = -fact;
        var ts, te = _bj_k_ux_mul(nf, 0, ss, se);
        var ns, ne = _bj_k_ux_mul(ps, pe, ts, te);
        ps = ns;
        pe = ne;
        fact = fact + 2.0;
    }
    if (l == m) { return (ps, pe); }
    var m_f: f64 = f64_from(m);
    var c1: f64 = 2.0 * m_f + 1.0;
    var c1s, c1e = _bj_k_ux_from(c1);
    var us, ue = _bj_k_ux_mul(xs, xe, c1s, c1e);
    var qs, qe = _bj_k_ux_mul(us, ue, ps, pe);
    if (l == m + 1) { return (qs, qe); }
    var ls: f64 = 0.0;
    var le = 0;
    for (var ll = m + 2; ll <= l; ll = ll + 1) {
        var ll_f: f64 = f64_from(ll);
        var c2: f64 = 2.0 * ll_f - 1.0;
        var c2s, c2e = _bj_k_ux_from(c2);
        var u2s, u2e = _bj_k_ux_mul(xs, xe, c2s, c2e);
        var as, ae = _bj_k_ux_mul(u2s, u2e, qs, qe);
        var c3: f64 = ll_f + m_f - 1.0;
        var c3s, c3e = _bj_k_ux_from(c3);
        var bs, be = _bj_k_ux_mul(c3s, c3e, ps, pe);
        var ds, de = _bj_k_ux_sub(as, ae, bs, be);
        var c4: f64 = ll_f - m_f;
        var c4s, c4e = _bj_k_ux_from(c4);
        var rs, re = _bj_k_ux_div(ds, de, c4s, c4e);
        ls = rs;
        le = re;
        ps = qs;
        pe = qe;
        qs = rs;
        qe = re;
    }
    return (ls, le);
}

# P̄_l^m(x) with an unbounded exponent: _bj_norm_legendre_k's operations, each to 53 bits (its constants, all normal,
# are Rust's doubles).
#must_use
fn _bj_ux_norm_legendre(l, m, xs: f64, xe, ss: f64, se): (f64, i64) {
    if (m > l) { return (0.0, 0); }
    var ps: f64 = 1.0;
    var pe = 0;
    var nss: f64 = -ss;
    for (var k = 1; k <= m; k = k + 1) {
        var k_f: f64 = f64_from(k);
        var ratio: f64 = (2.0 * k_f - 1.0) / (2.0 * k_f);
        var sr: f64 = f64_sqrt(ratio);
        var srs, sre = _bj_k_ux_from(sr);
        var ts, te = _bj_k_ux_mul(nss, se, srs, sre);
        var ns, ne = _bj_k_ux_mul(ps, pe, ts, te);
        ps = ns;
        pe = ne;
    }
    var m_f: f64 = f64_from(m);
    var c0: f64 = (2.0 * m_f + 1.0) / (4.0 * _BJ_PI);
    var c: f64 = f64_sqrt(c0);
    var cs, ce = _bj_k_ux_from(c);
    var p3s, p3e = _bj_k_ux_mul(ps, pe, cs, ce);
    ps = p3s;
    pe = p3e;
    if (l == m) { return (ps, pe); }
    var c3: f64 = 2.0 * m_f + 3.0;
    var s3: f64 = f64_sqrt(c3);
    var s3s, s3e = _bj_k_ux_from(s3);
    var us, ue = _bj_k_ux_mul(xs, xe, s3s, s3e);
    var qs, qe = _bj_k_ux_mul(us, ue, ps, pe);
    if (l == m + 1) { return (qs, qe); }
    var m_sq: f64 = m_f * m_f;
    var mp1: f64 = m_f + 1.0;
    var a0: f64 = (4.0 * mp1 * mp1 - 1.0) / (mp1 * mp1 - m_sq);
    var a_prev: f64 = f64_sqrt(a0);
    var ls: f64 = 0.0;
    var le = 0;
    for (var ll = m + 2; ll <= l; ll = ll + 1) {
        var ll_f: f64 = f64_from(ll);
        var an: f64 = (4.0 * ll_f * ll_f - 1.0) / (ll_f * ll_f - m_sq);
        var a: f64 = f64_sqrt(an);
        var xas, xae = _bj_k_ux_mul(xs, xe, qs, qe);
        var aps, ape = _bj_k_ux_from(a_prev);
        var pbs, pbe = _bj_k_ux_div(ps, pe, aps, ape);
        var ins, ine = _bj_k_ux_sub(xas, xae, pbs, pbe);
        var as2, ae2 = _bj_k_ux_from(a);
        var rs, re = _bj_k_ux_mul(as2, ae2, ins, ine);
        ls = rs;
        le = re;
        ps = qs;
        pe = qe;
        qs = rs;
        qe = re;
        a_prev = a;
    }
    return (ls, le);
}

# A running sum with an unbounded exponent whose last addition rounds once: acc (s[0], e[0]) and the pending term
# (s[1], e[1]), with e[2] = 1 once a term is pending. _bj_ux_sum_add adds a term; _bj_ux_sum_fin rounds.
fn _bj_ux_sum_add(s: *f64, e: *i64, ts: f64, te) {
    if (e[2] == 1) {
        var ns, ne = _bj_k_ux_add(s[0], e[0], s[1], e[1]);
        s[0] = ns;
        e[0] = ne;
    }
    s[1] = ts;
    e[1] = te;
    e[2] = 1;
    return 0;
}

#must_use
fn _bj_ux_sum_fin(s: *f64, e: *i64): f64 {
    if (e[2] == 0) {
        var a: f64 = s[0];
        return a;
    }
    var r: f64 = _bj_k_ux_add_f64(s[0], e[0], s[1], e[1]);
    return r;
}

# The real moment at a range edge: every charge's term with an unbounded exponent, the sum's last addition rounded once.
#must_use
fn _bj_fv_multipole_edge(l, m, m_abs, charges: *f64, n): f64 {
    var m_f: f64 = f64_from(m_abs);
    var sm: f64[2];
    var em: i64[3];
    sm[0] = 0.0;
    em[0] = 0;
    em[2] = 0;
    var cs: f64[4];
    var ce: i64[4];
    for (var i = 0; i < n; i = i + 1) {
        var c: *f64 = charges + i * 4;
        var q: f64 = c[0];
        var qs, qe = _bj_k_ux_from(q);
        if (_bj_ux_sph(c + 1, &cs, &ce) == 0) {
            if (l == 0) { _bj_ux_sum_add(&sm, &em, qs, qe); }
        } else {
            var as, ae = _bj_k_ux_mul(m_f, 0, cs[3], ce[3]);
            var zs: f64 = 0.0;
            var ze = 0;
            if (m >= 0) {
                var c1s, c1e = _bj_vx_cos53(as, ae);
                zs = c1s;
                ze = c1e;
            } else {
                var s1s, s1e = _bj_vx_sin53(as, ae);
                zs = s1s;
                ze = s1e;
            }
            var rps, rpe = _bj_ux_radial(cs[0], ce[0], l);
            var pls, ple = _bj_ux_assoc_legendre(l, m_abs, cs[1], ce[1], cs[2], ce[2]);
            var t1s, t1e = _bj_k_ux_mul(qs, qe, rps, rpe);
            var t2s, t2e = _bj_k_ux_mul(t1s, t1e, pls, ple);
            var t3s, t3e = _bj_k_ux_mul(t2s, t2e, zs, ze);
            _bj_ux_sum_add(&sm, &em, t3s, t3e);
        }
    }
    var r: f64 = _bj_ux_sum_fin(&sm, &em);
    return r;
}

# M_lm = Σᵢ qᵢ·rᵢˡ·P_l^|m|(cos θᵢ)·{cos(mφᵢ) for m ≥ 0, sin(|m|φᵢ) for m < 0}, the unnormalized real moment (C·mˡ) of
# n charges at `charges` (32 bytes each: q, x, y, z), summed in order; a charge at the origin adds q to the monopole
# only. At a range edge the whole sum runs with an unbounded exponent and its last addition rounds once (ADR 0002 row
# 18). InvalidParameter when |m| > l. Mirrors `field::multipole_moment`.
public fn bj_multipole_moment(l, m, charges: *f64, n): Result {
    var m_abs = m;
    if (m < 0) { m_abs = 0 - m; }
    if (l < 0 || l > 4294967295 || m < 0 - 2147483648 || m > 2147483647 || m_abs > l) {
        return Err(_bj_moment_order_error(l, m));
    }
    var m_f: f64 = f64_from(m_abs);
    var moment: f64 = 0.0;
    var sc: f64[4];
    var ok = 1;
    for (var i = 0; i < n; i = i + 1) {
        var c: *f64 = charges + i * 4;
        var q: f64 = c[0];
        if (_bj_spherical_coords(c + 1, &sc, &ok) == 0) {
            if (l == 0) { moment = moment + q; }
        } else {
            var r: f64 = sc[0];
            var phi: f64 = sc[3];
            var ang: f64 = m_f * phi;
            _bj_fv_chk(ang, m_f, phi, &ok);
            var az: f64 = 0.0;
            if (m >= 0) { az = _bj_cos(ang); } else { az = _bj_sin(ang); }
            var rp: f64 = _bj_radial_power(r, l);
            var brp = (load64(&rp) >> 52) & 0x7FF;
            if (l != 0 && (brp < 2 || brp > 2046)) { ok = 0; }
            var pl: f64 = _bj_assoc_legendre_k(l, m_abs, sc[1], sc[2], &ok);
            var t1: f64 = q * rp;
            _bj_fv_chk(t1, q, rp, &ok);
            var t2: f64 = t1 * pl;
            _bj_fv_chk(t2, t1, pl, &ok);
            var term: f64 = t2 * az;
            _bj_fv_chk(term, t2, az, &ok);
            moment = moment + term;
        }
    }
    var bm = (load64(&moment) >> 52) & 0x7FF;
    if ((ok == 1 && bm != 2047) || _bj_vx_finite_n(charges, 4 * n) == 0) { return Ok(moment); }
    var u: f64 = _bj_fv_multipole_edge(l, m, m_abs, charges, n);
    return Ok(u);
}

# The spherical moment at a range edge, into out: every charge's w = q·rˡ·P̄ and its angle's sine and cosine with an
# unbounded exponent, Re and Im each summed with their last addition rounded once.
fn _bj_fv_sph_multipole_edge(l, m, m_abs, charges: *f64, n, out: *BjComplex) {
    var m_f: f64 = f64_from(m_abs);
    var neg_sign: f64 = 1.0;
    if ((m_abs & 1) == 1) { neg_sign = -1.0; }
    var sr: f64[2];
    var er: i64[3];
    var si: f64[2];
    var ei: i64[3];
    sr[0] = 0.0;
    er[0] = 0;
    er[2] = 0;
    si[0] = 0.0;
    ei[0] = 0;
    ei[2] = 0;
    var spi: f64 = f64_sqrt(_BJ_PI);
    var sps, spe = _bj_k_ux_from(spi);
    var cs: f64[4];
    var ce: i64[4];
    for (var i = 0; i < n; i = i + 1) {
        var c: *f64 = charges + i * 4;
        var q: f64 = c[0];
        var qs, qe = _bj_k_ux_from(q);
        if (_bj_ux_sph(c + 1, &cs, &ce) == 0) {
            if (l == 0) {
                var hs, he = _bj_k_ux_mul(qs, qe, 0.5, 0);
                var ys, ye = _bj_k_ux_div(hs, he, sps, spe);
                _bj_ux_sum_add(&sr, &er, ys, ye);
            }
        } else {
            var rps, rpe = _bj_ux_radial(cs[0], ce[0], l);
            var pls, ple = _bj_ux_norm_legendre(l, m_abs, cs[1], ce[1], cs[2], ce[2]);
            var t1s, t1e = _bj_k_ux_mul(qs, qe, rps, rpe);
            var ws, we = _bj_k_ux_mul(t1s, t1e, pls, ple);
            var as, ae = _bj_k_ux_mul(m_f, 0, cs[3], ce[3]);
            var vs, ve = _bj_vx_sin53(as, ae);
            var us, ue = _bj_vx_cos53(as, ae);
            if (m >= 0) {
                var wcs, wce = _bj_k_ux_mul(ws, we, us, ue);
                var wss, wse = _bj_k_ux_mul(ws, we, vs, ve);
                var nws: f64 = -wss;
                _bj_ux_sum_add(&sr, &er, wcs, wce);
                _bj_ux_sum_add(&si, &ei, nws, wse);
            } else {
                var gs, ge = _bj_k_ux_mul(neg_sign, 0, ws, we);
                var ncs, nce = _bj_k_ux_mul(gs, ge, us, ue);
                var nss, nse = _bj_k_ux_mul(gs, ge, vs, ve);
                _bj_ux_sum_add(&sr, &er, ncs, nce);
                _bj_ux_sum_add(&si, &ei, nss, nse);
            }
        }
    }
    var re: f64 = _bj_ux_sum_fin(&sr, &er);
    var im: f64 = _bj_ux_sum_fin(&si, &ei);
    out.re = re;
    out.im = im;
    return 0;
}

# q_lm = Σᵢ qᵢ·rᵢˡ·Y*_lm(θᵢ, φᵢ) (Jackson eq. 4.3, orthonormal Y with the CS phase), into out as (Re, Im):
# w·(cos mφ, −sin mφ) for m ≥ 0, and (−1)^|m|·w·(cos |m|φ, sin |m|φ) for m < 0, w = q·rˡ·P̄_l^|m|(cos θ); a charge at
# the origin adds q·0.5/√π to Re q₀₀ only. Static, so no time convention enters. At a range edge both sums run with an
# unbounded exponent, each last addition rounded once (ADR 0002 row 18). InvalidParameter when |m| > l. Mirrors
# `field::spherical_multipole_moment` (its `(f64, f64)` is a BjComplex here).
public fn bj_spherical_multipole_moment(l, m, charges: *f64, n, out: *BjComplex): Result {
    var m_abs = m;
    if (m < 0) { m_abs = 0 - m; }
    if (l < 0 || l > 4294967295 || m < 0 - 2147483648 || m > 2147483647 || m_abs > l) {
        return Err(_bj_moment_order_error(l, m));
    }
    var m_f: f64 = f64_from(m_abs);
    var neg_sign: f64 = 1.0;
    if ((m_abs & 1) == 1) { neg_sign = -1.0; }
    var re: f64 = 0.0;
    var im: f64 = 0.0;
    var sp: f64 = f64_sqrt(_BJ_PI);
    var sc: f64[4];
    var ok = 1;
    for (var i = 0; i < n; i = i + 1) {
        var c: *f64 = charges + i * 4;
        var q: f64 = c[0];
        if (_bj_spherical_coords(c + 1, &sc, &ok) == 0) {
            if (l == 0) {
                var qh: f64 = q * 0.5;
                _bj_fv_chk(qh, q, 0.5, &ok);
                var y00: f64 = qh / sp;
                _bj_fv_chk(y00, qh, sp, &ok);
                re = re + y00;
            }
        } else {
            var rp: f64 = _bj_radial_power(sc[0], l);
            var brp = (load64(&rp) >> 52) & 0x7FF;
            if (l != 0 && (brp < 2 || brp > 2046)) { ok = 0; }
            var pl: f64 = _bj_norm_legendre_k(l, m_abs, sc[1], sc[2], &ok);
            var t1: f64 = q * rp;
            _bj_fv_chk(t1, q, rp, &ok);
            var w: f64 = t1 * pl;
            _bj_fv_chk(w, t1, pl, &ok);
            var phi: f64 = sc[3];
            var ang: f64 = m_f * phi;
            _bj_fv_chk(ang, m_f, phi, &ok);
            var s, cs = _bj_sin_cos(ang);
            var sv: f64 = s;
            var cv: f64 = cs;
            if (m >= 0) {
                var wc: f64 = w * cv;
                var ws: f64 = w * sv;
                _bj_fv_chk(wc, w, cv, &ok);
                _bj_fv_chk(ws, w, sv, &ok);
                re = re + wc;
                im = im - ws;
            } else {
                var g: f64 = neg_sign * w;
                var nc: f64 = g * cv;
                var ns: f64 = g * sv;
                _bj_fv_chk(nc, g, cv, &ok);
                _bj_fv_chk(ns, g, sv, &ok);
                re = re + nc;
                im = im + ns;
            }
        }
    }
    out.re = re;
    out.im = im;
    var br = (load64(&re) >> 52) & 0x7FF;
    var bi = (load64(&im) >> 52) & 0x7FF;
    if ((ok == 1 && br != 2047 && bi != 2047) || _bj_vx_finite_n(charges, 4 * n) == 0) { return Ok(0); }
    _bj_fv_sph_multipole_edge(l, m, m_abs, charges, n, out);
    return Ok(0);
}

# ── method of images (M1 part 3b) ───────────────────────────────────────────────────────────────────────────────

# The image of a charge at `position` in a conducting plane z = plane_z: returns −charge, and writes the mirror
# point (x, y, 2·plane_z − z) to image_pos; where 2·plane_z overflows (|plane_z| ≥ 2^1023, z finite) the difference
# with an unbounded exponent, rounded once (ADR 0002 row 18). Mirrors `field::image_charge_plane` (its tuple: the
# charge returned, the position written).
#must_use
public fn bj_image_charge_plane(charge: f64, position: *f64, plane_z: f64, image_pos: *f64): f64 {
    var z: f64 = position[2];
    var image_z: f64 = 2.0 * plane_z - z;
    var bp = (_bj_bits(plane_z) >> 52) & 0x7FF;
    if (bp >= 2046 && bp != 2047 && _bj_is_finite(z) == 1) {
        var ps, pe = _bj_k_ux_from(plane_z);
        var zs, ze = _bj_k_ux_from(z);
        var iz: f64 = _bj_k_ux_sub_f64(ps, pe + 1, zs, ze);
        image_z = iz;
    }
    image_pos[0] = position[0];
    image_pos[1] = position[1];
    image_pos[2] = image_z;
    var q: f64 = -charge;
    return q;
}

# The image of a charge at `position` outside a grounded sphere of radius R at the origin: Ok(q' = −(R/d)·q), and the
# position (R²/d²)·r into image_pos (Griffiths Ex. 3.2). InvalidParameter when R is not positive and finite, or the
# charge is not strictly outside (a NaN position included). At a range edge the chain runs with an unbounded exponent,
# the comparison with R included, each output rounded once (ADR 0002 row 18). Mirrors `field::image_charge_sphere`.
public fn bj_image_charge_sphere(charge: f64, position: *f64, sphere_radius: f64, image_pos: *f64): Result {
    if (!(sphere_radius > 0.0 && _bj_is_finite(sphere_radius) == 1)) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "sphere radius must be positive and finite, got ");
        _bj_fmt_f64_display(t, sphere_radius);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var d_sq: f64 = position[0] * position[0] + position[1] * position[1] + position[2] * position[2];
    var d: f64 = f64_sqrt(d_sq);
    # |r|² in the band makes Rust's |r| the unbounded chain's, and with it the comparison; outside it (a finite
    # position) the whole chain, the comparison included, runs with an unbounded exponent (ADR 0002 row 18).
    var e1 = (load64(&d_sq) >> 52) & 0x7FF;
    if (e1 < 123 || e1 > 2046) {
        if (_bj_vx_finite_n(position, 3) == 1 && _bj_is_finite(charge) == 1) {
            var rt, rv = _bj_fv_sphere_edge(charge, position, sphere_radius, image_pos);
            if (is_err_result(rt) == 1) { return Err(rv); }
            return Ok(rv);
        }
    }
    if (d != d || d <= sphere_radius) { return Err(_bj_fv_sphere_err(d, sphere_radius)); }
    var ratio: f64 = sphere_radius / d;
    var nq: f64 = -charge;
    var q_image: f64 = nq * ratio;
    var scale: f64 = ratio * ratio;
    image_pos[0] = position[0] * scale;
    image_pos[1] = position[1] * scale;
    image_pos[2] = position[2] * scale;
    var e2 = (load64(&ratio) >> 52) & 0x7FF;
    var e3 = (load64(&scale) >> 52) & 0x7FF;
    var w = (e2 - 2) | (2046 - e2) | (e3 - 2) | (2046 - e3);
    if (w >= 0 || _bj_is_finite(charge) == 0) { return Ok(q_image); }
    var r2t, r2v = _bj_fv_sphere_edge(charge, position, sphere_radius, image_pos);
    if (is_err_result(r2t) == 1) { return Err(r2v); }
    return Ok(r2v);
}

# The sphere image's InvalidParameter, "charge must be outside the sphere (|r| = d > R = R)".
fn _bj_fv_sphere_err(d: f64, rr: f64): i64 {
    var t2 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t2, "charge must be outside the sphere (|r| = ");
    _bj_fmt_f64_display(t2, d);
    _bj_tx_cstr(t2, " > R = ");
    _bj_fmt_f64_display(t2, rr);
    _bj_tx_putc(t2, 41);
    return BJ_ERR_INVALID_PARAMETER;
}

# The sphere image at a range edge: |r| with an unbounded exponent, compared with R exactly (the error then reports
# |r| rounded once), R/|r| and (R/|r|)² with one, each output product rounded once.
fn _bj_fv_sphere_edge(charge: f64, p: *f64, rr: f64, image_pos: *f64): Result {
    var ss, se = _bj_vx_sumsq(p[0], p[1], p[2]);
    var ds, de = _bj_k_ux_sqrt(ss, se);
    var Rs, Re = _bj_k_ux_from(rr);
    if (_bj_k_ux_le(ds, de, Rs, Re) == 1) {
        var dd: f64 = _bj_k_ux_round(ds, de, 0.0);
        return Err(_bj_fv_sphere_err(dd, rr));
    }
    var qs, qe = _bj_k_ux_div(Rs, Re, ds, de);
    var nq: f64 = -charge;
    var ns, ne = _bj_k_ux_from(nq);
    var qi: f64 = _bj_k_ux_mul_f64(ns, ne, qs, qe);
    var cs, ce = _bj_k_ux_mul(qs, qe, qs, qe);
    for (var i = 0; i < 3; i = i + 1) {
        var xs, xe = _bj_k_ux_from(p[i]);
        var o: f64 = _bj_k_ux_mul_f64(xs, xe, cs, ce);
        image_pos[i] = o;
    }
    return Ok(qi);
}

# The image of a charge at height z > 0 over a dielectric half-space (Jackson §4.4): Ok(q' = −q(ε₂ − ε₁)/(ε₁ + ε₂)),
# and the mirror point (x, y, −z) into image_pos. InvalidParameter when z is not positive and finite, then
# InvalidPermittivity for the first of ε₁, ε₂ that is not positive and finite. Where the product −q·(ε₂ − ε₁) or the
# sum ε₁ + ε₂ leaves the normal range (a finite q), the chain runs with an unbounded exponent and the quotient is
# rounded once (ADR 0002 row 18). Mirrors `field::image_charge_dielectric`.
public fn bj_image_charge_dielectric(charge: f64, position: *f64, eps_r1: f64, eps_r2: f64, image_pos: *f64): Result {
    var z: f64 = position[2];
    if (!(z > 0.0 && _bj_is_finite(z) == 1)) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "charge must be in medium 1 (z > 0) for dielectric image method, got z = ");
        _bj_fmt_f64_display(t, z);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (!(eps_r1 > 0.0 && _bj_is_finite(eps_r1) == 1)) { return Err(_bj_err_invalid_permittivity(eps_r1)); }
    if (!(eps_r2 > 0.0 && _bj_is_finite(eps_r2) == 1)) { return Err(_bj_err_invalid_permittivity(eps_r2)); }
    var nq: f64 = -charge;
    var diff: f64 = eps_r2 - eps_r1;
    var num: f64 = nq * diff;
    var den: f64 = eps_r1 + eps_r2;
    var q_image: f64 = num / den;
    if (_bj_is_finite(charge) == 1 && _bj_fv_dielectric_plain(nq, diff, num, den) == 0) {
        var ns, ne = _bj_k_ux_from(nq);
        var e1s, e1e = _bj_k_ux_from(eps_r1);
        var e2s, e2e = _bj_k_ux_from(eps_r2);
        var ds, de = _bj_k_ux_sub(e2s, e2e, e1s, e1e);
        var ms, me = _bj_k_ux_mul(ns, ne, ds, de);
        var ss, se = _bj_k_ux_add(e1s, e1e, e2s, e2e);
        var qi: f64 = _bj_k_ux_div_f64(ms, me, ss, se);
        q_image = qi;
    }
    image_pos[0] = position[0];
    image_pos[1] = position[1];
    image_pos[2] = -z;
    return Ok(q_image);
}

# 1 when the dielectric image's binary64 chain is the unbounded one (ε₁, ε₂ positive normal doubles): the sum below
# DBL_MAX, the product of −q and the difference exactly 0 (one factor 0) or normal and above 2^-1022; the difference
# of two positive doubles is exact wherever it is small, so it needs no test.
#must_use
fn _bj_fv_dielectric_plain(nq: f64, diff: f64, num: f64, den: f64): i64 {
    var bd = _bj_bits(den) >> 52;
    if (bd >= 2047) { return 0; }
    var bn = _bj_bits(num) & 0x7FFFFFFFFFFFFFFF;
    if (bn == 0) {
        if (nq == 0.0 || diff == 0.0) { return 1; }
        return 0;
    }
    if (bn <= 0x0010000000000000 || bn >= 0x7FF0000000000000) { return 0; }
    return 1;
}

# ── Green's functions (M1 part 3b) ──────────────────────────────────────────────────────────────────────────────

# (4π)·R for R = |f − c| with an unbounded exponent, to 53 bits: (s, e) (the Green's functions at a range edge).
#must_use
fn _bj_fv_green_den_ux(f: *f64, c: *f64): (f64, i64) {
    var o: f64[5];
    var oe: i64[5];
    _bj_vx_offset_ux(f, c, &o, &oe);
    var four_pi: f64 = 4.0 * _BJ_PI;
    var ps, pe = _bj_k_ux_from(four_pi);
    var ds, de = _bj_k_ux_mul(ps, pe, o[3], oe[3]);
    return (ds, de);
}

# The scalar Green's function at a range edge, into out: R, 4πR, its reciprocal and k·R with an unbounded exponent, the
# cosine and sine of the 53-bit k·R (past DBL_MAX by _bj_vx_cos53, _bj_vx_sin53), each product rounded once.
fn _bj_fv_green_scalar_edge(f: *f64, c: *f64, k: f64, out: *BjComplex) {
    var o: f64[5];
    var oe: i64[5];
    _bj_vx_offset_ux(f, c, &o, &oe);
    var four_pi: f64 = 4.0 * _BJ_PI;
    var ps, pe = _bj_k_ux_from(four_pi);
    var ds, de = _bj_k_ux_mul(ps, pe, o[3], oe[3]);
    var fs, fe = _bj_k_ux_div(1.0, 0, ds, de);
    var ks, ke = _bj_k_ux_from(k);
    var ts, te = _bj_k_ux_mul(ks, ke, o[3], oe[3]);
    var cs, ce = _bj_vx_cos53(ts, te);
    var ss, se = _bj_vx_sin53(ts, te);
    var re: f64 = _bj_k_ux_mul_f64(fs, fe, cs, ce);
    var im: f64 = _bj_k_ux_mul_f64(fs, fe, ss, se);
    out.re = re;
    out.im = -im;
    return 0;
}

# G(r, r') = e^{−jkR}/(4πR), the free-space scalar Green's function of the outgoing wave in bijli's e^{+jωt}
# convention (src/complex.cyr), into out: (cos kR, −sin kR)/(4πR). Rust's e^{+ikR}/(4πR) was the e^{−iωt} form, so the
# port's value is its conjugate (ADR 0002 row 5). At a range edge (4πR past DBL_MAX, 1/(4πR) or kR outside the normal
# range) the chain runs with an unbounded exponent, kR's cosine and sine included, each product rounded once (row 18).
# Singularity when the exact R < 10^-30 (row 17). Mirrors `field::greens_function_scalar` (its `(f64, f64)` is a
# BjComplex here).
public fn bj_greens_function_scalar(field_pos: *f64, source_pos: *f64, k: f64, out: *BjComplex): Result {
    var dx: f64 = field_pos[0] - source_pos[0];
    var dy: f64 = field_pos[1] - source_pos[1];
    var dz: f64 = field_pos[2] - source_pos[2];
    var s: f64 = dx * dx + dy * dy + dz * dz;
    var r: f64 = f64_sqrt(s);
    var band = _bj_x_band(r, _BJ_FIELD_R2_MIN);
    if (band == 2) { band = _bj_x_r2_below(field_pos, source_pos, 60); }
    if (band == 1) {
        return Err(_bj_err_singularity());
    }
    var d: f64 = 4.0 * _BJ_PI * r;
    var factor: f64 = 1.0 / d;
    var kr: f64 = k * r;
    var c: f64 = _bj_cos(kr);
    var sn: f64 = _bj_sin(kr);
    var im: f64 = factor * sn;
    out.re = factor * c;
    out.im = -im;
    var e1 = (load64(&d) >> 52) & 0x7FF;
    var e2 = (load64(&factor) >> 52) & 0x7FF;
    var e3 = (load64(&kr) >> 52) & 0x7FF;
    if (((2046 - e1) | (e2 - 2) | (2046 - e2) | (e3 - 2) | (2046 - e3)) >= 0) { return Ok(0); }
    var p: f64[7];
    for (var i = 0; i < 3; i = i + 1) {
        p[i] = field_pos[i];
        p[3 + i] = source_pos[i];
    }
    p[6] = k;
    if (_bj_vx_finite_n(&p, 7) == 0) { return Ok(0); }
    if (k == 0.0 && ((2046 - e1) | (e2 - 2) | (2046 - e2)) >= 0) { return Ok(0); }
    _bj_fv_green_scalar_edge(field_pos, source_pos, k, out);
    return Ok(0);
}

# G(r, r') = 1/(4πR), the static Green's function (k = 0); where 4πR passes DBL_MAX, R and 4πR with an unbounded
# exponent and the quotient rounded once (ADR 0002 row 18). Singularity when the exact R < 10^-30 (row 17). Mirrors
# `field::greens_function_static`.
public fn bj_greens_function_static(field_pos: *f64, source_pos: *f64): Result {
    var dx: f64 = field_pos[0] - source_pos[0];
    var dy: f64 = field_pos[1] - source_pos[1];
    var dz: f64 = field_pos[2] - source_pos[2];
    var s: f64 = dx * dx + dy * dy + dz * dz;
    var r: f64 = f64_sqrt(s);
    var band = _bj_x_band(r, _BJ_FIELD_R2_MIN);
    if (band == 2) { band = _bj_x_r2_below(field_pos, source_pos, 60); }
    if (band == 1) {
        return Err(_bj_err_singularity());
    }
    var d: f64 = 4.0 * _BJ_PI * r;
    var g: f64 = 1.0 / d;
    var e1 = (load64(&d) >> 52) & 0x7FF;
    if (e1 <= 2046) { return Ok(g); }
    var p: f64[6];
    for (var i = 0; i < 3; i = i + 1) {
        p[i] = field_pos[i];
        p[3 + i] = source_pos[i];
    }
    if (_bj_vx_finite_n(&p, 6) == 0) { return Ok(g); }
    var ds, de = _bj_fv_green_den_ux(field_pos, source_pos);
    var u: f64 = _bj_k_ux_div_f64(1.0, 0, ds, de);
    return Ok(u);
}

# ── the Maxwell stress tensor (M1 part 3b) ──────────────────────────────────────────────────────────────────────

# T_ij = ε₀(EᵢEⱼ − ½δᵢⱼE²) + (1/μ₀)(BᵢBⱼ − ½δᵢⱼB²) (Pa) into out, 9 f64 row-major (Rust's `[[f64; 3]; 3]`). With
# every part of E and B ±0 or in [2^-250, 2^251) each product, E², B² and their halves, each difference and its product
# by ε₀ or 1/μ₀ is normal or an exact 0 (a difference that small is exact), so Rust's chain is the unbounded one; any
# other finite part takes the chain with an unbounded exponent, each element's sum rounded once (ADR 0002 row 18).
# Mirrors `field::maxwell_stress_tensor`.
public fn bj_maxwell_stress_tensor(e: BjFieldVector, b: BjFieldVector, out: *f64): i64 {
    var ea: f64[3];
    var ba: f64[3];
    e.to_array(&ea);
    b.to_array(&ba);
    var e_sq: f64 = _bj_fv_dot_rust(e, e);
    var b_sq: f64 = _bj_fv_dot_rust(b, b);
    var inv_mu0: f64 = 1.0 / BJ_MU_0;
    for (var i = 0; i < 3; i = i + 1) {
        for (var j = 0; j < 3; j = j + 1) {
            var delta: f64 = 0.0;
            if (i == j) { delta = 1.0; }
            var te: f64 = ea[i] * ea[j] - 0.5 * delta * e_sq;
            var tb: f64 = ba[i] * ba[j] - 0.5 * delta * b_sq;
            var t1: f64 = BJ_EPSILON_0 * te;
            var t2: f64 = inv_mu0 * tb;
            out[i * 3 + j] = t1 + t2;
        }
    }
    # The box, branch-free: per part a negative word when it is ±0 or its biased exponent is in [773, 1273); w < 0
    # when every part's is.
    var e0: f64 = ea[0];
    var e1: f64 = ea[1];
    var e2: f64 = ea[2];
    var b0: f64 = ba[0];
    var b1: f64 = ba[1];
    var b2: f64 = ba[2];
    var w = _bj_fv_box1(load64(&e0) & 0x7FFFFFFFFFFFFFFF) & _bj_fv_box1(load64(&e1) & 0x7FFFFFFFFFFFFFFF);
    w = w & _bj_fv_box1(load64(&e2) & 0x7FFFFFFFFFFFFFFF) & _bj_fv_box1(load64(&b0) & 0x7FFFFFFFFFFFFFFF);
    w = w & _bj_fv_box1(load64(&b1) & 0x7FFFFFFFFFFFFFFF) & _bj_fv_box1(load64(&b2) & 0x7FFFFFFFFFFFFFFF);
    if (w < 0) { return 0; }
    var p: f64[6];
    for (var k = 0; k < 3; k = k + 1) {
        p[k] = ea[k];
        p[3 + k] = ba[k];
    }
    if (_bj_vx_finite_n(&p, 6) == 0) { return 0; }
    _bj_fv_stress_edge(&ea, &ba, inv_mu0, out);
    return 0;
}

# The stress tensor's box test for one part's magnitude bits a: negative when a = 0 (a − 1 < 0) or its biased exponent
# is in [773, 1273) (~((a − 773·2^52) | (1273·2^52 − 1 − a)) < 0), where every product and sum of the chain is normal
# or an exact 0.
#inline
#must_use
fn _bj_fv_box1(a): i64 {
    return (0 - 1 - ((a - 0x3050000000000000) | (0x4F8FFFFFFFFFFFFF - a))) | (a - 1);
}

# The stress tensor at a range edge, into out: E², B², each product, half-square, difference and its product by ε₀ or
# 1/μ₀ with an unbounded exponent, each element's sum rounded once.
fn _bj_fv_stress_edge(ea: *f64, ba: *f64, inv_mu0: f64, out: *f64) {
    var es, ee = _bj_vx_sumsq(ea[0], ea[1], ea[2]);
    var bs, be = _bj_vx_sumsq(ba[0], ba[1], ba[2]);
    var hes, hee = _bj_k_ux_mul(0.5, 0, es, ee);
    var hbs, hbe = _bj_k_ux_mul(0.5, 0, bs, be);
    var eps_s, eps_e = _bj_k_ux_from(BJ_EPSILON_0);
    var mus, mue = _bj_k_ux_from(inv_mu0);
    for (var i = 0; i < 3; i = i + 1) {
        for (var j = 0; j < 3; j = j + 1) {
            var ps, pe = _bj_vx_mul(ea[i], ea[j]);
            var qs, qe = _bj_vx_mul(ba[i], ba[j]);
            var ts: f64 = ps;
            var tt = pe;
            var us: f64 = qs;
            var uu = qe;
            if (i == j) {
                var d1s, d1e = _bj_k_ux_sub(ps, pe, hes, hee);
                var d2s, d2e = _bj_k_ux_sub(qs, qe, hbs, hbe);
                ts = d1s;
                tt = d1e;
                us = d2s;
                uu = d2e;
            } else {
                # a − 0·E²: the difference with +0 (Rust's 0.5·0·E² is +0 for a finite E²).
                var z1s, z1e = _bj_k_ux_sub(ps, pe, 0.0, 0);
                var z2s, z2e = _bj_k_ux_sub(qs, qe, 0.0, 0);
                ts = z1s;
                tt = z1e;
                us = z2s;
                uu = z2e;
            }
            var t1s, t1e = _bj_k_ux_mul(eps_s, eps_e, ts, tt);
            var t2s, t2e = _bj_k_ux_mul(mus, mue, us, uu);
            var r: f64 = _bj_k_ux_add_f64(t1s, t1e, t2s, t2e);
            out[i * 3 + j] = r;
        }
    }
    return 0;
}

# Fᵢ = Σⱼ Tᵢⱼnⱼ (N/m²), the force per unit area on a surface of outward normal n, each sum from 0 in j order. `tensor`
# is 9 f64, row-major. Each component is a dot product, so src/crmath_vx.cyr's guard applies: a sum in [2^-900,
# DBL_MAX], or an exact 0 from exact products, is the unbounded chain's; any other, with finite parts, runs with an
# unbounded exponent and its last sum rounds once (ADR 0002 row 18). Mirrors `field::stress_tensor_force`.
#must_use
public fn bj_stress_tensor_force(tensor: *f64, normal: BjFieldVector): BjFieldVector {
    var n: f64[3];
    normal.to_array(&n);
    var f: f64[3];
    for (var i = 0; i < 3; i = i + 1) {
        var acc: f64 = 0.0;
        for (var j = 0; j < 3; j = j + 1) {
            var tij: f64 = tensor[i * 3 + j];
            var nj: f64 = n[j];
            acc = acc + tij * nj;
        }
        f[i] = acc;
        var aa: f64 = f64_abs(acc);
        if (!(aa >= _BJ_VX_LO && aa <= _BJ_VX_HI)) { f[i] = _bj_fv_force_edge(tensor, &n, i, acc); }
    }
    var v: BjFieldVector = BjFieldVector_new(f[0], f[1], f[2]);
    return v;
}

# Component i of the force outside the band: Rust's acc for a part not finite (anywhere in the call) or an exact 0 from
# exact products, else Σⱼ Tᵢⱼnⱼ with an unbounded exponent, the last sum rounded once.
#must_use
fn _bj_fv_force_edge(tensor: *f64, n: *f64, i, acc: f64): f64 {
    if (_bj_vx_finite_n(tensor, 9) == 0 || _bj_vx_finite_n(n, 3) == 0) { return acc; }
    if (acc == 0.0) {
        var e = 0;
        for (var j = 0; j < 3; j = j + 1) {
            var tij: f64 = tensor[i * 3 + j];
            var nj: f64 = n[j];
            var p: f64 = tij * nj;
            e = e + _bj_vx_exact(tij, nj, p);
        }
        if (e == 3) { return acc; }
    }
    var as: f64 = 0.0;
    var ae = 0;
    for (var j2 = 0; j2 < 2; j2 = j2 + 1) {
        var ts, te = _bj_vx_mul(tensor[i * 3 + j2], n[j2]);
        var ns, ne = _bj_k_ux_add(as, ae, ts, te);
        as = ns;
        ae = ne;
    }
    var ls, le = _bj_vx_mul(tensor[i * 3 + 2], n[2]);
    var r: f64 = _bj_k_ux_add_f64(as, ae, ls, le);
    return r;
}

# Clears *ok unless the binary64 result r = a ⊗ b (a product or quotient) is the unbounded chain's value: normal and
# above 2^-1022, or 0 with a zero operand.
fn _bj_fv_chk(r: f64, a: f64, b: f64, ok: *i64) {
    var x = load64(&r) & 0x7FFFFFFFFFFFFFFF;
    if (x == 0) {
        if (a != 0.0 && b != 0.0) { ok[0] = 0; }
        return 0;
    }
    var be = x >> 52;
    if (be < 2 || be > 2046) { ok[0] = 0; }
    return 0;
}

# P ≈ Σ ((E × B)·(1/μ₀))·n̂·ΔA (W), the Poynting flux through a closed surface from n samples, each 10 f64 at
# `samples` (E, B, the outward normal, ΔA: Rust's `(FieldVector, FieldVector, FieldVector, f64)`), summed in order
# from 0. The chain is sums of products three deep (E × B, then the dot product with n̂ of its scaling, then the sum
# of each by ΔA), so src/crmath_vx.cyr's guard applies at each: a cross component, a dot product and the total in
# [2^-900, DBL_MAX], or an exact 0 from exact products, is the unbounded chain's. Anything else, with finite parts,
# runs the whole sum with an unbounded exponent, its last addition rounded once (ADR 0002 row 18). Mirrors
# `field::poynting_flux_surface`.
#must_use
public fn bj_poynting_flux_surface(samples: *f64, n): f64 {
    var inv_mu0: f64 = 1.0 / BJ_MU_0;
    var total: f64 = 0.0;
    var ok = 1;
    var tz = 1;
    for (var i = 0; i < n; i = i + 1) {
        var p: *f64 = samples + i * 10;
        var e: BjFieldVector = BjFieldVector_from_array(p);
        var b: BjFieldVector = BjFieldVector_from_array(p + 3);
        var nv: BjFieldVector = BjFieldVector_from_array(p + 6);
        var da: f64 = p[9];
        var cr: BjFieldVector = _bj_fv_cross_rust(e, b);
        var s: BjFieldVector = cr.scale(inv_mu0);
        var dt: f64 = _bj_fv_dot_rust(s, nv);
        var term: f64 = dt * da;
        total = total + term;
        # The band test inline (each cross component and dt); a miss takes the full test.
        var c0: f64 = f64_abs(cr.x);
        var c1: f64 = f64_abs(cr.y);
        var c2: f64 = f64_abs(cr.z);
        var ad: f64 = f64_abs(dt);
        var lo: f64 = _BJ_VX_LO;
        var hi: f64 = _BJ_VX_HI;
        if (!(c0 >= lo && c0 <= hi && c1 >= lo && c1 <= hi && c2 >= lo && c2 <= hi && ad >= lo && ad <= hi)) {
            if (ok == 1 && _bj_fv_poynting_ok(p, cr, s, dt) == 0) { ok = 0; }
        }
        var am: f64 = f64_abs(term);
        if (!(dt == 0.0 || da == 0.0 || (am > _BJ_VX_MN && am <= hi))) { tz = 0; }
    }
    var at: f64 = f64_abs(total);
    if (ok == 1 && ((at >= _BJ_VX_LO && at <= _BJ_VX_HI) || (total == 0.0 && tz == 1))) { return total; }
    if (_bj_vx_finite_n(samples, 10 * n) == 0) { return total; }
    var u: f64 = _bj_fv_poynting_edge(samples, n, inv_mu0);
    return u;
}

# 1 when one Poynting sample's cross product cr = E × B and dot product dt = (cr·(1/μ₀))·n̂ (s the scaled cross product)
# are the unbounded chain's: each in [2^-900, DBL_MAX] or an exact 0 from exact products (src/crmath_vx.cyr's guard).
#must_use
fn _bj_fv_poynting_ok(p: *f64, cr: BjFieldVector, s: BjFieldVector, dt: f64): i64 {
    var c: f64[3];
    c[0] = cr.x;
    c[1] = cr.y;
    c[2] = cr.z;
    for (var k = 0; k < 3; k = k + 1) {
        var ck: f64 = c[k];
        var ak: f64 = f64_abs(ck);
        if (!(ak >= _BJ_VX_LO && ak <= _BJ_VX_HI)) {
            if (ck != 0.0) { return 0; }
            var j1 = (k + 1) % 3;
            var j2 = (k + 2) % 3;
            var a1: f64 = p[j1];
            var b1: f64 = p[3 + j2];
            var a2: f64 = p[j2];
            var b2: f64 = p[3 + j1];
            var x1: f64 = a1 * b1;
            var x2: f64 = a2 * b2;
            if (_bj_vx_exact(a1, b1, x1) == 0 || _bj_vx_exact(a2, b2, x2) == 0) { return 0; }
        }
    }
    var ad: f64 = f64_abs(dt);
    if (ad >= _BJ_VX_LO && ad <= _BJ_VX_HI) { return 1; }
    if (dt != 0.0) { return 0; }
    var sa: f64[3];
    sa[0] = s.x;
    sa[1] = s.y;
    sa[2] = s.z;
    for (var k2 = 0; k2 < 3; k2 = k2 + 1) {
        var sk: f64 = sa[k2];
        var nk: f64 = p[6 + k2];
        var dk: f64 = sk * nk;
        if (_bj_vx_exact(sk, nk, dk) == 0) { return 0; }
    }
    return 1;
}

# The Poynting sum at a range edge: each sample's cross product, its scaling, the dot product and the area's product
# with an unbounded exponent, the sum from 0 with one, the last addition rounded once.
#must_use
fn _bj_fv_poynting_edge(samples: *f64, n, inv_mu0: f64): f64 {
    var ms, me = _bj_k_ux_from(inv_mu0);
    var acs: f64 = 0.0;
    var ace = 0;
    var fin: f64 = 0.0;
    for (var i = 0; i < n; i = i + 1) {
        var p: *f64 = samples + i * 10;
        var dts: f64 = 0.0;
        var dte = 0;
        for (var k = 0; k < 3; k = k + 1) {
            var j1 = (k + 1) % 3;
            var j2 = (k + 2) % 3;
            var cs, ce = _bj_vx_cross1(p[j1], p[3 + j2], p[j2], p[3 + j1]);
            var ss, se = _bj_k_ux_mul(cs, ce, ms, me);
            var ns, ne = _bj_k_ux_from(p[6 + k]);
            var ds, de = _bj_k_ux_mul(ss, se, ns, ne);
            if (k == 0) {
                dts = ds;
                dte = de;
            } else {
                var ts, te = _bj_k_ux_add(dts, dte, ds, de);
                dts = ts;
                dte = te;
            }
        }
        var as, ae = _bj_k_ux_from(p[9]);
        var ws, we = _bj_k_ux_mul(dts, dte, as, ae);
        if (i == n - 1) {
            var r: f64 = _bj_k_ux_add_f64(acs, ace, ws, we);
            fin = r;
        } else {
            var us, ue = _bj_k_ux_add(acs, ace, ws, we);
            acs = us;
            ace = ue;
        }
    }
    return fin;
}

# ── field lines (M1 part 3c) ────────────────────────────────────────────────────────────────────────────────────

# A polyline of 3D points, a caller-owned growable buffer (Rust's `Vec<[f64; 3]>`, port plan §9.5): `pts` the address
# of 3·cap f64 from fl_alloc (0 while empty), `len` the points in use. Make one with BjPolyline_new, reuse it across
# calls (its buffer is kept), and give it back with BjPolyline_free.
public struct BjPolyline {
    pts;
    len;
    cap;
}

# The address a as a *f64 (an untyped word stored into a typed pointer warns; a typed return does not).
#must_use
fn _bj_f64p(a): *f64 {
    return a;
}

# An empty polyline (no buffer yet).
#must_use
public fn BjPolyline_new(): BjPolyline {
    var p: BjPolyline;
    p.pts = 0;
    p.len = 0;
    p.cap = 0;
    return p;
}

# Frees p's buffer and empties it.
public fn BjPolyline_free(p: *BjPolyline): i64 {
    if (p.pts != 0) { fl_free(p.pts); }
    p.pts = 0;
    p.len = 0;
    p.cap = 0;
    return 0;
}

impl BjPolyline {
    # The number of points.
    #must_use
    public fn count(self): i64 {
        return self.len;
    }

    # The address of point i's three f64 (0 ≤ i < count).
    #must_use
    public fn at(self, i): *f64 {
        var a: *f64 = _bj_f64p(self.pts + i * 24);
        return a;
    }
}

# Room in p for n points (p's points kept): 1, or 0 when the allocation fails. Grows to n, or to twice p's capacity
# when that is more.
fn _bj_poly_reserve(p: *BjPolyline, n): i64 {
    if (n <= p.cap) { return 1; }
    var c = p.cap * 2;
    if (c < n) { c = n; }
    var buf = fl_alloc(c * 24);
    if (buf == 0) { return 0; }
    if (p.pts != 0) {
        memcpy(buf, p.pts, p.len * 24);
        fl_free(p.pts);
    }
    p.pts = buf;
    p.cap = c;
    return 1;
}

# Appends point q (three f64) to p: 1, or 0 when p can't grow.
fn _bj_poly_push(p: *BjPolyline, q: *f64): i64 {
    if (p.len == p.cap && _bj_poly_reserve(p, p.len + 1) == 0) { return 0; }
    var a: *f64 = _bj_f64p(p.pts + p.len * 24);
    a[0] = q[0];
    a[1] = q[1];
    a[2] = q[2];
    p.len = p.len + 1;
    return 1;
}

# Rust's TRACE_INITIAL_CAPACITY: the first reservation is min(max_steps + 1, 4096) points; the buffer grows beyond.
var _BJ_TRACE_INITIAL_CAPACITY = 4096;

# One field-line step at a range edge: pos_i ← pos_i + h·F_i/|F|, with |F|² (each square and sum), |F|, each quotient
# and each product to 53 bits with an unbounded exponent, and each new position rounded once (ADR 0002 row 18). F is
# finite and nonzero, h positive and finite.
fn _bj_fv_trace_edge(fx: f64, fy: f64, fz: f64, h: f64, pos: *f64) {
    var ms, me = _bj_vx_sumsq(fx, fy, fz);
    var mg, mge = _bj_k_ux_sqrt(ms, me);
    var hs, he = _bj_k_ux_from(h);
    var f: f64[3];
    f[0] = fx;
    f[1] = fy;
    f[2] = fz;
    for (var i = 0; i < 3; i = i + 1) {
        var fs, fe = _bj_k_ux_from(f[i]);
        var ds, de = _bj_k_ux_div(fs, fe, mg, mge);
        var ts, te = _bj_k_ux_mul(hs, he, ds, de);
        var ps, pe = _bj_k_ux_from(pos[i]);
        var r: f64 = _bj_k_ux_add_f64(ps, pe, ts, te);
        pos[i] = r;
    }
    return 0;
}

# Traces a field line from `start` by forward Euler, x ← x + h·F(x)/|F(x)|, into out (emptied first): `start`, then
# one point per step, at most max_steps + 1 points. `max_steps` is Rust's usize, its 64 bits unsigned: −1 is usize::MAX.
# `field_fn` is called through callptr as `field_fn(pos, f)`, pos the three f64 of the position and f a *BjFieldVector
# to fill; it returns BJ_ERR_NONE, or a BJ_ERR_* code with its error recorded (Rust's `Fn([f64; 3]) ->
# Result<FieldVector>`: a Result can't pass through callptr, plan §9.3). The line stops early, Ok, at a null point
# (a zero field), when field_fn returns Singularity (a source or sink), or at a field with an infinite component. At a
# range edge a step runs with an unbounded exponent, each new position rounded once (ADR 0002 row 18).
# Errors: InvalidParameter when step_size is not positive and finite, start is not finite, or field_fn returns a NaN
# component; any other error of field_fn's is returned as is; Allocation when out can't grow (Rust aborts there; ADR
# 0002 row 9). On an error out is empty. A success leaves the last-error record as field_fn left it. Mirrors
# `field::trace_field_line`.
public fn bj_trace_field_line(start: *f64, step_size: f64, max_steps, field_fn, out: *BjPolyline): Result {
    out.len = 0;
    if (!(step_size > 0.0 && _bj_is_finite(step_size) == 1)) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "step size must be positive and finite, got ");
        _bj_fmt_f64_display(t, step_size);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (_bj_is_finite(start[0]) == 0 || _bj_is_finite(start[1]) == 0 || _bj_is_finite(start[2]) == 0) {
        var t2 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t2, "start position must be finite, got ");
        _bj_fmt_f64x3_debug(t2, start);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (_bj_log_on(4) == 1) {
        var lb[400];
        var lt[24];
        _bj_tx_init(&lt, &lb, 400);
        _bj_tx_cstr(&lt, "tracing field line start=");
        _bj_fmt_f64x3_debug(&lt, start);
        _bj_tx_cstr(&lt, " step_size=");
        _bj_fmt_f64_debug(&lt, step_size);
        _bj_tx_cstr(&lt, " max_steps=");
        _bj_tx_u64(&lt, max_steps);
        _bj_log_text(4, &lt);
    }
    var first = _BJ_TRACE_INITIAL_CAPACITY;
    if (max_steps >= 0 && max_steps < _BJ_TRACE_INITIAL_CAPACITY - 1) { first = max_steps + 1; }
    if (_bj_poly_reserve(out, first) == 0) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "field line buffer");
        return Err(BJ_ERR_ALLOCATION);
    }
    var pos: f64[3];
    pos[0] = start[0];
    pos[1] = start[1];
    pos[2] = start[2];
    _bj_poly_push(out, &pos);
    var stop_reason = "max_steps reached";
    var f: BjFieldVector;
    var h_small = 0;
    if (step_size <= 1.0) { h_small = 1; }
    var wh = (load64(&step_size) >> 52) - 2046;                     # negative when h < 2^1023
    var i = 0;
    while (i != max_steps) {
        var st = callptr(field_fn, &pos, &f);
        if (st != BJ_ERR_NONE) {
            if (st == BJ_ERR_SINGULARITY) {
                stop_reason = "singularity (source/sink)";
                break;
            }
            out.len = 0;
            return Err(st);
        }
        var fx: f64 = f.x;
        var fy: f64 = f.y;
        var fz: f64 = f.z;
        if (fx != fx || fy != fy || fz != fz) {
            out.len = 0;
            var t3 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(t3, "field function returned NaN at ");
            _bj_fmt_f64x3_debug(t3, &pos);
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        if (_bj_is_finite(fx) == 0 || _bj_is_finite(fy) == 0 || _bj_is_finite(fz) == 0) {
            stop_reason = "infinite field (source/sink)";
            break;
        }
        # A finite field fails to normalize only when it is zero: test that first, so a null point leaves the
        # last-error record alone, as Rust's discarded error has no effect.
        if (fx == 0.0 && fy == 0.0 && fz == 0.0) {
            stop_reason = "null point";
            break;
        }
        # The step, F/|F| (normalized's first branch, as Rust's in the band) times h, added to pos. Rust's chain is the
        # unbounded one when |F|² is in the band and each d_i = F_i/|F| and t_i = h·d_i is normal above 2^-1022 or an
        # exact 0 (F_i = 0); else the step runs with an unbounded exponent, each new position rounded once (ADR 0002
        # row 18). |d_i| ≤ 1 + 2^-51, so for h ≤ 1 a normal t_i makes d_i normal (|d_i| ≥ |t_i|), and for h > 1 a
        # normal d_i makes t_i normal, finite while h < 2^1023 (wh): one test per part, on v_i (t_i or d_i).
        var ms: f64 = fx * fx + fy * fy + fz * fz;
        var w = 0;
        if (ms >= _BJ_VX_LO && ms <= _BJ_VX_HI) {
            var mag: f64 = f64_sqrt(ms);
            var ux: f64 = fx / mag;
            var uy: f64 = fy / mag;
            var uz: f64 = fz / mag;
            var tx: f64 = step_size * ux;
            var ty: f64 = step_size * uy;
            var tz: f64 = step_size * uz;
            var vx: f64 = ux;
            var vy: f64 = uy;
            var vz: f64 = uz;
            if (h_small == 1) {
                vx = tx;
                vy = ty;
                vz = tz;
            }
            # Negative when good: |v_i| ≥ 2^-1021 (bits ≥ 2^53), or F_i = 0 (bits − 1 < 0); w is negative when all are.
            var gx = (0x1FFFFFFFFFFFFF - (load64(&vx) & 0x7FFFFFFFFFFFFFFF)) | ((load64(&fx) & 0x7FFFFFFFFFFFFFFF) - 1);
            var gy = (0x1FFFFFFFFFFFFF - (load64(&vy) & 0x7FFFFFFFFFFFFFFF)) | ((load64(&fy) & 0x7FFFFFFFFFFFFFFF) - 1);
            var gz = (0x1FFFFFFFFFFFFF - (load64(&vz) & 0x7FFFFFFFFFFFFFFF)) | ((load64(&fz) & 0x7FFFFFFFFFFFFFFF) - 1);
            w = gx & gy & gz & wh;
            if (w < 0) {
                pos[0] = pos[0] + tx;
                pos[1] = pos[1] + ty;
                pos[2] = pos[2] + tz;
            }
        }
        if (w >= 0) { _bj_fv_trace_edge(fx, fy, fz, step_size, &pos); }
        if (_bj_poly_push(out, &pos) == 0) {
            out.len = 0;
            _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "field line buffer");
            return Err(BJ_ERR_ALLOCATION);
        }
        i = i + 1;
    }
    if (_bj_log_on(4) == 1) {
        var lb2[160];
        var lt2[24];
        _bj_tx_init(&lt2, &lb2, 160);
        _bj_tx_cstr(&lt2, "field line traced points=");
        _bj_tx_u64(&lt2, out.len);
        _bj_tx_cstr(&lt2, " stop_reason=\"");
        _bj_tx_cstr(&lt2, stop_reason);
        _bj_tx_putc(&lt2, 34);
        _bj_log_text(4, &lt2);
    }
    return Ok(0);
}

# --- maxwell.cyr ---

# maxwell.cyr — Maxwell's equations: the divergences, the displacement current, wave speed, refractive index,
# impedance, wavelength and frequency, skin depth (port of rust-old/src/maxwell.rs, M1 part 3d).
#
# SI units throughout. A fallible function returns a value-form Result with its f64 payload, the error in the last-error
# record (src/error.cyr). No harmonic quantity appears here, so no time convention (src/complex.cyr) is involved.
#
# The roots are rounded once (ADR 0002 row 13, the user's "round once" decision of 2026-11-12): wave_speed, the
# refractive index, the impedances and skin depth are the correctly rounded √ of their monomial (src/crmath_mono.cyr;
# kimiya's √(x/y) for the impedances), where Rust's chains round two to four times (one ulp off on about a quarter of
# inputs) and their products and quotients over- or underflow where the root is representable. An infinite operand keeps
# Rust's result (an infinite product or quotient, then its root). The divergences, the displacement current, wavelength
# and frequency are one IEEE operation each, already rounded once: Rust's bits.

private

# The InvalidPermittivity or InvalidPermeability of a medium's ε and μ (NaN or not positive, ε first), or 0.
fn _bj_check_eps_mu(permittivity: f64, permeability: f64): i64 {
    if (permittivity != permittivity || permittivity <= 0.0) { return _bj_err_invalid_permittivity(permittivity); }
    if (permeability != permeability || permeability <= 0.0) { return _bj_err_invalid_permeability(permeability); }
    return 0;
}

# The InvalidParameter "<name> must be positive, got <value>" for a NaN or non-positive value, or 0.
fn _bj_check_positive(name, value: f64): i64 {
    if (value != value || value <= 0.0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, name);
        _bj_tx_cstr(t, " must be positive, got ");
        _bj_fmt_f64_display(t, value);
        return BJ_ERR_INVALID_PARAMETER;
    }
    return 0;
}

# ∇·E = ρ/ε₀ (V/m²) for a charge density ρ (C/m³). Mirrors `maxwell::gauss_electric_divergence`.
#must_use
#pure
public fn bj_gauss_electric_divergence(charge_density: f64): f64 {
    var d: f64 = charge_density / BJ_EPSILON_0;
    return d;
}

# ∇·B = 0: there are no magnetic monopoles. Mirrors `maxwell::gauss_magnetic_divergence`.
#must_use
#pure
public fn bj_gauss_magnetic_divergence(): f64 {
    var z: f64 = 0.0;
    return z;
}

# J_d = ε₀·∂E/∂t (A/m²). Mirrors `maxwell::displacement_current`.
#must_use
#pure
public fn bj_displacement_current(de_dt: BjFieldVector): BjFieldVector {
    var j: BjFieldVector = de_dt.scale(BJ_EPSILON_0);
    return j;
}

# v = 1/√(εμ) (m/s), correctly rounded (ADR 0002 row 13); 0 for an infinite ε or μ, as Rust's 1/√∞.
# InvalidPermittivity, then InvalidPermeability, for a NaN or non-positive ε or μ. Mirrors `maxwell::wave_speed`.
public fn bj_wave_speed(permittivity: f64, permeability: f64): Result {
    var c = _bj_check_eps_mu(permittivity, permeability);
    if (c != 0) { return Err(c); }
    if (permittivity == _BJ_K_INF || permeability == _BJ_K_INF) { return Ok(0.0); }
    var den: f64[2];
    den[0] = permittivity;
    den[1] = permeability;
    var v: f64 = _bj_cr_sqrt_mono(0, 0, &den, 2);
    return Ok(v);
}

# n = √(ε_r·μ_r), correctly rounded (ADR 0002 row 13); +∞ for an infinite ε_r or μ_r. Errors as wave_speed's.
# Mirrors `maxwell::refractive_index`.
public fn bj_refractive_index(relative_permittivity: f64, relative_permeability: f64): Result {
    var c = _bj_check_eps_mu(relative_permittivity, relative_permeability);
    if (c != 0) { return Err(c); }
    if (relative_permittivity == _BJ_K_INF || relative_permeability == _BJ_K_INF) { return Ok(_BJ_K_INF); }
    var num: f64[2];
    num[0] = relative_permittivity;
    num[1] = relative_permeability;
    var n: f64 = _bj_cr_sqrt_mono(&num, 2, 0, 0);
    return Ok(n);
}

# η = √(μ/ε) (ohms), correctly rounded (ADR 0002 row 13); an infinite ε or μ keeps Rust's √(μ/ε) (+∞, 0, or NaN for
# both). Errors as wave_speed's. Mirrors `maxwell::impedance`.
public fn bj_impedance(permittivity: f64, permeability: f64): Result {
    var c = _bj_check_eps_mu(permittivity, permeability);
    if (c != 0) { return Err(c); }
    if (permittivity == _BJ_K_INF || permeability == _BJ_K_INF) {
        var q: f64 = permeability / permittivity;
        var eta: f64 = f64_sqrt(q);
        return Ok(eta);
    }
    var r: f64 = _bj_k_cr_sqrt_div(permeability, permittivity);   # kimiya's √(x/y): the same bits, faster
    return Ok(r);
}

# η₀ = √(μ₀/ε₀) ≈ 376.73 Ω, correctly rounded (ADR 0002 row 13). Mirrors `maxwell::free_space_impedance`.
#must_use
#pure
public fn bj_free_space_impedance(): f64 {
    var eta: f64 = _bj_k_cr_sqrt_div(BJ_MU_0, BJ_EPSILON_0);
    return eta;
}

# λ = v/f (m). InvalidParameter for a NaN or non-positive frequency, then velocity. Mirrors `maxwell::wavelength`.
public fn bj_wavelength(frequency: f64, velocity: f64): Result {
    var c = _bj_check_positive("frequency", frequency);
    if (c != 0) { return Err(c); }
    c = _bj_check_positive("velocity", velocity);
    if (c != 0) { return Err(c); }
    var l: f64 = velocity / frequency;
    return Ok(l);
}

# f = v/λ (Hz). InvalidParameter for a NaN or non-positive wavelength, then velocity. Mirrors `maxwell::frequency`.
public fn bj_frequency(wavelength_m: f64, velocity: f64): Result {
    var c = _bj_check_positive("wavelength", wavelength_m);
    if (c != 0) { return Err(c); }
    c = _bj_check_positive("velocity", velocity);
    if (c != 0) { return Err(c); }
    var f: f64 = velocity / wavelength_m;
    return Ok(f);
}

# The InvalidParameter "<name> must be positive for skin depth, got <value>", or 0.
fn _bj_check_skin(name, value: f64): i64 {
    if (value != value || value <= 0.0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, name);
        _bj_tx_cstr(t, " must be positive for skin depth, got ");
        _bj_fmt_f64_display(t, value);
        return BJ_ERR_INVALID_PARAMETER;
    }
    return 0;
}

# δ = √(2/(ωμσ)) (m), how far an EM wave reaches into a good conductor (σ ≫ ωε), correctly rounded (ADR 0002 row 13);
# 0 for an infinite ω, μ or σ, as Rust's √(2/∞). InvalidParameter unless ω, μ and σ are each positive (checked in
# that order; NaN refused). Mirrors `maxwell::skin_depth`.
public fn bj_skin_depth(angular_freq: f64, permeability: f64, conductivity: f64): Result {
    var c = _bj_check_skin("angular frequency", angular_freq);
    if (c != 0) { return Err(c); }
    c = _bj_check_skin("permeability", permeability);
    if (c != 0) { return Err(c); }
    c = _bj_check_skin("conductivity", conductivity);
    if (c != 0) { return Err(c); }
    if (angular_freq == _BJ_K_INF || permeability == _BJ_K_INF || conductivity == _BJ_K_INF) { return Ok(0.0); }
    var num: f64[1];
    var den: f64[3];
    num[0] = 2.0;
    den[0] = angular_freq;
    den[1] = permeability;
    den[2] = conductivity;
    var d: f64 = _bj_cr_sqrt_mono(&num, 1, &den, 3);
    return Ok(d);
}

# --- charge.cyr ---

# charge.cyr — point charges, Coulomb's law, the Lorentz force, cyclotron motion (port of rust-old/src/charge.rs,
# M1 part 3d).
#
# SI units: coulombs, newtons, metres, seconds. Every formula is Rust's in Rust's order (the golden rows compare bit for
# bit, class A), but for the three that are one product or quotient of inputs and constants (the Coulomb energy,
# cyclotron frequency and Larmor radius), which are rounded once (ADR 0002 row 13). The constants (BJ_ELEMENTARY_CHARGE,
# BJ_ELECTRON_MASS, BJ_PROTON_MASS) are src/constants.cyr's. Shapes as src/field.cyr's: a `[f64; 3]` is the address of
# three f64; a `Result<FieldVector>` writes through an out pointer; a fallible constructor of a struct over 16 bytes
# writes through `out` too.

private

# A point charge with its position and velocity. Mirrors `charge::PointCharge`; Rust's `[f64; 3]` fields are
# `(f64, f64, f64)` tuples stored inline (`q.position.0` for `q.position[0]`; probe p15), 64 bytes, by value.
public struct BjPointCharge {
    charge: f64;
    mass: f64;
    position: (f64, f64, f64);
    velocity: (f64, f64, f64);
}

# A point charge into out; InvalidParameter when mass is NaN or not positive, out untouched. Mirrors
# `PointCharge::new`.
public fn BjPointCharge_new(charge: f64, mass: f64, position: *f64, velocity: *f64, out: *BjPointCharge): Result {
    if (mass != mass || mass <= 0.0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "mass must be positive, got ");
        _bj_fmt_f64_display(t, mass);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    out.charge = charge;
    out.mass = mass;
    out.position = (position[0], position[1], position[2]);
    out.velocity = (velocity[0], velocity[1], velocity[2]);
    return Ok(0);
}

# A particle of charge q and mass m at rest at `position`.
#must_use
fn _bj_particle_at(q: f64, m: f64, position: *f64): BjPointCharge {
    var p: BjPointCharge;
    p.charge = q;
    p.mass = m;
    p.position = (position[0], position[1], position[2]);
    p.velocity = (0.0, 0.0, 0.0);
    return p;
}

# An electron at rest at `position`: charge −e, the electron mass. Mirrors `PointCharge::electron`.
#must_use
public fn BjPointCharge_electron(position: *f64): BjPointCharge {
    var q: f64 = -BJ_ELEMENTARY_CHARGE;
    var p: BjPointCharge = _bj_particle_at(q, BJ_ELECTRON_MASS, position);
    return p;
}

# A proton at rest at `position`: charge e, the proton mass. Mirrors `PointCharge::proton`.
#must_use
public fn BjPointCharge_proton(position: *f64): BjPointCharge {
    var p: BjPointCharge = _bj_particle_at(BJ_ELEMENTARY_CHARGE, BJ_PROTON_MASS, position);
    return p;
}

# Writes a `(f64, f64, f64)` tuple's elements to p[0..3]: the `[f64; 3]` the field functions take.
fn _bj_tuple3_put(t: (f64, f64, f64), p: *f64): i64 {
    p[0] = t.0;
    p[1] = t.1;
    p[2] = t.2;
    return 0;
}

impl BjPointCharge {
    # E at field_pos from this charge, into out: bj_electric_field_point_charge's value and errors. Mirrors
    # `PointCharge::electric_field_at`.
    public fn electric_field_at(self, field_pos: *f64, out: *BjFieldVector): Result {
        var pos: f64[3];
        _bj_tuple3_put(self.position, &pos);
        return bj_electric_field_point_charge(self.charge, &pos, field_pos, out);
    }

    # V at field_pos from this charge: bj_electric_potential_point_charge's value and errors. Mirrors
    # `PointCharge::electric_potential_at`.
    public fn electric_potential_at(self, field_pos: *f64): Result {
        var pos: f64[3];
        _bj_tuple3_put(self.position, &pos);
        return bj_electric_potential_point_charge(self.charge, &pos, field_pos);
    }

    # B at field_pos from this moving charge (Biot–Savart), into out: bj_magnetic_field_moving_charge's. Mirrors
    # `PointCharge::magnetic_field_at`.
    public fn magnetic_field_at(self, field_pos: *f64, out: *BjFieldVector): Result {
        var pos: f64[3];
        var vel: f64[3];
        _bj_tuple3_put(self.position, &pos);
        _bj_tuple3_put(self.velocity, &vel);
        return bj_magnetic_field_moving_charge(self.charge, &pos, &vel, field_pos, out);
    }

    # The Lorentz force on this charge, moving with its velocity, in fields E and B: bj_lorentz_force's. Mirrors
    # `PointCharge::lorentz_force_in`.
    #must_use
    public fn lorentz_force_in(self, electric_field: BjFieldVector, magnetic_field: BjFieldVector): BjFieldVector {
        var v: BjFieldVector = BjFieldVector_new(self.velocity.0, self.velocity.1, self.velocity.2);
        var f: BjFieldVector = bj_lorentz_force(self.charge, v, electric_field, magnetic_field);
        return f;
    }
}

# F = kq₁q₂/r²·r̂ (N) on q1 from q2, as k·q₁·q₂·(1/r)³ times the offset q1 − q2 (away from q2 when they repel).
# At a range edge with an unbounded exponent, each component rounded once (ADR 0002 row 18). Singularity when the
# exact r² < 10^-30 (row 17). Mirrors `charge::coulomb_force`.
public fn bj_coulomb_force(q1: BjPointCharge, q2: BjPointCharge, out: *BjFieldVector): Result {
    var dx: f64 = q1.position.0 - q2.position.0;
    var dy: f64 = q1.position.1 - q2.position.1;
    var dz: f64 = q1.position.2 - q2.position.2;
    var r_sq: f64 = dx * dx + dy * dy + dz * dz;
    var band = _bj_x_band(r_sq, _BJ_FIELD_R2_MIN);
    if (band == 2) {
        var pa: f64[3];
        var pb: f64[3];
        pa[0] = q1.position.0;
        pa[1] = q1.position.1;
        pa[2] = q1.position.2;
        pb[0] = q2.position.0;
        pb[1] = q2.position.1;
        pb[2] = q2.position.2;
        band = _bj_x_r2_below(&pa, &pb, 30);
    }
    if (band == 1) { return Err(_bj_err_singularity()); }
    var rt: f64 = f64_sqrt(r_sq);
    var inv_r: f64 = 1.0 / rt;
    var kq: f64 = BJ_COULOMB_K * q1.charge;
    var kq2: f64 = kq * q2.charge;
    var factor: f64 = kq2 * inv_r * inv_r * inv_r;
    out.x = factor * dx;
    out.y = factor * dy;
    out.z = factor * dz;
    # k·q₁, k·q₁·q₂ and the factor normal (an overflowed offset makes the factor 0, so r² needs no test of its own).
    var e2 = (load64(&kq) >> 52) & 0x7FF;
    var e3 = (load64(&kq2) >> 52) & 0x7FF;
    var e4 = (load64(&factor) >> 52) & 0x7FF;
    if (((e2 - 2) | (2046 - e2) | (e3 - 2) | (2046 - e3) | (e4 - 2) | (2046 - e4)) >= 0) { return Ok(0); }
    _bj_ch_coulomb_slow(q1, q2, r_sq, kq, kq2, factor, out);
    return Ok(0);
}

# coulomb_force past its fast test, into out (which holds Rust's): Rust's chain stands for a zero charge with r² finite
# or a non-finite input, else the unbounded chain.
fn _bj_ch_coulomb_slow(q1: BjPointCharge, q2: BjPointCharge, r_sq: f64, kq: f64, kq2: f64, factor: f64,
  out: *BjFieldVector) {
    var pa: f64[3];
    var pb: f64[3];
    var p: f64[8];
    pa[0] = q1.position.0;
    pa[1] = q1.position.1;
    pa[2] = q1.position.2;
    pb[0] = q2.position.0;
    pb[1] = q2.position.1;
    pb[2] = q2.position.2;
    p[0] = q1.charge;
    p[1] = q2.charge;
    for (var i = 0; i < 3; i = i + 1) {
        p[2 + i] = pa[i];
        p[5 + i] = pb[i];
    }
    if (_bj_vx_coulomb_plain(r_sq, kq, kq2, factor, q1.charge, q2.charge, &p, 8) == 1) { return 0; }
    _bj_vx_coulomb_edge(BJ_COULOMB_K, q1.charge, q2.charge, &pa, &pb, out);
    return 0;
}

# One component of the Lorentz force, (e + (a·b − c·d))·q, given Rust's s = e + (a·b − c·d): s·q where Rust's chain is
# the unbounded one (s in the band, an exact 0 from exact products, or a part not finite: src/crmath_vx.cyr's guard),
# else the chain with an unbounded exponent and the product by q rounded once.
#must_use
fn _bj_ch_lorentz1(e: f64, a: f64, b: f64, c: f64, d: f64, s: f64, q: f64): f64 {
    var f: f64 = s * q;
    var dq: f64 = (q - q) + (e - e);
    if (_bj_vx_band(s) == 1 || dq != 0.0 || _bj_vx_finite4(a, b, c, d) == 0) { return f; }
    if (s == 0.0) {
        var p: f64 = a * b;
        var r: f64 = c * d;
        if (_bj_vx_exact(a, b, p) == 1 && _bj_vx_exact(c, d, r) == 1) { return f; }
    }
    var vs, ve = _bj_vx_cross1(a, b, c, d);
    var es, ee = _bj_k_ux_from(e);
    var ss, se = _bj_k_ux_add(es, ee, vs, ve);
    var qs, qe = _bj_k_ux_from(q);
    var u: f64 = _bj_k_ux_mul_f64(ss, se, qs, qe);
    return u;
}

# F = q(E + v × B) (N), as (E + v × B)·q; at a range edge (a product past DBL_MAX or below 2^-1022 that the result can
# see) the chain with an unbounded exponent, each product by q rounded once (ADR 0002 row 18). Mirrors
# `charge::lorentz_force`.
#must_use
#pure
public fn bj_lorentz_force(charge: f64, velocity: BjFieldVector, electric_field: BjFieldVector,
  magnetic_field: BjFieldVector): BjFieldVector {
    var v: BjFieldVector = velocity;
    var b: BjFieldVector = magnetic_field;
    var e: BjFieldVector = electric_field;
    var sx: f64 = e.x + (v.y * b.z - v.z * b.y);
    var sy: f64 = e.y + (v.z * b.x - v.x * b.z);
    var sz: f64 = e.z + (v.x * b.y - v.y * b.x);
    var w: BjFieldVector;
    w.x = sx * charge;
    w.y = sy * charge;
    w.z = sz * charge;
    # Each s's biased exponent in [123, 2046] is |s| ∈ [2^-900, DBL_MAX] (src/crmath_vx.cyr's band); q finite.
    var cq: f64 = charge;
    var ex = (load64(&sx) >> 52) & 0x7FF;
    var ey = (load64(&sy) >> 52) & 0x7FF;
    var ez = (load64(&sz) >> 52) & 0x7FF;
    var eq = (load64(&cq) >> 52) & 0x7FF;
    if (((ex - 123) | (ey - 123) | (ez - 123) | (2046 - ex) | (2046 - ey) | (2046 - ez) | (2046 - eq)) >= 0) {
        return w;
    }
    # A component that is 0 through zero factors and a zero E is exact; so is one in the band.
    var hard = 0;
    if (((ex - 123) | (2046 - ex)) < 0 && !(sx == 0.0 && e.x == 0.0 && (v.y == 0.0 || b.z == 0.0) && (v.z == 0.0
          || b.y == 0.0))) { hard = 1; }
    if (((ey - 123) | (2046 - ey)) < 0 && !(sy == 0.0 && e.y == 0.0 && (v.z == 0.0 || b.x == 0.0) && (v.x == 0.0
          || b.z == 0.0))) { hard = 1; }
    if (((ez - 123) | (2046 - ez)) < 0 && !(sz == 0.0 && e.z == 0.0 && (v.x == 0.0 || b.y == 0.0) && (v.y == 0.0
          || b.x == 0.0))) { hard = 1; }
    if (hard == 0 && eq != 2047) { return w; }
    var dq: f64 = charge - charge;
    var dv: f64 = (v.x - v.x) + (v.y - v.y) + (v.z - v.z) + (e.x - e.x) + (e.y - e.y) + (e.z - e.z);
    dv = dv + (b.x - b.x) + (b.y - b.y) + (b.z - b.z) + dq;
    if (dv != 0.0) { return w; }                            # a non-finite part keeps Rust's chain
    var fx: f64 = _bj_ch_lorentz1(e.x, v.y, b.z, v.z, b.y, sx, charge);
    var fy: f64 = _bj_ch_lorentz1(e.y, v.z, b.x, v.x, b.z, sy, charge);
    var fz: f64 = _bj_ch_lorentz1(e.z, v.x, b.y, v.y, b.x, sz, charge);
    w.x = fx;
    w.y = fy;
    w.z = fz;
    return w;
}

# p = qd (C·m). Mirrors `charge::dipole_moment`.
#must_use
#pure
public fn bj_dipole_moment(charge: f64, separation: f64): f64 {
    var p: f64 = charge * separation;
    return p;
}

# U = qV (J). Mirrors `charge::potential_energy`.
#must_use
#pure
public fn bj_potential_energy(charge: f64, potential: f64): f64 {
    var u: f64 = charge * potential;
    return u;
}

# U = kq₁q₂/r (J), correctly rounded (ADR 0002 row 13; an infinite or NaN operand keeps Rust's (k·q₁·q₂)/r).
# InvalidParameter when r is NaN or negative, Singularity below 1e-30 m (field.rs's check_radial_distance). Mirrors
# `charge::coulomb_potential_energy`.
public fn bj_coulomb_potential_energy(q1: f64, q2: f64, distance: f64): Result {
    var t, v = _bj_check_radial_distance(distance);
    if (is_err_result(t) == 1) { return Err(v); }
    if (_bj_is_finite(q1) == 0 || _bj_is_finite(q2) == 0 || _bj_is_finite(distance) == 0) {
        var u: f64 = BJ_COULOMB_K * q1 * q2 / distance;
        return Ok(u);
    }
    var cr: f64 = _bj_k_cr_mul3_div(BJ_COULOMB_K, q1, q2, distance);
    return Ok(cr);
}

# A particle mass's error for `what`: DivisionByZero "mass cannot be zero for <what>" for 0, InvalidParameter "mass
# must be positive for <what>, got <mass>" for NaN or negative; else 0. Mirrors charge.rs's private `check_mass`.
fn _bj_check_mass(mass: f64, what): i64 {
    if (mass == 0.0) {
        var t = _bj_err_reason(BJ_ERR_DIVISION_BY_ZERO);
        _bj_tx_cstr(t, "mass cannot be zero for ");
        _bj_tx_cstr(t, what);
        return BJ_ERR_DIVISION_BY_ZERO;
    }
    if (mass != mass || mass <= 0.0) {
        var t2 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t2, "mass must be positive for ");
        _bj_tx_cstr(t2, what);
        _bj_tx_cstr(t2, ", got ");
        _bj_fmt_f64_display(t2, mass);
        return BJ_ERR_INVALID_PARAMETER;
    }
    return 0;
}

# ω_c = |q|B/m (rad/s) for |B| ≥ 0 (T), correctly rounded (ADR 0002 row 13; an infinite operand keeps Rust's
# (|q|·B)/m). DivisionByZero for a zero mass; InvalidParameter for a negative mass, a NaN
# charge, or a negative or NaN |B| (in that order). Mirrors `charge::cyclotron_frequency`.
public fn bj_cyclotron_frequency(charge: f64, mass: f64, b_magnitude: f64): Result {
    var c = _bj_check_mass(mass, "cyclotron frequency");
    if (c != 0) { return Err(c); }
    if (charge != charge) { return Err(_bj_err_invalid_parameter("charge must not be NaN")); }
    if (b_magnitude != b_magnitude || b_magnitude < 0.0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "|B| must be non-negative, got ");
        _bj_fmt_f64_display(t, b_magnitude);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var aq: f64 = f64_abs(charge);
    if (_bj_is_finite(aq) == 0 || _bj_is_finite(b_magnitude) == 0 || _bj_is_finite(mass) == 0) {
        var w: f64 = aq * b_magnitude / mass;
        return Ok(w);
    }
    var cr: f64 = _bj_k_cr_mul_div(aq, b_magnitude, mass);
    return Ok(cr);
}

# r_L = m|v⊥|/(|q|B) (m) for |B| > 0, correctly rounded (ADR 0002 row 13: Rust divides in two steps, m·|v⊥|/|q|/B,
# so a tiny |q|·B can't underflow, but m·|v⊥| still can; an infinite operand keeps that chain). DivisionByZero for a
# zero mass, charge or |B|; InvalidParameter for a negative mass or |B|, or a NaN argument (in Rust's order). Mirrors
# `charge::larmor_radius`.
public fn bj_larmor_radius(mass: f64, v_perp: f64, charge: f64, b_magnitude: f64): Result {
    var c = _bj_check_mass(mass, "Larmor radius");
    if (c != 0) { return Err(c); }
    if (v_perp != v_perp || charge != charge) {
        return Err(_bj_err_invalid_parameter("v_perp and charge must not be NaN"));
    }
    if (charge == 0.0) { return Err(_bj_err_division_by_zero("charge cannot be zero for Larmor radius")); }
    if (b_magnitude == 0.0) { return Err(_bj_err_division_by_zero("|B| cannot be zero for Larmor radius")); }
    if (b_magnitude != b_magnitude || b_magnitude <= 0.0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "|B| must be positive, got ");
        _bj_fmt_f64_display(t, b_magnitude);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var av: f64 = f64_abs(v_perp);
    var aq: f64 = f64_abs(charge);
    var fin = _bj_is_finite(mass) + _bj_is_finite(av) + _bj_is_finite(aq) + _bj_is_finite(b_magnitude);
    if (fin != 4) {
        var r: f64 = mass * av / aq / b_magnitude;
        return Ok(r);
    }
    var cr: f64 = _bj_k_cr_mul2_div2(mass, av, aq, b_magnitude);
    return Ok(cr);
}

# --- material.cyr ---

# material.cyr — dielectric and magnetic materials: susceptibilities, polarization and magnetization, bound charges
# and currents, Clausius–Mossotti, the Curie laws, and the unified BjMaterial (port of rust-old/src/material.rs, M2
# part 1a).
#
# SI units: C/m², A/m, F/m, H/m. Every formula is Rust's in Rust's order (the golden rows compare bit for bit, class A),
# but for the products, quotients and roots of inputs and constants, which are rounded once (ADR 0002 row 13, M2 part
# 2b-1): the dielectric and magnetic energy densities, D = ε_r·ε₀·E, B = μ_r·μ₀·H and H = B/(μ_r·μ₀) part by part, and
# BjMaterial's refractive index, impedance, wave speed and lossless optical constants (src/crmath_kx.cyr's monomials,
# src/crmath_mono.cyr's √ of one). A non-finite operand keeps Rust's chain; the formulas with a difference inside
# (polarization, magnetization, Curie–Weiss) are Rust's. Clausius–Mossotti decides its pole and zero on the exact Nα
# and rounds ε_r once (ADR 0002 row 17, M2 part 2c-2, src/crmath_edge.cyr), and the thresholds against 10^-30 and
# −10^-15 are exact (row 17, M2 part 2c-1). The bound surface charge and current are BjFieldVector's dot and cross, so
# their range edges follow ADR 0002 row 18 (src/field.cyr). Three of Rust's inconsistencies are fixed (ADR 0002, the
# user's answers of 2026-11-12): the Curie laws refuse a NaN temperature (row 19), BjMaterial.wave_speed validates as
# impedance does (row 20), and bj_classify_magnetic refuses a NaN susceptibility (row 21). A fallible function returns
# a value-form Result with its payload, the error in the last-error record (src/error.cyr); a `Result<FieldVector>`
# writes through an out pointer.
# No harmonic quantity appears here, so no time convention (src/complex.cyr) is involved.

private

# A material's magnetic class from its susceptibility. Mirrors `material::MagneticType` (`#[non_exhaustive]`: the
# values are append-only).
public enum BjMagneticType {
    BJ_MAGNETIC_TYPE_DIAMAGNETIC = 0;
    BJ_MAGNETIC_TYPE_PARAMAGNETIC = 1;
    BJ_MAGNETIC_TYPE_FERROMAGNETIC = 2;
}

# ── dielectrics ──────────────────────────────────────────────────────────────────────────────────────────────────

# χ_e = ε_r − 1. Mirrors `material::electric_susceptibility`.
#must_use
#pure
public fn bj_electric_susceptibility(relative_permittivity: f64): f64 {
    var x: f64 = relative_permittivity - 1.0;
    return x;
}

# ε_r = 1 + χ_e. Mirrors `material::relative_permittivity`.
#must_use
#pure
public fn bj_relative_permittivity(electric_susceptibility: f64): f64 {
    var x: f64 = 1.0 + electric_susceptibility;
    return x;
}

# ε = ε_r·ε₀ (F/m). Mirrors `material::absolute_permittivity`.
#must_use
#pure
public fn bj_absolute_permittivity(relative_permittivity: f64): f64 {
    var x: f64 = relative_permittivity * BJ_EPSILON_0;
    return x;
}

# P = (ε_r − 1)ε₀E (C/m²). Mirrors `material::polarization`.
#must_use
#pure
public fn bj_polarization(relative_permittivity: f64, electric_field: BjFieldVector): BjFieldVector {
    var k: f64 = (relative_permittivity - 1.0) * BJ_EPSILON_0;
    var p: BjFieldVector = electric_field.scale(k);
    return p;
}

# x·c·w (mode 0) or w/(x·c) (mode 1), correctly rounded for a finite w (ADR 0002 row 13); Rust's w·k for a non-finite
# one, k being Rust's rounded scale factor (x·c, or 1/(x·c)). x is finite and c a constant.
#must_use
fn _bj_mat_part(x: f64, c: f64, w: f64, k: f64, mode): f64 {
    if (_bj_is_finite(w) == 0) {
        var r: f64 = w * k;
        return r;
    }
    if (mode == 0) {
        var a: f64 = _bj_k_cr_mul3(x, c, w);
        return a;
    }
    var b: f64 = _bj_k_cr_div2(w, x, c);
    return b;
}

# v scaled part by part as _bj_mat_part (x finite): x·c·v (mode 0) or v/(x·c) (mode 1), k Rust's scale factor.
#must_use
fn _bj_mat_scale(x: f64, c: f64, v: BjFieldVector, k: f64, mode): BjFieldVector {
    var px: f64 = _bj_mat_part(x, c, v.x, k, mode);
    var py: f64 = _bj_mat_part(x, c, v.y, k, mode);
    var pz: f64 = _bj_mat_part(x, c, v.z, k, mode);
    var r: BjFieldVector = BjFieldVector_new(px, py, pz);
    return r;
}

# D = ε_r·ε₀·E (C/m²), each part correctly rounded (ADR 0002 row 13; a non-finite ε_r keeps Rust's E·(ε_r·ε₀), and a
# non-finite part its own). Mirrors `material::displacement_field`.
#must_use
#pure
public fn bj_displacement_field(relative_permittivity: f64, electric_field: BjFieldVector): BjFieldVector {
    var k: f64 = relative_permittivity * BJ_EPSILON_0;
    if (_bj_is_finite(relative_permittivity) == 0) {
        var d: BjFieldVector = electric_field.scale(k);
        return d;
    }
    var r: BjFieldVector = _bj_mat_scale(relative_permittivity, BJ_EPSILON_0, electric_field, k, 0);
    return r;
}

# σ_b = P·n̂ (C/m²), n̂ the outward normal: BjFieldVector's dot (ADR 0002 row 18 at a range edge). Mirrors
# `material::bound_surface_charge`.
#must_use
public fn bj_bound_surface_charge(polarization: BjFieldVector, normal: BjFieldVector): f64 {
    var s: f64 = polarization.dot(normal);
    return s;
}

# ρ_b = −∇·P = −(∂Px/∂x + ∂Py/∂y + ∂Pz/∂z) (C/m³), from the three partial derivatives. Mirrors
# `material::bound_volume_charge`.
#must_use
#pure
public fn bj_bound_volume_charge(dp_dx: f64, dp_dy: f64, dp_dz: f64): f64 {
    var s: f64 = dp_dx + dp_dy + dp_dz;
    var r: f64 = -s;
    return r;
}

# u = ε_r·ε₀·E²/2 (J/m³), correctly rounded (ADR 0002 row 13; a non-finite ε_r or E keeps Rust's 0.5·ε_r·ε₀·E·E).
# Mirrors `material::dielectric_energy_density`.
#must_use
#pure
public fn bj_dielectric_energy_density(relative_permittivity: f64, e_magnitude: f64): f64 {
    if (_bj_is_finite(relative_permittivity) == 0 || _bj_is_finite(e_magnitude) == 0) {
        var u: f64 = 0.5 * relative_permittivity * BJ_EPSILON_0 * e_magnitude * e_magnitude;
        return u;
    }
    var cr: f64 = _bj_k_cr_mul5(0.5, relative_permittivity, BJ_EPSILON_0, e_magnitude, e_magnitude);
    return cr;
}

# ε_r = (1 + 2X)/(1 − X) with X = Nα/(3ε₀), the Clausius–Mossotti relation, for a molecular polarizability α (F·m²)
# and number density N (m⁻³). InvalidParameter for a non-finite α or N, N < 0, or X ≥ 1 (the polarization
# catastrophe); InvalidPermittivity when ε_r ≤ 0 (X ≤ −1/2, a negative α). Both tests are exact, ε_r is
# (3ε₀ + 2Nα)/(3ε₀ − Nα) correctly rounded, and the catastrophe reports X correctly rounded (ADR 0002 row 17,
# src/crmath_edge.cyr). Mirrors `material::clausius_mossotti`.
public fn bj_clausius_mossotti(polarizability: f64, number_density: f64): Result {
    if (_bj_is_finite(polarizability) == 0 || _bj_is_finite(number_density) == 0 || number_density < 0.0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "polarizability and number density must be finite with N ≥ 0, got α = ");
        _bj_fmt_f64_display(t, polarizability);
        _bj_tx_cstr(t, ", N = ");
        _bj_fmt_f64_display(t, number_density);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var er: f64[1];
    if (_bj_cr_clausius(polarizability, number_density, 0, &er) == 1) {
        var chi: f64 = _bj_k_cr_mul2_div2(number_density, polarizability, 3.0, BJ_EPSILON_0);
        var t2 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t2, "Nα/(3ε₀) = ");
        _bj_fmt_f64_display(t2, chi);
        _bj_tx_cstr(t2, " ≥ 1: Clausius-Mossotti diverges (polarization catastrophe), no physical ε_r");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var eps_r: f64 = er[0];
    if (eps_r <= 0.0) { return Err(_bj_err_invalid_permittivity(eps_r)); }
    return Ok(eps_r);
}

# ── magnetic materials ───────────────────────────────────────────────────────────────────────────────────────────

# χ_m = μ_r − 1. Mirrors `material::magnetic_susceptibility`.
#must_use
#pure
public fn bj_magnetic_susceptibility(relative_permeability: f64): f64 {
    var x: f64 = relative_permeability - 1.0;
    return x;
}

# μ_r = 1 + χ_m. Mirrors `material::relative_permeability`.
#must_use
#pure
public fn bj_relative_permeability(magnetic_susceptibility: f64): f64 {
    var x: f64 = 1.0 + magnetic_susceptibility;
    return x;
}

# μ = μ_r·μ₀ (H/m). Mirrors `material::absolute_permeability`.
#must_use
#pure
public fn bj_absolute_permeability(relative_permeability: f64): f64 {
    var x: f64 = relative_permeability * BJ_MU_0;
    return x;
}

# M = (μ_r − 1)H (A/m), H the auxiliary field. Mirrors `material::magnetization`.
#must_use
#pure
public fn bj_magnetization(relative_permeability: f64, h_field: BjFieldVector): BjFieldVector {
    var k: f64 = relative_permeability - 1.0;
    var m: BjFieldVector = h_field.scale(k);
    return m;
}

# H = B/(μ_r·μ₀) (A/m), into out, each part correctly rounded (ADR 0002 row 13; a non-finite μ_r keeps Rust's
# B·(1/(μ_r·μ₀)), and a non-finite part its own). DivisionByZero when |μ_r| < 1e-30 (a NaN μ_r passes, as Rust's
# test), out untouched. Mirrors `material::h_field_from_b`.
public fn bj_h_field_from_b(relative_permeability: f64, b_field: BjFieldVector, out: *BjFieldVector): Result {
    var a: f64 = f64_abs(relative_permeability);
    if (a < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("relative permeability cannot be zero"));
    }
    var mu: f64 = relative_permeability * BJ_MU_0;
    var k: f64 = 1.0 / mu;
    var h: BjFieldVector = b_field.scale(k);
    if (_bj_is_finite(relative_permeability) == 1) { h = _bj_mat_scale(relative_permeability, BJ_MU_0, b_field, k, 1); }
    out.x = h.x;
    out.y = h.y;
    out.z = h.z;
    return Ok(0);
}

# B = μ_r·μ₀·H (T), each part correctly rounded (ADR 0002 row 13; a non-finite μ_r keeps Rust's H·(μ_r·μ₀), and a
# non-finite part its own). Mirrors `material::b_field_from_h`.
#must_use
#pure
public fn bj_b_field_from_h(relative_permeability: f64, h_field: BjFieldVector): BjFieldVector {
    var k: f64 = relative_permeability * BJ_MU_0;
    if (_bj_is_finite(relative_permeability) == 0) {
        var b: BjFieldVector = h_field.scale(k);
        return b;
    }
    var r: BjFieldVector = _bj_mat_scale(relative_permeability, BJ_MU_0, h_field, k, 0);
    return r;
}

# u = B²/(2μ) (J/m³), μ = μ_r·μ₀, correctly rounded (ADR 0002 row 13; a non-finite μ_r or B keeps Rust's B·B/(2μ)).
# DivisionByZero when the exact |μ_r·μ₀| < 10^-30 (ADR 0002 row 17's rule, M2 part 2c-1: Rust tested the rounded
# product; a NaN passes, as Rust's test). Mirrors `material::magnetic_energy_density_material`.
public fn bj_magnetic_energy_density_material(relative_permeability: f64, b_magnitude: f64): Result {
    var mu: f64 = relative_permeability * BJ_MU_0;
    var a: f64 = f64_abs(mu);
    var band = _bj_x_band(a, _BJ_FIELD_R2_MIN);
    if (band == 2) { band = _bj_x_prod_below(relative_permeability, BJ_MU_0, 30); }
    if (band == 1) {
        return Err(_bj_err_division_by_zero("permeability cannot be zero for energy density"));
    }
    if (_bj_is_finite(relative_permeability) == 0 || _bj_is_finite(b_magnitude) == 0) {
        var b2: f64 = b_magnitude * b_magnitude;
        var mu2: f64 = 2.0 * mu;
        var u: f64 = b2 / mu2;
        return Ok(u);
    }
    var two_mu: f64 = 2.0 * BJ_MU_0;
    var cr: f64 = _bj_k_cr_mul2_div2(b_magnitude, b_magnitude, relative_permeability, two_mu);
    return Ok(cr);
}

# K_b = M × n̂ (A/m), n̂ the outward normal: BjFieldVector's cross (ADR 0002 row 18 at a range edge). Mirrors
# `material::bound_surface_current`.
#must_use
public fn bj_bound_surface_current(magnetization: BjFieldVector, normal: BjFieldVector): BjFieldVector {
    var k: BjFieldVector = magnetization.cross(normal);
    return k;
}

# χ_m = C/T, Curie's law for a paramagnet, C the Curie constant (K) and T the temperature (K). InvalidParameter
# unless T > 0, a NaN T among them (ADR 0002 row 19: Rust's `T <= 0` let NaN through). Mirrors `material::curie_law`.
public fn bj_curie_law(curie_constant: f64, temperature: f64): Result {
    if (!(temperature > 0.0)) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "temperature must be positive, got ");
        _bj_fmt_f64_display(t, temperature);
        _bj_tx_cstr(t, " K");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var chi: f64 = curie_constant / temperature;
    return Ok(chi);
}

# χ_m = C/(T − T_c), the Curie–Weiss law for a ferromagnet above its Curie temperature T_c. InvalidParameter unless
# T − T_c > 0, a NaN difference among them (ADR 0002 row 19). Mirrors `material::curie_weiss`.
public fn bj_curie_weiss(curie_constant: f64, temperature: f64, curie_temperature: f64): Result {
    var d: f64 = temperature - curie_temperature;
    if (!(d > 0.0)) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "temperature (");
        _bj_fmt_f64_display(t, temperature);
        _bj_tx_cstr(t, " K) must be above Curie temperature (");
        _bj_fmt_f64_display(t, curie_temperature);
        _bj_tx_cstr(t, " K)");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var chi: f64 = curie_constant / d;
    return Ok(chi);
}

# The magnetic class of a susceptibility: Ok(BJ_MAGNETIC_TYPE_DIAMAGNETIC) below −10^-15 exactly, FERROMAGNETIC above
# 1, else PARAMAGNETIC. InvalidParameter for a NaN susceptibility (ADR 0002 row 21: Rust classifies NaN as
# paramagnetic). The exact test χ < −10^-15 is χ ≤ −1e-15 on doubles: the double 1e-15 lies 0.39 ulp above 10^-15,
# and no double falls between them (ADR 0002 row 17's rule, the user's answer of 2026-11-12: Rust's χ < −1e-15 left
# the double −1e-15 itself, which is below −10^-15, paramagnetic). Mirrors `material::classify_magnetic`.
public fn bj_classify_magnetic(susceptibility: f64): Result {
    if (susceptibility != susceptibility) {
        return Err(_bj_err_invalid_parameter("magnetic susceptibility must not be NaN, got NaN"));
    }
    if (susceptibility <= -0.000000000000001) { return Ok(BJ_MAGNETIC_TYPE_DIAMAGNETIC); }
    if (susceptibility > 1.0) { return Ok(BJ_MAGNETIC_TYPE_FERROMAGNETIC); }
    return Ok(BJ_MAGNETIC_TYPE_PARAMAGNETIC);
}

# ── the unified material ─────────────────────────────────────────────────────────────────────────────────────────

# A material's relative permittivity ε_r, relative permeability μ_r and conductivity σ (S/m, 0 for lossless): the
# struct the wave and FDTD modules take. Mirrors `material::Material`; 24 bytes, by value.
public struct BjMaterial {
    eps_r: f64;
    mu_r: f64;
    conductivity: f64;
}

# A material of the given properties. Mirrors `Material::new`.
#must_use
#pure
public fn BjMaterial_new(eps_r: f64, mu_r: f64, conductivity: f64): BjMaterial {
    var m: BjMaterial;
    m.eps_r = eps_r;
    m.mu_r = mu_r;
    m.conductivity = conductivity;
    return m;
}

# Vacuum: ε_r = μ_r = 1, σ = 0. Mirrors `Material::vacuum`.
#must_use
#pure
public fn BjMaterial_vacuum(): BjMaterial {
    var m: BjMaterial = BjMaterial_new(1.0, 1.0, 0.0);
    return m;
}

# A lossless, non-magnetic dielectric of relative permittivity eps_r. Mirrors `Material::dielectric`.
#must_use
#pure
public fn BjMaterial_dielectric(eps_r: f64): BjMaterial {
    var m: BjMaterial = BjMaterial_new(eps_r, 1.0, 0.0);
    return m;
}

# A conductor of conductivity σ (S/m), ε_r = μ_r = 1. Mirrors `Material::conductor`.
#must_use
#pure
public fn BjMaterial_conductor(conductivity: f64): BjMaterial {
    var m: BjMaterial = BjMaterial_new(1.0, 1.0, conductivity);
    return m;
}

# Vacuum. Mirrors `impl Default for Material`.
#must_use
#pure
public fn BjMaterial_default(): BjMaterial {
    var m: BjMaterial = BjMaterial_vacuum();
    return m;
}

# The lossless optical constants of m into out: n = √(ε_r·μ_r) in out[0] and the relative impedance η/η₀ = √(μ_r/ε_r)
# in out[1], each correctly rounded (ADR 0002 row 13). InvalidPermittivity, then InvalidPermeability, unless ε_r, μ_r
# are positive and finite; InvalidParameter for σ ≠ 0 (a conductor's index depends on frequency). bijli-internal, for
# the Fresnel functions (Rust's `pub(crate) Material::lossless_optical_constants`); public only so that src/wave.cyr
# can call it in the tests' build.
public fn _bj_material_lossless_optical_constants(m: BjMaterial, out: *f64): Result {
    var e: f64 = m.eps_r;
    var u: f64 = m.mu_r;
    var s: f64 = m.conductivity;
    if (!(_bj_is_finite(e) == 1 && e > 0.0)) { return Err(_bj_err_invalid_permittivity(e)); }
    if (!(_bj_is_finite(u) == 1 && u > 0.0)) { return Err(_bj_err_invalid_permeability(u)); }
    if (s != 0.0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "Fresnel coefficients from Material are lossless-only; conductivity σ = ");
        _bj_fmt_f64_display(t, s);
        _bj_tx_cstr(t, " S/m needs a frequency-dependent complex refractive index");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var num: f64[2];
    num[0] = e;
    num[1] = u;
    var n: f64 = _bj_cr_sqrt_mono(&num, 2, 0, 0);
    var eta: f64 = _bj_k_cr_sqrt_div(u, e);
    out[0] = n;
    out[1] = eta;
    return Ok(0);
}

impl BjMaterial {
    # n = √(ε_r·μ_r), the lossless refractive index, correctly rounded for nonzero finite ε_r and μ_r (ADR 0002 row 13):
    # NaN when their signs differ, the exact product being negative (Rust's −0 where it underflows). A zero or
    # non-finite operand keeps Rust's √(ε_r·μ_r). Mirrors `Material::refractive_index`.
    #must_use
    #pure
    public fn refractive_index(self): f64 {
        var e: f64 = self.eps_r;
        var u: f64 = self.mu_r;
        var p: f64 = e * u;
        var n: f64 = f64_sqrt(p);
        if (_bj_is_finite(e) == 0 || _bj_is_finite(u) == 0 || e == 0.0 || u == 0.0) { return n; }
        if ((e < 0.0) != (u < 0.0)) {
            var nan: f64 = _bj_k_nan();
            return nan;
        }
        var num: f64[2];
        num[0] = f64_abs(e);
        num[1] = f64_abs(u);
        var cr: f64 = _bj_cr_sqrt_mono(&num, 2, 0, 0);
        return cr;
    }

    # ε = ε_r·ε₀ (F/m). Mirrors `Material::permittivity`.
    #must_use
    #pure
    public fn permittivity(self): f64 {
        var e: f64 = self.eps_r * BJ_EPSILON_0;
        return e;
    }

    # μ = μ_r·μ₀ (H/m). Mirrors `Material::permeability`.
    #must_use
    #pure
    public fn permeability(self): f64 {
        var u: f64 = self.mu_r * BJ_MU_0;
        return u;
    }

    # η = √(μ/ε) (Ω), the lossless wave impedance, correctly rounded (ADR 0002 row 13); σ is ignored.
    # InvalidPermittivity, then InvalidPermeability, unless ε_r, μ_r are positive and finite. Mirrors
    # `Material::impedance`.
    public fn impedance(self): Result {
        var e: f64 = self.eps_r;
        var u: f64 = self.mu_r;
        if (!(_bj_is_finite(e) == 1 && e > 0.0)) { return Err(_bj_err_invalid_permittivity(e)); }
        if (!(_bj_is_finite(u) == 1 && u > 0.0)) { return Err(_bj_err_invalid_permeability(u)); }
        var num: f64[2];
        var den: f64[2];
        num[0] = u;
        num[1] = BJ_MU_0;
        den[0] = e;
        den[1] = BJ_EPSILON_0;
        var z: f64 = _bj_cr_sqrt_mono(&num, 2, &den, 2);
        return Ok(z);
    }

    # v = 1/√(ε_r·ε₀·μ_r·μ₀) (m/s), correctly rounded (ADR 0002 row 13). InvalidPermittivity, then
    # InvalidPermeability, unless ε_r, μ_r are positive and finite: impedance's validation (ADR 0002 row 20; Rust
    # refused a non-positive or NaN value as InvalidParameter and accepted ∞). Mirrors `Material::wave_speed`.
    public fn wave_speed(self): Result {
        var e: f64 = self.eps_r;
        var u: f64 = self.mu_r;
        if (!(_bj_is_finite(e) == 1 && e > 0.0)) { return Err(_bj_err_invalid_permittivity(e)); }
        if (!(_bj_is_finite(u) == 1 && u > 0.0)) { return Err(_bj_err_invalid_permeability(u)); }
        var den: f64[4];
        den[0] = e;
        den[1] = BJ_EPSILON_0;
        den[2] = u;
        den[3] = BJ_MU_0;
        var v: f64 = _bj_cr_sqrt_mono(0, 0, &den, 4);
        return Ok(v);
    }

    # 1 when σ > 0 (the material is lossy), else 0. Mirrors `Material::is_lossy`.
    #must_use
    #pure
    public fn is_lossy(self): i64 {
        var s: f64 = self.conductivity;
        if (s > 0.0) { return 1; }
        return 0;
    }

    # R = ((η₂ − η₁)/(η₂ + η₁))², the normal-incidence reflectance into `other`, η = √(μ_r/ε_r): right for magnetic
    # media too (ε_r = μ_r = 4 is matched to vacuum). Both materials must be lossless: the errors of
    # _bj_material_lossless_optical_constants, this material's first. Γ as src/crmath_vx.cyr's _bj_vx_gamma (an η past
    # DBL_MAX or subnormal runs with an unbounded exponent: ADR 0002 row 18's rule, M2 part 2d-2c). Mirrors
    # `Material::try_reflectance_at`.
    public fn try_reflectance_at(self, other: BjMaterial): Result {
        var c1: f64[2];
        var c2: f64[2];
        var t1, v1 = _bj_material_lossless_optical_constants(self, &c1);
        if (is_err_result(t1) == 1) { return Err(v1); }
        var t2, v2 = _bj_material_lossless_optical_constants(other, &c2);
        if (is_err_result(t2) == 1) { return Err(v2); }
        var eta1: f64 = c1[1];
        var eta2: f64 = c2[1];
        var r: f64 = _bj_vx_gamma(eta1, eta2, self.eps_r, self.mu_r, other.eps_r, other.mu_r);
        var rr: f64 = r * r;
        return Ok(rr);
    }

    # 1 when every field equals o's (IEEE: −0 equals +0, NaN equals nothing). Mirrors the derived `PartialEq`.
    #must_use
    #pure
    public fn eq(self, o: BjMaterial): i64 {
        var a: f64 = self.eps_r;
        var b: f64 = self.mu_r;
        var c: f64 = self.conductivity;
        if (a == o.eps_r && b == o.mu_r && c == o.conductivity) { return 1; }
        return 0;
    }
}

# --- wave_data.cyr ---

# wave_data.cyr — the dipole constants of src/wave.cyr (ADR 0002 row 22). Generated by scripts/oracle/validate.py
# (python3 -I -B scripts/oracle/validate.py . --write) from π (Machin, checked against MPFR), Cin(2π) by its
# series and η₀ = √(μ₀/ε₀) of BJ_MU_0 and BJ_EPSILON_0, all in exact rational arithmetic; do not edit.

# The doubles, as bit patterns in typed f64 globals.
var _BJ_WAVE_HALF_WAVE_D: f64 = 0x3FFA4137D286C626;  # 4/Cin(2π) = 1.640922376984585, nearest
var _BJ_WAVE_HALF_WAVE_R: f64 = 0x4052450E812803B3;  # η₀·Cin(2π)/(4π) = 73.07901028545056 Ω, nearest
var _BJ_WAVE_HERTZ_K: f64 = 0x4088A82D4F472750;  # (2π/3)·η₀ = 789.0221238669274 Ω, nearest

# --- wave.cyr ---

# wave.cyr — electromagnetic waves: the Poynting vector and the plane-wave relations, Snell's law and the Fresnel
# coefficients (the angle forms and the trig-free family: *_direct, unpolarized, Schlick), the material-based interface,
# rectangular and circular waveguides, and the dipole antennas (port of rust-old/src/wave.rs, M2 part 1b).
#
# SI units. A plane wave here is the real E(x, t) = E₀ sin(kx − ωt + φ), so no complex phasor and no time convention
# (src/complex.cyr) is involved. Every formula is Rust's in Rust's order: the golden rows compare bit for bit (class A),
# and the functions that call sin, cos, asin or atan take bijli's correctly rounded ones (src/crmath.cyr, class C
# against tests/golden/wave.cr.tsv). The Poynting vector and the momentum density are BjFieldVector's cross, so their
# range edges follow ADR 0002 row 18 (src/field.cyr). Four of Rust's inconsistencies are fixed (ADR 0002, the user's
# answers of 2026-11-12): the dipoles use bijli's η₀ = √(μ₀/ε₀) and the exact Cin(2π), not 120π's textbook figures
# (row 22, the constants in src/wave_data.cyr); bj_effective_aperture refuses a NaN wavelength (row 23);
# bj_schlick_reflectance takes R₀ without reflectance_normal's |n₁ + n₂| < 1e-30 guard (row 24); and
# bj_material_reflection_coefficient's Γ is on the relative impedances, so Γ² is bj_reflectance_normal_materials' R
# (row 25). And bj_half_wave_dipole_pattern's numerator is computed with no cancellation near the axis (row 28, M2's
# range-edge Part). The products and quotients of inputs and constants are rounded once (ADR 0002 row 13, M2 part 2b-2,
# src/crmath_kx.cyr's monomials): the plane-wave intensity, the reflected radiation pressure, the wave number, the
# circular cutoff, the Hertzian resistance, the effective aperture and Friis's ratio; a constant enters as its double
# (2π and 4π as Rust's π times an exact power of two), and a non-finite operand keeps Rust's chain. The thresholds
# are exact (ADR 0002 row 17): reflectance_normal's |n₁ + n₂| against 10^-30 (M2 part 2c-1), and the trig-free
# family's total internal reflection, with its cos θ_t correctly rounded (2c-3, src/crmath_edge.cyr).
#
# A fallible function returns a value-form Result, the error in the last-error record (src/error.cyr). Rust's
# `Result<Option<f64>>` is `Ok(Some)` with the value in *out, or `Ok(None)` under total internal reflection (out
# untouched, as on an error). The trig-free family takes n₁ (the incident side) and n₂ positive and finite, and cos θ_i
# in [0, 1] against the incident-side normal, clamping a rounding excursion of up to 1e-6; it never flips sides.

private

# ── plane waves ──────────────────────────────────────────────────────────────────────────────────────────────────

# One part of S = (E × B)/μ₀ (mode 0) or of g = S/c² (mode 1), from the cross component ci = a·b − c·d as
# BjFieldVector's cross gives it (src/crmath_vx.cyr's band, its unbounded fallback rounded once). Rust's ci·k (then ·k2)
# where ci is normal (it is then the chain's 53-bit value) and, for g, S finite; an exact 0 (zero factors, or two
# normal products) and a non-finite operand keep it, and so does S past DBL_MAX (k > 1: the cross is past it too).
# Otherwise (ci below 2^-1022 or 0 by underflow, or g's S or cross past DBL_MAX where g is representable) the chain runs
# with an unbounded exponent from the products, its last product rounded once (ADR 0002 row 18's rule, M2 part 2d-2b).
#must_use
fn _bj_wave_flux_part(a: f64, b: f64, c: f64, d: f64, ci: f64, k: f64, k2: f64, mode): f64 {
    var s: f64 = ci * k;
    var r: f64 = s;
    if (mode == 1) { r = s * k2; }
    var ac: f64 = f64_abs(ci);
    var asv: f64 = f64_abs(s);
    if (ac >= _BJ_VX_MN && ac <= _BJ_VX_HI && (mode == 0 || asv <= _BJ_VX_HI)) { return r; }
    if (_bj_vx_finite4(a, b, c, d) == 0) { return r; }
    if (mode == 0 && ac > _BJ_VX_HI) { return r; }
    if (ci == 0.0) {
        var pp: f64 = a * b;
        var qq: f64 = c * d;
        if (_bj_vx_exact(a, b, pp) == 1 && _bj_vx_exact(c, d, qq) == 1) { return r; }
    }
    var cs, ce = _bj_vx_cross1(a, b, c, d);
    var ks, ke = _bj_k_ux_from(k);
    if (mode == 0) {
        var u0: f64 = _bj_k_ux_mul_f64(cs, ce, ks, ke);
        return u0;
    }
    var ss, se = _bj_k_ux_mul(cs, ce, ks, ke);
    var ts, te = _bj_k_ux_from(k2);
    var u1: f64 = _bj_k_ux_mul_f64(ss, se, ts, te);
    return u1;
}

# 1 when every part of the cross c = E × B is normal or an exact 0 through zero factors (and, mode 1, its product by k
# finite): the common case, where every part's _bj_wave_flux_part is Rust's ci·k (·k2).
#must_use
fn _bj_wave_cross_plain(e: BjFieldVector, b: BjFieldVector, c: BjFieldVector, k: f64, mode): i64 {
    var lo: f64 = _BJ_VX_MN;
    var hi: f64 = _BJ_VX_HI;
    var cx: f64 = c.x;
    var cy: f64 = c.y;
    var cz: f64 = c.z;
    var ax: f64 = f64_abs(cx);
    var ay: f64 = f64_abs(cy);
    var az: f64 = f64_abs(cz);
    var ox = 0;
    var oy = 0;
    var oz = 0;
    if (ax >= lo && ax <= hi) { ox = 1; }
    if (ay >= lo && ay <= hi) { oy = 1; }
    if (az >= lo && az <= hi) { oz = 1; }
    if (ox == 0 && cx == 0.0 && (e.y == 0.0 || b.z == 0.0) && (e.z == 0.0 || b.y == 0.0)) { ox = 1; }
    if (oy == 0 && cy == 0.0 && (e.z == 0.0 || b.x == 0.0) && (e.x == 0.0 || b.z == 0.0)) { oy = 1; }
    if (oz == 0 && cz == 0.0 && (e.x == 0.0 || b.y == 0.0) && (e.y == 0.0 || b.x == 0.0)) { oz = 1; }
    if (ox == 0 || oy == 0 || oz == 0) { return 0; }
    if (mode == 1) {
        var m: f64 = ax;
        if (ay > m) { m = ay; }
        if (az > m) { m = az; }
        var sm: f64 = m * k;
        if (sm > hi) { return 0; }
    }
    return 1;
}

# S = E × B/μ₀ (W/m²), the energy flux: BjFieldVector's cross (ADR 0002 row 18 at a range edge), then each part by
# 1/μ₀, with an unbounded exponent where a part of the cross falls below 2^-1022 (_bj_wave_flux_part). Mirrors
# `wave::poynting_vector`.
#must_use
public fn bj_poynting_vector(e: BjFieldVector, b: BjFieldVector): BjFieldVector {
    var c: BjFieldVector = e.cross(b);
    var k: f64 = 1.0 / BJ_MU_0;
    if (_bj_wave_cross_plain(e, b, c, 0.0, 0) == 1) {
        var s0: BjFieldVector = c.scale(k);
        return s0;
    }
    var sx: f64 = _bj_wave_flux_part(e.y, b.z, e.z, b.y, c.x, k, 0.0, 0);
    var sy: f64 = _bj_wave_flux_part(e.z, b.x, e.x, b.z, c.y, k, 0.0, 0);
    var sz: f64 = _bj_wave_flux_part(e.x, b.y, e.y, b.x, c.z, k, 0.0, 0);
    var s: BjFieldVector = BjFieldVector_new(sx, sy, sz);
    return s;
}

# I = c·ε₀·E₀²/2 (W/m²), a plane wave's time-averaged intensity, correctly rounded (ADR 0002 row 13; a non-finite E₀
# keeps Rust's 0.5·c·ε₀·E₀·E₀). Mirrors `wave::plane_wave_intensity`.
#must_use
#pure
public fn bj_plane_wave_intensity(e_amplitude: f64): f64 {
    if (_bj_is_finite(e_amplitude) == 0) {
        var i: f64 = 0.5 * BJ_SPEED_OF_LIGHT * BJ_EPSILON_0 * e_amplitude * e_amplitude;
        return i;
    }
    var cr: f64 = _bj_k_cr_mul5(0.5, BJ_SPEED_OF_LIGHT, BJ_EPSILON_0, e_amplitude, e_amplitude);
    return cr;
}

# P = I/c (Pa), the radiation pressure on a perfect absorber. Mirrors `wave::radiation_pressure_absorbed`.
#must_use
#pure
public fn bj_radiation_pressure_absorbed(intensity: f64): f64 {
    var p: f64 = intensity / BJ_SPEED_OF_LIGHT;
    return p;
}

# P = 2I/c (Pa), on a perfect reflector, correctly rounded (ADR 0002 row 13): for |I| ≤ DBL_MAX/2 Rust's 2I is exact,
# so 2I/c rounds once; above it Rust's 2I overflows, and RN(I/c)·2 is RN(2I/c) exactly (I/c is normal, the doubling
# exact). Mirrors `wave::radiation_pressure_reflected`.
#must_use
#pure
public fn bj_radiation_pressure_reflected(intensity: f64): f64 {
    var half_max: f64 = _bj_from_bits(0x7FDFFFFFFFFFFFFF);    # DBL_MAX/2
    var a: f64 = f64_abs(intensity);
    if (a > half_max) {
        var q: f64 = intensity / BJ_SPEED_OF_LIGHT;
        var p2: f64 = q * 2.0;
        return p2;
    }
    var two_i: f64 = 2.0 * intensity;
    var p: f64 = two_i / BJ_SPEED_OF_LIGHT;
    return p;
}

# E₀ = c·B₀. Mirrors `wave::e_from_b`.
#must_use
#pure
public fn bj_e_from_b(b_amplitude: f64): f64 {
    var e: f64 = BJ_SPEED_OF_LIGHT * b_amplitude;
    return e;
}

# B₀ = E₀/c. Mirrors `wave::b_from_e`.
#must_use
#pure
public fn bj_b_from_e(e_amplitude: f64): f64 {
    var b: f64 = e_amplitude / BJ_SPEED_OF_LIGHT;
    return b;
}

# E(x, t) = E₀ sin(kx − ωt + φ), a plane wave along +x. Rust's chain, or at a range edge (a product below 2^-1022 or 0
# by underflow, a sum past DBL_MAX) the unbounded one: kx, ωt and the sums to 53 bits, the sine of that argument to 53
# bits (past DBL_MAX by Payne–Hanek, src/crmath_ux.cyr), the product by E₀ rounded once (ADR 0002 row 18's rule, M2
# part 2d-2b: Rust's sin(±∞) was NaN for an argument whose sine exists). A non-finite operand keeps Rust's chain.
# Mirrors `wave::plane_wave_e`.
#must_use
#pure
public fn bj_plane_wave_e(e_amplitude: f64, k: f64, x: f64, omega: f64, t: f64, phase: f64): f64 {
    var kx: f64 = k * x;
    var wt: f64 = omega * t;
    var d: f64 = kx - wt;
    var arg: f64 = d + phase;
    var ak: f64 = f64_abs(kx);
    var aw: f64 = f64_abs(wt);
    var ad: f64 = f64_abs(d);
    var aa: f64 = f64_abs(arg);
    var plain = 0;
    if (ak > _BJ_VX_MN && aw > _BJ_VX_MN && ad <= _BJ_VX_HI && aa <= _BJ_VX_HI) { plain = 1; }
    if (plain == 0) {
        var fin: f64 = (phase - phase) + (e_amplitude - e_amplitude);
        if (_bj_vx_finite4(k, x, omega, t) == 0 || fin != 0.0) { plain = 1; }
    }
    if (plain == 0) {
        if (_bj_vx_exact(k, x, kx) == 1 && _bj_vx_exact(omega, t, wt) == 1 && ad <= _BJ_VX_HI && aa <= _BJ_VX_HI) {
            plain = 1;
        }
    }
    if (plain == 1) {
        var s: f64 = _bj_sin(arg);
        var e: f64 = e_amplitude * s;
        return e;
    }
    var ps, pe = _bj_vx_mul(k, x);
    var qs, qe = _bj_vx_mul(omega, t);
    var ds, de = _bj_k_ux_sub(ps, pe, qs, qe);
    var fs, fe = _bj_k_ux_from(phase);
    var as2, ae2 = _bj_k_ux_add(ds, de, fs, fe);
    var ss, se = _bj_vx_sin53(as2, ae2);
    var es, ee = _bj_k_ux_from(e_amplitude);
    var u: f64 = _bj_k_ux_mul_f64(es, ee, ss, se);
    return u;
}

# k = 2πf/v, correctly rounded (ADR 0002 row 13; a non-finite f or v keeps Rust's (2π·f)/v). DivisionByZero when
# |v| < 1e-30 (a NaN v passes, as Rust's test). Mirrors `wave::wave_number`.
public fn bj_wave_number(frequency: f64, velocity: f64): Result {
    var a: f64 = f64_abs(velocity);
    if (a < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("velocity cannot be zero for wave number"));
    }
    var two_pi: f64 = 2.0 * _BJ_PI;
    if (_bj_is_finite(frequency) == 0 || _bj_is_finite(velocity) == 0) {
        var w: f64 = two_pi * frequency;
        var k: f64 = w / velocity;
        return Ok(k);
    }
    var cr: f64 = _bj_k_cr_mul_div(two_pi, frequency, velocity);
    return Ok(cr);
}

# ω = 2πf. Mirrors `wave::angular_frequency`.
#must_use
#pure
public fn bj_angular_frequency(frequency: f64): f64 {
    var w: f64 = 2.0 * _BJ_PI * frequency;
    return w;
}

# g = S/c² (kg/(m²·s)), the momentum density: S as bj_poynting_vector's, then each part by 1/c²; with an unbounded
# exponent where S or the cross passes DBL_MAX while g = (E × B)ε₀ is representable, or a part of the cross falls below
# 2^-1022 (_bj_wave_flux_part). Mirrors `wave::momentum_density`.
#must_use
public fn bj_momentum_density(e: BjFieldVector, b: BjFieldVector): BjFieldVector {
    var c: BjFieldVector = e.cross(b);
    var k: f64 = 1.0 / BJ_MU_0;
    var c2: f64 = BJ_SPEED_OF_LIGHT * BJ_SPEED_OF_LIGHT;
    var k2: f64 = 1.0 / c2;
    if (_bj_wave_cross_plain(e, b, c, k, 1) == 1) {
        var sv: BjFieldVector = c.scale(k);
        var g0: BjFieldVector = sv.scale(k2);
        return g0;
    }
    var gx: f64 = _bj_wave_flux_part(e.y, b.z, e.z, b.y, c.x, k, k2, 1);
    var gy: f64 = _bj_wave_flux_part(e.z, b.x, e.x, b.z, c.y, k, k2, 1);
    var gz: f64 = _bj_wave_flux_part(e.x, b.y, e.y, b.x, c.z, k, k2, 1);
    var g: BjFieldVector = BjFieldVector_new(gx, gy, gz);
    return g;
}

# ── refraction and reflection, the angle forms ───────────────────────────────────────────────────────────────────
# These take any index (a negative one refracts negatively) and any angle; only a zero divisor is refused.

# θ_t = asin(n₁ sin θ_i/n₂), Snell's law: Ok(Some) with θ_t in *out, or Ok(None) when |n₁ sin θ_i/n₂| > 1 (total
# internal reflection). DivisionByZero when |n₂| < 1e-30. An n₁ sin θ_i below 2^-1022 (or 0 by underflow) runs with an
# unbounded exponent, the quotient rounded once (ADR 0002 row 18's rule, M2 part 2d-2b). Mirrors
# `wave::snell_refraction_angle`.
public fn bj_snell_refraction_angle(n1: f64, n2: f64, theta_i: f64, out: *f64): Result {
    var a: f64 = f64_abs(n2);
    if (a < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("refractive index n₂ cannot be zero"));
    }
    var s: f64 = _bj_sin(theta_i);
    var p: f64 = n1 * s;
    var sin_t: f64 = p / n2;
    var ap: f64 = f64_abs(p);
    if (!(ap > _BJ_VX_MN) && _bj_vx_finite4(n1, s, n2, 0.0) == 1 && _bj_vx_exact(n1, s, p) == 0) {
        var ps, pe = _bj_vx_mul(n1, s);             # n₁ sin θ_i below 2^-1022: unbounded, the quotient rounded once
        var ns, ne = _bj_k_ux_from(n2);
        sin_t = _bj_k_ux_div_f64(ps, pe, ns, ne);
    }
    var m: f64 = f64_abs(sin_t);
    if (m > 1.0) { return Ok(None); }
    var t: f64 = _bj_asin(sin_t);
    out[0] = t;
    return Ok(Some);
}

# θ_c = asin(n₂/n₁): Ok(Some) with θ_c in *out, or Ok(None) when n₂/n₁ ≥ 1 (no total internal reflection).
# DivisionByZero when |n₁| < 1e-30. Mirrors `wave::critical_angle`.
public fn bj_critical_angle(n1: f64, n2: f64, out: *f64): Result {
    var a: f64 = f64_abs(n1);
    if (a < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("refractive index n₁ cannot be zero"));
    }
    var ratio: f64 = n2 / n1;
    if (ratio >= 1.0) { return Ok(None); }
    var t: f64 = _bj_asin(ratio);
    out[0] = t;
    return Ok(Some);
}

# θ_B = atan(n₂/n₁), where the reflection is purely s-polarized. DivisionByZero when |n₁| < 1e-30. Mirrors
# `wave::brewster_angle`.
public fn bj_brewster_angle(n1: f64, n2: f64): Result {
    var a: f64 = f64_abs(n1);
    if (a < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("refractive index n₁ cannot be zero"));
    }
    var ratio: f64 = n2 / n1;
    var t: f64 = _bj_atan(ratio);
    return Ok(t);
}

# (a·x − b·y)/(a·x + b·y), the Fresnel ratios' and reflectance_normal's chain: Rust's, or at a range edge (a sum past
# DBL_MAX, a product below 2^-1022 or 0 from nonzero factors) the unbounded one, each step to 53 bits and the quotient
# rounded once (src/crmath_vx.cyr; ADR 0002 row 18's rule, M2 part 2d-2a: the ratio is scale-free, so Rust's 1/3 of
# DBL_MAX and DBL_MAX/2 came out 0). DivisionByZero "Fresnel denominator is zero" when the chain's denominator has a
# magnitude below 1e-30 (strict = 1, the angle forms) or is 0 (strict = 0, the trig-free family).
fn _bj_wave_ratio_of(a: f64, x: f64, b: f64, y: f64, strict): Result {
    var p: f64 = a * x;
    var q: f64 = b * y;
    var num: f64 = p - q;
    var den: f64 = p + q;
    var pa: f64 = f64_abs(p);                       # the common case, inline: both products normal and both sums
    var qa: f64 = f64_abs(q);                       # finite (an ∞ product fails the sums' test, a NaN every test)
    var na: f64 = f64_abs(num);
    var da: f64 = f64_abs(den);
    var plain = 0;
    if (pa > _BJ_VX_MN && qa > _BJ_VX_MN && na <= _BJ_VX_HI && da <= _BJ_VX_HI) { plain = 1; }
    if (plain == 0) { plain = _bj_vx_ratio_plain(a, x, b, y, p, q, num, den); }
    if (plain == 0) {
        var st: i64[1];
        var ru: f64 = _bj_vx_ratio_ux(a, x, b, y, &st);
        if (st[0] == 1 || (strict == 1 && st[0] == 2)) {
            return Err(_bj_err_division_by_zero("Fresnel denominator is zero"));
        }
        return Ok(ru);
    }
    if (strict == 1) {
        var m: f64 = f64_abs(den);
        if (m < 0.000000000000000000000000000001) {
            return Err(_bj_err_division_by_zero("Fresnel denominator is zero"));
        }
        var r: f64 = num / den;
        return Ok(r);
    }
    var tr, vr = _bj_wave_ratio(num, den);
    if (is_err_result(tr) == 1) { return Err(vr); }
    return Ok(vr);
}

# (a cos θ_i − b cos θ_t)/(a cos θ_i + b cos θ_t): r_s with (a, b) = (n₁, n₂), r_p with (n₂, n₁). DivisionByZero when
# the denominator's magnitude is below 1e-30; a range edge as _bj_wave_ratio_of.
fn _bj_wave_fresnel_angles(a: f64, theta_i: f64, b: f64, theta_t: f64): Result {
    var ci: f64 = _bj_cos(theta_i);
    var ct: f64 = _bj_cos(theta_t);
    var t, v = _bj_wave_ratio_of(a, ci, b, ct, 1);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# r_s = (n₁ cos θ_i − n₂ cos θ_t)/(n₁ cos θ_i + n₂ cos θ_t), TE. DivisionByZero when the denominator's magnitude is
# below 1e-30. Mirrors `wave::fresnel_rs`.
public fn bj_fresnel_rs(n1: f64, theta_i: f64, n2: f64, theta_t: f64): Result {
    var t, v = _bj_wave_fresnel_angles(n1, theta_i, n2, theta_t);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# r_p = (n₂ cos θ_i − n₁ cos θ_t)/(n₂ cos θ_i + n₁ cos θ_t), TM. As bj_fresnel_rs. Mirrors `wave::fresnel_rp`.
public fn bj_fresnel_rp(n1: f64, theta_i: f64, n2: f64, theta_t: f64): Result {
    var t, v = _bj_wave_fresnel_angles(n2, theta_i, n1, theta_t);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# R_s = r_s². As bj_fresnel_rs. Mirrors `wave::reflectance_s`.
public fn bj_reflectance_s(n1: f64, theta_i: f64, n2: f64, theta_t: f64): Result {
    var t, v = _bj_wave_fresnel_angles(n1, theta_i, n2, theta_t);
    if (is_err_result(t) == 1) { return Err(v); }
    var r: f64 = v;
    var rr: f64 = r * r;
    return Ok(rr);
}

# R_p = r_p². As bj_fresnel_rp. Mirrors `wave::reflectance_p`.
public fn bj_reflectance_p(n1: f64, theta_i: f64, n2: f64, theta_t: f64): Result {
    var t, v = _bj_wave_fresnel_angles(n2, theta_i, n1, theta_t);
    if (is_err_result(t) == 1) { return Err(v); }
    var r: f64 = v;
    var rr: f64 = r * r;
    return Ok(rr);
}

# R = ((n₁ − n₂)/(n₁ + n₂))² at normal incidence. DivisionByZero when the exact |n₁ + n₂| < 10^-30 (ADR 0002 row
# 17's rule, M2 part 2c-1: the rounded sum decides outside 64 ulps of the double nearest 10^-30, src/crmath_cmp.cyr's
# exact sum inside; a NaN sum passes, as Rust's test). The ratio as _bj_wave_ratio_of (a sum past DBL_MAX). Mirrors
# `wave::reflectance_normal`.
public fn bj_reflectance_normal(n1: f64, n2: f64): Result {
    var den: f64 = n1 + n2;
    var m: f64 = f64_abs(den);
    var band = _bj_x_band(m, _BJ_FIELD_R2_MIN);
    if (band == 2) { band = _bj_x_sum_below(n1, n2, 30); }
    if (band == 1) {
        return Err(_bj_err_division_by_zero("sum of refractive indices cannot be zero"));
    }
    var tq, vq = _bj_wave_ratio_of(n1, 1.0, n2, 1.0, 0);
    var r: f64 = vq;
    var rr: f64 = r * r;
    return Ok(rr);
}

# T = 1 − R at normal incidence; bj_reflectance_normal's error. Mirrors `wave::transmittance_normal`.
public fn bj_transmittance_normal(n1: f64, n2: f64): Result {
    var t, v = bj_reflectance_normal(n1, n2);
    if (is_err_result(t) == 1) { return Err(v); }
    var r: f64 = v;
    var tt: f64 = 1.0 - r;
    return Ok(tt);
}

# ── the trig-free Fresnel family ─────────────────────────────────────────────────────────────────────────────────

# Validated (cos θ_i, cos θ_t) into cs[0], cs[1]: Ok(Some), or Ok(None) under total internal reflection (cs[0] only).
# DivisionByZero for n₂ = 0; InvalidParameter unless both indices are positive and finite, then unless cos θ_i is in
# [0, 1] (a value within 1e-6 outside it is clamped). cos θ_t = √(1 − (n₁/n₂)²(1 − cos²θ_i)), None when the sine²
# passes 1: the test exact (n₁²(1 − cos²θ_i) > n₂²) and cos θ_t = √(n₂² − n₁²(1 − cos²θ_i))/n₂ correctly rounded (ADR
# 0002 row 17, M2 part 2c-3, src/crmath_edge.cyr). Mirrors wave.rs's `check_indices`, `check_cos_theta_i` and
# `fresnel_cosines`.
fn _bj_wave_cosines(n1: f64, n2: f64, cos_theta_i: f64, cs: *f64): Result {
    if (n2 == 0.0) { return Err(_bj_err_division_by_zero("refractive index n₂ cannot be zero")); }
    if (!(_bj_is_finite(n1) == 1 && n1 > 0.0 && _bj_is_finite(n2) == 1 && n2 > 0.0)) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "refractive indices must be positive and finite, got n₁=");
        _bj_fmt_f64_display(t, n1);
        _bj_tx_cstr(t, ", n₂=");
        _bj_fmt_f64_display(t, n2);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var ci: f64 = cos_theta_i;
    var hi: f64 = 1.0 + 0.000001;
    if (!(ci >= 0.0 && ci <= 1.0)) {
        if (ci >= -0.000001 && ci <= hi) {
            if (ci < 0.0) { ci = 0.0; } else { ci = 1.0; }
        } else {
            var u = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(u, "cos θ_i must lie in [0, 1] (measured against the incident-side normal), got ");
            _bj_fmt_f64_display(u, cos_theta_i);
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
    }
    cs[0] = ci;
    var co: f64[1];
    if (_bj_cr_cos_t(n1, n2, ci, 0, &co) == 1) { return Ok(None); }
    var ct: f64 = co[0];
    cs[1] = ct;
    return Ok(Some);
}

# num/den for a Fresnel ratio whose denominator is a sum of non-negative terms: DivisionByZero when it is 0.
fn _bj_wave_ratio(num: f64, den: f64): Result {
    if (den == 0.0) { return Err(_bj_err_division_by_zero("Fresnel denominator is zero")); }
    var r: f64 = num / den;
    return Ok(r);
}

# 0.5·(r_s² + r_p²), r_s = (a cos θ_i − b cos θ_t)/(a cos θ_i + b cos θ_t) and r_p the same with a and b swapped: the
# index form passes (n₁, n₂), the material form (η₂, η₁). Each ratio as _bj_wave_ratio_of; r_s² + r_p² never nears the
# underflow (r_s vanishes only for n₁ = n₂, a shortcut, so |r_s| ≳ 2^-53 for distinct doubles).
fn _bj_wave_unpolarized(a: f64, b: f64, ci: f64, ct: f64): Result {
    var t1, v1 = _bj_wave_ratio_of(a, ci, b, ct, 0);
    if (is_err_result(t1) == 1) { return Err(v1); }
    var t2, v2 = _bj_wave_ratio_of(b, ci, a, ct, 0);
    if (is_err_result(t2) == 1) { return Err(v2); }
    var rs: f64 = v1;
    var rp: f64 = v2;
    var s: f64 = rs * rs + rp * rp;
    var r: f64 = 0.5 * s;
    return Ok(r);
}

# r for (a, b): None (TIR), 0 when n₁ = n₂ (also at grazing incidence, where the formula is 0/0), else the ratio.
fn _bj_wave_direct(n1: f64, n2: f64, cos_theta_i: f64, swap, out: *f64): Result {
    var cs: f64[2];
    var t, v = _bj_wave_cosines(n1, n2, cos_theta_i, &cs);
    if (is_err_result(t) == 1) { return Err(v); }
    if (v == None) { return Ok(None); }
    if (n1 == n2) {
        out[0] = 0.0;
        return Ok(Some);
    }
    var a: f64 = n1;
    var b: f64 = n2;
    if (swap == 1) {
        a = n2;
        b = n1;
    }
    var ci: f64 = cs[0];
    var ct: f64 = cs[1];
    var tr, vr = _bj_wave_ratio_of(a, ci, b, ct, 0);
    if (is_err_result(tr) == 1) { return Err(vr); }
    out[0] = vr;
    return Ok(Some);
}

# cos θ_t = √(1 − (n₁/n₂)²(1 − cos²θ_i)), no trig: Ok(Some) with it in *out, or Ok(None) under total internal
# reflection. DivisionByZero for n₂ = 0; InvalidParameter for an index that is not positive and finite, or cos θ_i
# outside [0, 1] beyond the 1e-6 clamp. Mirrors `wave::snell_cos_theta_t`.
public fn bj_snell_cos_theta_t(n1: f64, n2: f64, cos_theta_i: f64, out: *f64): Result {
    var cs: f64[2];
    var t, v = _bj_wave_cosines(n1, n2, cos_theta_i, &cs);
    if (is_err_result(t) == 1) { return Err(v); }
    if (v == None) { return Ok(None); }
    out[0] = cs[1];
    return Ok(Some);
}

# r_s from cos θ_i, no trig: Ok(Some) with r_s in *out (exactly 0 for n₁ = n₂, grazing incidence included), or Ok(None)
# under total internal reflection (|r_s| = 1). The errors of bj_snell_cos_theta_t. Mirrors `wave::fresnel_rs_direct`.
public fn bj_fresnel_rs_direct(n1: f64, n2: f64, cos_theta_i: f64, out: *f64): Result {
    var t, v = _bj_wave_direct(n1, n2, cos_theta_i, 0, out);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# r_p from cos θ_i, no trig: as bj_fresnel_rs_direct with n₁ and n₂ swapped in the ratio. Mirrors
# `wave::fresnel_rp_direct`.
public fn bj_fresnel_rp_direct(n1: f64, n2: f64, cos_theta_i: f64, out: *f64): Result {
    var t, v = _bj_wave_direct(n1, n2, cos_theta_i, 1, out);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# R_s = r_s² from cos θ_i, 1 under total internal reflection. Mirrors `wave::reflectance_s_direct`.
public fn bj_reflectance_s_direct(n1: f64, n2: f64, cos_theta_i: f64): Result {
    var r: f64[1];
    var t, v = _bj_wave_direct(n1, n2, cos_theta_i, 0, &r);
    if (is_err_result(t) == 1) { return Err(v); }
    if (v == None) { return Ok(1.0); }
    var x: f64 = r[0];
    var xx: f64 = x * x;
    return Ok(xx);
}

# R_p = r_p² from cos θ_i, 1 under total internal reflection. Mirrors `wave::reflectance_p_direct`.
public fn bj_reflectance_p_direct(n1: f64, n2: f64, cos_theta_i: f64): Result {
    var r: f64[1];
    var t, v = _bj_wave_direct(n1, n2, cos_theta_i, 1, &r);
    if (is_err_result(t) == 1) { return Err(v); }
    if (v == None) { return Ok(1.0); }
    var x: f64 = r[0];
    var xx: f64 = x * x;
    return Ok(xx);
}

# R = (R_s + R_p)/2 from cos θ_i, in [0, 1]: 1 under total internal reflection, 0 for n₁ = n₂; cos θ_t is computed
# once for both polarizations. The errors of bj_snell_cos_theta_t. Mirrors `wave::reflectance_unpolarized`.
public fn bj_reflectance_unpolarized(n1: f64, n2: f64, cos_theta_i: f64): Result {
    var cs: f64[2];
    var t, v = _bj_wave_cosines(n1, n2, cos_theta_i, &cs);
    if (is_err_result(t) == 1) { return Err(v); }
    if (v == None) { return Ok(1.0); }
    if (n1 == n2) { return Ok(0.0); }
    var tu, vu = _bj_wave_unpolarized(n1, n2, cs[0], cs[1]);
    if (is_err_result(tu) == 1) { return Err(vu); }
    return Ok(vu);
}

# T = 1 − R from cos θ_i, in [0, 1]; bj_reflectance_unpolarized's errors. Mirrors `wave::transmittance_unpolarized`.
public fn bj_transmittance_unpolarized(n1: f64, n2: f64, cos_theta_i: f64): Result {
    var t, v = bj_reflectance_unpolarized(n1, n2, cos_theta_i);
    if (is_err_result(t) == 1) { return Err(v); }
    var r: f64 = v;
    var tt: f64 = 1.0 - r;
    return Ok(tt);
}

# Schlick's R ≈ R₀ + (1 − R₀)(1 − cos θ)⁵, R₀ = ((n₁ − n₂)/(n₁ + n₂))², with θ on the optically thinner side: θ_i for
# n₁ ≤ n₂, θ_t for n₁ > n₂, and exactly 1 under total internal reflection (de Greve 2006). The errors of
# bj_snell_cos_theta_t; R₀ needs no guard of its own, since the indices are positive and finite (ADR 0002 row 24: Rust
# refused indices summing below 1e-30 through reflectance_normal), and its ratio is _bj_wave_ratio_of's (a sum past
# DBL_MAX). Mirrors `wave::schlick_reflectance`.
public fn bj_schlick_reflectance(n1: f64, n2: f64, cos_theta_i: f64): Result {
    var cs: f64[2];
    var t, v = _bj_wave_cosines(n1, n2, cos_theta_i, &cs);
    if (is_err_result(t) == 1) { return Err(v); }
    var c: f64 = cs[0];
    if (n1 > n2) {
        if (v == None) { return Ok(1.0); }
        c = cs[1];
    }
    var tq, vq = _bj_wave_ratio_of(n1, 1.0, n2, 1.0, 0);
    var r: f64 = vq;
    var r0: f64 = r * r;
    var omc: f64 = 1.0 - c;
    var omc2: f64 = omc * omc;
    var omc5: f64 = omc2 * omc2 * omc;
    var w: f64 = 1.0 - r0;
    var rs: f64 = r0 + w * omc5;
    return Ok(rs);
}

# ── the material-based interface ─────────────────────────────────────────────────────────────────────────────────

# R = (r_s² + r_p²)/2 between two lossless materials from cos θ_i, valid for magnetic media: Snell's law on
# n = √(ε_r μ_r), the amplitudes on the relative impedance η = √(μ_r/ε_r), r_s = (η₂ cos θ_i − η₁ cos θ_t)/(η₂ cos θ_i +
# η₁ cos θ_t) and r_p with η₁, η₂ swapped; 1 under total internal reflection, and Γ² = ((η₂ − η₁)/(η₂ + η₁))² for
# n₁ = n₂. The errors of _bj_material_lossless_optical_constants (mat1's first), then of bj_snell_cos_theta_t. A
# subnormal n, or an η past DBL_MAX or subnormal, runs on the roots to 53 bits with an unbounded exponent (row 18's
# rule, M2 part 2d-2c). Mirrors `wave::reflectance_at_interface`.
public fn bj_reflectance_at_interface(mat1: BjMaterial, mat2: BjMaterial, cos_theta_i: f64): Result {
    var o1: f64[2];
    var o2: f64[2];
    var t1, v1 = _bj_material_lossless_optical_constants(mat1, &o1);
    if (is_err_result(t1) == 1) { return Err(v1); }
    var t2, v2 = _bj_material_lossless_optical_constants(mat2, &o2);
    if (is_err_result(t2) == 1) { return Err(v2); }
    var n1: f64 = o1[0];
    var eta1: f64 = o1[1];
    var n2: f64 = o2[0];
    var eta2: f64 = o2[1];
    var lo: f64 = _BJ_VX_MN;
    var hi: f64 = _BJ_VX_HI;
    var same = 0;
    if (n1 == n2) { same = 1; }
    if (!(n1 > lo && n2 > lo)) {
        # An index at or below 2^-1022 (coarse, or a subnormal root rounded up): the TIR test and cos θ_t depend only on
        # n₁/n₂, so they run on the 53-bit indices scaled together into the normal range, the smaller clamped at
        # 2^-200 below the larger (past a ratio of 2^27 both decide alike: TIR below grazing, or cos θ_t = 1).
        var a1s, a1e = _bj_vx_sqrt_ux(mat1.eps_r, mat1.mu_r, 1);
        var a2s, a2e = _bj_vx_sqrt_ux(mat2.eps_r, mat2.mu_r, 1);
        var top = a1e;
        if (a2e > top) { top = a2e; }
        var d1 = a1e - top;
        var d2 = a2e - top;
        if (d1 < 0 - 200) { d1 = 0 - 200; }
        if (d2 < 0 - 200) { d2 = 0 - 200; }
        var s1: f64 = a1s;
        var s2: f64 = a2s;
        var p1: f64 = _bj_k_cr_pow2(d1);
        var p2: f64 = _bj_k_cr_pow2(d2);
        n1 = s1 * p1;
        n2 = s2 * p2;
        same = 0;
        if (s1 == s2 && a1e == a2e) { same = 1; }
    }
    var cs: f64[2];
    var t, v = _bj_wave_cosines(n1, n2, cos_theta_i, &cs);
    if (is_err_result(t) == 1) { return Err(v); }
    if (v == None) { return Ok(1.0); }
    if (same == 1) {
        var g: f64 = _bj_vx_gamma(eta1, eta2, mat1.eps_r, mat1.mu_r, mat2.eps_r, mat2.mu_r);
        var gg: f64 = g * g;
        return Ok(gg);
    }
    if (eta1 > lo && eta1 <= hi && eta2 > lo && eta2 <= hi) {
        var tu, vu = _bj_wave_unpolarized(eta2, eta1, cs[0], cs[1]);
        if (is_err_result(tu) == 1) { return Err(vu); }
        return Ok(vu);
    }
    # An η past DBL_MAX or at or below 2^-1022: the ratios on η's rounded to 53 bits with an unbounded exponent.
    var b1s, b1e = _bj_vx_sqrt_ux(mat1.mu_r, mat1.eps_r, 0);
    var b2s, b2e = _bj_vx_sqrt_ux(mat2.mu_r, mat2.eps_r, 0);
    var ci: f64 = cs[0];
    var ct: f64 = cs[1];
    var st: i64[1];
    var rs: f64 = _bj_vx_ratio_ux2(b2s, b2e, ci, b1s, b1e, ct, &st);
    if (st[0] == 1) { return Err(_bj_err_division_by_zero("Fresnel denominator is zero")); }
    var rp: f64 = _bj_vx_ratio_ux2(b1s, b1e, ci, b2s, b2e, ct, &st);
    if (st[0] == 1) { return Err(_bj_err_division_by_zero("Fresnel denominator is zero")); }
    var sq: f64 = rs * rs + rp * rp;
    var r: f64 = 0.5 * sq;
    return Ok(r);
}

# R = ((η₂ − η₁)/(η₂ + η₁))² at normal incidence between two lossless materials: BjMaterial.try_reflectance_at.
# Mirrors `wave::reflectance_normal_materials`.
public fn bj_reflectance_normal_materials(mat1: BjMaterial, mat2: BjMaterial): Result {
    var t, v = mat1.try_reflectance_at(mat2);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# Γ = (η₂ − η₁)/(η₂ + η₁), the reflection coefficient between two lossless materials, on the relative impedances
# η = √(μ_r/ε_r) (ADR 0002 row 25: Rust took the absolute √(μ_rμ₀/(ε_rε₀)), whose Γ² missed
# bj_reflectance_normal_materials' R in the last bits). The errors of _bj_material_lossless_optical_constants, mat1's
# first. Rust's |η₁ + η₂| < 1e-30 guard is gone (row 25, amended in M2 part 2d-1, the user's answer of 2026-11-13):
# both η are positive, so their sum never vanishes, and the guard refused only pairs of tiny impedances whose Γ is
# well defined. An η past DBL_MAX or subnormal, or a sum past DBL_MAX, runs with an unbounded exponent
# (src/crmath_vx.cyr's _bj_vx_gamma; row 18's rule, M2 part 2d-2c). Mirrors `wave::material_reflection_coefficient`.
public fn bj_material_reflection_coefficient(mat1: BjMaterial, mat2: BjMaterial): Result {
    var o1: f64[2];
    var o2: f64[2];
    var t1, v1 = _bj_material_lossless_optical_constants(mat1, &o1);
    if (is_err_result(t1) == 1) { return Err(v1); }
    var t2, v2 = _bj_material_lossless_optical_constants(mat2, &o2);
    if (is_err_result(t2) == 1) { return Err(v2); }
    var eta1: f64 = o1[1];
    var eta2: f64 = o2[1];
    var g: f64 = _bj_vx_gamma(eta1, eta2, mat1.eps_r, mat1.mu_r, mat2.eps_r, mat2.mu_r);
    return Ok(g);
}

# ── waveguides ───────────────────────────────────────────────────────────────────────────────────────────────────

# 0, or the InvalidParameter of a rectangular waveguide: the Cyrius-only m or n outside a u32 (Rust's type), then a or
# b not positive and finite, then m = n = 0 (there is no TE₀₀ or TM₀₀ mode).
fn _bj_wave_check_rect(a: f64, b: f64, m, n): i64 {
    if (m < 0 || m > 4294967295 || n < 0 || n > 4294967295) {
        var u = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(u, "m and n must be u32s, got m=");
        _bj_tx_i64(u, m);
        _bj_tx_cstr(u, ", n=");
        _bj_tx_i64(u, n);
        return BJ_ERR_INVALID_PARAMETER;
    }
    if (!(_bj_is_finite(a) == 1 && a > 0.0 && _bj_is_finite(b) == 1 && b > 0.0)) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "waveguide dimensions must be positive and finite, got a=");
        _bj_fmt_f64_display(t, a);
        _bj_tx_cstr(t, ", b=");
        _bj_fmt_f64_display(t, b);
        return BJ_ERR_INVALID_PARAMETER;
    }
    if (m == 0 && n == 0) { return _bj_err_invalid_parameter("both m and n cannot be zero (no TE₀₀/TM₀₀ mode)"); }
    return 0;
}

# 0, or InvalidParameter "<what> must be positive and finite, got <x>".
fn _bj_wave_check_positive(what, x: f64): i64 {
    if (_bj_is_finite(x) == 1 && x > 0.0) { return 0; }
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, what);
    _bj_tx_cstr(t, " must be positive and finite, got ");
    _bj_fmt_f64_display(t, x);
    return BJ_ERR_INVALID_PARAMETER;
}

# √((m/a)² + (n/b)²), and pl[0] = 1 when that is the unbounded chain's (row 18's rule, M2 part 2d-2c): each square
# above 2^-1022 or an exact 0 (m or n = 0) and their sum finite, so every step is its 53-bit value; else 0.
#must_use
fn _bj_wave_rect_root(a: f64, b: f64, m, n, pl: *i64): f64 {
    var mf: f64 = f64_from(m);
    var nf: f64 = f64_from(n);
    var ma: f64 = mf / a;
    var nb: f64 = nf / b;
    var m2: f64 = ma * ma;
    var n2: f64 = nb * nb;
    var s: f64 = m2 + n2;
    var r: f64 = f64_sqrt(s);
    var ok = 1;
    if (s > _BJ_VX_HI) { ok = 0; }
    if (m != 0 && !(m2 > _BJ_VX_MN)) { ok = 0; }
    if (n != 0 && !(n2 > _BJ_VX_MN)) { ok = 0; }
    pl[0] = ok;
    return r;
}

# √((m/a)² + (n/b)²) with an unbounded exponent, each step to 53 bits: (s, e).
#must_use
fn _bj_wave_rect_root_ux(a: f64, b: f64, m, n): (f64, i64) {
    var mf: f64 = f64_from(m);
    var nf: f64 = f64_from(n);
    var ms, me = _bj_k_ux_from(mf);
    var ns, ne = _bj_k_ux_from(nf);
    var as1, ae1 = _bj_k_ux_from(a);
    var bs1, be1 = _bj_k_ux_from(b);
    var qs, qe = _bj_k_ux_div(ms, me, as1, ae1);
    var ps, pe = _bj_k_ux_div(ns, ne, bs1, be1);
    var q2s, q2e = _bj_k_ux_mul(qs, qe, qs, qe);
    var p2s, p2e = _bj_k_ux_mul(ps, pe, ps, pe);
    var ss, se = _bj_k_ux_add(q2s, q2e, p2s, p2e);
    var rs, re = _bj_k_ux_sqrt(ss, se);
    return (rs, re);
}

# f_c = (v/2)√((m/a)² + (n/b)²) (Hz), the cutoff of a rectangular waveguide's TE_mn or TM_mn mode: a, b its sides
# (a ≥ b by convention), v the filling medium's phase velocity (c for air), m and n u32s. The errors of the check
# (m, n, then a, b, then m = n = 0), then InvalidParameter unless v is positive and finite. Where the root's squares
# under- or overflow, or v/2 is subnormal, the chain runs with an unbounded exponent and f_c rounds once (row 18's rule,
# M2 part 2d-2c). Mirrors `wave::rectangular_waveguide_cutoff`.
public fn bj_rectangular_waveguide_cutoff(a: f64, b: f64, m, n, velocity: f64): Result {
    var c = _bj_wave_check_rect(a, b, m, n);
    if (c != 0) { return Err(c); }
    var cv = _bj_wave_check_positive("wave velocity", velocity);
    if (cv != 0) { return Err(cv); }
    var pl: i64[1];
    var r: f64 = _bj_wave_rect_root(a, b, m, n, &pl);
    var hv: f64 = 0.5 * velocity;
    var fc: f64 = hv * r;
    var hm: f64 = _BJ_VX_MN;
    if (pl[0] == 1 && hv > hm) { return Ok(fc); }
    var rs, re = _bj_wave_rect_root_ux(a, b, m, n);
    var vs, ve = _bj_k_ux_from(velocity);
    var u: f64 = _bj_k_ux_mul_f64(vs, ve - 1, rs, re);
    return Ok(u);
}

# λ_c = 2/√((m/a)² + (n/b)²) (m). The check's errors, then InvalidParameter when λ_c is not representable: Rust's root
# 0 or NaN, and at a range edge (squares under- or overflowing) the unbounded chain's λ_c past DBL_MAX; there a
# representable λ_c is computed and rounded once (row 18's rule, M2 part 2d-2c: Rust gave 0 for an ∞ root and refused
# sides of 10^300 m). Mirrors `wave::rectangular_waveguide_cutoff_wavelength`.
public fn bj_rectangular_waveguide_cutoff_wavelength(a: f64, b: f64, m, n): Result {
    var c = _bj_wave_check_rect(a, b, m, n);
    if (c != 0) { return Err(c); }
    var pl: i64[1];
    var r: f64 = _bj_wave_rect_root(a, b, m, n, &pl);
    if (pl[0] == 0) {
        # At a range edge: λ_c = 2/r rounded once from the unbounded root, "not representable" when it passes DBL_MAX.
        var rs, re = _bj_wave_rect_root_ux(a, b, m, n);
        var lu: f64 = _bj_k_ux_div_f64(1.0, 1, rs, re);
        if (lu <= _BJ_VX_HI) { return Ok(lu); }
        r = 0.0;
    }
    if (r != r || r <= 0.0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "cutoff wavelength not representable for a=");
        _bj_fmt_f64_display(t, a);
        _bj_tx_cstr(t, ", b=");
        _bj_fmt_f64_display(t, b);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var lc: f64 = 2.0 / r;
    return Ok(lc);
}

# λ_g = λ/√(1 − (λ/λ_c)²) (m), above cutoff (λ < λ_c); λ_c = +∞ (a TEM line) gives λ. DivisionByZero for λ_c = 0;
# InvalidParameter for a NaN or negative λ_c, then a λ that is not positive and finite, then λ/λ_c ≥ 1 (its text
# gives the ratio to 4 decimals, Rust's `{ratio:.4}`). Mirrors `wave::guide_wavelength`.
public fn bj_guide_wavelength(free_space_wavelength: f64, cutoff_wavelength: f64): Result {
    var lc: f64 = cutoff_wavelength;
    var lam: f64 = free_space_wavelength;
    if (lc == 0.0) { return Err(_bj_err_division_by_zero("cutoff wavelength cannot be zero")); }
    if (lc != lc || lc < 0.0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "cutoff wavelength must be positive, got ");
        _bj_fmt_f64_display(t, lc);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (!(_bj_is_finite(lam) == 1 && lam > 0.0)) {
        var u = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(u, "wavelength must be positive and finite, got ");
        _bj_fmt_f64_display(u, lam);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var ratio: f64 = lam / lc;
    var rr: f64 = ratio * ratio;
    var rad: f64 = 1.0 - rr;
    if (rad != rad || rad <= 0.0) {
        var w = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(w, "frequency below cutoff: λ/λ_c = ");
        _bj_fmt_f64_fixed(w, ratio, 4);
        _bj_tx_cstr(w, " (must be < 1)");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var s: f64 = f64_sqrt(rad);
    var lg: f64 = lam / s;
    return Ok(lg);
}

# f_c = x·v/(2πa) (Hz), the cutoff of a circular waveguide's mode: a its radius, v the filling medium's phase velocity,
# x the mode's root: x′_mn of J′_m for TE_mn (TE₁₁ 1.8412, the dominant mode; TE₂₁ 3.0542; TE₀₁ 3.8317), x_mn of J_m for
# TM_mn (TM₀₁ 2.4048, TM₁₁ 3.8317), correctly rounded (ADR 0002 row 13: Rust's x·v and 2πa over- or underflowed
# where f_c is representable). InvalidParameter unless the radius, then the root, then v is positive and finite.
# Mirrors `wave::cylindrical_waveguide_cutoff`.
public fn bj_cylindrical_waveguide_cutoff(radius: f64, bessel_root: f64, velocity: f64): Result {
    var c = _bj_wave_check_positive("waveguide radius", radius);
    if (c == 0) { c = _bj_wave_check_positive("Bessel root", bessel_root); }
    if (c == 0) { c = _bj_wave_check_positive("wave velocity", velocity); }
    if (c != 0) { return Err(c); }
    var two_pi: f64 = 2.0 * _BJ_PI;
    var fc: f64 = _bj_k_cr_mul2_div2(bessel_root, velocity, two_pi, radius);
    return Ok(fc);
}

# ── antennas ─────────────────────────────────────────────────────────────────────────────────────────────────────

# U(θ) = sin²θ, a Hertzian (short) dipole's normalized pattern (peak 1 at θ = π/2). Mirrors
# `wave::hertzian_dipole_pattern`.
#must_use
#pure
public fn bj_hertzian_dipole_pattern(theta: f64): f64 {
    var s: f64 = _bj_sin(theta);
    var u: f64 = s * s;
    return u;
}

# U(θ) = [cos((π/2) cos θ)/sin θ]², a half-wave dipole's normalized pattern; 0 where |sin θ| < 1e-15 (the axis nulls).
# The numerator is sin(π·sin²(θ/2)), or sin(π·cos²(θ/2)) where cos θ < 0: the same real number with no cancellation
# near either axis, where Rust's cos((π/2)·cos θ) lost every digit below θ ≈ 10^-8 (ADR 0002 row 28; a few ulps
# everywhere). Mirrors `wave::half_wave_dipole_pattern`.
#must_use
#pure
public fn bj_half_wave_dipole_pattern(theta: f64): f64 {
    var sp, cp = _bj_sin_cos(theta);
    var s: f64 = sp;
    var c: f64 = cp;
    var a: f64 = f64_abs(s);
    if (a < 0.000000000000001) { return 0.0; }
    var h: f64 = 0.5 * theta;
    var m: f64 = 0.0;
    if (c >= 0.0) {
        var sh: f64 = _bj_sin(h);
        m = sh * sh;
    } else {
        var ch: f64 = _bj_cos(h);
        m = ch * ch;
    }
    var arg: f64 = _BJ_PI * m;
    var num: f64 = _bj_sin(arg);
    var f: f64 = num / s;
    var u: f64 = f * f;
    return u;
}

# D = 1.5 (1.76 dBi), a Hertzian dipole's directivity. Mirrors `wave::hertzian_dipole_directivity`.
#must_use
#pure
public fn bj_hertzian_dipole_directivity(): f64 {
    return 1.5;
}

# D = 4/Cin(2π) = 1.6409224 (2.15 dBi), a half-wave dipole's directivity, Cin the cosine integral: the double nearest
# the exact value (ADR 0002 row 22; Rust returned 1.6409). Mirrors `wave::half_wave_dipole_directivity`.
#must_use
#pure
public fn bj_half_wave_dipole_directivity(): f64 {
    var d: f64 = _BJ_WAVE_HALF_WAVE_D;
    return d;
}

# R_rad = (2π/3)·η₀·(dl/λ)² (Ω), a Hertzian dipole's radiation resistance, η₀ = √(μ₀/ε₀) (bj_free_space_impedance):
# (2π/3)·η₀ is the double nearest 789.0221 (ADR 0002 row 22; Rust's 80π² = 789.5684 assumed η₀ = 120π), and the
# product with (dl/λ)² is rounded once on that double (row 13; a non-finite dl or λ keeps K·(dl/λ)·(dl/λ)).
# DivisionByZero when |λ| < 1e-30. Mirrors `wave::hertzian_dipole_radiation_resistance`.
public fn bj_hertzian_dipole_radiation_resistance(dipole_length: f64, wavelength: f64): Result {
    var a: f64 = f64_abs(wavelength);
    if (a < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("wavelength cannot be zero"));
    }
    if (_bj_is_finite(dipole_length) == 0 || _bj_is_finite(wavelength) == 0) {
        var ratio: f64 = dipole_length / wavelength;
        var r: f64 = _BJ_WAVE_HERTZ_K * ratio * ratio;
        return Ok(r);
    }
    var cr: f64 = _bj_k_cr_mul3_div2(_BJ_WAVE_HERTZ_K, dipole_length, dipole_length, wavelength, wavelength);
    return Ok(cr);
}

# R_rad = η₀·Cin(2π)/(4π) = 73.079 Ω, a half-wave dipole's radiation resistance on bijli's η₀ (bj_free_space_impedance):
# the double nearest the exact value (ADR 0002 row 22; Rust returned 73.1, 120π's 73.13 rounded). Mirrors
# `wave::half_wave_dipole_radiation_resistance`.
#must_use
#pure
public fn bj_half_wave_dipole_radiation_resistance(): f64 {
    var r: f64 = _BJ_WAVE_HALF_WAVE_R;
    return r;
}

# A_e = λ²D/(4π) (m²), an antenna's effective aperture, correctly rounded (ADR 0002 row 13; a non-finite λ or D keeps
# Rust's λ·λ·D/(4π)). InvalidParameter unless λ ≥ 0: a NaN λ too (row 23; Rust's `λ < 0` let it through as NaN).
# Mirrors `wave::effective_aperture`.
public fn bj_effective_aperture(wavelength: f64, directivity: f64): Result {
    if (!(wavelength >= 0.0)) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "wavelength must be non-negative, got ");
        _bj_fmt_f64_display(t, wavelength);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var fp: f64 = 4.0 * _BJ_PI;
    if (_bj_is_finite(wavelength) == 0 || _bj_is_finite(directivity) == 0) {
        var l2d: f64 = wavelength * wavelength * directivity;
        var ae: f64 = l2d / fp;
        return Ok(ae);
    }
    var cr: f64 = _bj_k_cr_mul3_div(wavelength, wavelength, directivity, fp);
    return Ok(cr);
}

# P_r/P_t = G_t·G_r·(λ/(4πd))², Friis's transmission equation (a power ratio), correctly rounded (ADR 0002 row 13; a
# non-finite operand keeps Rust's G_t·G_r·ratio·ratio). Singularity when |d| < 1e-30. Mirrors
# `wave::friis_transmission`.
public fn bj_friis_transmission(gain_tx: f64, gain_rx: f64, wavelength: f64, distance: f64): Result {
    var a: f64 = f64_abs(distance);
    if (a < 0.000000000000000000000000000001) { return Err(_bj_err_singularity()); }
    var fp: f64 = 4.0 * _BJ_PI;
    if (_bj_is_finite(gain_tx) == 0 || _bj_is_finite(gain_rx) == 0 || _bj_is_finite(wavelength) == 0
      || _bj_is_finite(distance) == 0) {
        var d: f64 = fp * distance;
        var ratio: f64 = wavelength / d;
        var p: f64 = gain_tx * gain_rx * ratio * ratio;
        return Ok(p);
    }
    var num: f64[4];
    var den: f64[4];
    num[0] = gain_tx;
    num[1] = gain_rx;
    num[2] = wavelength;
    num[3] = wavelength;
    den[0] = fp;
    den[1] = fp;
    den[2] = distance;
    den[3] = distance;
    var cr: f64 = _bj_k_cr_mono(&num, 4, &den, 4);
    return Ok(cr);
}

# --- circuit.cyr ---

# circuit.cyr — Ohm's law, series and parallel combinations, capacitance and inductance, the RC and RL transients and
# the series RLC relations (port of rust-old/src/circuit.rs, M2 part 1c).
#
# SI units: ohms, farads, henries, volts, amperes, seconds. Every formula is Rust's in Rust's order: the golden rows
# compare bit for bit (class A), and the transients take bijli's correctly rounded exp and expm1 (class C). A
# series sum is Rust's `Sum`, a left fold from −0.0. Rust's `&[f64]` is a pointer and a count. Two of Rust's faults are
# fixed: bj_resistance_from_geometry and bj_parallel_plate_capacitance refuse a NaN area or separation, which Rust's
# `<= 0` let through (ADR 0002 row 26, rows 19 and 23's rule), and the charging transients take 1 − e^(−t/τ) as
# −expm1(−t/τ), with no cancellation (row 29, the user's answer of 2026-11-12). The products, quotients and roots of
# inputs and constants are rounded once (ADR 0002 row 13, M2 part 2b-3): ρL/A, εA/d, the two energies, μn²Al (bijli's
# exact product of five doubles, src/crmath_mono.cyr), the resonances, Q and ζ; a constant enters as its double (2π as
# Rust's π doubled), and a non-finite operand keeps Rust's chain. The parallel resistance and inductance and the series
# capacitance are 1/Σ 1/xᵢ from the exact sum, rounded once, with its zero test exact (ADR 0002 row 17, M2 part 2c-5).
# The series sums, the transients and the impedance (sums inside) are Rust's, except at a range edge: a series fold
# past DBL_MAX, the impedance's chain (M2 part 2d-3a) and the transients' τ, t/τ, V/R and e^x or expm1 (2d-3b) run with
# an unbounded exponent (ADR 0002 row 18's rule). A fallible function returns a value-form Result, the error in the
# last-error record (src/error.cyr). The impedance here is a magnitude, so no time convention (src/complex.cyr) is
# involved.

private

# ── Ohm's law ────────────────────────────────────────────────────────────────────────────────────────────────────

# V = IR. Mirrors `circuit::voltage`.
#must_use
#pure
public fn bj_voltage(current: f64, resistance: f64): f64 {
    var v: f64 = current * resistance;
    return v;
}

# I = V/R. DivisionByZero when |R| < 1e-30. Mirrors `circuit::current`.
public fn bj_current(voltage: f64, resistance: f64): Result {
    var a: f64 = f64_abs(resistance);
    if (a < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("resistance cannot be zero for Ohm's law"));
    }
    var i: f64 = voltage / resistance;
    return Ok(i);
}

# R = V/I. DivisionByZero when |I| < 1e-30. Mirrors `circuit::resistance`.
public fn bj_resistance(voltage: f64, current: f64): Result {
    var a: f64 = f64_abs(current);
    if (a < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("current cannot be zero for resistance calculation"));
    }
    var r: f64 = voltage / current;
    return Ok(r);
}

# P = IV (W). Mirrors `circuit::power`.
#must_use
#pure
public fn bj_power(current: f64, voltage: f64): f64 {
    var p: f64 = current * voltage;
    return p;
}

# R = ρL/A, correctly rounded (ADR 0002 row 13; a non-finite ρ, L or A keeps Rust's (ρ·L)/A). InvalidParameter unless
# A > 0, a NaN area too (row 26; Rust's `A <= 0` let it through). Mirrors `circuit::resistance_from_geometry`.
public fn bj_resistance_from_geometry(resistivity: f64, length: f64, cross_section_area: f64): Result {
    if (!(cross_section_area > 0.0)) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "cross-section area must be positive, got ");
        _bj_fmt_f64_display(t, cross_section_area);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (_bj_is_finite(resistivity) == 0 || _bj_is_finite(length) == 0 || _bj_is_finite(cross_section_area) == 0) {
        var rl: f64 = resistivity * length;
        var r: f64 = rl / cross_section_area;
        return Ok(r);
    }
    var cr: f64 = _bj_k_cr_mul_div(resistivity, length, cross_section_area);
    return Ok(cr);
}

# ── series and parallel ──────────────────────────────────────────────────────────────────────────────────────────

# The InvalidParameter of an empty combination: "at least one <what> value is required".
fn _bj_circuit_empty(what): i64 {
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, "at least one ");
    _bj_tx_cstr(t, what);
    _bj_tx_cstr(t, " value is required");
    return BJ_ERR_INVALID_PARAMETER;
}

# x₁ + x₂ + …, Rust's `Sum` (a left fold from −0.0); InvalidParameter for n = 0. Where a partial sum of finite values
# passed DBL_MAX (the fold then ends ±∞ or NaN, ∞ − ∞), the fold runs with an unbounded exponent, each step to 53 bits
# and the last rounded once (ADR 0002 row 18's rule, M2 part 2d-3a): a finite fold had no partial past DBL_MAX, and a
# sum of doubles never loses anything to the underflow. A non-finite value keeps Rust's fold.
fn _bj_circuit_sum(xs: *f64, n, what): Result {
    if (n <= 0) { return Err(_bj_circuit_empty(what)); }
    var acc: f64 = -0.0;
    for (var i = 0; i < n; i = i + 1) { acc = acc + xs[i]; }
    var d: f64 = acc - acc;
    if (d == 0.0) { return Ok(acc); }
    for (var j = 0; j < n; j = j + 1) {
        var x: f64 = xs[j];
        if (_bj_is_finite(x) == 0) { return Ok(acc); }
    }
    var as1, ae1 = _bj_k_ux_from(xs[0]);
    for (var k = 1; k < n - 1; k = k + 1) {
        var ys, ye = _bj_k_ux_from(xs[k]);
        var ts, te = _bj_k_ux_add(as1, ae1, ys, ye);
        as1 = ts;
        ae1 = te;
    }
    var ls, le = _bj_k_ux_from(xs[n - 1]);
    var u: f64 = _bj_k_ux_add_f64(as1, ae1, ls, le);
    return Ok(u);
}

# 1/(1/x₁ + 1/x₂ + …): InvalidParameter for n = 0; DivisionByZero "<what> cannot be zero in <kind> combination" for an
# |xᵢ| < 1e-30 (the first, in order, as Rust's loop), and "sum of inverse <what>s is zero" when |Σ 1/xᵢ| < 10^-30
# exactly. The combination is 1/Σ 1/xᵢ rounded once, from the exact sum (src/crmath_edge.cyr; ADR 0002 row 17, M2
# part 2c-5): Rust's rounded sum cancelled when the signs differ. A NaN value keeps Rust's chain (its NaN); Allocation
# when the exact path's buffers are refused.
fn _bj_circuit_inverse(xs: *f64, n, what, kind): Result {
    if (n <= 0) { return Err(_bj_circuit_empty(what)); }
    var nan = 0;
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = xs[i];
        var a: f64 = f64_abs(x);
        if (a < 0.000000000000000000000000000001) {
            var t = _bj_err_reason(BJ_ERR_DIVISION_BY_ZERO);
            _bj_tx_cstr(t, what);
            _bj_tx_cstr(t, " cannot be zero in ");
            _bj_tx_cstr(t, kind);
            _bj_tx_cstr(t, " combination");
            return Err(BJ_ERR_DIVISION_BY_ZERO);
        }
        if (x != x) { nan = 1; }
    }
    if (nan == 1) {
        var s: f64 = 0.0;
        for (var i2 = 0; i2 < n; i2 = i2 + 1) {
            var x2: f64 = xs[i2];
            var inv: f64 = 1.0 / x2;
            s = s + inv;
        }
        var r: f64 = 1.0 / s;
        return Ok(r);
    }
    var o: f64[1];
    var z = _bj_cr_parallel(xs, n, 0, &o);
    if (z == 1) {
        var u = _bj_err_reason(BJ_ERR_DIVISION_BY_ZERO);
        _bj_tx_cstr(u, "sum of inverse ");
        _bj_tx_cstr(u, what);
        _bj_tx_cstr(u, "s is zero");
        return Err(BJ_ERR_DIVISION_BY_ZERO);
    }
    if (z == 2) {
        var w = _bj_err_reason(BJ_ERR_ALLOCATION);
        _bj_tx_cstr(w, "the exact ");
        _bj_tx_cstr(w, kind);
        _bj_tx_cstr(w, " combination's buffers");
        return Err(BJ_ERR_ALLOCATION);
    }
    var rv: f64 = o[0];
    return Ok(rv);
}

# R = R₁ + R₂ + … over the n values at resistances. InvalidParameter for n = 0. Mirrors `circuit::resistance_series`.
public fn bj_resistance_series(resistances: *f64, n): Result {
    var t, v = _bj_circuit_sum(resistances, n, "resistance");
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# 1/R = 1/R₁ + 1/R₂ + …. InvalidParameter for n = 0; DivisionByZero for an |Rᵢ| < 1e-30 or an |Σ 1/Rᵢ| < 1e-30.
# Mirrors `circuit::resistance_parallel`.
public fn bj_resistance_parallel(resistances: *f64, n): Result {
    var t, v = _bj_circuit_inverse(resistances, n, "resistance", "parallel");
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# 1/C = 1/C₁ + 1/C₂ + …. As bj_resistance_parallel. Mirrors `circuit::capacitance_series`.
public fn bj_capacitance_series(capacitances: *f64, n): Result {
    var t, v = _bj_circuit_inverse(capacitances, n, "capacitance", "series");
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# C = C₁ + C₂ + …. InvalidParameter for n = 0. Mirrors `circuit::capacitance_parallel`.
public fn bj_capacitance_parallel(capacitances: *f64, n): Result {
    var t, v = _bj_circuit_sum(capacitances, n, "capacitance");
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# L = L₁ + L₂ + …. InvalidParameter for n = 0. Mirrors `circuit::inductance_series`.
public fn bj_inductance_series(inductances: *f64, n): Result {
    var t, v = _bj_circuit_sum(inductances, n, "inductance");
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# 1/L = 1/L₁ + 1/L₂ + …. As bj_resistance_parallel. Mirrors `circuit::inductance_parallel`.
public fn bj_inductance_parallel(inductances: *f64, n): Result {
    var t, v = _bj_circuit_inverse(inductances, n, "inductance", "parallel");
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# ── capacitance and inductance ───────────────────────────────────────────────────────────────────────────────────

# C = εA/d, correctly rounded (ADR 0002 row 13; a non-finite ε, A or d keeps Rust's (ε·A)/d). InvalidParameter unless
# d > 0, a NaN separation too (row 26; Rust's `d <= 0` let it through). Mirrors `circuit::parallel_plate_capacitance`.
public fn bj_parallel_plate_capacitance(permittivity: f64, area: f64, separation: f64): Result {
    if (!(separation > 0.0)) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "plate separation must be positive, got ");
        _bj_fmt_f64_display(t, separation);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (_bj_is_finite(permittivity) == 0 || _bj_is_finite(area) == 0 || _bj_is_finite(separation) == 0) {
        var ea: f64 = permittivity * area;
        var c: f64 = ea / separation;
        return Ok(c);
    }
    var cr: f64 = _bj_k_cr_mul_div(permittivity, area, separation);
    return Ok(cr);
}

# U = CV²/2 (J), correctly rounded (ADR 0002 row 13; a non-finite C or V keeps Rust's 0.5·C·V·V). Mirrors
# `circuit::capacitor_energy`.
#must_use
#pure
public fn bj_capacitor_energy(capacitance: f64, voltage: f64): f64 {
    if (_bj_is_finite(capacitance) == 0 || _bj_is_finite(voltage) == 0) {
        var u: f64 = 0.5 * capacitance * voltage * voltage;
        return u;
    }
    var cr: f64 = _bj_k_cr_mul4(0.5, capacitance, voltage, voltage);
    return cr;
}

# Q = CV (C). Mirrors `circuit::capacitor_charge`.
#must_use
#pure
public fn bj_capacitor_charge(capacitance: f64, voltage: f64): f64 {
    var q: f64 = capacitance * voltage;
    return q;
}

# L = μn²Al (H): n turns per unit length, A the cross-section, l the length; correctly rounded (ADR 0002 row 13: five
# full-precision doubles, bijli's _bj_cr_mul5; a non-finite operand keeps Rust's μ·n·n·A·l). Mirrors
# `circuit::solenoid_inductance`.
#must_use
#pure
public fn bj_solenoid_inductance(permeability: f64, turns_per_length: f64, area: f64, length: f64): f64 {
    if (_bj_is_finite(permeability) == 0 || _bj_is_finite(turns_per_length) == 0 || _bj_is_finite(area) == 0
      || _bj_is_finite(length) == 0) {
        var l: f64 = permeability * turns_per_length * turns_per_length * area * length;
        return l;
    }
    var cr: f64 = _bj_cr_mul5(permeability, turns_per_length, turns_per_length, area, length);
    return cr;
}

# U = LI²/2 (J), correctly rounded (ADR 0002 row 13; a non-finite L or I keeps Rust's 0.5·L·I·I). Mirrors
# `circuit::inductor_energy`.
#must_use
#pure
public fn bj_inductor_energy(inductance: f64, current: f64): f64 {
    if (_bj_is_finite(inductance) == 0 || _bj_is_finite(current) == 0) {
        var u: f64 = 0.5 * inductance * current * current;
        return u;
    }
    var cr: f64 = _bj_k_cr_mul4(0.5, inductance, current, current);
    return cr;
}

# ── RC and RL transients ─────────────────────────────────────────────────────────────────────────────────────────

# 1 when the exact |R·C| < 10^-30 (an instant transient), else 0: the rounded τ = RC decides outside 64 ulps of the
# double nearest 10^-30, the exact product inside (src/crmath_cmp.cyr; ADR 0002 row 17's rule, M2 part 2c-1). A NaN τ
# is not instant, as Rust's test.
#must_use
fn _bj_circuit_instant_rc(r: f64, c: f64, tau: f64): i64 {
    var a: f64 = f64_abs(tau);
    var band = _bj_x_band(a, _BJ_FIELD_R2_MIN);
    if (band == 2) { band = _bj_x_prod_below(r, c, 30); }
    return band;
}

# 1 when the exact |L/R| < 10^-30, else 0, as _bj_circuit_instant_rc (R nonzero: the callers refuse |R| < 1e-30).
#must_use
fn _bj_circuit_instant_rl(l: f64, r: f64, tau: f64): i64 {
    var a: f64 = f64_abs(tau);
    var band = _bj_x_band(a, _BJ_FIELD_R2_MIN);
    if (band == 2) { band = _bj_x_quot_below(l, r, 30); }
    return band;
}

# ── the transients at a range edge (M2 part 2d-3b) ──────────────────────────────────────────────────────────────
# amp·w for x = −t/τ, w = −expm1(x) (mode 0, a charge or rise) or e^x (mode 1, a discharge or decay), on the chain's
# τ and amplitude given as 53-bit pairs, every step to 53 bits with an unbounded exponent and the product rounded once
# (ADR 0002 row 18's rule). |x| below 2^-60: w = −x or 1. |x| from 4096: a charge's w = 1 for x < 0, and otherwise
# the product overflows or (a decay's x < 0) rounds to zero, its amplitude being at least 2^-2098 (V/R) and at most
# 2^1024 (an input).
# Between, x is a double: bijli's correctly rounded expm1 or exp where w is normal, else e^x by _bj_ux_exp_lim (past
# 709, −expm1 and −e^x round alike: e^x > 2^1023 lies nowhere near a rounding boundary). A zero amplitude gives IEEE's
# signed zero against w's sign (Rust's 0·∞ was NaN), and t = 0 a signed zero (or the amplitude). τ and the
# amplitude are finite.
#must_use
fn _bj_circuit_edge(as1: f64, ae, ts: f64, te, t: f64, mode): f64 {
    var nt: f64 = -t;
    var ns, ne = _bj_k_ux_from(nt);
    var xs, xe = _bj_k_ux_div(ns, ne, ts, te);
    if (xs == 0.0) {
        # t = 0 (τ past DBL_MAX): x = ∓0, so w = −expm1(x) = ±0 exactly, or e^x = 1.
        if (mode == 1) {
            var r8: f64 = _bj_k_ux_mul_f64(as1, ae, 1.0, 0);
            return r8;
        }
        var w0: f64 = -xs;
        var z0: f64 = as1 * w0;
        return z0;
    }
    var neg = 0;
    if (xs < 0.0) { neg = 1; }
    if (as1 == 0.0) {
        var sg: f64 = 1.0;
        if (mode == 0 && neg == 0) { sg = -1.0; }
        var z: f64 = as1 * sg;
        return z;
    }
    if (xe < 0 - 60) {
        if (mode == 1) {
            var r1: f64 = _bj_k_ux_mul_f64(as1, ae, 1.0, 0);
            return r1;
        }
        var nx: f64 = -xs;
        var r0: f64 = _bj_k_ux_mul_f64(as1, ae, nx, xe);
        return r0;
    }
    if (xe > 11) {
        if (mode == 0 && neg == 1) {
            var r2: f64 = _bj_k_ux_mul_f64(as1, ae, 1.0, 0);
            return r2;
        }
        var big = _BJ_UX_HUGE;
        if (mode == 1 && neg == 1) { big = 0 - _BJ_UX_HUGE; }
        var bs: f64 = 1.0;
        if (mode == 0) { bs = -1.0; }
        var r3: f64 = _bj_k_ux_mul_f64(as1, ae, bs, big);
        return r3;
    }
    var p2: f64 = _bj_k_cr_pow2(xe);
    var xf: f64 = xs * p2;                          # exact: |x| in [2^-60, 4096)
    if (mode == 0) {
        if (xf <= 709.0) {
            var em: f64 = _bj_expm1(xf);
            var w: f64 = -em;
            var wss, wse = _bj_k_ux_from(w);
            var r4: f64 = _bj_k_ux_mul_f64(as1, ae, wss, wse);
            return r4;
        }
        var es, ee = _bj_ux_exp_lim(xf, 2300.0);
        var nes: f64 = -es;
        var r5: f64 = _bj_k_ux_mul_f64(as1, ae, nes, ee);
        return r5;
    }
    if (xf >= -708.0 && xf <= 709.0) {
        var ex: f64 = _bj_exp(xf);
        var xxs, xxe = _bj_k_ux_from(ex);
        var r6: f64 = _bj_k_ux_mul_f64(as1, ae, xxs, xxe);
        return r6;
    }
    var fs, fe = _bj_ux_exp_lim(xf, 2300.0);
    var r7: f64 = _bj_k_ux_mul_f64(as1, ae, fs, fe);
    return r7;
}

# 1 when a transient's Rust chain is the unbounded one (row 18's rule): τ finite (past the instant test it is above
# 10^-30), x = −t/τ in (2^-1022, DBL_MAX] or t = 0, and w (mode 0: −expm1(x), normal whenever x is) finite, or e^x
# (mode 1) in (2^-1022, DBL_MAX]. Each is then its 53-bit value, and the product rounds once in both.
#must_use
fn _bj_circuit_plain(tau: f64, x: f64, w: f64, t: f64, mode): i64 {
    var at: f64 = f64_abs(tau);
    if (!(at <= _BJ_VX_HI)) { return 0; }
    var ax: f64 = f64_abs(x);
    if (!(ax > _BJ_VX_MN && ax <= _BJ_VX_HI) && t != 0.0) { return 0; }
    var aw: f64 = f64_abs(w);
    if (!(aw <= _BJ_VX_HI)) { return 0; }
    if (mode == 1 && !(aw > _BJ_VX_MN)) { return 0; }
    return 1;
}

# 1 when every operand of a transient is finite (a non-finite one keeps Rust's chain).
#must_use
fn _bj_circuit_fin4(a: f64, b: f64, c: f64, d: f64): i64 {
    if (_bj_is_finite(a) == 1 && _bj_is_finite(b) == 1 && _bj_is_finite(c) == 1 && _bj_is_finite(d) == 1) { return 1; }
    return 0;
}

# A transient whose common-case test failed (kind 0: RC charge, 1: RC discharge, 2: RL rise, 3: RL decay; a the
# amplitude V₀, V or I₀, b and c the R and C, or R and L): Rust's chain again, the full test (_bj_circuit_plain, the
# rise's V/R normal or V = 0), then for finite operands _bj_circuit_edge. Out of line: each f64 local a function holds
# costs it time on every call (about 0.6 ns apiece, M2 part 2d-3b), so the fast functions keep only the common test.
#must_use
fn _bj_circuit_slow(a: f64, b: f64, c: f64, t: f64, kind): f64 {
    var tau: f64 = b * c;
    if (kind >= 2) { tau = c / b; }
    var x: f64 = -t / tau;
    var amp: f64 = a;
    if (kind == 2) { amp = a / b; }
    var mode = 0;
    if (kind == 1 || kind == 3) { mode = 1; }
    var w: f64 = 0.0;
    if (mode == 0) {
        var em1: f64 = _bj_expm1(x);
        w = -em1;
    } else {
        w = _bj_exp(x);
    }
    var r: f64 = amp * w;
    var amp_ok = 1;
    if (kind == 2) {
        var am: f64 = f64_abs(amp);
        if (!(am > _BJ_VX_MN && am <= _BJ_VX_HI) && a != 0.0) { amp_ok = 0; }
    }
    if (amp_ok == 1 && _bj_circuit_plain(tau, x, w, t, mode) == 1) { return r; }
    if (_bj_circuit_fin4(a, b, c, t) == 0) { return r; }
    var as1, ae = _bj_k_ux_from(a);
    var bs, be = _bj_k_ux_from(b);
    var cs, ce = _bj_k_ux_from(c);
    if (kind == 2) {
        var qs, qe = _bj_k_ux_div(as1, ae, bs, be);
        as1 = qs;
        ae = qe;
    }
    var ts, te = _bj_k_ux_mul(bs, be, cs, ce);
    if (kind >= 2) {
        var ds, de = _bj_k_ux_div(cs, ce, bs, be);
        ts = ds;
        te = de;
    }
    var u: f64 = _bj_circuit_edge(as1, ae, ts, te, t, mode);
    return u;
}

# τ = RC (s). Mirrors `circuit::rc_time_constant`.
#must_use
#pure
public fn bj_rc_time_constant(resistance: f64, capacitance: f64): f64 {
    var tau: f64 = resistance * capacitance;
    return tau;
}

# V(t) = V₀(1 − e^(−t/RC)); V₀ when the exact |RC| < 10^-30 (an instant charge; ADR 0002 row 17's rule, M2 part 2c-1:
# Rust tested the rounded product). 1 − e^(−t/RC) is −expm1(−t/RC), correctly rounded (row 29: Rust's subtraction
# cancelled for t ≪ RC, and gave 0 below t/RC ≈ 1.1e-16). Mirrors `circuit::rc_charging_voltage`.
#must_use
#pure
public fn bj_rc_charging_voltage(v0: f64, resistance: f64, capacitance: f64, t: f64): f64 {
    var tau: f64 = resistance * capacitance;
    var a: f64 = f64_abs(tau);                     # far from 1e-30 the rounded τ decides at once
    if (a < 0.0000000000000000000000000000005) { return v0; }
    if (a <= 0.000000000000000000000000000002 && _bj_circuit_instant_rc(resistance, capacitance, tau) == 1) {
        return v0;
    }
    var x: f64 = -t / tau;
    var em1: f64 = _bj_expm1(x);
    var w: f64 = -em1;
    var v: f64 = v0 * w;
    var ax: f64 = f64_abs(x);
    var aw: f64 = f64_abs(w);
    if (a <= _BJ_VX_HI && ax > _BJ_VX_MN && ax <= _BJ_VX_HI && aw <= _BJ_VX_HI) { return v; }
    var u: f64 = _bj_circuit_slow(v0, resistance, capacitance, t, 0);
    return u;
}

# V(t) = V₀e^(−t/RC); 0 when the exact |RC| < 10^-30 (an instant discharge; row 17's rule). Mirrors
# `circuit::rc_discharging_voltage`.
#must_use
#pure
public fn bj_rc_discharging_voltage(v0: f64, resistance: f64, capacitance: f64, t: f64): f64 {
    var tau: f64 = resistance * capacitance;
    var a: f64 = f64_abs(tau);
    if (a < 0.0000000000000000000000000000005) { return 0.0; }
    if (a <= 0.000000000000000000000000000002 && _bj_circuit_instant_rc(resistance, capacitance, tau) == 1) {
        return 0.0;
    }
    var x: f64 = -t / tau;
    var e: f64 = _bj_exp(x);
    var v: f64 = v0 * e;
    var ax: f64 = f64_abs(x);
    if (a <= _BJ_VX_HI && ax > _BJ_VX_MN && ax <= _BJ_VX_HI && e > _BJ_VX_MN && e <= _BJ_VX_HI) { return v; }
    var u: f64 = _bj_circuit_slow(v0, resistance, capacitance, t, 1);
    return u;
}

# τ = L/R (s). DivisionByZero when |R| < 1e-30. Mirrors `circuit::rl_time_constant`.
public fn bj_rl_time_constant(inductance: f64, resistance: f64): Result {
    var a: f64 = f64_abs(resistance);
    if (a < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("resistance cannot be zero for RL time constant"));
    }
    var tau: f64 = inductance / resistance;
    return Ok(tau);
}

# I(t) = (V/R)(1 − e^(−tR/L)); V/R when the exact |L/R| < 10^-30 (an instant rise; row 17's rule), 1 − e^(−tR/L) as
# −expm1(−tR/L) (ADR 0002 row 29). DivisionByZero when |R| < 1e-30. Mirrors `circuit::rl_current_rise`.
public fn bj_rl_current_rise(voltage: f64, resistance: f64, inductance: f64, t: f64): Result {
    var a: f64 = f64_abs(resistance);
    if (a < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("resistance cannot be zero for RL current"));
    }
    var tau: f64 = inductance / resistance;
    var i_max: f64 = voltage / resistance;
    var at: f64 = f64_abs(tau);                    # far from 1e-30 the rounded τ decides at once
    if (at < 0.0000000000000000000000000000005) { return Ok(i_max); }
    if (at <= 0.000000000000000000000000000002 && _bj_circuit_instant_rl(inductance, resistance, tau) == 1) {
        return Ok(i_max);
    }
    var x: f64 = -t / tau;
    var em1: f64 = _bj_expm1(x);
    var w: f64 = -em1;
    var i: f64 = i_max * w;
    var am: f64 = f64_abs(i_max);
    var ax: f64 = f64_abs(x);
    var aw: f64 = f64_abs(w);
    if (at <= _BJ_VX_HI && ax > _BJ_VX_MN && ax <= _BJ_VX_HI && aw <= _BJ_VX_HI && am > _BJ_VX_MN
      && am <= _BJ_VX_HI) {
        return Ok(i);
    }
    var u: f64 = _bj_circuit_slow(voltage, resistance, inductance, t, 2);
    return Ok(u);
}

# I(t) = I₀e^(−tR/L); 0 when the exact |L/R| < 10^-30 (row 17's rule). DivisionByZero when |R| < 1e-30. Mirrors
# `circuit::rl_current_decay`.
public fn bj_rl_current_decay(i0: f64, resistance: f64, inductance: f64, t: f64): Result {
    var a: f64 = f64_abs(resistance);
    if (a < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("resistance cannot be zero for RL decay"));
    }
    var tau: f64 = inductance / resistance;
    var at: f64 = f64_abs(tau);
    if (at < 0.0000000000000000000000000000005) { return Ok(0.0); }
    if (at <= 0.000000000000000000000000000002 && _bj_circuit_instant_rl(inductance, resistance, tau) == 1) {
        return Ok(0.0);
    }
    var x: f64 = -t / tau;
    var e: f64 = _bj_exp(x);
    var i: f64 = i0 * e;
    var ax: f64 = f64_abs(x);
    if (at <= _BJ_VX_HI && ax > _BJ_VX_MN && ax <= _BJ_VX_HI && e > _BJ_VX_MN && e <= _BJ_VX_HI) { return Ok(i); }
    var u: f64 = _bj_circuit_slow(i0, resistance, inductance, t, 3);
    return Ok(u);
}

# ── series RLC ───────────────────────────────────────────────────────────────────────────────────────────────────

# 0, or the InvalidParameter "L and C must be finite and positive, got L=…, C=…".
fn _bj_circuit_check_lc(inductance: f64, capacitance: f64): i64 {
    var l: f64 = inductance;
    var c: f64 = capacitance;
    if (_bj_is_finite(l) == 1 && l > 0.0 && _bj_is_finite(c) == 1 && c > 0.0) { return 0; }
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, "L and C must be finite and positive, got L=");
    _bj_fmt_f64_display(t, l);
    _bj_tx_cstr(t, ", C=");
    _bj_fmt_f64_display(t, c);
    return BJ_ERR_INVALID_PARAMETER;
}

# 0, or the InvalidParameter "resistance must be finite and non-negative, got …".
fn _bj_circuit_check_r(resistance: f64): i64 {
    var r: f64 = resistance;
    if (_bj_is_finite(r) == 1 && r >= 0.0) { return 0; }
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, "resistance must be finite and non-negative, got ");
    _bj_fmt_f64_display(t, r);
    return BJ_ERR_INVALID_PARAMETER;
}

# f₀ = 1/(2π√(LC)) (Hz), correctly rounded (ADR 0002 row 13: √(1/((2π)²LC)), 2π Rust's π doubled). InvalidParameter
# unless L and C are finite and positive. Mirrors `circuit::resonant_frequency`.
public fn bj_resonant_frequency(inductance: f64, capacitance: f64): Result {
    var c = _bj_circuit_check_lc(inductance, capacitance);
    if (c != 0) { return Err(c); }
    var den: f64[4];
    den[0] = 2.0 * _BJ_PI;
    den[1] = 2.0 * _BJ_PI;
    den[2] = inductance;
    den[3] = capacitance;
    var f: f64 = _bj_cr_sqrt_mono(0, 0, &den, 4);
    return Ok(f);
}

# ω₀ = 1/√(LC) (rad/s), correctly rounded (ADR 0002 row 13). As bj_resonant_frequency. Mirrors
# `circuit::resonant_angular_frequency`.
public fn bj_resonant_angular_frequency(inductance: f64, capacitance: f64): Result {
    var c = _bj_circuit_check_lc(inductance, capacitance);
    if (c != 0) { return Err(c); }
    var den: f64[2];
    den[0] = inductance;
    den[1] = capacitance;
    var w: f64 = _bj_cr_sqrt_mono(0, 0, &den, 2);
    return Ok(w);
}

# Q = (1/R)√(L/C) = ω₀L/R, a series RLC's quality factor (a parallel tank's R√(C/L) is not this): Q = 1/(2ζ),
# correctly rounded (ADR 0002 row 13: √(L/(C·R²))).
# InvalidParameter unless R is finite and non-negative; DivisionByZero for R < 1e-30; then InvalidParameter unless L
# and C are finite and positive. Mirrors `circuit::quality_factor`.
public fn bj_quality_factor(resistance: f64, inductance: f64, capacitance: f64): Result {
    var cr = _bj_circuit_check_r(resistance);
    if (cr != 0) { return Err(cr); }
    if (resistance < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("resistance cannot be zero for quality factor"));
    }
    var c = _bj_circuit_check_lc(inductance, capacitance);
    if (c != 0) { return Err(c); }
    var num: f64[1];
    var den: f64[3];
    num[0] = inductance;
    den[0] = capacitance;
    den[1] = resistance;
    den[2] = resistance;
    var q: f64 = _bj_cr_sqrt_mono(&num, 1, &den, 3);
    return Ok(q);
}

# ζ = (R/2)√(C/L), a series RLC's damping ratio: underdamped below 1, critical at 1, overdamped above; ζ = 1/(2Q).
# Correctly rounded for R > 0 (ADR 0002 row 13: kimiya's RN(R·√((C/L)·2^-2))); a zero R keeps Rust's chain (±0).
# InvalidParameter unless R is finite and non-negative, then unless L and C are finite and positive. Mirrors
# `circuit::damping_ratio`.
public fn bj_damping_ratio(resistance: f64, inductance: f64, capacitance: f64): Result {
    var cr = _bj_circuit_check_r(resistance);
    if (cr != 0) { return Err(cr); }
    var c = _bj_circuit_check_lc(inductance, capacitance);
    if (c != 0) { return Err(c); }
    if (resistance == 0.0) {
        var q0: f64 = capacitance / inductance;
        var s: f64 = f64_sqrt(q0);
        var half_r: f64 = resistance * 0.5;
        var z: f64 = half_r * s;
        return Ok(z);
    }
    var zr: f64 = _bj_k_cr_mul_sqrt_ratio(resistance, capacitance, inductance, 0 - 2);
    return Ok(zr);
}

# |Z| = √(R² + (ωL − 1/(ωC))²) (Ω), a series RLC's impedance magnitude at ω. DivisionByZero when |ω| < 1e-30, then
# when |C| < 1e-30. Rust's chain where its R² + X² lies in [2^-900, DBL_MAX] (src/crmath_vx.cyr's band: a product or
# quotient below 2^-1022 is then absorbed, and X is the chain's wherever X² is not negligible); otherwise, for finite
# operands, the chain runs with an unbounded exponent and √ rounds once (ADR 0002 row 18's rule, M2 part 2d-3a: R past
# 1.3·10^154 had made |Z| ∞, and R = 10^-200 at resonance 0). Mirrors `circuit::rlc_impedance`.
public fn bj_rlc_impedance(resistance: f64, inductance: f64, capacitance: f64, angular_freq: f64): Result {
    var w: f64 = angular_freq;
    var aw: f64 = f64_abs(w);
    if (aw < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("angular frequency cannot be zero for impedance"));
    }
    var ac: f64 = f64_abs(capacitance);
    if (ac < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("capacitance cannot be zero for impedance"));
    }
    var wl: f64 = w * inductance;
    var wc: f64 = w * capacitance;
    var inv: f64 = 1.0 / wc;
    var x: f64 = wl - inv;
    var s: f64 = resistance * resistance + x * x;
    var z: f64 = f64_sqrt(s);
    if (s >= _BJ_VX_LO && s <= _BJ_VX_HI) { return Ok(z); }
    if (_bj_is_finite(resistance) == 0 || _bj_is_finite(inductance) == 0 || _bj_is_finite(capacitance) == 0
      || _bj_is_finite(w) == 0) {
        return Ok(z);
    }
    var ws, we = _bj_k_ux_from(w);
    var ls, le = _bj_k_ux_from(inductance);
    var cs, ce = _bj_k_ux_from(capacitance);
    var rs, re = _bj_k_ux_from(resistance);
    var pls, ple = _bj_k_ux_mul(ws, we, ls, le);
    var pcs, pce = _bj_k_ux_mul(ws, we, cs, ce);
    var ivs, ive = _bj_k_ux_div(1.0, 0, pcs, pce);
    var xs, xe = _bj_k_ux_sub(pls, ple, ivs, ive);
    var r2s, r2e = _bj_k_ux_mul(rs, re, rs, re);
    var x2s, x2e = _bj_k_ux_mul(xs, xe, xs, xe);
    var ss, se = _bj_k_ux_add(r2s, r2e, x2s, x2e);
    var zu: f64 = _bj_k_ux_sqrt_f64(ss, se);
    return Ok(zu);
}

# --- relativity.cyr ---

# relativity.cyr — relativistic electrodynamics: the Lorentz factor, the EM field tensor, the Lorentz transformation
# of fields, four-vectors, the retarded and Liénard–Wiechert potentials and fields, and the Larmor powers (port of
# rust-old/src/relativity.rs, M2 part 1d-1; the retarded-time solver and lienard_wiechert_fields are part 1d-2's).
#
# SI units; indices 0 = ct, 1 = x, 2 = y, 3 = z. BjFourVector's dot and interval_sq use the (−,+,+,+) metric
# η = diag(−1, 1, 1, 1). BjEmTensor stores F^μν in the Jackson/Griffiths layout (F^{0i} = −Eᵢ/c, F^{12} = −B_z), the
# contravariant tensor of the (+,−,−,−) signature: contract it with g = diag(1, −1, −1, −1), as four_force does. Rust's
# `components: [[f64; 4]; 4]` is a 16-element tuple field, row-major (probe p17), so `components.(4i + j)` is
# F^{ij}. No complex phasor appears, so no time convention (src/complex.cyr) is involved.
#
# Every formula is Rust's in Rust's order (class A). The FieldVector operations Rust calls are BjFieldVector's, so their
# range edges follow ADR 0002 row 18 (src/field.cyr). Two of Rust's faults are fixed: bj_lienard_wiechert_e refuses a
# NaN R as the Liénard–Wiechert potentials do (ADR 0002 row 27, row 20's rule), and every γ (γ² in Liénard–Wiechert's
# E) is correctly rounded from the exact c² − |v|², the |v| < c tests exact (row 30, src/crmath_gamma.cyr). The
# products and quotients of inputs and constants are rounded once (row 13, M2 part 2b-4): the retarded potentials,
# Larmor's power (src/crmath_mono.cyr's six-factor monomial) and the dual tensor, whose components are F's own; a
# non-finite operand keeps Rust's chain. The raw four-vector and tensor chains (BjFourVector's dot, interval_sq,
# spatial_magnitude and boost_x, the four-force, both invariants) keep Rust's chain where its own values pass the
# guards of src/crmath_vx.cyr, and otherwise run with an unbounded exponent and round once (row 18's rule, M2 part
# 2d-3c). The field transforms and the relativistic Larmor power, whose chains amplify a subnormal intermediate by γ and
# v, keep Rust's chain inside a box on their inputs and otherwise run unbounded (part 2d-3d). A fallible function
# returns a value-form Result, the error in the last-error record (src/error.cyr); a vector, four-vector or pair of
# vectors writes through out pointers.

private

# The 4×4 electromagnetic field tensor F^μν (contravariant, the (+,−,−,−) layout above), row-major. Mirrors
# `relativity::EmTensor`.
public struct BjEmTensor {
    components: (f64, f64, f64, f64, f64, f64, f64, f64, f64, f64, f64, f64, f64, f64, f64, f64);
}

# A four-vector (ct, x, y, z). Mirrors `relativity::FourVector`.
public struct BjFourVector {
    t: f64;
    x: f64;
    y: f64;
    z: f64;
}

# The four-potential A^μ = (φ/c, A_x, A_y, A_z): φ/c and the vector potential. Mirrors `relativity::FourPotential`.
public struct BjFourPotential {
    phi_over_c: f64;
    a: BjFieldVector;
}

# An address as a *f64: a BjEmTensor's sixteen components, from `&t` of a local or an untyped `self` (a `*T`).
fn _bj_rel_f64p(p): *f64 {
    return p;
}

# 1 when the exact |R| < 10^-30 (Σ Rᵢ² < 10^-60), else 0: the rounded |R| decides outside 64 ulps of the double
# nearest 10^-30, the exact sum of squares inside (src/crmath_cmp.cyr; ADR 0002 row 17, as the Green's functions'). A
# NaN |R| is not below (Rust's test), and an ∞ one lies far above.
#must_use
fn _bj_rel_r_below(r_vec: BjFieldVector, r_mag: f64): i64 {
    var band = _bj_x_band(r_mag, _BJ_FIELD_R2_MIN);
    if (band == 2) {
        var rp: f64[3];
        _bj_rel_parts(r_vec, &rp);
        band = _bj_x_r2_below(&rp, &_bj_x_origin, 60);
    }
    return band;
}

# g[k] := s·x (s = 1 or −1) for a finite x: a dual component rounded once is F's own (ADR 0002 row 13); a non-finite
# x leaves Rust's.
fn _bj_rel_dual_put(g: *f64, k, x: f64, s) {
    if (_bj_is_finite(x) == 0) { return 0; }
    if (s < 0) {
        var nx: f64 = -x;
        g[k] = nx;
        return 0;
    }
    g[k] = x;
    return 0;
}

# ── the Lorentz factor ───────────────────────────────────────────────────────────────────────────────────────────

# γ = 1/√(1 − v²/c²), correctly rounded: c/√(c² − v²) from the exact difference (src/crmath_gamma.cyr; ADR 0002 row
# 30: Rust's form cancelled near c, 1e-7 relative at β = 1 − 1e-9, and its rounded v²/c² ≥ 1 refused speeds an ulp
# below c). InvalidParameter "speed (v m/s) must be less than c" unless |v| < c exactly (NaN refused). Mirrors
# `relativity::lorentz_factor`.
public fn bj_lorentz_factor(speed: f64): Result {
    var vv: f64[1];
    vv[0] = speed;
    var g: f64[1];
    if (_bj_cr_lorentz(&vv, 0, 1, BJ_SPEED_OF_LIGHT, 0, 0, &g) == 0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "speed (");
        _bj_fmt_f64_display(t, speed);
        _bj_tx_cstr(t, " m/s) must be less than c");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var gamma: f64 = g[0];
    return Ok(gamma);
}

# The three components of v into p.
fn _bj_rel_parts(v: BjFieldVector, p: *f64) {
    p[0] = v.x;
    p[1] = v.y;
    p[2] = v.z;
    return 0;
}

# β = v/c. Mirrors `relativity::beta`.
#must_use
#pure
public fn bj_beta(speed: f64): f64 {
    var b: f64 = speed / BJ_SPEED_OF_LIGHT;
    return b;
}

# ── the four-vector and tensor chains at a range edge (M2 part 2d-3c) ─────────────────────────────────────────────
# Rust's chains of products and sums over- and underflow where the result is representable (ADR 0002 row 18's rule):
# the guards are src/crmath_vx.cyr's band on Rust's own sums, and the edges run each step to 53 bits with an unbounded
# exponent, the last operation rounded once. A non-finite operand keeps Rust's chain.

# −a₀b₀ + a₁b₁ + a₂b₂ + a₃b₃ at a range edge, Rust's d where its chain is the unbounded one (an exact 0 from exact
# products, or an operand not finite; the band test is the caller's).
#must_use
fn _bj_rel_dot4_edge(a: *f64, b: *f64, d: f64): f64 {
    if (_bj_vx_finite4(a[0], a[1], a[2], a[3]) == 0 || _bj_vx_finite4(b[0], b[1], b[2], b[3]) == 0) { return d; }
    var na: f64 = -a[0];
    if (d == 0.0) {
        var p0: f64 = na * b[0];
        var p1: f64 = a[1] * b[1];
        var p2: f64 = a[2] * b[2];
        var p3: f64 = a[3] * b[3];
        var e = _bj_vx_exact(na, b[0], p0) + _bj_vx_exact(a[1], b[1], p1) + _bj_vx_exact(a[2], b[2], p2)
        + _bj_vx_exact(a[3], b[3], p3);
        if (e == 4) { return d; }
    }
    var s0, e0 = _bj_vx_mul(na, b[0]);
    var s1, e1 = _bj_vx_mul(a[1], b[1]);
    var ss, se = _bj_k_ux_add(s0, e0, s1, e1);
    var s2, e2 = _bj_vx_mul(a[2], b[2]);
    var ts, te = _bj_k_ux_add(ss, se, s2, e2);
    var s3, e3 = _bj_vx_mul(a[3], b[3]);
    var w: f64 = _bj_k_ux_add_f64(ts, te, s3, e3);
    return w;
}

# γ(p − β·q), β = v/c, at a range edge (boost_x's ct' with p = ct and q = x, its x' with them swapped): Rust's γ·d where
# its chain is the unbounded one (β normal or 0 and β·q exact, or d in the band; p or q not finite), else β, β·q and
# p − β·q to 53 bits with an unbounded exponent, the product by γ rounded once.
#must_use
fn _bj_rel_boost_edge(gamma: f64, speed: f64, p: f64, q: f64, d: f64): f64 {
    var r: f64 = gamma * d;
    if (_bj_vx_finite4(p, q, 0.0, 0.0) == 0) { return r; }
    var c: f64 = BJ_SPEED_OF_LIGHT;
    var b: f64 = speed / c;
    var ab: f64 = f64_abs(b);
    if (ab > _BJ_VX_MN || speed == 0.0) {
        var bq: f64 = b * q;
        if (_bj_vx_exact(b, q, bq) == 1 || _bj_vx_band(d) == 1) { return r; }
    }
    var vs, ve = _bj_k_ux_from(speed);
    var cs, ce = _bj_k_ux_from(c);
    var bs, be = _bj_k_ux_div(vs, ve, cs, ce);
    var qs, qe = _bj_k_ux_from(q);
    var ms, me = _bj_k_ux_mul(bs, be, qs, qe);
    var ps, pe = _bj_k_ux_from(p);
    var ds, de = _bj_k_ux_sub(ps, pe, ms, me);
    var gs, ge = _bj_k_ux_from(gamma);
    var u: f64 = _bj_k_ux_mul_f64(gs, ge, ds, de);
    return u;
}

# q·(r₀u₀ + r₁u₁ + r₂u₂ + r₃u₃), one row of the four-force, at a range edge: Rust's k = q·s where its chain is the
# unbounded one (an exact 0 sum of exact products, or an operand not finite; the band test is the caller's), else
# the products and sums to 53 bits with an unbounded exponent, the product by q rounded once.
#must_use
fn _bj_rel_ff_edge(r: *f64, u: *f64, q: f64, s: f64): f64 {
    var k: f64 = q * s;
    if (_bj_vx_finite4(r[0], r[1], r[2], r[3]) == 0 || _bj_vx_finite4(u[0], u[1], u[2], u[3]) == 0
      || _bj_vx_finite4(q, 0.0, 0.0, 0.0) == 0) {
        return k;
    }
    if (s == 0.0) {
        var p0: f64 = r[0] * u[0];
        var p1: f64 = r[1] * u[1];
        var p2: f64 = r[2] * u[2];
        var p3: f64 = r[3] * u[3];
        var e = _bj_vx_exact(r[0], u[0], p0) + _bj_vx_exact(r[1], u[1], p1) + _bj_vx_exact(r[2], u[2], p2)
        + _bj_vx_exact(r[3], u[3], p3);
        if (e == 4) { return k; }
    }
    var s0, e0 = _bj_vx_mul(r[0], u[0]);
    var s1, e1 = _bj_vx_mul(r[1], u[1]);
    var ss, se = _bj_k_ux_add(s0, e0, s1, e1);
    var s2, e2 = _bj_vx_mul(r[2], u[2]);
    var ts, te = _bj_k_ux_add(ss, se, s2, e2);
    var s3, e3 = _bj_vx_mul(r[3], u[3]);
    var ws, we = _bj_k_ux_add(ts, te, s3, e3);
    var qs, qe = _bj_k_ux_from(q);
    var w: f64 = _bj_k_ux_mul_f64(qs, qe, ws, we);
    return w;
}

# 1 when every E component c·F^{i0} of the tensor at f is its exact product (F = 0, or |E| in (2^-1022, DBL_MAX]).
#must_use
fn _bj_rel_e_exact(f: *f64): i64 {
    var c: f64 = BJ_SPEED_OF_LIGHT;
    for (var k = 4; k <= 12; k = k + 4) {
        var fk: f64 = f[k];
        var ek: f64 = fk * c;
        if (_bj_vx_exact(fk, c, ek) == 0) { return 0; }
    }
    return 1;
}

# 1 when the six field components of the tensor at f are finite.
#must_use
fn _bj_rel_fields_finite(f: *f64): i64 {
    if (_bj_vx_finite4(f[4], f[8], f[12], f[14]) == 1 && _bj_vx_finite4(f[7], f[9], 0.0, 0.0) == 1) { return 1; }
    return 0;
}

# 2(B² − E²/c²) at a range edge for the tensor at f: E = c·F^{i0}, E², B², E²/c² and their difference to 53 bits with
# an unbounded exponent, the doubling rounded once; Rust's i for a non-finite component.
#must_use
fn _bj_rel_inv1_edge(f: *f64, i: f64): f64 {
    if (_bj_rel_fields_finite(f) == 0) { return i; }
    var c: f64 = BJ_SPEED_OF_LIGHT;
    var c2: f64 = BJ_SPEED_OF_LIGHT_SQ;
    var xs, xe = _bj_vx_mul(f[4], c);
    var ys, ye = _bj_vx_mul(f[8], c);
    var zs, ze = _bj_vx_mul(f[12], c);
    var x2s, x2e = _bj_k_ux_mul(xs, xe, xs, xe);
    var y2s, y2e = _bj_k_ux_mul(ys, ye, ys, ye);
    var z2s, z2e = _bj_k_ux_mul(zs, ze, zs, ze);
    var es, ee = _bj_k_ux_add(x2s, x2e, y2s, y2e);
    var e2s, e2e = _bj_k_ux_add(es, ee, z2s, z2e);
    var bs, be = _bj_vx_sumsq(f[14], f[7], f[9]);
    var cs, ce = _bj_k_ux_from(c2);
    var qs, qe = _bj_k_ux_div(e2s, e2e, cs, ce);
    var ds, de = _bj_k_ux_sub(bs, be, qs, qe);
    var u: f64 = _bj_k_ux_mul_f64(1.0, 1, ds, de);
    return u;
}

# −E⋅B/c at a range edge for the tensor at f: E = c·F^{i0}, its products with B and their sums to 53 bits with an
# unbounded exponent, the quotient by c rounded once; Rust's i for a non-finite component.
#must_use
fn _bj_rel_inv2_edge(f: *f64, i: f64): f64 {
    if (_bj_rel_fields_finite(f) == 0) { return i; }
    var c: f64 = BJ_SPEED_OF_LIGHT;
    var xs, xe = _bj_vx_mul(f[4], c);
    var ys, ye = _bj_vx_mul(f[8], c);
    var zs, ze = _bj_vx_mul(f[12], c);
    var bxs, bxe = _bj_k_ux_from(f[14]);
    var bys, bye = _bj_k_ux_from(f[7]);
    var bzs, bze = _bj_k_ux_from(f[9]);
    var p0s, p0e = _bj_k_ux_mul(xs, xe, bxs, bxe);
    var p1s, p1e = _bj_k_ux_mul(ys, ye, bys, bye);
    var p2s, p2e = _bj_k_ux_mul(zs, ze, bzs, bze);
    var ss, se = _bj_k_ux_add(p0s, p0e, p1s, p1e);
    var ts, te = _bj_k_ux_add(ss, se, p2s, p2e);
    var nts: f64 = -ts;
    var cs, ce = _bj_k_ux_from(c);
    var u: f64 = _bj_k_ux_div_f64(nts, te, cs, ce);
    return u;
}

# 2^-300 as an f64: the transforms' box's lower bound for a scalar (a speed lies below c, far inside the upper one).
var _BJ_REL_BOX_LO: f64 = 0x2D30000000000000;

# The transforms' box on the BjFieldVector parts at the byte addresses e, b and v (untyped: a typed pointer would cost
# a conversion call on the hot path): each part ±0 or of biased exponent in [723, 1923], i.e. |x| in [2^-300, 2^901),
# on the bit patterns with the sign cleared (a NaN or ±∞ lies above the bound). Straight-line integer tests, one
# helper per caller: on the pinned compiler a call per part, a loop or extra parameters cost more than the margin.
#must_use
fn _bj_rel_box_tf(e, b, v): i64 {
    var m = 0x7FFFFFFFFFFFFFFF;
    var lo = 723 << 52;
    var hi = 1924 << 52;
    var u = 0;
    u = load64(e) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(e + 8) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(e + 16) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(b) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(b + 8) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(b + 16) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(v) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(v + 8) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(v + 16) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    return 1;
}

# lorentz_transform_x's box: the y and z parts of E and B at the byte addresses e and b, the ones it computes with
# (E_x and B_x pass unchanged), tested as _bj_rel_box_tf does; the speed is the caller's (an f64 compare).
#must_use
fn _bj_rel_box_tx(e, b): i64 {
    var m = 0x7FFFFFFFFFFFFFFF;
    var lo = 723 << 52;
    var hi = 1924 << 52;
    var u = 0;
    u = load64(e + 8) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(e + 16) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(b + 8) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(b + 16) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    return 1;
}

# The Larmor power's box on the BjFieldVector parts at the byte addresses v and a: the acceleration's parts in
# [2^-200, 2^481), the velocity's at least 2^-200 (each ±0 allowed), tested as _bj_rel_box_tf does; the charge is the
# caller's (an f64 compare).
#must_use
fn _bj_rel_box_lar(v, a): i64 {
    var m = 0x7FFFFFFFFFFFFFFF;
    var lo = 823 << 52;
    var ha = 1504 << 52;
    var hv = 2047 << 52;
    var u = 0;
    u = load64(a) & m;
    if (u != 0 && (u < lo || u >= ha)) { return 0; }
    u = load64(a + 8) & m;
    if (u != 0 && (u < lo || u >= ha)) { return 0; }
    u = load64(a + 16) & m;
    if (u != 0 && (u < lo || u >= ha)) { return 0; }
    u = load64(v) & m;
    if (u != 0 && (u < lo || u >= hv)) { return 0; }
    u = load64(v + 8) & m;
    if (u != 0 && (u < lo || u >= hv)) { return 0; }
    u = load64(v + 16) & m;
    if (u != 0 && (u < lo || u >= hv)) { return 0; }
    return 1;
}

# 2^-200 and 2^401 as f64s: the Larmor power's bounds on the charge.
var _BJ_REL_LAR_QLO: f64 = 0x3370000000000000;
var _BJ_REL_LAR_QHI: f64 = 0x5900000000000000;

# 1 when none of the n doubles at p is NaN or infinite.
#must_use
fn _bj_rel_finite_n(p: *f64, n): i64 {
    for (var k = 0; k < n; k = k + 1) {
        var x: f64 = p[k];
        var d: f64 = x - x;
        if (d != 0.0) { return 0; }
    }
    return 1;
}

# a⋅b = (a₀b₀ + a₁b₁) + a₂b₂ to 53 bits with an unbounded exponent: (s, e).
#must_use
fn _bj_rel_dot3_ux(a: *f64, b: *f64): (f64, i64) {
    var s0, e0 = _bj_vx_mul(a[0], b[0]);
    var s1, e1 = _bj_vx_mul(a[1], b[1]);
    var ss, se = _bj_k_ux_add(s0, e0, s1, e1);
    var s2, e2 = _bj_vx_mul(a[2], b[2]);
    var ts, te = _bj_k_ux_add(ss, se, s2, e2);
    return (ts, te);
}

# Component i of (a × b)·…: a_j b_k − a_k b_j to 53 bits with an unbounded exponent, for i = 0, 1, 2 (j, k cyclic).
#must_use
fn _bj_rel_cross_ux(a: *f64, b: *f64, i): (f64, i64) {
    var j = (i + 1) % 3;
    var k = (i + 2) % 3;
    var s, e = _bj_vx_cross1(a[j], b[k], a[k], b[j]);
    return (s, e);
}

# Jackson's E' and B' (bj_lorentz_transform_fields' chain) with an unbounded exponent, into e_out and b_out: every
# step to 53 bits, each output's last difference rounded once (ADR 0002 row 18's rule, M2 part 2d-3c's section, part
# 2d-3d). γ is the correctly rounded double; γ + 1, (γ + 1)c², γ² and k run unbounded too.
fn _bj_rel_ltf_edge(e: *f64, b: *f64, v: *f64, gamma: f64, e_out: *f64, b_out: *f64) {
    var c2: f64 = BJ_SPEED_OF_LIGHT_SQ;
    var inv: f64 = 1.0 / c2;
    var gs, ge = _bj_k_ux_from(gamma);
    var g1s, g1e = _bj_k_ux_add(gs, ge, 1.0, 0);
    var cs, ce = _bj_k_ux_from(c2);
    var dns, dne = _bj_k_ux_mul(g1s, g1e, cs, ce);
    var ggs, gge = _bj_k_ux_mul(gs, ge, gs, ge);
    var ks, ke = _bj_k_ux_div(ggs, gge, dns, dne);
    var des, dee = _bj_rel_dot3_ux(v, e);
    var kes, kee = _bj_k_ux_mul(ks, ke, des, dee);
    var dbs, dbe = _bj_rel_dot3_ux(v, b);
    var kbs, kbe = _bj_k_ux_mul(ks, ke, dbs, dbe);
    var is1, ie1 = _bj_k_ux_from(inv);
    for (var i = 0; i < 3; i = i + 1) {
        var xs, xe = _bj_rel_cross_ux(v, b, i);
        var es, ee = _bj_k_ux_from(e[i]);
        var s1s, s1e = _bj_k_ux_add(es, ee, xs, xe);
        var s1gs, s1ge = _bj_k_ux_mul(s1s, s1e, gs, ge);
        var vs, ve = _bj_k_ux_from(v[i]);
        var t1s, t1e = _bj_k_ux_mul(vs, ve, kes, kee);
        var ep: f64 = _bj_k_ux_sub_f64(s1gs, s1ge, t1s, t1e);
        e_out[i] = ep;
        var ys, ye = _bj_rel_cross_ux(v, e, i);
        var qs, qe = _bj_k_ux_mul(ys, ye, is1, ie1);
        var bs, be = _bj_k_ux_from(b[i]);
        var s2s, s2e = _bj_k_ux_sub(bs, be, qs, qe);
        var s2gs, s2ge = _bj_k_ux_mul(s2s, s2e, gs, ge);
        var t2s, t2e = _bj_k_ux_mul(vs, ve, kbs, kbe);
        var bp: f64 = _bj_k_ux_sub_f64(s2gs, s2ge, t2s, t2e);
        b_out[i] = bp;
    }
    return 0;
}

# γ(E_y − vB_z), γ(E_z + vB_y), γ(B_y + vE_z/c²) and γ(B_z − vE_y/c²) (bj_lorentz_transform_x's chain) with an
# unbounded exponent, each product by γ rounded once; E_x and B_x pass unchanged.
fn _bj_rel_ltx_edge(e: *f64, b: *f64, speed: f64, gamma: f64, e_out: *f64, b_out: *f64) {
    var c2: f64 = BJ_SPEED_OF_LIGHT_SQ;
    var gs, ge = _bj_k_ux_from(gamma);
    var cs, ce = _bj_k_ux_from(c2);
    var p1s, p1e = _bj_vx_mul(speed, b[2]);
    var y1s, y1e = _bj_k_ux_from(e[1]);
    var d1s, d1e = _bj_k_ux_sub(y1s, y1e, p1s, p1e);
    var p2s, p2e = _bj_vx_mul(speed, b[1]);
    var z1s, z1e = _bj_k_ux_from(e[2]);
    var d2s, d2e = _bj_k_ux_add(z1s, z1e, p2s, p2e);
    var p3s, p3e = _bj_vx_mul(speed, e[2]);
    var q1s, q1e = _bj_k_ux_div(p3s, p3e, cs, ce);
    var y2s, y2e = _bj_k_ux_from(b[1]);
    var d3s, d3e = _bj_k_ux_add(y2s, y2e, q1s, q1e);
    var p4s, p4e = _bj_vx_mul(speed, e[1]);
    var q2s, q2e = _bj_k_ux_div(p4s, p4e, cs, ce);
    var z2s, z2e = _bj_k_ux_from(b[2]);
    var d4s, d4e = _bj_k_ux_sub(z2s, z2e, q2s, q2e);
    var r1: f64 = _bj_k_ux_mul_f64(gs, ge, d1s, d1e);
    var r2: f64 = _bj_k_ux_mul_f64(gs, ge, d2s, d2e);
    var r3: f64 = _bj_k_ux_mul_f64(gs, ge, d3s, d3e);
    var r4: f64 = _bj_k_ux_mul_f64(gs, ge, d4s, d4e);
    e_out[0] = e[0];
    e_out[1] = r1;
    e_out[2] = r2;
    b_out[0] = b[0];
    b_out[1] = r3;
    b_out[2] = r4;
    return 0;
}

# P = (q²/(6πε₀c³))·γ⁶·(a² − |v × a|²/c²) (bj_relativistic_larmor_power's chain) with an unbounded exponent, the last
# product rounded once; 6πε₀c³ is Rust's double (a normal constant).
#must_use
fn _bj_rel_larmor_edge(charge: f64, v: *f64, a: *f64, gamma: f64, den: f64): f64 {
    var c2: f64 = BJ_SPEED_OF_LIGHT_SQ;
    var gs, ge = _bj_k_ux_from(gamma);
    var g2s, g2e = _bj_k_ux_mul(gs, ge, gs, ge);
    var g4s, g4e = _bj_k_ux_mul(g2s, g2e, g2s, g2e);
    var g6s, g6e = _bj_k_ux_mul(g4s, g4e, g2s, g2e);
    var a2s, a2e = _bj_vx_sumsq(a[0], a[1], a[2]);
    var xs, xe = _bj_rel_cross_ux(v, a, 0);
    var ys, ye = _bj_rel_cross_ux(v, a, 1);
    var zs, ze = _bj_rel_cross_ux(v, a, 2);
    var x2s, x2e = _bj_k_ux_mul(xs, xe, xs, xe);
    var y2s, y2e = _bj_k_ux_mul(ys, ye, ys, ye);
    var z2s, z2e = _bj_k_ux_mul(zs, ze, zs, ze);
    var ws, we = _bj_k_ux_add(x2s, x2e, y2s, y2e);
    var w2s, w2e = _bj_k_ux_add(ws, we, z2s, z2e);
    var qqs, qqe = _bj_vx_mul(charge, charge);
    var dns, dne = _bj_k_ux_from(den);
    var prs, pre = _bj_k_ux_div(qqs, qqe, dns, dne);
    var cs, ce = _bj_k_ux_from(c2);
    var vcs, vce = _bj_k_ux_div(w2s, w2e, cs, ce);
    var ds, de = _bj_k_ux_sub(a2s, a2e, vcs, vce);
    var pgs, pge = _bj_k_ux_mul(prs, pre, g6s, g6e);
    var u: f64 = _bj_k_ux_mul_f64(pgs, pge, ds, de);
    return u;
}

# lienard_wiechert_e's box: the parts of R, β̇ and n̂ − β at the byte addresses r, bd and nm, R's and β̇'s ±0 or in
# [2^-100, 2^201) (biased exponents [923, 1223]), n̂ − β's ±0 or at least 2^-100 (row 17 bounds them by 2): the
# bit-pattern tests of _bj_rel_box_tf. The charge and γ² are the caller's.
#must_use
fn _bj_rel_box_e(r, bd, nm): i64 {
    var m = 0x7FFFFFFFFFFFFFFF;
    var lo = 923 << 52;
    var hi = 1224 << 52;
    var u = 0;
    u = load64(r) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(r + 8) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(r + 16) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(bd) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(bd + 8) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(bd + 16) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(nm) & m;
    if (u != 0 && u < lo) { return 0; }
    u = load64(nm + 8) & m;
    if (u != 0 && u < lo) { return 0; }
    u = load64(nm + 16) & m;
    if (u != 0 && u < lo) { return 0; }
    return 1;
}

# 2^-100 and 2^201 as f64s: the box's bounds on lienard_wiechert_e's charge.
var _BJ_REL_E_QLO: f64 = 0x39B0000000000000;
var _BJ_REL_E_QHI: f64 = 0x4C80000000000000;

# (a × b)ᵢ for pairs: a_j b_k − a_k b_j to 53 bits with an unbounded exponent, a and b three (s, e) pairs each (s at
# as[k], e at ae[k]).
#must_use
fn _bj_rel_cross_pp(as: *f64, ae: *i64, bs: *f64, be: *i64, i): (f64, i64) {
    var j = (i + 1) % 3;
    var k = (i + 2) % 3;
    var ps, pe = _bj_k_ux_mul(as[j], ae[j], bs[k], be[k]);
    var qs, qe = _bj_k_ux_mul(as[k], ae[k], bs[j], be[j]);
    var s, e = _bj_k_ux_sub(ps, pe, qs, qe);
    return (s, e);
}

# lienard_wiechert_e's tail outside its box (ADR 0002 row 18's rule, M2 part 2d-3f), on R and β̇ as 53-bit pairs (R at
# rs and re, β̇ at bs and be; M2 part 2d-3j): |R|, 1/|R|, n̂ = R/|R|, κ³, q/(4πε₀), γ²κ³R², the velocity factor,
# (n̂ − β) × β̇, n̂ × that, κ³Rc, the acceleration factor and both terms to 53 bits with an unbounded exponent. Into o
# (fifteen f64): E's parts, each sum rounded once (o[0..2]); E's 53-bit pairs (o[3..5], their exponents o[6..8]); n̂'s
# (o[9..11], o[12..14]), for lienard_wiechert_fields' B. κ, n̂ − β (row 17) and γ² (row 30) enter as the doubles their
# rows define; the cross products take Rust's order (BjFieldVector's cross).
fn _bj_rel_e_tail(charge: f64, rs: *f64, re: *i64, kappa: f64, gamma_sq: f64, nm: *f64, bs: *f64, be: *i64, o: *f64) {
    var c: f64 = BJ_SPEED_OF_LIGHT;
    var fpe: f64 = 4.0 * _BJ_PI * BJ_EPSILON_0;
    var q0s, q0e = _bj_k_ux_mul(rs[0], re[0], rs[0], re[0]);
    var q1s, q1e = _bj_k_ux_mul(rs[1], re[1], rs[1], re[1]);
    var q2s, q2e = _bj_k_ux_mul(rs[2], re[2], rs[2], re[2]);
    var s1s, s1e = _bj_k_ux_add(q0s, q0e, q1s, q1e);
    var rs2, re2 = _bj_k_ux_add(s1s, s1e, q2s, q2e);
    var ms, me = _bj_k_ux_sqrt(rs2, re2);
    var is1, ie1 = _bj_k_ux_div(1.0, 0, ms, me);
    var ns: f64[3];
    var ne: i64[3];
    var ms3: f64[3];
    var me3: i64[3];
    var ins: f64[3];
    var ine: i64[3];
    for (var i = 0; i < 3; i = i + 1) {
        var ts, te = _bj_k_ux_mul(rs[i], re[i], is1, ie1);
        ns[i] = ts;
        ne[i] = te;
        var xs, xe = _bj_k_ux_from(nm[i]);
        ms3[i] = xs;
        me3[i] = xe;
    }
    for (var i2 = 0; i2 < 3; i2 = i2 + 1) {
        var cs1, ce1 = _bj_rel_cross_pp(&ms3, &me3, bs, be, i2);
        ins[i2] = cs1;
        ine[i2] = ce1;
    }
    var ks, ke = _bj_k_ux_from(kappa);
    var k2s, k2e = _bj_k_ux_mul(ks, ke, ks, ke);
    var k3s, k3e = _bj_k_ux_mul(k2s, k2e, ks, ke);
    var qs, qe = _bj_k_ux_from(charge);
    var fs, fe = _bj_k_ux_from(fpe);
    var ps, pe = _bj_k_ux_div(qs, qe, fs, fe);
    var gs, ge = _bj_k_ux_from(gamma_sq);
    var d1s, d1e = _bj_k_ux_mul(gs, ge, k3s, k3e);
    var d2s, d2e = _bj_k_ux_mul(d1s, d1e, ms, me);
    var d3s, d3e = _bj_k_ux_mul(d2s, d2e, ms, me);
    var fvs, fve = _bj_k_ux_div(ps, pe, d3s, d3e);
    var a1s, a1e = _bj_k_ux_mul(k3s, k3e, ms, me);
    var cs, ce = _bj_k_ux_from(c);
    var a2s, a2e = _bj_k_ux_mul(a1s, a1e, cs, ce);
    var fas, fae = _bj_k_ux_div(ps, pe, a2s, a2e);
    for (var j = 0; j < 3; j = j + 1) {
        var vts, vte = _bj_k_ux_mul(ms3[j], me3[j], fvs, fve);
        var os, oe = _bj_rel_cross_pp(&ns, &ne, &ins, &ine, j);
        var ats, ate = _bj_k_ux_mul(os, oe, fas, fae);
        var ej: f64 = _bj_k_ux_add_f64(vts, vte, ats, ate);
        var es, ee = _bj_k_ux_add(vts, vte, ats, ate);
        o[j] = ej;
        o[3 + j] = es;
        o[6 + j] = f64_from(ee);
        o[9 + j] = ns[j];
        o[12 + j] = f64_from(ne[j]);
    }
    return 0;
}

# ── the electromagnetic tensor ───────────────────────────────────────────────────────────────────────────────────

# F^μν of (E, B): F^{i0} = Eᵢ/c, F^{0i} = −Eᵢ/c, F^{12} = −B_z, F^{13} = B_y, F^{23} = −B_x and their negatives below
# the diagonal. Mirrors `EmTensor::from_fields`.
#must_use
public fn BjEmTensor_from_fields(e: BjFieldVector, b: BjFieldVector): BjEmTensor {
    var t: BjEmTensor;
    var p: *f64 = _bj_rel_f64p(&t);
    var ex: f64 = e.x / BJ_SPEED_OF_LIGHT;
    var ey: f64 = e.y / BJ_SPEED_OF_LIGHT;
    var ez: f64 = e.z / BJ_SPEED_OF_LIGHT;
    var bx: f64 = b.x;
    var by: f64 = b.y;
    var bz: f64 = b.z;
    p[0] = 0.0;
    p[1] = -ex;
    p[2] = -ey;
    p[3] = -ez;
    p[4] = ex;
    p[5] = 0.0;
    p[6] = -bz;
    p[7] = by;
    p[8] = ey;
    p[9] = bz;
    p[10] = 0.0;
    p[11] = -bx;
    p[12] = ez;
    p[13] = -by;
    p[14] = bx;
    p[15] = 0.0;
    return t;
}

# A tensor of sixteen components from p, row-major (for `EmTensor { components }`, whose field is public in Rust).
#must_use
public fn BjEmTensor_from_components(p: *f64): BjEmTensor {
    var t: BjEmTensor;
    var q: *f64 = _bj_rel_f64p(&t);
    for (var k = 0; k < 16; k = k + 1) { q[k] = p[k]; }
    return t;
}

impl BjEmTensor {
    # E = c·(F^{10}, F^{20}, F^{30}). Mirrors `EmTensor::electric_field`.
    #must_use
    public fn electric_field(self): BjFieldVector {
        var p: *f64 = _bj_rel_f64p(self);
        var x: f64 = p[4] * BJ_SPEED_OF_LIGHT;
        var y: f64 = p[8] * BJ_SPEED_OF_LIGHT;
        var z: f64 = p[12] * BJ_SPEED_OF_LIGHT;
        var e: BjFieldVector = BjFieldVector_new(x, y, z);
        return e;
    }

    # B = (F^{32}, F^{13}, F^{21}). Mirrors `EmTensor::magnetic_field`.
    #must_use
    public fn magnetic_field(self): BjFieldVector {
        var p: *f64 = _bj_rel_f64p(self);
        var x: f64 = p[14];
        var y: f64 = p[7];
        var z: f64 = p[9];
        var b: BjFieldVector = BjFieldVector_new(x, y, z);
        return b;
    }

    # F_μν F^μν = 2(B² − E²/c²), the first Lorentz invariant. Mirrors `EmTensor::first_invariant`.
    #must_use
    public fn first_invariant(self): f64 {
        var e: BjFieldVector = self.electric_field();
        var b: BjFieldVector = self.magnetic_field();
        var b2: f64 = b.magnitude_sq();
        var e2: f64 = e.magnitude_sq();
        var ec: f64 = e2 / BJ_SPEED_OF_LIGHT_SQ;
        var d: f64 = b2 - ec;
        var i: f64 = 2.0 * d;
        var ad: f64 = f64_abs(d);
        if (ad >= _BJ_VX_LO && ad <= _BJ_VX_HI) { return i; }
        var u: f64 = _bj_rel_inv1_edge(_bj_rel_f64p(self), i);
        return u;
    }

    # ε_μνρσ F^μν F^ρσ/8 = −E⋅B/c, the second invariant (ε^{0123} = +1, Jackson's): 0 for radiation fields. Mirrors
    # `EmTensor::second_invariant`.
    #must_use
    public fn second_invariant(self): f64 {
        var e: BjFieldVector = self.electric_field();
        var b: BjFieldVector = self.magnetic_field();
        var d: f64 = e.dot(b);
        var nd: f64 = -d;
        var i: f64 = nd / BJ_SPEED_OF_LIGHT;
        var ad: f64 = f64_abs(d);
        var f: *f64 = _bj_rel_f64p(self);
        if (ad > _BJ_VX_MN && ad <= _BJ_VX_HI && _bj_rel_e_exact(f) == 1) { return i; }
        var u: f64 = _bj_rel_inv2_edge(f, i);
        return u;
    }

    # The dual *F^μν, E → cB and B → −E/c, rounded once (ADR 0002 row 13): its components (cB)/c = B and
    # −(cF^{i0})/c = −F^{i0} are F's own, exactly, where Rust's ×c then ÷c rounded twice and overflowed past DBL_MAX/c;
    # a non-finite component keeps Rust's chain. Mirrors `EmTensor::dual`.
    #must_use
    public fn dual(self): BjEmTensor {
        var f: *f64 = _bj_rel_f64p(self);
        var bx: f64 = f[14];                        # B = (F^{32}, F^{13}, F^{21}); E/c = (F^{10}, F^{20}, F^{30})
        var by: f64 = f[7];
        var bz: f64 = f[9];
        var ex: f64 = f[4];
        var ey: f64 = f[8];
        var ez: f64 = f[12];
        var all = _bj_is_finite(bx) + _bj_is_finite(by) + _bj_is_finite(bz) + _bj_is_finite(ex) + _bj_is_finite(ey)
        + _bj_is_finite(ez);
        if (all == 6) {                             # every component F's own: no arithmetic
            var t: BjEmTensor;
            var q: *f64 = _bj_rel_f64p(&t);
            var nbx: f64 = -bx;
            var nby: f64 = -by;
            var nbz: f64 = -bz;
            var nex: f64 = -ex;
            var ney: f64 = -ey;
            var nez: f64 = -ez;
            q[0] = 0.0;
            q[1] = nbx;
            q[2] = nby;
            q[3] = nbz;
            q[4] = bx;
            q[5] = 0.0;
            q[6] = ez;
            q[7] = ney;
            q[8] = by;
            q[9] = nez;
            q[10] = 0.0;
            q[11] = ex;
            q[12] = bz;
            q[13] = ey;
            q[14] = nex;
            q[15] = 0.0;
            return t;
        }
        var e: BjFieldVector = self.electric_field();
        var b: BjFieldVector = self.magnetic_field();
        var e_dual: BjFieldVector = b.scale(BJ_SPEED_OF_LIGHT);
        var inv: f64 = 1.0 / BJ_SPEED_OF_LIGHT;
        var ninv: f64 = -inv;
        var b_dual: BjFieldVector = e.scale(ninv);
        var d: BjEmTensor = BjEmTensor_from_fields(e_dual, b_dual);
        var g: *f64 = _bj_rel_f64p(&d);
        _bj_rel_dual_put(g, 1, bx, 0 - 1);
        _bj_rel_dual_put(g, 2, by, 0 - 1);
        _bj_rel_dual_put(g, 3, bz, 0 - 1);
        _bj_rel_dual_put(g, 4, bx, 1);
        _bj_rel_dual_put(g, 8, by, 1);
        _bj_rel_dual_put(g, 12, bz, 1);
        _bj_rel_dual_put(g, 6, ez, 1);
        _bj_rel_dual_put(g, 7, ey, 0 - 1);
        _bj_rel_dual_put(g, 9, ez, 0 - 1);
        _bj_rel_dual_put(g, 11, ex, 1);
        _bj_rel_dual_put(g, 13, ey, 1);
        _bj_rel_dual_put(g, 14, ex, 0 - 1);
        return d;
    }

    # K^μ = q F^μν g_νλ u^λ = (γq E⋅v/c, γq(E + v × B)) (N), the Lorentz four-force on a charge with four-velocity
    # u = γ(c, v): q (F^{μ0}u⁰ − F^{μ1}u¹ − F^{μ2}u² − F^{μ3}u³). Mirrors `EmTensor::four_force`.
    #must_use
    public fn four_force(self, charge: f64, four_velocity: BjFourVector): BjFourVector {
        var p: *f64 = _bj_rel_f64p(self);
        var u0: f64 = four_velocity.t;
        var u1: f64 = -four_velocity.x;
        var u2: f64 = -four_velocity.y;
        var u3: f64 = -four_velocity.z;
        var k: f64[4];
        var ul: f64[4];
        ul[0] = u0;
        ul[1] = u1;
        ul[2] = u2;
        ul[3] = u3;
        for (var i = 0; i < 4; i = i + 1) {
            var r0: f64 = p[4 * i];
            var r1: f64 = p[4 * i + 1];
            var r2: f64 = p[4 * i + 2];
            var r3: f64 = p[4 * i + 3];
            var s: f64 = r0 * u0 + r1 * u1 + r2 * u2 + r3 * u3;
            k[i] = charge * s;
            var as2: f64 = f64_abs(s);
            if (!(as2 >= _BJ_VX_LO && as2 <= _BJ_VX_HI)) { k[i] = _bj_rel_ff_edge(p + 4 * i, &ul, charge, s); }
        }
        var f: BjFourVector = BjFourVector_new(k[0], k[1], k[2], k[3]);
        return f;
    }

    # 1 when every component equals o's (IEEE: −0 equals +0, NaN equals nothing). Mirrors the derived `PartialEq`.
    #must_use
    public fn eq(self, o: BjEmTensor): i64 {
        var p: *f64 = _bj_rel_f64p(self);
        var q: *f64 = _bj_rel_f64p(&o);
        for (var k = 0; k < 16; k = k + 1) {
            var a: f64 = p[k];
            var b: f64 = q[k];
            if (!(a == b)) { return 0; }
        }
        return 1;
    }
}

# ── the Lorentz transformation of fields ─────────────────────────────────────────────────────────────────────────

# (E', B') in a frame moving with velocity v, into e_out and b_out, in Jackson's normalization-free form (eq. 11.149):
# E' = γ(E + v × B) − γ²/(γ + 1)·(v⋅E)v/c² and B' = γ(B − v × E/c²) − γ²/(γ + 1)·(v⋅B)v/c², exact for any small v ≠ 0.
# γ is correctly rounded from the exact c² − |v|² (ADR 0002 row 30). InvalidParameter "boost velocity must be less than
# c" unless |v| < c exactly (a NaN part refused); the outs untouched. Mirrors `relativity::lorentz_transform_fields`.
public fn bj_lorentz_transform_fields(e: BjFieldVector, b: BjFieldVector, velocity: BjFieldVector,
  e_out: *BjFieldVector, b_out: *BjFieldVector): Result {
    var vp: f64[3];
    _bj_rel_parts(velocity, &vp);
    var g: f64[1];
    if (_bj_cr_lorentz(&vp, 0, 3, BJ_SPEED_OF_LIGHT, 0, 0, &g) == 0) {
        return Err(_bj_err_invalid_parameter("boost velocity must be less than c"));
    }
    var gamma: f64 = g[0];
    var g1: f64 = gamma + 1.0;
    var den: f64 = g1 * BJ_SPEED_OF_LIGHT_SQ;
    var gg: f64 = gamma * gamma;
    var k: f64 = gg / den;
    var vxb: BjFieldVector = velocity.cross(b);
    var s1: BjFieldVector = BjFieldVector_add(e, vxb);
    var s1g: BjFieldVector = BjFieldVector_mul(s1, gamma);
    var vde: f64 = velocity.dot(e);
    var ke: f64 = k * vde;
    var t1: BjFieldVector = velocity.scale(ke);
    var ep: BjFieldVector = BjFieldVector_sub(s1g, t1);
    var vxe: BjFieldVector = velocity.cross(e);
    var inv: f64 = 1.0 / BJ_SPEED_OF_LIGHT_SQ;
    var vxes: BjFieldVector = vxe.scale(inv);
    var s2: BjFieldVector = BjFieldVector_sub(b, vxes);
    var s2g: BjFieldVector = BjFieldVector_mul(s2, gamma);
    var vdb: f64 = velocity.dot(b);
    var kb: f64 = k * vdb;
    var t2: BjFieldVector = velocity.scale(kb);
    var bp: BjFieldVector = BjFieldVector_sub(s2g, t2);
    var outside = 1;
    if (gamma < 134217728.0) { outside = 1 - _bj_rel_box_tf(&e, &b, &velocity); }
    if (outside == 1) {
        var pe: *f64 = _bj_rel_f64p(&e);
        var pb: *f64 = _bj_rel_f64p(&b);
        var pv: *f64 = _bj_rel_f64p(&velocity);
        if (_bj_rel_finite_n(pe, 3) + _bj_rel_finite_n(pb, 3) + _bj_rel_finite_n(pv, 3) == 3) {
            _bj_rel_ltf_edge(pe, pb, pv, gamma, _bj_rel_f64p(e_out), _bj_rel_f64p(b_out));
            return Ok(0);
        }
    }
    e_out.x = ep.x;
    e_out.y = ep.y;
    e_out.z = ep.z;
    b_out.x = bp.x;
    b_out.y = bp.y;
    b_out.z = bp.z;
    return Ok(0);
}

# (E', B') for a boost of speed v along x, into e_out and b_out: E'_x = E_x, E'_y = γ(E_y − vB_z), E'_z = γ(E_z + vB_y);
# B'_x = B_x, B'_y = γ(B_y + vE_z/c²), B'_z = γ(B_z − vE_y/c²). bj_lorentz_factor's error, the outs untouched. Mirrors
# `relativity::lorentz_transform_x`.
public fn bj_lorentz_transform_x(e: BjFieldVector, b: BjFieldVector, speed: f64, e_out: *BjFieldVector,
  b_out: *BjFieldVector): Result {
    var tg, vg = bj_lorentz_factor(speed);
    if (is_err_result(tg) == 1) { return Err(vg); }
    var gamma: f64 = vg;
    var ex: f64 = e.x;
    var ey: f64 = e.y;
    var ez: f64 = e.z;
    var bx: f64 = b.x;
    var by: f64 = b.y;
    var bz: f64 = b.z;
    var sbz: f64 = speed * bz;
    var sby: f64 = speed * by;
    var d1: f64 = ey - sbz;
    var d2: f64 = ez + sby;
    var sez: f64 = speed * ez;
    var sey: f64 = speed * ey;
    var q1: f64 = sez / BJ_SPEED_OF_LIGHT_SQ;
    var q2: f64 = sey / BJ_SPEED_OF_LIGHT_SQ;
    var d3: f64 = by + q1;
    var d4: f64 = bz - q2;
    var e1: f64 = gamma * d1;
    var e2: f64 = gamma * d2;
    var b1: f64 = gamma * d3;
    var b2: f64 = gamma * d4;
    var asp: f64 = f64_abs(speed);
    if (!(asp >= _BJ_REL_BOX_LO || speed == 0.0) || _bj_rel_box_tx(&e, &b) == 0) {
        var pe: *f64 = _bj_rel_f64p(&e);
        var pb: *f64 = _bj_rel_f64p(&b);
        if (_bj_rel_finite_n(pe, 3) + _bj_rel_finite_n(pb, 3) == 2) {
            _bj_rel_ltx_edge(pe, pb, speed, gamma, _bj_rel_f64p(e_out), _bj_rel_f64p(b_out));
            return Ok(0);
        }
    }
    e_out.x = ex;
    e_out.y = e1;
    e_out.z = e2;
    b_out.x = bx;
    b_out.y = b1;
    b_out.z = b2;
    return Ok(0);
}

# ── four-vectors ─────────────────────────────────────────────────────────────────────────────────────────────────

# (ct, x, y, z). Mirrors `FourVector::new`.
#must_use
#pure
public fn BjFourVector_new(ct: f64, x: f64, y: f64, z: f64): BjFourVector {
    var v: BjFourVector;
    v.t = ct;
    v.x = x;
    v.y = y;
    v.z = z;
    return v;
}

# The four-position (c·time, pos[0], pos[1], pos[2]). Mirrors `FourVector::from_time_position`.
#must_use
public fn BjFourVector_from_time_position(time: f64, pos: *f64): BjFourVector {
    var ct: f64 = BJ_SPEED_OF_LIGHT * time;
    var v: BjFourVector = BjFourVector_new(ct, pos[0], pos[1], pos[2]);
    return v;
}

impl BjFourVector {
    # η_μν A^μ B^ν = −A⁰B⁰ + A¹B¹ + A²B² + A³B³. Mirrors `FourVector::dot`.
    #must_use
    public fn dot(self, other: BjFourVector): f64 {
        var t: f64 = self.t;
        var nt: f64 = -t;
        var x: f64 = self.x;
        var y: f64 = self.y;
        var z: f64 = self.z;
        var d: f64 = nt * other.t + x * other.x + y * other.y + z * other.z;
        var ad: f64 = f64_abs(d);
        if (ad >= _BJ_VX_LO && ad <= _BJ_VX_HI) { return d; }
        var u: f64 = _bj_rel_dot4_edge(_bj_rel_f64p(self), _bj_rel_f64p(&other), d);
        return u;
    }

    # s² = −(ct)² + x² + y² + z². Mirrors `FourVector::interval_sq`.
    #must_use
    public fn interval_sq(self): f64 {
        var t: f64 = self.t;
        var nt: f64 = -t;
        var x: f64 = self.x;
        var y: f64 = self.y;
        var z: f64 = self.z;
        var s: f64 = nt * t + x * x + y * y + z * z;
        var as2: f64 = f64_abs(s);
        if (as2 >= _BJ_VX_LO && as2 <= _BJ_VX_HI) { return s; }
        var sp: *f64 = _bj_rel_f64p(self);
        var u: f64 = _bj_rel_dot4_edge(sp, sp, s);
        return u;
    }

    # √(x² + y² + z²). Mirrors `FourVector::spatial_magnitude`.
    #must_use
    public fn spatial_magnitude(self): f64 {
        var x: f64 = self.x;
        var y: f64 = self.y;
        var z: f64 = self.z;
        var s: f64 = x * x + y * y + z * z;
        if ((s >= _BJ_VX_LO && s <= _BJ_VX_HI) || _bj_vx_sumsq_plain(x, y, z, s) == 1) {
            var m: f64 = f64_sqrt(s);
            return m;
        }
        var us, ue = _bj_vx_sumsq(x, y, z);         # BjFieldVector.magnitude's edge
        var u: f64 = _bj_k_ux_sqrt_f64(us, ue);
        return u;
    }

    # The boost of speed v along x, into out: ct' = γ(ct − βx), x' = γ(x − β·ct). bj_lorentz_factor's error, out
    # untouched. Mirrors `FourVector::boost_x`.
    public fn boost_x(self, speed: f64, out: *BjFourVector): Result {
        var tg, vg = bj_lorentz_factor(speed);
        if (is_err_result(tg) == 1) { return Err(vg); }
        var gamma: f64 = vg;
        var b: f64 = speed / BJ_SPEED_OF_LIGHT;
        var t: f64 = self.t;
        var x: f64 = self.x;
        var bx: f64 = b * x;
        var bt: f64 = b * t;
        var d1: f64 = t - bx;
        var d2: f64 = x - bt;
        var t2: f64 = gamma * d1;
        var x2: f64 = gamma * d2;
        var ab: f64 = f64_abs(b);
        var a1: f64 = f64_abs(d1);
        var a2: f64 = f64_abs(d2);
        if (!(ab > _BJ_VX_MN && a1 >= _BJ_VX_LO && a1 <= _BJ_VX_HI && a2 >= _BJ_VX_LO && a2 <= _BJ_VX_HI)) {
            t2 = _bj_rel_boost_edge(gamma, speed, t, x, d1);
            x2 = _bj_rel_boost_edge(gamma, speed, x, t, d2);
        }
        out.t = t2;
        out.x = x2;
        out.y = self.y;
        out.z = self.z;
        return Ok(0);
    }

    # 1 when every component equals o's (IEEE). Mirrors the derived `PartialEq`.
    #must_use
    public fn eq(self, o: BjFourVector): i64 {
        var t: f64 = self.t;
        var x: f64 = self.x;
        var y: f64 = self.y;
        var z: f64 = self.z;
        if (t == o.t && x == o.x && y == o.y && z == o.z) { return 1; }
        return 0;
    }
}

# ── retarded and Liénard–Wiechert potentials ─────────────────────────────────────────────────────────────────────

# φ = q/(4πε₀R_eff) (V), R_eff the Liénard–Wiechert effective distance |R| − R⋅β at the retarded time (for a charge at
# rest |R|, and this is Coulomb's potential), correctly rounded (ADR 0002 row 13; a non-finite q or R_eff keeps Rust's
# q/(4π·ε₀·R_eff)). The radial distance's errors (InvalidParameter when negative or NaN, Singularity below 1e-30).
# Mirrors `relativity::retarded_scalar_potential`.
public fn bj_retarded_scalar_potential(charge: f64, retarded_distance: f64): Result {
    var tc, vc = _bj_check_radial_distance(retarded_distance);
    if (is_err_result(tc) == 1) { return Err(vc); }
    var fp: f64 = 4.0 * _BJ_PI;
    if (_bj_is_finite(charge) == 0 || _bj_is_finite(retarded_distance) == 0) {
        var d: f64 = fp * BJ_EPSILON_0 * retarded_distance;
        var phi: f64 = charge / d;
        return Ok(phi);
    }
    var cr: f64 = _bj_k_cr_div3(charge, fp, BJ_EPSILON_0, retarded_distance);
    return Ok(cr);
}

# A = μ₀qv/(4πR_eff) (T⋅m) into out, v and R_eff at the retarded time, each part correctly rounded (ADR 0002 row 13; a
# non-finite q or R_eff keeps Rust's v·(μ₀q/(4πR_eff)), and a non-finite part its own). As
# bj_retarded_scalar_potential, out untouched on an error. Mirrors `relativity::retarded_vector_potential`.
public fn bj_retarded_vector_potential(charge: f64, velocity: BjFieldVector, retarded_distance: f64,
  out: *BjFieldVector): Result {
    var tc, vc = _bj_check_radial_distance(retarded_distance);
    if (is_err_result(tc) == 1) { return Err(vc); }
    var num: f64 = BJ_MU_0 * charge;
    var fp: f64 = 4.0 * _BJ_PI;
    var den: f64 = fp * retarded_distance;
    var k: f64 = num / den;
    var a: BjFieldVector = velocity.scale(k);
    if (_bj_is_finite(charge) == 1 && _bj_is_finite(retarded_distance) == 1) {
        var vp: f64[3];
        _bj_rel_parts(velocity, &vp);
        var ap: f64[3];
        for (var i = 0; i < 3; i = i + 1) {
            var vi: f64 = vp[i];
            var ai: f64 = vi * k;
            if (_bj_is_finite(vi) == 1) { ai = _bj_k_cr_mul3_div2(BJ_MU_0, charge, vi, fp, retarded_distance); }
            ap[i] = ai;
        }
        a = BjFieldVector_new(ap[0], ap[1], ap[2]);
    }
    out.x = a.x;
    out.y = a.y;
    out.z = a.z;
    return Ok(0);
}

# R_eff = |R| − R⋅β (> 0 for |β| < 1): InvalidParameter "R vector must not contain NaN", Singularity for
# |R| < 10^-30 exactly (row 17's rule), InvalidParameter "β must be < 1" unless |β| < 1 exactly (a NaN part refused;
# ADR 0002 row 30). For a finite R, R_eff is rounded once from the exact S and P (src/crmath_edge.cyr; ADR 0002 row
# 17, M2 part 2c-4), where Rust's difference cancelled as n̂⋅β → 1; an ∞ part keeps Rust's |R| − R⋅β.
fn _bj_rel_effective_distance(r_vec: BjFieldVector, beta_vec: BjFieldVector): Result {
    var r_mag: f64 = r_vec.magnitude();
    if (r_mag != r_mag) { return Err(_bj_err_invalid_parameter("R vector must not contain NaN")); }
    if (_bj_vx_finite4(r_vec.x, r_vec.y, r_vec.z, 0.0) == 0) {
        return Err(_bj_err_invalid_parameter("R vector must be finite"));
    }
    if (r_mag < 0.0000000000000000000000000000005) { return Err(_bj_err_singularity()); }
    if (r_mag <= 0.000000000000000000000000000002 && _bj_rel_r_below(r_vec, r_mag) == 1) {
        return Err(_bj_err_singularity());
    }
    var bp: f64[3];
    _bj_rel_parts(beta_vec, &bp);
    if (_bj_cr_lorentz_ok(&bp, 3, 1.0) == 0) { return Err(_bj_err_invalid_parameter("β must be < 1")); }
    var rp: f64[3];
    _bj_rel_parts(r_vec, &rp);
    var o: f64[1];
    var z = _bj_cr_lw(&rp, &bp, 0, 0, 0, &o);
    var re: f64 = o[0];
    return Ok(re);
}

# R_eff = |R| − R⋅β to 53 bits with an unbounded exponent (src/crmath_edge.cyr's _bj_cr_lw, mode 3), for a finite R the
# effective-distance checks passed: (s, e). The potentials' range edge, an R_eff past DBL_MAX (M2 part 2d-3e).
#must_use
fn _bj_rel_reff_ux(r_vec: BjFieldVector, beta_vec: BjFieldVector): (f64, i64) {
    var rp: f64[3];
    var bp: f64[3];
    _bj_rel_parts(r_vec, &rp);
    _bj_rel_parts(beta_vec, &bp);
    var o: f64[2];
    var z = _bj_cr_lw(&rp, &bp, 0, 3, 0, &o);
    var y: f64 = o[0];
    var kf: f64 = o[1];
    var ys, ye = _bj_k_ux_from(y);
    return (ys, ye + f64_to(kf));
}

# φ = q/(4πε₀(|R| − R⋅β)) (V), the Liénard–Wiechert scalar potential (Griffiths 10.46, Jackson 14.8): R = r − r'(t_r)
# from the retarded position to the field point, β = v(t_r)/c. Singularity for R = 0; InvalidParameter for |β| ≥ 1 or
# a NaN input, and for an R with an infinite part ("R vector must be finite": ADR 0002 row 27, amended in M2 part 2d-3e
# on the user's answer of 2026-11-13; Rust went on to NaN). An R_eff past DBL_MAX runs to 53 bits with an unbounded
# exponent and φ rounds once (row 18's rule). Mirrors `relativity::lienard_wiechert_scalar_potential`.
public fn bj_lienard_wiechert_scalar_potential(charge: f64, r_vec: BjFieldVector, beta_vec: BjFieldVector): Result {
    var t, v = _bj_rel_effective_distance(r_vec, beta_vec);
    if (is_err_result(t) == 1) { return Err(v); }
    var r_eff: f64 = v;
    var d: f64 = 4.0 * _BJ_PI * BJ_EPSILON_0 * r_eff;
    var phi: f64 = charge / d;
    if (r_eff <= _BJ_VX_HI || _bj_is_finite(charge) == 0) { return Ok(phi); }
    # R_eff past DBL_MAX (row 18's rule, M2 part 2d-3e): R_eff, 4πε₀R_eff to 53 bits, the quotient rounded once.
    var rs, re = _bj_rel_reff_ux(r_vec, beta_vec);
    var fpe: f64 = 4.0 * _BJ_PI * BJ_EPSILON_0;
    var fs, fe = _bj_k_ux_from(fpe);
    var ds, de = _bj_k_ux_mul(fs, fe, rs, re);
    var qs, qe = _bj_k_ux_from(charge);
    var u: f64 = _bj_k_ux_div_f64(qs, qe, ds, de);
    return Ok(u);
}

# A = μ₀qcβ/(4π(|R| − R⋅β)) = (β/c)φ (T⋅m) into out (Griffiths 10.47). As bj_lienard_wiechert_scalar_potential, out
# untouched on an error; where μ₀q, μ₀qc or their quotient by 4πR_eff leaves the normal range, or R_eff passes DBL_MAX,
# the chain runs with an unbounded exponent and each part rounds once (row 18's rule, M2 part 2d-3e). Mirrors
# `relativity::lienard_wiechert_vector_potential`.
public fn bj_lienard_wiechert_vector_potential(charge: f64, r_vec: BjFieldVector, beta_vec: BjFieldVector,
  out: *BjFieldVector): Result {
    var t, v = _bj_rel_effective_distance(r_vec, beta_vec);
    if (is_err_result(t) == 1) { return Err(v); }
    var r_eff: f64 = v;
    var mq: f64 = BJ_MU_0 * charge;
    var num: f64 = mq * BJ_SPEED_OF_LIGHT;
    var den: f64 = 4.0 * _BJ_PI * r_eff;
    var k: f64 = num / den;
    var amq: f64 = f64_abs(mq);
    var ank: f64 = f64_abs(num);
    var ak: f64 = f64_abs(k);
    var plain = 0;                                  # every product and quotient its 53-bit value, or an exact 0
    if (r_eff <= _BJ_VX_HI && (charge == 0.0 || (amq > _BJ_VX_MN && ank > _BJ_VX_MN && ank <= _BJ_VX_HI))) {
        if (charge == 0.0 || (ak > _BJ_VX_MN && ak <= _BJ_VX_HI)) { plain = 1; }
    }
    if (plain == 1 || _bj_is_finite(charge) == 0) {
        var a: BjFieldVector = beta_vec.scale(k);
        out.x = a.x;
        out.y = a.y;
        out.z = a.z;
        return Ok(0);
    }
    _bj_rel_avec_edge(charge, r_vec, beta_vec, r_eff, out);
    return Ok(0);
}

# A = β·μ₀qc/(4πR_eff) at a range edge into out (row 18's rule, M2 part 2d-3e): μ₀q, μ₀qc, R_eff (past DBL_MAX by
# _bj_rel_reff_ux), 4πR_eff and their quotient to 53 bits with an unbounded exponent, each part's product rounded once.
fn _bj_rel_avec_edge(charge: f64, r_vec: BjFieldVector, beta_vec: BjFieldVector, r_eff: f64, out: *BjFieldVector) {
    var c: f64 = BJ_SPEED_OF_LIGHT;
    var ms, me = _bj_vx_mul(BJ_MU_0, charge);
    var cs, ce = _bj_k_ux_from(c);
    var ns, ne = _bj_k_ux_mul(ms, me, cs, ce);
    var rs, re = _bj_k_ux_from(r_eff);
    if (r_eff > _BJ_VX_HI) {
        var us, ue = _bj_rel_reff_ux(r_vec, beta_vec);
        rs = us;
        re = ue;
    }
    var fp: f64 = 4.0 * _BJ_PI;
    var fs, fe = _bj_k_ux_from(fp);
    var ds, de = _bj_k_ux_mul(fs, fe, rs, re);
    var ks, ke = _bj_k_ux_div(ns, ne, ds, de);
    var bx, bxe = _bj_k_ux_from(beta_vec.x);
    var by, bye = _bj_k_ux_from(beta_vec.y);
    var bz, bze = _bj_k_ux_from(beta_vec.z);
    var ax: f64 = _bj_k_ux_mul_f64(bx, bxe, ks, ke);
    var ay: f64 = _bj_k_ux_mul_f64(by, bye, ks, ke);
    var az: f64 = _bj_k_ux_mul_f64(bz, bze, ks, ke);
    out.x = ax;
    out.y = ay;
    out.z = az;
    return 0;
}

# ── Liénard–Wiechert fields and the Larmor powers ────────────────────────────────────────────────────────────────

# E = (q/4πε₀)(n̂ − β)/(γ²κ³R²) + (q/4πε₀c) n̂ × [(n̂ − β) × β̇]/(κ³R) (V/m) into out, κ = 1 − n̂⋅β: the velocity
# (Coulomb, ∝ 1/R²) and acceleration (radiation, ∝ 1/R) fields; r_vec from the retarded position to the field point,
# β = v/c and β̇ = a/c at the retarded time. InvalidParameter for a NaN R ("R vector must not contain NaN", as the
# potentials: ADR 0002 row 27, where Rust went on to NaN) and for an infinite part ("R vector must be finite", row 27
# amended, M2 part 2d-3e), Singularity for |R| < 10^-30 exactly, InvalidParameter
# unless |β| < 1 exactly, DivisionByZero for κ < 10^-30 exactly; out untouched on an error. γ² = 1/(1 − |β|²) is
# correctly rounded from the exact difference (ADR 0002 row 30). For a finite R, κ = (|R| − R⋅β)/|R| is rounded once
# from the exact S and P, and its test decided on the exact κ (src/crmath_edge.cyr; ADR 0002 row 17, M2 part 2c-4):
# Rust's 1 − n̂⋅β cancelled as n̂⋅β → 1, and refused a κ of 6e-17 as zero. n̂ − β, which vanishes with κ, is rounded
# once part by part from the same exact parts (row 17, M2 part 2d-1, the user's answer of 2026-11-13). The tail
# (γ²κ³R², the two factors, the cross products) keeps Rust's chain inside a box on q, R, β̇, n̂ − β and γ², and
# otherwise runs with an unbounded exponent, |R| and 1/|R| included, each part's sum rounded once (row 18's rule, M2
# part 2d-3f). Mirrors `relativity::lienard_wiechert_e`.
public fn bj_lienard_wiechert_e(charge: f64, r_vec: BjFieldVector, beta_vec: BjFieldVector, beta_dot: BjFieldVector,
  out: *BjFieldVector): Result {
    return _bj_rel_e_impl(charge, r_vec, beta_vec, beta_dot, out, 0);
}

# bj_lienard_wiechert_e's body; *boxed (when boxed is not 0) := 1 when Rust's chain ran inside its box, so each part of
# E is ±0 exactly or normal and its double is its 53-bit value (lienard_wiechert_fields' B needs that, M2 part 2d-3j).
fn _bj_rel_e_impl(charge: f64, r_vec: BjFieldVector, beta_vec: BjFieldVector, beta_dot: BjFieldVector,
  out: *BjFieldVector, boxed): Result {
    var r_mag: f64 = r_vec.magnitude();
    if (r_mag != r_mag) { return Err(_bj_err_invalid_parameter("R vector must not contain NaN")); }
    if (_bj_vx_finite4(r_vec.x, r_vec.y, r_vec.z, 0.0) == 0) {
        return Err(_bj_err_invalid_parameter("R vector must be finite"));
    }
    if (r_mag < 0.0000000000000000000000000000005) { return Err(_bj_err_singularity()); }
    if (r_mag <= 0.000000000000000000000000000002 && _bj_rel_r_below(r_vec, r_mag) == 1) {
        return Err(_bj_err_singularity());
    }
    var bp: f64[3];
    _bj_rel_parts(beta_vec, &bp);
    var g2: f64[1];
    if (_bj_cr_lorentz(&bp, 0, 3, 1.0, 1, 0, &g2) == 0) { return Err(_bj_err_invalid_parameter("β must be < 1")); }
    var inv_r: f64 = 1.0 / r_mag;
    var n_hat: BjFieldVector = r_vec.scale(inv_r);
    var rp: f64[3];
    _bj_rel_parts(r_vec, &rp);
    var ko: f64[4];
    if (_bj_cr_lw(&rp, &bp, 0, 2, 0, &ko) == 1) {
        return Err(_bj_err_division_by_zero("Liénard-Wiechert denominator (1 − n̂⋅β) is zero"));
    }
    var kappa: f64 = ko[0];
    var n_minus_beta: BjFieldVector = BjFieldVector_new(ko[1], ko[2], ko[3]);
    var gamma_sq: f64 = g2[0];
    var kappa3: f64 = kappa * kappa * kappa;
    var four_pi_eps0: f64 = 4.0 * _BJ_PI * BJ_EPSILON_0;
    var pre: f64 = charge / four_pi_eps0;
    var dv: f64 = gamma_sq * kappa3 * r_mag * r_mag;
    var fv: f64 = pre / dv;
    var velocity_term: BjFieldVector = n_minus_beta.scale(fv);
    var inner: BjFieldVector = n_minus_beta.cross(beta_dot);
    var outer: BjFieldVector = n_hat.cross(inner);
    var da: f64 = kappa3 * r_mag * BJ_SPEED_OF_LIGHT;
    var fa: f64 = pre / da;
    var accel_term: BjFieldVector = outer.scale(fa);
    var e: BjFieldVector = BjFieldVector_add(velocity_term, accel_term);
    var aq: f64 = f64_abs(charge);
    if ((charge == 0.0 || (aq >= _BJ_REL_E_QLO && aq < _BJ_REL_E_QHI)) && gamma_sq < 1267650600228229401496703205376.0
      && _bj_rel_box_e(&r_vec, &beta_dot, &n_minus_beta) == 1) {
        out.x = e.x;
        out.y = e.y;
        out.z = e.z;
        if (boxed != 0) { store64(boxed, 1); }
        return Ok(0);
    }
    _bj_rel_e_slow(charge, r_vec, kappa, gamma_sq, n_minus_beta, beta_dot, e, out);
    return Ok(0);
}

# lienard_wiechert_e outside its box: _bj_rel_e_tail on R's and β̇'s pairs for a finite charge and β̇, else Rust's
# chain e (a non-finite operand keeps it).
fn _bj_rel_e_slow(charge: f64, r_vec: BjFieldVector, kappa: f64, gamma_sq: f64, nmb: BjFieldVector,
  beta_dot: BjFieldVector, e: BjFieldVector, out: *BjFieldVector) {
    if (_bj_vx_finite4(charge, beta_dot.x, beta_dot.y, beta_dot.z) == 1) {
        var rp: *f64 = _bj_rel_f64p(&r_vec);
        var dp: *f64 = _bj_rel_f64p(&beta_dot);
        var rs: f64[3];
        var re: i64[3];
        var ds: f64[3];
        var de: i64[3];
        for (var i = 0; i < 3; i = i + 1) {
            var xs, xe = _bj_k_ux_from(rp[i]);
            rs[i] = xs;
            re[i] = xe;
            var ys, ye = _bj_k_ux_from(dp[i]);
            ds[i] = ys;
            de[i] = ye;
        }
        var o: f64[15];
        _bj_rel_e_tail(charge, &rs, &re, kappa, gamma_sq, _bj_rel_f64p(&nmb), &ds, &de, &o);
        out.x = o[0];
        out.y = o[1];
        out.z = o[2];
        return 0;
    }
    out.x = e.x;
    out.y = e.y;
    out.z = e.z;
    return 0;
}

# B = n̂ × E/c (T), perpendicular to n̂ and E. A component keeps Rust's chain where its cross component is normal or
# ±0: that double is then its 53-bit value, and B's product rounds once (ADR 0002 row 18's rule, M2 part 2d-3h). A
# cross component past DBL_MAX or subnormal, for finite n̂ and E, runs to 53 bits with an unbounded exponent and B's
# product rounds once; Rust gave ∞ for a cross past DBL_MAX, where B is representable. A non-finite part keeps Rust's
# chain. Mirrors `relativity::lienard_wiechert_b`.
#must_use
public fn bj_lienard_wiechert_b(n_hat: BjFieldVector, e_field: BjFieldVector): BjFieldVector {
    var c: BjFieldVector = n_hat.cross(e_field);
    var inv: f64 = 1.0 / BJ_SPEED_OF_LIGHT;
    var b: BjFieldVector = c.scale(inv);
    # Each cross component ±0 or normal: |bits| 0, or in [2^-1022, ∞) below ∞ (integer compares on the bit patterns).
    var m = 0x7FFFFFFFFFFFFFFF;
    var u = load64(&c) & m;
    var bad = 0;
    if (u != 0 && (u < 0x0010000000000000 || u >= 0x7FF0000000000000)) { bad = 1; }
    u = load64(&c + 8) & m;
    if (u != 0 && (u < 0x0010000000000000 || u >= 0x7FF0000000000000)) { bad = 1; }
    u = load64(&c + 16) & m;
    if (u != 0 && (u < 0x0010000000000000 || u >= 0x7FF0000000000000)) { bad = 1; }
    if (bad == 1) { _bj_rel_b_edge(&n_hat, &e_field, &c, inv, &b); }
    return b;
}

# lienard_wiechert_b off its common case (M2 part 2d-3h), into out (Rust's B on entry): for finite n̂ and E (at the
# byte addresses n and e, the cross at c), each component whose cross is past DBL_MAX or subnormal takes
# n̂ⱼEₖ − n̂ₖEⱼ to 53 bits with an unbounded exponent (_bj_vx_cross1) times 1/c, rounded once.
fn _bj_rel_b_edge(n, e, c, inv: f64, out) {
    var np: *f64 = _bj_rel_f64p(n);
    var ep: *f64 = _bj_rel_f64p(e);
    var cp: *f64 = _bj_rel_f64p(c);
    var op: *f64 = _bj_rel_f64p(out);
    if (_bj_rel_finite_n(np, 3) == 0 || _bj_rel_finite_n(ep, 3) == 0) { return 0; }
    var is, ie = _bj_k_ux_from(inv);
    for (var i = 0; i < 3; i = i + 1) {
        var x: f64 = cp[i];
        var ax: f64 = f64_abs(x);
        if (x == 0.0 || (ax >= _BJ_VX_MN && ax <= _BJ_VX_HI)) { continue; }
        var j = (i + 1) % 3;
        var k = (i + 2) % 3;
        var ps, pe = _bj_vx_cross1(np[j], ep[k], np[k], ep[j]);
        var bi: f64 = _bj_k_ux_mul_f64(ps, pe, is, ie);
        op[i] = bi;
    }
    return 0;
}

# P = q²a²/(6πε₀c³) (W), Larmor's formula (non-relativistic), correctly rounded (ADR 0002 row 13: c³ of c's double, π
# Rust's; six factors below, src/crmath_mono.cyr's _bj_cr_mono_wide; a non-finite q or a keeps Rust's chain on
# c·c² and 6π rounded). Mirrors `relativity::larmor_power`.
#must_use
#pure
public fn bj_larmor_power(charge: f64, acceleration: f64): f64 {
    if (_bj_is_finite(charge) == 0 || _bj_is_finite(acceleration) == 0) {
        var c3: f64 = BJ_SPEED_OF_LIGHT * BJ_SPEED_OF_LIGHT_SQ;
        var num0: f64 = charge * charge * acceleration * acceleration;
        var den0: f64 = 6.0 * _BJ_PI * BJ_EPSILON_0 * c3;
        var p: f64 = num0 / den0;
        return p;
    }
    var num: f64[4];
    var den: f64[6];
    num[0] = charge;
    num[1] = charge;
    num[2] = acceleration;
    num[3] = acceleration;
    den[0] = 6.0;
    den[1] = _BJ_PI;
    den[2] = BJ_EPSILON_0;
    den[3] = BJ_SPEED_OF_LIGHT;
    den[4] = BJ_SPEED_OF_LIGHT;
    den[5] = BJ_SPEED_OF_LIGHT;
    var cr: f64 = _bj_cr_mono_wide(&num, 4, &den, 6);
    return cr;
}

# P = q²γ⁶/(6πε₀c³)·[a² − |v × a|²/c²] (W), Liénard's relativistic Larmor formula, γ correctly rounded from the exact
# c² − |v|² (ADR 0002 row 30). InvalidParameter "velocity must be less than c" unless |v| < c exactly. Mirrors
# `relativity::relativistic_larmor_power`.
public fn bj_relativistic_larmor_power(charge: f64, velocity: BjFieldVector, acceleration: BjFieldVector): Result {
    var vp: f64[3];
    _bj_rel_parts(velocity, &vp);
    var gg: f64[1];
    if (_bj_cr_lorentz(&vp, 0, 3, BJ_SPEED_OF_LIGHT, 0, 0, &gg) == 0) {
        return Err(_bj_err_invalid_parameter("velocity must be less than c"));
    }
    var gamma: f64 = gg[0];
    var g2: f64 = gamma * gamma;
    var g6: f64 = g2 * g2 * g2;
    var a_sq: f64 = acceleration.magnitude_sq();
    var vxa: BjFieldVector = velocity.cross(acceleration);
    var vxa_sq: f64 = vxa.magnitude_sq();
    var c3: f64 = BJ_SPEED_OF_LIGHT * BJ_SPEED_OF_LIGHT_SQ;
    var qq: f64 = charge * charge;
    var den: f64 = 6.0 * _BJ_PI * BJ_EPSILON_0 * c3;
    var pre: f64 = qq / den;
    var vc: f64 = vxa_sq / BJ_SPEED_OF_LIGHT_SQ;
    var d: f64 = a_sq - vc;
    var pg: f64 = pre * g6;
    var p: f64 = pg * d;
    var aq: f64 = f64_abs(charge);
    if ((charge == 0.0 || (aq >= _BJ_REL_LAR_QLO && aq < _BJ_REL_LAR_QHI)) && gamma < 134217728.0
      && _bj_rel_box_lar(&velocity, &acceleration) == 1) {
        return Ok(p);
    }
    var pv: *f64 = _bj_rel_f64p(&velocity);
    var pa: *f64 = _bj_rel_f64p(&acceleration);
    var dq: f64 = charge - charge;
    if (dq != 0.0 || _bj_rel_finite_n(pa, 3) == 0) { return Ok(p); }
    var u: f64 = _bj_rel_larmor_edge(charge, pv, pa, gamma, den);
    return Ok(u);
}

# ── the retarded-time solver ─────────────────────────────────────────────────────────────────────────────────────
# A trajectory is a closure (or `&fn`) called through callptr as `trajectory_fn(t, out)`, t an f64 in a word (rebind it
# inside as `var tt: f64 = t;`, probe p18): it writes the charge's position, then its velocity (six f64) at out, and for
# bj_lienard_wiechert_fields its acceleration after them (nine). Its return value is ignored: Rust's trajectory can't
# fail. The motion must be subluminal.

# One light-cone sample g(τ) = |r_obs − r(t − τ)| − cτ into s: τ, g, dg/dτ = R̂⋅v − c (−c at R = 0), the rounding
# scale of g, 2ε·max(|R|, cτ, ‖r_obs‖∞, ‖r(t_r)‖∞, ‖v‖∞|t_r|), and g's 53-bit pair (s[4], s[5]; s[5] NaN when g is its
# own). The light-travel term is c·(t − t_r) with the rounded t_r. The maxima are f64::max's folds: every operand is
# finite or +∞ and none is −0 or NaN, so compares give the same value in any order. The trajectory's state is left in
# st. 0, or the InvalidParameter of a non-finite state.
fn _bj_rel_sample(obs: *f64, t: f64, tau: f64, traj, st: *f64, s: *f64): i64 {
    var t_r: f64 = t - tau;
    callptr(traj, t_r, st);
    var z: f64 = (st[0] - st[0]) + (st[1] - st[1]) + (st[2] - st[2]);   # x − x: +0 when x is finite, else NaN
    z = z + (st[3] - st[3]) + (st[4] - st[4]) + (st[5] - st[5]);
    if (z != 0.0) { return _bj_rel_state_error(t_r); }
    var dx: f64 = obs[0] - st[0];
    var dy: f64 = obs[1] - st[1];
    var dz: f64 = obs[2] - st[2];
    var d2: f64 = dx * dx + dy * dy + dz * dz;
    var dist: f64 = f64_sqrt(d2);
    var dt: f64 = t - t_r;
    var light: f64 = BJ_SPEED_OF_LIGHT * dt;
    # The common case of _bj_rel_sample_edge's test: d2 in [2^-900, DBL_MAX] (then the noise's maximum is at least
    # |R| ≥ 2^-450), c·(t − t_r) 0 (then t − t_r is 0) or normal, |R⋅v| in the band and ‖v‖∞·|t_r| finite.
    var ok = 1;
    if (!(d2 >= _BJ_VX_LO && d2 <= _BJ_VX_HI)) { ok = 0; }
    if (light != 0.0 && !(light > _BJ_VX_MN && light <= _BJ_VX_HI)) { ok = 0; }
    var dg: f64 = -BJ_SPEED_OF_LIGHT;
    if (dist > 0.0) {
        var rv: f64 = dx * st[3] + dy * st[4] + dz * st[5];
        var q: f64 = rv / dist;
        dg = q - BJ_SPEED_OF_LIGHT;
        q = f64_abs(rv);
        if (!(q >= _BJ_VX_LO && q <= _BJ_VX_HI)) { ok = 0; }
    }
    var m: f64 = f64_abs(obs[0]);                   # max(‖r_obs‖∞, ‖r(t_r)‖∞)
    var w: f64 = f64_abs(obs[1]);
    if (w > m) { m = w; }
    w = f64_abs(obs[2]);
    if (w > m) { m = w; }
    w = f64_abs(st[0]);
    if (w > m) { m = w; }
    w = f64_abs(st[1]);
    if (w > m) { m = w; }
    w = f64_abs(st[2]);
    if (w > m) { m = w; }
    var mv: f64 = f64_abs(st[3]);                   # ‖v‖∞
    w = f64_abs(st[4]);
    if (w > mv) { mv = w; }
    w = f64_abs(st[5]);
    if (w > mv) { mv = w; }
    w = f64_abs(t_r);
    w = mv * w;
    if (!(w <= _BJ_VX_HI)) { ok = 0; }
    if (w > m) { m = w; }
    if (dist > m) { m = dist; }
    if (light > m) { m = light; }
    s[0] = tau;
    s[1] = dist - light;
    s[2] = dg;
    s[3] = 0.000000000000000444089209850062616169452667236328125 * m;   # 2ε = 2^-51
    s[4] = 0.0;
    s[5] = _BJ_REL_NAN;                             # g is its own 53-bit value
    if (ok == 0) { _bj_rel_sample_edge(obs, t, st, s); }
    return 0;
}

# The InvalidParameter of a non-finite trajectory state: "trajectory returned a non-finite state at t = ..".
fn _bj_rel_state_error(t_r: f64): i64 {
    var e = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(e, "trajectory returned a non-finite state at t = ");
    _bj_fmt_f64_display(e, t_r);
    return BJ_ERR_INVALID_PARAMETER;
}

# A quiet NaN, the marker of a sample whose g is its own 53-bit value.
var _BJ_REL_NAN: f64 = 0x7FF8000000000000;

# DBL_MAX/2 (the largest double below 2^1023): 2g is finite and exact up to it.
var _BJ_REL_HALF_MAX: f64 = 0x7FDFFFFFFFFFFFFF;

# The light-cone sample off its common case (M2 part 2d-3g): s holds Rust's sample at τ = s[0], kept where Rust's chain
# is the unbounded one (ADR 0002 row 18's rule), else replaced by _bj_rel_sample_ux's. The chain is the unbounded one
# when dx, dy and dz are finite (a difference of finite doubles is otherwise exact); dx² + dy² + dz² is in the band
# [2^-900, DBL_MAX] or every d is 0, so |R| is its 53-bit value; c·(t − t_r) is normal or 0; R⋅v is in the band, or 0
# from exact products (or |R| = 0, where dg is −c), so R̂⋅v − c absorbs a degraded part; ‖v‖·|t_r| is finite and the
# noise's maximum at least 2^-900 (or all 0).
fn _bj_rel_sample_edge(obs: *f64, t: f64, st: *f64, s: *f64) {
    var tau: f64 = s[0];
    var t_r: f64 = t - tau;
    var dx: f64 = obs[0] - st[0];
    var dy: f64 = obs[1] - st[1];
    var dz: f64 = obs[2] - st[2];
    var d2: f64 = dx * dx + dy * dy + dz * dz;
    var dt: f64 = t - t_r;
    var light: f64 = BJ_SPEED_OF_LIGHT * dt;
    var at: f64 = f64_abs(t_r);
    var mv: f64 = _bj_rel_max_abs3(st, 3);
    var mvt: f64 = mv * at;
    var plain = 1;
    var dd: f64 = (dx - dx) + (dy - dy) + (dz - dz);
    if (dd != 0.0) { plain = 0; }
    if (!(d2 >= _BJ_VX_LO && d2 <= _BJ_VX_HI) && !(dx == 0.0 && dy == 0.0 && dz == 0.0)) { plain = 0; }
    if (!(light <= _BJ_VX_HI && (light > _BJ_VX_MN || dt == 0.0))) { plain = 0; }
    if (plain == 1 && d2 > 0.0) {
        var p0: f64 = dx * st[3];
        var p1: f64 = dy * st[4];
        var p2: f64 = dz * st[5];
        var rv: f64 = p0 + p1 + p2;
        var arv: f64 = f64_abs(rv);
        if (!(arv >= _BJ_VX_LO && arv <= _BJ_VX_HI)) {
            if (rv != 0.0) { plain = 0; }
            var ex = _bj_vx_exact(dx, st[3], p0) + _bj_vx_exact(dy, st[4], p1) + _bj_vx_exact(dz, st[5], p2);
            if (ex != 3) { plain = 0; }
        }
    }
    if (!(mvt <= _BJ_VX_HI)) { plain = 0; }
    if (plain == 1) {
        var dist: f64 = f64_sqrt(d2);
        var m_obs: f64 = _bj_rel_max_abs3(obs, 0);
        var m_pos: f64 = _bj_rel_max_abs3(st, 0);
        var m: f64 = _bj_max(dist, light);
        m = _bj_max(m, m_obs);
        m = _bj_max(m, m_pos);
        m = _bj_max(m, mvt);
        if (m >= _BJ_VX_LO) { return 0; }
        if (m == 0.0 && (at == 0.0 || mv == 0.0)) { return 0; }
    }
    _bj_rel_sample_ux(obs, t, tau, st, s);
    return 0;
}

# The light-cone sample with an unbounded exponent into s (row 18's rule, M2 part 2d-3g): R = r_obs − r(t_r) part by
# part, |R|, c·(t − t_r), g = |R| − c(t − t_r) (s[1] rounded once, s[4] and s[5] its 53-bit pair), R⋅v, dg = R̂⋅v − c
# rounded once (−c at R = 0), and the noise 2ε·max(|R|, c(t − t_r), ‖r_obs‖∞, ‖r(t_r)‖∞, ‖v‖∞|t_r|) rounded once. The
# trajectory's state is st's (finite).
fn _bj_rel_sample_ux(obs: *f64, t: f64, tau: f64, st: *f64, s: *f64) {
    var t_r: f64 = t - tau;
    var dt: f64 = t - t_r;
    var c: f64 = BJ_SPEED_OF_LIGHT;
    var ds: f64[3];
    var de: i64[3];
    for (var i = 0; i < 3; i = i + 1) {
        var os, oe = _bj_k_ux_from(obs[i]);
        var ps, pe = _bj_k_ux_from(st[i]);
        var xs, xe = _bj_k_ux_sub(os, oe, ps, pe);
        ds[i] = xs;
        de[i] = xe;
    }
    var q0s, q0e = _bj_k_ux_mul(ds[0], de[0], ds[0], de[0]);
    var q1s, q1e = _bj_k_ux_mul(ds[1], de[1], ds[1], de[1]);
    var q2s, q2e = _bj_k_ux_mul(ds[2], de[2], ds[2], de[2]);
    var s1s, s1e = _bj_k_ux_add(q0s, q0e, q1s, q1e);
    var s2s, s2e = _bj_k_ux_add(s1s, s1e, q2s, q2e);
    var ms, me = _bj_k_ux_sqrt(s2s, s2e);
    var cs, ce = _bj_k_ux_from(c);
    var ts, te = _bj_k_ux_from(dt);
    var ls, le = _bj_k_ux_mul(cs, ce, ts, te);
    var gs, ge = _bj_k_ux_sub(ms, me, ls, le);
    var g: f64 = _bj_k_ux_sub_f64(ms, me, ls, le);
    var dg: f64 = -c;
    if (ms != 0.0) {
        var v0s, v0e = _bj_k_ux_from(st[3]);
        var v1s, v1e = _bj_k_ux_from(st[4]);
        var v2s, v2e = _bj_k_ux_from(st[5]);
        var r0s, r0e = _bj_k_ux_mul(ds[0], de[0], v0s, v0e);
        var r1s, r1e = _bj_k_ux_mul(ds[1], de[1], v1s, v1e);
        var r2s, r2e = _bj_k_ux_mul(ds[2], de[2], v2s, v2e);
        var u1s, u1e = _bj_k_ux_add(r0s, r0e, r1s, r1e);
        var u2s, u2e = _bj_k_ux_add(u1s, u1e, r2s, r2e);
        var qs, qe = _bj_k_ux_div(u2s, u2e, ms, me);
        dg = _bj_k_ux_sub_f64(qs, qe, cs, ce);
    }
    var mxs, mxe = _bj_k_ux_max(ms, me, ls, le);
    var mo: f64 = _bj_rel_max_abs3(obs, 0);
    var mp: f64 = _bj_rel_max_abs3(st, 0);
    var mv: f64 = _bj_rel_max_abs3(st, 3);
    var at: f64 = f64_abs(t_r);
    var mos, moe = _bj_k_ux_from(mo);
    var mps, mpe = _bj_k_ux_from(mp);
    var mvs, mve = _bj_k_ux_from(mv);
    var ats, ate = _bj_k_ux_from(at);
    var mts, mte = _bj_k_ux_mul(mvs, mve, ats, ate);
    var a1s, a1e = _bj_k_ux_max(mxs, mxe, mos, moe);
    var a2s, a2e = _bj_k_ux_max(a1s, a1e, mps, mpe);
    var a3s, a3e = _bj_k_ux_max(a2s, a2e, mts, mte);
    var noise: f64 = _bj_k_ux_mul_f64(1.0, 0 - 51, a3s, a3e);
    s[0] = tau;
    s[1] = g;
    s[2] = dg;
    s[3] = noise;
    s[4] = gs;
    s[5] = f64_from(ge);
    return 0;
}

# The 53-bit pair of a sample's g: its own where the sample computed one, else g's (exact then).
#must_use
fn _bj_rel_gp(s: *f64): (f64, i64) {
    var e5: f64 = s[5];
    if (e5 != e5) {
        var gs, ge = _bj_k_ux_from(s[1]);
        return (gs, ge);
    }
    var s4: f64 = s[4];
    return (s4, f64_to(e5));
}

# The sign of a sample's g (−1, 0 or 1), from its pair: an unbounded g below 2^-1074 still has its sign.
#must_use
fn _bj_rel_gsign(s: *f64): i64 {
    var e5: f64 = s[5];
    var x: f64 = s[1];
    if (e5 == e5) { x = s[4]; }
    if (x > 0.0) { return 1; }
    if (x < 0.0) { return 0 - 1; }
    return 0;
}

# 1 when |g_a| < |g_b| exactly for two samples (the solver calls it only where one g is not normal).
#must_use
fn _bj_rel_gabs_lt(a: *f64, b: *f64): i64 {
    var xs, xe = _bj_rel_gp(a);
    var ys, ye = _bj_rel_gp(b);
    var ax: f64 = f64_abs(xs);
    var ay: f64 = f64_abs(ys);
    if (_bj_k_ux_cmp(ax, xe, ay, ye) == 0 - 1) { return 1; }
    return 0;
}

# The solver's step tests on g's 53-bit pair for a sample (exact for every sample), as fl's flags: 1 when g = 0 (then
# alone), else 2 when |g| ≤ the noise and 4 when |2g| ≤ |last_step·dg|; for dg < 0 the Newton point τ − g/dg into
# out[0] and |g/dg| into out[1] (g/dg to 53 bits with an unbounded exponent, each rounded once).
fn _bj_rel_step_ux(s: *f64, last_step: f64, out: *f64): i64 {
    var gs, ge = _bj_rel_gp(s);
    if (gs == 0.0) { return 1; }
    var fl = 0;
    var ag: f64 = f64_abs(gs);
    var ns, ne = _bj_k_ux_from(s[3]);
    if (_bj_k_ux_cmp(ag, ge, ns, ne) <= 0) { fl = 2; }
    var cd: f64 = s[2];
    var ds, de = _bj_k_ux_from(cd);
    var ls1, le1 = _bj_k_ux_from(last_step);
    var ps, pe = _bj_k_ux_mul(ls1, le1, ds, de);
    var ap: f64 = f64_abs(ps);
    if (_bj_k_ux_cmp(ag, ge + 1, ap, pe) <= 0) { fl = fl + 4; }
    if (cd < 0.0) {
        var qs, qe = _bj_k_ux_div(gs, ge, ds, de);
        var ts, te = _bj_k_ux_from(s[0]);
        var nu: f64 = _bj_k_ux_sub_f64(ts, te, qs, qe);
        var aq: f64 = f64_abs(qs);
        var st: f64 = _bj_k_ux_mul_f64(aq, qe, 1.0, 0);
        out[0] = nu;
        out[1] = st;
    }
    return fl;
}

# max(|p[k]|, |p[k + 1]|, |p[k + 2]|), Rust's f64::max fold.
fn _bj_rel_max_abs3(p: *f64, k): f64 {
    var a: f64 = f64_abs(p[k]);
    var b: f64 = f64_abs(p[k + 1]);
    var c: f64 = f64_abs(p[k + 2]);
    var ab: f64 = _bj_max(a, b);
    var m: f64 = _bj_max(ab, c);
    return m;
}

# dst := src, a light-cone sample (six f64: τ, g, dg, noise and g's 53-bit pair, M2 part 2d-3g).
fn _bj_rel_copy6(dst: *f64, src: *f64) {
    dst[0] = src[0];
    dst[1] = src[1];
    dst[2] = src[2];
    dst[3] = src[3];
    dst[4] = src[4];
    dst[5] = src[5];
    return 0;
}

# The InvalidParameter of an observer that is not finite: "observer position and time must be finite, got [..] at
# t = ..".
fn _bj_rel_observer_error(obs: *f64, t: f64): i64 {
    var e = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(e, "observer position and time must be finite, got ");
    _bj_fmt_f64x3_debug(e, obs);
    _bj_tx_cstr(e, " at t = ");
    _bj_fmt_f64_display(e, t);
    return BJ_ERR_INVALID_PARAMETER;
}

# Logs one of the solver's debug events, a message and its fields: t_r and τ (`what` 1: converged, with the
# iteration and expansion counts), t_r alone (2: the observer on the trajectory), or the budget and the bracket (3).
fn _bj_rel_solve_log(what, a: f64, b: f64, n1, n2) {
    if (_bj_log_on(4) == 0) { return 0; }
    var lb[256];
    var lt[24];
    _bj_tx_init(&lt, &lb, 256);
    if (what == 1) {
        _bj_tx_cstr(&lt, "retarded time converged t_r=");
        _bj_fmt_f64_debug(&lt, a);
        _bj_tx_cstr(&lt, " tau=");
        _bj_fmt_f64_debug(&lt, b);
        _bj_tx_cstr(&lt, " iterations=");
        _bj_tx_u64(&lt, n1);
        _bj_tx_cstr(&lt, " expansions=");
        _bj_tx_u64(&lt, n2);
    } elif (what == 2) {
        _bj_tx_cstr(&lt, "retarded time: observer on the trajectory t_r=");
        _bj_fmt_f64_debug(&lt, a);
    } else {
        _bj_tx_cstr(&lt, "retarded time solver did not converge max_iterations=");
        _bj_tx_u64(&lt, n1);
        _bj_tx_cstr(&lt, " lo=");
        _bj_fmt_f64_debug(&lt, a);
        _bj_tx_cstr(&lt, " hi=");
        _bj_fmt_f64_debug(&lt, b);
    }
    _bj_log_text(4, &lt);
    return 0;
}

# The solver over traj into *out, the trajectory's state left in st (nine f64): the body of bj_solve_retarded_time.
fn _bj_rel_solve(obs: *f64, t: f64, traj, max_iterations, st: *f64, out: *f64): Result {
    if (!(_bj_is_finite(t) == 1 && _bj_is_finite(obs[0]) == 1 && _bj_is_finite(obs[1]) == 1
        && _bj_is_finite(obs[2]) == 1)) {
        return Err(_bj_rel_observer_error(obs, t));
    }
    if (_bj_log_on(4) == 1) {
        var lb[256];
        var lt[24];
        _bj_tx_init(&lt, &lb, 256);
        _bj_tx_cstr(&lt, "solving retarded time observer_pos=");
        _bj_fmt_f64x3_debug(&lt, obs);
        _bj_tx_cstr(&lt, " observation_time=");
        _bj_fmt_f64_debug(&lt, t);
        _bj_tx_cstr(&lt, " max_iterations=");
        _bj_tx_u64(&lt, max_iterations);
        _bj_log_text(4, &lt);
    }
    var lo: f64[6];
    var hi: f64[6];
    var cur: f64[6];
    var c0 = _bj_rel_sample(obs, t, 0.0, traj, st, &lo);
    if (c0 != 0) { return Err(c0); }
    # g's sign, |g| and the Newton point come from Rust's doubles where g is normal (so its double is its 53-bit
    # value) and from g's 53-bit pair otherwise (ADR 0002 row 18's rule, M2 part 2d-3g): the pair helpers run only
    # off the normal case.
    var g0: f64 = lo[1];
    if (g0 == 0.0) {
        if (_bj_rel_gsign(&lo) == 0) {
            _bj_rel_solve_log(2, t, 0.0, 0, 0);
            out[0] = t;
            return Ok(0);
        }
    }
    var tau0: f64 = g0 / BJ_SPEED_OF_LIGHT;
    var ag0: f64 = f64_abs(g0);
    if (!(ag0 > _BJ_VX_MN && ag0 <= _BJ_VX_HI)) {  # g past DBL_MAX or subnormal: τ₀ from its 53-bit pair
        var g0s, g0e = _bj_rel_gp(&lo);
        var cs, ce = _bj_k_ux_from(BJ_SPEED_OF_LIGHT);
        tau0 = _bj_k_ux_div_f64(g0s, g0e, cs, ce);
    }
    var min_pos: f64 = _bj_from_bits(0x0010000000000000);
    var tau1: f64 = _bj_max(tau0, min_pos);
    var c1 = _bj_rel_sample(obs, t, tau1, traj, st, &hi);
    if (c1 != 0) { return Err(c1); }
    var expansions = 0;
    while (1 == 1) {
        var hg: f64 = hi[1];
        if (!(hg > 0.0)) {
            if (hg != 0.0 || _bj_rel_gsign(&hi) <= 0) { break; }
        }
        var ht: f64 = hi[0];
        var next_tau: f64 = 2.0 * ht;
        if (expansions >= 2100 || _bj_is_finite(next_tau) == 0) {
            var be = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(be, "retarded time solver could not bracket the light-cone root ");
            _bj_tx_cstr(be, "(is the trajectory faster than light?)");
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        _bj_rel_copy6(&lo, &hi);
        var c2 = _bj_rel_sample(obs, t, next_tau, traj, st, &hi);
        if (c2 != 0) {
            # A non-finite state while the bracket still expands: the doubling drove the trajectory past the range,
            # so no bracket was found (ADR 0002 row 31, the user's answer of 2026-11-13; Rust reported the state).
            var bf = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(bf, "retarded time solver could not bracket the light-cone root ");
            _bj_tx_cstr(bf, "(is the trajectory faster than light?)");
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        expansions = expansions + 1;
    }
    var alo: f64 = f64_abs(lo[1]);
    var ahi: f64 = f64_abs(hi[1]);
    var lo_cur = 0;
    if (alo > _BJ_VX_MN && alo <= _BJ_VX_HI && ahi > _BJ_VX_MN && ahi <= _BJ_VX_HI) {
        if (alo < ahi) { lo_cur = 1; }
    } else {
        lo_cur = _bj_rel_gabs_lt(&lo, &hi);
    }
    if (lo_cur == 1) { _bj_rel_copy6(&cur, &lo); } else { _bj_rel_copy6(&cur, &hi); }
    var last_step: f64 = hi[0] - lo[0];
    var iterations = 0;
    var tau: f64 = 0.0;
    var nw: f64[2];
    var at: f64 = f64_abs(t);
    while (1 == 1) {
        var ct: f64 = cur[0];
        var cg: f64 = cur[1];
        var cd: f64 = cur[2];
        var gd: f64 = cg / cd;
        var newton: f64 = ct - gd;
        var step_n: f64 = f64_abs(gd);
        # Rust's doubles where g is normal with 2g finite and g/dg normal: g's double is its 53-bit value, g/dg's
        # rounding is the chain's, and |2g| ≤ |last_step·dg| is decided alike for a product that underflows (both
        # false, |2g| > 2^-1021) or overflows (both true). g's 53-bit pair otherwise. fl: 1 g = 0, 2 |g| ≤ noise,
        # 4 |2g| ≤ |last_step·dg|.
        var fl = 0;
        var acg: f64 = f64_abs(cg);
        if (acg > _BJ_VX_MN && acg <= _BJ_REL_HALF_MAX && step_n > _BJ_VX_MN && step_n <= _BJ_VX_HI) {
            var cn: f64 = cur[3];
            if (acg <= cn) { fl = 2; }
            var g2: f64 = 2.0 * acg;
            var ls: f64 = last_step * cd;
            var als: f64 = f64_abs(ls);
            if (g2 <= als) { fl = fl + 4; }
        } else {
            fl = _bj_rel_step_ux(&cur, last_step, &nw);
            newton = nw[0];
            step_n = nw[1];
        }
        if (fl == 1) {
            tau = ct;
            break;
        }
        if ((fl & 2) != 0) {
            tau = ct;
            if (cd < 0.0) {
                var pl: f64 = _bj_max(newton, lo[0]);
                tau = _bj_min(pl, hi[0]);
            }
            break;
        }
        if (iterations == max_iterations) {
            _bj_rel_solve_log(3, lo[0], hi[0], max_iterations, 0);
            var ne = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(ne, "retarded time solver did not converge in ");
            _bj_tx_u64(ne, max_iterations);
            _bj_tx_cstr(ne, " iterations");
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        iterations = iterations + 1;
        var next: f64 = 0.0;
        var step: f64 = 0.0;
        if (cd < 0.0 && newton >= lo[0] && newton <= hi[0] && (fl & 4) != 0) {
            next = newton;
            step = step_n;
        } else {
            var w: f64 = hi[0] - lo[0];
            var half: f64 = 0.5 * w;
            next = lo[0] + half;
            step = half;
        }
        var mt: f64 = next;                         # f64::max(|t|, next): neither is NaN
        if (at > mt) { mt = at; }
        var tol: f64 = 0.00000000000000088817841970012523233890533447265625 * mt;   # 4ε = 2^-50
        if (step <= tol || next == ct) {
            tau = next;
            break;
        }
        last_step = step;
        var c3 = _bj_rel_sample(obs, t, next, traj, st, &cur);
        if (c3 != 0) { return Err(c3); }
        var ng: f64 = cur[1];
        var up = 0;
        if (ng > 0.0) {
            up = 1;
        } elif (ng == 0.0) {
            if (_bj_rel_gsign(&cur) > 0) { up = 1; }
        }
        if (up == 1) { _bj_rel_copy6(&lo, &cur); } else { _bj_rel_copy6(&hi, &cur); }
    }
    var t_r: f64 = t - tau;
    _bj_rel_solve_log(1, t_r, tau, iterations, expansions);
    out[0] = t_r;
    return Ok(0);
}

# The retarded time t_r ≤ t with |r_obs − r(t_r)| = c(t − t_r), unique for a subluminal charge. On the delay τ = t − t_r
# with g(τ) = |r_obs − r(t − τ)| − cτ (g(0) ≥ 0, g′ < 0): from the static estimate τ₀ = |r_obs − r(t)|/c a bracket
# g(lo) > 0 ≥ g(hi) by doubling, then Newton steps safeguarded by bisection, until the step is at most 4ε·max(|t|, τ)
# or |g| reaches its own rounding level (then one last Newton correction). `observer_pos` is three f64, the trajectory
# a callback (above) writing position and velocity, `max_iterations` Rust's usize (−1 is usize::MAX) counting the
# refinement steps (the bracket's doublings are not counted). InvalidParameter when the observer or the time is not
# finite, the trajectory returns a non-finite state, no bracket exists (a superluminal trajectory: a non-finite state
# met while the bracket expands reports this error, ADR 0002 row 31, the user's answer of 2026-11-13), or the
# refinement has not converged in max_iterations steps. Mirrors `relativity::solve_retarded_time`.
public fn bj_solve_retarded_time(observer_pos: *f64, observation_time: f64, trajectory_fn, max_iterations): Result {
    var st: f64[9];
    var r: f64[1];
    var t, v = _bj_rel_solve(observer_pos, observation_time, trajectory_fn, max_iterations, &st, &r);
    if (is_err_result(t) == 1) { return Err(v); }
    var t_r: f64 = r[0];
    return Ok(t_r);
}

# (E, B) (V/m, T) at the observer, into e_out and b_out: bj_solve_retarded_time with a budget of 200 refinement steps,
# then bj_lienard_wiechert_e and bj_lienard_wiechert_b at the retarded position, β = v/c and β̇ = a/c. The trajectory
# writes position, velocity and acceleration (nine f64). The solver's errors; InvalidParameter for a non-finite
# acceleration; Singularity when the observer sits on the retarded position; bj_lienard_wiechert_e's errors; the outs
# untouched on an error. Rust's chain is kept where its own values make it the unbounded one (_bj_rel_fields_plain,
# and E's parts normal or exact zeros); otherwise R, β, β̇, E, n̂ and B run to 53 bits with an unbounded exponent and
# each output rounds once (ADR 0002 row 18's rule, M2 part 2d-3j): an R past DBL_MAX (Rust: ∞, then NaN fields), a
# 1/|R| or n̂ below 2^-1022, a β or β̇ below 2^-1022, or an E that B would see degraded. A non-finite charge keeps
# Rust's chain (NaN fields where R passes DBL_MAX). Mirrors `relativity::lienard_wiechert_fields`.
public fn bj_lienard_wiechert_fields(charge: f64, observer_pos: *f64, observation_time: f64, trajectory_fn,
  e_out: *BjFieldVector, b_out: *BjFieldVector): Result {
    if (_bj_log_on(5) == 1) {
        var lb[256];
        var lt[24];
        _bj_tx_init(&lt, &lb, 256);
        _bj_tx_cstr(&lt, "Liénard-Wiechert fields charge=");
        _bj_fmt_f64_debug(&lt, charge);
        _bj_tx_cstr(&lt, " observer_pos=");
        _bj_fmt_f64x3_debug(&lt, observer_pos);
        _bj_tx_cstr(&lt, " observation_time=");
        _bj_fmt_f64_debug(&lt, observation_time);
        _bj_log_text(5, &lt);
    }
    var st: f64[9];
    var r: f64[1];
    var ts, vs = _bj_rel_solve(observer_pos, observation_time, trajectory_fn, 200, &st, &r);
    if (is_err_result(ts) == 1) { return Err(vs); }
    var t_r: f64 = r[0];
    callptr(trajectory_fn, t_r, &st);
    for (var k = 6; k < 9; k = k + 1) {
        var a: f64 = st[k];
        if (_bj_is_finite(a) == 0) {
            var e = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(e, "trajectory returned a non-finite acceleration at t = ");
            _bj_fmt_f64_display(e, t_r);
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
    }
    var rx: f64 = observer_pos[0] - st[0];
    var ry: f64 = observer_pos[1] - st[1];
    var rz: f64 = observer_pos[2] - st[2];
    var r_vec: BjFieldVector = BjFieldVector_new(rx, ry, rz);
    var r_mag: f64 = r_vec.magnitude();
    var band = _bj_x_band(r_mag, _BJ_FIELD_R2_MIN);       # the exact |observer − position| (ADR 0002 row 17's rule)
    if (band == 2) { band = _bj_x_r2_below(observer_pos, &st, 60); }
    if (band == 1) { return Err(_bj_err_singularity()); }
    var inv: f64 = 1.0 / r_mag;
    var n_hat: BjFieldVector = r_vec.scale(inv);
    var bx: f64 = st[3] / BJ_SPEED_OF_LIGHT;
    var by: f64 = st[4] / BJ_SPEED_OF_LIGHT;
    var bz: f64 = st[5] / BJ_SPEED_OF_LIGHT;
    var dx: f64 = st[6] / BJ_SPEED_OF_LIGHT;
    var dy: f64 = st[7] / BJ_SPEED_OF_LIGHT;
    var dz: f64 = st[8] / BJ_SPEED_OF_LIGHT;
    var beta_vec: BjFieldVector = BjFieldVector_new(bx, by, bz);
    var beta_dot: BjFieldVector = BjFieldVector_new(dx, dy, dz);
    var dq: f64 = charge - charge;
    if (dq != 0.0) {
        if (_bj_vx_finite4(rx, ry, rz, 0.0) == 0) {    # Rust's ∞ R makes n̂, κ and every part NaN
            var nan: f64 = _BJ_REL_NAN;
            e_out.x = nan;
            e_out.y = nan;
            e_out.z = nan;
            b_out.x = nan;
            b_out.y = nan;
            b_out.z = nan;
            return Ok(0);
        }
    } elif (_bj_rel_fields_plain(&r_vec, &n_hat, &beta_vec, &beta_dot, &st, r_mag) == 0) {
        var t1, v1 = _bj_rel_fields_edge(charge, observer_pos, &st, e_out, b_out);
        if (is_err_result(t1) == 1) { return Err(v1); }
        return Ok(0);
    }
    var e: BjFieldVector;
    var boxed: i64[1];
    boxed[0] = 0;
    var te, ve = _bj_rel_e_impl(charge, r_vec, beta_vec, beta_dot, &e, &boxed);
    if (is_err_result(te) == 1) { return Err(ve); }
    if (dq == 0.0 && _bj_rel_e_exact3(&e, boxed[0]) == 0) {
        var t2, v2 = _bj_rel_fields_edge(charge, observer_pos, &st, e_out, b_out);
        if (is_err_result(t2) == 1) { return Err(v2); }
        return Ok(0);
    }
    var b: BjFieldVector = bj_lienard_wiechert_b(n_hat, e);
    e_out.x = e.x;
    e_out.y = e.y;
    e_out.z = e.z;
    b_out.x = b.x;
    b_out.y = b.y;
    b_out.z = b.z;
    return Ok(0);
}

# 2^1022: an |R| above it makes 1/|R| subnormal.
var _BJ_REL_R_INV: f64 = 0x7FD0000000000000;

# 1 when lienard_wiechert_fields' chain up to E is the unbounded one (ADR 0002 row 18's rule, M2 part 2d-3j), given R,
# n̂ = R·(1/|R|), β = v/c and β̇ = a/c (at the byte addresses r, n, bv and bd), the trajectory's state st and |R|: R
# finite (a difference of finite doubles is otherwise its 53-bit value, a subnormal one exact), |R| ≤ 2^1022 (1/|R|
# normal), and each part of n̂, β and β̇ normal or an exact zero (of a zero part of R, v or a).
#must_use
fn _bj_rel_fields_plain(r, n, bv, bd, st: *f64, r_mag: f64): i64 {
    if (!(r_mag <= _BJ_REL_R_INV)) { return 0; }
    var rp: *f64 = _bj_rel_f64p(r);
    var np: *f64 = _bj_rel_f64p(n);
    var bp: *f64 = _bj_rel_f64p(bv);
    var dp: *f64 = _bj_rel_f64p(bd);
    for (var i = 0; i < 3; i = i + 1) {
        var x: f64 = rp[i];
        var ax: f64 = f64_abs(x);
        if (!(ax <= _BJ_VX_HI)) { return 0; }
        var an: f64 = f64_abs(np[i]);
        if (!(an >= _BJ_VX_MN) && x != 0.0) { return 0; }
        var ab: f64 = f64_abs(bp[i]);
        if (!(ab >= _BJ_VX_MN) && st[3 + i] != 0.0) { return 0; }
        var ad: f64 = f64_abs(dp[i]);
        if (!(ad >= _BJ_VX_MN) && st[6 + i] != 0.0) { return 0; }
    }
    return 1;
}

# 1 when each part of E (at the byte address e) is its 53-bit value, as B needs it: normal and finite, or 0 where Rust's
# chain ran inside E's box (its zeros exact there).
#must_use
fn _bj_rel_e_exact3(e, boxed): i64 {
    var ep: *f64 = _bj_rel_f64p(e);
    for (var i = 0; i < 3; i = i + 1) {
        var x: f64 = ep[i];
        var ax: f64 = f64_abs(x);
        if (x == 0.0) {
            if (boxed == 0) { return 0; }
        } elif (!(ax >= _BJ_VX_MN && ax <= _BJ_VX_HI)) {
            return 0;
        }
    }
    return 1;
}

# lienard_wiechert_fields off its common case (ADR 0002 row 18's rule, M2 part 2d-3j), for a finite charge, into e_out
# and b_out: R = r_obs − r(t_r), β = v/c and β̇ = a/c to 53 bits with an unbounded exponent (an R past DBL_MAX and a β
# below 2^-1022 in the exact kernels' offset forms, M2 part 2d-3i); E's checks on them (|β| < 1 and γ² by
# _bj_cr_lorentz, κ < 10^-30 and n̂ − β by _bj_cr_lw); E's tail on the pairs (_bj_rel_e_tail); B = n̂ × E/c from n̂'s
# and E's 53-bit values, each part rounded once. The Singularity test is the caller's (exact on r_obs and r(t_r)); the
# outs untouched on an error.
fn _bj_rel_fields_edge(charge: f64, obs: *f64, st: *f64, e_out: *BjFieldVector, b_out: *BjFieldVector): Result {
    var cs, ce = _bj_k_ux_from(BJ_SPEED_OF_LIGHT);
    var rs: f64[3];
    var re: i64[3];
    var rd: f64[3];
    var bv: f64[3];
    var ds: f64[3];
    var de: i64[3];
    var xo: i64[6];
    var bo: i64[3];
    for (var i = 0; i < 3; i = i + 1) {
        var os, oe = _bj_k_ux_from(obs[i]);
        var ps, pe = _bj_k_ux_from(st[i]);
        var xs, xe = _bj_k_ux_sub(os, oe, ps, pe);
        rs[i] = xs;
        re[i] = xe;
        var x: f64 = obs[i] - st[i];                # Rust's double: the pair's value unless it passed DBL_MAX
        var ax: f64 = f64_abs(x);
        rd[i] = x;
        xo[i] = 0;
        if (!(ax <= _BJ_VX_HI)) {
            rd[i] = xs;
            xo[i] = xe;
        }
        var vs, ve = _bj_k_ux_from(st[3 + i]);
        var qs, qe = _bj_k_ux_div(vs, ve, cs, ce);
        var bq: f64 = _bj_k_ux_mul_f64(qs, qe, 1.0, 0);
        bv[i] = bq;
        bo[i] = 0;
        if (qs != 0.0 && qe < 0 - 1022) {           # below 2^-1022: the offset form, its significand normal
            bv[i] = qs;
            bo[i] = qe;
        }
        xo[3 + i] = bo[i];
        var as, ae = _bj_k_ux_from(st[6 + i]);
        var us, ue = _bj_k_ux_div(as, ae, cs, ce);
        ds[i] = us;
        de[i] = ue;
    }
    var g2: f64[1];
    if (_bj_cr_lorentz(&bv, &bo, 3, 1.0, 1, 0, &g2) == 0) { return Err(_bj_err_invalid_parameter("β must be < 1")); }
    var ko: f64[4];
    if (_bj_cr_lw(&rd, &bv, &xo, 2, 0, &ko) == 1) {
        return Err(_bj_err_division_by_zero("Liénard-Wiechert denominator (1 − n̂⋅β) is zero"));
    }
    var nm: f64[3];
    nm[0] = ko[1];
    nm[1] = ko[2];
    nm[2] = ko[3];
    var o: f64[15];
    _bj_rel_e_tail(charge, &rs, &re, ko[0], g2[0], &nm, &ds, &de, &o);
    var es: f64[3];
    var ee: i64[3];
    var ns: f64[3];
    var ne: i64[3];
    for (var j = 0; j < 3; j = j + 1) {
        es[j] = o[3 + j];
        ee[j] = f64_to(o[6 + j]);
        ns[j] = o[9 + j];
        ne[j] = f64_to(o[12 + j]);
    }
    var inv: f64 = 1.0 / BJ_SPEED_OF_LIGHT;
    var is, ie = _bj_k_ux_from(inv);
    var bb: f64[3];
    for (var j2 = 0; j2 < 3; j2 = j2 + 1) {
        var cps, cpe = _bj_rel_cross_pp(&ns, &ne, &es, &ee, j2);
        var bj: f64 = _bj_k_ux_mul_f64(cps, cpe, is, ie);
        bb[j2] = bj;
    }
    e_out.x = o[0];
    e_out.y = o[1];
    e_out.z = o[2];
    b_out.x = bb[0];
    b_out.y = bb[1];
    b_out.z = bb[2];
    return Ok(0);
}

# --- polarization.cyr ---

# polarization.cyr — polarization.rs (M3 part 1a-1): Jones vectors and matrices for fully polarized coherent light,
# Stokes vectors and Mueller matrices for partially polarized and incoherent light. Angles are in radians, measured
# from +x (horizontal) toward +y.
#
# The time convention is bijli's one, e^{+jωt} with IEEE handedness (src/complex.cyr's header; ADR 0002 row 5, D3).
# Rust's polarization.rs used e^{−iωt} with Born & Wolf handedness; for one physical state or element:
# - a complex amplitude (a Jones vector's or matrix's entry, an inner product, a determinant) is the conjugate of
#   Rust's, and a phase its negative. So a retarder's slow axis, which lags the fast axis by δ, takes e^{−jδ/2} and
#   the fast axis e^{+jδ/2} (BjJonesMatrix_waveplate);
# - the circular states and polarizers are named by IEEE handedness: BjJonesVector_right_circular() = (1, −j)/√2,
#   whose field Re{J·e^{+jωt}} at z = 0 is x̂·cos ωt + ŷ·sin ωt, turning from x̂ toward ŷ: the right-hand rule about the
#   propagation direction +z. It is Rust's left_circular, Born & Wolf's "left" ([1, +i]/√2 in e^{−iωt}). Under these
#   names the circular states and polarizers carry Rust's numbers: the two changes cancel;
# - S₃ = 2 Im(E_x E_y*) keeps its meaning under the IEEE names, +1 for right-hand circular. For one physical state it
#   is the negative of Rust's S₃, and so is the ellipticity angle; a Mueller matrix's entries that couple S₃ to S₁ or
#   S₂ are the negatives of Rust's (D·M·D, D = diag(1, 1, 1, −1)), so the Mueller retarders change sign there.
# Intensities, overlaps, the degree of polarization, the orientation angle and the linear elements are unchanged.
# The parity harness maps each oracle row to the same physical state (tests/parity.tcyr's _par_polarization).
#
# Complex arithmetic is BjComplex's (src/complex.cyr): hisab's formulas, each rounded once at a range edge (ADR 0002
# row 14). The waveplates are cancellation-free (ADR 0002 row 33, M3 part 2a-1): the Jones form takes cos 2θ and
# sin 2θ correctly rounded where Rust had c² − s² and 2cs (c² − s² loses every digit near a fast axis at 45°), and the
# Mueller form takes 1 − cos δ as 2·sin²(δ/2) where cos δ > 1/2 (where 1 − cos δ cancels). Every other formula is
# Rust's in Rust's order. The JSON of the four structs is part 1a-2's.

private

# Intensities at or above this are computed without loss of precision to underflow; smaller (or non-finite) values
# take the rescaling path. Mirrors polarization.rs's SAFE_MIN_INTENSITY.
var _BJ_POL_SAFE_MIN: f64 = 0x03B8F2B061AEA072;     # 1e-290

# std::f64::consts::FRAC_1_SQRT_2 and FRAC_PI_2, by their bits.
var _BJ_POL_SQRT1_2: f64 = 0x3FE6A09E667F3BCD;
var _BJ_POL_PI_2: f64 = 0x3FF921FB54442D18;

# 2^1023: where 2θ passes DBL_MAX, and the divisor that scales such a θ into [1, 2) exactly.
var _BJ_POL_2P1023: f64 = 0x7FE0000000000000;

# cos 2θ and sin 2θ, each correctly rounded (ADR 0002 row 33): one sin_cos of the exact double 2θ, or, where 2θ passes
# DBL_MAX (|θ| ≥ 2^1023), the reduction of 2θ = (θ·2^-1023)·2^1024 past DBL_MAX (src/crmath_ux.cyr). NaN for a
# non-finite θ, as cos θ and sin θ are.
#must_use
fn _bj_pol_cos_sin_2t(t: f64): (f64, f64) {
    var a: f64 = f64_abs(t);
    if (_bj_is_finite(t) == 1 && a >= _BJ_POL_2P1023) {
        var ts: f64 = t / _BJ_POL_2P1023;
        var cb: f64 = _bj_ux_sin_cos(ts, 1024, 0);
        var sb: f64 = _bj_ux_sin_cos(ts, 1024, 1);
        return (cb, sb);
    }
    var t2: f64 = 2.0 * t;
    var s, c = _bj_sin_cos(t2);
    var cv: f64 = c;
    var sv: f64 = s;
    return (cv, sv);
}

# ── Jones vector ─────────────────────────────────────────────────────────────────────────────────────────────────

# A Jones vector: the complex amplitudes [E_x, E_y] of a fully polarized state. Mirrors `polarization::JonesVector`.
public struct BjJonesVector {
    x: BjComplex;
    y: BjComplex;
}

# A Jones vector from its components. Mirrors `JonesVector::new`.
#must_use
#pure
public fn BjJonesVector_new(x: BjComplex, y: BjComplex): BjJonesVector {
    var v: BjJonesVector;
    v.x = x;
    v.y = y;
    return v;
}

# (a, b) as a Jones vector of two real amplitudes.
#must_use
#pure
fn _bj_pol_jv_real(a: f64, b: f64): BjJonesVector {
    var v: BjJonesVector;
    v.x.re = a;
    v.x.im = 0.0;
    v.y.re = b;
    v.y.im = 0.0;
    return v;
}

# Horizontal linear polarization [1, 0]. Mirrors `JonesVector::horizontal`.
#must_use
#pure
public fn BjJonesVector_horizontal(): BjJonesVector {
    var v: BjJonesVector = _bj_pol_jv_real(1.0, 0.0);
    return v;
}

# The default Jones vector: horizontal. Mirrors `Default for JonesVector`.
#must_use
#pure
public fn BjJonesVector_default(): BjJonesVector {
    var v: BjJonesVector = _bj_pol_jv_real(1.0, 0.0);
    return v;
}

# Vertical linear polarization [0, 1]. Mirrors `JonesVector::vertical`.
#must_use
#pure
public fn BjJonesVector_vertical(): BjJonesVector {
    var v: BjJonesVector = _bj_pol_jv_real(0.0, 1.0);
    return v;
}

# Diagonal (+45°) linear polarization [1, 1]/√2. Mirrors `JonesVector::diagonal`.
#must_use
#pure
public fn BjJonesVector_diagonal(): BjJonesVector {
    var s: f64 = _BJ_POL_SQRT1_2;
    var v: BjJonesVector = _bj_pol_jv_real(s, s);
    return v;
}

# Anti-diagonal (−45°) linear polarization [1, −1]/√2. Mirrors `JonesVector::anti_diagonal`.
#must_use
#pure
public fn BjJonesVector_anti_diagonal(): BjJonesVector {
    var s: f64 = _BJ_POL_SQRT1_2;
    var ns: f64 = -s;
    var v: BjJonesVector = _bj_pol_jv_real(s, ns);
    return v;
}

# Right-hand circular polarization (IEEE) [1, −j]/√2: the field turns from x̂ toward ŷ (the module comment). Rust's
# `JonesVector::left_circular` is the same state in e^{−iωt} (ADR 0002 row 5).
#must_use
#pure
public fn BjJonesVector_right_circular(): BjJonesVector {
    var s: f64 = _BJ_POL_SQRT1_2;
    var ns: f64 = -s;
    var v: BjJonesVector = _bj_pol_jv_real(s, 0.0);
    v.y.im = ns;
    return v;
}

# Left-hand circular polarization (IEEE) [1, +j]/√2: the field turns from x̂ toward −ŷ. Rust's
# `JonesVector::right_circular` is the same state in e^{−iωt} (ADR 0002 row 5).
#must_use
#pure
public fn BjJonesVector_left_circular(): BjJonesVector {
    var s: f64 = _BJ_POL_SQRT1_2;
    var v: BjJonesVector = _bj_pol_jv_real(s, 0.0);
    v.y.im = s;
    return v;
}

# Linear polarization at angle θ from horizontal: [cos θ, sin θ]. Mirrors `JonesVector::linear`.
#must_use
public fn BjJonesVector_linear(angle: f64): BjJonesVector {
    var c: f64 = _bj_cos(angle);
    var s: f64 = _bj_sin(angle);
    var v: BjJonesVector = _bj_pol_jv_real(c, s);
    return v;
}

impl BjJonesVector {
    # The intensity |E_x|² + |E_y|². Mirrors `JonesVector::intensity`.
    #must_use
    public fn intensity(self): f64 {
        var a: f64 = self.x.norm_sq();
        var b: f64 = self.y.norm_sq();
        var i: f64 = a + b;
        return i;
    }

    # This vector scaled to unit intensity, into out: for any nonzero finite amplitude scale, a vector whose
    # intensity under- or overflows first rescaled by its largest part. DivisionByZero for the zero vector,
    # InvalidParameter for a non-finite part; out untouched on an error. Mirrors `JonesVector::normalized`.
    public fn normalized(self, out: *BjJonesVector): Result {
        var i: f64 = self.intensity();
        var v: BjJonesVector = *self;
        if (!(_bj_is_finite(i) == 1 && i >= _BJ_POL_SAFE_MIN)) {
            var t, e = _bj_pol_rescaled(self, &v);
            if (is_err_result(t) == 1) { return Err(e); }
        }
        var vi: f64 = v.intensity();
        var r: f64 = f64_sqrt(vi);
        var s: f64 = 1.0 / r;
        var nx: BjComplex = v.x.scale(s);
        var ny: BjComplex = v.y.scale(s);
        out.x = nx;
        out.y = ny;
        return Ok(0);
    }

    # The inner product ⟨J₁|J₂⟩ = x₁*·x₂ + y₁*·y₂, conjugate-linear in the first. Mirrors `JonesVector::inner`.
    #must_use
    public fn inner(self, other: BjJonesVector): BjComplex {
        var cx: BjComplex = self.x.conj();
        var cy: BjComplex = self.y.conj();
        var p: BjComplex = BjComplex_mul(cx, other.x);
        var q: BjComplex = BjComplex_mul(cy, other.y);
        var z: BjComplex = BjComplex_add(p, q);
        return z;
    }

    # The degree of overlap |⟨J₁|J₂⟩|²/(I₁·I₂): 0 for orthogonal states, 1 for parallel ones, whatever the two
    # amplitude scales (rescaled when the product of the intensities under- or overflows). DivisionByZero when either
    # vector is zero, InvalidParameter for a non-finite part. Mirrors `JonesVector::overlap`.
    public fn overlap(self, other: BjJonesVector): Result {
        var ia: f64 = self.intensity();
        var ib: f64 = other.intensity();
        var den: f64 = ia * ib;
        if (_bj_is_finite(den) == 1 && den >= _BJ_POL_SAFE_MIN) {
            var z: BjComplex = self.inner(other);
            var n: f64 = z.norm_sq();
            var o: f64 = n / den;
            return Ok(o);
        }
        var a: BjJonesVector;
        var ta, ea = _bj_pol_rescaled(self, &a);
        if (is_err_result(ta) == 1) { return Err(ea); }
        var b: BjJonesVector;
        var tb, eb = _bj_pol_rescaled(&other, &b);
        if (is_err_result(tb) == 1) { return Err(eb); }
        var w: BjComplex = a.inner(b);
        var n2: f64 = w.norm_sq();
        var i1: f64 = a.intensity();
        var i2: f64 = b.intensity();
        var d2: f64 = i1 * i2;
        var o2: f64 = n2 / d2;
        return Ok(o2);
    }
}

# The vector at v scaled so that its largest real or imaginary part has magnitude 1 (its intensity in [1, 4]), into
# out. InvalidParameter "Jones vector components must be finite", DivisionByZero "zero Jones vector has no
# polarization state". Mirrors polarization.rs's private `JonesVector::rescaled`.
fn _bj_pol_rescaled(v: *BjJonesVector, out: *BjJonesVector): Result {
    var a: f64 = v.x.re;
    var b: f64 = v.x.im;
    var c: f64 = v.y.re;
    var d: f64 = v.y.im;
    if (_bj_is_finite(a) == 0 || _bj_is_finite(b) == 0 || _bj_is_finite(c) == 0 || _bj_is_finite(d) == 0) {
        return Err(_bj_err_invalid_parameter("Jones vector components must be finite"));
    }
    var aa: f64 = f64_abs(a);                       # Rust's fold of f64::max from 0, over finite parts
    var ab: f64 = f64_abs(b);
    var ac: f64 = f64_abs(c);
    var ad: f64 = f64_abs(d);
    var m: f64 = _bj_max(0.0, aa);
    m = _bj_max(m, ab);
    m = _bj_max(m, ac);
    m = _bj_max(m, ad);
    if (m == 0.0) { return Err(_bj_err_division_by_zero("zero Jones vector has no polarization state")); }
    var s: f64 = 1.0 / m;
    var vx: BjComplex = v.x;
    var vy: BjComplex = v.y;
    var nx: BjComplex = vx.scale(s);
    var ny: BjComplex = vy.scale(s);
    out.x = nx;
    out.y = ny;
    return Ok(0);
}

# ── Jones matrix ─────────────────────────────────────────────────────────────────────────────────────────────────

# A Jones matrix: the 2×2 complex matrix [[m00, m01], [m10, m11]] of an optical element, acting as
# [E_x', E_y'] = [[m00, m01], [m10, m11]]·[E_x, E_y]. Rust's `m: [[Complex; 2]; 2]` is the four fields, `m[i][j]` as
# `mij`. Mirrors `polarization::JonesMatrix`.
public struct BjJonesMatrix {
    m00: BjComplex;
    m01: BjComplex;
    m10: BjComplex;
    m11: BjComplex;
}

# A Jones matrix from its entries [[a, b], [c, d]]. Mirrors `JonesMatrix::new`.
#must_use
#pure
public fn BjJonesMatrix_new(a: BjComplex, b: BjComplex, c: BjComplex, d: BjComplex): BjJonesMatrix {
    var j: BjJonesMatrix;
    j.m00 = a;
    j.m01 = b;
    j.m10 = c;
    j.m11 = d;
    return j;
}

# [[a, b], [c, d]] as a Jones matrix of real entries.
#must_use
#pure
fn _bj_pol_jm_real(a: f64, b: f64, c: f64, d: f64): BjJonesMatrix {
    var j: BjJonesMatrix;
    j.m00.re = a;
    j.m00.im = 0.0;
    j.m01.re = b;
    j.m01.im = 0.0;
    j.m10.re = c;
    j.m10.im = 0.0;
    j.m11.re = d;
    j.m11.im = 0.0;
    return j;
}

# The identity: no effect on the polarization. Mirrors `JonesMatrix::identity`.
#must_use
#pure
public fn BjJonesMatrix_identity(): BjJonesMatrix {
    var j: BjJonesMatrix = _bj_pol_jm_real(1.0, 0.0, 0.0, 1.0);
    return j;
}

# The horizontal linear polarizer [[1, 0], [0, 0]]. Mirrors `JonesMatrix::horizontal_polarizer`.
#must_use
#pure
public fn BjJonesMatrix_horizontal_polarizer(): BjJonesMatrix {
    var j: BjJonesMatrix = _bj_pol_jm_real(1.0, 0.0, 0.0, 0.0);
    return j;
}

# The vertical linear polarizer [[0, 0], [0, 1]]. Mirrors `JonesMatrix::vertical_polarizer`.
#must_use
#pure
public fn BjJonesMatrix_vertical_polarizer(): BjJonesMatrix {
    var j: BjJonesMatrix = _bj_pol_jm_real(0.0, 0.0, 0.0, 1.0);
    return j;
}

# The linear polarizer at angle θ from horizontal: [[c², cs], [cs, s²]], c = cos θ, s = sin θ. Mirrors
# `JonesMatrix::linear_polarizer`.
#must_use
public fn BjJonesMatrix_linear_polarizer(angle: f64): BjJonesMatrix {
    var c: f64 = _bj_cos(angle);
    var s: f64 = _bj_sin(angle);
    var cc: f64 = c * c;
    var cs: f64 = c * s;
    var ss: f64 = s * s;
    var j: BjJonesMatrix = _bj_pol_jm_real(cc, cs, cs, ss);
    return j;
}

# The general waveplate (linear retarder) with fast axis at angle θ and retardance δ: R(−θ)·diag(e^{+jδ/2},
# e^{−jδ/2})·R(θ), the slow axis lagging the fast by δ in e^{+jωt} (the module comment): [[cos(δ/2) + j sin(δ/2)·
# cos 2θ, j sin(δ/2)·sin 2θ], [the same, cos(δ/2) − j sin(δ/2)·cos 2θ]]. Rust's e^{−iωt} matrix conjugated (ADR 0002
# row 5), on cos 2θ and sin 2θ correctly rounded where Rust had c² − s² and 2cs (ADR 0002 row 33: c² − s² loses every
# digit near a fast axis at 45°). Mirrors `JonesMatrix::waveplate`.
#must_use
public fn BjJonesMatrix_waveplate(fast_axis_angle: f64, retardance: f64): BjJonesMatrix {
    var c2, s2 = _bj_pol_cos_sin_2t(fast_axis_angle);
    var half_d: f64 = retardance / 2.0;
    var cos_d: f64 = _bj_cos(half_d);
    var sin_d: f64 = _bj_sin(half_d);
    var ai: f64 = sin_d * c2;
    var bi: f64 = sin_d * s2;
    var nsd: f64 = -sin_d;
    var di: f64 = nsd * c2;
    var j: BjJonesMatrix = _bj_pol_jm_real(cos_d, 0.0, 0.0, cos_d);
    j.m00.im = ai;
    j.m01.im = bi;
    j.m10.im = bi;
    j.m11.im = di;
    return j;
}

# The half-wave plate (δ = π) with fast axis at angle θ: it mirrors the polarization about the fast axis. Mirrors
# `JonesMatrix::half_wave_plate`.
#must_use
public fn BjJonesMatrix_half_wave_plate(fast_axis_angle: f64): BjJonesMatrix {
    var j: BjJonesMatrix = BjJonesMatrix_waveplate(fast_axis_angle, _BJ_PI);
    return j;
}

# The quarter-wave plate (δ = π/2) with fast axis at angle θ: linear to circular at 45° and back. Mirrors
# `JonesMatrix::quarter_wave_plate`.
#must_use
public fn BjJonesMatrix_quarter_wave_plate(fast_axis_angle: f64): BjJonesMatrix {
    var j: BjJonesMatrix = BjJonesMatrix_waveplate(fast_axis_angle, _BJ_POL_PI_2);
    return j;
}

# The Faraday rotator: actively rotates the polarization by θ, from +x toward +y: [[cos θ, −sin θ], [sin θ, cos θ]].
# Its Mueller form is BjMuellerMatrix_rotation(−θ). Mirrors `JonesMatrix::rotator`.
#must_use
public fn BjJonesMatrix_rotator(angle: f64): BjJonesMatrix {
    var c: f64 = _bj_cos(angle);
    var s: f64 = _bj_sin(angle);
    var ns: f64 = -s;
    var j: BjJonesMatrix = _bj_pol_jm_real(c, ns, s, c);
    return j;
}

impl BjJonesMatrix {
    # This matrix applied to a Jones vector. Mirrors `JonesMatrix::apply`.
    #must_use
    public fn apply(self, v: BjJonesVector): BjJonesVector {
        var p: BjComplex = BjComplex_mul(self.m00, v.x);
        var q: BjComplex = BjComplex_mul(self.m01, v.y);
        var r: BjComplex = BjComplex_mul(self.m10, v.x);
        var u: BjComplex = BjComplex_mul(self.m11, v.y);
        var x: BjComplex = BjComplex_add(p, q);
        var y: BjComplex = BjComplex_add(r, u);
        var o: BjJonesVector = BjJonesVector_new(x, y);
        return o;
    }

    # self × other: self applied after other. Mirrors `JonesMatrix::compose`.
    #must_use
    public fn compose(self, other: BjJonesMatrix): BjJonesMatrix {
        var a1: BjComplex = BjComplex_mul(self.m00, other.m00);
        var a2: BjComplex = BjComplex_mul(self.m01, other.m10);
        var b1: BjComplex = BjComplex_mul(self.m00, other.m01);
        var b2: BjComplex = BjComplex_mul(self.m01, other.m11);
        var c1: BjComplex = BjComplex_mul(self.m10, other.m00);
        var c2: BjComplex = BjComplex_mul(self.m11, other.m10);
        var d1: BjComplex = BjComplex_mul(self.m10, other.m01);
        var d2: BjComplex = BjComplex_mul(self.m11, other.m11);
        var a: BjComplex = BjComplex_add(a1, a2);
        var b: BjComplex = BjComplex_add(b1, b2);
        var c: BjComplex = BjComplex_add(c1, c2);
        var d: BjComplex = BjComplex_add(d1, d2);
        var j: BjJonesMatrix = BjJonesMatrix_new(a, b, c, d);
        return j;
    }

    # The determinant m00·m11 − m01·m10. Mirrors `JonesMatrix::determinant`.
    #must_use
    public fn determinant(self): BjComplex {
        var p: BjComplex = BjComplex_mul(self.m00, self.m11);
        var q: BjComplex = BjComplex_mul(self.m01, self.m10);
        var z: BjComplex = BjComplex_sub(p, q);
        return z;
    }
}

# ── Stokes vector ────────────────────────────────────────────────────────────────────────────────────────────────

# A Stokes vector [S₀, S₁, S₂, S₃]: the total intensity, the horizontal-vertical, diagonal-antidiagonal and
# right-left circular (IEEE, S₃ > 0 right-hand) preferences. Rust's `s: [f64; 4]` is a 4-element tuple field, `s[i]`
# as `s.i`. Mirrors `polarization::StokesVector`.
public struct BjStokesVector {
    s: (f64, f64, f64, f64);
}

# A Stokes vector from its components. Mirrors `StokesVector::new`.
#must_use
#pure
public fn BjStokesVector_new(s0: f64, s1: f64, s2: f64, s3: f64): BjStokesVector {
    var v: BjStokesVector;
    v.s.0 = s0;
    v.s.1 = s1;
    v.s.2 = s2;
    v.s.3 = s3;
    return v;
}

# The default Stokes vector: unpolarized light of zero intensity. Mirrors `Default for StokesVector`.
#must_use
#pure
public fn BjStokesVector_default(): BjStokesVector {
    var v: BjStokesVector = BjStokesVector_new(0.0, 0.0, 0.0, 0.0);
    return v;
}

# The Stokes vector of a fully polarized Jones vector: S₀ = |E_x|² + |E_y|², S₁ = |E_x|² − |E_y|², S₂ = 2 Re(E_x E_y*)
# and S₃ = 2 Im(E_x E_y*), +1 for right-hand circular light (the module comment). Mirrors `StokesVector::from_jones`.
#must_use
public fn BjStokesVector_from_jones(j: BjJonesVector): BjStokesVector {
    var ix: f64 = j.x.norm_sq();
    var iy: f64 = j.y.norm_sq();
    var cy: BjComplex = j.y.conj();
    var cr: BjComplex = BjComplex_mul(j.x, cy);
    var s0: f64 = ix + iy;
    var s1: f64 = ix - iy;
    var s2: f64 = 2.0 * cr.re;
    var s3: f64 = 2.0 * cr.im;
    var v: BjStokesVector = BjStokesVector_new(s0, s1, s2, s3);
    return v;
}

# Unpolarized light of the given intensity: [I, 0, 0, 0]. Mirrors `StokesVector::unpolarized`.
#must_use
#pure
public fn BjStokesVector_unpolarized(intensity: f64): BjStokesVector {
    var v: BjStokesVector = BjStokesVector_new(intensity, 0.0, 0.0, 0.0);
    return v;
}

# Horizontal linear polarization: [I, I, 0, 0]. Mirrors `StokesVector::horizontal`.
#must_use
#pure
public fn BjStokesVector_horizontal(intensity: f64): BjStokesVector {
    var v: BjStokesVector = BjStokesVector_new(intensity, intensity, 0.0, 0.0);
    return v;
}

# Vertical linear polarization: [I, −I, 0, 0]. Mirrors `StokesVector::vertical`.
#must_use
#pure
public fn BjStokesVector_vertical(intensity: f64): BjStokesVector {
    var ni: f64 = -intensity;
    var v: BjStokesVector = BjStokesVector_new(intensity, ni, 0.0, 0.0);
    return v;
}

# Right-hand circular polarization (IEEE): [I, 0, 0, I]. Rust's `StokesVector::left_circular` is the same state
# (ADR 0002 row 5).
#must_use
#pure
public fn BjStokesVector_right_circular(intensity: f64): BjStokesVector {
    var v: BjStokesVector = BjStokesVector_new(intensity, 0.0, 0.0, intensity);
    return v;
}

# Left-hand circular polarization (IEEE): [I, 0, 0, −I]. Rust's `StokesVector::right_circular` is the same state
# (ADR 0002 row 5).
#must_use
#pure
public fn BjStokesVector_left_circular(intensity: f64): BjStokesVector {
    var ni: f64 = -intensity;
    var v: BjStokesVector = BjStokesVector_new(intensity, 0.0, 0.0, ni);
    return v;
}

# a + b, component by component (incoherent superposition). Mirrors `Add for StokesVector`.
#must_use
#pure
public fn BjStokesVector_add(a: BjStokesVector, b: BjStokesVector): BjStokesVector {
    var s0: f64 = a.s.0 + b.s.0;
    var s1: f64 = a.s.1 + b.s.1;
    var s2: f64 = a.s.2 + b.s.2;
    var s3: f64 = a.s.3 + b.s.3;
    var v: BjStokesVector = BjStokesVector_new(s0, s1, s2, s3);
    return v;
}

impl BjStokesVector {
    # The total intensity S₀. Mirrors `StokesVector::intensity`.
    #must_use
    #pure
    public fn intensity(self): f64 {
        var i: f64 = self.s.0;
        return i;
    }

    # The degree of polarization √(S₁² + S₂² + S₃²)/S₀ (hypot's, so no square under- or overflows): 0 unpolarized, 1
    # fully polarized, for any positive finite S₀. DivisionByZero for S₀ = 0; InvalidParameter "Stokes vector must be
    # finite with S₀ > 0, got [..]" for S₀ < 0 or a non-finite part. Mirrors `StokesVector::degree_of_polarization`.
    public fn degree_of_polarization(self): Result {
        var s0: f64 = self.s.0;
        if (s0 == 0.0) { return Err(_bj_err_division_by_zero("cannot compute DOP for zero-intensity light")); }
        var p: *f64 = _bj_pol_f64p(self);
        if (!(s0 > 0.0 && _bj_is_finite(p[0]) == 1 && _bj_is_finite(p[1]) == 1 && _bj_is_finite(p[2]) == 1
            && _bj_is_finite(p[3]) == 1)) {
            var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(t, "Stokes vector must be finite with S₀ > 0, got ");
            _bj_pol_fmt4(t, p);
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        var h1: f64 = _bj_hypot(p[1], p[2]);
        var h2: f64 = _bj_hypot(h1, p[3]);
        var d: f64 = h2 / s0;
        return Ok(d);
    }

    # The ellipticity angle χ, tan 2χ = S₃/√(S₁² + S₂²): 0 for linear light, +π/4 for right-hand circular (IEEE), −π/4
    # for left. Mirrors `StokesVector::ellipticity_angle`.
    #must_use
    public fn ellipticity_angle(self): f64 {
        var a: f64 = self.s.1;
        var b: f64 = self.s.2;
        var c: f64 = self.s.3;
        var q: f64 = a * a + b * b;
        var lin: f64 = f64_sqrt(q);
        var t: f64 = _bj_atan2(c, lin);
        var x: f64 = 0.5 * t;
        return x;
    }

    # The orientation angle ψ of the polarization ellipse, tan 2ψ = S₂/S₁. Mirrors `StokesVector::orientation_angle`.
    #must_use
    public fn orientation_angle(self): f64 {
        var a: f64 = self.s.1;
        var b: f64 = self.s.2;
        var t: f64 = _bj_atan2(b, a);
        var x: f64 = 0.5 * t;
        return x;
    }
}

# An address as a *f64: a BjStokesVector's four components or a BjMuellerMatrix's sixteen.
#must_use
fn _bj_pol_f64p(p): *f64 {
    return p;
}

# Appends the four f64 at p as Rust's `{:?}` writes an [f64; 4]: [a, b, c, d].
fn _bj_pol_fmt4(t, p: *f64) {
    _bj_tx_putc(t, 91);
    _bj_fmt_f64_debug(t, p[0]);
    _bj_tx_cstr(t, ", ");
    _bj_fmt_f64_debug(t, p[1]);
    _bj_tx_cstr(t, ", ");
    _bj_fmt_f64_debug(t, p[2]);
    _bj_tx_cstr(t, ", ");
    _bj_fmt_f64_debug(t, p[3]);
    _bj_tx_putc(t, 93);
    return 0;
}

# ── Mueller matrix ───────────────────────────────────────────────────────────────────────────────────────────────

# A Mueller matrix: the 4×4 real matrix acting on Stokes vectors (partially polarized and incoherent light). Rust's
# `m: [[f64; 4]; 4]` is a 16-element tuple field, row-major, `m[i][j]` as `m.(4i + j)` (probe p17, as BjEmTensor).
# Mirrors `polarization::MuellerMatrix`.
public struct BjMuellerMatrix {
    m: (f64, f64, f64, f64, f64, f64, f64, f64, f64, f64, f64, f64, f64, f64, f64, f64);
}

# A Mueller matrix from its sixteen entries at m, row-major. Mirrors `MuellerMatrix::new`.
#must_use
public fn BjMuellerMatrix_new(m: *f64): BjMuellerMatrix {
    var r: BjMuellerMatrix;
    var o: *f64 = _bj_pol_f64p(&r);
    for (var k = 0; k < 16; k = k + 1) { o[k] = m[k]; }
    return r;
}

# The matrix with diagonal (a, b, c, d) and every other entry 0.
#must_use
fn _bj_pol_mm_diag(a: f64, b: f64, c: f64, d: f64): BjMuellerMatrix {
    var r: BjMuellerMatrix;
    var o: *f64 = _bj_pol_f64p(&r);
    for (var k = 0; k < 16; k = k + 1) { o[k] = 0.0; }
    o[0] = a;
    o[5] = b;
    o[10] = c;
    o[15] = d;
    return r;
}

# The identity Mueller matrix. Mirrors `MuellerMatrix::identity`.
#must_use
public fn BjMuellerMatrix_identity(): BjMuellerMatrix {
    var r: BjMuellerMatrix = _bj_pol_mm_diag(1.0, 1.0, 1.0, 1.0);
    return r;
}

# The ideal depolarizer: the output is unpolarized whatever the input. Mirrors `MuellerMatrix::depolarizer`.
#must_use
public fn BjMuellerMatrix_depolarizer(): BjMuellerMatrix {
    var r: BjMuellerMatrix = _bj_pol_mm_diag(1.0, 0.0, 0.0, 0.0);
    return r;
}

# The attenuator (a neutral density filter): every component scaled by the transmission. Mirrors
# `MuellerMatrix::attenuator`.
#must_use
public fn BjMuellerMatrix_attenuator(transmission: f64): BjMuellerMatrix {
    var t: f64 = transmission;
    var r: BjMuellerMatrix = _bj_pol_mm_diag(t, t, t, t);
    return r;
}

# The horizontal linear polarizer ½[[1, 1, 0, 0], [1, 1, 0, 0], 0, 0]. Mirrors `MuellerMatrix::horizontal_polarizer`.
#must_use
public fn BjMuellerMatrix_horizontal_polarizer(): BjMuellerMatrix {
    var r: BjMuellerMatrix = _bj_pol_mm_diag(0.5, 0.5, 0.0, 0.0);
    var o: *f64 = _bj_pol_f64p(&r);
    o[1] = 0.5;
    o[4] = 0.5;
    return r;
}

# The vertical linear polarizer ½[[1, −1, 0, 0], [−1, 1, 0, 0], 0, 0]. Mirrors `MuellerMatrix::vertical_polarizer`.
#must_use
public fn BjMuellerMatrix_vertical_polarizer(): BjMuellerMatrix {
    var r: BjMuellerMatrix = _bj_pol_mm_diag(0.5, 0.5, 0.0, 0.0);
    var o: *f64 = _bj_pol_f64p(&r);
    o[1] = -0.5;
    o[4] = -0.5;
    return r;
}

# The linear polarizer at angle θ: ½[[1, C, S, 0], [C, C², CS, 0], [S, CS, S², 0], 0], C = cos 2θ, S = sin 2θ. Mirrors
# `MuellerMatrix::linear_polarizer`.
#must_use
public fn BjMuellerMatrix_linear_polarizer(angle: f64): BjMuellerMatrix {
    var a2: f64 = 2.0 * angle;
    var c2: f64 = _bj_cos(a2);
    var s2: f64 = _bj_sin(a2);
    var r: BjMuellerMatrix = _bj_pol_mm_diag(0.5, 0.0, 0.0, 0.0);
    var o: *f64 = _bj_pol_f64p(&r);
    var hc: f64 = 0.5 * c2;
    var hs: f64 = 0.5 * s2;
    o[1] = hc;
    o[2] = hs;
    o[4] = hc;
    o[5] = hc * c2;
    o[6] = hc * s2;
    o[8] = hs;
    o[9] = hc * s2;
    o[10] = hs * s2;
    return r;
}

# The general waveplate with fast axis at angle θ and retardance δ: the Mueller form of BjJonesMatrix_waveplate.
# C = cos 2θ, S = sin 2θ: [[1, 0, 0, 0], [0, C² + S²cos δ, CS(1 − cos δ), S sin δ], [0, CS(1 − cos δ), S² + C²cos δ,
# −C sin δ], [0, −S sin δ, C sin δ, cos δ]]. The entries coupling S₃ are the exact negatives of Rust's (the module
# comment, ADR 0002 row 5). 1 − cos δ is 2·sin²(δ/2) where cos δ > 1/2, where the difference cancels (ADR 0002
# row 33), and Rust's difference elsewhere, where it is exact or nearly. Mirrors `MuellerMatrix::waveplate`.
#must_use
public fn BjMuellerMatrix_waveplate(fast_axis_angle: f64, retardance: f64): BjMuellerMatrix {
    var a2: f64 = 2.0 * fast_axis_angle;
    var c2: f64 = _bj_cos(a2);
    var s2: f64 = _bj_sin(a2);
    var cd: f64 = _bj_cos(retardance);
    var sd: f64 = _bj_sin(retardance);
    var r: BjMuellerMatrix = _bj_pol_mm_diag(1.0, 0.0, 0.0, cd);
    var o: *f64 = _bj_pol_f64p(&r);
    var cc: f64 = c2 * c2;
    var ss: f64 = s2 * s2;
    var cs: f64 = c2 * s2;
    var om: f64 = 1.0 - cd;
    if (cd > 0.5) {
        var hd: f64 = retardance / 2.0;
        var hs: f64 = _bj_sin(hd);
        var hh: f64 = hs * hs;
        om = 2.0 * hh;
    }
    var ssd: f64 = ss * cd;
    var ccd: f64 = cc * cd;
    var nc2: f64 = -c2;
    var ns2: f64 = -s2;
    o[5] = cc + ssd;
    o[6] = cs * om;
    o[7] = s2 * sd;
    o[9] = cs * om;
    o[10] = ss + ccd;
    o[11] = nc2 * sd;
    o[13] = ns2 * sd;
    o[14] = c2 * sd;
    return r;
}

# The quarter-wave plate (δ = π/2) with fast axis at angle θ. Mirrors `MuellerMatrix::quarter_wave_plate`.
#must_use
public fn BjMuellerMatrix_quarter_wave_plate(fast_axis_angle: f64): BjMuellerMatrix {
    var r: BjMuellerMatrix = BjMuellerMatrix_waveplate(fast_axis_angle, _BJ_POL_PI_2);
    return r;
}

# The half-wave plate (δ = π) with fast axis at angle θ. Mirrors `MuellerMatrix::half_wave_plate`.
#must_use
public fn BjMuellerMatrix_half_wave_plate(fast_axis_angle: f64): BjMuellerMatrix {
    var r: BjMuellerMatrix = BjMuellerMatrix_waveplate(fast_axis_angle, _BJ_PI);
    return r;
}

# The rotation of the coordinate frame by θ (passive): S₁′ = cos 2θ S₁ + sin 2θ S₂, S₂′ = −sin 2θ S₁ + cos 2θ S₂.
# Re-expressing a state in axes rotated by +θ physically rotates it by −θ, so this is the Mueller form of
# BjJonesMatrix_rotator(−θ); an element M rotated by θ is rotation(−θ)·M·rotation(θ). Mirrors
# `MuellerMatrix::rotation`.
#must_use
public fn BjMuellerMatrix_rotation(angle: f64): BjMuellerMatrix {
    var a2: f64 = 2.0 * angle;
    var c2: f64 = _bj_cos(a2);
    var s2: f64 = _bj_sin(a2);
    var ns2: f64 = -s2;
    var r: BjMuellerMatrix = _bj_pol_mm_diag(1.0, c2, c2, 1.0);
    var o: *f64 = _bj_pol_f64p(&r);
    o[6] = s2;
    o[9] = ns2;
    return r;
}

# The right-hand circular polarizer (IEEE): ½[[1, 0, 0, 1], 0, 0, [1, 0, 0, 1]], passing BjStokesVector_right_circular.
# Rust's `MuellerMatrix::left_circular_polarizer` is the same element (ADR 0002 row 5).
#must_use
public fn BjMuellerMatrix_right_circular_polarizer(): BjMuellerMatrix {
    var r: BjMuellerMatrix = _bj_pol_mm_diag(0.5, 0.0, 0.0, 0.5);
    var o: *f64 = _bj_pol_f64p(&r);
    o[3] = 0.5;
    o[12] = 0.5;
    return r;
}

# The left-hand circular polarizer (IEEE): ½[[1, 0, 0, −1], 0, 0, [−1, 0, 0, 1]]. Rust's
# `MuellerMatrix::right_circular_polarizer` is the same element (ADR 0002 row 5).
#must_use
public fn BjMuellerMatrix_left_circular_polarizer(): BjMuellerMatrix {
    var r: BjMuellerMatrix = _bj_pol_mm_diag(0.5, 0.0, 0.0, 0.5);
    var o: *f64 = _bj_pol_f64p(&r);
    o[3] = -0.5;
    o[12] = -0.5;
    return r;
}

impl BjMuellerMatrix {
    # This matrix applied to a Stokes vector: each output the sum of a row's four products, left to right (Rust's
    # iterator sum, from 0). Mirrors `MuellerMatrix::apply`.
    #must_use
    public fn apply(self, s: BjStokesVector): BjStokesVector {
        var m: *f64 = _bj_pol_f64p(self);
        var v: *f64 = _bj_pol_f64p(&s);
        var r: BjStokesVector;
        var o: *f64 = _bj_pol_f64p(&r);
        for (var i = 0; i < 4; i = i + 1) {
            var acc: f64 = _bj_pol_neg0();
            for (var j = 0; j < 4; j = j + 1) {
                var a: f64 = m[4 * i + j];
                var b: f64 = v[j];
                var p: f64 = a * b;
                acc = acc + p;
            }
            o[i] = acc;
        }
        return r;
    }

    # self × other: self applied after other, each entry a sum of four products left to right (Rust's iterator
    # sum). Mirrors `MuellerMatrix::compose`.
    #must_use
    public fn compose(self, other: BjMuellerMatrix): BjMuellerMatrix {
        var a: *f64 = _bj_pol_f64p(self);
        var b: *f64 = _bj_pol_f64p(&other);
        var r: BjMuellerMatrix;
        var o: *f64 = _bj_pol_f64p(&r);
        for (var i = 0; i < 4; i = i + 1) {
            for (var j = 0; j < 4; j = j + 1) {
                var acc: f64 = _bj_pol_neg0();
                for (var k = 0; k < 4; k = k + 1) {
                    var x: f64 = a[4 * i + k];
                    var y: f64 = b[4 * k + j];
                    var p: f64 = x * y;
                    acc = acc + p;
                }
                o[4 * i + j] = acc;
            }
        }
        return r;
    }
}

# −0.0: Rust's `Iterator::sum` of f64 starts from −0.0 (core's float Sum, since 1.81), so a sum of −0.0 terms stays −0.
#must_use
fn _bj_pol_neg0(): f64 {
    var z: f64 = 0x8000000000000000;
    return z;
}

# --- scattering.cyr ---

# scattering.cyr — scattering.rs (M3 part 1b-1): Mie scattering by a homogeneous sphere, and the Rayleigh limit.
#
# Size parameter x = 2πr/λ, with r the sphere's radius and λ the wavelength in the surrounding medium; m is the
# sphere's index relative to that medium.
#
# The time convention is bijli's one, e^{+jωt} (src/complex.cyr's header; ADR 0002 row 5). scattering.rs already used
# it, so nothing here changes: the outgoing Riccati–Hankel function is ξₙ(x) = ψₙ(x) + jχₙ(x) = x·hₙ⁽²⁾(x), so
# ξ₀(x) = sin x + j cos x, and an absorbing sphere has Im(m) < 0 (m = n − jκ). bj_mie refuses Im(m) > 0, a gain
# medium or, far more often, an index written in the other convention: for an index quoted as n + jκ (Bohren &
# Huffman's e^{−jωt}) pass m.conj(). The efficiencies and g are convention-free; the coefficients a and b are the
# complex conjugates of Bohren & Huffman's aₙ and bₙ. polarization and beam now share the convention (2.0).
#
# Mie follows Bohren & Huffman (1983, App. A), with Wiscombe's n_max = ⌈x + 4x^{1/3} + 2⌉ (at least 4) terms and
# Dₙ(mx) by downward recurrence from max(n_max, |mx| + 4|mx|^{1/3}) + 15. Its recurrences run on f64 locals (probe p8:
# a struct-valued step is 2.2× slower) in Rust's exact order of operations, hisab's Complex products and sums written
# out; the reciprocal and Smith's division are scattering.rs's own, ported as written. sin, cos and hypot are
# correctly rounded (src/crmath.cyr), and cbrt is ganita's, correctly rounded as Rust's (CORE-MATH's).
#
# A BjMieResult owns its coefficient buffers (Rust's `Vec<Complex>`, port plan §9.5): bj_mie writes new ones into
# `out` and never reads it, so give a result back with BjMieResult_free before reusing it.

private

# Below this size parameter ψ₁(x) is its power series, avoiding the cancellation in sin x / x − cos x. Mirrors
# `PSI1_SERIES_THRESHOLD`.
var _BJ_SC_PSI1_SERIES: f64 = 0.1;

# The smallest normal f64 and the largest finite one: |z|² is normal between them.
var _BJ_SC_MIN_NORMAL: f64 = 0x0010000000000000;
var _BJ_SC_MAX_FINITE: f64 = 0x7FEFFFFFFFFFFFFF;

# ── the result ──────────────────────────────────────────────────────────────────────────────────────────────────

# Mie scattering by a homogeneous sphere: the efficiencies, the asymmetry parameter and the coefficients. `a` and
# `b` are the addresses of a_len and b_len BjComplex (16 bytes each) from fl_alloc, 0 while empty: aₙ and bₙ for
# n = 1…n_max at indices 0…n_max − 1, in the e^{+jωt} convention (the complex conjugates of Bohren & Huffman's).
# Mirrors `MieResult`.
public struct BjMieResult {
    q_sca: f64;
    q_ext: f64;
    q_abs: f64;
    g: f64;
    a;
    a_len;
    b;
    b_len;
}

# An empty result: zero efficiencies, no coefficients.
#must_use
public fn BjMieResult_new(): BjMieResult {
    var r: BjMieResult;
    r.q_sca = 0.0;
    r.q_ext = 0.0;
    r.q_abs = 0.0;
    r.g = 0.0;
    r.a = 0;
    r.a_len = 0;
    r.b = 0;
    r.b_len = 0;
    return r;
}

# Frees r's coefficient buffers and empties them (its efficiencies are kept).
public fn BjMieResult_free(r: *BjMieResult): i64 {
    if (r.a != 0) { fl_free(r.a); }
    if (r.b != 0) { fl_free(r.b); }
    r.a = 0;
    r.a_len = 0;
    r.b = 0;
    r.b_len = 0;
    return 0;
}

# The address a as a *f64 (an untyped word stored into a typed pointer warns; a typed return does not).
#must_use
fn _bj_sc_f64p(a): *f64 {
    return a;
}

# The BjComplex at address p.
#must_use
fn _bj_sc_load(p): BjComplex {
    var z: BjComplex;
    z.re = load64(p);
    z.im = load64(p + 8);
    return z;
}

impl BjMieResult {
    # aₖ₊₁, the coefficient at index k (0 ≤ k < a_len). Mirrors `result.a[k]`.
    #must_use
    public fn a_at(self, k): BjComplex {
        var z: BjComplex = _bj_sc_load(self.a + k * 16);
        return z;
    }

    # bₖ₊₁, the coefficient at index k (0 ≤ k < b_len). Mirrors `result.b[k]`.
    #must_use
    public fn b_at(self, k): BjComplex {
        var z: BjComplex = _bj_sc_load(self.b + k * 16);
        return z;
    }
}

# ── the module's complex helpers ────────────────────────────────────────────────────────────────────────────────

# Records scattering.rs's DivisionByZero ("complex division by zero in scattering computation"); its code.
fn _bj_sc_dz(): i64 {
    return _bj_err_division_by_zero("complex division by zero in scattering computation");
}

# a / b by Smith's algorithm (no intermediate |b|², so no spurious over- or underflow), b ≠ 0: the caller tests for
# zero (_bj_sc_dz). Mirrors scattering.rs's `complex_div`.
#must_use
fn _bj_sc_div(ar: f64, ai: f64, br: f64, bi: f64): (f64, f64) {
    var abr: f64 = f64_abs(br);
    var abi: f64 = f64_abs(bi);
    if (abr >= abi) {
        var r: f64 = bi / br;
        var den: f64 = br + bi * r;
        var qr: f64 = (ar + ai * r) / den;
        var qi: f64 = (ai - ar * r) / den;
        return (qr, qi);
    }
    var r2: f64 = br / bi;
    var den2: f64 = br * r2 + bi;
    var pr: f64 = (ar * r2 + ai) / den2;
    var pi: f64 = (ai * r2 - ar) / den2;
    return (pr, pi);
}

# 1/z into out[0], out[1]: one division when |z|² is a normal f64, Smith's algorithm otherwise. 0, or the
# DivisionByZero code recorded (z = 0). Mirrors scattering.rs's `complex_recip`.
fn _bj_sc_recip(zr: f64, zi: f64, out: *f64): i64 {
    var d: f64 = zr * zr + zi * zi;
    var lo: f64 = _BJ_SC_MIN_NORMAL;
    var hi: f64 = _BJ_SC_MAX_FINITE;
    if (d >= lo && d <= hi) {
        var inv: f64 = 1.0 / d;
        out[0] = zr * inv;
        out[1] = -zi * inv;
        return 0;
    }
    if (zr == 0.0 && zi == 0.0) { return _bj_sc_dz(); }
    var qr, qi = _bj_sc_div(1.0, 0.0, zr, zi);
    out[0] = qr;
    out[1] = qi;
    return 0;
}

# ── Mie ─────────────────────────────────────────────────────────────────────────────────────────────────────────

# Records InvalidParameter "size parameter x must be positive and finite, got {x}" and the like: the head, x in
# Rust's Display form, the tail. Returns the code.
fn _bj_sc_bad(head, x: f64, tail): i64 {
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, head);
    _bj_fmt_f64_display(t, x);
    _bj_tx_cstr(t, tail);
    return BJ_ERR_INVALID_PARAMETER;
}

# mie's argument checks: 0, or the InvalidParameter code recorded with Rust's reason.
fn _bj_sc_mie_check(x: f64, m: BjComplex, mx_abs: f64): i64 {
    var mre: f64 = m.re;
    var mim: f64 = m.im;
    var lim: f64 = BJ_MIE_MAX_SIZE_PARAMETER;
    var limx: f64 = BJ_MIE_MAX_MX;
    if (_bj_is_finite(x) == 0 || x <= 0.0) {
        return _bj_sc_bad("size parameter x must be positive and finite, got ", x, "");
    }
    if (x > lim) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "size parameter x = ");
        _bj_fmt_f64_display(t, x);
        _bj_tx_cstr(t, " exceeds the supported maximum ");
        _bj_fmt_f64_display(t, lim);
        return BJ_ERR_INVALID_PARAMETER;
    }
    if (_bj_is_finite(mre) == 0 || _bj_is_finite(mim) == 0) {
        var u = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(u, "refractive index must be finite, got ");
        m.display(u);
        return BJ_ERR_INVALID_PARAMETER;
    }
    if (mre == 0.0 && mim == 0.0) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_INVALID_PARAMETER), "refractive index cannot be zero");
        return BJ_ERR_INVALID_PARAMETER;
    }
    if (mim > 0.0) {
        var w = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(w, "Im(m) = ");
        _bj_fmt_f64_display(w, mim);
        _bj_tx_cstr(w, " > 0: bijli's Mie solver uses the e^{+iωt} convention, where absorbing media have Im(m) < 0 ");
        _bj_tx_cstr(w, "(m = n − iκ); for an index written as n + iκ pass m.conj()");
        return BJ_ERR_INVALID_PARAMETER;
    }
    if (mx_abs != mx_abs || mx_abs > limx) {
        var y = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(y, "|m|·x = ");
        _bj_fmt_f64_display(y, mx_abs);
        _bj_tx_cstr(y, " exceeds the supported maximum ");
        _bj_fmt_f64_display(y, limx);
        return BJ_ERR_INVALID_PARAMETER;
    }
    return 0;
}

# ψ₁(x) = sin x / x − cos x, by its Maclaurin series below x = 0.1 where the direct form cancels (relative error
# about 3ε/x²): x²/3 − x⁴/30 + x⁶/840 − x⁸/45360 + x¹⁰/3991680. Mirrors scattering.rs's `psi1`.
#must_use
fn _bj_sc_psi1(x: f64, sin_x: f64, cos_x: f64): f64 {
    var th: f64 = _BJ_SC_PSI1_SERIES;
    if (x < th) {
        var x2: f64 = x * x;
        var r: f64 = x2 / 3.0 * (1.0 - x2 / 10.0 * (1.0 - x2 / 28.0 * (1.0 - x2 / 54.0 * (1.0 - x2 / 88.0))));
        return r;
    }
    var d: f64 = sin_x / x - cos_x;
    return d;
}

# Wiscombe's n_max = max(⌈x + 4·∛x + 2⌉, 4), and the D_n recurrence's start ⌈max(n_max, |mx| + 4·∛|mx|) + 15⌉. x ≤ 10⁵
# and |mx| ≤ 10⁷, so both are exact integers.
fn _bj_sc_terms(x: f64, mx_abs: f64): (i64, i64) {
    var cx: f64 = ganita_f64_cbrt(x);
    var t: f64 = x + 4.0 * cx + 2.0;
    var tc: f64 = f64_ceil(t);
    var n_max = f64_to(tc);
    if (n_max < 4) { n_max = 4; }
    var cm: f64 = ganita_f64_cbrt(mx_abs);
    var s: f64 = mx_abs + 4.0 * cm;
    var nf: f64 = f64_from(n_max);
    var top: f64 = _bj_max(nf, s);
    var u: f64 = top + 15.0;
    var uc: f64 = f64_ceil(u);
    var n_start = f64_to(uc);
    return (n_max, n_start);
}

# Dₙ(mx) = ψₙ′(mx)/ψₙ(mx) for n = 0…n_max into d (n_max + 1 BjComplex), by the downward recurrence
# D_{n−1} = n/z − 1/(Dₙ + n/z) from D_{n_start} = 0, z = mx, on f64 locals. 0, or the DivisionByZero code recorded.
fn _bj_sc_lderiv(imr: f64, imi: f64, n_max, n_start, d): i64 {
    var lo: f64 = _BJ_SC_MIN_NORMAL;
    var hi: f64 = _BJ_SC_MAX_FINITE;
    var dr: f64 = 0.0;
    var di: f64 = 0.0;
    for (var n = n_start; n >= 1; n = n - 1) {
        var nf: f64 = f64_from(n);
        var rr: f64 = imr * nf;
        var ri: f64 = imi * nf;
        var sr: f64 = dr + rr;
        var si: f64 = di + ri;
        var q: f64 = sr * sr + si * si;
        var qr: f64 = 0.0;
        var qi: f64 = 0.0;
        if (q >= lo && q <= hi) {
            var inv: f64 = 1.0 / q;
            qr = sr * inv;
            qi = -si * inv;
        } else {
            if (sr == 0.0 && si == 0.0) { return _bj_sc_dz(); }
            var vr, vi = _bj_sc_div(1.0, 0.0, sr, si);
            qr = vr;
            qi = vi;
        }
        dr = rr - qr;
        di = ri - qi;
        if (n - 1 <= n_max) {
            var p: *f64 = _bj_sc_f64p(d + (n - 1) * 16);
            p[0] = dr;
            p[1] = di;
        }
    }
    return 0;
}

# The Riccati–Bessel loop: aₙ and bₙ for n = 1…n_max into a and b (n_max BjComplex each), and the sums for Q_sca,
# Q_ext and g into sums[0..3]. ψₙ(x) = x·jₙ(x) and χₙ(x) = −x·yₙ(x) by upward recurrence, ξₙ = ψₙ + jχₙ; Rust's
# order of operations throughout (Bohren & Huffman eq. 4.88: aₙ uses Dₙ/m + n/x, bₙ uses m·Dₙ + n/x). 0, or the
# DivisionByZero code recorded.
fn _bj_sc_series(x: f64, m: *f64, d, n_max, a, b, sums: *f64): i64 {
    var sin_x, cos_x = _bj_sin_cos(x);
    var sx: f64 = sin_x;
    var cx: f64 = cos_x;
    var psi_prev: f64 = sx;
    var psi_curr: f64 = _bj_sc_psi1(x, sx, cx);
    var chi_prev: f64 = cx;
    var chi_curr: f64 = cx / x + sx;
    var mr: f64 = m[0];
    var mi: f64 = m[1];
    var im: f64[2];
    var c = _bj_sc_recip(mr, mi, &im);
    if (c != 0) { return c; }
    var imr: f64 = im[0];
    var imi: f64 = im[1];
    var sca: f64 = 0.0;
    var ext: f64 = 0.0;
    var gs: f64 = 0.0;
    var apr: f64 = 0.0;
    var api: f64 = 0.0;
    var bpr: f64 = 0.0;
    var bpi: f64 = 0.0;
    for (var n = 1; n <= n_max; n = n + 1) {
        var dp: *f64 = _bj_sc_f64p(d + n * 16);
        var dnr: f64 = dp[0];
        var dni: f64 = dp[1];
        if (n > 1) {
            var tw: f64 = f64_from(2 * n - 1);
            var f: f64 = tw / x;
            var psi_next: f64 = f * psi_curr - psi_prev;
            psi_prev = psi_curr;
            psi_curr = psi_next;
            var chi_next: f64 = f * chi_curr - chi_prev;
            chi_prev = chi_curr;
            chi_curr = chi_next;
        }
        var nf: f64 = f64_from(n);
        var nox: f64 = nf / x;
        # a_factor = Dₙ·(1/m) + n/x; its numerator a_factor·ψₙ − ψₙ₋₁ (Rust subtracts complex_real(ψₙ₋₁): the
        # imaginary part's − 0.0 is the identity), its denominator a_factor·ξₙ − ξₙ₋₁.
        var afr: f64 = dnr * imr - dni * imi + nox;
        var afi0: f64 = dnr * imi + dni * imr;
        var afi: f64 = afi0 + 0.0;
        var anr: f64 = afr * psi_curr - psi_prev;
        var ani: f64 = afi * psi_curr;
        var adr: f64 = afr * psi_curr - afi * chi_curr - psi_prev;
        var adi: f64 = afr * chi_curr + afi * psi_curr - chi_prev;
        if (adr == 0.0 && adi == 0.0) { return _bj_sc_dz(); }
        var ar, ai = _bj_sc_div(anr, ani, adr, adi);
        var a_r: f64 = ar;
        var a_i: f64 = ai;
        var bfr: f64 = mr * dnr - mi * dni + nox;
        var bfi0: f64 = mr * dni + mi * dnr;
        var bfi: f64 = bfi0 + 0.0;
        var bnr: f64 = bfr * psi_curr - psi_prev;
        var bni: f64 = bfi * psi_curr;
        var bdr: f64 = bfr * psi_curr - bfi * chi_curr - psi_prev;
        var bdi: f64 = bfr * chi_curr + bfi * psi_curr - chi_prev;
        if (bdr == 0.0 && bdi == 0.0) { return _bj_sc_dz(); }
        var br, bi = _bj_sc_div(bnr, bni, bdr, bdi);
        var b_r: f64 = br;
        var b_i: f64 = bi;
        var w: f64 = 2.0 * nf + 1.0;
        sca = sca + w * (a_r * a_r + a_i * a_i + (b_r * b_r + b_i * b_i));
        ext = ext + w * (a_r + b_r);
        # (2n+1)/(n(n+1)) Re(aₙb*ₙ) for every n, and (n−1)(n+1)/n Re(aₙ₋₁a*ₙ + bₙ₋₁b*ₙ) for n > 1.
        gs = gs + w / (nf * (nf + 1.0)) * (a_r * b_r + a_i * b_i);
        if (n > 1) {
            gs = gs + (nf - 1.0) * (nf + 1.0) / nf * (apr * a_r + api * a_i + bpr * b_r + bpi * b_i);
        }
        apr = a_r;
        api = a_i;
        bpr = b_r;
        bpi = b_i;
        var pa: *f64 = _bj_sc_f64p(a + (n - 1) * 16);
        pa[0] = a_r;
        pa[1] = a_i;
        var pb: *f64 = _bj_sc_f64p(b + (n - 1) * 16);
        pb[0] = b_r;
        pb[1] = b_i;
    }
    sums[0] = sca;
    sums[1] = ext;
    sums[2] = gs;
    return 0;
}

# Logs the start of a Mie computation at debug, as Rust's `tracing::debug!(x, m_re, m_im, n_max, n_start, ..)`.
fn _bj_sc_log_start(x: f64, mre: f64, mim: f64, n_max, n_start) {
    if (_bj_log_on(4) == 0) { return 0; }
    var lb[240];
    var lt[24];
    _bj_tx_init(&lt, &lb, 240);
    _bj_tx_cstr(&lt, "computing Mie scattering x=");
    _bj_fmt_f64_debug(&lt, x);
    _bj_tx_cstr(&lt, " m_re=");
    _bj_fmt_f64_debug(&lt, mre);
    _bj_tx_cstr(&lt, " m_im=");
    _bj_fmt_f64_debug(&lt, mim);
    _bj_tx_cstr(&lt, " n_max=");
    _bj_tx_u64(&lt, n_max);
    _bj_tx_cstr(&lt, " n_start=");
    _bj_tx_u64(&lt, n_start);
    _bj_log_text(4, &lt);
    return 0;
}

# Logs the result at debug, as Rust's `tracing::debug!(q_ext, q_sca, g, "Mie scattering computed")`.
fn _bj_sc_log_done(q_ext: f64, q_sca: f64, g: f64) {
    if (_bj_log_on(4) == 0) { return 0; }
    var lb[200];
    var lt[24];
    _bj_tx_init(&lt, &lb, 200);
    _bj_tx_cstr(&lt, "Mie scattering computed q_ext=");
    _bj_fmt_f64_debug(&lt, q_ext);
    _bj_tx_cstr(&lt, " q_sca=");
    _bj_fmt_f64_debug(&lt, q_sca);
    _bj_tx_cstr(&lt, " g=");
    _bj_fmt_f64_debug(&lt, g);
    _bj_log_text(4, &lt);
    return 0;
}

# Gives back the three buffers of a Mie computation that failed (each 0 or from fl_alloc).
fn _bj_sc_drop(d, a, b) {
    if (d != 0) { fl_free(d); }
    if (a != 0) { fl_free(a); }
    if (b != 0) { fl_free(b); }
    return 0;
}

# Mie scattering by a homogeneous sphere of size parameter x and relative index m, into *out: Ok(0), or Err with
# the reason recorded and out untouched. Q_sca = (2/x²) Σ (2n+1)(|aₙ|² + |bₙ|²), Q_ext = (2/x²) Σ (2n+1) Re(aₙ + bₙ),
# Q_abs = Q_ext − Q_sca, g = 2 Σ[..]/Σ(2n+1)(|aₙ|² + |bₙ|²) (0 when nothing scatters). out gets n_max new coefficients
# of each kind; bj_mie never reads it, so free a previous result first (BjMieResult_free).
# - x finite, 0 < x ≤ BJ_MIE_MAX_SIZE_PARAMETER; m finite, nonzero, Im(m) ≤ 0 (e^{+jωt}: absorbing m = n − jκ),
#   |m|·x ≤ BJ_MIE_MAX_MX; else InvalidParameter;
# - InvalidParameter also when the series over- or underflows (only for vanishingly small x or m), DivisionByZero
#   when mx underflows to zero, Allocation when a buffer can't be had.
# Mirrors `scattering::mie`.
#must_use
public fn bj_mie(x: f64, m: BjComplex, out: *BjMieResult): Result {
    var mre: f64 = m.re;
    var mim: f64 = m.im;
    var h: f64 = 0.0;
    if (_bj_is_finite(mre) == 1 && _bj_is_finite(mim) == 1) { h = _bj_hypot(mre, mim); }
    var mx_abs: f64 = h * x;
    var c = _bj_sc_mie_check(x, m, mx_abs);
    if (c != 0) { return Err(c); }
    var n_max, n_start = _bj_sc_terms(x, mx_abs);
    _bj_sc_log_start(x, mre, mim, n_max, n_start);
    var d = fl_alloc((n_max + 1) * 16);
    var a = fl_alloc(n_max * 16);
    var b = fl_alloc(n_max * 16);
    if (d == 0 || a == 0 || b == 0) {
        _bj_sc_drop(d, a, b);
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "Mie coefficient buffers");
        return Err(BJ_ERR_ALLOCATION);
    }
    # Dₙ(0) is never read, but its slot is defined.
    var d0: *f64 = _bj_sc_f64p(d);
    d0[0] = 0.0;
    d0[1] = 0.0;
    var mxr: f64 = mre * x;
    var mxi: f64 = mim * x;
    var imx: f64[2];
    c = _bj_sc_recip(mxr, mxi, &imx);
    if (c == 0) { c = _bj_sc_lderiv(imx[0], imx[1], n_max, n_start, d); }
    var mv: f64[2];
    mv[0] = mre;
    mv[1] = mim;
    var sums: f64[3];
    if (c == 0) { c = _bj_sc_series(x, &mv, d, n_max, a, b, &sums); }
    fl_free(d);
    if (c != 0) {
        _bj_sc_drop(0, a, b);
        return Err(c);
    }
    var sca: f64 = sums[0];
    var ext: f64 = sums[1];
    var gs: f64 = sums[2];
    var scale: f64 = 2.0 / (x * x);
    var q_sca: f64 = scale * sca;
    var q_ext: f64 = scale * ext;
    var q_abs: f64 = q_ext - q_sca;
    var g: f64 = 0.0;
    if (sca > 0.0) { g = 2.0 * gs / sca; }
    if (_bj_is_finite(q_sca) == 0 || _bj_is_finite(q_ext) == 0 || _bj_is_finite(g) == 0) {
        _bj_sc_drop(0, a, b);
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "Mie series over/underflowed for x = ");
        _bj_fmt_f64_display(t, x);
        _bj_tx_cstr(t, ", m = ");
        m.display(t);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    _bj_sc_log_done(q_ext, q_sca, g);
    out.q_sca = q_sca;
    out.q_ext = q_ext;
    out.q_abs = q_abs;
    out.g = g;
    out.a = a;
    out.a_len = n_max;
    out.b = b;
    out.b_len = n_max;
    return Ok(0);
}

# σ = Q·π·r², a cross-section from its efficiency, rounded once for finite Q and r (ADR 0002 row 13, M3 part 2b: Rust's
# Q·π, then ·r twice, rounded three times and overflowed at Q = 1e308, r = 0.1 for 3.1e306); a non-finite operand keeps
# Rust's chain. Mirrors `scattering::cross_section_from_efficiency`.
#must_use
#pure
public fn bj_cross_section_from_efficiency(q: f64, radius: f64): f64 {
    var dq: f64 = (q - q) + (radius - radius);
    if (dq == 0.0) {
        var cr: f64 = _bj_cr_mul5(q, _BJ_PI, radius, radius, 1.0);
        return cr;
    }
    var s: f64 = q * _BJ_PI * radius * radius;
    return s;
}

# ── Rayleigh ────────────────────────────────────────────────────────────────────────────────────────────────────

# |K|², K = (m² − 1)/(m² + 2), with BjComplex's m·m and |K|² (row 14 at a range edge) and scattering.rs's Smith
# division into k2[0]. 0, or the DivisionByZero code recorded (m² = −2).
fn _bj_sc_k2(m: BjComplex, k2: *f64): i64 {
    var m2: BjComplex = BjComplex_mul(m, m);
    var nr: f64 = m2.re - 1.0;
    var ni: f64 = m2.im - 0.0;
    var dr: f64 = m2.re + 2.0;
    var di: f64 = m2.im + 0.0;
    if (dr == 0.0 && di == 0.0) { return _bj_sc_dz(); }
    var kr, ki = _bj_sc_div(nr, ni, dr, di);
    var k: BjComplex = BjComplex_new(kr, ki);
    var s: f64 = k.norm_sq();
    k2[0] = s;
    return 0;
}

# Records InvalidParameter "<name> must be positive and finite, got {v}" when v isn't finite and positive: its code,
# else 0.
fn _bj_sc_positive(name, v: f64): i64 {
    if (_bj_is_finite(v) == 1 && v > 0.0) { return 0; }
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, name);
    _bj_tx_cstr(t, " must be positive and finite, got ");
    _bj_fmt_f64_display(t, v);
    return BJ_ERR_INVALID_PARAMETER;
}

# σ = (8π/3)(2πr/λ)⁴ r² |K|², K = (m² − 1)/(m² + 2), for a sphere with x = 2πr/λ ≪ 1. |K|² is convention-free.
# InvalidParameter for a radius or wavelength not finite and positive. Mirrors `scattering::rayleigh_cross_section`.
#must_use
public fn bj_rayleigh_cross_section(radius: f64, wavelength: f64, m: BjComplex): Result {
    var c = _bj_sc_positive("radius", radius);
    if (c == 0) { c = _bj_sc_positive("wavelength", wavelength); }
    if (c != 0) { return Err(c); }
    var x: f64 = 2.0 * _BJ_PI * radius / wavelength;
    var k: f64[1];
    c = _bj_sc_k2(m, &k);
    if (c != 0) { return Err(c); }
    var k2: f64 = k[0];
    var x4: f64 = x * x * x * x;
    var s: f64 = 8.0 / 3.0 * _BJ_PI * radius * radius * x4 * k2;
    return Ok(s);
}

# Q_sca = σ/(πr²) = (8/3)x⁴|K|². InvalidParameter for an x not finite and positive. Mirrors
# `scattering::rayleigh_efficiency`.
#must_use
public fn bj_rayleigh_efficiency(x: f64, m: BjComplex): Result {
    var c = _bj_sc_positive("size parameter", x);
    if (c != 0) { return Err(c); }
    var k: f64[1];
    c = _bj_sc_k2(m, &k);
    if (c != 0) { return Err(c); }
    var k2: f64 = k[0];
    var q: f64 = 8.0 / 3.0 * x * x * x * x * k2;
    return Ok(q);
}

# P(θ) = (3/4)(1 + cos²θ), normalized to 4π over the sphere. Mirrors `scattering::rayleigh_phase_function`.
#must_use
#pure
#inline
public fn bj_rayleigh_phase_function(cos_theta: f64): f64 {
    return 0.75 * (1.0 + cos_theta * cos_theta);
}

# I/I₀ = (σ/r²)·P(θ)/(4π) = 3σ(1 + cos²θ)/(16πr²) at distance r for unpolarized light; σ the total cross-section (m²),
# for instance from bj_rayleigh_cross_section. InvalidParameter for a NaN distance, Singularity when |r| < 1e-30.
# Mirrors `scattering::rayleigh_angular_intensity`.
#must_use
public fn bj_rayleigh_angular_intensity(cross_section: f64, distance: f64, cos_theta: f64): Result {
    if (distance != distance) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_INVALID_PARAMETER), "distance must not be NaN");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var ad: f64 = f64_abs(distance);
    if (ad < 0.000000000000000000000000000001) { return Err(_bj_err_singularity()); }
    var p: f64 = bj_rayleigh_phase_function(cos_theta);
    var four_pi: f64 = 4.0 * _BJ_PI;
    var r: f64 = cross_section / (distance * distance) * p / four_pi;
    return Ok(r);
}

# --- beam.cyr ---

# beam.cyr — beam.rs (M3 part 1c-1): Gaussian beams, ABCD ray transfer matrices, resonator stability, and the
# higher-order Hermite–Gaussian and Laguerre–Gaussian modes. SI units: wavelengths and distances in metres.
#
# - BjGaussianBeam.wavelength is the wavelength in the medium the beam propagates in (λ₀/n). The complex beam
#   parameter is q = (z − z_waist) + j·z_R with z_R = πw₀²/λ.
# - ABCD matrices act on (height, actual ray angle), so a system that ends in another medium has det = n_in/n_out,
#   and its output wavelength is λ_out = λ_in·det.
# - The time convention is bijli's one, e^{+jωt} (src/complex.cyr's header; ADR 0002 row 5, D3): a mode field is
#   ∝ e^{−jkz}, as Siegman's *Lasers* writes it. beam.rs wrote the complex field in e^{−iωt}, so
#   bj_hermite_gaussian_field is its complex conjugate. Every other value here is real or convention-free: q = z + j·z_R
#   is already Siegman's form (1/q = 1/R − jλ/(πw²)), so q, its ABCD propagation and the transformed beams keep Rust's
#   numbers, and the Gouy phase ζ(z) = arctan(z/z_R) is a geometric angle.
#
# The resonators decide their stability exactly and compute w₀ without cancellation (ADR 0002 row 34, M3 part 2a-2,
# the user's answer of 2026-11-14): 0 ≤ (1 − L/R₁)(1 − L/R₂) ≤ 1 on the exact value, and w₀ from the inputs' own
# differences and sums, where Rust's g = 1 − L/R rounded L/R's digits away near the planar edge.
#
# Mode indices are Rust's: m, n and p are u32 (0 ≤ m < 2³²) and l is an i32. The polynomials are their recurrences
# in Rust's order; exp and atan are correctly rounded (src/crmath.cyr), and so are acos and sqrt.

private

# std::f64::consts::SQRT_2.
var _BJ_BEAM_SQRT_2: f64 = 0x3FF6A09E667F3BCD;

# ── the Gaussian beam ───────────────────────────────────────────────────────────────────────────────────────────

# A fundamental Gaussian beam at a reference plane: its wavelength λ in the medium (m), its waist radius w₀ (the 1/e²
# intensity radius at the focus, m) and its Rayleigh range z_R = πw₀²/λ (m). Mirrors `GaussianBeam`.
public struct BjGaussianBeam {
    wavelength: f64;
    waist: f64;
    rayleigh_range: f64;
}

# Records InvalidParameter "<head>{v}<tail>", v in Rust's Display form. Returns the code.
fn _bj_beam_bad(head, v: f64, tail): i64 {
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, head);
    _bj_fmt_f64_display(t, v);
    _bj_tx_cstr(t, tail);
    return BJ_ERR_INVALID_PARAMETER;
}

# 1 when x is finite and positive.
#must_use
fn _bj_beam_pos(x: f64): i64 {
    if (_bj_is_finite(x) == 1 && x > 0.0) { return 1; }
    return 0;
}

# A Gaussian beam of wavelength λ (in the medium) and waist w₀ into *out: Ok(0), or Err(InvalidParameter) with out
# untouched unless both are positive and finite and z_R = πw₀²/λ is positive and finite. z_R is rounded once (ADR 0002
# row 13, M3 part 2b): Rust's three roundings overflowed at λ = 1e10, w₀ = 1e155 for 3e300, and underflowed at
# λ = 5e-324, w₀ = 1e-162 to 1.0 for 0.63. Mirrors `GaussianBeam::new`.
#must_use
public fn BjGaussianBeam_new(wavelength: f64, waist: f64, out: *BjGaussianBeam): Result {
    if (_bj_beam_pos(wavelength) == 0) {
        return Err(_bj_beam_bad("wavelength must be positive and finite, got ", wavelength, ""));
    }
    if (_bj_beam_pos(waist) == 0) {
        return Err(_bj_beam_bad("beam waist must be positive and finite, got ", waist, ""));
    }
    var zn: f64[3];
    var zd: f64[1];
    zn[0] = _BJ_PI;
    zn[1] = waist;
    zn[2] = waist;
    zd[0] = wavelength;
    var zr: f64 = _bj_cr_mono_wide(&zn, 3, &zd, 1);
    if (_bj_beam_pos(zr) == 0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "Rayleigh range πw₀²/λ = ");
        _bj_fmt_f64_display(t, zr);
        _bj_tx_cstr(t, " is not representable (w₀ = ");
        _bj_fmt_f64_display(t, waist);
        _bj_tx_cstr(t, ", λ = ");
        _bj_fmt_f64_display(t, wavelength);
        _bj_tx_cstr(t, ")");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (_bj_log_on(4) == 1) {
        var lb[200];
        var lt[24];
        _bj_tx_init(&lt, &lb, 200);
        _bj_tx_cstr(&lt, "Gaussian beam created wavelength=");
        _bj_fmt_f64_debug(&lt, wavelength);
        _bj_tx_cstr(&lt, " waist=");
        _bj_fmt_f64_debug(&lt, waist);
        _bj_tx_cstr(&lt, " rayleigh_range=");
        _bj_fmt_f64_debug(&lt, zr);
        _bj_log_text(4, &lt);
    }
    out.wavelength = wavelength;
    out.waist = waist;
    out.rayleigh_range = zr;
    return Ok(0);
}

impl BjGaussianBeam {
    # The complex beam parameter q(z) = z + j·z_R, z the distance from the waist: (Re q, Im q). Mirrors
    # `GaussianBeam::q`.
    #must_use
    public fn q(self, z: f64): (f64, f64) {
        var zr: f64 = self.rayleigh_range;
        return (z, zr);
    }

    # w(z) = w₀·√(1 + (z/z_R)²), the 1/e² intensity radius at distance z from the waist. Mirrors
    # `GaussianBeam::spot_size`.
    #must_use
    public fn spot_size(self, z: f64): f64 {
        var ratio: f64 = z / self.rayleigh_range;
        var root: f64 = f64_sqrt(1.0 + ratio * ratio);
        var w: f64 = self.waist * root;
        return w;
    }

    # R(z) = z·(1 + (z_R/z)²), the wavefront's radius of curvature; InvalidParameter at the waist (|z| < 1e-30, where
    # R is infinite). Mirrors `GaussianBeam::radius_of_curvature`.
    #must_use
    public fn radius_of_curvature(self, z: f64): Result {
        var az: f64 = f64_abs(z);
        if (az < 0.000000000000000000000000000001) {
            _bj_tx_cstr(_bj_err_reason(BJ_ERR_INVALID_PARAMETER), "radius of curvature is infinite at the beam waist");
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        var ratio: f64 = self.rayleigh_range / z;
        var r: f64 = z * (1.0 + ratio * ratio);
        return Ok(r);
    }

    # ζ(z) = arctan(z/z_R), the Gouy phase at distance z from the waist (a geometric angle, convention-free). Mirrors
    # `GaussianBeam::gouy_phase`.
    #must_use
    public fn gouy_phase(self, z: f64): f64 {
        var a: f64 = _bj_atan(z / self.rayleigh_range);
        return a;
    }

    # θ = λ/(πw₀), the far-field half-angle divergence, rounded once for finite fields and a nonzero waist (ADR 0002
    # row 13; Rust's two roundings otherwise). Mirrors `GaussianBeam::divergence`.
    #must_use
    public fn divergence(self): f64 {
        var lam: f64 = self.wavelength;
        var w0: f64 = self.waist;
        var dl: f64 = (lam - lam) + (w0 - w0);
        if (dl == 0.0 && w0 != 0.0) {
            var dn: f64[1];
            var dd: f64[2];
            dn[0] = lam;
            dd[0] = _BJ_PI;
            dd[1] = w0;
            var cr: f64 = _bj_cr_mono_wide(&dn, 1, &dd, 2);
            return cr;
        }
        var d: f64 = lam / (_BJ_PI * w0);
        return d;
    }

    # 2/(πw(z)²), the factor that multiplies the total power P to give the peak intensity I₀ = 2P/(πw²). Mirrors
    # `GaussianBeam::peak_intensity_factor`.
    #must_use
    public fn peak_intensity_factor(self, z: f64): f64 {
        var w: f64 = self.spot_size(z);
        var f: f64 = 2.0 / (_BJ_PI * w * w);
        return f;
    }

    # b = 2z_R, the confocal parameter. Mirrors `GaussianBeam::confocal_parameter`.
    #must_use
    public fn confocal_parameter(self): f64 {
        var b: f64 = 2.0 * self.rayleigh_range;
        return b;
    }

    # 2z_R, the depth of focus (where the spot grows by √2). Mirrors `GaussianBeam::depth_of_focus`.
    #must_use
    public fn depth_of_focus(self): f64 {
        var d: f64 = 2.0 * self.rayleigh_range;
        return d;
    }
}

# ── ABCD matrices ───────────────────────────────────────────────────────────────────────────────────────────────

# ── the exact determinant (ADR 0002 row 35, M3 part 2a-3) ──
# transform_beam decides det > 0 and det = 1 on the exact AD − BC of finite entries, and takes λ·det rounded once from
# it, where Rust tested the rounded AD − BC and kept λ within 10⁻¹² of 1. The products are integers (each a product of
# two significands, at most 106 bits, times a power of two) in src/fmtf.cyr's bignums (word 0 the limb count, then
# 32-bit limbs; 41 words, 1,280 bits). A product more than 220 bits below the other only decides roundings as a sticky
# bit, so it becomes a unit 230 bits below the other: every shift stays under 330 bits and every value under 2^500.

# |x₁·x₂| as a bignum into dst, for finite x₁, x₂ (t scratch): (its exponent, its sign −1, 0 or 1).
fn _bj_beam_prod(x1: f64, x2: f64, dst, t): (i64, i64) {
    if (x1 == 0.0 || x2 == 0.0) {
        store64(dst, 0);
        return (0, 0);
    }
    var me1: i64[2];
    var me2: i64[2];
    _bj_g_split(x1, &me1);
    _bj_g_split(x2, &me2);
    _bj_bn_set(dst, me1[0]);
    _bj_g_mul(dst, me2[0], t);
    var s = 1;
    if (x1 < 0.0) { s = 0 - s; }
    if (x2 < 0.0) { s = 0 - s; }
    return (me1[1] + me2[1], s);
}

# 1 when x is 0 or 2^-450 ≤ |x| ≤ 2^450 (TwoProduct is exact on two such, and their product is 0 or at least 2^-900).
#must_use
fn _bj_beam_mid(x: f64): i64 {
    var u = _bj_bits(x) & 0x7FFFFFFFFFFFFFFF;
    if (u == 0) { return 1; }
    if (u < 0x23D0000000000000 || u > 0x5C10000000000000) { return 0; }
    return 1;
}

# _bj_beam_det35's fast path, for entries 0 or of magnitude in [2^-450, 2^450]: AD − BC as Shewchuk's exact expansion
# of p₁ + e₁ − p₂ − e₂ (TwoProduct; crmath_gamma's _bj_g_grow), whose sign is its largest component's and which is 1
# when it less 1 is empty. λ·det from the compressed top two components (within 2^-104) times |λ| (_bj_k_dd_mul_d,
# 3.01u²): kimiya's rounding test (_bj_k_dd_round_ends, a 32u² budget) proves the correctly rounded value. The same
# results as the exact path, which takes over (2, 0) where this declines: an entry outside the range, |λ·det| outside
# [2^-900, 2^900], or a value within about 2^-100 of a midpoint.
#must_use
fn _bj_beam_det35_fast(a: f64, b: f64, c: f64, d: f64, lam: f64, out: *f64): (i64, i64) {
    if (_bj_beam_mid(a) == 0 || _bj_beam_mid(b) == 0 || _bj_beam_mid(c) == 0 || _bj_beam_mid(d) == 0) {
        return (2, 0);
    }
    var p1, e1 = _bj_cr_two_prod(a, d);
    var p2, e2 = _bj_cr_two_prod(b, c);
    var p1v: f64 = p1;
    var e1v: f64 = e1;
    var np2: f64 = -p2;
    var ne2: f64 = -e2;
    var ex: f64[8];
    var k = _bj_g_grow(&ex, 0, e1v);
    k = _bj_g_grow(&ex, k, ne2);
    k = _bj_g_grow(&ex, k, p1v);
    k = _bj_g_grow(&ex, k, np2);
    if (k == 0) { return (0, 0); }
    var top: f64 = ex[k - 1];
    if (top < 0.0) { return (0 - 1, 0); }
    var ey: f64[8];
    for (var j = 0; j < k; j = j + 1) { ey[j] = ex[j]; }
    if (_bj_g_grow(&ey, k, -1.0) == 0) { return (1, 1); }
    var dl: f64 = lam - lam;
    if (lam == 0.0 || dl != 0.0) { return (1, 0); }
    var al: f64 = f64_abs(lam);
    var dh, dlo = _bj_g_compress(&ex, k);
    var dhv: f64 = dh;
    var pp: f64 = dhv * al;
    var pu = _bj_bits(pp) & 0x7FFFFFFFFFFFFFFF;
    if (_bj_beam_mid(al) == 0 || pu < 0x07B0000000000000 || pu > 0x7830000000000000) { return (2, 0); }
    var h, l = _bj_k_dd_mul_d(dhv, dlo, al);
    var z1, z2 = _bj_k_dd_round_ends(h, l);
    var z1v: f64 = z1;
    var z2v: f64 = z2;
    if (z1v != z2v) { return (2, 0); }
    if (lam < 0.0) { z1v = -z1v; }
    out[0] = z1v;
    return (1, 0);
}

# The exact AD − BC of finite a, b, c, d: (its sign −1, 0 or 1; 1 when it is exactly 1), and, when it is positive and
# not 1, RN(λ·(AD − BC)) into out[0] for a finite nonzero λ: λ's significand times the determinant, its top 60 bits
# and a sticky bit for the rest, rounded once by kimiya's _bj_k_cr_from_int (the subnormal grid, ties to even, +∞
# past DBL_MAX). out is untouched otherwise. The fast path (_bj_beam_det35_fast) answers first where it can.
#must_use
fn _bj_beam_det35(a: f64, b: f64, c: f64, d: f64, lam: f64, out: *f64): (i64, i64) {
    var fs, fo = _bj_beam_det35_fast(a, b, c, d, lam, out);
    if (fs != 2) { return (fs, fo); }
    var xb: i64[41];
    var yb: i64[41];
    var tb: i64[41];
    var vb: i64[41];
    var ex, sx = _bj_beam_prod(a, d, &xb, &tb);
    var ey, sy = _bj_beam_prod(b, c, &yb, &tb);
    if (sx != 0 && sy != 0) {
        var tx = ex + _bj_g_bitlen(&xb);
        var ty = ey + _bj_g_bitlen(&yb);
        if (tx - ty > 220) {
            _bj_bn_set(&yb, 1);
            ey = tx - 230;
        } elif (ty - tx > 220) {
            _bj_bn_set(&xb, 1);
            ex = ty - 230;
        }
    }
    if (sx == 0 && sy == 0) { return (0, 0); }
    var k = ex;
    if (sx == 0 || (sy != 0 && ey < ex)) { k = ey; }
    if (sx != 0) { _bj_bn_shl(&xb, ex - k); }
    if (sy != 0) { _bj_bn_shl(&yb, ey - k); }
    var sgn = 0;
    if (sy == 0) {
        _bj_bn_copy(&vb, &xb);
        sgn = sx;
    } elif (sx == 0) {
        _bj_bn_copy(&vb, &yb);
        sgn = 0 - sy;
    } elif (sx != sy) {
        _bj_bn_sum(&vb, &xb, &yb);
        sgn = sx;
    } else {
        var cm = _bj_bn_cmp(&xb, &yb);
        if (cm == 0) { return (0, 0); }
        if (cm > 0) {
            _bj_bn_copy(&vb, &xb);
            _bj_bn_sub(&vb, &yb);
            sgn = sx;
        } else {
            _bj_bn_copy(&vb, &yb);
            _bj_bn_sub(&vb, &xb);
            sgn = 0 - sx;
        }
    }
    if (sgn < 0) { return (0 - 1, 0); }
    var nb = _bj_g_bitlen(&vb);
    if (k <= 0 && nb == 1 - k && _bj_bn_any_below(&vb, 0 - k) == 0) { return (1, 1); }
    var dl: f64 = lam - lam;
    if (lam == 0.0 || dl != 0.0) { return (1, 0); }
    var mel: i64[2];
    _bj_g_split(lam, &mel);
    _bj_g_mul(&vb, mel[0], &tb);
    var e2 = k + mel[1];
    var n = _bj_g_bitlen(&vb);
    var mm = _bj_g_limb(&vb, 0) | (_bj_g_limb(&vb, 1) << 32);
    var s = e2;
    if (n > 61) {
        var sh = n - 60;
        _bj_bn_copy(&tb, &vb);
        _bj_bn_shr(&tb, sh);
        var top = _bj_g_limb(&tb, 0) | (_bj_g_limb(&tb, 1) << 32);
        mm = 2 * top + _bj_bn_any_below(&vb, sh);
        s = e2 + sh - 1;
    }
    var r: f64 = _bj_k_cr_from_int(mm, s);
    if (lam < 0.0) { r = -r; }
    out[0] = r;
    return (1, 0);
}

# A paraxial ray transfer matrix acting on (y, θ): y' = A·y + B·θ, θ' = C·y + D·θ. Mirrors `AbcdMatrix`.
public struct BjAbcdMatrix {
    a: f64;
    b: f64;
    c: f64;
    d: f64;
}

# The matrix (A, B; C, D). Mirrors `AbcdMatrix::new`.
#must_use
#pure
public fn BjAbcdMatrix_new(a: f64, b: f64, c: f64, d: f64): BjAbcdMatrix {
    var m: BjAbcdMatrix;
    m.a = a;
    m.b = b;
    m.c = c;
    m.d = d;
    return m;
}

# The identity (no element). Mirrors `AbcdMatrix::identity`.
#must_use
#pure
public fn BjAbcdMatrix_identity(): BjAbcdMatrix {
    var m: BjAbcdMatrix = BjAbcdMatrix_new(1.0, 0.0, 0.0, 1.0);
    return m;
}

# The identity. Mirrors `Default for AbcdMatrix`.
#must_use
#pure
public fn BjAbcdMatrix_default(): BjAbcdMatrix {
    var m: BjAbcdMatrix = BjAbcdMatrix_new(1.0, 0.0, 0.0, 1.0);
    return m;
}

# Free space of length d: (1, d; 0, 1). Mirrors `AbcdMatrix::free_space`.
#must_use
#pure
public fn BjAbcdMatrix_free_space(distance: f64): BjAbcdMatrix {
    var m: BjAbcdMatrix = BjAbcdMatrix_new(1.0, distance, 0.0, 1.0);
    return m;
}

# Records DivisionByZero with Rust's context. Returns the code.
fn _bj_beam_dz(context): i64 {
    return _bj_err_division_by_zero(context);
}

# A thin lens of focal length f (positive converging, negative diverging) into *out: (1, 0; −1/f, 1).
# InvalidParameter for a NaN f, DivisionByZero when |f| < 1e-30. Mirrors `AbcdMatrix::thin_lens`.
#must_use
public fn BjAbcdMatrix_thin_lens(focal_length: f64, out: *BjAbcdMatrix): Result {
    if (focal_length != focal_length) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_INVALID_PARAMETER), "focal length must not be NaN");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var af: f64 = f64_abs(focal_length);
    if (af < 0.000000000000000000000000000001) { return Err(_bj_beam_dz("focal length cannot be zero")); }
    var c: f64 = -1.0 / focal_length;
    out.a = 1.0;
    out.b = 0.0;
    out.c = c;
    out.d = 1.0;
    return Ok(0);
}

# A curved mirror of radius R (concave R > 0 focuses), a thin lens of f = R/2, into *out: (1, 0; −2/R, 1).
# InvalidParameter for a NaN R, DivisionByZero when |R| < 1e-30. Mirrors `AbcdMatrix::curved_mirror`.
#must_use
public fn BjAbcdMatrix_curved_mirror(radius: f64, out: *BjAbcdMatrix): Result {
    if (radius != radius) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_INVALID_PARAMETER), "mirror radius must not be NaN");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var ar: f64 = f64_abs(radius);
    if (ar < 0.000000000000000000000000000001) { return Err(_bj_beam_dz("mirror radius cannot be zero")); }
    var c: f64 = -2.0 / radius;
    out.a = 1.0;
    out.b = 0.0;
    out.c = c;
    out.d = 1.0;
    return Ok(0);
}

# A flat interface from index n₁ to n₂ into *out: (1, 0; 0, n₁/n₂). InvalidParameter for a NaN index,
# DivisionByZero when |n₂| < 1e-30. Mirrors `AbcdMatrix::flat_interface`.
#must_use
public fn BjAbcdMatrix_flat_interface(n1: f64, n2: f64, out: *BjAbcdMatrix): Result {
    if (n1 != n1 || n2 != n2) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_INVALID_PARAMETER), "refractive indices must not be NaN");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var a2: f64 = f64_abs(n2);
    if (a2 < 0.000000000000000000000000000001) { return Err(_bj_beam_dz("refractive index n₂ cannot be zero")); }
    var d: f64 = n1 / n2;
    out.a = 1.0;
    out.b = 0.0;
    out.c = 0.0;
    out.d = d;
    return Ok(0);
}

# A curved interface of radius R (R > 0 with the centre of curvature on the transmission side) from n₁ to n₂ into
# *out: (1, 0; (n₁ − n₂)/(n₂R), n₁/n₂). InvalidParameter for a NaN input, DivisionByZero when |n₂| < 1e-30 or
# |R| < 1e-30. Mirrors `AbcdMatrix::curved_interface`.
#must_use
public fn BjAbcdMatrix_curved_interface(n1: f64, n2: f64, radius: f64, out: *BjAbcdMatrix): Result {
    if (n1 != n1 || n2 != n2 || radius != radius) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_INVALID_PARAMETER), "refractive indices and radius must not be NaN");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var a2: f64 = f64_abs(n2);
    if (a2 < 0.000000000000000000000000000001) { return Err(_bj_beam_dz("refractive index n₂ cannot be zero")); }
    var ar: f64 = f64_abs(radius);
    if (ar < 0.000000000000000000000000000001) { return Err(_bj_beam_dz("interface radius cannot be zero")); }
    var c: f64 = (n1 - n2) / (n2 * radius);
    var d: f64 = n1 / n2;
    out.a = 1.0;
    out.b = 0.0;
    out.c = c;
    out.d = d;
    return Ok(0);
}

impl BjAbcdMatrix {
    # (A·y + B·θ, C·y + D·θ), the ray (y, θ) after this element. Mirrors `AbcdMatrix::apply_ray`.
    #must_use
    public fn apply_ray(self, y: f64, theta: f64): (f64, f64) {
        var y2: f64 = self.a * y + self.b * theta;
        var t2: f64 = self.c * y + self.d * theta;
        return (y2, t2);
    }

    # self × other: other first, then self. Mirrors `AbcdMatrix::compose`.
    #must_use
    public fn compose(self, other: *BjAbcdMatrix): BjAbcdMatrix {
        var m: BjAbcdMatrix;
        m.a = self.a * other.a + self.b * other.c;
        m.b = self.a * other.b + self.b * other.d;
        m.c = self.c * other.a + self.d * other.c;
        m.d = self.c * other.b + self.d * other.d;
        return m;
    }

    # AD − BC: 1 in one medium, n₁/n₂ across media. Mirrors `AbcdMatrix::determinant`.
    #must_use
    public fn determinant(self): f64 {
        var det: f64 = self.a * self.d - self.b * self.c;
        return det;
    }

    # q_out = (A·q + B)/(C·q + D) for q = q_re + j·q_im into out[0], out[1]: Ok(0), or DivisionByZero when
    # |C·q + D|² < 1e-60 (a NaN passes, as Rust's test). Mirrors `AbcdMatrix::propagate_beam`.
    #must_use
    public fn propagate_beam(self, q_re: f64, q_im: f64, out: *f64): Result {
        var num_re: f64 = self.a * q_re + self.b;
        var num_im: f64 = self.a * q_im;
        var den_re: f64 = self.c * q_re + self.d;
        var den_im: f64 = self.c * q_im;
        var den_sq: f64 = den_re * den_re + den_im * den_im;
        if (den_sq < 0.000000000000000000000000000000000000000000000000000000000001) {
            return Err(_bj_beam_dz("ABCD beam propagation denominator is zero"));
        }
        var r0: f64 = (num_re * den_re + num_im * den_im) / den_sq;
        var r1: f64 = (num_im * den_re - num_re * den_im) / den_sq;
        out[0] = r0;
        out[1] = r1;
        return Ok(0);
    }

    # The output beam into *out, and the signed distance from the output plane to its waist into *distance, for an
    # input beam whose waist lies at the input plane. q_out = (A·j z_R + B)/(C·j z_R + D); z_R′ = Im q_out;
    # λ′ = λ·det rounded once from the exact AD − BC (λ kept only when it is exactly 1; a zero, infinite or NaN λ as it
    # is), w₀′ = √(z_R′λ′/π); distance = −Re q_out (positive downstream: a converging beam). InvalidParameter when the
    # exact det of finite entries isn't positive (Rust's rounded det isn't positive and finite, for another), the
    # reason quoting the rounded det, or when z_R′ isn't positive and finite; DivisionByZero when C·q + D = 0; and
    # BjGaussianBeam_new's errors. out and distance are untouched by an error. ADR 0002 row 35: Rust tested the rounded
    # det and kept λ within 10⁻¹² of 1. Mirrors `AbcdMatrix::transform_beam_with_waist_position`.
    #must_use
    public fn transform_beam_with_waist_position(self, beam: *BjGaussianBeam, out: *BjGaussianBeam,
      distance: *f64): Result {
        var det: f64 = self.determinant();
        var pos = _bj_beam_pos(det);
        var exact = _bj_vx_finite4(self.a, self.b, self.c, self.d);
        var lx: f64[1];
        lx[0] = beam.wavelength;
        var one = 0;
        if (exact == 1) {
            var dsg, dn = _bj_beam_det35(self.a, self.b, self.c, self.d, beam.wavelength, &lx);
            pos = 0;
            if (dsg > 0) { pos = 1; }
            one = dn;
        }
        if (pos == 0) {
            return Err(_bj_beam_bad("ABCD determinant must be positive and finite (det = n_in/n_out), got ", det, ""));
        }
        var qo: f64[2];
        var zr: f64 = beam.rayleigh_range;
        var t, v = self.propagate_beam(0.0, zr, &qo);
        if (is_err_result(t) == 1) { return Err(v); }
        var zr2: f64 = qo[1];
        if (_bj_beam_pos(zr2) == 0) {
            _bj_tx_cstr(_bj_err_reason(BJ_ERR_INVALID_PARAMETER), "transformed beam has non-physical Rayleigh range");
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        var lam: f64 = beam.wavelength;
        if (exact == 1) {
            if (one == 0) { lam = lx[0]; }
        } else {
            var dd: f64 = f64_abs(det - 1.0);
            if (dd > 0.000000000001) { lam = beam.wavelength * det; }
        }
        var w0: f64 = f64_sqrt(zr2 * lam / _BJ_PI);
        var nb: BjGaussianBeam;
        var t2, v2 = BjGaussianBeam_new(lam, w0, &nb);
        if (is_err_result(t2) == 1) { return Err(v2); }
        var d: f64 = -qo[0];
        out.wavelength = nb.wavelength;
        out.waist = nb.waist;
        out.rayleigh_range = nb.rayleigh_range;
        distance[0] = d;
        return Ok(0);
    }

    # The output beam into *out for an input beam whose waist lies at the input plane, as
    # transform_beam_with_waist_position without the waist's position. Mirrors `AbcdMatrix::transform_beam`.
    #must_use
    public fn transform_beam(self, beam: *BjGaussianBeam, out: *BjGaussianBeam): Result {
        var d: f64[1];
        var t, v = self.transform_beam_with_waist_position(beam, out, &d);
        if (is_err_result(t) == 1) { return Err(v); }
        return Ok(0);
    }
}

# ── resonators ──────────────────────────────────────────────────────────────────────────────────────────────────

# A two-mirror cavity's stability: g₁ = 1 − L/R₁, g₂ = 1 − L/R₂, their product, and whether 0 ≤ g₁g₂ ≤ 1 (1 stable,
# 0 not). Mirrors `ResonatorStability`.
public struct BjResonatorStability {
    g1: f64;
    g2: f64;
    g_product: f64;
    is_stable;
}

# ── the exact edges (ADR 0002 row 34) ──

# 1 when 0 ≤ (1 − L/R₁)(1 − L/R₂) ≤ 1 in exact value, else 0, for a positive finite L and radii neither NaN nor below
# 1e-30 in magnitude (±∞ is a flat mirror, L/R = 0). With a = L/R₁, b = L/R₂:
# - the product is ≥ 0 when its factors' signs don't differ: 1 − L/R is positive for a convex (R < 0) or flat mirror
#   and for R > L, 0 at R = L, negative for 0 < R < L;
# - it is ≤ 1 when ab ≤ a + b: always for two flat mirrors, for R > 0 with one, and otherwise L ≤ R₁ + R₂ where
#   R₁R₂ > 0, L ≥ R₁ + R₂ where R₁R₂ < 0 (the inequality times R₁R₂/L). L is compared with s = RN(R₁ + R₂), and at
#   L = s with TwoSum's exact error t: s is the double nearest R₁ + R₂, so a double L other than s lies on the same
#   side of R₁ + R₂ as of s; an s past DBL_MAX is past every finite L.
#must_use
fn _bj_beam_stable34(length: f64, r1: f64, r2: f64): i64 {
    var s1 = 1;
    if (r1 > 0.0 && r1 < length) { s1 = 0 - 1; }
    if (r1 == length) { s1 = 0; }
    var s2 = 1;
    if (r2 > 0.0 && r2 < length) { s2 = 0 - 1; }
    if (r2 == length) { s2 = 0; }
    if (s1 * s2 < 0) { return 0; }
    var d1: f64 = r1 - r1;
    var d2: f64 = r2 - r2;
    if (d1 != 0.0 || d2 != 0.0) {
        if (d1 != 0.0 && d2 != 0.0) { return 1; }
        if (d1 != 0.0 && r2 > 0.0) { return 1; }
        if (d2 != 0.0 && r1 > 0.0) { return 1; }
        return 0;
    }
    var s: f64 = r1 + r2;
    var c = 0;
    if (s - s != 0.0) {
        c = 1;
        if (s > 0.0) { c = 0 - 1; }
    } elif (length < s) { c = 0 - 1; }
    elif (length > s) { c = 1; }
    else {
        var bb: f64 = s - r1;
        var tt: f64 = (r1 - (s - bb)) + (r2 - bb);
        if (tt > 0.0) { c = 0 - 1; }
        if (tt < 0.0) { c = 1; }
    }
    if ((r1 > 0.0 && r2 > 0.0) || (r1 < 0.0 && r2 < 0.0)) {
        if (c <= 0) { return 1; }
        return 0;
    }
    if (c >= 0) { return 1; }
    return 0;
}

# 1 when 0 ≤ g₁·g₂ ≤ 1 in exact value, else 0, for finite g₁, g₂ with gp = RN(g₁·g₂): the sign from the factors' (a
# product that underflows keeps it), then gp's side of 1 (gp is the double nearest the product, and 1 is a double),
# but at gp = 1, where the exact sign of g₁g₂ − 1 decides (src/crmath_cmp.cyr's _bj_x_sign).
#must_use
fn _bj_beam_gg_ok(g1: f64, g2: f64, gp: f64): i64 {
    if ((g1 < 0.0 && g2 > 0.0) || (g1 > 0.0 && g2 < 0.0)) { return 0; }
    if (gp > 1.0) { return 0; }
    if (gp < 1.0) { return 1; }
    var tm: i64[14];
    _bj_x_put2(&tm, 0, g1, g2, 0, 0);
    _bj_x_put2(&tm, 1, 1.0, 1.0, 0, 1);
    if (_bj_x_sign(&tm, 2) > 0) { return 0; }
    return 1;
}

# a + b + c, within about an ulp and a half, and the exact sum rounded once where it cancels: s₁ + t₁ = a + b and
# s₂ + t₂ = s₁ + c exactly (TwoSum), then s₂ + (t₁ + t₂). Where s₁ and c cancel, s₁ + c is exact (Sterbenz), so t₂ = 0
# and the result is RN(s₂ + t₁); elsewhere nothing cancels. The callers keep |a| + |b| + |c| below 2^1023.
#must_use
fn _bj_beam_sum3(a: f64, b: f64, c: f64): f64 {
    var s1, t1 = _bj_k_two_sum(a, b);
    var s1v: f64 = s1;
    var t1v: f64 = t1;
    var s2, t2 = _bj_k_two_sum(s1v, c);
    var s2v: f64 = s2;
    var t2v: f64 = t2;
    var tt: f64 = t1v + t2v;
    var r: f64 = s2v + tt;
    return r;
}

# 2^1020: a cavity whose L or finite radius reaches it is scaled by 2^-4 for w₀'s sums.
var _BJ_BEAM_2P1020: f64 = 0x7FB0000000000000;

# w₀ for a stable cavity that is neither planar nor confocal: w₀² = (λ/π)·√(L(R₁ − L)(R₂ − L)(R₁ + R₂ − L))/
# |R₁ + R₂ − 2L| (Kogelnik and Li: g₁g₂(1 − g₁g₂) and g₁ + g₂ − 2g₁g₂ written in the inputs), or (λ/π)·√(L(R − L)) with
# one flat mirror (the limit as the other R → ∞). Each factor is a difference or a compensated sum of the inputs, so
# none cancels; past 2^1020 they are summed scaled by 2^-4 (the form is homogeneous, and the scale comes back exactly
# in the exponent). The products run with an unbounded exponent (kimiya's _bj_k_ux_*, _bj_beam_waist34_ux), and w₀ is
# rounded once: within one ulp of the exact value on every golden row (validate.py's bound is four). The fast path
# runs the same operations on doubles: where every result is normal (kimiya's _bj_k_ux_normal) each is the same
# 53-bit rounding of the same exact value, so the bits are the unbounded chain's, and only an edge takes the slow
# path. (w₀, 1), or (0, 0) where R₁ + R₂ − 2L is 0 (only the confocal and planar cavities, which the caller has taken).
#must_use
fn _bj_beam_waist34(length: f64, r1: f64, r2: f64, wavelength: f64): (f64, i64) {
    var d1: f64 = r1 - r1;
    var d2: f64 = r2 - r2;
    var mx: f64 = length;
    var x1: f64 = f64_abs(r1);
    var x2: f64 = f64_abs(r2);
    if (d1 == 0.0 && x1 > mx) { mx = x1; }
    if (d2 == 0.0 && x2 > mx) { mx = x2; }
    var k = 0;
    var sc: f64 = 1.0;
    if (mx >= _BJ_BEAM_2P1020) {
        k = 4;
        sc = 0.0625;
    }
    var l: f64 = length * sc;
    var a: f64 = r1 * sc;
    var b: f64 = r2 * sc;
    var lp: f64 = wavelength / _BJ_PI;
    if (d1 != 0.0 || d2 != 0.0) {
        var rf: f64 = a;
        if (d1 != 0.0) { rf = b; }
        var fv: f64 = rf - l;
        var fa: f64 = f64_abs(fv);
        var p1: f64 = length * fa;
        var q1: f64 = f64_sqrt(p1);
        var w1: f64 = q1 * lp;
        var okf = 0;
        if (_bj_k_ux_normal(lp) == 1 && _bj_k_ux_normal(p1) == 1) { okf = 1; }
        if (okf == 1 && _bj_k_ux_normal(q1) == 1 && _bj_k_ux_normal(w1) == 1) {
            var r1v: f64 = f64_sqrt(w1);
            if (k == 4) { r1v = 2.0 * r1v; }
            return (r1v, 1);
        }
        var u1: f64 = _bj_beam_waist34_ux(length, fa, 1.0, 1.0, 1.0, wavelength, k, 1);
        return (u1, 1);
    }
    var f1: f64 = a - l;
    var f2: f64 = b - l;
    var nl: f64 = -l;
    var f3: f64 = _bj_beam_sum3(a, b, nl);
    var l2: f64 = 2.0 * l;
    var n2l: f64 = -l2;
    var f4: f64 = _bj_beam_sum3(a, b, n2l);
    if (f4 == 0.0) { return (0.0, 0); }
    var a1: f64 = f64_abs(f1);
    var a2: f64 = f64_abs(f2);
    var a3: f64 = f64_abs(f3);
    var a4: f64 = f64_abs(f4);
    var m1: f64 = length * a1;
    var m2: f64 = m1 * a2;
    var m3: f64 = m2 * a3;
    var rt: f64 = f64_sqrt(m3);
    var nm: f64 = rt * lp;
    var w2: f64 = nm / a4;
    var ok = 0;
    if (_bj_k_ux_normal(lp) == 1 && _bj_k_ux_normal(m1) == 1 && _bj_k_ux_normal(m2) == 1 && _bj_k_ux_normal(m3) == 1) {
        ok = 1;
    }
    if (ok == 1 && _bj_k_ux_normal(rt) == 1 && _bj_k_ux_normal(nm) == 1 && _bj_k_ux_normal(w2) == 1) {
        var r2v: f64 = f64_sqrt(w2);
        if (k == 4) { r2v = 2.0 * r2v; }
        return (r2v, 1);
    }
    var u2: f64 = _bj_beam_waist34_ux(length, a1, a2, a3, a4, wavelength, k, 0);
    return (u2, 1);
}

# _bj_beam_waist34's slow path, its chain with an unbounded exponent for the factors' magnitudes f₁ … f₄ (sums scaled
# by 2^-k): Q = √(L·f₁·f₂·f₃) (flat = 1: √(L·f₁)), W = Q·(λ/π) (/f₄ unless flat), w₀ = √(W·2^(k/2)) rounded once into
# binary64; 0 for a zero factor.
#must_use
fn _bj_beam_waist34_ux(length: f64, f1: f64, f2: f64, f3: f64, f4: f64, wavelength: f64, k, flat): f64 {
    var lms, lme = _bj_k_ux_from(wavelength);
    var pis, pie = _bj_k_ux_from(_BJ_PI);
    var lps, lpe = _bj_k_ux_div(lms, lme, pis, pie);
    var lns, lne = _bj_k_ux_from(length);
    var u1s, u1e = _bj_k_ux_from(f1);
    var ps, pe = _bj_k_ux_mul(lns, lne, u1s, u1e);
    if (flat == 0) {
        var u2s, u2e = _bj_k_ux_from(f2);
        var u3s, u3e = _bj_k_ux_from(f3);
        var m2s, m2e = _bj_k_ux_mul(ps, pe, u2s, u2e);
        var m3s, m3e = _bj_k_ux_mul(m2s, m2e, u3s, u3e);
        ps = m3s;
        pe = m3e;
    }
    var rts, rte = _bj_k_ux_sqrt(ps, pe);
    var ws, we = _bj_k_ux_mul(rts, rte, lps, lpe);
    if (flat == 0) {
        var u4s, u4e = _bj_k_ux_from(f4);
        var qs, qe = _bj_k_ux_div(ws, we, u4s, u4e);
        ws = qs;
        we = qe;
    }
    var wsv: f64 = ws;
    if (wsv == 0.0) { return 0.0; }
    var w0: f64 = _bj_k_ux_sqrt_f64(wsv, we + k / 2);
    return w0;
}

# ── the resonator functions ──

# The stability of a cavity of length L between mirrors of radii R₁ and R₂ (positive concave, ±∞ flat) into *out:
# Ok(0), or with out untouched InvalidParameter for an L not positive and finite or a NaN radius, DivisionByZero when
# |R₁| or |R₂| < 1e-30. g₁, g₂ and g₁g₂ are Rust's rounded values; is_stable is decided on the exact
# (1 − L/R₁)(1 − L/R₂) (ADR 0002 row 34), so it may disagree with g_product's rounding at the edges: two convex
# mirrors are never stable, though their rounded g can be 1. Mirrors `resonator_stability`.
#must_use
public fn bj_resonator_stability(length: f64, r1: f64, r2: f64, out: *BjResonatorStability): Result {
    if (_bj_beam_pos(length) == 0) {
        return Err(_bj_beam_bad("cavity length must be positive and finite, got ", length, ""));
    }
    if (r1 != r1 || r2 != r2) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_INVALID_PARAMETER), "mirror radii must not be NaN");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var a1: f64 = f64_abs(r1);
    var a2: f64 = f64_abs(r2);
    if (a1 < 0.000000000000000000000000000001 || a2 < 0.000000000000000000000000000001) {
        return Err(_bj_beam_dz("mirror radius of curvature cannot be zero"));
    }
    var g1: f64 = 1.0 - length / r1;
    var g2: f64 = 1.0 - length / r2;
    var gp: f64 = g1 * g2;
    var st = _bj_beam_stable34(length, r1, r2);
    out.g1 = g1;
    out.g2 = g2;
    out.g_product = gp;
    out.is_stable = st;
    return Ok(0);
}

# Records InvalidParameter "<head>{gp:.4}<tail>", Rust's four-decimal form of g₁g₂. Returns the code.
fn _bj_beam_unstable(gp: f64, tail): i64 {
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, "cavity is unstable (g₁g₂ = ");
    _bj_fmt_f64_fixed(t, gp, 4);
    _bj_tx_cstr(t, tail);
    return BJ_ERR_INVALID_PARAMETER;
}

# The fundamental mode's waist in a stable cavity, w₀ = √[(Lλ/π)·√(g₁g₂(1 − g₁g₂))/|g₁ + g₂ − 2g₁g₂|] (Siegman, ch. 19),
# computed in the inputs without cancellation (_bj_beam_waist34, ADR 0002 row 34), with the symmetric confocal limit
# w₀ = √(Lλ/2π) at R₁ = R₂ = L, rounded once (ADR 0002 row 13). bj_resonator_stability's errors, then InvalidParameter
# for an unstable cavity (on the exact product; the reason quotes Rust's rounded g₁g₂) or a λ not positive and finite,
# DivisionByZero for the planar cavity (two flat mirrors). A near-planar cavity of finite radii has its finite waist,
# where Rust's g rounded to 1. Mirrors `resonator_beam_waist`.
#must_use
public fn bj_resonator_beam_waist(length: f64, r1: f64, r2: f64, wavelength: f64): Result {
    var st: BjResonatorStability;
    var t, v = bj_resonator_stability(length, r1, r2, &st);
    if (is_err_result(t) == 1) { return Err(v); }
    var gp: f64 = st.g_product;
    if (st.is_stable == 0) { return Err(_bj_beam_unstable(gp, "), no confined mode exists")); }
    if (_bj_beam_pos(wavelength) == 0) {
        return Err(_bj_beam_bad("wavelength must be positive and finite, got ", wavelength, ""));
    }
    if (_bj_is_finite(r1) == 0 && _bj_is_finite(r2) == 0) {
        return Err(_bj_beam_dz("planar cavity (g₁ = g₂ = 1) has no confined mode"));
    }
    if (r1 == length && r2 == length) {
        var cn: f64[2];
        var cd: f64[1];
        cn[0] = length;
        cn[1] = wavelength;
        cd[0] = 2.0 * _BJ_PI;
        var c: f64 = _bj_cr_sqrt_mono(&cn, 2, &cd, 1);
        return Ok(c);
    }
    var w0, ok = _bj_beam_waist34(length, r1, r2, wavelength);
    if (ok == 0) { return Err(_bj_beam_dz("planar cavity (g₁ = g₂ = 1) has no confined mode")); }
    var wv: f64 = w0;
    return Ok(wv);
}

# Δν_T = (Δν_FSR/π)·arccos(±√(g₁g₂)), the frequency step per unit of m + n: + when g₁, g₂ ≥ 0, − when either is
# negative (Siegman, ch. 19), so Δν_T ∈ [0, Δν_FSR]. InvalidParameter for an fsr not positive and finite or an
# unstable (or NaN) g₁g₂, decided on the exact product of finite g's (ADR 0002 row 34; Rust's rounded one otherwise).
# Mirrors `transverse_mode_spacing`.
#must_use
public fn bj_transverse_mode_spacing(fsr: f64, g1: f64, g2: f64): Result {
    if (_bj_beam_pos(fsr) == 0) {
        return Err(_bj_beam_bad("free spectral range must be positive and finite, got ", fsr, ""));
    }
    var gp: f64 = g1 * g2;
    var stable = 0;
    if (gp >= 0.0 && gp <= 1.0) { stable = 1; }
    if (_bj_is_finite(g1) == 1 && _bj_is_finite(g2) == 1) { stable = _bj_beam_gg_ok(g1, g2, gp); }
    if (stable == 0) { return Err(_bj_beam_unstable(gp, ")")); }
    var root: f64 = f64_sqrt(gp);
    var arg: f64 = root;
    if (g1 < 0.0 || g2 < 0.0) { arg = -root; }
    var ac: f64 = _bj_acos(arg);
    var s: f64 = fsr / _BJ_PI * ac;
    return Ok(s);
}

# ── the modes ───────────────────────────────────────────────────────────────────────────────────────────────────

# H_n(x) by the recurrence H₀ = 1, H₁ = 2x, H_k = 2x·H_{k−1} − 2(k − 1)·H_{k−2}, n ≥ 0 (Rust's u32). Mirrors beam.rs's
# `hermite_polynomial` (bijli-internal; its tests reach it).
#must_use
public fn _bj_hermite_polynomial(n, x: f64): f64 {
    if (n == 0) { return 1.0; }
    var two_x: f64 = 2.0 * x;
    if (n == 1) { return two_x; }
    var h_prev: f64 = 1.0;
    var h_curr: f64 = two_x;
    for (var k = 2; k <= n; k = k + 1) {
        var km: f64 = f64_from(k - 1);
        var h_next: f64 = two_x * h_curr - 2.0 * km * h_prev;
        h_prev = h_curr;
        h_curr = h_next;
    }
    return h_curr;
}

# L_p^l(x) by the recurrence L₀ = 1, L₁ = 1 + l − x, L_k = ((2k + l − 1 − x)·L_{k−1} − (k + l − 1)·L_{k−2})/k, p and
# l ≥ 0 (Rust's u32). Mirrors beam.rs's `laguerre_polynomial` (bijli-internal; its tests reach it).
#must_use
public fn _bj_laguerre_polynomial(p, l, x: f64): f64 {
    if (p == 0) { return 1.0; }
    var lf: f64 = f64_from(l);
    var l1: f64 = 1.0 + lf - x;
    if (p == 1) { return l1; }
    var l_prev: f64 = 1.0;
    var l_curr: f64 = l1;
    for (var k = 2; k <= p; k = k + 1) {
        var kf: f64 = f64_from(k);
        var l_next: f64 = ((2.0 * kf + lf - 1.0 - x) * l_curr - (kf + lf - 1.0) * l_prev) / kf;
        l_prev = l_curr;
        l_curr = l_next;
    }
    return l_curr;
}

# The Hermite–Gaussian envelope u_mn(x, y, z) = (w₀/w)·H_m(√2x/w)·H_n(√2y/w)·e^{−(x² + y²)/w²}, the field with every
# propagation phase removed (|u_mn| = |E|, u_mn² the intensity), the lobes' signs kept. The TEM₀₀ prefactor serves
# every mode (HG₀₀(0, 0, 0) = 1): HG_mn carries 2^{m+n}·m!·n! times TEM₀₀'s power. m, n ≥ 0 (Rust's u32). Mirrors
# `hermite_gaussian`.
#must_use
public fn bj_hermite_gaussian(beam: *BjGaussianBeam, m, n, x: f64, y: f64, z: f64): f64 {
    var w: f64 = beam.spot_size(z);
    var w0: f64 = beam.waist;
    var sx: f64 = _BJ_BEAM_SQRT_2 * x / w;
    var sy: f64 = _BJ_BEAM_SQRT_2 * y / w;
    var hm: f64 = _bj_hermite_polynomial(m, sx);
    var hn: f64 = _bj_hermite_polynomial(n, sy);
    var r_sq: f64 = x * x + y * y;
    var e: f64 = _bj_exp(-r_sq / (w * w));
    var scale: f64 = w0 / w;
    var u: f64 = scale * hm * hn * e;
    return u;
}

# The complex Hermite–Gaussian field E_mn = u_mn·e^{−j[kz + k(x² + y²)/(2R(z)) − (m + n + 1)ζ(z)]} in e^{+jωt} (field
# ∝ e^{−jkz}, Siegman's), u_mn = bj_hermite_gaussian, k = 2π/λ, 1/R(z) = z/(z² + z_R²) (finite at the waist),
# ζ(z) = arctan(z/z_R). The conjugate of beam.rs's e^{−iωt} field, part for part: Rust's phase, then (u·cos φ,
# −(u·sin φ)) (ADR 0002 row 5). Normalization as bj_hermite_gaussian's. Mirrors `hermite_gaussian_field`.
#must_use
public fn bj_hermite_gaussian_field(beam: *BjGaussianBeam, m, n, x: f64, y: f64, z: f64): BjComplex {
    var amp: f64 = bj_hermite_gaussian(beam, m, n, x, y, z);
    var two_pi: f64 = 2.0 * _BJ_PI;
    var k: f64 = two_pi / beam.wavelength;
    var zr: f64 = beam.rayleigh_range;
    var inv_r: f64 = z / (z * z + zr * zr);
    var mf: f64 = f64_from(m);
    var nf: f64 = f64_from(n);
    var order: f64 = mf + nf + 1.0;
    var gouy: f64 = beam.gouy_phase(z);
    var phase: f64 = k * z + 0.5 * k * (x * x + y * y) * inv_r - order * gouy;
    # Complex::from_polar's (u·cos φ, u·sin φ), with one sincos as Rust's compiles it (correctly rounded, so the
    # bits of separate cos and sin), then conjugated.
    var sp, cp = _bj_sin_cos(phase);
    var sv: f64 = sp;
    var cv: f64 = cp;
    var e: BjComplex;
    e.re = amp * cv;
    e.im = -(amp * sv);
    return e;
}

# The Laguerre–Gaussian intensity I_pl(r, z) = (w₀/w)²·(2r²/w²)^|l|·[L_p^|l|(2r²/w²)]²·e^{−2r²/w²}, |E|² (the vortex
# phase e^{jlφ} and the Gouy phase drop out). The TEM₀₀ prefactor serves every mode (LG₀₀(0, 0) = 1): LG_pl carries
# (p + |l|)!/p! times TEM₀₀'s power. p ≥ 0 (Rust's u32), l Rust's i32. For l = i32::MIN the power is (2r²/w²)^{2³¹}
# (ADR 0002 row 32: Rust's `l.unsigned_abs() as i32` wraps to −2³¹, the reciprocal). Mirrors
# `laguerre_gaussian_intensity`.
#must_use
public fn bj_laguerre_gaussian_intensity(beam: *BjGaussianBeam, p, l, r: f64, z: f64): f64 {
    var w: f64 = beam.spot_size(z);
    var w0: f64 = beam.waist;
    var rho: f64 = _BJ_BEAM_SQRT_2 * r / w;
    var rho_sq: f64 = rho * rho;
    var la = l;
    if (la < 0) { la = 0 - la; }
    var lp: f64 = _bj_laguerre_polynomial(p, la, rho_sq);
    var e: f64 = _bj_exp(-2.0 * r * r / (w * w));
    var scale: f64 = w0 * w0 / (w * w);
    var pw: f64 = _bj_powi(rho_sq, la);
    var i: f64 = scale * pw * lp * lp * e;
    return i;
}

# --- json.cyr ---

# json.cyr — JSON for the serializable types: BjComplex (Rust hisab 1.4.0's `Complex`), BjFieldVector,
# BjPointCharge, (M2 part 1a) BjMaterial, (M3 part 1a-2) polarization's BjJonesVector, BjJonesMatrix,
# BjStokesVector and BjMuellerMatrix, (M3 part 1b-2) scattering's BjMieResult, and (M3 part 1c-2) beam's
# BjGaussianBeam, BjAbcdMatrix and BjResonatorStability, as serde_json 1.0.154 writes and reads them (port plan D5,
# M1 part 4; ADR 0002 rows 10–12).
#
# Writers append serde's document to a `str_builder`: the fields in Rust declaration order, no spaces, a Rust array
# (`[f64; 3]`, a Jones matrix's `m: [[Complex; 2]; 2]`, a Mueller matrix's `m: [[f64; 4]; 4]`) as nested arrays row by
# row, an inner Complex as its own object, a bool (BjResonatorStability's `is_stable`, 1 or 0) as `true` or `false`,
# every f64 through bayan's printer (`bayan_f64_to_json`, the printer `#derive(Serialize)` uses): the shortest
# round-trip digits, `null` for NaN and ±∞ as serde_json writes them. The notation is bayan's, not ryu's
# (`10000000000000000.0` where serde_json writes `1e16`); each parses to the same bits, which is what the golden rows
# compare (D5). The document is built on the stack (a BjMieResult's, whose two `Vec<Complex>` have any length, in one
# fl_alloc block sized for the longest numbers) and appended in one grow, so a refused allocation leaves the builder as
# it was and returns BJ_ERR_ALLOCATION (the builder's own grow would exit the process). Hand-written, not derived: on
# cyrius 6.7.18 a `#derive(Serialize)` in a second `private` file fails to compile (the derive's shared helper is
# private to the first one), and the derive would export its scanner decoders as bijli API (probe p16).
#
# Readers parse the text with bayan's value tree and apply serde's derive semantics:
# - a struct reads from an object, by field name, or from an array, by position (serde's sequence form), which must
#   hold exactly its fields, at every level (a Jones vector's x is a Complex in either form); a Rust `[T; n]` reads
#   from an array of exactly n T, a `Vec<T>` from an array of any length;
# - a field missing, a value of the wrong JSON type, or an array of the wrong length is BJ_ERR_DESERIALIZE;
# - unknown fields are ignored, whatever their value (it must still be valid JSON);
# - a bool takes only JSON's `true` or `false`, as serde reads one: never a number (0 or 1), a string or null;
# - an f64 takes any JSON number, correctly rounded (ADR 0002 row 11: serde_json's default parse is best-effort, and
#   the golden rows compare against the correctly rounded value), and never `null` (serde_json writes NaN and ±∞ as
#   `null` and can't read them back, nor can the port); a number whose correctly rounded value overflows is refused,
#   as serde_json refuses `1e400`;
# - the whole document is checked, unknown values included (ADR 0002 row 12): a key repeated in any object, a lone
#   surrogate escape in any string, or containers nested past 128 levels refuse it. serde_json checks only what it
#   deserializes: it refuses those in the struct's own fields and keys, and skips an unknown value unchecked;
# - a mass that `BjPointCharge_new` would refuse is read as written, and so are a beam that `BjGaussianBeam_new`
#   would refuse (its z_R as given, not recomputed) and a ResonatorStability whose `is_stable` disagrees with its
#   g₁g₂: Rust's fields are public, serde's derive calls no constructor, and the readers read back every document
#   the writers write.
# Where bayan reads the text otherwise than serde_json, one pass before bayan sees it puts that right: the integer
# `-0` (an integer 0 in bayan's tree, so an f64 field would lose the sign; serde_json reads -0.0) and an integer
# outside i64 (refused by bayan; a number to serde_json) each get `.0` appended, which bayan reads as a float,
# correctly rounded; a raw control character in a string (taken by bayan; refused by serde_json and RFC 8259 §7) and
# bytes that are not UTF-8 in a string (which a Rust `&str` can't hold) refuse the document. A document with no such
# integer is parsed in place.
#
# A failed read fills the calling thread's last-error record: BJ_ERR_DESERIALIZE, Display
# `deserialization failed: <reason>`, with serde's wording where it applies (`missing field `y``) and bayan's for a
# syntax error, at its byte offset in the caller's text. `out` is written only on success.
#
# Memory. Every node of the tree comes from a decode region on the reader's stack: freelist chunks, chained and given
# back when the read ends, so a read leaves the heap as it found it (nothing on the bump heap) and two threads reading
# at once share nothing.

private

# ── writers ─────────────────────────────────────────────────────────────────────────

# Appends the C string s at buf + n; the new length.
fn _bj_jw_cstr(buf, n, s): i64 {
    var k = strlen(s);
    memcpy(buf + n, s, k);
    return n + k;
}

# Appends the f64 with bits x in bayan's JSON form (at most 25 bytes; `null` for NaN and ±∞); the new length.
fn _bj_jw_f64(buf, n, x): i64 {
    return n + bayan_f64_to_json(x, buf + n);
}

# Appends `[a,b,c]` for the three f64 at p; the new length.
fn _bj_jw_triple(buf, n, a, b, c): i64 {
    var m = n;
    store8(buf + m, 91);
    m = _bj_jw_f64(buf, m + 1, a);
    store8(buf + m, 44);
    m = _bj_jw_f64(buf, m + 1, b);
    store8(buf + m, 44);
    m = _bj_jw_f64(buf, m + 1, c);
    store8(buf + m, 93);
    return m + 1;
}

# Appends `{"re":<re>,"im":<im>}` for the two f64 at p; the new length.
fn _bj_jw_cx(buf, n, p): i64 {
    var m = _bj_jw_cstr(buf, n, "{\"re\":");
    m = _bj_jw_f64(buf, m, load64(p));
    m = _bj_jw_cstr(buf, m, ",\"im\":");
    m = _bj_jw_f64(buf, m, load64(p + 8));
    store8(buf + m, 125);
    return m + 1;
}

# Appends `[a,b,c,d]` for the four f64 at p; the new length.
fn _bj_jw_quad(buf, n, p): i64 {
    var m = n;
    for (var k = 0; k < 4; k = k + 1) {
        if (k == 0) { store8(buf + m, 91); } else { store8(buf + m, 44); }
        m = _bj_jw_f64(buf, m + 1, load64(p + k * 8));
    }
    store8(buf + m, 93);
    return m + 1;
}

# Appends the document [buf, buf + n) to the builder sb in one grow: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it
# was.
#must_use
fn _bj_jw_put(sb, buf, n): Result {
    store8(buf + n, 0);
    if (str_builder_add_cstr_a(default_alloc(), sb, buf) != 0) {
        var t = _bj_err_reason(BJ_ERR_ALLOCATION);
        _bj_tx_cstr(t, "the JSON document's builder can't grow");
        return Err(BJ_ERR_ALLOCATION);
    }
    return Ok(0);
}

# Appends `{"re":<re>,"im":<im>}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors
# `serde_json::to_string(&c)` for Rust hisab's `Complex`.
#must_use
public fn BjComplex_to_json(c: *BjComplex, sb): Result {
    var buf[80];
    var n = _bj_jw_cstr(&buf, 0, "{\"re\":");
    n = _bj_jw_f64(&buf, n, c.re);
    n = _bj_jw_cstr(&buf, n, ",\"im\":");
    n = _bj_jw_f64(&buf, n, c.im);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"x":<x>,"y":<y>,"z":<z>}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors
# `serde_json::to_string(&v)` for `field::FieldVector`.
#must_use
public fn BjFieldVector_to_json(v: *BjFieldVector, sb): Result {
    var buf[112];
    var n = _bj_jw_cstr(&buf, 0, "{\"x\":");
    n = _bj_jw_f64(&buf, n, v.x);
    n = _bj_jw_cstr(&buf, n, ",\"y\":");
    n = _bj_jw_f64(&buf, n, v.y);
    n = _bj_jw_cstr(&buf, n, ",\"z\":");
    n = _bj_jw_f64(&buf, n, v.z);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"charge":<q>,"mass":<m>,"position":[<x>,<y>,<z>],"velocity":[<vx>,<vy>,<vz>]}` to the builder sb: Ok(0),
# or Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors `serde_json::to_string(&p)` for `charge::PointCharge`.
#must_use
public fn BjPointCharge_to_json(p: *BjPointCharge, sb): Result {
    var buf[320];
    var n = _bj_jw_cstr(&buf, 0, "{\"charge\":");
    n = _bj_jw_f64(&buf, n, p.charge);
    n = _bj_jw_cstr(&buf, n, ",\"mass\":");
    n = _bj_jw_f64(&buf, n, p.mass);
    n = _bj_jw_cstr(&buf, n, ",\"position\":");
    var x: f64 = p.position.0;
    var y: f64 = p.position.1;
    var z: f64 = p.position.2;
    n = _bj_jw_triple(&buf, n, x, y, z);
    n = _bj_jw_cstr(&buf, n, ",\"velocity\":");
    var vx: f64 = p.velocity.0;
    var vy: f64 = p.velocity.1;
    var vz: f64 = p.velocity.2;
    n = _bj_jw_triple(&buf, n, vx, vy, vz);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"eps_r":<ε_r>,"mu_r":<μ_r>,"conductivity":<σ>}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with
# sb as it was. Mirrors `serde_json::to_string(&m)` for `material::Material`.
#must_use
public fn BjMaterial_to_json(m: *BjMaterial, sb): Result {
    var buf[128];
    var n = _bj_jw_cstr(&buf, 0, "{\"eps_r\":");
    n = _bj_jw_f64(&buf, n, m.eps_r);
    n = _bj_jw_cstr(&buf, n, ",\"mu_r\":");
    n = _bj_jw_f64(&buf, n, m.mu_r);
    n = _bj_jw_cstr(&buf, n, ",\"conductivity\":");
    n = _bj_jw_f64(&buf, n, m.conductivity);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"x":{"re":..,"im":..},"y":{"re":..,"im":..}}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb
# as it was. Mirrors `serde_json::to_string(&j)` for `polarization::JonesVector`.
#must_use
public fn BjJonesVector_to_json(j: *BjJonesVector, sb): Result {
    var w: f64[4];
    memcpy(&w, j, 32);
    var buf[160];
    var n = _bj_jw_cstr(&buf, 0, "{\"x\":");
    n = _bj_jw_cx(&buf, n, &w);
    n = _bj_jw_cstr(&buf, n, ",\"y\":");
    n = _bj_jw_cx(&buf, n, &w + 16);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"m":[[<m00>,<m01>],[<m10>,<m11>]]}`, each element a Complex object, to the builder sb: Ok(0), or
# Err(BJ_ERR_ALLOCATION) with sb as it was. Rust's `m[r][c]` is BjJonesMatrix's field m<r><c>. Mirrors
# `serde_json::to_string(&j)` for `polarization::JonesMatrix`.
#must_use
public fn BjJonesMatrix_to_json(j: *BjJonesMatrix, sb): Result {
    var w: f64[8];
    memcpy(&w, j, 64);
    var buf[320];
    var n = _bj_jw_cstr(&buf, 0, "{\"m\":[[");
    n = _bj_jw_cx(&buf, n, &w);
    n = _bj_jw_cstr(&buf, n, ",");
    n = _bj_jw_cx(&buf, n, &w + 16);
    n = _bj_jw_cstr(&buf, n, "],[");
    n = _bj_jw_cx(&buf, n, &w + 32);
    n = _bj_jw_cstr(&buf, n, ",");
    n = _bj_jw_cx(&buf, n, &w + 48);
    n = _bj_jw_cstr(&buf, n, "]]}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"s":[<S₀>,<S₁>,<S₂>,<S₃>]}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was.
# Mirrors `serde_json::to_string(&s)` for `polarization::StokesVector`.
#must_use
public fn BjStokesVector_to_json(s: *BjStokesVector, sb): Result {
    var w: f64[4];
    memcpy(&w, s, 32);
    var buf[128];
    var n = _bj_jw_cstr(&buf, 0, "{\"s\":");
    n = _bj_jw_quad(&buf, n, &w);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"m":[[..],[..],[..],[..]]}`, the matrix row by row, to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION)
# with sb as it was. Mirrors `serde_json::to_string(&m)` for `polarization::MuellerMatrix`.
#must_use
public fn BjMuellerMatrix_to_json(m: *BjMuellerMatrix, sb): Result {
    var w: f64[16];
    memcpy(&w, m, 128);
    var buf[512];
    var n = _bj_jw_cstr(&buf, 0, "{\"m\":[");
    for (var r = 0; r < 4; r = r + 1) {
        if (r > 0) { n = _bj_jw_cstr(&buf, n, ","); }
        n = _bj_jw_quad(&buf, n, &w + r * 32);
    }
    n = _bj_jw_cstr(&buf, n, "]}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"q_sca":..,"q_ext":..,"q_abs":..,"g":..,"a":[<Complex>,..],"b":[<Complex>,..]}` to the builder sb, each
# coefficient a Complex object: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was. The document is built in one
# fl_alloc block of 160 + 64 bytes a coefficient (an f64 is at most 25 bytes, a Complex with its comma at most 64).
# Mirrors `serde_json::to_string(&r)` for `scattering::MieResult`.
#must_use
public fn BjMieResult_to_json(r: *BjMieResult, sb): Result {
    var na = r.a_len;
    var nb = r.b_len;
    var buf = fl_alloc(160 + (na + nb) * 64);
    if (buf == 0) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "the JSON document's buffer");
        return Err(BJ_ERR_ALLOCATION);
    }
    var n = _bj_jw_cstr(buf, 0, "{\"q_sca\":");
    n = _bj_jw_f64(buf, n, r.q_sca);
    n = _bj_jw_cstr(buf, n, ",\"q_ext\":");
    n = _bj_jw_f64(buf, n, r.q_ext);
    n = _bj_jw_cstr(buf, n, ",\"q_abs\":");
    n = _bj_jw_f64(buf, n, r.q_abs);
    n = _bj_jw_cstr(buf, n, ",\"g\":");
    n = _bj_jw_f64(buf, n, r.g);
    n = _bj_jw_cstr(buf, n, ",\"a\":[");
    n = _bj_jw_cvec(buf, n, r.a, na);
    n = _bj_jw_cstr(buf, n, "],\"b\":[");
    n = _bj_jw_cvec(buf, n, r.b, nb);
    n = _bj_jw_cstr(buf, n, "]}");
    var t, v = _bj_jw_put(sb, buf, n);
    fl_free(buf);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(0);
}

# Appends the k Complex at p as objects separated by commas; the new length.
fn _bj_jw_cvec(buf, n, p, k): i64 {
    var m = n;
    for (var j = 0; j < k; j = j + 1) {
        if (j > 0) {
            store8(buf + m, 44);
            m = m + 1;
        }
        m = _bj_jw_cx(buf, m, p + j * 16);
    }
    return m;
}

# Appends `{"wavelength":<λ>,"waist":<w₀>,"rayleigh_range":<z_R>}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION)
# with sb as it was. Mirrors `serde_json::to_string(&b)` for `beam::GaussianBeam`.
#must_use
public fn BjGaussianBeam_to_json(b: *BjGaussianBeam, sb): Result {
    var buf[128];
    var n = _bj_jw_cstr(&buf, 0, "{\"wavelength\":");
    n = _bj_jw_f64(&buf, n, b.wavelength);
    n = _bj_jw_cstr(&buf, n, ",\"waist\":");
    n = _bj_jw_f64(&buf, n, b.waist);
    n = _bj_jw_cstr(&buf, n, ",\"rayleigh_range\":");
    n = _bj_jw_f64(&buf, n, b.rayleigh_range);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"a":<A>,"b":<B>,"c":<C>,"d":<D>}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was.
# Mirrors `serde_json::to_string(&m)` for `beam::AbcdMatrix`.
#must_use
public fn BjAbcdMatrix_to_json(m: *BjAbcdMatrix, sb): Result {
    var buf[128];
    var n = _bj_jw_cstr(&buf, 0, "{\"a\":");
    n = _bj_jw_f64(&buf, n, m.a);
    n = _bj_jw_cstr(&buf, n, ",\"b\":");
    n = _bj_jw_f64(&buf, n, m.b);
    n = _bj_jw_cstr(&buf, n, ",\"c\":");
    n = _bj_jw_f64(&buf, n, m.c);
    n = _bj_jw_cstr(&buf, n, ",\"d\":");
    n = _bj_jw_f64(&buf, n, m.d);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"g1":<g₁>,"g2":<g₂>,"g_product":<g₁g₂>,"is_stable":<true|false>}` to the builder sb: Ok(0), or
# Err(BJ_ERR_ALLOCATION) with sb as it was. `is_stable` is written `true` when it is not 0, as
# bj_resonator_beam_waist reads it. Mirrors `serde_json::to_string(&s)` for `beam::ResonatorStability`.
#must_use
public fn BjResonatorStability_to_json(s: *BjResonatorStability, sb): Result {
    var buf[128];
    var n = _bj_jw_cstr(&buf, 0, "{\"g1\":");
    n = _bj_jw_f64(&buf, n, s.g1);
    n = _bj_jw_cstr(&buf, n, ",\"g2\":");
    n = _bj_jw_f64(&buf, n, s.g2);
    n = _bj_jw_cstr(&buf, n, ",\"g_product\":");
    n = _bj_jw_f64(&buf, n, s.g_product);
    if (s.is_stable != 0) { n = _bj_jw_cstr(&buf, n, ",\"is_stable\":true}"); }
    else { n = _bj_jw_cstr(&buf, n, ",\"is_stable\":false}"); }
    return _bj_jw_put(sb, &buf, n);
}

# ── the decode region ───────────────────────────────────────────────────────────────
# A region on the reader's stack, 64 bytes: +0 the chunk chain (each chunk's first word links the next), +8 the next
# free byte, +16 the current chunk's end, +24 the 40-byte allocator bayan calls (lib/alloc.cyr's vtable: alloc,
# realloc, free, reset, state). Chunks are freelist blocks of one 4,096-byte class; a request larger than a chunk
# gets a block of its own. Nothing is freed before the read ends, when _bj_jr_close gives every chunk back.

const _BJ_JR_REGION = 64;
const _BJ_JR_CHUNK = 4080;

# A block of `size` bytes, 16-byte aligned, or 0 when the freelist refuses.
fn _bj_jr_alloc(st, size): i64 {
    var n = (size + 15) & (0 - 16);
    if (n <= 0) { n = 16; }
    var cur = load64(st + 8);
    if (cur != 0 && cur + n <= load64(st + 16)) {
        store64(st + 8, cur + n);
        return cur;
    }
    var cap = _BJ_JR_CHUNK - 16;
    var own = 0;
    if (n > cap) {
        cap = n;
        own = 1;
    }
    var c = fl_alloc(cap + 16);
    if (c == 0) { return 0; }
    store64(c, load64(st));
    store64(st, c);
    if (own == 0) {
        store64(st + 8, c + 16 + n);
        store64(st + 16, c + 16 + cap);
    }
    return c + 16;
}

# A block of new_size bytes holding the first min(old_size, new_size) bytes at old, or 0.
fn _bj_jr_realloc(st, old, old_size, new_size): i64 {
    var p = _bj_jr_alloc(st, new_size);
    if (p == 0) { return 0; }
    var k = old_size;
    if (new_size < k) { k = new_size; }
    if (old != 0 && k > 0) { memcpy(p, old, k); }
    return p;
}

# A block is freed with its region.
fn _bj_jr_free(st, p): i64 {
    return 0;
}

# Gives every chunk back; the region is empty and usable again.
fn _bj_jr_reset(st): i64 {
    var c = load64(st);
    while (c != 0) {
        var next = load64(c);
        fl_free(c);
        c = next;
    }
    store64(st, 0);
    store64(st + 8, 0);
    store64(st + 16, 0);
    return 0;
}

# Makes the region at rg empty; its allocator is rg + 24.
fn _bj_jr_open(rg): i64 {
    store64(rg, 0);
    store64(rg + 8, 0);
    store64(rg + 16, 0);
    store64(rg + 24, &_bj_jr_alloc);
    store64(rg + 32, &_bj_jr_realloc);
    store64(rg + 40, &_bj_jr_free);
    store64(rg + 48, &_bj_jr_reset);
    store64(rg + 56, rg);
    return rg + 24;
}

# Gives the region's memory back.
fn _bj_jr_close(rg): i64 {
    return _bj_jr_reset(rg);
}

# ── the document ────────────────────────────────────────────────────────────────────

# 1 when the integer token [p, p + n), its digits from offset ds, is one bayan reads otherwise than serde_json: `-0`,
# or a magnitude outside i64 (more than 19 digits, or 19 above i64's bound; leading zeros, which both refuse, count
# as digits).
#must_use
fn _bj_jr_int_odd(p, n, ds): i64 {
    if (n == 2 && load8(p) == 45 && load8(p + 1) == 48) { return 1; }
    var digits = n - ds;
    if (digits < 19) { return 0; }
    if (digits > 19) { return 1; }
    var bound = "9223372036854775807";
    if (ds == 1) { bound = "9223372036854775808"; }
    for (var k = 0; k < 19; k = k + 1) {
        var d = load8(p + ds + k);
        var b = load8(bound + k);
        if (d < b) { return 0; }
        if (d > b) { return 1; }
    }
    return 0;
}

# The length of the well-formed UTF-8 sequence (RFC 3629: no overlong form, no surrogate, nothing past U+10FFFF) at
# p, whose first byte is 0x80 or above and which has n bytes left, or 0.
#must_use
fn _bj_jr_utf8(p, n): i64 {
    var b0 = load8(p);
    var need = 0;
    var lo = 128;
    var hi = 191;
    if (b0 >= 194 && b0 <= 223) { need = 1; }
    elif (b0 == 224) {
        need = 2;
        lo = 160;
    } elif (b0 >= 225 && b0 <= 236) { need = 2; }
    elif (b0 == 237) {
        need = 2;
        hi = 159;
    } elif (b0 >= 238 && b0 <= 239) { need = 2; }
    elif (b0 == 240) {
        need = 3;
        lo = 144;
    } elif (b0 >= 241 && b0 <= 243) { need = 3; }
    elif (b0 == 244) {
        need = 3;
        hi = 143;
    } else { return 0; }
    if (need >= n) { return 0; }
    var b1 = load8(p + 1);
    if (b1 < lo || b1 > hi) { return 0; }
    for (var k = 2; k <= need; k = k + 1) {
        var b = load8(p + k);
        if (b < 128 || b > 191) { return 0; }
    }
    return need + 1;
}

# Notes the defect `msg` at byte `pos` in flaw[0..2] (its offset, its message), unless an earlier one is noted.
fn _bj_jr_flaw(flaw, pos, msg) {
    if (load64(flaw) < 0) {
        store64(flaw, pos);
        store64(flaw + 8, msg);
    }
    return 0;
}

# One read-only pass over the JSON text [buf, buf + len) for what bayan's tree reads otherwise than serde_json:
# - the integer tokens outside strings that _bj_jr_int_odd names: their count is returned, and when `ends` is not 0
#   each one's end offset goes to ends[0..] (a number with a fraction or an exponent is bayan's to read as it is);
# - inside strings, a raw control character (U+0000..U+001F, which RFC 8259 §7 and serde_json refuse and bayan
#   takes) or bytes that are not UTF-8 (which a Rust `&str` can't hold): the first is noted in flaw[0..2].
# On a malformed document the pass may misread where strings are, but `.0` after a run of digits can't make a
# malformed document well formed, and bayan's own error comes first when it is earlier in the text.
fn _bj_jr_scan(buf, len, ends, flaw): i64 {
    var count = 0;
    var i = 0;
    while (i < len) {
        var c = load8(buf + i);
        if (c == 34) {
            i = i + 1;
            while (i < len) {
                var d = load8(buf + i);
                if (d == 34) { break; }
                if (d == 92) { i = i + 2; }
                elif (d < 32) {
                    _bj_jr_flaw(flaw, i, "a control character (U+0000..U+001F) in a string");
                    i = i + 1;
                } elif (d < 128) { i = i + 1; }
                else {
                    var u = _bj_jr_utf8(buf + i, len - i);
                    if (u == 0) {
                        _bj_jr_flaw(flaw, i, "invalid UTF-8 in a string");
                        u = 1;
                    }
                    i = i + u;
                }
            }
            i = i + 1;
        } elif (c == 45 || (c >= 48 && c <= 57)) {
            var s = i;
            if (c == 45) { i = i + 1; }
            var ds = i - s;
            while (i < len && load8(buf + i) >= 48 && load8(buf + i) <= 57) { i = i + 1; }
            var e = i;
            var g = 0;
            if (i < len) { g = load8(buf + i); }
            if (g == 46 || g == 101 || g == 69) {
                while (i < len) {
                    var h = load8(buf + i);
                    if ((h >= 48 && h <= 57) || h == 46 || h == 101 || h == 69 || h == 43 || h == 45) { i = i + 1; }
                    else { break; }
                }
            } elif (e > s + ds && _bj_jr_int_odd(buf + s, e - s, ds) == 1) {
                if (ends != 0) { store64(ends + count * 8, e); }
                count = count + 1;
            }
        } else {
            i = i + 1;
        }
    }
    return count;
}

# Records a syntax error: bayan's message at byte `pos` of the caller's text. Returns BJ_ERR_DESERIALIZE.
fn _bj_jr_syntax(msg, pos): i64 {
    var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
    _bj_tx_cstr(t, msg);
    _bj_tx_cstr(t, " at byte ");
    _bj_tx_i64(t, pos);
    return BJ_ERR_DESERIALIZE;
}

# The value tree of the JSON text [buf, buf + len), on the region whose allocator is `a`, or 0 with the error
# recorded (BJ_ERR_DESERIALIZE; BJ_ERR_ALLOCATION when the region can't grow). Of a string defect the scan noted and
# bayan's own error, the earlier in the text is reported.
fn _bj_jr_doc(a, buf, len): i64 {
    if (buf == 0 || len < 0) {
        _bj_jr_syntax("no document", 0);
        return 0;
    }
    var flaw: i64[2];
    flaw[0] = 0 - 1;
    flaw[1] = 0;
    var text = buf;
    var tlen = len;
    var ends = 0;
    var odd = _bj_jr_scan(buf, len, 0, &flaw);
    if (odd > 0) {
        ends = alloc_via(a, odd * 8);
        tlen = len + odd * 2;
        text = alloc_via(a, tlen);
        if (ends == 0 || text == 0) {
            var t = _bj_err_reason(BJ_ERR_ALLOCATION);
            _bj_tx_cstr(t, "the JSON reader's decode region can't grow");
            return 0;
        }
        _bj_jr_scan(buf, len, ends, &flaw);
        var from = 0;
        var to = 0;
        for (var k = 0; k < odd; k = k + 1) {
            var e = load64(ends + k * 8);
            memcpy(text + to, buf + from, e - from);
            to = to + e - from;
            store8(text + to, 46);
            store8(text + to + 1, 48);
            to = to + 2;
            from = e;
        }
        memcpy(text + to, buf + from, len - from);
    }
    var ps[48];
    var v = bayan_json_v_parse_ctx_a(a, &ps, text, tlen);
    if (v != 0) {
        if (flaw[0] < 0) { return v; }
        _bj_jr_syntax(flaw[1], flaw[0]);
        return 0;
    }
    var msg = bayan_json_state_error(&ps);
    var pos = bayan_json_state_error_pos(&ps);
    # A position in the rewritten text, back in the caller's: two bytes fewer for each `.0` before it.
    if (odd > 0) {
        var shift = 0;
        for (var j = 0; j < odd; j = j + 1) {
            if (load64(ends + j * 8) + shift + 2 <= pos) { shift = shift + 2; }
        }
        pos = pos - shift;
    }
    if (_bj_jr_starts(msg, "out of memory") == 1) {
        var t2 = _bj_err_reason(BJ_ERR_ALLOCATION);
        _bj_tx_cstr(t2, "the JSON reader's decode region can't grow");
        return 0;
    }
    if (flaw[0] >= 0 && flaw[0] < pos) {
        _bj_jr_syntax(flaw[1], flaw[0]);
        return 0;
    }
    _bj_jr_syntax(msg, pos);
    return 0;
}

# 1 when the C string s starts with the C string p.
#must_use
fn _bj_jr_starts(s, p): i64 {
    var k = 0;
    while (load8(p + k) != 0) {
        if (load8(s + k) != load8(p + k)) { return 0; }
        k = k + 1;
    }
    return 1;
}

# ── values ──────────────────────────────────────────────────────────────────────────

# serde's name for the JSON type of node v, as its "invalid type" message gives it.
#must_use
fn _bj_jr_kind(v): i64 {
    var tag = bayan_json_v_tag(v);
    if (tag == JTAG_NULL) { return "null"; }
    if (tag == JTAG_BOOL) { return "boolean"; }
    if (tag == JTAG_INT) { return "integer"; }
    if (tag == JTAG_FLOAT) { return "floating point"; }
    if (tag == JTAG_STR) { return "string"; }
    if (tag == JTAG_ARR) { return "sequence"; }
    return "map";
}

# Records `invalid type: <kind of v>, expected <what>`. Returns BJ_ERR_DESERIALIZE.
fn _bj_jr_type(v, what): i64 {
    var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
    _bj_tx_cstr(t, "invalid type: ");
    _bj_tx_cstr(t, _bj_jr_kind(v));
    _bj_tx_cstr(t, ", expected ");
    _bj_tx_cstr(t, what);
    return BJ_ERR_DESERIALIZE;
}

# Records `invalid length <n>, expected <what>`. Returns BJ_ERR_DESERIALIZE.
fn _bj_jr_length(n, what): i64 {
    var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
    _bj_tx_cstr(t, "invalid length ");
    _bj_tx_i64(t, n);
    _bj_tx_cstr(t, ", expected ");
    _bj_tx_cstr(t, what);
    return BJ_ERR_DESERIALIZE;
}

# Records `missing field `<name>``. Returns BJ_ERR_DESERIALIZE.
fn _bj_jr_missing(name): i64 {
    var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
    _bj_tx_cstr(t, "missing field `");
    _bj_tx_cstr(t, name);
    _bj_tx_putc(t, 96);
    return BJ_ERR_DESERIALIZE;
}

# Node v as an f64 into *out: 0, or BJ_ERR_DESERIALIZE recorded. An integer converts to the nearest f64 (exact below
# 2^53, as serde's `n as f64`); a float is bayan's correctly rounded parse, refused when it overflowed.
fn _bj_jr_f64(v, out): i64 {
    var tag = bayan_json_v_tag(v);
    if (tag != JTAG_INT && tag != JTAG_FLOAT) { return _bj_jr_type(v, "f64"); }
    var bits = bayan_json_v_float(v);
    if ((bits & 0x7FF0000000000000) == 0x7FF0000000000000) {
        var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
        _bj_tx_cstr(t, "number out of range");
        return BJ_ERR_DESERIALIZE;
    }
    store64(out, bits);
    return 0;
}

# Node v as a Rust `[T; n]`: 0 when it is an array of exactly n elements, or BJ_ERR_DESERIALIZE recorded (`what` is
# serde's "an array of length n").
fn _bj_jr_array(v, n, what): i64 {
    if (bayan_json_v_tag(v) != JTAG_ARR) { return _bj_jr_type(v, what); }
    var k = bayan_json_v_arr_len(v);
    if (k != n) { return _bj_jr_length(k, what); }
    return 0;
}

# Node v as a `[f64; n]` into out[0..n]: an array of exactly n numbers. 0, or BJ_ERR_DESERIALIZE recorded.
fn _bj_jr_f64s(v, n, what, out): i64 {
    var c = _bj_jr_array(v, n, what);
    if (c != 0) { return c; }
    for (var k = 0; k < n; k = k + 1) {
        c = _bj_jr_f64(bayan_json_v_arr_get(v, k), out + k * 8);
        if (c != 0) { return c; }
    }
    return 0;
}

# The form of struct node v with n fields: 1 an object, 2 an array of exactly n elements (serde's sequence form), or
# 0 with BJ_ERR_DESERIALIZE recorded (`what` names the struct: "struct FieldVector").
fn _bj_jr_form(v, n, what): i64 {
    var tag = bayan_json_v_tag(v);
    if (tag == JTAG_OBJ) { return 1; }
    if (tag != JTAG_ARR) {
        _bj_jr_type(v, what);
        return 0;
    }
    var k = bayan_json_v_arr_len(v);
    if (k != n) {
        var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
        _bj_tx_cstr(t, "invalid length ");
        _bj_tx_i64(t, k);
        _bj_tx_cstr(t, ", expected ");
        _bj_tx_cstr(t, what);
        _bj_tx_cstr(t, " with ");
        _bj_tx_i64(t, n);
        _bj_tx_cstr(t, " elements");
        return 0;
    }
    return 2;
}

# Field i, named `name`, of struct node v in `form`: its node, or 0 with `missing field` recorded.
fn _bj_jr_field(v, form, i, name): i64 {
    var f = 0;
    if (form == 1) { f = bayan_json_v_obj_get_by_cstr(v, name); }
    else { f = bayan_json_v_arr_get(v, i); }
    if (f == 0) { _bj_jr_missing(name); }
    return f;
}

# Struct node v whose n fields, named names[0..n], are all f64, into out[0..n]. 0, or the code recorded.
fn _bj_jr_f64_struct(v, names, n, what, out): i64 {
    var form = _bj_jr_form(v, n, what);
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    for (var k = 0; k < n; k = k + 1) {
        var f = _bj_jr_field(v, form, k, load64(names + k * 8));
        if (f == 0) { return BJ_ERR_DESERIALIZE; }
        var c = _bj_jr_f64(f, out + k * 8);
        if (c != 0) { return c; }
    }
    return 0;
}

# Reads the document [buf, buf + len) with decoder `dec(node, words)` into the n words at w: 0, or the code recorded.
fn _bj_jr_read(buf, len, dec, w): i64 {
    var rg[64];
    var a = _bj_jr_open(&rg);
    var code = BJ_ERR_DESERIALIZE;
    var v = _bj_jr_doc(a, buf, len);
    if (v != 0) { code = fncall2(dec, v, w); }
    else { code = bj_last_error(); }
    _bj_jr_close(&rg);
    return code;
}

# The decoders, each from a node into words.
fn _bj_jr_complex(v, w): i64 {
    var names: i64[2];
    names[0] = "re";
    names[1] = "im";
    return _bj_jr_f64_struct(v, &names, 2, "struct Complex", w);
}

fn _bj_jr_field_vector(v, w): i64 {
    var names: i64[3];
    names[0] = "x";
    names[1] = "y";
    names[2] = "z";
    return _bj_jr_f64_struct(v, &names, 3, "struct FieldVector", w);
}

fn _bj_jr_material(v, w): i64 {
    var names: i64[3];
    names[0] = "eps_r";
    names[1] = "mu_r";
    names[2] = "conductivity";
    return _bj_jr_f64_struct(v, &names, 3, "struct Material", w);
}

fn _bj_jr_point_charge(v, w): i64 {
    var form = _bj_jr_form(v, 4, "struct PointCharge");
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    var f = _bj_jr_field(v, form, 0, "charge");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    var c = _bj_jr_f64(f, w);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 1, "mass");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    c = _bj_jr_f64(f, w + 8);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 2, "position");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    c = _bj_jr_f64s(f, 3, "an array of length 3", w + 16);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 3, "velocity");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    return _bj_jr_f64s(f, 3, "an array of length 3", w + 40);
}

# The one field, named `name`, of struct node v (`what` names the struct): its node, or 0 with the reason recorded.
fn _bj_jr_only(v, name, what): i64 {
    var form = _bj_jr_form(v, 1, what);
    if (form == 0) { return 0; }
    return _bj_jr_field(v, form, 0, name);
}

fn _bj_jr_jones_vector(v, w): i64 {
    var form = _bj_jr_form(v, 2, "struct JonesVector");
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    var f = _bj_jr_field(v, form, 0, "x");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    var c = _bj_jr_complex(f, w);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 1, "y");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    return _bj_jr_complex(f, w + 16);
}

# `m: [[Complex; 2]; 2]` into w row by row, as BjJonesMatrix's m00, m01, m10, m11.
fn _bj_jr_jones_matrix(v, w): i64 {
    var m = _bj_jr_only(v, "m", "struct JonesMatrix");
    if (m == 0) { return BJ_ERR_DESERIALIZE; }
    var c = _bj_jr_array(m, 2, "an array of length 2");
    if (c != 0) { return c; }
    for (var r = 0; r < 2; r = r + 1) {
        var row = bayan_json_v_arr_get(m, r);
        c = _bj_jr_array(row, 2, "an array of length 2");
        if (c != 0) { return c; }
        for (var k = 0; k < 2; k = k + 1) {
            c = _bj_jr_complex(bayan_json_v_arr_get(row, k), w + (r * 2 + k) * 16);
            if (c != 0) { return c; }
        }
    }
    return 0;
}

fn _bj_jr_stokes(v, w): i64 {
    var s = _bj_jr_only(v, "s", "struct StokesVector");
    if (s == 0) { return BJ_ERR_DESERIALIZE; }
    return _bj_jr_f64s(s, 4, "an array of length 4", w);
}

# Node v as a `Vec<Complex>` into out[0] (the address of its elements, from fl_alloc; 0 when empty) and out[1] (its
# length): an array of any length. The block is stored before its elements are read, so the caller frees it on a
# failure. 0, or the code recorded (BJ_ERR_ALLOCATION when the block can't be had).
fn _bj_jr_cvec(v, out): i64 {
    if (bayan_json_v_tag(v) != JTAG_ARR) { return _bj_jr_type(v, "a sequence"); }
    var n = bayan_json_v_arr_len(v);
    var p = 0;
    if (n > 0) {
        p = fl_alloc(n * 16);
        if (p == 0) {
            _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "the Mie coefficients read");
            return BJ_ERR_ALLOCATION;
        }
    }
    store64(out, p);
    store64(out + 8, n);
    for (var k = 0; k < n; k = k + 1) {
        var c = _bj_jr_complex(bayan_json_v_arr_get(v, k), p + k * 16);
        if (c != 0) { return c; }
    }
    return 0;
}

# A MieResult into w: q_sca, q_ext, q_abs, g, then a's block and length, then b's (w[4] and w[6] are 0 on entry).
fn _bj_jr_mie(v, w): i64 {
    var form = _bj_jr_form(v, 6, "struct MieResult");
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    var names: i64[4];
    names[0] = "q_sca";
    names[1] = "q_ext";
    names[2] = "q_abs";
    names[3] = "g";
    for (var k = 0; k < 4; k = k + 1) {
        var f = _bj_jr_field(v, form, k, names[k]);
        if (f == 0) { return BJ_ERR_DESERIALIZE; }
        var c = _bj_jr_f64(f, w + k * 8);
        if (c != 0) { return c; }
    }
    var fa = _bj_jr_field(v, form, 4, "a");
    if (fa == 0) { return BJ_ERR_DESERIALIZE; }
    var ca = _bj_jr_cvec(fa, w + 32);
    if (ca != 0) { return ca; }
    var fb = _bj_jr_field(v, form, 5, "b");
    if (fb == 0) { return BJ_ERR_DESERIALIZE; }
    return _bj_jr_cvec(fb, w + 48);
}

# `m: [[f64; 4]; 4]` into w row by row, as BjMuellerMatrix's row-major m.
fn _bj_jr_mueller(v, w): i64 {
    var m = _bj_jr_only(v, "m", "struct MuellerMatrix");
    if (m == 0) { return BJ_ERR_DESERIALIZE; }
    var c = _bj_jr_array(m, 4, "an array of length 4");
    if (c != 0) { return c; }
    for (var r = 0; r < 4; r = r + 1) {
        c = _bj_jr_f64s(bayan_json_v_arr_get(m, r), 4, "an array of length 4", w + r * 32);
        if (c != 0) { return c; }
    }
    return 0;
}

fn _bj_jr_gaussian_beam(v, w): i64 {
    var names: i64[3];
    names[0] = "wavelength";
    names[1] = "waist";
    names[2] = "rayleigh_range";
    return _bj_jr_f64_struct(v, &names, 3, "struct GaussianBeam", w);
}

fn _bj_jr_abcd(v, w): i64 {
    var names: i64[4];
    names[0] = "a";
    names[1] = "b";
    names[2] = "c";
    names[3] = "d";
    return _bj_jr_f64_struct(v, &names, 4, "struct AbcdMatrix", w);
}

# Node v as a bool into *out, 1 for `true` and 0 for `false`: JSON's two literals only, as serde reads a bool (never
# a number, a string or null). 0, or BJ_ERR_DESERIALIZE recorded.
fn _bj_jr_bool(v, out): i64 {
    if (bayan_json_v_tag(v) != JTAG_BOOL) { return _bj_jr_type(v, "a boolean"); }
    store64(out, bayan_json_v_bool(v));
    return 0;
}

# A ResonatorStability into w: g1, g2, g_product, then is_stable as 1 or 0.
fn _bj_jr_resonator(v, w): i64 {
    var form = _bj_jr_form(v, 4, "struct ResonatorStability");
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    var names: i64[3];
    names[0] = "g1";
    names[1] = "g2";
    names[2] = "g_product";
    for (var k = 0; k < 3; k = k + 1) {
        var f = _bj_jr_field(v, form, k, names[k]);
        if (f == 0) { return BJ_ERR_DESERIALIZE; }
        var c = _bj_jr_f64(f, w + k * 8);
        if (c != 0) { return c; }
    }
    var fs = _bj_jr_field(v, form, 3, "is_stable");
    if (fs == 0) { return BJ_ERR_DESERIALIZE; }
    return _bj_jr_bool(fs, w + 24);
}

# ── readers ─────────────────────────────────────────────────────────────────────────

# Reads a `Complex` document from [buf, buf + len) into *out: Ok(0), or Err(BJ_ERR_DESERIALIZE) (BJ_ERR_ALLOCATION
# when the decode region can't grow) with the reason recorded and out untouched. Mirrors
# `serde_json::from_str::<Complex>` for Rust hisab's `Complex`.
#must_use
public fn BjComplex_from_json(buf, len, out: *BjComplex): Result {
    var w: f64[2];
    var code = _bj_jr_read(buf, len, &_bj_jr_complex, &w);
    if (code != 0) { return Err(code); }
    out.re = w[0];
    out.im = w[1];
    return Ok(0);
}

# Reads a `FieldVector` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched,
# as BjComplex_from_json. Mirrors `serde_json::from_str::<FieldVector>`.
#must_use
public fn BjFieldVector_from_json(buf, len, out: *BjFieldVector): Result {
    var w: f64[3];
    var code = _bj_jr_read(buf, len, &_bj_jr_field_vector, &w);
    if (code != 0) { return Err(code); }
    out.x = w[0];
    out.y = w[1];
    out.z = w[2];
    return Ok(0);
}

# Reads a `PointCharge` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched,
# as BjComplex_from_json. Mirrors `serde_json::from_str::<PointCharge>`.
#must_use
public fn BjPointCharge_from_json(buf, len, out: *BjPointCharge): Result {
    var w: f64[8];
    var code = _bj_jr_read(buf, len, &_bj_jr_point_charge, &w);
    if (code != 0) { return Err(code); }
    out.charge = w[0];
    out.mass = w[1];
    out.position = (w[2], w[3], w[4]);
    out.velocity = (w[5], w[6], w[7]);
    return Ok(0);
}

# Reads a `Material` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched, as
# BjComplex_from_json. Any ε_r, μ_r and σ are read as written, as serde's derive reads Rust's public fields. Mirrors
# `serde_json::from_str::<Material>`.
#must_use
public fn BjMaterial_from_json(buf, len, out: *BjMaterial): Result {
    var w: f64[3];
    var code = _bj_jr_read(buf, len, &_bj_jr_material, &w);
    if (code != 0) { return Err(code); }
    out.eps_r = w[0];
    out.mu_r = w[1];
    out.conductivity = w[2];
    return Ok(0);
}

# Reads a `JonesVector` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched, as
# BjComplex_from_json. Each of x and y is a Complex in either of serde's forms. Mirrors
# `serde_json::from_str::<JonesVector>`.
#must_use
public fn BjJonesVector_from_json(buf, len, out: *BjJonesVector): Result {
    var w: f64[4];
    var code = _bj_jr_read(buf, len, &_bj_jr_jones_vector, &w);
    if (code != 0) { return Err(code); }
    memcpy(out, &w, 32);
    return Ok(0);
}

# Reads a `JonesMatrix` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched, as
# BjComplex_from_json. `m` is two rows of two Complex; Rust's `m[r][c]` is out's m<r><c>. Mirrors
# `serde_json::from_str::<JonesMatrix>`.
#must_use
public fn BjJonesMatrix_from_json(buf, len, out: *BjJonesMatrix): Result {
    var w: f64[8];
    var code = _bj_jr_read(buf, len, &_bj_jr_jones_matrix, &w);
    if (code != 0) { return Err(code); }
    memcpy(out, &w, 64);
    return Ok(0);
}

# Reads a `StokesVector` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched,
# as BjComplex_from_json. Any four numbers are read as written, as serde's derive reads Rust's public field. Mirrors
# `serde_json::from_str::<StokesVector>`.
#must_use
public fn BjStokesVector_from_json(buf, len, out: *BjStokesVector): Result {
    var w: f64[4];
    var code = _bj_jr_read(buf, len, &_bj_jr_stokes, &w);
    if (code != 0) { return Err(code); }
    memcpy(out, &w, 32);
    return Ok(0);
}

# Reads a `MuellerMatrix` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched,
# as BjComplex_from_json. `m` is four rows of four numbers. Mirrors `serde_json::from_str::<MuellerMatrix>`.
#must_use
public fn BjMuellerMatrix_from_json(buf, len, out: *BjMuellerMatrix): Result {
    var w: f64[16];
    var code = _bj_jr_read(buf, len, &_bj_jr_mueller, &w);
    if (code != 0) { return Err(code); }
    memcpy(out, &w, 128);
    return Ok(0);
}

# Reads a `MieResult` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched, as
# BjComplex_from_json (and any coefficients read so far given back). `a` and `b` are arrays of any length, each
# element a Complex in either of serde's forms, so out's lengths may differ, as Rust's public fields may. out gets new
# coefficient blocks and is never read: free a previous result first (BjMieResult_free). Mirrors
# `serde_json::from_str::<MieResult>`.
#must_use
public fn BjMieResult_from_json(buf, len, out: *BjMieResult): Result {
    var w: i64[8];
    w[4] = 0;
    w[5] = 0;
    w[6] = 0;
    w[7] = 0;
    var code = _bj_jr_read(buf, len, &_bj_jr_mie, &w);
    if (code != 0) {
        if (w[4] != 0) { fl_free(w[4]); }
        if (w[6] != 0) { fl_free(w[6]); }
        return Err(code);
    }
    memcpy(out, &w, 64);
    return Ok(0);
}

# Reads a `GaussianBeam` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched, as
# BjComplex_from_json. The three fields are read as written, as serde's derive reads Rust's public fields: a beam
# BjGaussianBeam_new would refuse is read, and z_R is the document's, not recomputed from λ and w₀. Mirrors
# `serde_json::from_str::<GaussianBeam>`.
#must_use
public fn BjGaussianBeam_from_json(buf, len, out: *BjGaussianBeam): Result {
    var w: f64[3];
    var code = _bj_jr_read(buf, len, &_bj_jr_gaussian_beam, &w);
    if (code != 0) { return Err(code); }
    memcpy(out, &w, 24);
    return Ok(0);
}

# Reads an `AbcdMatrix` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched, as
# BjComplex_from_json. Any four numbers are read as written. Mirrors `serde_json::from_str::<AbcdMatrix>`.
#must_use
public fn BjAbcdMatrix_from_json(buf, len, out: *BjAbcdMatrix): Result {
    var w: f64[4];
    var code = _bj_jr_read(buf, len, &_bj_jr_abcd, &w);
    if (code != 0) { return Err(code); }
    memcpy(out, &w, 32);
    return Ok(0);
}

# Reads a `ResonatorStability` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out
# untouched, as BjComplex_from_json. `is_stable` must be `true` (read as 1) or `false` (0); the fields are read as
# written, so an `is_stable` that disagrees with g₁g₂ is kept, as serde's derive keeps Rust's public fields. Mirrors
# `serde_json::from_str::<ResonatorStability>`.
#must_use
public fn BjResonatorStability_from_json(buf, len, out: *BjResonatorStability): Result {
    var w: i64[4];
    var code = _bj_jr_read(buf, len, &_bj_jr_resonator, &w);
    if (code != 0) { return Err(code); }
    memcpy(out, &w, 32);
    return Ok(0);
}
