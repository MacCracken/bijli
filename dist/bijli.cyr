    var xh, xm, xl = _bj_k_td_mul(vh, vm, vl, dh, dm, dl);
    var th2, tm2, tl2 = _bj_k_td_add(dh, dm, dl, xh, xm, xl);          # atan δ
    var ah: f64 = load64(&_BJ_K_CR_ATAN_T + 24 * j);
    var am: f64 = load64(&_BJ_K_CR_ATAN_T + 24 * j + 8);
    var al: f64 = load64(&_BJ_K_CR_ATAN_T + 24 * j + 16);
    var gh, gm, gl = _bj_k_td_add(ah, am, al, th2, tm2, tl2);          # θ
    if (oct == 0) {
