    var ra, rb, rc = _bj_k_td_add(n0, n1, n2, -t0, -t1, -t2);
    var r0, r1, r2 = _bj_k_td_norm(ra, rb, rc);
    var q1: f64 = r0 / b0;
    var u0, u1, u2 = _bj_k_td_mul_d(b0, b1, b2, q1);
    var sa, sb, sc = _bj_k_td_add(r0, r1, r2, -u0, -u1, -u2);
    var s0, s1, s2 = _bj_k_td_norm(sa, sb, sc);
    var q2: f64 = s0 / b0;
    var h, m0 = _bj_k_fast_two_sum(q0, q1);
    var m, l = _bj_k_two_sum(m0, q2);
    store64(out, h);
    store64(out + 8, m);
    store64(out + 16, l);
}

# offset ± atan(n/d) as a triple-double at out[0..2] (the accurate atan core before its rounding).
fn _bj_k_atan_acc_td(n0: f64, n1: f64, n2: f64, d0: f64, d1: f64, d2: f64, oct, out) {
    var zh: f64 = n0 / d0;
    var cz: f64 = zh + 26388279066624.0;
    var c: f64 = cz - 26388279066624.0;
    var j = load64(&cz) - 0x42B8000000000000;
