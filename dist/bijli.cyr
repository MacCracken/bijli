}

# RN(x·y/(z·w)), correctly rounded: faraday_mass_deposited's Q·M/(n·F) (#29). A midpoint the fast path leaves is
# _bj_k_cr_mono's (its 2/2 tie resolution).
#must_use
fn _bj_k_cr_mul2_div2(x: f64, y: f64, z: f64, w: f64): f64 {
