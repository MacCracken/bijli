# (−1)^k/(2k + 1) for k = 1 … 8 as triple-doubles (index 3·(k − 1)): the accurate atan series.
var _BJ_K_CR_ATAN_ACC: i64[24] = {
    0xBFD5555555555555, 0xBC75555555555555, 0xB915555555555555,
    0x3FC999999999999A, 0xBC6999999999999A, 0x390999999999999A,
    0xBFC2492492492492, 0xBC62492492492492, 0xB902492492492492,
    0x3FBC71C71C71C71C, 0x3C5C71C71C71C71C, 0x38FC71C71C71C71C,
    0xBFB745D1745D1746, 0x3C4745D1745D1746, 0xB8D745D1745D1746,
    0x3FB3B13B13B13B14, 0xBC53B13B13B13B14, 0x38F3B13B13B13B14,
    0xBFB1111111111111, 0xBC31111111111111, 0xB8B1111111111111,
    0x3FAE1E1E1E1E1E1E, 0x3C2E1E1E1E1E1E1E, 0x38AE1E1E1E1E1E1E
};

# --- crmath_k.cyr ---

# crmath_k.cyr — correctly rounded acos, asin, ln and log10 (bijli ADR 0001), on kimiya's correctly rounded cores.
#
# acos, ln and log10 are kimiya's (src/mathx.cyr, its ADR 0006), copied function for function with the prefixes
# renamed (_km_ → _bj_k_, _KM_ → _BJ_K_): the 27 functions their call closure reaches — the atan and ln cores (fast:
# double-double with a proven bound and a rounding test; accurate: triple-double) and the triple-double arithmetic
# under them. asin is bijli's, at the end of this file, on the same atan core as kimiya's acos. Tables:
# src/crmath_k_data.cyr, generated by scripts/oracle/crtables_k.py (kimiya's mathx_tables.py, its ln and atan
# tables), every value equal to kimiya's. src/crmath.cyr (impetus's) holds exp, sin, cos, hypot, pow and atan2;
# the two libraries share nothing but the IEEE primitives.

# +∞ (0x7FF0000000000000), a compile-time constant.
const _BJ_K_INF = 1.0 / 0.0;

# The quiet NaN Rust's f64::NAN is (0x7FF8000000000000). The parity rules match any NaN.
#must_use
fn _bj_k_nan(): f64 {
    var n: f64 = 0x7FF8000000000000;
    return n;
}

# a + b = s + e exactly (Knuth's TwoSum).
#must_use
fn _bj_k_two_sum(a: f64, b: f64): (f64, f64) {
    var s: f64 = a + b;
    var bb: f64 = s - a;
    var e: f64 = (a - (s - bb)) + (b - bb);
    return (s, e);
}

# a + b = s + e exactly, for |a| ≥ |b| or a = 0 (Dekker's FastTwoSum): s = RN(a + b).
#must_use
fn _bj_k_fast_two_sum(a: f64, b: f64): (f64, f64) {
    var s: f64 = a + b;
    var e: f64 = b - (s - a);
    return (s, e);
}

# a·b = p + e exactly (Dekker's TwoProduct with Veltkamp's 2²⁷ + 1 split), for |a|, |b| < 2⁹⁹⁶
# and no underflow in e.
#must_use
fn _bj_k_two_prod(a: f64, b: f64): (f64, f64) {
    var p: f64 = a * b;
    var split: f64 = 134217729.0;
    var ca: f64 = split * a;
    var ah: f64 = ca - (ca - a);
    var al: f64 = a - ah;
    var cb: f64 = split * b;
    var bh: f64 = cb - (cb - b);
    var bl: f64 = b - bh;
    var e: f64 = (al * bl) - (((p - (ah * bh)) - (al * bh)) - (ah * bl));
    return (p, e);
}

# RO(a + b): a + b rounded to odd (of the two doubles around an inexact sum, the one with an odd last
# bit; exact sums are returned as they are). TwoSum's error e gives the side of the exact sum; an inexact
# sum is never 0, so the bit step stays in range.
#must_use
fn _bj_k_ro_sum(a: f64, b: f64): f64 {
    var s, e = _bj_k_two_sum(a, b);
    if (e == 0.0) { return s; }
    var sb = load64(&s);
    if ((sb & 1) != 0) { return s; }
    var up = 0;
    if (e > 0.0) { up = 1; }
    var pos = 0;
    if (s > 0.0) { pos = 1; }
    if (up == pos) { sb = sb + 1; } else { sb = sb - 1; }   # away from zero is the larger magnitude word
    var r: f64 = sb;
    return r;
}

# RN(a + b + c) exactly, for any three doubles without underflow in the TwoSums: Boldo and Melquiond's
# rounding-to-odd algorithm ("Emulation of FMA and correctly rounded sums", IEEE TC 2008): b + c = uh + ul
# and a + uh = th + tl exactly, then RN(th + RO(tl + ul)). (300,000 adversarial triples — ties, near-ties,
# binade edges, cancellation — agree with exact rational rounding.)
#must_use
fn _bj_k_rn3(a: f64, b: f64, c: f64): f64 {
    var uh, ul = _bj_k_two_sum(b, c);
    var th, tl = _bj_k_two_sum(a, uh);
    var v: f64 = _bj_k_ro_sum(tl, ul);
    var z: f64 = th + v;
    return z;
}

# Triple-doubles (h, m, l), normalised (|m| ≲ ulp(h), |l| ≲ ulp(m)). Every step is TwoSum or TwoProduct
# (exact) except the rounded sums of the third-order terms and the dropped products below 2^-158 of the
# result, so each operation's error is below 2^-155·max(|a|, |b|) for a sum and 2^-153·|a·b| for a
# product. The renormalising TwoSums keep the sum exact whatever the magnitudes, so a cancellation costs
# only its relative factor.
#must_use
fn _bj_k_td_add(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64): (f64, f64, f64) {
    var s0, e0 = _bj_k_two_sum(a0, b0);
    var s1, e1 = _bj_k_two_sum(a1, b1);
    var s2: f64 = a2 + b2;
    var t1, f1 = _bj_k_two_sum(e0, s1);
    var t2: f64 = (f1 + e1) + s2;
    var h, u = _bj_k_two_sum(s0, t1);
    var m, l = _bj_k_two_sum(u, t2);
    return (h, m, l);
}

# (a0, a1, a2) + d.
#must_use
fn _bj_k_td_add_d(a0: f64, a1: f64, a2: f64, d: f64): (f64, f64, f64) {
    var s0, e0 = _bj_k_two_sum(a0, d);
    var t1, f1 = _bj_k_two_sum(e0, a1);
    var t2: f64 = f1 + a2;
    var h, u = _bj_k_two_sum(s0, t1);
    var m, l = _bj_k_two_sum(u, t2);
    return (h, m, l);
}

# (a0, a1, a2)·(b0, b1, b2): a0b0, a0b1, a1b0 exact (TwoProduct), the 2^-106 terms rounded, the 2^-159 ones
# (a1b2, a2b1, a2b2) dropped.
#must_use
fn _bj_k_td_mul(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64): (f64, f64, f64) {
    var p0, q0 = _bj_k_two_prod(a0, b0);
    var p1, q1 = _bj_k_two_prod(a0, b1);
    var p2, q2 = _bj_k_two_prod(a1, b0);
    var r: f64 = ((a0 * b2) + (a1 * b1)) + (a2 * b0);
    var s1, e1 = _bj_k_two_sum(p1, p2);
    var s2, e2 = _bj_k_two_sum(q0, s1);
    var t: f64 = (((e1 + e2) + q1) + q2) + r;
    var h, u = _bj_k_two_sum(p0, s2);
    var m, l = _bj_k_two_sum(u, t);
    return (h, m, l);
}

# (a0, a1, a2)·d for a double d.
#must_use
fn _bj_k_td_mul_d(a0: f64, a1: f64, a2: f64, d: f64): (f64, f64, f64) {
    var p0, q0 = _bj_k_two_prod(a0, d);
    var p1, q1 = _bj_k_two_prod(a1, d);
    var r: f64 = a2 * d;
    var s, e = _bj_k_two_sum(q0, p1);
    var t: f64 = (e + q1) + r;
    var h, u = _bj_k_two_sum(p0, s);
    var m, l = _bj_k_two_sum(u, t);
    return (h, m, l);
}

# The ln fast core for the bits ui of a positive normal x (ebias −54 for a subnormal pre-scaled by 2^54):
# (hi, lo, err) with |hi + lo − ln x| < err minus the test's own rounding (the bound above).
#must_use
fn _bj_k_ln_core(ui, ebias): (f64, f64, f64) {
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_BJ_K_CR_LN_T + ti);
    var lh: f64 = load64(&_BJ_K_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_BJ_K_CR_LN_T + ti + 16);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var cc: f64 = r * 134217729.0;
    var ra: f64 = cc - (cc - r);
    var rb: f64 = r - ra;
    var t1: f64 = -0.5 * (ra * ra);             # −ra²/2, exact
    var nrb: f64 = -rb;
    var t2: f64 = nrb * (ra + (0.5 * rb));
    var c3: f64 = _BJ_K_CR_LN_C3;
    var c4: f64 = _BJ_K_CR_LN_C4;
    var c5: f64 = _BJ_K_CR_LN_C5;
    var c6: f64 = _BJ_K_CR_LN_C6;
    var c7: f64 = _BJ_K_CR_LN_C7;
    var c8: f64 = _BJ_K_CR_LN_C8;
    var z: f64 = r * r;
    var pz: f64 = ((c3 + (r * c4)) + (z * (c5 + (r * c6)))) + ((z * z) * (c7 + (r * c8)));   # Estrin
    var p: f64 = (z * r) * pz;
    var e = e0 + ebias;
    var ef: f64 = f64_from(e);
    var ln2h: f64 = _BJ_K_CR_LN_LN2H;
    var ln2m: f64 = _BJ_K_CR_LN_LN2M;
    var a: f64 = ef * ln2h;                      # exact: LN2H has 42 bits, |E| < 2^11
    var s0: f64 = a + lh;
    var d0: f64 = lh - (s0 - a);
    var s1: f64 = s0 + r;
    var d1: f64 = r - (s1 - s0);
    var s2: f64 = s1 + t1;
    var d2: f64 = t1 - (s2 - s1);
    var lo: f64 = (((ef * ln2m) + lm) + (t2 + p)) + ((d0 + d1) + d2);   # short chains (latency)
    var ap: f64 = f64_abs(p);
    var ah: f64 = f64_abs(s2);
    var ae: f64 = f64_abs(ef);
    var k49: f64 = 0x3CE0000000000000;          # 2^-49
    var k83: f64 = 0x3AC0000000000000;          # 2^-83
    var k93: f64 = 0x3A20000000000000;          # 2^-93
    var err: f64 = ((ap * k49) + (ah * k83)) + (ae * k93);
    return (s2, lo, err);
}

# The accurate ln of a positive finite x ≠ 1 as a triple-double at out[0..2]: the fast path's E, j and the
# exact r; log1p(r) by Horner in triple-double on the exact r to r^16/16 (truncation 2^-144·|r|);
# E·ln 2 = E·LN2H (exact) + E·LN2M (TwoProduct) + E·LN2L (rounded, 2^-138); then E·ln2 + L_j + log1p(r)
# with at most 1.3 bits of cancellation. Measured relative error 2^-150.
fn _bj_k_ln_acc_td(x: f64, out) {
    var ui = load64(&x);
    var eb = 0;
    if (ui < 0x0010000000000000) {
        var p54: f64 = 0x4350000000000000;
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_BJ_K_CR_LN_T + ti);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var sh: f64 = load64(&_BJ_K_CR_LN_ACC + 336);     # −1/16 (index 3·(16 − 2))
    var sm: f64 = load64(&_BJ_K_CR_LN_ACC + 344);
    var sl: f64 = load64(&_BJ_K_CR_LN_ACC + 352);
    var n = 15;
    while (n >= 2) {
        var th, tm, tl = _bj_k_td_mul_d(sh, sm, sl, r);
        var off = (n - 2) * 24;
        var ch: f64 = load64(&_BJ_K_CR_LN_ACC + off);
        var cm: f64 = load64(&_BJ_K_CR_LN_ACC + off + 8);
        var cl: f64 = load64(&_BJ_K_CR_LN_ACC + off + 16);
        var uh, um, ul = _bj_k_td_add(ch, cm, cl, th, tm, tl);
        sh = uh;
        sm = um;
        sl = ul;
        n = n - 1;
    }
    var vh, vm, vl = _bj_k_td_mul_d(sh, sm, sl, r);
    var wh, wm, wl = _bj_k_td_add_d(vh, vm, vl, 1.0);
    var ph, pm, pl = _bj_k_td_mul_d(wh, wm, wl, r);       # log1p(r)
    var lh: f64 = load64(&_BJ_K_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_BJ_K_CR_LN_T + ti + 16);
    var ll: f64 = load64(&_BJ_K_CR_LN_T + ti + 24);
    var ef: f64 = f64_from(e0 + eb);
    var ln2h: f64 = _BJ_K_CR_LN_LN2H;
    var ln2m: f64 = _BJ_K_CR_LN_LN2M;
    var ln2l: f64 = _BJ_K_CR_LN_LN2L;
    var a0: f64 = ef * ln2h;
    var a1, a1e = _bj_k_two_prod(ef, ln2m);
    var a2: f64 = ef * ln2l;
    var h0, u0 = _bj_k_fast_two_sum(a0, a1);
    var a12: f64 = a1e + a2;
    var m0, l0 = _bj_k_two_sum(u0, a12);
    var bh, bm, bl = _bj_k_td_add(h0, m0, l0, lh, lm, ll);
    var zh, zm, zl = _bj_k_td_add(bh, bm, bl, ph, pm, pl);
    store64(out, zh);
    store64(out + 8, zm);
    store64(out + 16, zl);
}

# ln(x), correctly rounded. ln(1) = +0, ln(±0) = −∞, ln(+∞) = +∞, NaN for NaN and x < 0 (−∞ included).
#must_use
fn _bj_k_cr_ln(x: f64): f64 {
    var ui = load64(&x);
    # x ≤ 0 (the sign bit), subnormal, ∞ or NaN: ui − bits(DBL_MIN) is at least bits(∞) − bits(DBL_MIN) as an
    # unsigned word (the unsigned range test of kimiya's _km_cr_exp).
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {
        var w, okw = _bj_k_cr_ln_fast(x);
        if (okw == 1) { return w; }
        var zw: f64 = _bj_k_cr_ln_acc(x);
        return zw;
    }
    # _bj_k_ln_core's body, inline (a call and its three-value return cost about 4 ns here).
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_BJ_K_CR_LN_T + ti);
    var lh: f64 = load64(&_BJ_K_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_BJ_K_CR_LN_T + ti + 16);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var cc: f64 = r * 134217729.0;
    var ra: f64 = cc - (cc - r);
    var rb: f64 = r - ra;
    var t1: f64 = -0.5 * (ra * ra);             # −ra²/2, exact
    var nrb: f64 = -rb;
    var t2: f64 = nrb * (ra + (0.5 * rb));
    var c3: f64 = _BJ_K_CR_LN_C3;
    var c4: f64 = _BJ_K_CR_LN_C4;
    var c5: f64 = _BJ_K_CR_LN_C5;
    var c6: f64 = _BJ_K_CR_LN_C6;
    var c7: f64 = _BJ_K_CR_LN_C7;
    var c8: f64 = _BJ_K_CR_LN_C8;
    var z: f64 = r * r;
    var pz: f64 = ((c3 + (r * c4)) + (z * (c5 + (r * c6)))) + ((z * z) * (c7 + (r * c8)));   # Estrin
    var p: f64 = (z * r) * pz;
    var e = e0;
    var ef: f64 = f64_from(e);
    var ln2h: f64 = _BJ_K_CR_LN_LN2H;
    var ln2m: f64 = _BJ_K_CR_LN_LN2M;
    var a: f64 = ef * ln2h;                      # exact: LN2H has 42 bits, |E| < 2^11
    var s0: f64 = a + lh;
    var d0: f64 = lh - (s0 - a);
    var s1: f64 = s0 + r;
    var d1: f64 = r - (s1 - s0);
    var s2: f64 = s1 + t1;
    var d2: f64 = t1 - (s2 - s1);
    var lo: f64 = (((ef * ln2m) + lm) + (t2 + p)) + ((d0 + d1) + d2);   # short chains (latency)
    var ap: f64 = f64_abs(p);
    var ah: f64 = f64_abs(s2);
    var ae: f64 = f64_abs(ef);
    var k49: f64 = 0x3CE0000000000000;          # 2^-49
    var k83: f64 = 0x3AC0000000000000;          # 2^-83
    var k93: f64 = 0x3A20000000000000;          # 2^-93
    var err: f64 = ((ap * k49) + (ah * k83)) + (ae * k93);
    var u: f64 = s2 + (lo - err);
    var v: f64 = s2 + (lo + err);
    if (u == v) { return u; }
    var za: f64 = _bj_k_cr_ln_acc(x);
    return za;
