# acos x by the accurate path alone.
#must_use
fn _bj_k_cr_acos_acc(x: f64): f64 {
    var s, sp = _bj_k_acos_special(x);
    if (sp == 1) { return s; }
    var rb: f64[3];
    _bj_k_acos_acc_td(x, &rb);
