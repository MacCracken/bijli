# The fast path alone, for every x (as kimiya's _km_cr_exp_fast): the specials, a subnormal x scaled exactly by 2^54,
# then the core and its test, the operations of _bj_k_cr_ln's inline path.
#must_use
fn _bj_k_cr_ln_fast(x: f64): (f64, i64) {
    var ui = load64(&x);
    var eb = 0;
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {
        if (x != x) { return (x, 1); }
        if (x == 0.0) {
            var m1: f64 = -1.0;
            var ninf: f64 = m1 / 0.0;
            return (ninf, 1);
        }
        if (x < 0.0) {
            var nan: f64 = _bj_k_nan();           # the same quiet NaN on every target
            return (nan, 1);
        }
        if (x == _BJ_K_INF) { return (x, 1); }
        var p54: f64 = 0x4350000000000000;      # 2^54
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var hi, lo, err = _bj_k_ln_core(ui, eb);
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    if (u == v) { return (u, 1); }
    return (0.0, 0);
}

# ln by the accurate path alone, for every x.
#must_use
fn _bj_k_cr_ln_acc(x: f64): f64 {
    if (x != x) { return x; }
    if (x == 0.0) {
        var m1: f64 = -1.0;
        var ninf: f64 = m1 / 0.0;
        return ninf;
    }
    if (x < 0.0) {
        var nan: f64 = _bj_k_nan();               # the same quiet NaN on every target
        return nan;
    }
    if (x == _BJ_K_INF) { return x; }
    if (x == 1.0) { return 0.0; }
    var buf: f64[3];
    _bj_k_ln_acc_td(x, &buf);
    var r: f64 = _bj_k_rn3(buf[0], buf[1], buf[2]);
    return r;
}

# log10(x), correctly rounded. log10(10^k) = k (k = 0 … 22), log10(1) = +0, log10(±0) = −∞, log10(+∞) = +∞,
# NaN for NaN and x < 0. The ln core's (hi, lo, ε), then (hi + lo)·(IVH + IVM) (Dekker's product with IVH
# pre-split) and the rounding test, else the accurate path.
#must_use
fn _bj_k_cr_log10(x: f64): f64 {
    var ui = load64(&x);
    var eb = 0;
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {   # as in _bj_k_cr_ln
        if (x != x) { return x; }
        if (x == 0.0) {
            var m1: f64 = -1.0;
            var ninf: f64 = m1 / 0.0;
            return ninf;
        }
        if (x < 0.0) {
            var nan: f64 = _bj_k_nan();
            return nan;
        }
        if (x == _BJ_K_INF) { return x; }
        var p54: f64 = 0x4350000000000000;          # a subnormal x, scaled exactly by 2^54
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var hi, lo, eln = _bj_k_ln_core(ui, eb);
    var ivh: f64 = _BJ_K_CR_LN_IVH;
    var ivm: f64 = _BJ_K_CR_LN_IVM;
    var i1: f64 = _BJ_K_CR_LN_IVH1;
    var i2: f64 = _BJ_K_CR_LN_IVH2;
    var ph: f64 = hi * ivh;
    var c: f64 = 134217729.0 * hi;
    var h1: f64 = c - (c - hi);
    var h2: f64 = hi - h1;
    var pe: f64 = ((((h1 * i1) - ph) + (h1 * i2)) + (h2 * i1)) + (h2 * i2);
    var pl: f64 = pe + ((hi * ivm) + (lo * ivh));
    # The error: 0.4343·(ln's error) plus the product's roundings (hi·IVM, lo·IVH, pl's sum, the test's own:
    # below 2^-52.4·|lo| + 2^-101·|ph|, which eln's slack and 0.5 − 0.4343 cover) and IVL (2^-111·|ln x|):
    # err10 = eln/2 + 2^-100·|ph|.
    var ap: f64 = f64_abs(ph);
    var k100: f64 = 0x39B0000000000000;     # 2^-100
    var err: f64 = (eln * 0.5) + (ap * k100);
    var u: f64 = ph + (pl - err);
    var v: f64 = ph + (pl + err);
    if (u == v) { return u; }
    var z: f64 = _bj_k_cr_log10_acc(x);
    return z;
}

# log10 by the accurate path alone: the triple-double ln times 1/ln 10 = IVH + IVM + IVL.
#must_use
fn _bj_k_cr_log10_acc(x: f64): f64 {
    if (x != x) { return x; }
    if (x == 0.0) {
        var m1: f64 = -1.0;
        var ninf: f64 = m1 / 0.0;
        return ninf;
    }
    if (x < 0.0) {
        var nan: f64 = _bj_k_nan();               # the same quiet NaN on every target
        return nan;
    }
    if (x == _BJ_K_INF) { return x; }
    if (x == 1.0) { return 0.0; }
    var buf: f64[3];
    _bj_k_ln_acc_td(x, &buf);
    var ivh: f64 = _BJ_K_CR_LN_IVH;
    var ivm: f64 = _BJ_K_CR_LN_IVM;
    var ivl: f64 = _BJ_K_CR_LN_IVL;
    var zh, zm, zl = _bj_k_td_mul(buf[0], buf[1], buf[2], ivh, ivm, ivl);
    var r: f64 = _bj_k_rn3(zh, zm, zl);
    return r;
}

# The fast atan core for n = nh + nl, d = dh + dl with 0 < n ≤ d (1 + 2^-50), dh in [1/2, 2), nh ≥ 2^-62·dh:
# (hi, lo, err) for offset ± atan(n/d) by oct.
#must_use
fn _bj_k_atan_core(nh: f64, nl: f64, dh: f64, dl: f64, oct): (f64, f64, f64) {
    var zh: f64 = nh / dh;
    var cz: f64 = zh + 26388279066624.0;          # 1.5·2^44: rounds n/d to a multiple of 2^-8
    var c: f64 = cz - 26388279066624.0;
    var j = load64(&cz) - 0x42B8000000000000;
    var sh: f64 = nh;
    var sl: f64 = nl;
    var eh: f64 = dh;
    var el: f64 = dl;
    if (j != 0) {
        var d1: f64 = (dh + 384.0) - 384.0;       # 1.5·2^8: dh on the 2^-44 grid
        var d2: f64 = dh - d1;
        var n1: f64 = (nh + 384.0) - 384.0;
        var n2: f64 = nh - n1;
        var p1: f64 = c * d1;                     # exact
        var np1: f64 = -p1;
        var u: f64 = nh + np1;                    # TwoSum(nh, −c·d1)
        var ub: f64 = u - nh;
        var ue: f64 = (nh - (u - ub)) + (np1 - ub);
        sh = u;
        sl = ((ue - (c * d2)) + nl) - (c * dl);
        var q1: f64 = c * n1;                     # exact
        var v: f64 = dh + q1;                     # TwoSum(dh, c·n1)
        var vb: f64 = v - dh;
        var ve: f64 = (dh - (v - vb)) + (q1 - vb);
        eh = v;
        el = ((ve + (c * n2)) + dl) + (c * nl);
    }
    var qh: f64 = sh / eh;                        # δ = qh + ql: Dekker's division
    var cq: f64 = 134217729.0 * qh;
    var q1h: f64 = cq - (cq - qh);
    var q1l: f64 = qh - q1h;
    var ce: f64 = 134217729.0 * eh;
    var e1h: f64 = ce - (ce - eh);
    var e1l: f64 = eh - e1h;
    var pp: f64 = qh * eh;
    var pe: f64 = (((q1h * e1h) - pp) + (q1h * e1l) + (q1l * e1h)) + (q1l * e1l);
    var ql: f64 = ((((sh - pp) - pe) + sl) - (qh * el)) / eh;
    var a3: f64 = _BJ_K_CR_SC_A3;
    var a5: f64 = _BJ_K_CR_SC_A5;
    var a7: f64 = _BJ_K_CR_SC_A7;
    var a9: f64 = _BJ_K_CR_SC_A9;
    var z: f64 = qh * qh;
    var pz: f64 = ((qh * z) * (a3 + (z * (a5 + (z * (a7 + (z * a9))))))) - (ql * z);
    var ah: f64 = load64(&_BJ_K_CR_ATAN_T + 24 * j);
    var am: f64 = load64(&_BJ_K_CR_ATAN_T + 24 * j + 8);
    var oh: f64 = 0.0;
    var om: f64 = 0.0;
    var sg: f64 = 1.0;
    if (oct == 1) {
        oh = _BJ_K_CR_SC_PIH;
        om = _BJ_K_CR_SC_PIM;
        sg = -1.0;
    }
    if (oct >= 2) {
        oh = _BJ_K_CR_SC_PIO2H;
        om = _BJ_K_CR_SC_PIO2M;
        if (oct == 2) { sg = -1.0; }
    }
    var sah: f64 = sg * ah;
    var h1: f64 = oh + sah;                       # Fast2Sum: |oh| ≥ |ah| or oh = 0
    var f1: f64 = sah - (h1 - oh);
    var sqh: f64 = sg * qh;
    var hi: f64 = h1 + sqh;                       # Fast2Sum: |h1| ≥ |qh| or h1 = 0
    var f2: f64 = sqh - (hi - h1);
    var tl: f64 = (am + ql) + pz;
    var lo: f64 = ((f1 + f2) + om) + (sg * tl);
    var ahi: f64 = f64_abs(hi);
    var k68: f64 = 0x3BA6A09E667F3BCD;            # 2^-68.5 (√2·2^-69)
