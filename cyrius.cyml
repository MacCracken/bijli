[package]
name = "bijli"
version = "${file:VERSION}"
description = "Electromagnetism simulation — fields, Maxwell's equations, charge dynamics, EM waves"
license = "GPL-3.0-only"
language = "cyrius"
repository = "https://github.com/MacCracken/bijli"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
output = "build/bijli"

# Stdlib leaves for M0 (the harness and the math check). Port plan §6 step 3 lists the full
# set; sakshi, bayan and thread_local join with log.cyr / error.cyr in M1, and the [lib.ai]
# profile adds sandhi in M7. No [deps.hisab]: bijli has no production hisab dependency (ADR 0001).
[deps]
stdlib = ["syscalls", "string", "alloc", "str", "fmt", "io", "vec", "args", "math", "ganita",
          "tagged", "result", "fnptr", "freelist", "mmap", "overflow"]

# [test] modules is the [lib] list, so every test, bench and fuzz unit sees the library (port plan
# §6 step 7); scripts/surface_parity.py checks that the two lists stay equal.
[test]
stdlib = ["assert", "bench"]
modules = ["src/constants.cyr", "src/crmath_data.cyr", "src/crmath.cyr", "src/crmath_k_data.cyr",
           "src/crmath_k.cyr", "src/mathx.cyr"]
timeout = 300

# The default bundle (dist/bijli.cyr). The order is load-bearing: no src/ file includes another.
# [lib.ai] joins in M7.
[lib]
modules = ["src/constants.cyr", "src/crmath_data.cyr", "src/crmath.cyr", "src/crmath_k_data.cyr",
           "src/crmath_k.cyr", "src/mathx.cyr"]
