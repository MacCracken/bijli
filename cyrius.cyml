[package]
name = "bijli"
version = "${file:VERSION}"
description = "Electromagnetism simulation — fields, Maxwell's equations, charge dynamics, EM waves"
license = "GPL-3.0-only"
language = "cyrius"
repository = "https://github.com/MacCracken/bijli"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
output = "build/bijli"

# Stdlib leaves (port plan §6 step 3): atomic and thread_local hold the per-thread last-error record
# (src/error.cyr), sakshi is the logging (src/log.cyr), bayan the JSON (src/json.cyr: its f64 printer
# and its value tree); the [lib.ai] profile adds sandhi in M7. No [deps.hisab]: bijli has no production
# hisab dependency (ADR 0001).
[deps]
stdlib = ["syscalls", "string", "alloc", "str", "fmt", "io", "vec", "args", "math", "ganita",
          "tagged", "result", "fnptr", "freelist", "mmap", "overflow", "atomic", "thread_local",
          "sakshi", "bayan"]

# Every test, bench and fuzz unit includes tests/lib.cyr, the [lib] modules as files of their own (not
# `[test] modules`, which would fold them into the test's own file: port-parity.md §8);
# scripts/surface_parity.py checks that its list equals [lib] modules.
[test]
stdlib = ["assert", "bench", "thread"]
timeout = 300

# The default bundle (dist/bijli.cyr). The order is load-bearing: no src/ file includes another.
# [lib.ai] joins in M7.
[lib]
modules = ["src/constants.cyr", "src/crmath_data.cyr", "src/crmath.cyr", "src/crmath_k_data.cyr",
           "src/crmath_k.cyr", "src/crmath_kx.cyr", "src/crmath_mono.cyr", "src/crmath_ux.cyr", "src/crmath_cmp.cyr",
           "src/mathx.cyr", "src/fmtf.cyr", "src/log.cyr", "src/error.cyr",
           "src/complex.cyr", "src/field.cyr", "src/maxwell.cyr", "src/charge.cyr", "src/json.cyr"]
