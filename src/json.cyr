# json.cyr — JSON for the serializable types: BjComplex (Rust hisab 1.4.0's `Complex`), BjFieldVector,
# BjPointCharge, (M2 part 1a) BjMaterial, (M3 part 1a-2) polarization's BjJonesVector, BjJonesMatrix,
# BjStokesVector and BjMuellerMatrix, (M3 part 1b-2) scattering's BjMieResult, (M3 part 1c-2) beam's
# BjGaussianBeam, BjAbcdMatrix and BjResonatorStability, (M4 part 1d) rf's BjSMatrix, BjTouchstoneFormat and
# BjTouchstoneData, and (M5 part 1f) the FDTD's BjLossyMaterial, BjDrudeMaterial, BjLorentzMaterial, BjDebyeMaterial,
# BjNonUniformGrid and BjEigenmodeResult, (M6 part 1d) the 2D FDTD's BjCpmlParams and BjMode2d, and (M7 part 1b-2)
# soorat's BjFieldSlice2D, BjFieldSlice3D, BjFieldLine, BjFieldLineVisualization, BjChargePoint, BjChargeVisualization,
# BjRadiationPattern and BjVectorFieldSample, as serde_json 1.0.154 writes and reads them (port plan D5, M1 part 4;
# ADR 0002 rows 10–12, 36, 45). An EigenmodeResult's three vectors
# share one count, so a document whose vectors differ in length is refused (row 36); a NonUniformGrid's axes have any
# lengths. A usize (an SMatrix's or TouchstoneData's ports, a CpmlParams' thickness) is read from 0 to 2^63 − 1 (row
# 36: bayan's tree keeps no exact integer past it) and written as Rust's whole u64.
#
# Writers append serde's document to a `str_builder`: the fields in Rust declaration order, no spaces, a Rust array
# (`[f64; 3]`, a Jones matrix's `m: [[Complex; 2]; 2]`, a Mueller matrix's `m: [[f64; 4]; 4]`) as nested arrays row by
# row, an inner Complex as its own object, a bool (BjResonatorStability's `is_stable`, 1 or 0) as `true` or `false`,
# every f64 through bayan's printer (`bayan_f64_to_json`, the printer `#derive(Serialize)` uses): the shortest
# round-trip digits, `null` for NaN and ±∞ as serde_json writes them; an f32 (a ChargePoint's) through fmtf's
# `_bj_fmt_f32_json`, zmij's shortest f32 digits; a String (a field slice's component) with serde_json's escapes
# (`\"`, `\\`, `\n`-style for five controls, `\u00xx` for the rest). The f64 notation is bayan's, not ryu's
# (`10000000000000000.0` where serde_json writes `1e16`); each parses to the same bits, which is what the golden rows
# compare (D5). The document is built on the stack (a BjMieResult's, whose two `Vec<Complex>` have any length, in one
# fl_alloc block sized for the longest numbers) and appended in one grow, so a refused allocation leaves the builder as
# it was and returns BJ_ERR_ALLOCATION (the builder's own grow would exit the process). Hand-written, not derived: on
# cyrius 6.7.18 a `#derive(Serialize)` in a second `private` file fails to compile (the derive's shared helper is
# private to the first one), and the derive would export its scanner decoders as bijli API (probe p16).
#
# Readers parse the text with bayan's value tree and apply serde's derive semantics:
# - a struct reads from an object, by field name, or from an array, by position (serde's sequence form), which must
#   hold exactly its fields, at every level (a Jones vector's x is a Complex in either form); a Rust `[T; n]` reads
#   from an array of exactly n T, a `Vec<T>` from an array of any length;
# - a field missing, a value of the wrong JSON type, or an array of the wrong length is BJ_ERR_DESERIALIZE;
# - unknown fields are ignored, whatever their value (it must still be valid JSON);
# - a bool takes only JSON's `true` or `false`, as serde reads one: never a number (0 or 1), a string or null;
# - an f64 takes any JSON number, correctly rounded (ADR 0002 row 11: serde_json's default parse is best-effort, and
#   the golden rows compare against the correctly rounded value), and never `null` (serde_json writes NaN and ±∞ as
#   `null` and can't read them back, nor can the port); a number whose correctly rounded value overflows is refused,
#   as serde_json refuses `1e400`; an f32 takes any JSON number rounded once to the nearest f32 and is refused where
#   that overflows (ADR 0002 row 45: serde_json, built without float_roundtrip, rounds twice and keeps ±∞); a String
#   takes a JSON string, its escapes decoded (a `\u0000` among them: the bytes keep their count);
# - the whole document is checked, unknown values included (ADR 0002 row 12): a key repeated in any object, a lone
#   surrogate escape in any string, or containers nested past 128 levels refuse it. serde_json checks only what it
#   deserializes: it refuses those in the struct's own fields and keys, and skips an unknown value unchecked;
# - a mass that `BjPointCharge_new` would refuse is read as written, and so are a beam that `BjGaussianBeam_new`
#   would refuse (its z_R as given, not recomputed) and a ResonatorStability whose `is_stable` disagrees with its
#   g₁g₂: Rust's fields are public, serde's derive calls no constructor, and the readers read back every document
#   the writers write.
# Where bayan reads the text otherwise than serde_json, one pass before bayan sees it puts that right: the integer
# `-0` (an integer 0 in bayan's tree, so an f64 field would lose the sign; serde_json reads -0.0) and an integer
# outside i64 (refused by bayan; a number to serde_json) each get `.0` appended, which bayan reads as a float,
# correctly rounded; a raw control character in a string (taken by bayan; refused by serde_json and RFC 8259 §7) and
# bytes that are not UTF-8 in a string (which a Rust `&str` can't hold) refuse the document. A document with no such
# integer is parsed in place.
#
# A failed read fills the calling thread's last-error record: BJ_ERR_DESERIALIZE, Display
# `deserialization failed: <reason>`, with serde's wording where it applies (`missing field `y``) and bayan's for a
# syntax error, at its byte offset in the caller's text. `out` is written only on success.
#
# Memory. Every node of the tree comes from a decode region on the reader's stack: freelist chunks, chained and given
# back when the read ends, so a read leaves the heap as it found it (nothing on the bump heap) and two threads reading
# at once share nothing.

private

# ── writers ─────────────────────────────────────────────────────────────────────────

# Appends the C string s at buf + n; the new length.
public fn _bj_jw_cstr(buf, n, s): i64 {
    var k = strlen(s);
    memcpy(buf + n, s, k);
    return n + k;
}

# Appends the f64 with bits x in bayan's JSON form (at most 25 bytes; `null` for NaN and ±∞); the new length.
fn _bj_jw_f64(buf, n, x): i64 {
    return n + bayan_f64_to_json(x, buf + n);
}

# Appends `[a,b,c]` for the three f64 at p; the new length.
fn _bj_jw_triple(buf, n, a, b, c): i64 {
    var m = n;
    store8(buf + m, 91);
    m = _bj_jw_f64(buf, m + 1, a);
    store8(buf + m, 44);
    m = _bj_jw_f64(buf, m + 1, b);
    store8(buf + m, 44);
    m = _bj_jw_f64(buf, m + 1, c);
    store8(buf + m, 93);
    return m + 1;
}

# Appends `{"re":<re>,"im":<im>}` for the two f64 at p; the new length.
fn _bj_jw_cx(buf, n, p): i64 {
    var m = _bj_jw_cstr(buf, n, "{\"re\":");
    m = _bj_jw_f64(buf, m, load64(p));
    m = _bj_jw_cstr(buf, m, ",\"im\":");
    m = _bj_jw_f64(buf, m, load64(p + 8));
    store8(buf + m, 125);
    return m + 1;
}

# Appends `[a,b,c,d]` for the four f64 at p; the new length.
fn _bj_jw_quad(buf, n, p): i64 {
    var m = n;
    for (var k = 0; k < 4; k = k + 1) {
        if (k == 0) { store8(buf + m, 91); } else { store8(buf + m, 44); }
        m = _bj_jw_f64(buf, m + 1, load64(p + k * 8));
    }
    store8(buf + m, 93);
    return m + 1;
}

# Appends the document [buf, buf + n) to the builder sb in one grow: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it
# was.
#must_use
public fn _bj_jw_put(sb, buf, n): Result {
    store8(buf + n, 0);
    if (str_builder_add_cstr_a(default_alloc(), sb, buf) != 0) {
        var t = _bj_err_reason(BJ_ERR_ALLOCATION);
        _bj_tx_cstr(t, "the JSON document's builder can't grow");
        return Err(BJ_ERR_ALLOCATION);
    }
    return Ok(0);
}

# Appends `{"re":<re>,"im":<im>}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors
# `serde_json::to_string(&c)` for Rust hisab's `Complex`.
#must_use
public fn BjComplex_to_json(c: *BjComplex, sb): Result {
    var buf[80];
    var n = _bj_jw_cstr(&buf, 0, "{\"re\":");
    n = _bj_jw_f64(&buf, n, c.re);
    n = _bj_jw_cstr(&buf, n, ",\"im\":");
    n = _bj_jw_f64(&buf, n, c.im);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"x":<x>,"y":<y>,"z":<z>}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors
# `serde_json::to_string(&v)` for `field::FieldVector`.
#must_use
public fn BjFieldVector_to_json(v: *BjFieldVector, sb): Result {
    var buf[112];
    var n = _bj_jw_cstr(&buf, 0, "{\"x\":");
    n = _bj_jw_f64(&buf, n, v.x);
    n = _bj_jw_cstr(&buf, n, ",\"y\":");
    n = _bj_jw_f64(&buf, n, v.y);
    n = _bj_jw_cstr(&buf, n, ",\"z\":");
    n = _bj_jw_f64(&buf, n, v.z);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"charge":<q>,"mass":<m>,"position":[<x>,<y>,<z>],"velocity":[<vx>,<vy>,<vz>]}` to the builder sb: Ok(0),
# or Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors `serde_json::to_string(&p)` for `charge::PointCharge`.
#must_use
public fn BjPointCharge_to_json(p: *BjPointCharge, sb): Result {
    var buf[320];
    var n = _bj_jw_cstr(&buf, 0, "{\"charge\":");
    n = _bj_jw_f64(&buf, n, p.charge);
    n = _bj_jw_cstr(&buf, n, ",\"mass\":");
    n = _bj_jw_f64(&buf, n, p.mass);
    n = _bj_jw_cstr(&buf, n, ",\"position\":");
    var x: f64 = p.position.0;
    var y: f64 = p.position.1;
    var z: f64 = p.position.2;
    n = _bj_jw_triple(&buf, n, x, y, z);
    n = _bj_jw_cstr(&buf, n, ",\"velocity\":");
    var vx: f64 = p.velocity.0;
    var vy: f64 = p.velocity.1;
    var vz: f64 = p.velocity.2;
    n = _bj_jw_triple(&buf, n, vx, vy, vz);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"eps_r":<ε_r>,"mu_r":<μ_r>,"conductivity":<σ>}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with
# sb as it was. Mirrors `serde_json::to_string(&m)` for `material::Material`.
#must_use
public fn BjMaterial_to_json(m: *BjMaterial, sb): Result {
    var buf[128];
    var n = _bj_jw_cstr(&buf, 0, "{\"eps_r\":");
    n = _bj_jw_f64(&buf, n, m.eps_r);
    n = _bj_jw_cstr(&buf, n, ",\"mu_r\":");
    n = _bj_jw_f64(&buf, n, m.mu_r);
    n = _bj_jw_cstr(&buf, n, ",\"conductivity\":");
    n = _bj_jw_f64(&buf, n, m.conductivity);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"x":{"re":..,"im":..},"y":{"re":..,"im":..}}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb
# as it was. Mirrors `serde_json::to_string(&j)` for `polarization::JonesVector`.
#must_use
public fn BjJonesVector_to_json(j: *BjJonesVector, sb): Result {
    var w: f64[4];
    memcpy(&w, j, 32);
    var buf[160];
    var n = _bj_jw_cstr(&buf, 0, "{\"x\":");
    n = _bj_jw_cx(&buf, n, &w);
    n = _bj_jw_cstr(&buf, n, ",\"y\":");
    n = _bj_jw_cx(&buf, n, &w + 16);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"m":[[<m00>,<m01>],[<m10>,<m11>]]}`, each element a Complex object, to the builder sb: Ok(0), or
# Err(BJ_ERR_ALLOCATION) with sb as it was. Rust's `m[r][c]` is BjJonesMatrix's field m<r><c>. Mirrors
# `serde_json::to_string(&j)` for `polarization::JonesMatrix`.
#must_use
public fn BjJonesMatrix_to_json(j: *BjJonesMatrix, sb): Result {
    var w: f64[8];
    memcpy(&w, j, 64);
    var buf[320];
    var n = _bj_jw_cstr(&buf, 0, "{\"m\":[[");
    n = _bj_jw_cx(&buf, n, &w);
    n = _bj_jw_cstr(&buf, n, ",");
    n = _bj_jw_cx(&buf, n, &w + 16);
    n = _bj_jw_cstr(&buf, n, "],[");
    n = _bj_jw_cx(&buf, n, &w + 32);
    n = _bj_jw_cstr(&buf, n, ",");
    n = _bj_jw_cx(&buf, n, &w + 48);
    n = _bj_jw_cstr(&buf, n, "]]}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"s":[<S₀>,<S₁>,<S₂>,<S₃>]}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was.
# Mirrors `serde_json::to_string(&s)` for `polarization::StokesVector`.
#must_use
public fn BjStokesVector_to_json(s: *BjStokesVector, sb): Result {
    var w: f64[4];
    memcpy(&w, s, 32);
    var buf[128];
    var n = _bj_jw_cstr(&buf, 0, "{\"s\":");
    n = _bj_jw_quad(&buf, n, &w);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"m":[[..],[..],[..],[..]]}`, the matrix row by row, to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION)
# with sb as it was. Mirrors `serde_json::to_string(&m)` for `polarization::MuellerMatrix`.
#must_use
public fn BjMuellerMatrix_to_json(m: *BjMuellerMatrix, sb): Result {
    var w: f64[16];
    memcpy(&w, m, 128);
    var buf[512];
    var n = _bj_jw_cstr(&buf, 0, "{\"m\":[");
    for (var r = 0; r < 4; r = r + 1) {
        if (r > 0) { n = _bj_jw_cstr(&buf, n, ","); }
        n = _bj_jw_quad(&buf, n, &w + r * 32);
    }
    n = _bj_jw_cstr(&buf, n, "]}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"q_sca":..,"q_ext":..,"q_abs":..,"g":..,"a":[<Complex>,..],"b":[<Complex>,..]}` to the builder sb, each
# coefficient a Complex object: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was. The document is built in one
# fl_alloc block of 160 + 64 bytes a coefficient (an f64 is at most 25 bytes, a Complex with its comma at most 64).
# Mirrors `serde_json::to_string(&r)` for `scattering::MieResult`.
#must_use
public fn BjMieResult_to_json(r: *BjMieResult, sb): Result {
    var na = r.a_len;
    var nb = r.b_len;
    var buf = fl_alloc(160 + (na + nb) * 64);
    if (buf == 0) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "the JSON document's buffer");
        return Err(BJ_ERR_ALLOCATION);
    }
    var n = _bj_jw_cstr(buf, 0, "{\"q_sca\":");
    n = _bj_jw_f64(buf, n, r.q_sca);
    n = _bj_jw_cstr(buf, n, ",\"q_ext\":");
    n = _bj_jw_f64(buf, n, r.q_ext);
    n = _bj_jw_cstr(buf, n, ",\"q_abs\":");
    n = _bj_jw_f64(buf, n, r.q_abs);
    n = _bj_jw_cstr(buf, n, ",\"g\":");
    n = _bj_jw_f64(buf, n, r.g);
    n = _bj_jw_cstr(buf, n, ",\"a\":[");
    n = _bj_jw_cvec(buf, n, r.a, na);
    n = _bj_jw_cstr(buf, n, "],\"b\":[");
    n = _bj_jw_cvec(buf, n, r.b, nb);
    n = _bj_jw_cstr(buf, n, "]}");
    var t, v = _bj_jw_put(sb, buf, n);
    fl_free(buf);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(0);
}

# Appends the k Complex at p as objects separated by commas; the new length.
fn _bj_jw_cvec(buf, n, p, k): i64 {
    var m = n;
    for (var j = 0; j < k; j = j + 1) {
        if (j > 0) {
            store8(buf + m, 44);
            m = m + 1;
        }
        m = _bj_jw_cx(buf, m, p + j * 16);
    }
    return m;
}

# Appends `{"wavelength":<λ>,"waist":<w₀>,"rayleigh_range":<z_R>}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION)
# with sb as it was. Mirrors `serde_json::to_string(&b)` for `beam::GaussianBeam`.
#must_use
public fn BjGaussianBeam_to_json(b: *BjGaussianBeam, sb): Result {
    var buf[128];
    var n = _bj_jw_cstr(&buf, 0, "{\"wavelength\":");
    n = _bj_jw_f64(&buf, n, b.wavelength);
    n = _bj_jw_cstr(&buf, n, ",\"waist\":");
    n = _bj_jw_f64(&buf, n, b.waist);
    n = _bj_jw_cstr(&buf, n, ",\"rayleigh_range\":");
    n = _bj_jw_f64(&buf, n, b.rayleigh_range);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"a":<A>,"b":<B>,"c":<C>,"d":<D>}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was.
# Mirrors `serde_json::to_string(&m)` for `beam::AbcdMatrix`.
#must_use
public fn BjAbcdMatrix_to_json(m: *BjAbcdMatrix, sb): Result {
    var buf[128];
    var n = _bj_jw_cstr(&buf, 0, "{\"a\":");
    n = _bj_jw_f64(&buf, n, m.a);
    n = _bj_jw_cstr(&buf, n, ",\"b\":");
    n = _bj_jw_f64(&buf, n, m.b);
    n = _bj_jw_cstr(&buf, n, ",\"c\":");
    n = _bj_jw_f64(&buf, n, m.c);
    n = _bj_jw_cstr(&buf, n, ",\"d\":");
    n = _bj_jw_f64(&buf, n, m.d);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"g1":<g₁>,"g2":<g₂>,"g_product":<g₁g₂>,"is_stable":<true|false>}` to the builder sb: Ok(0), or
# Err(BJ_ERR_ALLOCATION) with sb as it was. `is_stable` is written `true` when it is not 0, as
# bj_resonator_beam_waist reads it. Mirrors `serde_json::to_string(&s)` for `beam::ResonatorStability`.
#must_use
public fn BjResonatorStability_to_json(s: *BjResonatorStability, sb): Result {
    var buf[128];
    var n = _bj_jw_cstr(&buf, 0, "{\"g1\":");
    n = _bj_jw_f64(&buf, n, s.g1);
    n = _bj_jw_cstr(&buf, n, ",\"g2\":");
    n = _bj_jw_f64(&buf, n, s.g2);
    n = _bj_jw_cstr(&buf, n, ",\"g_product\":");
    n = _bj_jw_f64(&buf, n, s.g_product);
    if (s.is_stable != 0) { n = _bj_jw_cstr(&buf, n, ",\"is_stable\":true}"); }
    else { n = _bj_jw_cstr(&buf, n, ",\"is_stable\":false}"); }
    return _bj_jw_put(sb, &buf, n);
}

# ── rf's three types (M4 part 1d) ───────────────────────────────────────────────────────────────────────────────

# Appends the unsigned decimal digits of the 64-bit word v (a usize); the new length.
fn _bj_jw_u64(buf, n, v): i64 {
    var d[24];
    var k = 0;
    var x = v;
    if (x == 0) {
        store8(buf + n, 48);
        return n + 1;
    }
    # Above 2^63 the word is negative here: its first digit is the unsigned quotient by 10, taken via a halving.
    if (x < 0) {
        var q = ((x >> 1) / 5);
        store8(&d, 48 + (x - q * 10));
        k = 1;
        x = q;
    }
    while (x > 0) {
        store8(&d + k, 48 + x % 10);
        x = x / 10;
        k = k + 1;
    }
    for (var j = 0; j < k; j = j + 1) { store8(buf + n + j, load8(&d + k - 1 - j)); }
    return n + k;
}

# Appends an SMatrix's object `{"ports":<n>,"s":[[<Complex>,..],..],"z0":[..]}`; the new length. The buffer holds
# 64 bytes, 64 a Complex and 28 an impedance.
fn _bj_jw_sm(buf, n, m: *BjSMatrix): i64 {
    var p = m.ports;
    var k = _bj_jw_cstr(buf, n, "{\"ports\":");
    k = _bj_jw_u64(buf, k, p);
    k = _bj_jw_cstr(buf, k, ",\"s\":[");
    for (var r = 0; r < p; r = r + 1) {
        if (r > 0) { k = _bj_jw_cstr(buf, k, ","); }
        k = _bj_jw_cstr(buf, k, "[");
        k = _bj_jw_cvec(buf, k, m.s + r * p * 16, p);
        k = _bj_jw_cstr(buf, k, "]");
    }
    k = _bj_jw_cstr(buf, k, "],\"z0\":[");
    for (var j = 0; j < p; j = j + 1) {
        if (j > 0) { k = _bj_jw_cstr(buf, k, ","); }
        k = _bj_jw_f64(buf, k, load64(m.z0 + j * 8));
    }
    return _bj_jw_cstr(buf, k, "]}");
}

# The bytes an SMatrix of p ports needs in _bj_jw_sm's buffer, or -1 past 2^40.
#must_use
fn _bj_jw_sm_size(p): i64 {
    if (p < 0 || p > 131072) { return 0 - 1; }
    return 64 + p * p * 64 + p * 28;
}

# Appends `{"ports":<n>,"s":[[<Complex>,..],..],"z0":[..]}` to the builder sb (ports as an integer, each entry a
# Complex object, row by row): Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was. Built in one fl_alloc block.
# Mirrors `serde_json::to_string(&m)` for `rf::SMatrix`.
#must_use
public fn BjSMatrix_to_json(m: *BjSMatrix, sb): Result {
    var size = _bj_jw_sm_size(m.ports);
    var buf = 0;
    if (size > 0) { buf = fl_alloc(size); }
    if (buf == 0) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "the JSON document's buffer");
        return Err(BJ_ERR_ALLOCATION);
    }
    var n = _bj_jw_sm(buf, 0, m);
    var t, v = _bj_jw_put(sb, buf, n);
    fl_free(buf);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(0);
}

# Appends the format's document, its variant's name in quotes (`"MagnitudeAngle"`, `"RealImag"`, `"DbAngle"`), to the
# builder sb: Ok(0), Err(BJ_ERR_ALLOCATION) with sb as it was, or Err(BJ_ERR_INVALID_PARAMETER) for a value that is no
# BjTouchstoneFormat (Rust's enum has no other). Mirrors `serde_json::to_string(&f)` for `rf::TouchstoneFormat`.
#must_use
public fn BjTouchstoneFormat_to_json(format, sb): Result {
    if (format < 0 || format > 2) {
        var t0 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t0, "unknown Touchstone format ");
        _bj_tx_i64(t0, format);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var buf[24];
    var n = _bj_jw_cstr(&buf, 0, "\"");
    n = _bj_jw_cstr(&buf, n, _bj_ts_format_name(format));
    n = _bj_jw_cstr(&buf, n, "\"");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"ports":<n>,"z0":<R>,"frequencies":[..],"s_matrices":[<SMatrix>,..]}` to the builder sb: Ok(0), or
# Err(BJ_ERR_ALLOCATION) with sb as it was. Built in one fl_alloc block, sized by each matrix's own ports (a matrix's
# fields are public, so they need not be d.ports), at most 2^40 bytes. Mirrors `serde_json::to_string(&d)` for
# `rf::TouchstoneData`.
#must_use
public fn BjTouchstoneData_to_json(d: *BjTouchstoneData, sb): Result {
    var total = 128;
    var fits = 1;
    if (d.points < 0) { fits = 0; }
    for (var i = 0; fits == 1 && i < d.points; i = i + 1) {
        var mi: *BjSMatrix = d.matrix_at(i);
        var per = _bj_jw_sm_size(mi.ports);
        if (per < 0 || per + 32 > 1099511627776 - total) { fits = 0; }
        else { total = total + per + 32; }
    }
    var buf = 0;
    if (fits == 1) { buf = fl_alloc(total); }
    if (buf == 0) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "the JSON document's buffer");
        return Err(BJ_ERR_ALLOCATION);
    }
    var n = _bj_jw_cstr(buf, 0, "{\"ports\":");
    n = _bj_jw_u64(buf, n, d.ports);
    n = _bj_jw_cstr(buf, n, ",\"z0\":");
    n = _bj_jw_f64(buf, n, _bj_bits(d.z0));
    n = _bj_jw_cstr(buf, n, ",\"frequencies\":[");
    for (var k = 0; k < d.points; k = k + 1) {
        if (k > 0) { n = _bj_jw_cstr(buf, n, ","); }
        n = _bj_jw_f64(buf, n, load64(d.frequencies + k * 8));
    }
    n = _bj_jw_cstr(buf, n, "],\"s_matrices\":[");
    for (var j = 0; j < d.points; j = j + 1) {
        if (j > 0) { n = _bj_jw_cstr(buf, n, ","); }
        n = _bj_jw_sm(buf, n, d.matrix_at(j));
    }
    n = _bj_jw_cstr(buf, n, "]}");
    var t, v = _bj_jw_put(sb, buf, n);
    fl_free(buf);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(0);
}

# ── the decode region ───────────────────────────────────────────────────────────────
# A region on the reader's stack, 64 bytes: +0 the chunk chain (each chunk's first word links the next), +8 the next
# free byte, +16 the current chunk's end, +24 the 40-byte allocator bayan calls (lib/alloc.cyr's vtable: alloc,
# realloc, free, reset, state). Chunks are freelist blocks of one 4,096-byte class; a request larger than a chunk
# gets a block of its own. Nothing is freed before the read ends, when _bj_jr_close gives every chunk back.

const _BJ_JR_REGION = 64;
const _BJ_JR_CHUNK = 4080;

# A block of `size` bytes, 16-byte aligned, or 0 when the freelist refuses.
fn _bj_jr_alloc(st, size): i64 {
    var n = (size + 15) & (0 - 16);
    if (n <= 0) { n = 16; }
    var cur = load64(st + 8);
    if (cur != 0 && cur + n <= load64(st + 16)) {
        store64(st + 8, cur + n);
        return cur;
    }
    var cap = _BJ_JR_CHUNK - 16;
    var own = 0;
    if (n > cap) {
        cap = n;
        own = 1;
    }
    var c = fl_alloc(cap + 16);
    if (c == 0) { return 0; }
    store64(c, load64(st));
    store64(st, c);
    if (own == 0) {
        store64(st + 8, c + 16 + n);
        store64(st + 16, c + 16 + cap);
    }
    return c + 16;
}

# A block of new_size bytes holding the first min(old_size, new_size) bytes at old, or 0.
fn _bj_jr_realloc(st, old, old_size, new_size): i64 {
    var p = _bj_jr_alloc(st, new_size);
    if (p == 0) { return 0; }
    var k = old_size;
    if (new_size < k) { k = new_size; }
    if (old != 0 && k > 0) { memcpy(p, old, k); }
    return p;
}

# A block is freed with its region.
fn _bj_jr_free(st, p): i64 {
    return 0;
}

# Gives every chunk back; the region is empty and usable again.
fn _bj_jr_reset(st): i64 {
    var c = load64(st);
    while (c != 0) {
        var next = load64(c);
        fl_free(c);
        c = next;
    }
    store64(st, 0);
    store64(st + 8, 0);
    store64(st + 16, 0);
    return 0;
}

# Makes the region at rg empty; its allocator is rg + 24.
public fn _bj_jr_open(rg): i64 {
    store64(rg, 0);
    store64(rg + 8, 0);
    store64(rg + 16, 0);
    store64(rg + 24, &_bj_jr_alloc);
    store64(rg + 32, &_bj_jr_realloc);
    store64(rg + 40, &_bj_jr_free);
    store64(rg + 48, &_bj_jr_reset);
    store64(rg + 56, rg);
    return rg + 24;
}

# Gives the region's memory back.
public fn _bj_jr_close(rg): i64 {
    return _bj_jr_reset(rg);
}

# ── the document ────────────────────────────────────────────────────────────────────

# 1 when the integer token [p, p + n), its digits from offset ds, is one bayan reads otherwise than serde_json: `-0`,
# or a magnitude outside i64 (more than 19 digits, or 19 above i64's bound; leading zeros, which both refuse, count
# as digits).
#must_use
fn _bj_jr_int_odd(p, n, ds): i64 {
    if (n == 2 && load8(p) == 45 && load8(p + 1) == 48) { return 1; }
    var digits = n - ds;
    if (digits < 19) { return 0; }
    if (digits > 19) { return 1; }
    var bound = "9223372036854775807";
    if (ds == 1) { bound = "9223372036854775808"; }
    for (var k = 0; k < 19; k = k + 1) {
        var d = load8(p + ds + k);
        var b = load8(bound + k);
        if (d < b) { return 0; }
        if (d > b) { return 1; }
    }
    return 0;
}

# The length of the well-formed UTF-8 sequence (RFC 3629: no overlong form, no surrogate, nothing past U+10FFFF) at
# p, whose first byte is 0x80 or above and which has n bytes left, or 0.
#must_use
fn _bj_jr_utf8(p, n): i64 {
    var b0 = load8(p);
    var need = 0;
    var lo = 128;
    var hi = 191;
    if (b0 >= 194 && b0 <= 223) { need = 1; }
    elif (b0 == 224) {
        need = 2;
        lo = 160;
    } elif (b0 >= 225 && b0 <= 236) { need = 2; }
    elif (b0 == 237) {
        need = 2;
        hi = 159;
    } elif (b0 >= 238 && b0 <= 239) { need = 2; }
    elif (b0 == 240) {
        need = 3;
        lo = 144;
    } elif (b0 >= 241 && b0 <= 243) { need = 3; }
    elif (b0 == 244) {
        need = 3;
        hi = 143;
    } else { return 0; }
    if (need >= n) { return 0; }
    var b1 = load8(p + 1);
    if (b1 < lo || b1 > hi) { return 0; }
    for (var k = 2; k <= need; k = k + 1) {
        var b = load8(p + k);
        if (b < 128 || b > 191) { return 0; }
    }
    return need + 1;
}

# Notes the defect `msg` at byte `pos` in flaw[0..2] (its offset, its message), unless an earlier one is noted.
fn _bj_jr_flaw(flaw, pos, msg) {
    if (load64(flaw) < 0) {
        store64(flaw, pos);
        store64(flaw + 8, msg);
    }
    return 0;
}

# One read-only pass over the JSON text [buf, buf + len) for what bayan's tree reads otherwise than serde_json:
# - the integer tokens outside strings that _bj_jr_int_odd names: their count is returned, and when `ends` is not 0
#   each one's end offset goes to ends[0..] (a number with a fraction or an exponent is bayan's to read as it is);
# - inside strings, a raw control character (U+0000..U+001F, which RFC 8259 §7 and serde_json refuse and bayan
#   takes) or bytes that are not UTF-8 (which a Rust `&str` can't hold): the first is noted in flaw[0..2].
# On a malformed document the pass may misread where strings are, but `.0` after a run of digits can't make a
# malformed document well formed, and bayan's own error comes first when it is earlier in the text.
fn _bj_jr_scan(buf, len, ends, flaw): i64 {
    var count = 0;
    var i = 0;
    while (i < len) {
        var c = load8(buf + i);
        if (c == 34) {
            i = i + 1;
            while (i < len) {
                var d = load8(buf + i);
                if (d == 34) { break; }
                if (d == 92) { i = i + 2; }
                elif (d < 32) {
                    _bj_jr_flaw(flaw, i, "a control character (U+0000..U+001F) in a string");
                    i = i + 1;
                } elif (d < 128) { i = i + 1; }
                else {
                    var u = _bj_jr_utf8(buf + i, len - i);
                    if (u == 0) {
                        _bj_jr_flaw(flaw, i, "invalid UTF-8 in a string");
                        u = 1;
                    }
                    i = i + u;
                }
            }
            i = i + 1;
        } elif (c == 45 || (c >= 48 && c <= 57)) {
            var s = i;
            if (c == 45) { i = i + 1; }
            var ds = i - s;
            while (i < len && load8(buf + i) >= 48 && load8(buf + i) <= 57) { i = i + 1; }
            var e = i;
            var g = 0;
            if (i < len) { g = load8(buf + i); }
            if (g == 46 || g == 101 || g == 69) {
                while (i < len) {
                    var h = load8(buf + i);
                    if ((h >= 48 && h <= 57) || h == 46 || h == 101 || h == 69 || h == 43 || h == 45) { i = i + 1; }
                    else { break; }
                }
            } elif (e > s + ds && _bj_jr_int_odd(buf + s, e - s, ds) == 1) {
                if (ends != 0) { store64(ends + count * 8, e); }
                count = count + 1;
            }
        } else {
            i = i + 1;
        }
    }
    return count;
}

# Records a syntax error: bayan's message at byte `pos` of the caller's text. Returns BJ_ERR_DESERIALIZE.
fn _bj_jr_syntax(msg, pos): i64 {
    var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
    _bj_tx_cstr(t, msg);
    _bj_tx_cstr(t, " at byte ");
    _bj_tx_i64(t, pos);
    return BJ_ERR_DESERIALIZE;
}

# The value tree of the JSON text [buf, buf + len), on the region whose allocator is `a`, or 0 with the error
# recorded (BJ_ERR_DESERIALIZE; BJ_ERR_ALLOCATION when the region can't grow). Of a string defect the scan noted and
# bayan's own error, the earlier in the text is reported.
public fn _bj_jr_doc(a, buf, len): i64 {
    if (buf == 0 || len < 0) {
        _bj_jr_syntax("no document", 0);
        return 0;
    }
    var flaw: i64[2];
    flaw[0] = 0 - 1;
    flaw[1] = 0;
    var text = buf;
    var tlen = len;
    var ends = 0;
    var odd = _bj_jr_scan(buf, len, 0, &flaw);
    if (odd > 0) {
        ends = alloc_via(a, odd * 8);
        tlen = len + odd * 2;
        text = alloc_via(a, tlen);
        if (ends == 0 || text == 0) {
            var t = _bj_err_reason(BJ_ERR_ALLOCATION);
            _bj_tx_cstr(t, "the JSON reader's decode region can't grow");
            return 0;
        }
        _bj_jr_scan(buf, len, ends, &flaw);
        var from = 0;
        var to = 0;
        for (var k = 0; k < odd; k = k + 1) {
            var e = load64(ends + k * 8);
            memcpy(text + to, buf + from, e - from);
            to = to + e - from;
            store8(text + to, 46);
            store8(text + to + 1, 48);
            to = to + 2;
            from = e;
        }
        memcpy(text + to, buf + from, len - from);
    }
    var ps[48];
    var v = bayan_json_v_parse_ctx_a(a, &ps, text, tlen);
    if (v != 0) {
        if (flaw[0] < 0) { return v; }
        _bj_jr_syntax(flaw[1], flaw[0]);
        return 0;
    }
    var msg = bayan_json_state_error(&ps);
    var pos = bayan_json_state_error_pos(&ps);
    # A position in the rewritten text, back in the caller's: two bytes fewer for each `.0` before it.
    if (odd > 0) {
        var shift = 0;
        for (var j = 0; j < odd; j = j + 1) {
            if (load64(ends + j * 8) + shift + 2 <= pos) { shift = shift + 2; }
        }
        pos = pos - shift;
    }
    if (_bj_jr_starts(msg, "out of memory") == 1) {
        var t2 = _bj_err_reason(BJ_ERR_ALLOCATION);
        _bj_tx_cstr(t2, "the JSON reader's decode region can't grow");
        return 0;
    }
    if (flaw[0] >= 0 && flaw[0] < pos) {
        _bj_jr_syntax(flaw[1], flaw[0]);
        return 0;
    }
    _bj_jr_syntax(msg, pos);
    return 0;
}

# 1 when the C string s starts with the C string p.
#must_use
fn _bj_jr_starts(s, p): i64 {
    var k = 0;
    while (load8(p + k) != 0) {
        if (load8(s + k) != load8(p + k)) { return 0; }
        k = k + 1;
    }
    return 1;
}

# ── values ──────────────────────────────────────────────────────────────────────────

# serde's name for the JSON type of node v, as its "invalid type" message gives it.
#must_use
public fn _bj_jr_kind(v): i64 {
    var tag = bayan_json_v_tag(v);
    if (tag == JTAG_NULL) { return "null"; }
    if (tag == JTAG_BOOL) { return "boolean"; }
    if (tag == JTAG_INT) { return "integer"; }
    if (tag == JTAG_FLOAT) { return "floating point"; }
    if (tag == JTAG_STR) { return "string"; }
    if (tag == JTAG_ARR) { return "sequence"; }
    return "map";
}

# Records `invalid type: <kind of v>, expected <what>`. Returns BJ_ERR_DESERIALIZE.
public fn _bj_jr_type(v, what): i64 {
    var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
    _bj_tx_cstr(t, "invalid type: ");
    _bj_tx_cstr(t, _bj_jr_kind(v));
    _bj_tx_cstr(t, ", expected ");
    _bj_tx_cstr(t, what);
    return BJ_ERR_DESERIALIZE;
}

# Records `invalid length <n>, expected <what>`. Returns BJ_ERR_DESERIALIZE.
fn _bj_jr_length(n, what): i64 {
    var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
    _bj_tx_cstr(t, "invalid length ");
    _bj_tx_i64(t, n);
    _bj_tx_cstr(t, ", expected ");
    _bj_tx_cstr(t, what);
    return BJ_ERR_DESERIALIZE;
}

# Records `missing field `<name>``. Returns BJ_ERR_DESERIALIZE.
fn _bj_jr_missing(name): i64 {
    var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
    _bj_tx_cstr(t, "missing field `");
    _bj_tx_cstr(t, name);
    _bj_tx_putc(t, 96);
    return BJ_ERR_DESERIALIZE;
}

# Node v as an f64 into *out: 0, or BJ_ERR_DESERIALIZE recorded. An integer converts to the nearest f64 (exact below
# 2^53, as serde's `n as f64`); a float is bayan's correctly rounded parse, refused when it overflowed.
fn _bj_jr_f64(v, out): i64 {
    var tag = bayan_json_v_tag(v);
    if (tag != JTAG_INT && tag != JTAG_FLOAT) { return _bj_jr_type(v, "f64"); }
    var bits = bayan_json_v_float(v);
    if ((bits & 0x7FF0000000000000) == 0x7FF0000000000000) {
        var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
        _bj_tx_cstr(t, "number out of range");
        return BJ_ERR_DESERIALIZE;
    }
    store64(out, bits);
    return 0;
}

# Node v as a Rust `[T; n]`: 0 when it is an array of exactly n elements, or BJ_ERR_DESERIALIZE recorded (`what` is
# serde's "an array of length n").
fn _bj_jr_array(v, n, what): i64 {
    if (bayan_json_v_tag(v) != JTAG_ARR) { return _bj_jr_type(v, what); }
    var k = bayan_json_v_arr_len(v);
    if (k != n) { return _bj_jr_length(k, what); }
    return 0;
}

# Node v as a `[f64; n]` into out[0..n]: an array of exactly n numbers. 0, or BJ_ERR_DESERIALIZE recorded.
fn _bj_jr_f64s(v, n, what, out): i64 {
    var c = _bj_jr_array(v, n, what);
    if (c != 0) { return c; }
    for (var k = 0; k < n; k = k + 1) {
        c = _bj_jr_f64(bayan_json_v_arr_get(v, k), out + k * 8);
        if (c != 0) { return c; }
    }
    return 0;
}

# The form of struct node v with n fields: 1 an object, 2 an array of exactly n elements (serde's sequence form), or
# 0 with BJ_ERR_DESERIALIZE recorded (`what` names the struct: "struct FieldVector").
public fn _bj_jr_form(v, n, what): i64 {
    var tag = bayan_json_v_tag(v);
    if (tag == JTAG_OBJ) { return 1; }
    if (tag != JTAG_ARR) {
        _bj_jr_type(v, what);
        return 0;
    }
    var k = bayan_json_v_arr_len(v);
    if (k != n) {
        var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
        _bj_tx_cstr(t, "invalid length ");
        _bj_tx_i64(t, k);
        _bj_tx_cstr(t, ", expected ");
        _bj_tx_cstr(t, what);
        _bj_tx_cstr(t, " with ");
        _bj_tx_i64(t, n);
        _bj_tx_cstr(t, " elements");
        return 0;
    }
    return 2;
}

# Field i, named `name`, of struct node v in `form`: its node, or 0 with `missing field` recorded.
public fn _bj_jr_field(v, form, i, name): i64 {
    var f = 0;
    if (form == 1) { f = bayan_json_v_obj_get_by_cstr(v, name); }
    else { f = bayan_json_v_arr_get(v, i); }
    if (f == 0) { _bj_jr_missing(name); }
    return f;
}

# Struct node v whose n fields, named names[0..n], are all f64, into out[0..n]. 0, or the code recorded.
fn _bj_jr_f64_struct(v, names, n, what, out): i64 {
    var form = _bj_jr_form(v, n, what);
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    for (var k = 0; k < n; k = k + 1) {
        var f = _bj_jr_field(v, form, k, load64(names + k * 8));
        if (f == 0) { return BJ_ERR_DESERIALIZE; }
        var c = _bj_jr_f64(f, out + k * 8);
        if (c != 0) { return c; }
    }
    return 0;
}

# Reads the document [buf, buf + len) with decoder `dec(node, words)` into the n words at w: 0, or the code recorded.
public fn _bj_jr_read(buf, len, dec, w): i64 {
    var rg[64];
    var a = _bj_jr_open(&rg);
    var code = BJ_ERR_DESERIALIZE;
    var v = _bj_jr_doc(a, buf, len);
    if (v != 0) { code = fncall2(dec, v, w); }
    else { code = bj_last_error(); }
    _bj_jr_close(&rg);
    return code;
}

# The decoders, each from a node into words.
fn _bj_jr_complex(v, w): i64 {
    var names: i64[2];
    names[0] = "re";
    names[1] = "im";
    return _bj_jr_f64_struct(v, &names, 2, "struct Complex", w);
}

fn _bj_jr_field_vector(v, w): i64 {
    var names: i64[3];
    names[0] = "x";
    names[1] = "y";
    names[2] = "z";
    return _bj_jr_f64_struct(v, &names, 3, "struct FieldVector", w);
}

fn _bj_jr_material(v, w): i64 {
    var names: i64[3];
    names[0] = "eps_r";
    names[1] = "mu_r";
    names[2] = "conductivity";
    return _bj_jr_f64_struct(v, &names, 3, "struct Material", w);
}

fn _bj_jr_point_charge(v, w): i64 {
    var form = _bj_jr_form(v, 4, "struct PointCharge");
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    var f = _bj_jr_field(v, form, 0, "charge");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    var c = _bj_jr_f64(f, w);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 1, "mass");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    c = _bj_jr_f64(f, w + 8);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 2, "position");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    c = _bj_jr_f64s(f, 3, "an array of length 3", w + 16);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 3, "velocity");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    return _bj_jr_f64s(f, 3, "an array of length 3", w + 40);
}

# The one field, named `name`, of struct node v (`what` names the struct): its node, or 0 with the reason recorded.
public fn _bj_jr_only(v, name, what): i64 {
    var form = _bj_jr_form(v, 1, what);
    if (form == 0) { return 0; }
    return _bj_jr_field(v, form, 0, name);
}

fn _bj_jr_jones_vector(v, w): i64 {
    var form = _bj_jr_form(v, 2, "struct JonesVector");
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    var f = _bj_jr_field(v, form, 0, "x");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    var c = _bj_jr_complex(f, w);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 1, "y");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    return _bj_jr_complex(f, w + 16);
}

# `m: [[Complex; 2]; 2]` into w row by row, as BjJonesMatrix's m00, m01, m10, m11.
fn _bj_jr_jones_matrix(v, w): i64 {
    var m = _bj_jr_only(v, "m", "struct JonesMatrix");
    if (m == 0) { return BJ_ERR_DESERIALIZE; }
    var c = _bj_jr_array(m, 2, "an array of length 2");
    if (c != 0) { return c; }
    for (var r = 0; r < 2; r = r + 1) {
        var row = bayan_json_v_arr_get(m, r);
        c = _bj_jr_array(row, 2, "an array of length 2");
        if (c != 0) { return c; }
        for (var k = 0; k < 2; k = k + 1) {
            c = _bj_jr_complex(bayan_json_v_arr_get(row, k), w + (r * 2 + k) * 16);
            if (c != 0) { return c; }
        }
    }
    return 0;
}

fn _bj_jr_stokes(v, w): i64 {
    var s = _bj_jr_only(v, "s", "struct StokesVector");
    if (s == 0) { return BJ_ERR_DESERIALIZE; }
    return _bj_jr_f64s(s, 4, "an array of length 4", w);
}

# Node v as a `Vec<Complex>` into out[0] (the address of its elements, from fl_alloc; 0 when empty) and out[1] (its
# length): an array of any length. The block is stored before its elements are read, so the caller frees it on a
# failure. 0, or the code recorded (BJ_ERR_ALLOCATION when the block can't be had).
fn _bj_jr_cvec(v, out): i64 {
    if (bayan_json_v_tag(v) != JTAG_ARR) { return _bj_jr_type(v, "a sequence"); }
    var n = bayan_json_v_arr_len(v);
    var p = 0;
    if (n > 0) {
        p = fl_alloc(n * 16);
        if (p == 0) {
            _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "the Mie coefficients read");
            return BJ_ERR_ALLOCATION;
        }
    }
    store64(out, p);
    store64(out + 8, n);
    for (var k = 0; k < n; k = k + 1) {
        var c = _bj_jr_complex(bayan_json_v_arr_get(v, k), p + k * 16);
        if (c != 0) { return c; }
    }
    return 0;
}

# A MieResult into w: q_sca, q_ext, q_abs, g, then a's block and length, then b's (w[4] and w[6] are 0 on entry).
fn _bj_jr_mie(v, w): i64 {
    var form = _bj_jr_form(v, 6, "struct MieResult");
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    var names: i64[4];
    names[0] = "q_sca";
    names[1] = "q_ext";
    names[2] = "q_abs";
    names[3] = "g";
    for (var k = 0; k < 4; k = k + 1) {
        var f = _bj_jr_field(v, form, k, names[k]);
        if (f == 0) { return BJ_ERR_DESERIALIZE; }
        var c = _bj_jr_f64(f, w + k * 8);
        if (c != 0) { return c; }
    }
    var fa = _bj_jr_field(v, form, 4, "a");
    if (fa == 0) { return BJ_ERR_DESERIALIZE; }
    var ca = _bj_jr_cvec(fa, w + 32);
    if (ca != 0) { return ca; }
    var fb = _bj_jr_field(v, form, 5, "b");
    if (fb == 0) { return BJ_ERR_DESERIALIZE; }
    return _bj_jr_cvec(fb, w + 48);
}

# `m: [[f64; 4]; 4]` into w row by row, as BjMuellerMatrix's row-major m.
fn _bj_jr_mueller(v, w): i64 {
    var m = _bj_jr_only(v, "m", "struct MuellerMatrix");
    if (m == 0) { return BJ_ERR_DESERIALIZE; }
    var c = _bj_jr_array(m, 4, "an array of length 4");
    if (c != 0) { return c; }
    for (var r = 0; r < 4; r = r + 1) {
        c = _bj_jr_f64s(bayan_json_v_arr_get(m, r), 4, "an array of length 4", w + r * 32);
        if (c != 0) { return c; }
    }
    return 0;
}

fn _bj_jr_gaussian_beam(v, w): i64 {
    var names: i64[3];
    names[0] = "wavelength";
    names[1] = "waist";
    names[2] = "rayleigh_range";
    return _bj_jr_f64_struct(v, &names, 3, "struct GaussianBeam", w);
}

fn _bj_jr_abcd(v, w): i64 {
    var names: i64[4];
    names[0] = "a";
    names[1] = "b";
    names[2] = "c";
    names[3] = "d";
    return _bj_jr_f64_struct(v, &names, 4, "struct AbcdMatrix", w);
}

# Node v as a bool into *out, 1 for `true` and 0 for `false`: JSON's two literals only, as serde reads a bool (never
# a number, a string or null). 0, or BJ_ERR_DESERIALIZE recorded.
fn _bj_jr_bool(v, out): i64 {
    if (bayan_json_v_tag(v) != JTAG_BOOL) { return _bj_jr_type(v, "a boolean"); }
    store64(out, bayan_json_v_bool(v));
    return 0;
}

# A ResonatorStability into w: g1, g2, g_product, then is_stable as 1 or 0.
fn _bj_jr_resonator(v, w): i64 {
    var form = _bj_jr_form(v, 4, "struct ResonatorStability");
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    var names: i64[3];
    names[0] = "g1";
    names[1] = "g2";
    names[2] = "g_product";
    for (var k = 0; k < 3; k = k + 1) {
        var f = _bj_jr_field(v, form, k, names[k]);
        if (f == 0) { return BJ_ERR_DESERIALIZE; }
        var c = _bj_jr_f64(f, w + k * 8);
        if (c != 0) { return c; }
    }
    var fs = _bj_jr_field(v, form, 3, "is_stable");
    if (fs == 0) { return BJ_ERR_DESERIALIZE; }
    return _bj_jr_bool(fs, w + 24);
}

# ── readers ─────────────────────────────────────────────────────────────────────────

# Reads a `Complex` document from [buf, buf + len) into *out: Ok(0), or Err(BJ_ERR_DESERIALIZE) (BJ_ERR_ALLOCATION
# when the decode region can't grow) with the reason recorded and out untouched. Mirrors
# `serde_json::from_str::<Complex>` for Rust hisab's `Complex`.
#must_use
public fn BjComplex_from_json(buf, len, out: *BjComplex): Result {
    var w: f64[2];
    var code = _bj_jr_read(buf, len, &_bj_jr_complex, &w);
    if (code != 0) { return Err(code); }
    out.re = w[0];
    out.im = w[1];
    return Ok(0);
}

# Reads a `FieldVector` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched,
# as BjComplex_from_json. Mirrors `serde_json::from_str::<FieldVector>`.
#must_use
public fn BjFieldVector_from_json(buf, len, out: *BjFieldVector): Result {
    var w: f64[3];
    var code = _bj_jr_read(buf, len, &_bj_jr_field_vector, &w);
    if (code != 0) { return Err(code); }
    out.x = w[0];
    out.y = w[1];
    out.z = w[2];
    return Ok(0);
}

# Reads a `PointCharge` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched,
# as BjComplex_from_json. Mirrors `serde_json::from_str::<PointCharge>`.
#must_use
public fn BjPointCharge_from_json(buf, len, out: *BjPointCharge): Result {
    var w: f64[8];
    var code = _bj_jr_read(buf, len, &_bj_jr_point_charge, &w);
    if (code != 0) { return Err(code); }
    out.charge = w[0];
    out.mass = w[1];
    out.position = (w[2], w[3], w[4]);
    out.velocity = (w[5], w[6], w[7]);
    return Ok(0);
}

# Reads a `Material` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched, as
# BjComplex_from_json. Any ε_r, μ_r and σ are read as written, as serde's derive reads Rust's public fields. Mirrors
# `serde_json::from_str::<Material>`.
#must_use
public fn BjMaterial_from_json(buf, len, out: *BjMaterial): Result {
    var w: f64[3];
    var code = _bj_jr_read(buf, len, &_bj_jr_material, &w);
    if (code != 0) { return Err(code); }
    out.eps_r = w[0];
    out.mu_r = w[1];
    out.conductivity = w[2];
    return Ok(0);
}

# Reads a `JonesVector` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched, as
# BjComplex_from_json. Each of x and y is a Complex in either of serde's forms. Mirrors
# `serde_json::from_str::<JonesVector>`.
#must_use
public fn BjJonesVector_from_json(buf, len, out: *BjJonesVector): Result {
    var w: f64[4];
    var code = _bj_jr_read(buf, len, &_bj_jr_jones_vector, &w);
    if (code != 0) { return Err(code); }
    memcpy(out, &w, 32);
    return Ok(0);
}

# Reads a `JonesMatrix` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched, as
# BjComplex_from_json. `m` is two rows of two Complex; Rust's `m[r][c]` is out's m<r><c>. Mirrors
# `serde_json::from_str::<JonesMatrix>`.
#must_use
public fn BjJonesMatrix_from_json(buf, len, out: *BjJonesMatrix): Result {
    var w: f64[8];
    var code = _bj_jr_read(buf, len, &_bj_jr_jones_matrix, &w);
    if (code != 0) { return Err(code); }
    memcpy(out, &w, 64);
    return Ok(0);
}

# Reads a `StokesVector` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched,
# as BjComplex_from_json. Any four numbers are read as written, as serde's derive reads Rust's public field. Mirrors
# `serde_json::from_str::<StokesVector>`.
#must_use
public fn BjStokesVector_from_json(buf, len, out: *BjStokesVector): Result {
    var w: f64[4];
    var code = _bj_jr_read(buf, len, &_bj_jr_stokes, &w);
    if (code != 0) { return Err(code); }
    memcpy(out, &w, 32);
    return Ok(0);
}

# Reads a `MuellerMatrix` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched,
# as BjComplex_from_json. `m` is four rows of four numbers. Mirrors `serde_json::from_str::<MuellerMatrix>`.
#must_use
public fn BjMuellerMatrix_from_json(buf, len, out: *BjMuellerMatrix): Result {
    var w: f64[16];
    var code = _bj_jr_read(buf, len, &_bj_jr_mueller, &w);
    if (code != 0) { return Err(code); }
    memcpy(out, &w, 128);
    return Ok(0);
}

# Reads a `MieResult` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out empty, errors as
# BjComplex_from_json (and any coefficients read so far given back). `a` and `b` are arrays of any length, each
# element a Complex in either of serde's forms, so out's lengths may differ, as Rust's public fields may. out gets new
# coefficient blocks and is never read: free a previous result first (BjMieResult_free). Mirrors
# `serde_json::from_str::<MieResult>`.
#must_use
public fn BjMieResult_from_json(buf, len, out: *BjMieResult): Result {
    memset(out, 0, sizeof(BjMieResult));
    var w: i64[8];
    w[4] = 0;
    w[5] = 0;
    w[6] = 0;
    w[7] = 0;
    var code = _bj_jr_read(buf, len, &_bj_jr_mie, &w);
    if (code != 0) {
        if (w[4] != 0) { fl_free(w[4]); }
        if (w[6] != 0) { fl_free(w[6]); }
        return Err(code);
    }
    memcpy(out, &w, 64);
    return Ok(0);
}

# Reads a `GaussianBeam` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched, as
# BjComplex_from_json. The three fields are read as written, as serde's derive reads Rust's public fields: a beam
# BjGaussianBeam_new would refuse is read, and z_R is the document's, not recomputed from λ and w₀. Mirrors
# `serde_json::from_str::<GaussianBeam>`.
#must_use
public fn BjGaussianBeam_from_json(buf, len, out: *BjGaussianBeam): Result {
    var w: f64[3];
    var code = _bj_jr_read(buf, len, &_bj_jr_gaussian_beam, &w);
    if (code != 0) { return Err(code); }
    memcpy(out, &w, 24);
    return Ok(0);
}

# Reads an `AbcdMatrix` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched, as
# BjComplex_from_json. Any four numbers are read as written. Mirrors `serde_json::from_str::<AbcdMatrix>`.
#must_use
public fn BjAbcdMatrix_from_json(buf, len, out: *BjAbcdMatrix): Result {
    var w: f64[4];
    var code = _bj_jr_read(buf, len, &_bj_jr_abcd, &w);
    if (code != 0) { return Err(code); }
    memcpy(out, &w, 32);
    return Ok(0);
}

# Reads a `ResonatorStability` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out
# untouched, as BjComplex_from_json. `is_stable` must be `true` (read as 1) or `false` (0); the fields are read as
# written, so an `is_stable` that disagrees with g₁g₂ is kept, as serde's derive keeps Rust's public fields. Mirrors
# `serde_json::from_str::<ResonatorStability>`.
#must_use
public fn BjResonatorStability_from_json(buf, len, out: *BjResonatorStability): Result {
    var w: i64[4];
    var code = _bj_jr_read(buf, len, &_bj_jr_resonator, &w);
    if (code != 0) { return Err(code); }
    memcpy(out, &w, 32);
    return Ok(0);
}

# ── rf's three types (M4 part 1d) ───────────────────────────────────────────────────────────────────────────────

# Node v as a usize into *out: an integer node, 0 or above. serde reads an integer of ASCII digits up to u64::MAX; the
# port's word is an i64, so a count past 2^63 − 1 (a float node after the pre-pass) is refused with a float, which no
# matrix could hold (ADR 0002 row 36). 0, or BJ_ERR_DESERIALIZE recorded.
fn _bj_jr_usize(v, out): i64 {
    if (bayan_json_v_tag(v) != JTAG_INT) { return _bj_jr_type(v, "usize"); }
    var x = bayan_json_v_int(v);
    if (x < 0) {
        var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
        _bj_tx_cstr(t, "invalid value: integer `");
        _bj_tx_i64(t, x);
        _bj_tx_cstr(t, "`, expected usize");
        return BJ_ERR_DESERIALIZE;
    }
    store64(out, x);
    return 0;
}

# Records the ADR 0002 row 36 refusal: a shape the port's fixed structs can't hold. Returns BJ_ERR_DESERIALIZE.
fn _bj_jr_shape(what): i64 {
    var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
    _bj_tx_cstr(t, what);
    _bj_tx_cstr(t, " (its shape is fixed: ADR 0002 row 36)");
    return BJ_ERR_DESERIALIZE;
}

# An SMatrix node's port count and its `s` and `z0` nodes into w[0..3], with its shape checked: s an array of ports
# arrays of ports elements, z0 an array of ports elements, and the port count `want` unless want is -1. 0, or
# BJ_ERR_DESERIALIZE recorded (a wrong type, or row 36's shape).
fn _bj_jr_sm_check(v, want, w: *i64): i64 {
    var form = _bj_jr_form(v, 3, "struct SMatrix");
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    var fp = _bj_jr_field(v, form, 0, "ports");
    if (fp == 0) { return BJ_ERR_DESERIALIZE; }
    var c = _bj_jr_usize(fp, w);
    if (c != 0) { return c; }
    var fs = _bj_jr_field(v, form, 1, "s");
    if (fs == 0) { return BJ_ERR_DESERIALIZE; }
    var fz = _bj_jr_field(v, form, 2, "z0");
    if (fz == 0) { return BJ_ERR_DESERIALIZE; }
    if (bayan_json_v_tag(fs) != JTAG_ARR) { return _bj_jr_type(fs, "a sequence"); }
    if (bayan_json_v_tag(fz) != JTAG_ARR) { return _bj_jr_type(fz, "a sequence"); }
    var p = w[0];
    var rows = bayan_json_v_arr_len(fs);
    for (var r = 0; r < rows; r = r + 1) {
        var row = bayan_json_v_arr_get(fs, r);
        if (bayan_json_v_tag(row) != JTAG_ARR) { return _bj_jr_type(row, "a sequence"); }
        if (bayan_json_v_arr_len(row) != p) { return _bj_jr_shape("an SMatrix row is not ports long"); }
    }
    if (rows != p) { return _bj_jr_shape("an SMatrix's s does not have ports rows"); }
    if (bayan_json_v_arr_len(fz) != p) { return _bj_jr_shape("an SMatrix's z0 is not ports long"); }
    if (want >= 0 && p != want) { return _bj_jr_shape("a TouchstoneData matrix's ports differ from the data's"); }
    w[1] = fs;
    w[2] = fz;
    return 0;
}

# The entries and impedances of a checked SMatrix node (its s and z0 nodes) into the matrix m: 0, or the code
# recorded.
fn _bj_jr_sm_fill(fs, fz, m: *BjSMatrix): i64 {
    var p = m.ports;
    for (var r = 0; r < p; r = r + 1) {
        var row = bayan_json_v_arr_get(fs, r);
        for (var c = 0; c < p; c = c + 1) {
            var e = _bj_jr_complex(bayan_json_v_arr_get(row, c), m.s + (r * p + c) * 16);
            if (e != 0) { return e; }
        }
    }
    for (var k = 0; k < p; k = k + 1) {
        var e2 = _bj_jr_f64(bayan_json_v_arr_get(fz, k), m.z0 + k * 8);
        if (e2 != 0) { return e2; }
    }
    return 0;
}

# A whole SMatrix document's node into a new matrix at w (a BjSMatrix): 0, or the code recorded with nothing kept.
fn _bj_jr_smatrix(v, w): i64 {
    var nodes: i64[3];
    var c = _bj_jr_sm_check(v, 0 - 1, &nodes);
    if (c != 0) { return c; }
    var t, e = BjSMatrix_new(nodes[0], 0.0, w);
    if (is_err_result(t) == 1) { return e; }
    var f = _bj_jr_sm_fill(nodes[1], nodes[2], w);
    if (f != 0) { BjSMatrix_free(w); }
    return f;
}

# A TouchstoneFormat node into w[0]: a string, or a one-member object whose value is null (serde's two forms of a
# unit variant), naming one of the three variants. 0, or BJ_ERR_DESERIALIZE recorded.
fn _bj_jr_ts_format(v, w): i64 {
    var tag = bayan_json_v_tag(v);
    var name = 0;
    if (tag == JTAG_STR) { name = bayan_json_v_str(v); }
    elif (tag == JTAG_OBJ && bayan_json_v_obj_len(v) == 1) {
        if (bayan_json_v_tag(bayan_json_v_obj_val(v, 0)) != JTAG_NULL) {
            return _bj_jr_type(bayan_json_v_obj_val(v, 0), "unit");
        }
        name = bayan_json_v_obj_key(v, 0);
    } else {
        return _bj_jr_type(v, "enum TouchstoneFormat");
    }
    for (var k = 0; k < 3; k = k + 1) {
        var lit = _bj_ts_format_name(k);
        if (str_len(name) == strlen(lit) && memeq(str_data(name), lit, strlen(lit)) == 1) {
            store64(w, k);
            return 0;
        }
    }
    var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
    _bj_tx_cstr(t, "unknown variant, expected one of `MagnitudeAngle`, `RealImag`, `DbAngle`");
    return BJ_ERR_DESERIALIZE;
}

# The address a as a *BjTouchstoneData (an untyped word stored into a typed pointer warns; a typed return does not).
#must_use
fn _bj_jr_tdp(a): *BjTouchstoneData {
    return a;
}

# A TouchstoneData document's node into new data at w (a BjTouchstoneData): its fields, then row 36's shape (as many
# matrices as frequencies, each a checked ports-port matrix), then the block, filled. 0, or the code recorded with
# nothing kept.
fn _bj_jr_ts_data(v, w): i64 {
    var form = _bj_jr_form(v, 4, "struct TouchstoneData");
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    var hdr: i64[1];
    var fp = _bj_jr_field(v, form, 0, "ports");
    if (fp == 0) { return BJ_ERR_DESERIALIZE; }
    var c = _bj_jr_usize(fp, &hdr);
    if (c != 0) { return c; }
    var fz = _bj_jr_field(v, form, 1, "z0");
    if (fz == 0) { return BJ_ERR_DESERIALIZE; }
    var zb: i64[1];
    c = _bj_jr_f64(fz, &zb);
    if (c != 0) { return c; }
    var ff = _bj_jr_field(v, form, 2, "frequencies");
    if (ff == 0) { return BJ_ERR_DESERIALIZE; }
    if (bayan_json_v_tag(ff) != JTAG_ARR) { return _bj_jr_type(ff, "a sequence"); }
    var fm = _bj_jr_field(v, form, 3, "s_matrices");
    if (fm == 0) { return BJ_ERR_DESERIALIZE; }
    if (bayan_json_v_tag(fm) != JTAG_ARR) { return _bj_jr_type(fm, "a sequence"); }
    var points = bayan_json_v_arr_len(ff);
    var junk: f64[1];
    for (var k = 0; k < points; k = k + 1) {
        c = _bj_jr_f64(bayan_json_v_arr_get(ff, k), &junk);
        if (c != 0) { return c; }
    }
    var nodes: i64[3];
    var mats = bayan_json_v_arr_len(fm);
    for (var j = 0; j < mats; j = j + 1) {
        c = _bj_jr_sm_check(bayan_json_v_arr_get(fm, j), hdr[0], &nodes);
        if (c != 0) { return c; }
    }
    if (mats != points) { return _bj_jr_shape("a TouchstoneData's frequencies and matrices differ in number"); }
    var z0: f64 = _bj_from_bits(zb[0]);
    var t, e = BjTouchstoneData_new(hdr[0], z0, points, w);
    if (is_err_result(t) == 1) { return e; }
    var d: *BjTouchstoneData = _bj_jr_tdp(w);
    for (var q = 0; q < points; q = q + 1) {
        _bj_jr_f64(bayan_json_v_arr_get(ff, q), d.frequencies + q * 8);
        _bj_jr_sm_check(bayan_json_v_arr_get(fm, q), hdr[0], &nodes);
        c = _bj_jr_sm_fill(nodes[1], nodes[2], d.matrix_at(q));
        if (c != 0) {
            BjTouchstoneData_free(d);
            return c;
        }
    }
    return 0;
}

# Reads an `SMatrix` document from [buf, buf + len) into a new matrix in *out: Ok(0), or Err with the reason recorded
# and out empty (never read), errors as BjComplex_from_json. Its shape is fixed (ADR 0002 row 36): `s` must be
# ports rows of ports entries and `z0` ports long, where serde reads any lengths (and a port count past 2^63 − 1, which
# no matrix holds, is refused). Give the matrix back with BjSMatrix_free. Mirrors `serde_json::from_str::<SMatrix>`.
#must_use
public fn BjSMatrix_from_json(buf, len, out: *BjSMatrix): Result {
    memset(out, 0, sizeof(BjSMatrix));
    var m: BjSMatrix;
    var code = _bj_jr_read(buf, len, &_bj_jr_smatrix, &m);
    if (code != 0) { return Err(code); }
    out.ports = m.ports;
    out.s = m.s;
    out.z0 = m.z0;
    return Ok(0);
}

# Reads a `TouchstoneFormat` document from [buf, buf + len) into *out (BJ_TOUCHSTONE_FORMAT_*): Ok(0), or Err with
# the reason recorded and out untouched. serde's two forms of a unit variant: its name as a string, or a one-member
# object mapping the name to null. Mirrors `serde_json::from_str::<TouchstoneFormat>`.
#must_use
public fn BjTouchstoneFormat_from_json(buf, len, out: *i64): Result {
    var w: i64[1];
    var code = _bj_jr_read(buf, len, &_bj_jr_ts_format, &w);
    if (code != 0) { return Err(code); }
    out[0] = w[0];
    return Ok(0);
}

# Reads a `TouchstoneData` document from [buf, buf + len) into new data in *out: Ok(0), or Err with the reason
# recorded and out empty (never read), errors as BjComplex_from_json. Its shape is fixed (ADR 0002 row 36): as many
# matrices as frequencies, each a ports-port SMatrix of the data's ports, where serde reads any. Give the data back
# with BjTouchstoneData_free. Mirrors `serde_json::from_str::<TouchstoneData>`.
#must_use
public fn BjTouchstoneData_from_json(buf, len, out: *BjTouchstoneData): Result {
    memset(out, 0, sizeof(BjTouchstoneData));
    var d: BjTouchstoneData;
    var code = _bj_jr_read(buf, len, &_bj_jr_ts_data, &d);
    if (code != 0) { return Err(code); }
    out.ports = d.ports;
    out.z0 = d.z0;
    out.points = d.points;
    out.frequencies = d.frequencies;
    out.s_matrices = d.s_matrices;
    return Ok(0);
}

# ── the FDTD types (M5 part 1f) ──────────────────────────────────────────────────────────────────────────────────

# Appends the n f64 at p as `[a,b,..]`; the new length.
fn _bj_jw_f64_vec(buf, n, p, k): i64 {
    var m = n;
    store8(buf + m, 91);
    m = m + 1;
    for (var j = 0; j < k; j = j + 1) {
        if (j > 0) {
            store8(buf + m, 44);
            m = m + 1;
        }
        m = _bj_jw_f64(buf, m, load64(p + j * 8));
    }
    store8(buf + m, 93);
    return m + 1;
}

# Appends `{"<k0>":[..],"<k1>":[..],"<k2>":[..]}` (three Vec<f64>, the keys' text with their quotes and colons at
# keys[0..3]) to sb, built in one fl_alloc block of 64 + 26 bytes a value (an f64 at most 25, and its comma): Ok(0), or
# Err(BJ_ERR_ALLOCATION) with sb as it was.
fn _bj_jw_three_vecs(sb, keys: *i64, p: *i64, k: *i64): Result {
    var buf = fl_alloc(64 + (k[0] + k[1] + k[2]) * 26);
    if (buf == 0) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "the JSON document's buffer");
        return Err(BJ_ERR_ALLOCATION);
    }
    var n = _bj_jw_cstr(buf, 0, "{");
    for (var f = 0; f < 3; f = f + 1) {
        if (f > 0) { n = _bj_jw_cstr(buf, n, ","); }
        n = _bj_jw_cstr(buf, n, keys[f]);
        n = _bj_jw_f64_vec(buf, n, p[f], k[f]);
    }
    n = _bj_jw_cstr(buf, n, "}");
    var t, v = _bj_jw_put(sb, buf, n);
    fl_free(buf);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(0);
}

# Appends `{"eps_r":<ε_r>,"conductivity":<σ>}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was.
# Mirrors `serde_json::to_string(&m)` for `fdtd::LossyMaterial`.
#must_use
public fn BjLossyMaterial_to_json(m: *BjLossyMaterial, sb): Result {
    var buf[96];
    var n = _bj_jw_cstr(&buf, 0, "{\"eps_r\":");
    n = _bj_jw_f64(&buf, n, m.eps_r);
    n = _bj_jw_cstr(&buf, n, ",\"conductivity\":");
    n = _bj_jw_f64(&buf, n, m.conductivity);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"eps_inf":<ε_∞>,"omega_p":<ω_p>,"gamma":<γ>}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb
# as it was. Mirrors `serde_json::to_string(&m)` for `fdtd::DrudeMaterial`.
#must_use
public fn BjDrudeMaterial_to_json(m: *BjDrudeMaterial, sb): Result {
    var buf[128];
    var n = _bj_jw_cstr(&buf, 0, "{\"eps_inf\":");
    n = _bj_jw_f64(&buf, n, m.eps_inf);
    n = _bj_jw_cstr(&buf, n, ",\"omega_p\":");
    n = _bj_jw_f64(&buf, n, m.omega_p);
    n = _bj_jw_cstr(&buf, n, ",\"gamma\":");
    n = _bj_jw_f64(&buf, n, m.gamma);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"eps_inf":<ε_∞>,"delta_eps":<Δε>,"omega_0":<ω₀>,"gamma":<γ>}` to the builder sb: Ok(0), or
# Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors `serde_json::to_string(&m)` for `fdtd::LorentzMaterial`.
#must_use
public fn BjLorentzMaterial_to_json(m: *BjLorentzMaterial, sb): Result {
    var buf[160];
    var n = _bj_jw_cstr(&buf, 0, "{\"eps_inf\":");
    n = _bj_jw_f64(&buf, n, m.eps_inf);
    n = _bj_jw_cstr(&buf, n, ",\"delta_eps\":");
    n = _bj_jw_f64(&buf, n, m.delta_eps);
    n = _bj_jw_cstr(&buf, n, ",\"omega_0\":");
    n = _bj_jw_f64(&buf, n, m.omega_0);
    n = _bj_jw_cstr(&buf, n, ",\"gamma\":");
    n = _bj_jw_f64(&buf, n, m.gamma);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"eps_inf":<ε_∞>,"eps_s":<ε_s>,"tau":<τ>}` to the builder sb: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it
# was. Mirrors `serde_json::to_string(&m)` for `fdtd::DebyeMaterial`.
#must_use
public fn BjDebyeMaterial_to_json(m: *BjDebyeMaterial, sb): Result {
    var buf[128];
    var n = _bj_jw_cstr(&buf, 0, "{\"eps_inf\":");
    n = _bj_jw_f64(&buf, n, m.eps_inf);
    n = _bj_jw_cstr(&buf, n, ",\"eps_s\":");
    n = _bj_jw_f64(&buf, n, m.eps_s);
    n = _bj_jw_cstr(&buf, n, ",\"tau\":");
    n = _bj_jw_f64(&buf, n, m.tau);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"dx":[..],"dy":[..],"dz":[..]}` to the builder sb, each axis's widths in order: Ok(0), or
# Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors `serde_json::to_string(&g)` for `fdtd::NonUniformGrid`.
#must_use
public fn BjNonUniformGrid_to_json(g: *BjNonUniformGrid, sb): Result {
    var keys: i64[3];
    var p: i64[3];
    var k: i64[3];
    keys[0] = "\"dx\":";
    keys[1] = "\"dy\":";
    keys[2] = "\"dz\":";
    p[0] = g.dx;
    p[1] = g.dy;
    p[2] = g.dz;
    k[0] = g.nx;
    k[1] = g.ny;
    k[2] = g.nz;
    return _bj_jw_three_vecs(sb, &keys, &p, &k);
}

# Appends `{"frequencies":[..],"quality_factors":[..],"amplitudes":[..]}` to the builder sb, each of the result's count
# values: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors `serde_json::to_string(&r)` for
# `fdtd::EigenmodeResult`.
#must_use
public fn BjEigenmodeResult_to_json(r: *BjEigenmodeResult, sb): Result {
    var keys: i64[3];
    var p: i64[3];
    var k: i64[3];
    keys[0] = "\"frequencies\":";
    keys[1] = "\"quality_factors\":";
    keys[2] = "\"amplitudes\":";
    p[0] = r.frequencies;
    p[1] = r.quality_factors;
    p[2] = r.amplitudes;
    k[0] = r.count;
    k[1] = r.count;
    k[2] = r.count;
    return _bj_jw_three_vecs(sb, &keys, &p, &k);
}

# The decoders of the four materials, each an all-f64 struct.
fn _bj_jr_lossy(v, w): i64 {
    var names: i64[2];
    names[0] = "eps_r";
    names[1] = "conductivity";
    return _bj_jr_f64_struct(v, &names, 2, "struct LossyMaterial", w);
}

fn _bj_jr_drude(v, w): i64 {
    var names: i64[3];
    names[0] = "eps_inf";
    names[1] = "omega_p";
    names[2] = "gamma";
    return _bj_jr_f64_struct(v, &names, 3, "struct DrudeMaterial", w);
}

fn _bj_jr_lorentz(v, w): i64 {
    var names: i64[4];
    names[0] = "eps_inf";
    names[1] = "delta_eps";
    names[2] = "omega_0";
    names[3] = "gamma";
    return _bj_jr_f64_struct(v, &names, 4, "struct LorentzMaterial", w);
}

fn _bj_jr_debye(v, w): i64 {
    var names: i64[3];
    names[0] = "eps_inf";
    names[1] = "eps_s";
    names[2] = "tau";
    return _bj_jr_f64_struct(v, &names, 3, "struct DebyeMaterial", w);
}

# The three `Vec<f64>` fields, named names[0..3], of struct node v (`what` names it): their array nodes into
# nodes[0..3], each checked to be an array. 0, or the code recorded.
fn _bj_jr_three_vecs(v, names: *i64, what, nodes: *i64): i64 {
    var form = _bj_jr_form(v, 3, what);
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    for (var f = 0; f < 3; f = f + 1) {
        var node = _bj_jr_field(v, form, f, names[f]);
        if (node == 0) { return BJ_ERR_DESERIALIZE; }
        if (bayan_json_v_tag(node) != JTAG_ARR) { return _bj_jr_type(node, "a sequence"); }
        nodes[f] = node;
    }
    return 0;
}

# Array node v's n numbers into out[0..n]. 0, or the code recorded.
fn _bj_jr_f64_elems(v, n, out): i64 {
    for (var k = 0; k < n; k = k + 1) {
        var c = _bj_jr_f64(bayan_json_v_arr_get(v, k), out + k * 8);
        if (c != 0) { return c; }
    }
    return 0;
}

# A NonUniformGrid into w (a BjNonUniformGrid, its block allocated here, so the caller frees it on a failure; w's
# block is 0 on entry): three arrays of any lengths.
fn _bj_jr_nonuniform(v, w): i64 {
    var names: i64[3];
    var nodes: i64[3];
    names[0] = "dx";
    names[1] = "dy";
    names[2] = "dz";
    var c = _bj_jr_three_vecs(v, &names, "struct NonUniformGrid", &nodes);
    if (c != 0) { return c; }
    var nx = bayan_json_v_arr_len(nodes[0]);
    var ny = bayan_json_v_arr_len(nodes[1]);
    var nz = bayan_json_v_arr_len(nodes[2]);
    var g: BjNonUniformGrid;
    var t, e = BjNonUniformGrid_uniform(nx, ny, nz, 0.0, &g);
    if (is_err_result(t) == 1) { return e; }
    memcpy(w, &g, 56);
    c = _bj_jr_f64_elems(nodes[0], nx, g.dx);
    if (c == 0) { c = _bj_jr_f64_elems(nodes[1], ny, g.dy); }
    if (c == 0) { c = _bj_jr_f64_elems(nodes[2], nz, g.dz); }
    return c;
}

# An EigenmodeResult into w (a BjEigenmodeResult, its block allocated here, so the caller frees it on a failure; w's
# frequencies are 0 on entry): three arrays, which must be equally long (ADR 0002 row 36: the port's result has one
# count, where serde reads any lengths).
fn _bj_jr_eigen(v, w): i64 {
    var names: i64[3];
    var nodes: i64[3];
    names[0] = "frequencies";
    names[1] = "quality_factors";
    names[2] = "amplitudes";
    var c = _bj_jr_three_vecs(v, &names, "struct EigenmodeResult", &nodes);
    if (c != 0) { return c; }
    var n = bayan_json_v_arr_len(nodes[0]);
    if (bayan_json_v_arr_len(nodes[1]) != n || bayan_json_v_arr_len(nodes[2]) != n) {
        return _bj_jr_shape("an EigenmodeResult whose three arrays differ in length");
    }
    var b = 0;
    if (n > 0) {
        b = fl_alloc(n * 24);
        if (b == 0) {
            _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "the eigenmode result read");
            return BJ_ERR_ALLOCATION;
        }
    }
    store64(w, b);
    store64(w + 8, b + n * 8);
    store64(w + 16, b + n * 16);
    store64(w + 24, n);
    if (n == 0) {
        store64(w + 8, 0);
        store64(w + 16, 0);
    }
    for (var f = 0; f < 3; f = f + 1) {
        c = _bj_jr_f64_elems(nodes[f], n, b + f * n * 8);
        if (c != 0) { return c; }
    }
    return 0;
}

# Reads a `LossyMaterial` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched,
# as BjComplex_from_json. The fields are read as written, as serde's derive reads Rust's public fields. Mirrors
# `serde_json::from_str::<LossyMaterial>`.
#must_use
public fn BjLossyMaterial_from_json(buf, len, out: *BjLossyMaterial): Result {
    var w: f64[2];
    var code = _bj_jr_read(buf, len, &_bj_jr_lossy, &w);
    if (code != 0) { return Err(code); }
    out.eps_r = w[0];
    out.conductivity = w[1];
    return Ok(0);
}

# Reads a `DrudeMaterial` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched,
# as BjComplex_from_json; the fields as written. Mirrors `serde_json::from_str::<DrudeMaterial>`.
#must_use
public fn BjDrudeMaterial_from_json(buf, len, out: *BjDrudeMaterial): Result {
    var w: f64[3];
    var code = _bj_jr_read(buf, len, &_bj_jr_drude, &w);
    if (code != 0) { return Err(code); }
    out.eps_inf = w[0];
    out.omega_p = w[1];
    out.gamma = w[2];
    return Ok(0);
}

# Reads a `LorentzMaterial` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched,
# as BjComplex_from_json; the fields as written. Mirrors `serde_json::from_str::<LorentzMaterial>`.
#must_use
public fn BjLorentzMaterial_from_json(buf, len, out: *BjLorentzMaterial): Result {
    var w: f64[4];
    var code = _bj_jr_read(buf, len, &_bj_jr_lorentz, &w);
    if (code != 0) { return Err(code); }
    out.eps_inf = w[0];
    out.delta_eps = w[1];
    out.omega_0 = w[2];
    out.gamma = w[3];
    return Ok(0);
}

# Reads a `DebyeMaterial` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched,
# as BjComplex_from_json; the fields as written (an ε_s below ε_∞ too). Mirrors `serde_json::from_str::<DebyeMaterial>`.
#must_use
public fn BjDebyeMaterial_from_json(buf, len, out: *BjDebyeMaterial): Result {
    var w: f64[3];
    var code = _bj_jr_read(buf, len, &_bj_jr_debye, &w);
    if (code != 0) { return Err(code); }
    out.eps_inf = w[0];
    out.eps_s = w[1];
    out.tau = w[2];
    return Ok(0);
}

# Reads a `NonUniformGrid` document from [buf, buf + len) into a new grid in *out: Ok(0), or the error recorded with
# out empty (never read), errors as BjComplex_from_json; each axis an array of any length, its widths as written (a
# grid validate refuses too). Give it back with BjNonUniformGrid_free. Mirrors `serde_json::from_str::<NonUniformGrid>`.
#must_use
public fn BjNonUniformGrid_from_json(buf, len, out: *BjNonUniformGrid): Result {
    memset(out, 0, sizeof(BjNonUniformGrid));
    var g: BjNonUniformGrid;
    g.block = 0;
    g.nx = 0;
    g.ny = 0;
    g.nz = 0;
    var code = _bj_jr_read(buf, len, &_bj_jr_nonuniform, &g);
    if (code != 0) {
        BjNonUniformGrid_free(&g);
        return Err(code);
    }
    memcpy(out, &g, 56);
    return Ok(0);
}

# Reads an `EigenmodeResult` document from [buf, buf + len) into a new result in *out: Ok(0), or the error recorded
# with out empty (never read), errors as BjComplex_from_json. Its three arrays must be equally long (ADR 0002 row 36),
# where serde reads any. Give it back with BjEigenmodeResult_free. Mirrors `serde_json::from_str::<EigenmodeResult>`.
#must_use
public fn BjEigenmodeResult_from_json(buf, len, out: *BjEigenmodeResult): Result {
    memset(out, 0, sizeof(BjEigenmodeResult));
    var r: BjEigenmodeResult;
    r.frequencies = 0;
    r.count = 0;
    var code = _bj_jr_read(buf, len, &_bj_jr_eigen, &r);
    if (code != 0) {
        BjEigenmodeResult_free(&r);
        return Err(code);
    }
    out.frequencies = r.frequencies;
    out.quality_factors = r.quality_factors;
    out.amplitudes = r.amplitudes;
    out.count = r.count;
    return Ok(0);
}

# ── the 2D FDTD types (M6 part 1d) ───────────────────────────────────────────────────────────────────────────────

# Appends `{"thickness":<n>,"grading_order":<m>,"sigma_ratio":<r>,"kappa_max":<κ>,"alpha_max":<α>}` to the builder sb,
# the thickness as an unsigned 64-bit integer (Rust's usize), the fields as held (parameters BjCpml_with_params would
# refuse too): Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors `serde_json::to_string(&p)` for
# `fdtd::CpmlParams`.
#must_use
public fn BjCpmlParams_to_json(p: *BjCpmlParams, sb): Result {
    var buf[224];
    var n = _bj_jw_cstr(&buf, 0, "{\"thickness\":");
    n = _bj_jw_u64(&buf, n, p.thickness);
    n = _bj_jw_cstr(&buf, n, ",\"grading_order\":");
    n = _bj_jw_f64(&buf, n, p.grading_order);
    n = _bj_jw_cstr(&buf, n, ",\"sigma_ratio\":");
    n = _bj_jw_f64(&buf, n, p.sigma_ratio);
    n = _bj_jw_cstr(&buf, n, ",\"kappa_max\":");
    n = _bj_jw_f64(&buf, n, p.kappa_max);
    n = _bj_jw_cstr(&buf, n, ",\"alpha_max\":");
    n = _bj_jw_f64(&buf, n, p.alpha_max);
    n = _bj_jw_cstr(&buf, n, "}");
    return _bj_jw_put(sb, &buf, n);
}

# Appends the mode's document, its variant's name in quotes (`"Tm"`, `"Te"`), to the builder sb: Ok(0),
# Err(BJ_ERR_ALLOCATION) with sb as it was, or Err(BJ_ERR_INVALID_PARAMETER) "unknown 2D mode {mode}" for a word that
# is no BjMode2d (Rust's enum has no other), as BjFdtd2d_new refuses it. Mirrors `serde_json::to_string(&m)` for
# `fdtd::Mode2d`.
#must_use
public fn BjMode2d_to_json(mode, sb): Result {
    if (mode != BJ_MODE2D_TM && mode != BJ_MODE2D_TE) {
        var t0 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t0, "unknown 2D mode ");
        _bj_tx_i64(t0, mode);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var buf[8];
    var n = 0;
    if (mode == BJ_MODE2D_TE) { n = _bj_jw_cstr(&buf, 0, "\"Te\""); }
    else { n = _bj_jw_cstr(&buf, 0, "\"Tm\""); }
    return _bj_jw_put(sb, &buf, n);
}

# A CpmlParams node into the BjCpmlParams at w: `thickness` a usize (_bj_jr_usize: an integer from 0 to 2^63 − 1,
# since bayan's tree keeps no exact integer past it, ADR 0002 row 36), the four f64 as written. 0, or
# BJ_ERR_DESERIALIZE recorded.
fn _bj_jr_cpml_params(v, w): i64 {
    var form = _bj_jr_form(v, 5, "struct CpmlParams");
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    var names: i64[5];
    names[0] = "thickness";
    names[1] = "grading_order";
    names[2] = "sigma_ratio";
    names[3] = "kappa_max";
    names[4] = "alpha_max";
    for (var k = 0; k < 5; k = k + 1) {
        var f = _bj_jr_field(v, form, k, names[k]);
        if (f == 0) { return BJ_ERR_DESERIALIZE; }
        var c = 0;
        if (k == 0) { c = _bj_jr_usize(f, w); }
        else { c = _bj_jr_f64(f, w + k * 8); }
        if (c != 0) { return c; }
    }
    return 0;
}

# A Mode2d node into w[0]: a string, or a one-member object whose value is null (serde's two forms of a unit variant),
# naming `Tm` or `Te`. 0, or BJ_ERR_DESERIALIZE recorded.
fn _bj_jr_mode2d(v, w): i64 {
    var tag = bayan_json_v_tag(v);
    var name = 0;
    if (tag == JTAG_STR) { name = bayan_json_v_str(v); }
    elif (tag == JTAG_OBJ && bayan_json_v_obj_len(v) == 1) {
        if (bayan_json_v_tag(bayan_json_v_obj_val(v, 0)) != JTAG_NULL) {
            return _bj_jr_type(bayan_json_v_obj_val(v, 0), "unit");
        }
        name = bayan_json_v_obj_key(v, 0);
    } else {
        return _bj_jr_type(v, "enum Mode2d");
    }
    if (str_len(name) == 2 && memeq(str_data(name), "Tm", 2) == 1) {
        store64(w, BJ_MODE2D_TM);
        return 0;
    }
    if (str_len(name) == 2 && memeq(str_data(name), "Te", 2) == 1) {
        store64(w, BJ_MODE2D_TE);
        return 0;
    }
    _bj_tx_cstr(_bj_err_reason(BJ_ERR_DESERIALIZE), "unknown variant, expected `Tm` or `Te`");
    return BJ_ERR_DESERIALIZE;
}

# Reads a `CpmlParams` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched, as
# BjComplex_from_json. The fields are read as written, as serde's derive reads Rust's public fields: parameters
# BjCpml_with_params refuses (a zero thickness, a grading order below 1) are read, and refused when used. A thickness
# past 2^63 − 1, which serde reads, is refused (ADR 0002 row 36): no grid fits it and no profile can be allocated for
# it. Mirrors `serde_json::from_str::<CpmlParams>`.
#must_use
public fn BjCpmlParams_from_json(buf, len, out: *BjCpmlParams): Result {
    var p: BjCpmlParams;
    var code = _bj_jr_read(buf, len, &_bj_jr_cpml_params, &p);
    if (code != 0) { return Err(code); }
    out.thickness = p.thickness;
    out.grading_order = p.grading_order;
    out.sigma_ratio = p.sigma_ratio;
    out.kappa_max = p.kappa_max;
    out.alpha_max = p.alpha_max;
    return Ok(0);
}

# Reads a `Mode2d` document from [buf, buf + len) into *out (BJ_MODE2D_TM or BJ_MODE2D_TE): Ok(0), or Err with the
# reason recorded and out untouched. serde's two forms of a unit variant: its name as a string, or a one-member object
# mapping the name to null. Mirrors `serde_json::from_str::<Mode2d>`.
#must_use
public fn BjMode2d_from_json(buf, len, out: *i64): Result {
    var w: i64[1];
    var code = _bj_jr_read(buf, len, &_bj_jr_mode2d, &w);
    if (code != 0) { return Err(code); }
    out[0] = w[0];
    return Ok(0);
}

# ── soorat's visualization types (M7 part 1b-2) ──────────────────────────────────────────────────────────────────────

# The largest count a writer takes: freelist's largest block is 2 GiB, so no array a constructor or reader made is
# longer. A hand-filled struct claiming more is refused as Allocation before anything is written.
var _BJ_JW_MAX = 268435456;

# Appends the bytes [s, s + k) as a JSON string, escaped as serde_json escapes it: `"` and `\` after a backslash, the
# control bytes U+0000..U+001F as `\b` `\t` `\n` `\f` `\r` or `\u00xx` (lowercase hex), every other byte as it is
# (UTF-8 passes through; U+007F is not escaped); the new length (at most 6k + 2 bytes more).
public fn _bj_jw_str(buf, n, s, k): i64 {
    var m = n;
    store8(buf + m, 34);
    m = m + 1;
    for (var i = 0; i < k; i = i + 1) {
        var c = load8(s + i);
        if (c == 34 || c == 92) {
            store8(buf + m, 92);
            store8(buf + m + 1, c);
            m = m + 2;
        } elif (c >= 32) {
            store8(buf + m, c);
            m = m + 1;
        } else {
            var e = 0;
            if (c == 8) { e = 98; }
            elif (c == 9) { e = 116; }
            elif (c == 10) { e = 110; }
            elif (c == 12) { e = 102; }
            elif (c == 13) { e = 114; }
            store8(buf + m, 92);
            if (e != 0) {
                store8(buf + m + 1, e);
                m = m + 2;
            } else {
                var hex = "0123456789abcdef";
                store8(buf + m + 1, 117);
                store8(buf + m + 2, 48);
                store8(buf + m + 3, 48);
                store8(buf + m + 4, load8(hex + (c >> 4)));
                store8(buf + m + 5, load8(hex + (c & 15)));
                m = m + 6;
            }
        }
    }
    store8(buf + m, 34);
    return m + 1;
}

# Appends the f32 x (widened to f64, which is exact) as serde_json writes an f32 (_bj_fmt_f32_json: at most 17 bytes,
# with 32 bytes of room needed at buf + n); the new length.
fn _bj_jw_f32(buf, n, x: f64): i64 {
    var t[24];
    _bj_tx_init(&t, buf + n, 32);
    _bj_fmt_f32_json(&t, x);
    return n + _bj_tx_len(&t);
}

# Appends `[a,b]` (k = 2) or `[a,b,c]` (k = 3) for the k words at p, as unsigned integers (Rust's usize); the new
# length.
fn _bj_jw_u64s(buf, n, p: *i64, k): i64 {
    var m = n;
    for (var j = 0; j < k; j = j + 1) {
        if (j == 0) { store8(buf + m, 91); } else { store8(buf + m, 44); }
        m = _bj_jw_u64(buf, m + 1, p[j]);
    }
    store8(buf + m, 93);
    return m + 1;
}

# Appends `[[x,y,z],..]` for the k triples (3k f64) at p; the new length.
fn _bj_jw_triples(buf, n, p, k): i64 {
    var m = n;
    store8(buf + m, 91);
    m = m + 1;
    for (var j = 0; j < k; j = j + 1) {
        if (j > 0) {
            store8(buf + m, 44);
            m = m + 1;
        }
        var q = p + j * 24;
        m = _bj_jw_triple(buf, m, load64(q), load64(q + 8), load64(q + 16));
    }
    store8(buf + m, 93);
    return m + 1;
}

# Records Allocation for a writer's buffer; returns its code.
public fn _bj_jw_nobuf(): i64 {
    _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "the JSON document's buffer");
    return BJ_ERR_ALLOCATION;
}

# A writer's buffer of `bytes` bytes (fl_alloc), or 0 with Allocation recorded.
public fn _bj_jw_buf(bytes): i64 {
    var b = fl_alloc(bytes);
    if (b == 0) { _bj_jw_nobuf(); }
    return b;
}

# A word as a *BjFieldLine.
#must_use
fn _bj_jw_linep(a): *BjFieldLine {
    return a;
}

# A word as a *BjChargePoint.
#must_use
fn _bj_jw_cpp(a): *BjChargePoint {
    return a;
}

# 1 when the count n is one a writer takes (0 ≤ n ≤ _BJ_JW_MAX).
#must_use
fn _bj_jw_count_ok(n): i64 {
    if (n < 0 || n > _BJ_JW_MAX) { return 0; }
    return 1;
}

# Appends buf's document [buf, buf + n) to sb and gives buf back: Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was.
#must_use
public fn _bj_jw_put_free(sb, buf, n): Result {
    var t, v = _bj_jw_put(sb, buf, n);
    fl_free(buf);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(0);
}

# Appends a field slice's or volume's document to the builder sb: nd (2 or 3) dimensions at dims and origin values at
# org, the other fields given. Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was.
#must_use
fn _bj_jw_slice(sb, values, nv, dims: *i64, org: *i64, nd, spacing, comp, nc, step): Result {
    if (_bj_jw_count_ok(nv) == 0 || _bj_jw_count_ok(nc) == 0) { return Err(_bj_jw_nobuf()); }
    # At their longest a float is 25 bytes (bayan's positional form, -0.0000012345678901234567) and a usize 20 digits:
    # a volume's fixed fields and the NUL take 258 bytes, its values 26 a value plus 1 (2 when empty), a component byte
    # 6 (\u00XX). 264 covers both cases.
    var buf = _bj_jw_buf(264 + nv * 26 + nc * 6);
    if (buf == 0) { return Err(BJ_ERR_ALLOCATION); }
    var n = _bj_jw_cstr(buf, 0, "{\"values\":");
    n = _bj_jw_f64_vec(buf, n, values, nv);
    n = _bj_jw_cstr(buf, n, ",\"dimensions\":");
    n = _bj_jw_u64s(buf, n, dims, nd);
    n = _bj_jw_cstr(buf, n, ",\"origin\":");
    if (nd == 2) { n = _bj_jw_f64_vec(buf, n, org, 2); }
    else { n = _bj_jw_triple(buf, n, org[0], org[1], org[2]); }
    n = _bj_jw_cstr(buf, n, ",\"spacing\":");
    n = _bj_jw_f64(buf, n, spacing);
    n = _bj_jw_cstr(buf, n, ",\"component\":");
    n = _bj_jw_str(buf, n, comp, nc);
    n = _bj_jw_cstr(buf, n, ",\"step\":");
    n = _bj_jw_u64(buf, n, step);
    n = _bj_jw_cstr(buf, n, "}");
    return _bj_jw_put_free(sb, buf, n);
}

# Appends `{"values":[..],"dimensions":[nx,ny],"origin":[x,y],"spacing":<Δ>,"component":"<name>","step":<n>}` to the
# builder sb: the values_len values in order, the dimensions and step as unsigned integers (Rust's usize), the
# component's component_len bytes as a JSON string (serde_json's escapes). The fields are written as held: a values_len
# other than nx·ny too. Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors `serde_json::to_string(&s)` for
# `integration::soorat::FieldSlice2D`.
#must_use
public fn BjFieldSlice2D_to_json(s: *BjFieldSlice2D, sb): Result {
    var dims: i64[2];
    var org: i64[2];
    dims[0] = s.dimensions.0;
    dims[1] = s.dimensions.1;
    var o0: f64 = s.origin.0;
    var o1: f64 = s.origin.1;
    org[0] = _bj_bits(o0);
    org[1] = _bj_bits(o1);
    return _bj_jw_slice(sb, s.values, s.values_len, &dims, &org, 2, s.spacing, s.component, s.component_len, s.step);
}

# Appends `{"values":[..],"dimensions":[nx,ny,nz],"origin":[x,y,z],"spacing":<Δ>,"component":"<name>","step":<n>}` to
# the builder sb, as BjFieldSlice2D_to_json. Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors
# `serde_json::to_string(&s)` for `integration::soorat::FieldSlice3D`.
#must_use
public fn BjFieldSlice3D_to_json(s: *BjFieldSlice3D, sb): Result {
    var dims: i64[3];
    var org: i64[3];
    dims[0] = s.dimensions.0;
    dims[1] = s.dimensions.1;
    dims[2] = s.dimensions.2;
    var o0: f64 = s.origin.0;
    var o1: f64 = s.origin.1;
    var o2: f64 = s.origin.2;
    org[0] = _bj_bits(o0);
    org[1] = _bj_bits(o1);
    org[2] = _bj_bits(o2);
    return _bj_jw_slice(sb, s.values, s.values_len, &dims, &org, 3, s.spacing, s.component, s.component_len, s.step);
}

# The bytes a field line's document needs, or 0 for a count past _BJ_JW_MAX.
#must_use
fn _bj_jw_line_size(l: *BjFieldLine): i64 {
    if (_bj_jw_count_ok(l.points_len) == 0 || _bj_jw_count_ok(l.magnitudes_len) == 0) { return 0; }
    return 64 + l.points_len * 80 + l.magnitudes_len * 26;
}

# Appends `{"points":[[x,y,z],..],"magnitudes":[..]}` for field line l; the new length.
fn _bj_jw_line(buf, n, l: *BjFieldLine): i64 {
    var m = _bj_jw_cstr(buf, n, "{\"points\":");
    m = _bj_jw_triples(buf, m, l.points, l.points_len);
    m = _bj_jw_cstr(buf, m, ",\"magnitudes\":");
    m = _bj_jw_f64_vec(buf, m, l.magnitudes, l.magnitudes_len);
    store8(buf + m, 125);
    return m + 1;
}

# Appends `{"points":[[x,y,z],..],"magnitudes":[..]}` to the builder sb, the points_len points and magnitudes_len
# magnitudes as held (lengths that differ too). Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors
# `serde_json::to_string(&l)` for `integration::soorat::FieldLine`.
#must_use
public fn BjFieldLine_to_json(l: *BjFieldLine, sb): Result {
    var size = _bj_jw_line_size(l);
    if (size == 0) { return Err(_bj_jw_nobuf()); }
    var buf = _bj_jw_buf(size);
    if (buf == 0) { return Err(BJ_ERR_ALLOCATION); }
    var n = _bj_jw_line(buf, 0, l);
    return _bj_jw_put_free(sb, buf, n);
}

# Appends `{"lines":[{"points":..,"magnitudes":..},..]}` to the builder sb, each of the lines_len lines as
# BjFieldLine_to_json writes it. Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors
# `serde_json::to_string(&v)` for `integration::soorat::FieldLineVisualization`.
#must_use
public fn BjFieldLineVisualization_to_json(v: *BjFieldLineVisualization, sb): Result {
    if (_bj_jw_count_ok(v.lines_len) == 0) { return Err(_bj_jw_nobuf()); }
    var ls: *BjFieldLine = _bj_jw_linep(v.lines);
    var size = 32;
    for (var i = 0; i < v.lines_len; i = i + 1) {
        var one = _bj_jw_line_size(ls + i);
        if (one == 0 || size > 1099511627776) { return Err(_bj_jw_nobuf()); }
        size = size + one + 1;
    }
    var buf = _bj_jw_buf(size);
    if (buf == 0) { return Err(BJ_ERR_ALLOCATION); }
    var n = _bj_jw_cstr(buf, 0, "{\"lines\":[");
    for (var j = 0; j < v.lines_len; j = j + 1) {
        if (j > 0) { n = _bj_jw_cstr(buf, n, ","); }
        n = _bj_jw_line(buf, n, ls + j);
    }
    n = _bj_jw_cstr(buf, n, "]}");
    return _bj_jw_put_free(sb, buf, n);
}

# Appends `{"position":[x,y,z],"charge":<q>,"magnitude":<|q|>}` for charge point c, each an f32 as serde_json writes
# one (_bj_jw_f32); the new length (at most 128 bytes, with 160 of room).
fn _bj_jw_charge(buf, n, c: *BjChargePoint): i64 {
    var x: f64 = f32_to(c.position_x);
    var y: f64 = f32_to(c.position_y);
    var z: f64 = f32_to(c.position_z);
    var q: f64 = f32_to(c.charge);
    var a: f64 = f32_to(c.magnitude);
    var m = _bj_jw_cstr(buf, n, "{\"position\":[");
    m = _bj_jw_f32(buf, m, x);
    store8(buf + m, 44);
    m = _bj_jw_f32(buf, m + 1, y);
    store8(buf + m, 44);
    m = _bj_jw_f32(buf, m + 1, z);
    m = _bj_jw_cstr(buf, m, "],\"charge\":");
    m = _bj_jw_f32(buf, m, q);
    m = _bj_jw_cstr(buf, m, ",\"magnitude\":");
    m = _bj_jw_f32(buf, m, a);
    store8(buf + m, 125);
    return m + 1;
}

# Appends `{"position":[x,y,z],"charge":<q>,"magnitude":<|q|>}` to the builder sb, each f32 as serde_json writes one:
# the shortest digits that read back to the same f32 (`0.1`, not the widened 0.10000000149011612), `null` for NaN and
# ±∞. Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors `serde_json::to_string(&c)` for
# `integration::soorat::ChargePoint`.
#must_use
public fn BjChargePoint_to_json(c: *BjChargePoint, sb): Result {
    var buf[160];
    var n = _bj_jw_charge(&buf, 0, c);
    return _bj_jw_put(sb, &buf, n);
}

# Appends `{"charges":[{"position":..,"charge":..,"magnitude":..},..]}` to the builder sb, each of the charges_len
# points as BjChargePoint_to_json writes it. Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors
# `serde_json::to_string(&v)` for `integration::soorat::ChargeVisualization`.
#must_use
public fn BjChargeVisualization_to_json(v: *BjChargeVisualization, sb): Result {
    if (_bj_jw_count_ok(v.charges_len) == 0) { return Err(_bj_jw_nobuf()); }
    var buf = _bj_jw_buf(192 + v.charges_len * 161);
    if (buf == 0) { return Err(BJ_ERR_ALLOCATION); }
    var cs: *BjChargePoint = _bj_jw_cpp(v.charges);
    var n = _bj_jw_cstr(buf, 0, "{\"charges\":[");
    for (var j = 0; j < v.charges_len; j = j + 1) {
        if (j > 0) { n = _bj_jw_cstr(buf, n, ","); }
        n = _bj_jw_charge(buf, n, cs + j);
    }
    n = _bj_jw_cstr(buf, n, "]}");
    return _bj_jw_put_free(sb, buf, n);
}

# Appends `{"angles":[..],"pattern":[..],"max_gain":<g>}` to the builder sb, the angles_len angles and pattern_len
# values as held. Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it was. Mirrors `serde_json::to_string(&p)` for
# `integration::soorat::RadiationPattern`.
#must_use
public fn BjRadiationPattern_to_json(p: *BjRadiationPattern, sb): Result {
    if (_bj_jw_count_ok(p.angles_len) == 0 || _bj_jw_count_ok(p.pattern_len) == 0) {
        return Err(_bj_jw_nobuf());
    }
    var buf = _bj_jw_buf(96 + (p.angles_len + p.pattern_len) * 26);
    if (buf == 0) { return Err(BJ_ERR_ALLOCATION); }
    var n = _bj_jw_cstr(buf, 0, "{\"angles\":");
    n = _bj_jw_f64_vec(buf, n, p.angles, p.angles_len);
    n = _bj_jw_cstr(buf, n, ",\"pattern\":");
    n = _bj_jw_f64_vec(buf, n, p.pattern, p.pattern_len);
    n = _bj_jw_cstr(buf, n, ",\"max_gain\":");
    n = _bj_jw_f64(buf, n, p.max_gain);
    n = _bj_jw_cstr(buf, n, "}");
    return _bj_jw_put_free(sb, buf, n);
}

# Appends `{"vectors":[[vx,vy,vz],..],"dimensions":[nx,ny,nz],"origin":[x,y,z],"spacing":<Δ>,"max_magnitude":<m>}` to
# the builder sb, the vectors_len vectors and the other fields as held. Ok(0), or Err(BJ_ERR_ALLOCATION) with sb as it
# was. Mirrors `serde_json::to_string(&v)` for `integration::soorat::VectorFieldSample`.
#must_use
public fn BjVectorFieldSample_to_json(v: *BjVectorFieldSample, sb): Result {
    if (_bj_jw_count_ok(v.vectors_len) == 0) { return Err(_bj_jw_nobuf()); }
    # The fixed fields and the NUL take 258 bytes at their longest (a float 25 bytes, a usize 20 digits), the vectors 80
    # a vector plus 1 (2 when empty): 264 covers both cases.
    var buf = _bj_jw_buf(264 + v.vectors_len * 80);
    if (buf == 0) { return Err(BJ_ERR_ALLOCATION); }
    var dims: i64[3];
    dims[0] = v.dimensions.0;
    dims[1] = v.dimensions.1;
    dims[2] = v.dimensions.2;
    var o0: f64 = v.origin.0;
    var o1: f64 = v.origin.1;
    var o2: f64 = v.origin.2;
    var n = _bj_jw_cstr(buf, 0, "{\"vectors\":");
    n = _bj_jw_triples(buf, n, v.vectors, v.vectors_len);
    n = _bj_jw_cstr(buf, n, ",\"dimensions\":");
    n = _bj_jw_u64s(buf, n, &dims, 3);
    n = _bj_jw_cstr(buf, n, ",\"origin\":");
    n = _bj_jw_triple(buf, n, o0, o1, o2);
    n = _bj_jw_cstr(buf, n, ",\"spacing\":");
    n = _bj_jw_f64(buf, n, v.spacing);
    n = _bj_jw_cstr(buf, n, ",\"max_magnitude\":");
    n = _bj_jw_f64(buf, n, v.max_magnitude);
    n = _bj_jw_cstr(buf, n, "}");
    return _bj_jw_put_free(sb, buf, n);
}

# A reader's block of `bytes` bytes (at least 8), or 0 with Allocation recorded.
fn _bj_jr_block(bytes): i64 {
    var n = bytes;
    if (n < 8) { n = 8; }
    var b = fl_alloc(n);
    if (b == 0) { _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "the JSON reader's array"); }
    return b;
}

# Array node v of numbers (a `Vec<f64>`) into a new block: its address into w[0] and its n values' count into w[1].
# 0, or the code recorded (w[0] then the block or 0, which the caller gives back).
fn _bj_jr_f64_vec(v, w: *i64): i64 {
    if (bayan_json_v_tag(v) != JTAG_ARR) { return _bj_jr_type(v, "a sequence"); }
    var n = bayan_json_v_arr_len(v);
    var b = _bj_jr_block(n * 8);
    if (b == 0) { return BJ_ERR_ALLOCATION; }
    w[0] = b;
    w[1] = n;
    return _bj_jr_f64_elems(v, n, b);
}

# Array node v of `[f64; 3]` (a `Vec<[f64; 3]>`) into a new block of 3n f64: its address into w[0], n into w[1]. 0, or
# the code recorded (w[0] then the block or 0, which the caller gives back).
fn _bj_jr_triples(v, w: *i64): i64 {
    if (bayan_json_v_tag(v) != JTAG_ARR) { return _bj_jr_type(v, "a sequence"); }
    var n = bayan_json_v_arr_len(v);
    var b = _bj_jr_block(n * 24);
    if (b == 0) { return BJ_ERR_ALLOCATION; }
    w[0] = b;
    w[1] = n;
    for (var k = 0; k < n; k = k + 1) {
        var c = _bj_jr_f64s(bayan_json_v_arr_get(v, k), 3, "an array of length 3", b + k * 24);
        if (c != 0) { return c; }
    }
    return 0;
}

# Node v as a `[usize; k]` (k 2 or 3) into out[0..k]: an array of exactly k integers from 0 to 2^63 − 1 (_bj_jr_usize,
# ADR 0002 row 36). 0, or the code recorded.
fn _bj_jr_usizes(v, k, out): i64 {
    var what = "an array of length 3";
    if (k == 2) { what = "an array of length 2"; }
    var c = _bj_jr_array(v, k, what);
    if (c != 0) { return c; }
    for (var j = 0; j < k; j = j + 1) {
        c = _bj_jr_usize(bayan_json_v_arr_get(v, j), out + j * 8);
        if (c != 0) { return c; }
    }
    return 0;
}

# String node v (a Rust `String`: JSON's escapes decoded, UTF-8) into a new block holding its bytes and a NUL: the
# address into w[0], the byte count into w[1]. 0, or the code recorded.
public fn _bj_jr_string(v, w: *i64): i64 {
    if (bayan_json_v_tag(v) != JTAG_STR) { return _bj_jr_type(v, "a string"); }
    var s = bayan_json_v_str(v);
    var n = str_len(s);
    var b = _bj_jr_block(n + 1);
    if (b == 0) { return BJ_ERR_ALLOCATION; }
    memcpy(b, str_data(s), n);
    store8(b + n, 0);
    w[0] = b;
    w[1] = n;
    return 0;
}

# ── f32, rounded once (ADR 0002 row 45) ──────────────────────────────────────────────────────────────────────────────
# A JSON number read into an f32 field is rounded once from its decimal value to the nearest f32, ties to even, as
# serde_json's `float_roundtrip` feature reads it; bijli's build of serde_json, which lacks it, reads the f64 and then
# casts it (`as f32`), rounding twice. Bayan's tree holds each number's correctly rounded f64 x, and the nearest f32 to
# x is the nearest f32 to the number unless x lies exactly halfway between two f32 (or between f32::MAX and 2^128):
# only then is the number itself compared with x, exactly, from the document's text.

# The f32 quantum's exponent q (the gap between f32 values near x is 2^q, −149 ≤ q ≤ 104) when the finite double with
# bits `bits` lies exactly halfway between two neighbouring f32 values, or between f32::MAX and 2^128; else 999.
#must_use
fn _bj_jr_f32_mid(bits): i64 {
    var mag = bits & 0x7FFFFFFFFFFFFFFF;
    var be = mag >> 52;
    if (mag == 0 || be >= 1151) { return 999; }
    var m = (mag & 0xFFFFFFFFFFFFF) | 0x10000000000000;
    var er = be - 1075;
    if (be == 0) {
        m = mag;
        er = 0 - 1074;
    }
    var q = er + 29;
    if (q < 0 - 149) { q = 0 - 149; }
    var sh = q - er;
    if (sh > 53) { return 999; }
    var low = m & ((1 << sh) - 1);
    if (low != (1 << (sh - 1))) { return 999; }
    return q;
}

# The number of number nodes met before node t in a document-order walk of node v, added to cnt[0]; 1 when t was met
# (the walk stops there), else 0. A document's number nodes come in the order of its number tokens.
fn _bj_jr_ord(v, t, cnt: *i64): i64 {
    if (v == t) { return 1; }
    var tag = bayan_json_v_tag(v);
    if (tag == JTAG_INT || tag == JTAG_FLOAT) {
        cnt[0] = cnt[0] + 1;
        return 0;
    }
    if (tag == JTAG_ARR) {
        var na = bayan_json_v_arr_len(v);
        for (var k = 0; k < na; k = k + 1) {
            if (_bj_jr_ord(bayan_json_v_arr_get(v, k), t, cnt) == 1) { return 1; }
        }
    } elif (tag == JTAG_OBJ) {
        var no = bayan_json_v_obj_len(v);
        for (var j = 0; j < no; j = j + 1) {
            if (_bj_jr_ord(bayan_json_v_obj_val(v, j), t, cnt) == 1) { return 1; }
        }
    }
    return 0;
}

# The offset of number token k (from 0, outside strings) in the well-formed JSON text [buf, buf + len), its end into
# end[0], or −1.
fn _bj_jr_num_tok(buf, len, k, end: *i64): i64 {
    var seen = 0;
    var i = 0;
    while (i < len) {
        var c = load8(buf + i);
        if (c == 34) {
            i = i + 1;
            while (i < len && load8(buf + i) != 34) {
                if (load8(buf + i) == 92) { i = i + 2; } else { i = i + 1; }
            }
            i = i + 1;
        } elif (c == 45 || (c >= 48 && c <= 57)) {
            var s = i;
            while (i < len) {
                var d = load8(buf + i);
                if ((d >= 48 && d <= 57) || d == 46 || d == 101 || d == 69 || d == 43 || d == 45) { i = i + 1; }
                else { break; }
            }
            if (seen == k) {
                end[0] = i;
                return s;
            }
            seen = seen + 1;
        } else {
            i = i + 1;
        }
    }
    return 0 - 1;
}

# Digit q (from 0) of the digit run of a JSON number: its integer part's il digits at p, then its fraction's after
# the point.
#must_use
fn _bj_jr_dig(p, il, q): i64 {
    if (q < il) { return load8(p + q); }
    return load8(p + q + 1);
}

# The sign of |the JSON number [p, p + n)| − mg·2^er (mg below 2^53, −202 ≤ er ≤ 104, an f32 halfway value): −1, 0
# or 1, exactly, for a number of any length. The halfway value is X·10^sc with X an integer of L digits (fmtf's
# bignum: mg·2^er, or mg·5^−er with sc = er); the number is 0.d₁d₂… × 10^kd once its leading zeros are dropped.
fn _bj_jr_dec_cmp(p, n, mg, er): i64 {
    var a[328];
    _bj_bn_set(&a, mg);
    var sc = 0;
    if (er >= 0) { _bj_bn_shl(&a, er); }
    else {
        var k5 = 0 - er;
        sc = er;
        while (k5 >= 13) {
            _bj_bn_mul_small(&a, 1220703125);
            k5 = k5 - 13;
        }
        while (k5 > 0) {
            _bj_bn_mul_small(&a, 5);
            k5 = k5 - 1;
        }
    }
    var rev[192];
    var xl = 0;
    while (load64(&a) != 0) {
        var r = _bj_bn_divmod_small(&a, 1000000000);
        for (var j = 0; j < 9; j = j + 1) {
            store8(&rev + xl, 48 + r % 10);
            r = r / 10;
            xl = xl + 1;
        }
    }
    while (xl > 0 && load8(&rev + xl - 1) == 48) { xl = xl - 1; }
    var tz = 0;
    while (tz < xl && load8(&rev + tz) == 48) { tz = tz + 1; }
    var kx = xl + sc;
    # The number's digit run: il integer digits, fl fraction digits, then an exponent (saturated far past any
    # document's length).
    var i = 0;
    if (n > 0 && load8(p) == 45) { i = 1; }
    var ds = p + i;
    var il = 0;
    while (i < n && load8(p + i) >= 48 && load8(p + i) <= 57) {
        il = il + 1;
        i = i + 1;
    }
    var fl = 0;
    if (i < n && load8(p + i) == 46) {
        i = i + 1;
        while (i < n && load8(p + i) >= 48 && load8(p + i) <= 57) {
            fl = fl + 1;
            i = i + 1;
        }
    }
    var ex = 0;
    if (i < n && (load8(p + i) == 101 || load8(p + i) == 69)) {
        i = i + 1;
        var neg = 0;
        if (i < n && (load8(p + i) == 43 || load8(p + i) == 45)) {
            if (load8(p + i) == 45) { neg = 1; }
            i = i + 1;
        }
        while (i < n && load8(p + i) >= 48 && load8(p + i) <= 57) {
            if (ex < 2199023255552) { ex = ex * 10 + load8(p + i) - 48; }
            i = i + 1;
        }
        if (neg == 1) { ex = 0 - ex; }
    }
    var nd = il + fl;
    var z = 0;
    while (z < nd && _bj_jr_dig(ds, il, z) == 48) { z = z + 1; }
    if (z == nd) { return 0 - 1; }
    var kd = il - z + ex;
    if (kd < kx) { return 0 - 1; }
    if (kd > kx) { return 1; }
    for (var q = 0; q < nd - z; q = q + 1) {
        var dd = _bj_jr_dig(ds, il, z + q);
        var xd = 48;
        if (q < xl - tz) { xd = load8(&rev + xl - 1 - q); }
        if (dd < xd) { return 0 - 1; }
        if (dd > xd) { return 1; }
    }
    if (nd - z < xl - tz) { return 0 - 1; }
    return 0;
}

# ── the number index (2.0.1, H17) ──────────────────────────────────────────────────────────────────────────────────
# A float on an f32 halfway value needs its token's digits, and bayan's nodes keep no text offset. Finding the token
# by a walk of the tree to the node and a scan of the text to its ordinal cost the whole document per such number,
# quadratic in a document of them. The index is built once, at a document's first such number: one walk puts every
# number node's address and ordinal into an open-addressed table, one scan puts every number token's (start, end)
# after it, so each later lookup is a probe. It lives in cx[3] (the block) and cx[4] (the table's slots, a power of
# two; 0 while unbuilt, −1 where it couldn't be had, the walk and the scan per number then, as before). The table is
# only ever probed, never iterated: its order can't reach a result.

# A word as a *i64.
#must_use
fn _bj_jr_i64p(a): *i64 {
    return a;
}

# The slot of node address v in the table tab of mask + 1 slots (two words each): v's, or the empty one where it goes.
# Fibonacci hashing: the product's bits from 20 up (mask is below 2^30).
fn _bj_jr_ix_slot(tab: *i64, mask, v): i64 {
    var h = ((v >> 3) * 0x9E3779B97F4A7C15) >> 20;
    var i = h & mask;
    while (tab[2 * i] != 0 && tab[2 * i] != v) { i = (i + 1) & mask; }
    return i;
}

# Puts every number node under v into the table, in document order (as _bj_jr_ord counts them), ordinals from cnt[0].
fn _bj_jr_ix_walk(v, tab: *i64, mask, cnt: *i64) {
    var tag = bayan_json_v_tag(v);
    if (tag == JTAG_INT || tag == JTAG_FLOAT) {
        var i = _bj_jr_ix_slot(tab, mask, v);
        tab[2 * i] = v;
        tab[2 * i + 1] = cnt[0];
        cnt[0] = cnt[0] + 1;
    } elif (tag == JTAG_ARR) {
        var na = bayan_json_v_arr_len(v);
        for (var k = 0; k < na; k = k + 1) { _bj_jr_ix_walk(bayan_json_v_arr_get(v, k), tab, mask, cnt); }
    } elif (tag == JTAG_OBJ) {
        var no = bayan_json_v_obj_len(v);
        for (var j = 0; j < no; j = j + 1) { _bj_jr_ix_walk(bayan_json_v_obj_val(v, j), tab, mask, cnt); }
    }
    return 0;
}

# The number of number nodes under v.
#must_use
fn _bj_jr_ix_count(v): i64 {
    var tag = bayan_json_v_tag(v);
    if (tag == JTAG_INT || tag == JTAG_FLOAT) { return 1; }
    var n = 0;
    if (tag == JTAG_ARR) {
        var na = bayan_json_v_arr_len(v);
        for (var k = 0; k < na; k = k + 1) { n = n + _bj_jr_ix_count(bayan_json_v_arr_get(v, k)); }
    } elif (tag == JTAG_OBJ) {
        var no = bayan_json_v_obj_len(v);
        for (var j = 0; j < no; j = j + 1) { n = n + _bj_jr_ix_count(bayan_json_v_obj_val(v, j)); }
    }
    return n;
}

# Each number token's (start, end) in the text [buf, buf + len) into toks, as _bj_jr_num_tok finds them; their count.
fn _bj_jr_ix_toks(buf, len, toks: *i64, cap): i64 {
    var seen = 0;
    var i = 0;
    while (i < len) {
        var c = load8(buf + i);
        if (c == 34) {
            i = i + 1;
            while (i < len && load8(buf + i) != 34) {
                if (load8(buf + i) == 92) { i = i + 2; } else { i = i + 1; }
            }
            i = i + 1;
        } elif (c == 45 || (c >= 48 && c <= 57)) {
            var st = i;
            while (i < len) {
                var d = load8(buf + i);
                if ((d >= 48 && d <= 57) || d == 46 || d == 101 || d == 69 || d == 43 || d == 45) { i = i + 1; }
                else { break; }
            }
            if (seen < cap) {
                toks[2 * seen] = st;
                toks[2 * seen + 1] = i;
            }
            seen = seen + 1;
        } else {
            i = i + 1;
        }
    }
    return seen;
}

# Builds the document cx's number index into cx[3] and cx[4] (−1 in cx[4] where it can't be had, or where the tokens
# and the nodes don't pair up one to one, which a well-formed document always does).
fn _bj_jr_ix_build(cx: *i64) {
    cx[4] = 0 - 1;
    var n = _bj_jr_ix_count(cx[2]);
    var slots = 2;
    while (slots < 2 * n && slots < 1152921504606846976) { slots = slots * 2; }
    if (n < 1 || n > 268435456) { return 0; }
    var blk = fl_calloc(slots * 16 + n * 16);
    if (blk == 0) { return 0; }
    var tab: *i64 = _bj_jr_i64p(blk);
    var toks: *i64 = _bj_jr_i64p(blk + slots * 16);
    var cnt: i64[1];
    cnt[0] = 0;
    _bj_jr_ix_walk(cx[2], tab, slots - 1, &cnt);
    var nt = _bj_jr_ix_toks(cx[0], cx[1], toks, n);
    if (nt != n || cnt[0] != n) {
        fl_free(blk);
        return 0;
    }
    cx[3] = blk;
    cx[4] = slots;
    return 0;
}

# Number node v's token in the document cx: its start, its end into end[0], or −1. By the index (built on the first
# call), or, where it couldn't be had, by the walk and the scan.
fn _bj_jr_tok_of(cx: *i64, v, end: *i64): i64 {
    if (cx[4] == 0) { _bj_jr_ix_build(cx); }
    if (cx[4] > 0) {
        var tab: *i64 = _bj_jr_i64p(cx[3]);
        var i = _bj_jr_ix_slot(tab, cx[4] - 1, v);
        if (tab[2 * i] != v) { return 0 - 1; }
        var k = tab[2 * i + 1];
        var toks: *i64 = _bj_jr_i64p(cx[3] + cx[4] * 16);
        end[0] = toks[2 * k + 1];
        return toks[2 * k];
    }
    var cnt: i64[1];
    cnt[0] = 0;
    _bj_jr_ord(cx[2], v, &cnt);
    return _bj_jr_num_tok(cx[0], cx[1], cnt[0], end);
}

# The sign of |number node v| − |x| for the f32 halfway double x with bits `bits` (quantum 2^q), exactly: an integer
# node against x's integer value, a float node from its token in the text cx[0], cx[1] bytes, whose root node is cx[2]
# (the token found through the index in cx[3], cx[4]).
fn _bj_jr_f32_side(cx: *i64, v, bits, q): i64 {
    var mag = bits & 0x7FFFFFFFFFFFFFFF;
    if (bayan_json_v_tag(v) == JTAG_INT) {
        var iv = bayan_json_v_int(v);
        if (iv < 0) { iv = 0 - iv; }
        var xf: f64 = _bj_from_bits(mag);
        var xi = f64_to(xf);
        if (iv < xi) { return 0 - 1; }
        if (iv > xi) { return 1; }
        return 0;
    }
    var e: i64[1];
    var s = _bj_jr_tok_of(cx, v, &e);
    if (s < 0) { return 0; }
    var be = mag >> 52;
    var mg = (mag & 0xFFFFFFFFFFFFF) | 0x10000000000000;
    return _bj_jr_dec_cmp(cx[0] + s, e[0] - s, mg, be - 1075);
}

# Number node v of the document cx (its text cx[0], cx[1] bytes; its root node cx[2]) as an f32 into *out, the f32
# widened to f64 (exact): the number rounded once to the nearest f32, ties to even (ADR 0002 row 45). An integer reads
# as serde reads one into an f32 (`n as f32`, rounded once); a number whose f32 overflows is refused, as serde_json's
# float_roundtrip refuses one. 0, or BJ_ERR_DESERIALIZE recorded.
fn _bj_jr_f32(cx: *i64, v, out): i64 {
    var tag = bayan_json_v_tag(v);
    if (tag != JTAG_INT && tag != JTAG_FLOAT) { return _bj_jr_type(v, "f32"); }
    var bits = bayan_json_v_float(v);
    var y: f64 = 0.0;
    if ((bits & 0x7FF0000000000000) != 0x7FF0000000000000) {
        var x: f64 = _bj_from_bits(bits);
        var r: f32 = x;
        y = f32_to(r);
        var q = _bj_jr_f32_mid(bits);
        if (q != 999) {
            var side = _bj_jr_f32_side(cx, v, bits, q);
            if (side != 0) {
                var h: f64 = _bj_from_bits((q + 1022) << 52);
                var ax: f64 = f64_abs(x);
                var near: f64 = ax + h;
                if (side < 0) { near = ax - h; }
                if (x < 0.0) { near = -near; }
                y = near;
            }
        }
    }
    var ay: f64 = f64_abs(y);
    var top: f64 = _bj_from_bits(0x47F0000000000000);
    if ((bits & 0x7FF0000000000000) == 0x7FF0000000000000 || ay >= top) {
        var t = _bj_err_reason(BJ_ERR_DESERIALIZE);
        _bj_tx_cstr(t, "number out of range");
        return BJ_ERR_DESERIALIZE;
    }
    store64(out, _bj_bits(y));
    return 0;
}

# ── soorat's readers ─────────────────────────────────────────────────────────────────────────────────────────────────

# A field slice (nd 2) or volume (nd 3) node into the words at w, which are 0 on entry: w[0..2] the values' block and
# count, w[2..4] the component's block and byte count, w[4] the step, w[5] the spacing's bits, w[6..6 + nd] the
# dimensions and w[9..9 + nd] the origin's bits. 0, or the code recorded (the caller gives back w[0] and w[2]).
fn _bj_jr_slice(v, w, nd): i64 {
    var what = "struct FieldSlice2D";
    var arr = "an array of length 2";
    if (nd == 3) {
        what = "struct FieldSlice3D";
        arr = "an array of length 3";
    }
    var form = _bj_jr_form(v, 6, what);
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    var f = _bj_jr_field(v, form, 0, "values");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    var c = _bj_jr_f64_vec(f, w);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 1, "dimensions");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    c = _bj_jr_usizes(f, nd, w + 48);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 2, "origin");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    c = _bj_jr_f64s(f, nd, arr, w + 72);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 3, "spacing");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    c = _bj_jr_f64(f, w + 40);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 4, "component");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    c = _bj_jr_string(f, w + 16);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 5, "step");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    return _bj_jr_usize(f, w + 32);
}

fn _bj_jr_slice2(v, w): i64 {
    return _bj_jr_slice(v, w, 2);
}

fn _bj_jr_slice3(v, w): i64 {
    return _bj_jr_slice(v, w, 3);
}

# Gives back a reader's blocks a and b (each 0 or a block).
fn _bj_jr_give(a, b) {
    if (a != 0) { fl_free(a); }
    if (b != 0) { fl_free(b); }
    return 0;
}

# Word k's address in the word array p.
#must_use
fn _bj_jr_at(p, k): i64 {
    return p + k * 8;
}

# The n words at w, zeroed.
fn _bj_jr_zero(w: *i64, n) {
    for (var k = 0; k < n; k = k + 1) { w[k] = 0; }
    return 0;
}

# Reads a `FieldSlice2D` document from [buf, buf + len) into a new slice in *out: Ok(0), or the error recorded with
# out empty (never read), errors as BjComplex_from_json. The fields are read as written, as serde's derive reads
# Rust's public fields: any number of values (a count other than nx·ny too), the dimensions and step integers from 0
# to 2^63 − 1 (ADR 0002 row 36: past it bayan's tree keeps no exact integer, where serde reads up to u64::MAX), the
# component any JSON string. Give it back with BjFieldSlice2D_free. Mirrors `serde_json::from_str::<FieldSlice2D>`.
#must_use
public fn BjFieldSlice2D_from_json(buf, len, out: *BjFieldSlice2D): Result {
    memset(out, 0, sizeof(BjFieldSlice2D));
    var w: i64[12];
    _bj_jr_zero(&w, 12);
    var code = _bj_jr_read(buf, len, &_bj_jr_slice2, &w);
    if (code != 0) {
        _bj_jr_give(w[0], w[2]);
        return Err(code);
    }
    var sp: f64 = _bj_from_bits(w[5]);
    var o0: f64 = _bj_from_bits(w[9]);
    var o1: f64 = _bj_from_bits(w[10]);
    out.values = w[0];
    out.values_len = w[1];
    out.dimensions = (w[6], w[7]);
    out.origin = (o0, o1);
    out.spacing = sp;
    out.component = w[2];
    out.component_len = w[3];
    out.step = w[4];
    return Ok(0);
}

# Reads a `FieldSlice3D` document from [buf, buf + len) into a new volume in *out: Ok(0), or the error recorded with
# out empty (never read), errors as BjFieldSlice2D_from_json. Give it back with BjFieldSlice3D_free. Mirrors
# `serde_json::from_str::<FieldSlice3D>`.
#must_use
public fn BjFieldSlice3D_from_json(buf, len, out: *BjFieldSlice3D): Result {
    memset(out, 0, sizeof(BjFieldSlice3D));
    var w: i64[12];
    _bj_jr_zero(&w, 12);
    var code = _bj_jr_read(buf, len, &_bj_jr_slice3, &w);
    if (code != 0) {
        _bj_jr_give(w[0], w[2]);
        return Err(code);
    }
    var sp: f64 = _bj_from_bits(w[5]);
    var o0: f64 = _bj_from_bits(w[9]);
    var o1: f64 = _bj_from_bits(w[10]);
    var o2: f64 = _bj_from_bits(w[11]);
    out.values = w[0];
    out.values_len = w[1];
    out.dimensions = (w[6], w[7], w[8]);
    out.origin = (o0, o1, o2);
    out.spacing = sp;
    out.component = w[2];
    out.component_len = w[3];
    out.step = w[4];
    return Ok(0);
}

# A FieldLine node into the BjFieldLine words at w (points, points_len, magnitudes, magnitudes_len), which are 0 on
# entry: the points an array of `[f64; 3]`, the magnitudes of numbers, any lengths. 0, or the code recorded (the
# caller gives back the blocks).
fn _bj_jr_line(v, w): i64 {
    var form = _bj_jr_form(v, 2, "struct FieldLine");
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    var f = _bj_jr_field(v, form, 0, "points");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    var c = _bj_jr_triples(f, w);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 1, "magnitudes");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    return _bj_jr_f64_vec(f, w + 16);
}

# A FieldLineVisualization node into w[0..2] (the lines' block and count, 0 on entry): the lines' block is zeroed
# before any line is read, so BjFieldLineVisualization_free gives back whatever a failed read made.
fn _bj_jr_lines(v, w: *i64): i64 {
    var f = _bj_jr_only(v, "lines", "struct FieldLineVisualization");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    if (bayan_json_v_tag(f) != JTAG_ARR) { return _bj_jr_type(f, "a sequence"); }
    var n = bayan_json_v_arr_len(f);
    var b = _bj_jr_block(n * 32);
    if (b == 0) { return BJ_ERR_ALLOCATION; }
    _bj_jr_zero(b, n * 4);
    w[0] = b;
    w[1] = n;
    for (var k = 0; k < n; k = k + 1) {
        var c = _bj_jr_line(bayan_json_v_arr_get(f, k), b + k * 32);
        if (c != 0) { return c; }
    }
    return 0;
}

# Reads a `FieldLine` document from [buf, buf + len) into a new line in *out: Ok(0), or the error recorded with out
# empty (and never read), as BjComplex_from_json; any numbers of points and magnitudes. Give it back with
# BjFieldLine_free. Mirrors `serde_json::from_str::<FieldLine>`.
#must_use
public fn BjFieldLine_from_json(buf, len, out: *BjFieldLine): Result {
    memset(out, 0, sizeof(BjFieldLine));
    var w: i64[4];
    _bj_jr_zero(&w, 4);
    var code = _bj_jr_read(buf, len, &_bj_jr_line, &w);
    if (code != 0) {
        _bj_jr_give(w[0], w[2]);
        return Err(code);
    }
    out.points = w[0];
    out.points_len = w[1];
    out.magnitudes = w[2];
    out.magnitudes_len = w[3];
    return Ok(0);
}

# Reads a `FieldLineVisualization` document from [buf, buf + len) into a new visualization in *out: Ok(0), or the
# error recorded with out empty (never read), errors as BjComplex_from_json; each line as BjFieldLine_from_json reads
# it. Give it back with BjFieldLineVisualization_free. Mirrors `serde_json::from_str::<FieldLineVisualization>`.
#must_use
public fn BjFieldLineVisualization_from_json(buf, len, out: *BjFieldLineVisualization): Result {
    memset(out, 0, sizeof(BjFieldLineVisualization));
    var lv: BjFieldLineVisualization;
    lv.lines = 0;
    lv.lines_len = 0;
    var code = _bj_jr_read(buf, len, &_bj_jr_lines, &lv);
    if (code != 0) {
        BjFieldLineVisualization_free(&lv);
        return Err(code);
    }
    out.lines = lv.lines;
    out.lines_len = lv.lines_len;
    return Ok(0);
}

# A ChargePoint node of the document cx (_bj_jr_f32's) into the five f64 words at w (x, y, z, charge, magnitude), each
# an f32 rounded once (_bj_jr_f32). 0, or the code recorded.
fn _bj_jr_charge(cx: *i64, v, w): i64 {
    var form = _bj_jr_form(v, 3, "struct ChargePoint");
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    var f = _bj_jr_field(v, form, 0, "position");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    var c = _bj_jr_array(f, 3, "an array of length 3");
    if (c != 0) { return c; }
    for (var k = 0; k < 3; k = k + 1) {
        c = _bj_jr_f32(cx, bayan_json_v_arr_get(f, k), w + k * 8);
        if (c != 0) { return c; }
    }
    f = _bj_jr_field(v, form, 1, "charge");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    c = _bj_jr_f32(cx, f, w + 24);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 2, "magnitude");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    return _bj_jr_f32(cx, f, w + 32);
}

# The five f64 words at w (each an f32's value) into charge point c.
fn _bj_jr_put_charge(c: *BjChargePoint, w: *i64) {
    var x: f64 = _bj_from_bits(w[0]);
    var y: f64 = _bj_from_bits(w[1]);
    var z: f64 = _bj_from_bits(w[2]);
    var q: f64 = _bj_from_bits(w[3]);
    var a: f64 = _bj_from_bits(w[4]);
    c.position_x = x;
    c.position_y = y;
    c.position_z = z;
    c.charge = q;
    c.magnitude = a;
    return 0;
}

# The ChargePoint decoder: cx[0..2] the text, cx[2] the root (set here), cx[3..5] the number index, cx[5..10] the five
# values.
fn _bj_jr_charge1(v, cx): i64 {
    store64(cx + 16, v);
    return _bj_jr_charge(cx, v, cx + 40);
}

# The ChargeVisualization decoder: cx[0..2] the text, cx[2] the root (set here), cx[3..5] the number index, cx[5..7] the
# points' block and count (0 on entry; the caller gives the block back on a failure).
fn _bj_jr_charges(v, cx: *i64): i64 {
    cx[2] = v;
    var f = _bj_jr_only(v, "charges", "struct ChargeVisualization");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    if (bayan_json_v_tag(f) != JTAG_ARR) { return _bj_jr_type(f, "a sequence"); }
    var n = bayan_json_v_arr_len(f);
    var b = _bj_jr_block(n * 20);
    if (b == 0) { return BJ_ERR_ALLOCATION; }
    cx[5] = b;
    cx[6] = n;
    var cs: *BjChargePoint = _bj_jw_cpp(b);
    var w: i64[5];
    for (var k = 0; k < n; k = k + 1) {
        var c = _bj_jr_charge(cx, bayan_json_v_arr_get(f, k), &w);
        if (c != 0) { return c; }
        _bj_jr_put_charge(cs + k, &w);
    }
    return 0;
}

# Reads a `ChargePoint` document from [buf, buf + len) into *out: Ok(0), or the error recorded with out untouched, as
# BjComplex_from_json. Each value is rounded once to the nearest f32, ties to even, as serde_json's float_roundtrip
# reads one (ADR 0002 row 45: bijli's build of serde_json reads the f64, then casts it, rounding twice), and refused
# where that overflows (1e39); an integer as `n as f32`. The magnitude is read as written, not |charge|. Mirrors
# `serde_json::from_str::<ChargePoint>`.
#must_use
public fn BjChargePoint_from_json(buf, len, out: *BjChargePoint): Result {
    var cx: i64[10];
    _bj_jr_zero(&cx, 10);
    cx[0] = buf;
    cx[1] = len;
    var code = _bj_jr_read(buf, len, &_bj_jr_charge1, &cx);
    _bj_jr_give(cx[3], 0);
    if (code != 0) { return Err(code); }
    _bj_jr_put_charge(out, _bj_jr_at(&cx, 5));
    return Ok(0);
}

# Reads a `ChargeVisualization` document from [buf, buf + len) into a new visualization in *out: Ok(0), or the error
# recorded with out empty (never read), errors as BjComplex_from_json; each point as BjChargePoint_from_json reads
# it. Give it back with BjChargeVisualization_free. Mirrors `serde_json::from_str::<ChargeVisualization>`.
#must_use
public fn BjChargeVisualization_from_json(buf, len, out: *BjChargeVisualization): Result {
    memset(out, 0, sizeof(BjChargeVisualization));
    var cx: i64[7];
    _bj_jr_zero(&cx, 7);
    cx[0] = buf;
    cx[1] = len;
    var code = _bj_jr_read(buf, len, &_bj_jr_charges, &cx);
    _bj_jr_give(cx[3], 0);
    if (code != 0) {
        _bj_jr_give(cx[5], 0);
        return Err(code);
    }
    out.charges = cx[5];
    out.charges_len = cx[6];
    return Ok(0);
}

# A RadiationPattern node into the words at w (0 on entry): w[0..2] the angles' block and count, w[2..4] the pattern's,
# w[4] max_gain's bits. Any lengths; the gain as written. 0, or the code recorded (the caller gives back the blocks).
fn _bj_jr_pattern(v, w): i64 {
    var form = _bj_jr_form(v, 3, "struct RadiationPattern");
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    var f = _bj_jr_field(v, form, 0, "angles");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    var c = _bj_jr_f64_vec(f, w);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 1, "pattern");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    c = _bj_jr_f64_vec(f, w + 16);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 2, "max_gain");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    return _bj_jr_f64(f, w + 32);
}

# Reads a `RadiationPattern` document from [buf, buf + len) into a new pattern in *out: Ok(0), or the error recorded
# with out empty (never read), errors as BjComplex_from_json. The fields are read as written: angles and pattern of
# any lengths, a max_gain that isn't their maximum too. Give it back with BjRadiationPattern_free. Mirrors
# `serde_json::from_str::<RadiationPattern>`.
#must_use
public fn BjRadiationPattern_from_json(buf, len, out: *BjRadiationPattern): Result {
    memset(out, 0, sizeof(BjRadiationPattern));
    var w: i64[5];
    _bj_jr_zero(&w, 5);
    var code = _bj_jr_read(buf, len, &_bj_jr_pattern, &w);
    if (code != 0) {
        _bj_jr_give(w[0], w[2]);
        return Err(code);
    }
    var g: f64 = _bj_from_bits(w[4]);
    out.angles = w[0];
    out.angles_len = w[1];
    out.pattern = w[2];
    out.pattern_len = w[3];
    out.max_gain = g;
    return Ok(0);
}

# A VectorFieldSample node into the words at w (0 on entry): w[0..2] the vectors' block and count, w[2..5] the
# dimensions, w[5..8] the origin's bits, w[8] the spacing's and w[9] max_magnitude's. 0, or the code recorded (the
# caller gives back the block).
fn _bj_jr_vectors(v, w): i64 {
    var form = _bj_jr_form(v, 5, "struct VectorFieldSample");
    if (form == 0) { return BJ_ERR_DESERIALIZE; }
    var f = _bj_jr_field(v, form, 0, "vectors");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    var c = _bj_jr_triples(f, w);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 1, "dimensions");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    c = _bj_jr_usizes(f, 3, w + 16);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 2, "origin");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    c = _bj_jr_f64s(f, 3, "an array of length 3", w + 40);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 3, "spacing");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    c = _bj_jr_f64(f, w + 64);
    if (c != 0) { return c; }
    f = _bj_jr_field(v, form, 4, "max_magnitude");
    if (f == 0) { return BJ_ERR_DESERIALIZE; }
    return _bj_jr_f64(f, w + 72);
}

# Reads a `VectorFieldSample` document from [buf, buf + len) into a new sample in *out: Ok(0), or the error recorded
# with out empty (never read), errors as BjComplex_from_json. The fields are read as written (a vector count other
# than nx·ny·nz, a spacing or origin try_from_components refuses, a max_magnitude that isn't the largest too), the
# dimensions from 0 to 2^63 − 1 (ADR 0002 row 36). Give it back with BjVectorFieldSample_free. Mirrors
# `serde_json::from_str::<VectorFieldSample>`.
#must_use
public fn BjVectorFieldSample_from_json(buf, len, out: *BjVectorFieldSample): Result {
    memset(out, 0, sizeof(BjVectorFieldSample));
    var w: i64[10];
    _bj_jr_zero(&w, 10);
    var code = _bj_jr_read(buf, len, &_bj_jr_vectors, &w);
    if (code != 0) {
        _bj_jr_give(w[0], 0);
        return Err(code);
    }
    var o0: f64 = _bj_from_bits(w[5]);
    var o1: f64 = _bj_from_bits(w[6]);
    var o2: f64 = _bj_from_bits(w[7]);
    var sp: f64 = _bj_from_bits(w[8]);
    var mm: f64 = _bj_from_bits(w[9]);
    out.vectors = w[0];
    out.vectors_len = w[1];
    out.dimensions = (w[2], w[3], w[4]);
    out.origin = (o0, o1, o2);
    out.spacing = sp;
    out.max_magnitude = mm;
    return Ok(0);
}
