# bijli — text: the bounded text that bijli's `display` and `debug` methods and the ai client's `register_agent` write
# into (M8 part 2), src/fmtf.cyr's BjText for a consumer. Rust's `Display` and `Debug` write to a growing `String`; a
# bijli text is a fixed buffer the caller owns, so formatting never allocates.
#
# A text is three words, 24 bytes (`var t[24];`), over a buffer of `cap` bytes the caller supplies. It is kept
# NUL-terminated; bytes past cap − 1 are dropped and counted, so bj_text_overflowed tells when the buffer was too small.
#
#     var buf[128];
#     var t[24];
#     bj_text_init(&t, &buf, 128);
#     v.display(&t);                 # Rust's `format!("{v}")`: "(1, 2, 3)"
#     print(bj_text_ptr(&t), bj_text_len(&t));

private

# Makes t an empty text over [buf, buf + cap), cap ≥ 1 (the NUL takes one byte). Returns 0.
public fn bj_text_init(t, buf, cap): i64 {
    _bj_tx_init(t, buf, cap);
    return 0;
}

# The text's address: a NUL-terminated C string.
#must_use
public fn bj_text_ptr(t): i64 {
    return _bj_tx_ptr(t);
}

# The number of bytes the text holds (below its capacity).
#must_use
public fn bj_text_len(t): i64 {
    return _bj_tx_len(t);
}

# 1 when bytes were dropped for want of room, else 0.
#must_use
public fn bj_text_overflowed(t): i64 {
    return _bj_tx_overflowed(t);
}
