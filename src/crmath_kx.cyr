# ── correctly rounded square roots of quotients (the overflow audit's B2): ADR 0002 #30 ──────────────────────────────

# (y₀, d) with y₀ + d = √(sₓ/s_y) to 5.7u² (the section comment), for sₓ/s_y in (½, 4) and both in [1, 4). (Inlining
# the two TwoProducts saved 1 ns of 87 and was not kept.)
#must_use
fn _bj_k_sqrt_div_dd(sx: f64, sy: f64): (f64, f64) {
    var qh: f64 = sx / sy;
    var a, b = _bj_k_two_prod(qh, sy);
    var rem: f64 = (sx - a) - b;
    var ql: f64 = rem / sy;
    var y0: f64 = f64_sqrt(qh);
    var p, pe = _bj_k_two_prod(y0, y0);
    var t1: f64 = (qh - p) - pe;
    var t: f64 = t1 + ql;
    var tr: f64 = y0 + y0;
    var d: f64 = t / tr;
    return (y0, d);
}

# RN(√(x/y)) by the fast path (the section comment): (RN, 1), or (0, 0) for an operand that is not a positive normal
# double, a failed rounding test or a possibly subnormal result.
#must_use
fn _bj_k_sqrt_div_fast(x: f64, y: f64): (f64, i64) {
    var bx = load64(&x);
    var by = load64(&y);
    var nmin = 0x0010000000000000;
    var nmax = 0x7FF0000000000000;
    if (bx < nmin || by < nmin || bx >= nmax || by >= nmax) { return (0.0, 0); }     # a sign bit reads negative
    var kk = (bx >> 52) - (by >> 52);                                   # eₓ − e_y
    var mask = 0x000FFFFFFFFFFFFF;
    var one = 0x3FF0000000000000;
    var sxb = (bx & mask) | one;
    var syb = (by & mask) | one;
    var sx: f64 = sxb;
    var sy: f64 = syb;
    if ((kk & 1) != 0) {
        sx = sx * 2.0;
        kk = kk - 1;
    }
    var y0, d = _bj_k_sqrt_div_dd(sx, sy);
    var k100: f64 = 0x39B0000000000000;     # 2⁻¹⁰⁰
    var eps: f64 = y0 * k100;
    var lo: f64 = d - eps;
    var hi: f64 = d + eps;
    var z1: f64 = y0 + lo;
    var z2: f64 = y0 + hi;
    if (z1 != z2) { return (0.0, 0); }
    var r, ok = _bj_k_mono_fin(z1, kk / 2, 0);
    return (r, ok);
}

# R²·B into w (multi-word, below 2¹⁶⁵), for 0 ≤ R < 2⁵⁷ and B at bb; t and s are scratch.
fn _bj_k_sqrt_sq_mul(w, rr, bb, t, s) {
    _bj_k_bn_set(t, rr);
    _bj_k_bn_mul(s, t, t);
    _bj_k_bn_mul(w, s, bb);
    return 0;
}

# RN(√(x/y)) by the exact path alone (the section comment), for positive finite x and y; NaN otherwise.
#must_use
fn _bj_k_sqrt_div_acc(x: f64, y: f64): f64 {
    var bx = load64(&x);
    var by = load64(&y);
    var nmax = 0x7FF0000000000000;
    if (bx <= 0 || by <= 0 || bx >= nmax || by >= nmax) {
        var nan: f64 = _bj_k_nan();
        return nan;
    }
    var am, ea = _bj_k_f64_int(bx);
    var bm, eb = _bj_k_f64_int(by);
    var e = ea - eb;
    if ((e & 1) != 0) {
        am = am * 2;
        e = e - 1;
    }
    var af: f64 = f64_from(am);              # below 2⁵⁴: exact
    var bf: f64 = f64_from(bm);
    var p52: f64 = 0x3CB0000000000000;      # 2⁻⁵²: A/B as a quotient of significands in [1, 4), exactly scaled
    var sa: f64 = af * p52;
    var sb: f64 = bf * p52;
    var y0, d = _bj_k_sqrt_div_dd(sa, sb);
    var p55: f64 = 0x4360000000000000;      # 2⁵⁵
    var gy: f64 = y0 * p55;                 # an integer below 2⁵⁶ (y₀'s ulp is at least 2⁻⁵³)
    var gd: f64 = d * p55;
    var rr = f64_to(gy) + f64_to(gd);
    var pb[64];
    var bb[64];
    var wb[64];
    var tb[64];
    var sb2[64];
    _bj_k_bn_set(&pb, am);
    _bj_k_bn_shl(&pb, 110);
    _bj_k_bn_set(&bb, bm);
    var up = 1;
    while (up == 1) {
        _bj_k_sqrt_sq_mul(&wb, rr + 1, &bb, &tb, &sb2);
        if (_bj_k_bn_cmp(&wb, &pb) > 0) {
            up = 0;
        } else {
            rr = rr + 1;
        }
    }
    _bj_k_sqrt_sq_mul(&wb, rr, &bb, &tb, &sb2);
    while (_bj_k_bn_cmp(&wb, &pb) > 0) {
        rr = rr - 1;
        _bj_k_sqrt_sq_mul(&wb, rr, &bb, &tb, &sb2);
    }
    var sticky = 0;
    if (_bj_k_bn_cmp(&wb, &pb) != 0) { sticky = 1; }
    var h = (e - 110) / 2;
    var r: f64 = _bj_k_cr_from_int(2 * rr + sticky, h - 1);
    return r;
}

# RN(√(x/y)), correctly rounded (the section comment), for positive finite x and y: the fast path, then the exact path
# where it declines; NaN outside the domain.
#must_use
fn _bj_k_cr_sqrt_div(x: f64, y: f64): f64 {
    var r, ok = _bj_k_sqrt_div_fast(x, y);
    if (ok == 1) { return r; }
    var a: f64 = _bj_k_sqrt_div_acc(x, y);
    return a;
}

# ── correctly rounded w·√((x/y)·2^e) (the overflow audit's B3): ADR 0002 #32 ──────────────────────────────────────────

# RN(w·√((x/y)·2^e)) by the fast path (the section comment): (RN, 1), or (0, 0) for an operand that is not a positive
# normal double, a failed rounding test or a possibly subnormal result.
#must_use
fn _bj_k_mul_sqrt_ratio_fast(w: f64, x: f64, y: f64, e): (f64, i64) {
    var bw = load64(&w);
    var bx = load64(&x);
    var by = load64(&y);
    var nmin = 0x0010000000000000;
    var nmax = 0x7FF0000000000000;
    if (bw < nmin || bx < nmin || by < nmin) { return (0.0, 0); }      # a sign bit reads negative
    if (bw >= nmax || bx >= nmax || by >= nmax) { return (0.0, 0); }
    var kk = (bx >> 52) - (by >> 52) + e;                               # eₓ − e_y + e
    var mask = 0x000FFFFFFFFFFFFF;
    var one = 0x3FF0000000000000;
    var sxb = (bx & mask) | one;
    var syb = (by & mask) | one;
    var swb = (bw & mask) | one;
    var sx: f64 = sxb;
    var sy: f64 = syb;
    var sw: f64 = swb;
    if ((kk & 1) != 0) {
        sx = sx * 2.0;
        kk = kk - 1;
    }
    var y0, d = _bj_k_sqrt_div_dd(sx, sy);
    var ph, pl = _bj_k_two_prod(y0, sw);
    var c: f64 = d * sw;
    var t: f64 = pl + c;
    var h, l = _bj_k_fast_two_sum(ph, t);
    var z1, z2 = _bj_k_dd_round_ends(h, l);
    if (z1 != z2) { return (0.0, 0); }
    var k = (bw >> 52) - 1023 + kk / 2;
    var r, ok = _bj_k_mono_fin(z1, k, 0);
    return (r, ok);
}

# RN(w·√((x/y)·2^e)) by the exact path alone (the section comment), for positive finite w, x and y; NaN otherwise.
#must_use
fn _bj_k_mul_sqrt_ratio_acc(w: f64, x: f64, y: f64, e): f64 {
    var bw = load64(&w);
    var bx = load64(&x);
    var by = load64(&y);
    var nmax = 0x7FF0000000000000;
    if (bw <= 0 || bx <= 0 || by <= 0 || bw >= nmax || bx >= nmax || by >= nmax) {
        var nan: f64 = _bj_k_nan();
        return nan;
    }
    var wm, ew = _bj_k_f64_int(bw);
    var am, ea = _bj_k_f64_int(bx);
    var bm, eb = _bj_k_f64_int(by);
    var ee = ea - eb + e;
    if ((ee & 1) != 0) {
        am = am * 2;
        ee = ee - 1;
    }
    var wf: f64 = f64_from(wm);              # below 2⁵³: exact
    var af: f64 = f64_from(am);              # below 2⁵⁴: exact
    var bf: f64 = f64_from(bm);
    var p52: f64 = 0x3CB0000000000000;      # 2⁻⁵²: A/B as a quotient of significands in [1, 4), exactly scaled
    var sa: f64 = af * p52;
    var sb: f64 = bf * p52;
    var y0, d = _bj_k_sqrt_div_dd(sa, sb);
    var gh, gl = _bj_k_two_prod(wf, y0);      # W·y₀ exactly, at least 2^51.5: 8·g_h is an integer
    var gd: f64 = wf * d;
    var g8: f64 = gh * 8.0;
    var t8: f64 = (gl + gd) * 8.0;
    var rr = f64_to(g8) + f64_to(t8);       # within a few units of R
    var pb[64];
    var tb[64];
    var bb[64];
    var wb[64];
    var sb2[64];
    _bj_k_bn_set(&tb, wm);
    _bj_k_bn_mul(&sb2, &tb, &tb);
    _bj_k_bn_set(&tb, am);
    _bj_k_bn_mul(&pb, &sb2, &tb);
    _bj_k_bn_shl(&pb, 6);
    _bj_k_bn_set(&bb, bm);
    var up = 1;
    while (up == 1) {
        _bj_k_sqrt_sq_mul(&wb, rr + 1, &bb, &tb, &sb2);
        if (_bj_k_bn_cmp(&wb, &pb) > 0) {
            up = 0;
        } else {
            rr = rr + 1;
        }
    }
    _bj_k_sqrt_sq_mul(&wb, rr, &bb, &tb, &sb2);
    while (_bj_k_bn_cmp(&wb, &pb) > 0) {
        rr = rr - 1;
        _bj_k_sqrt_sq_mul(&wb, rr, &bb, &tb, &sb2);
    }
    var sticky = 0;
    if (_bj_k_bn_cmp(&wb, &pb) != 0) { sticky = 1; }
    var h = ew + ee / 2 - 3;
    var r: f64 = _bj_k_cr_from_int(2 * rr + sticky, h - 1);
    return r;
}

# RN(w·√((x/y)·2^e)), correctly rounded (the section comment), for positive finite w, x and y: the fast path, then the
# exact path where it declines; NaN outside the domain.
#must_use
fn _bj_k_cr_mul_sqrt_ratio(w: f64, x: f64, y: f64, e): f64 {
    var r, ok = _bj_k_mul_sqrt_ratio_fast(w, x, y, e);
    if (ok == 1) { return r; }
    var a: f64 = _bj_k_mul_sqrt_ratio_acc(w, x, y, e);
    return a;
}
