# crmath_kx.cyr — kimiya's correctly rounded monomials, square roots of quotients and binary64 with an
# unbounded exponent (kimiya ADR 0002 #20, #27–#32), for bijli's range-edge Part (M1 part 5).
#
# GENERATED by scripts/port/kimiya_closure.py from kimiya's src/mathx.cyr: the call closure of its _km_cr_mono
# family, _km_cr_sqrt_div, _km_cr_mul_sqrt_ratio and _km_ux_*, function for function, with the prefixes renamed
# (_km_ → _bj_k_, _KM_ → _BJ_K_) as src/crmath_k.cyr's copy was; what src/crmath_k.cyr already holds is used from
# there. Do not edit: re-run the script (port plan §10 G1: a shared module would replace both copies).

# The bit pattern of an f64, as an integer. The untyped parameter carries the word, and the
# `: i64` return types the caller's binding as an integer: a bare `var u = x;` copy of an f64
# is f64-typed, so its `<` would be a float compare.
#must_use
fn _bj_k_bits(x): i64 { return x; }

# 1 if x is NaN.
#must_use
fn _bj_k_is_nan(x: f64): i64 {
    if (x != x) { return 1; }
    return 0;
}

# The larger of x and y, ignoring a NaN operand (NaN only when both are). Equal operands,
# +0 and −0 included, give y: what rustc 1.99.1's `x.max(y)` returns (maxsd). Mirrors `f64::max`.
#must_use
fn _bj_k_max(x: f64, y: f64): f64 {
    if (x != x) { return y; }
    if (y != y) { return x; }
    if (x > y) { return x; }
    return y;
}

# ── error-free transformations (M2a) ───────────────────────────────────────────────────────────
# ── correctly rounded exp, expm1, exp10, ln and log10 (M3c-2a): ADR 0006 ────────────────────────

# 2^e as a double, for −1022 ≤ e ≤ 1023.
#must_use
fn _bj_k_cr_pow2(e): f64 {
    var b = (e + 1023) << 52;
    var r: f64 = b;
    return r;
}

# RN(2^e·(h + m + l)) for a normalised triple-double h + m + l in [0.99, 2.01], every result range: a normal
# result is RN3 then an exact scale (2^1024 in two steps; a significand that rounds up past DBL_MAX gives
# +∞, as IEEE overflow does). A result below 2^-1022 is rounded ONCE, at the subnormal grid: with
# y = 2^(e + 1022)·(h + m + l) < 1 (each part scaled exactly), RN(1 + y) has its ulp at 2^-52, which is
# 2^-1074 after the final scale, and (RN(1 + y) − 1)·2^-1022 is exact (glibc's specialcase technique). The
# sum 1 + yh + ym + yl is rounded exactly: 1 + yh = a + b (Fast2Sum), and RN(a + b + RO(ym + yl)) =
# RN(a + b + ym + yl) because every breakpoint minus a − b is a multiple of ulp(yh), an even multiple of
# ulp(RO(ym + yl)), and rounding to odd keeps the order against those.
#must_use
fn _bj_k_cr_finish(e, h: f64, m: f64, l: f64): f64 {
    if (e >= 0 - 1021) {
        var z: f64 = _bj_k_rn3(h, m, l);
        if (e > 1023) {
            var s1: f64 = _bj_k_cr_pow2(e - 1);
            var o: f64 = (z * s1) * 2.0;
            return o;
        }
        var s2: f64 = _bj_k_cr_pow2(e);
        var y: f64 = z * s2;
        return y;
    }
    var h1, m1a = _bj_k_fast_two_sum(h, m);    # renormalised, so the sign tests below decide y < 1
    var m1, l1 = _bj_k_two_sum(m1a, l);
    var s: f64 = _bj_k_cr_pow2(e + 1022);
    var yh: f64 = h1 * s;
    var ym: f64 = m1 * s;
    var yl: f64 = l1 * s;
    var normal = 0;
    if (yh > 1.0) { normal = 1; }
    if (yh == 1.0) {
        if (ym > 0.0) { normal = 1; }
        if (ym == 0.0 && yl >= 0.0) { normal = 1; }
    }
    if (normal == 1) {                       # y ≥ 1: the result is at least 2^-1022
        var z2: f64 = _bj_k_rn3(h, m, l);
        var s3: f64 = _bj_k_cr_pow2(e);
        var y2: f64 = z2 * s3;
        return y2;
    }
    var a, b = _bj_k_fast_two_sum(1.0, yh);
    var v: f64 = _bj_k_ro_sum(ym, yl);
    var w: f64 = _bj_k_rn3(a, b, v);
    var dmin: f64 = _bj_k_cr_pow2(0 - 1022);
    var r: f64 = (w - 1.0) * dmin;
    return r;
}

# ── exp ─────────────────────────────────────────────────────────────────────────────────────────

# The fast core for e^(xh + xl), |xh| ≤ 745.2 and |xl| ≤ 2^-42: (hi, lo, E) with hi + lo = e^x/2^E within
# 2^-70. exp passes xl = 0; exp10 passes x·ln 10 as xh + xl (xl folds into the K·L2 term).
#must_use
fn _bj_k_exp_core(xh: f64, xl: f64): (f64, f64, i64) {
    var inv: f64 = _BJ_K_CR_EXP_INVLN2N;
    var l1: f64 = _BJ_K_CR_EXP_L1;
    var l2: f64 = _BJ_K_CR_EXP_L2;
    var tt: f64 = (xh * inv) + 6755399441055744.0;   # 1.5·2^52: rounds x·512/ln 2 to an integer
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var ti = (k & 511) * 32;
    var e = k >>> 9;
    var rh: f64 = xh - (kd * l1);
    var s: f64 = (kd * l2) - xl;
    var r: f64 = rh - s;
    var rl: f64 = (rh - r) - s;
    var c: f64 = r + 49152.0;                         # 1.5·2^15: rounds r to a multiple of 2^-37
    var r1: f64 = c - 49152.0;
    var r2: f64 = r - r1;
    var p3: f64 = _BJ_K_CR_EXP_P3;
    var p4: f64 = _BJ_K_CR_EXP_P4;
    var p5: f64 = _BJ_K_CR_EXP_P5;
    var z: f64 = r * r;                       # Estrin: the code is latency-bound, so keep chains short
    var q: f64 = (z * (0.5 + (r * p3))) + ((z * z) * (p4 + (r * p5)));
    var a: f64 = load64(&_BJ_K_CR_EXP_T + ti);
    var b: f64 = load64(&_BJ_K_CR_EXP_T + ti + 8);
    var p1: f64 = a * r1;
    var hi: f64 = a + p1;
    var e1: f64 = p1 - (hi - a);
    var rlq: f64 = rl + q;
    var lo: f64 = (e1 + b) + ((a * (r2 + rlq)) + (b * (r + rlq)));
    return (hi, lo, e);
}

# The accurate core: e^(y0 + y1 + y2) = 2^E·(h + m + l), (h, m, l) stored at out[0..2], E returned. The same
# K as the fast path; r = y − K·(L1 + L2 + L3 + L4) as a triple-double (K·L1 exact, K·L2 and K·L3
# TwoProducts, K·L4 rounded: below 2^-186 of error); e^r − 1 by Horner in triple-double to r^11/11!
# (truncation 2^-152); T_j = A + B + C + D renormalised (2^-159); h + m + l = T_j + T_j·(e^r − 1). Measured
# relative error 2^-155 against 400-bit MPFR.
#must_use
fn _bj_k_exp_acc_core(y0: f64, y1: f64, y2: f64, out): i64 {
    var inv: f64 = _BJ_K_CR_EXP_INVLN2N;
    var l1: f64 = _BJ_K_CR_EXP_L1;
    var l2: f64 = _BJ_K_CR_EXP_L2;
    var l3: f64 = _BJ_K_CR_EXP_L3;
    var l4: f64 = _BJ_K_CR_EXP_L4;
    var tt: f64 = (y0 * inv) + 6755399441055744.0;
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var ti = (k & 511) * 32;
    var e = k >>> 9;
    var rh: f64 = y0 - (kd * l1);
    var a2, a2e = _bj_k_two_prod(kd, l2);
    var a3, a3e = _bj_k_two_prod(kd, l3);
    var a4: f64 = kd * l4;
    var ra0, ra1, ra2 = _bj_k_td_add_d(rh, 0.0, 0.0, -a2);
    var rb0, rb1, rb2 = _bj_k_td_add_d(ra0, ra1, ra2, y1);
    var rc0, rc1, rc2 = _bj_k_td_add_d(rb0, rb1, rb2, -a2e);
    var rd0, rd1, rd2 = _bj_k_td_add_d(rc0, rc1, rc2, -a3);
    var re0, re1, re2 = _bj_k_td_add_d(rd0, rd1, rd2, y2);
    var a34: f64 = a3e + a4;
    var r0, r1, r2 = _bj_k_td_add_d(re0, re1, re2, -a34);
    var sh: f64 = load64(&_BJ_K_CR_EXP_ACC + 216);    # 1/11! (index 3·(11 − 2))
    var sm: f64 = load64(&_BJ_K_CR_EXP_ACC + 224);
    var sl: f64 = load64(&_BJ_K_CR_EXP_ACC + 232);
    var n = 10;
    while (n >= 2) {
        var th, tm, tl = _bj_k_td_mul(r0, r1, r2, sh, sm, sl);
        var off = (n - 2) * 24;
        var ch: f64 = load64(&_BJ_K_CR_EXP_ACC + off);
        var cm: f64 = load64(&_BJ_K_CR_EXP_ACC + off + 8);
        var cl: f64 = load64(&_BJ_K_CR_EXP_ACC + off + 16);
        var uh, um, ul = _bj_k_td_add(ch, cm, cl, th, tm, tl);
        sh = uh;
        sm = um;
        sl = ul;
        n = n - 1;
    }
    var vh, vm, vl = _bj_k_td_mul(r0, r1, r2, sh, sm, sl);
    var wh, wm, wl = _bj_k_td_add_d(vh, vm, vl, 1.0);
    var ph, pm, pl = _bj_k_td_mul(r0, r1, r2, wh, wm, wl);     # e^r − 1
    var ta: f64 = load64(&_BJ_K_CR_EXP_T + ti);
    var tb: f64 = load64(&_BJ_K_CR_EXP_T + ti + 8);
    var tc: f64 = load64(&_BJ_K_CR_EXP_T + ti + 16);
    var td: f64 = load64(&_BJ_K_CR_EXP_T + ti + 24);
    var t0, t1a = _bj_k_fast_two_sum(ta, tb);
    var t1, t2a = _bj_k_fast_two_sum(t1a, tc);
    var t2: f64 = t2a + td;
    var qh, qm, ql = _bj_k_td_mul(t0, t1, t2, ph, pm, pl);
    var zh, zm, zl = _bj_k_td_add(t0, t1, t2, qh, qm, ql);
    store64(out, zh);
    store64(out + 8, zm);
    store64(out + 16, zl);
    return e;
}

# ── exp10 ───────────────────────────────────────────────────────────────────────────────────────
# ── expm1 ───────────────────────────────────────────────────────────────────────────────────────

# expm1(x) = e^x − 1, correctly rounded. ±0 → ±0 and |x| < 2^-53 → x (x²/2 is then below half an ulp of x,
# on the side that keeps x), +∞ → +∞, −∞ → −1, NaN for NaN; x above 709.782712893384 overflows, below
# −37.42994775023704 (e^x < 2^-54) rounds to −1.
#must_use
fn _bj_k_cr_expm1(x: f64): f64 {
    var y, ok = _bj_k_cr_expm1_fast(x);
    if (ok == 1) { return y; }
    var z: f64 = _bj_k_cr_expm1_acc(x);
    return z;
}

# The fast path alone: (its result, 1), or (0, 0) when its test fails or x > 708 (left to the accurate path).
#must_use
fn _bj_k_cr_expm1_fast(x: f64): (f64, i64) {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3F90000000000000) {               # |x| < 2^-6
        if (ax < 0x3CA0000000000000) { return (x, 1); }   # |x| < 2^-53, ±0, subnormals
        var p: f64 = x * x;                      # x² = p + pe exactly (Dekker, inline)
        var cx: f64 = 134217729.0 * x;
        var x1: f64 = cx - (cx - x);
        var x2: f64 = x - x1;
        var pe: f64 = (((x1 * x1) - p) + (2.0 * (x1 * x2))) + (x2 * x2);
        var k3: f64 = _BJ_K_CR_EXPM1_Q3;
        var k4: f64 = _BJ_K_CR_EXPM1_Q4;
        var k5: f64 = _BJ_K_CR_EXPM1_Q5;
        var k6: f64 = _BJ_K_CR_EXPM1_Q6;
        var k7: f64 = _BJ_K_CR_EXPM1_Q7;
        var k8: f64 = _BJ_K_CR_EXPM1_Q8;
        var k9: f64 = _BJ_K_CR_EXPM1_Q9;
        var s: f64 = ((k3 + (x * k4)) + (p * (k5 + (x * k6)))) + ((p * p) * ((k7 + (x * k8)) + (p * k9)));
        var x3: f64 = (x * p) * s;
        var hp: f64 = p * 0.5;
        var hs: f64 = x + hp;
        var ht: f64 = hp - (hs - x);
        var lo: f64 = (ht + (pe * 0.5)) + x3;
        var ex3: f64 = f64_abs(x3);
        var exa: f64 = f64_abs(x);
        var c49: f64 = 0x3CE0000000000000;      # 2^-49
        var c100: f64 = 0x39B0000000000000;     # 2^-100
        var err: f64 = (ex3 * c49) + (exa * c100);
        var u: f64 = hs + (lo - err);
        var v: f64 = hs + (lo + err);
        if (u == v) { return (u, 1); }
        return (0.0, 0);
    }
    var m1b = _BJ_K_CR_EXPM1_M1 & 0x7FFFFFFFFFFFFFFF;
    if (ax > m1b) {                              # |x| > 37.42994775023704
        if (x < 0.0) { return (-1.0, 1); }       # x < EXPM1_M1 (−∞ included): e^x < 2^-54
        if (ax > 0x4086200000000000) {           # x > 708, +∞, NaN: left to the accurate path (which returns
            return (0.0, 0);                     # the specials at once)
        }
    }
    var hi, lo2, e = _bj_k_exp_core(x, 0.0);
    var hh: f64 = 0.0;
    var ll: f64 = lo2;
    var sc: f64 = 1.0;
    if (e == 0) {
        hh = hi - 1.0;                           # exact: hi in [0.9993, 1.9987]
    } else {
        sc = _bj_k_cr_pow2(e);
        var hsc: f64 = hi * sc;
        if (e > 0) {
            hh = hsc - 1.0;
            var t1: f64 = -1.0 - (hh - hsc);
            ll = t1 + (lo2 * sc);
        } else {
            hh = -1.0 + hsc;
            var t2: f64 = hsc - (hh + 1.0);
            ll = t2 + (lo2 * sc);
        }
    }
    var err2: f64 = 0x3BA0000000000000;      # 2^-69
    var errs: f64 = err2 * sc;
    var u2: f64 = hh + (ll - errs);
    var v2: f64 = hh + (ll + errs);
    if (u2 == v2) { return (u2, 1); }
    return (0.0, 0);
}

# expm1 by the accurate path alone. |x| < 2^-6: x + x²/2 + … + x^17/17! by Horner in triple-double on the
# exact x (truncation below 2^-154 of x; measured 2^-155). Otherwise e^x from exp's accurate core, scaled,
# minus 1 in triple-double (|expm1(x)| ≥ 0.0155: at most 6.1 bits of cancellation; measured 2^-152); for
# E ≥ 120 the −1 is below 2^-114 of e^x, inside exp's own worst-case distance (Lefèvre–Muller: 2^-113 for
# |x| ≥ 2^-30), so it cannot move the rounding and expm1 rounds as exp does.
#must_use
fn _bj_k_cr_expm1_acc(x: f64): f64 {
    if (x != x) { return x; }
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3CA0000000000000) { return x; }
    var ovf: f64 = _BJ_K_CR_EXPM1_OVF;
    var m1: f64 = _BJ_K_CR_EXPM1_M1;
    if (x > ovf) { return _BJ_K_INF; }
    if (x < m1) { return -1.0; }
    if (ax < 0x3F90000000000000) {
        var sh: f64 = load64(&_BJ_K_CR_EXP_ACC + 360);   # 1/17! (index 3·(17 − 2))
        var sm: f64 = load64(&_BJ_K_CR_EXP_ACC + 368);
        var sl: f64 = load64(&_BJ_K_CR_EXP_ACC + 376);
        var n = 16;
        while (n >= 2) {
            var th, tm, tl = _bj_k_td_mul_d(sh, sm, sl, x);
            var off = (n - 2) * 24;
            var ch: f64 = load64(&_BJ_K_CR_EXP_ACC + off);
            var cm: f64 = load64(&_BJ_K_CR_EXP_ACC + off + 8);
            var cl: f64 = load64(&_BJ_K_CR_EXP_ACC + off + 16);
            var uh, um, ul = _bj_k_td_add(ch, cm, cl, th, tm, tl);
            sh = uh;
            sm = um;
            sl = ul;
            n = n - 1;
        }
        var vh, vm, vl = _bj_k_td_mul_d(sh, sm, sl, x);
        var wh, wm, wl = _bj_k_td_add_d(vh, vm, vl, 1.0);
        var ph, pm, pl = _bj_k_td_mul_d(wh, wm, wl, x);
        var r: f64 = _bj_k_rn3(ph, pm, pl);
        return r;
    }
    var buf: f64[3];
    var e = _bj_k_exp_acc_core(x, 0.0, 0.0, &buf);
    if (e >= 120) {
        var big: f64 = _bj_k_cr_finish(e, buf[0], buf[1], buf[2]);
        return big;
    }
    var sc: f64 = _bj_k_cr_pow2(e);
    var bh: f64 = buf[0] * sc;
    var bm: f64 = buf[1] * sc;
    var bl: f64 = buf[2] * sc;
    var dh, dm, dl = _bj_k_td_add_d(bh, bm, bl, -1.0);
    var r2: f64 = _bj_k_rn3(dh, dm, dl);
    return r2;
}

# ── ln and log10 ────────────────────────────────────────────────────────────────────────────────
# ── pow (M3c-2b) ────────────────────────────────────────────────────────────────────────────────

# RN(mm·2^s) for an integer 1 ≤ mm < 2^62 and an integer |s| < 2^40, by integer rounding: ties to even,
# subnormal results on the 2^-1074 grid, +∞ past DBL_MAX, +0 below half of 2^-1074. Exact, so it rounds exact
# results and exact midpoints right.
#must_use
fn _bj_k_cr_from_int(mm, s): f64 {
    var b = 0;
    var t = mm;
    while (t != 0) {
        t = t >> 1;
        b = b + 1;
    }
    var top = s + b - 1;                         # the exponent of mm·2^s's leading bit
    if (top > 1023) {
        var inf: f64 = _BJ_K_INF;
        return inf;
    }
    var lsb = top - 52;                          # the result's last bit, at most 53 bits and not below 2^-1074
    if (lsb < 0 - 1074) { lsb = 0 - 1074; }
    var sh = lsb - s;
    var q = mm;
    if (sh > 0) {
        if (sh > 62) { return 0.0; }
        q = mm >> sh;
        var rem = mm - (q << sh);
        var half = 1 << (sh - 1);
        if (rem > half || (rem == half && (q & 1) == 1)) { q = q + 1; }
    } else {
        lsb = s;
    }
    var qf: f64 = f64_from(q);                   # q ≤ 2^53: exact
    if (lsb >= 0 - 1022) {
        var sc: f64 = _bj_k_cr_pow2(lsb);
        var r: f64 = qf * sc;                    # exact, or +∞ when q·2^lsb = 2^1024
        return r;
    }
    var s1: f64 = _bj_k_cr_pow2(lsb + 1074);       # q·2^lsb = ((q·2^(lsb + 1074))·2^-52)·2^-1022: each step exact
    var s2: f64 = _bj_k_cr_pow2(0 - 52);
    var s3: f64 = _bj_k_cr_pow2(0 - 1022);
    var w: f64 = ((qf * s1) * s2) * s3;
    return w;
}

# ── sin and cos (M4a) ───────────────────────────────────────────────────────────────────────────
# ── atan2 and acos (M4a) ────────────────────────────────────────────────────────────────────────
# ── x·2^y, correctly rounded (M4d): ADR 0002 #13 ──────────────────────────────────────────────────────
# ── 1/(100·x), correctly rounded (M4e): ADR 0002 #19 ──────────────────────────────────────────────────
# ── binary64 with an unbounded exponent (M4e-2): ADR 0002 #20 ──────────────────────────────────────────────

# (s, e) for a double r whose magnitude is normal, times 2^e: s is r with its exponent field set to 0 (1 ≤ |s| < 2), e
# plus r's exponent. A zero or a special gives (r, 0). r is never subnormal here (every caller's r is a significand
# operation's result, at least 2^-107 in magnitude, or a value _bj_k_ux_from has scaled).
#must_use
fn _bj_k_ux_norm(r: f64, e): (f64, i64) {
    var b = load64(&r);
    var be = (b >> 52) & 0x7FF;
    if (be == 0 || be == 0x7FF) { return (r, 0); }
    var sb = (b & 0x800FFFFFFFFFFFFF) | 0x3FF0000000000000;
    var s: f64 = sb;
    return (s, e + be - 1023);
}

# The unbounded-exponent value of a double x: (s, e) with x = s·2^e exactly (subnormals included); ±0, ±∞ and NaN give
# (x, 0).
#must_use
fn _bj_k_ux_from(x: f64): (f64, i64) {
    var b = load64(&x);
    if ((b & 0x7FF0000000000000) == 0 && (b & 0x7FFFFFFFFFFFFFFF) != 0) {
        var p54: f64 = 0x4350000000000000;           # 2^54: a subnormal scaled into the normal range, exactly
        var y: f64 = x * p54;
        var s, e = _bj_k_ux_norm(y, 0 - 54);
        return (s, e);
    }
    var s2, e2 = _bj_k_ux_norm(x, 0);
    return (s2, e2);
}

# −x.
#must_use
fn _bj_k_ux_neg(xs: f64, xe): (f64, i64) {
    var n: f64 = -xs;
    return (n, xe);
}

# x·y, rounded to 53 bits with an unbounded exponent.
#must_use
fn _bj_k_ux_mul(xs: f64, xe, ys: f64, ye): (f64, i64) {
    var p: f64 = xs * ys;
    var s, e = _bj_k_ux_norm(p, xe + ye);
    return (s, e);
}

# x/y, rounded to 53 bits with an unbounded exponent (y = ±0 gives IEEE's ±∞ or NaN).
#must_use
fn _bj_k_ux_div(xs: f64, xe, ys: f64, ye): (f64, i64) {
    var q: f64 = xs / ys;
    var s, e = _bj_k_ux_norm(q, xe - ye);
    return (s, e);
}

# √x, rounded to 53 bits with an unbounded exponent: √s·2^(e/2), or √(2s)·2^((e − 1)/2) for an odd e (2s exact).
# ±0, a negative x, ±∞ and NaN as IEEE's √ (√−0 = −0).
#must_use
fn _bj_k_ux_sqrt(xs: f64, xe): (f64, i64) {
    if (xs <= 0.0 || xs != xs || xs == _BJ_K_INF) {
        var z: f64 = f64_sqrt(xs);
        return (z, 0);
    }
    var odd = xe & 1;
    var w: f64 = xs;
    if (odd != 0) { w = xs * 2.0; }
    var r: f64 = f64_sqrt(w);
    var s, e = _bj_k_ux_norm(r, (xe - odd) / 2);
    return (s, e);
}

# x + y, rounded to 53 bits with an unbounded exponent (the section comment's argument). A zero operand contributes
# nothing (x + ±0 = x); two zeros, or a special, add as IEEE's significands do.
#must_use
fn _bj_k_ux_add(xs: f64, xe, ys: f64, ye): (f64, i64) {
    var dx: f64 = xs - xs;
    var dy: f64 = ys - ys;
    if (xs == 0.0 || ys == 0.0 || dx != 0.0 || dy != 0.0) {
        if (ys == 0.0 && xs != 0.0 && dx == 0.0) { return (xs, xe); }
        if (xs == 0.0 && ys != 0.0 && dy == 0.0) { return (ys, ye); }
        var z: f64 = xs + ys;
        return (z, 0);
    }
    var hs: f64 = xs;
    var he = xe;
    var ls: f64 = ys;
    var le = ye;
    if (ye > xe) {
        hs = ys;
        he = ye;
        ls = xs;
        le = xe;
    }
    var d = he - le;
    if (d > 55) { return (hs, he); }
    var sc: f64 = _bj_k_cr_pow2(0 - d);
    var t: f64 = ls * sc;                           # exact: at least 2^-55
    var r: f64 = hs + t;
    var s, e = _bj_k_ux_norm(r, he);
    return (s, e);
}

# x − y, rounded to 53 bits with an unbounded exponent: x + (−y) (IEEE's x − y, signed zeros included).
#must_use
fn _bj_k_ux_sub(xs: f64, xe, ys: f64, ye): (f64, i64) {
    var ny: f64 = -ys;
    var s, e = _bj_k_ux_add(xs, xe, ny, ye);
    return (s, e);
}

# −1, 0 or 1 as x <, =, > y in exact value; 2 when either is NaN. Zeros are equal whatever their signs.
#must_use
fn _bj_k_ux_cmp(xs: f64, xe, ys: f64, ye): i64 {
    if (xs != xs || ys != ys) { return 2; }
    var dx: f64 = xs - xs;
    var dy: f64 = ys - ys;
    if (xs == 0.0 || ys == 0.0 || dx != 0.0 || dy != 0.0) {
        # a zero or ±∞ against anything: the significands order the values (a finite nonzero one is 1 ≤ |s| < 2)
        if (xs < ys) { return 0 - 1; }
        if (xs > ys) { return 1; }
        return 0;
    }
    if ((xs < 0.0) != (ys < 0.0)) {
        if (xs < 0.0) { return 0 - 1; }
        return 1;
    }
    if (xe == ye) {
        if (xs < ys) { return 0 - 1; }
        if (xs > ys) { return 1; }
        return 0;
    }
    var c = 1;
    if (xe < ye) { c = 0 - 1; }
    if (xs < 0.0) { c = 0 - c; }
    return c;
}

# 1 if x ≤ y (false for a NaN), as f64's `<=` on the exact values.
#must_use
fn _bj_k_ux_le(xs: f64, xe, ys: f64, ye): i64 {
    var c = _bj_k_ux_cmp(xs, xe, ys, ye);
    if (c == 0 - 1 || c == 0) { return 1; }
    return 0;
}

# Rust's x.max(y) on the exact values (_bj_k_max's semantics): a NaN operand is ignored, equal operands give y.
#must_use
fn _bj_k_ux_max(xs: f64, xe, ys: f64, ye): (f64, i64) {
    if (xs != xs) { return (ys, ye); }
    if (ys != ys) { return (xs, xe); }
    if (_bj_k_ux_cmp(xs, xe, ys, ye) == 1) { return (xs, xe); }
    return (ys, ye);
}

# 1 if 0 < x < +∞ (validate.cyr's _bj_k_is_positive on the exact value): a normalised value's sign and class are its
# significand's.
#must_use
fn _bj_k_ux_is_positive(xs: f64, xe): i64 {
    if (xs > 0.0 && xs < _BJ_K_INF) { return 1; }
    return 0;
}

# 1 if the double x is the 53-bit rounding of an exact value in binary64's normal range, by its magnitude alone: |x| in
# [2⁻¹⁰²¹, DBL_MAX]. An IEEE product, quotient or square root that large has an exact value above 2⁻¹⁰²² (RN is
# monotone: below 2⁻¹⁰²² it rounds to at most 2⁻¹⁰²²), where binary64's rounding is the 53-bit one, and a finite one is
# not past DBL_MAX (IEEE overflow is the 53-bit rounding past it). 2⁻¹⁰²² itself is excluded: a value just below it
# rounds there at the subnormal grid but below it at 53 bits. The fast-path range tests of the overflow audit's
# #20-style functions (B3: gas, potential, inorganic) use it.
#must_use
fn _bj_k_ux_normal(x: f64): i64 {
    var u = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (u < 0x0020000000000000 || u > 0x7FEFFFFFFFFFFFFF) { return 0; }
    return 1;
}

# RN((s + t)·2^e) in binary64, rounded once, for a normalised s with s = RN53(s + t) (|t| at most half an ulp of s: t
# is the exact error of the operation that produced s, or 0 for an exact value): s·2^e itself when it is normal
# (2^-1022 ≤ |s·2^e|, e ≤ 1023); ±∞ past e = 1023; at the 2^-1074 grid by _bj_k_cr_finish (|s| + ±t, scaled once) below
# 2^-1022, where t breaks a midpoint s·2^e toward the exact value (the section comment); ±0 below 2^-1100 (under a
# quarter of 2^-1074). A zero or a special s is returned as it is.
#must_use
fn _bj_k_ux_round(s: f64, e, t: f64): f64 {
    var ds: f64 = s - s;
    if (s == 0.0 || ds != 0.0) { return s; }
    if (e > 1023) {
        var inf: f64 = _BJ_K_INF;
        if (s < 0.0) { inf = -inf; }
        return inf;
    }
    if (e >= 0 - 1022) {
        var sc: f64 = _bj_k_cr_pow2(e);
        var y: f64 = s * sc;
        return y;
    }
    if (e < 0 - 1100) {
        var z: f64 = s * 0.0;
        return z;
    }
    var h: f64 = s;
    var m: f64 = t;
    if (s < 0.0) {
        h = -s;
        m = -t;
    }
    var r: f64 = _bj_k_cr_finish(e, h, m, 0.0);
    if (s < 0.0) { r = -r; }
    return r;
}

# RN(x·y) in binary64, rounded once: the 53-bit product (TwoProduct of the significands, its exact error), then
# _bj_k_ux_round. A zero or special operand gives IEEE's product of the significands.
#must_use
fn _bj_k_ux_mul_f64(xs: f64, xe, ys: f64, ye): f64 {
    var p: f64 = xs * ys;
    var dp: f64 = p - p;
    if (p == 0.0 || dp != 0.0) { return p; }
    var ph, pe = _bj_k_two_prod(xs, ys);
    var e = xe + ye;
    if (ph >= 2.0 || ph <= -2.0) {
        ph = ph * 0.5;
        pe = pe * 0.5;
        e = e + 1;
    }
    var r: f64 = _bj_k_ux_round(ph, e, pe);
    return r;
}

# RN(x/y) in binary64, rounded once: q = RN(s₁/s₂), the remainder s₁ − q·s₂ (s₁ − p exact by Sterbenz, p = RN(q·s₂),
# then − pe: the sign is exact), its quotient by s₂ as the error, then _bj_k_ux_round. A zero dividend, a zero divisor
# or a special gives IEEE's quotient of the significands.
#must_use
fn _bj_k_ux_div_f64(xs: f64, xe, ys: f64, ye): f64 {
    var q: f64 = xs / ys;
    var dq: f64 = q - q;
    var dy: f64 = ys - ys;
    if (q == 0.0 || dq != 0.0 || dy != 0.0) { return q; }
    var p, pe = _bj_k_two_prod(q, ys);
    var rem: f64 = (xs - p) - pe;
    var t: f64 = rem / ys;
    var e = xe - ye;
    if (q < 1.0 && q > -1.0) {
        q = q * 2.0;
        t = t * 2.0;
        e = e - 1;
    }
    var r: f64 = _bj_k_ux_round(q, e, t);
    return r;
}

# RN(x + y) in binary64, rounded once: TwoSum of the aligned significands (d ≤ 55), its sum renormalised with its error;
# for d ≥ 56 the larger term with a sticky ±2^-60 in the smaller's direction (below a quarter ulp, so it moves only a
# midpoint, which is where the exact sum's side matters). A zero operand gives the other rounded once; two zeros or a
# special, IEEE's sum.
#must_use
fn _bj_k_ux_add_f64(xs: f64, xe, ys: f64, ye): f64 {
    var dx: f64 = xs - xs;
    var dy: f64 = ys - ys;
    if (dx != 0.0 || dy != 0.0 || (xs == 0.0 && ys == 0.0)) {
        var z: f64 = xs + ys;
        return z;
    }
    if (xs == 0.0) {
        var ry: f64 = _bj_k_ux_round(ys, ye, 0.0);
        return ry;
    }
    if (ys == 0.0) {
        var rx: f64 = _bj_k_ux_round(xs, xe, 0.0);
        return rx;
    }
    var hs: f64 = xs;
    var he = xe;
    var ls: f64 = ys;
    var le = ye;
    if (ye > xe) {
        hs = ys;
        he = ye;
        ls = xs;
        le = xe;
    }
    var d = he - le;
    if (d > 55) {
        var st: f64 = 0x3C30000000000000;           # 2^-60
        if (ls < 0.0) { st = -st; }
        var rs: f64 = _bj_k_ux_round(hs, he, st);
        return rs;
    }
    var sc: f64 = _bj_k_cr_pow2(0 - d);
    var t: f64 = ls * sc;                           # exact
    var r, err = _bj_k_two_sum(hs, t);
    if (r == 0.0) { return r; }                     # an exact cancellation: +0
    var s, e = _bj_k_ux_norm(r, he);
    var k = e - he;                                 # r = s·2^k, −107 ≤ k ≤ 1
    var ks: f64 = _bj_k_cr_pow2(0 - k);
    var te: f64 = err * ks;                         # exact (err is a multiple of 2^-107)
    var y: f64 = _bj_k_ux_round(s, e, te);
    return y;
}

# RN(x − y) in binary64, rounded once.
#must_use
fn _bj_k_ux_sub_f64(xs: f64, xe, ys: f64, ye): f64 {
    var ny: f64 = -ys;
    var r: f64 = _bj_k_ux_add_f64(xs, xe, ny, ye);
    return r;
}

# RN(√x) in binary64, rounded once: r = RN(√w) (w = s or 2s, in [1, 4)), the residual w − r² (r² = p + pe by
# TwoProduct, w − p exact by Sterbenz, then − pe: its sign is exact), its quotient by 2r as the error, then
# _bj_k_ux_round. √x is either exact (a 27-bit significand) or irrational, so a midpoint is only ever an exact one,
# broken to even. ±0, a negative x, ±∞ and NaN as IEEE's √.
#must_use
fn _bj_k_ux_sqrt_f64(xs: f64, xe): f64 {
    if (xs <= 0.0 || xs != xs || xs == _BJ_K_INF) {
        var z: f64 = f64_sqrt(xs);
        return z;
    }
    var odd = xe & 1;
    var w: f64 = xs;
    if (odd != 0) { w = xs * 2.0; }
    var r: f64 = f64_sqrt(w);
    var p, pe = _bj_k_two_prod(r, r);
    var rem: f64 = (w - p) - pe;
    var tr: f64 = r + r;
    var t: f64 = rem / tr;
    var k = (xe - odd) / 2;
    if (r >= 2.0) {                                 # √w rounded up to 2: (1, k + 1)
        r = r * 0.5;
        t = t * 0.5;
        k = k + 1;
    }
    var y: f64 = _bj_k_ux_round(r, k, t);
    return y;
}

# ── exact rationals rounded once (M4e-3): ADR 0002 #21, #22 ──────────────────────────────────────────────────

# The capacity of a multi-word integer, in 32-bit limbs (8: below 2^256, 64 bytes).
const _BJ_K_BN_LIMBS = 8;

# a = v, for v a 64-bit word read as unsigned (the other limbs cleared).
fn _bj_k_bn_set(a, v) {
    store64(a, v & 0xFFFFFFFF);
    store64(a + 8, v >> 32);
    var k = 2;
    while (k < _BJ_K_BN_LIMBS) {
        store64(a + 8 * k, 0);
        k = k + 1;
    }
    return 0;
}

# a = b.
fn _bj_k_bn_copy(a, b) {
    var k = 0;
    while (k < _BJ_K_BN_LIMBS) {
        store64(a + 8 * k, load64(b + 8 * k));
        k = k + 1;
    }
    return 0;
}

# The bit length of a (0 for zero).
#must_use
fn _bj_k_bn_bitlen(a): i64 {
    var k = _BJ_K_BN_LIMBS - 1;
    while (k >= 0) {
        var w = load64(a + 8 * k);
        if (w != 0) {
            var b = 0;
            while (w != 0) {
                w = w >> 1;
                b = b + 1;
            }
            return 32 * k + b;
        }
        k = k - 1;
    }
    return 0;
}

# −1, 0 or 1 as a <, =, > b.
#must_use
fn _bj_k_bn_cmp(a, b): i64 {
    var k = _BJ_K_BN_LIMBS - 1;
    while (k >= 0) {
        var x = load64(a + 8 * k);
        var y = load64(b + 8 * k);
        if (x < y) { return 0 - 1; }
        if (x > y) { return 1; }
        k = k - 1;
    }
    return 0;
}

# r = a + b (r may be a or b); the sum must be below 2^256.
fn _bj_k_bn_add(r, a, b) {
    var c = 0;
    var k = 0;
    while (k < _BJ_K_BN_LIMBS) {
        var s = load64(a + 8 * k) + load64(b + 8 * k) + c;
        store64(r + 8 * k, s & 0xFFFFFFFF);
        c = s >> 32;
        k = k + 1;
    }
    return 0;
}

# r = a − b, for a ≥ b (r may be a or b).
fn _bj_k_bn_sub(r, a, b) {
    var borrow = 0;
    var k = 0;
    while (k < _BJ_K_BN_LIMBS) {
        var d = load64(a + 8 * k) - load64(b + 8 * k) - borrow;
        borrow = 0;
        if (d < 0) {
            d = d + 0x100000000;
            borrow = 1;
        }
        store64(r + 8 * k, d);
        k = k + 1;
    }
    return 0;
}

# a = a·m in place, for 0 ≤ m < 2^32; the product must be below 2^256. Each limb·m + carry is below 2^64.
fn _bj_k_bn_mul_small(a, m) {
    var c = 0;
    var k = 0;
    while (k < _BJ_K_BN_LIMBS) {
        var t = load64(a + 8 * k) * m + c;
        store64(a + 8 * k, t & 0xFFFFFFFF);
        c = t >> 32;
        k = k + 1;
    }
    return 0;
}

# r = a·b, schoolbook on the limbs, r distinct from a and b; the product must be below 2^256. Each limb product plus
# the partial limb and the carry is below 2^64.
fn _bj_k_bn_mul(r, a, b) {
    var k = 0;
    while (k < _BJ_K_BN_LIMBS) {
        store64(r + 8 * k, 0);
        k = k + 1;
    }
    var la = (_bj_k_bn_bitlen(a) + 31) / 32;
    var lb = (_bj_k_bn_bitlen(b) + 31) / 32;
    var i = 0;
    while (i < la) {
        var ai = load64(a + 8 * i);
        var c = 0;
        var j = 0;
        while (j < lb && i + j < _BJ_K_BN_LIMBS) {
            var t = ai * load64(b + 8 * j) + load64(r + 8 * (i + j)) + c;
            store64(r + 8 * (i + j), t & 0xFFFFFFFF);
            c = t >> 32;
            j = j + 1;
        }
        if (i + lb < _BJ_K_BN_LIMBS) { store64(r + 8 * (i + lb), c); }
        i = i + 1;
    }
    return 0;
}

# a = a·2^s in place, for s ≥ 0; the result must be below 2^256.
fn _bj_k_bn_shl(a, s) {
    var w = s / 32;
    var b = s - 32 * w;
    var k = _BJ_K_BN_LIMBS - 1;
    while (k >= 0) {
        var v = 0;
        if (k - w >= 0) {
            v = (load64(a + 8 * (k - w)) << b) & 0xFFFFFFFF;
            if (b > 0 && k - w - 1 >= 0) { v = v | (load64(a + 8 * (k - w - 1)) >> (32 - b)); }
        }
        store64(a + 8 * k, v);
        k = k - 1;
    }
    return 0;
}

# (M, E) with x = M·2^E and 2^52 ≤ M < 2^53 for the bits b of a positive finite nonzero double (a subnormal's
# significand shifted up, E below −1074).
#must_use
fn _bj_k_f64_int(b): (i64, i64) {
    var be = b >> 52;
    var m = b & 0x000FFFFFFFFFFFFF;
    if (be != 0) { return (m | 0x0010000000000000, be - 1075); }
    var e = 0 - 1074;
    while (m < 0x0010000000000000) {
        m = m << 1;
        e = e - 1;
    }
    return (m, e);
}

# RN(p/q·2^e) in binary64, rounded once, for multi-word integers 0 ≤ p < 2^254 and 1 ≤ q < 2^254 and |e| < 2^39 (the
# section comment): exact, ties to even, subnormal results on the 2^-1074 grid, +∞ past DBL_MAX, +0 for p = 0 and below
# half of 2^-1074. p and q are not changed.
#must_use
fn _bj_k_cr_ratio(p, q, e): f64 {
    var bp = _bj_k_bn_bitlen(p);
    if (bp == 0) { return 0.0; }
    var bq = _bj_k_bn_bitlen(q);
    var nb[64];
    var db[64];
    var tb[64];
    _bj_k_bn_copy(&nb, p);
    _bj_k_bn_copy(&db, q);
    var t = bp - bq;
    var ll = bp;
    if (t >= 0) {
        _bj_k_bn_shl(&db, t);
    } else {
        _bj_k_bn_shl(&nb, 0 - t);
        ll = bq;
    }
    if (_bj_k_bn_cmp(&nb, &db) < 0) {
        _bj_k_bn_shl(&nb, 1);
        t = t - 1;
    }
    var n = (ll + 32) / 32;                         # the limbs of L + 1 bits: N < 2D throughout
    var np = &nb;
    var tp = &tb;
    var qq = 0;
    var i = 0;
    while (i < 55) {
        var borrow = 0;                             # T = N − D, kept when it does not borrow
        var k = 0;
        while (k < n) {
            var d = load64(np + 8 * k) - load64(&db + 8 * k) - borrow;
            borrow = 0;
            if (d < 0) {
                d = d + 0x100000000;
                borrow = 1;
            }
            store64(tp + 8 * k, d);
            k = k + 1;
        }
        qq = qq << 1;
        if (borrow == 0) {
            var sw = np;
            np = tp;
            tp = sw;
            qq = qq + 1;
        }
        var c = 0;                                  # N = 2N
        k = 0;
        while (k < n) {
            var w = load64(np + 8 * k);
            store64(np + 8 * k, ((w << 1) | c) & 0xFFFFFFFF);
            c = w >> 31;
            k = k + 1;
        }
        i = i + 1;
    }
    var sticky = 0;
    var j = 0;
    while (j < n) {
        if (load64(np + 8 * j) != 0) { sticky = 1; }
        j = j + 1;
    }
    var r: f64 = _bj_k_cr_from_int(2 * qq + sticky, e + t - 55);
    return r;
}

# (a_h + a_l)·(b_h + b_l) as a normalised double-double (h, l): TwoProduct of the heads (p + e exactly), the cross terms
# a_h·b_l + a_l·b_h rounded, a_l·b_l dropped, e + c rounded, FastTwoSum (exact, |p| ≥ |e + c|). For normalised inputs
# (|a_l| ≤ 2^-53·|a_h|, likewise b) with |a_h|, |b_h| < 2^996 and |a_h·b_h| ≥ 2^-900 (TwoProduct's conditions, every
# term normal): h + l = (a_h + a_l)(b_h + b_l)(1 + δ) with |δ| ≤ 8.01·2^-106 < 2^-102.99 (with u = 2^-53 and
# P = |a_h·b_h|: the two cross products' roundings u²·P each, their sum's 2u²·P, e + c's 3u²·P, the dropped term u²·P,
# so 8u²(1 + u)·P, and P ≤ |product|/(1 − u)²), |l| ≤ 2^-53·|h|.
#must_use
fn _bj_k_dd_mul(ah: f64, al: f64, bh: f64, bl: f64): (f64, f64) {
    var p, e = _bj_k_two_prod(ah, bh);
    var c: f64 = (ah * bl) + (al * bh);
    var t: f64 = e + c;
    var h, l = _bj_k_fast_two_sum(p, t);
    return (h, l);
}

# (RN(n/d), 1) for the double-double quotient n/d = (n_h + n_l)/(d_h + d_l) of an exact positive value v, or (0, 0) when
# the rounding test fails. n and d are normalised (|n_l| ≤ 2^-53·n_h, likewise d), n_h, d_h and n_h/d_h in
# [2^-900, 2^900], and they may carry relative errors δn, δd (n = N(1 + δn), d = D(1 + δd), v = N/D) with
# |δn| + |δd| ≤ 32u², u = 2^-53. y0 = RN(n_h/d_h); y0·d_h = a + b (TwoProduct); n_h − a is exact (Sterbenz: a is within
# 2u of n_h); r = (((n_h − a) − b) + n_l) − y0·d_l is n − y0·d to 7.04u²·n (four roundings: u²·n_h, 2.01u², 1.01u² and
# 3.01u² of n_h); d = RN(r/d_h) (|r| ≤ 3.02u·n, and r/d_h is r/d to 2.01u, so d is r/d to 6.08u²·v); so y0 + d is n/d to
# 13.12u², and v to 13.12u² + 32.01u² = 45.13u². The test: ε = 2^-100·y0 = 64u²·y0 ≥ 63.9u²·v; RN(d ∓ ε) are d ∓ ε to
# 3.04u²·v, so y0 + RN(d − ε) < v < y0 + RN(d + ε), and when the two sums round to the same double, RN being monotone,
# v rounds to it: exact values (half an ulp from every boundary) pass, a midpoint never does. It fails with probability
# about 2^-46 (v within 2^-99 of a midpoint, relative).
#must_use
fn _bj_k_dd_div_cr(nh: f64, nl: f64, dh: f64, dl: f64): (f64, i64) {
    var y0: f64 = nh / dh;
    var a: f64 = y0 * dh;                           # y0·d_h = a + b: TwoProduct, inline (Veltkamp's 2^27 + 1 split)
    var sp: f64 = 134217729.0;
    var cy: f64 = sp * y0;
    var yh: f64 = cy - (cy - y0);
    var yl: f64 = y0 - yh;
    var cd: f64 = sp * dh;
    var dhh: f64 = cd - (cd - dh);
    var dhl: f64 = dh - dhh;
    var b: f64 = (yl * dhl) - (((a - (yh * dhh)) - (yl * dhh)) - (yh * dhl));
    var s: f64 = nh - a;
    var s1: f64 = s - b;
    var s2: f64 = s1 + nl;
    var s3: f64 = y0 * dl;
    var r: f64 = s2 - s3;
    var d: f64 = r / dh;
    var k100: f64 = 0x39B0000000000000;             # 2^-100
    var eps: f64 = y0 * k100;
    var lo: f64 = d - eps;
    var hi: f64 = d + eps;
    var z1: f64 = y0 + lo;
    var z2: f64 = y0 + hi;
    if (z1 != z2) { return (0.0, 0); }
    return (z1, 1);
}

# ── correctly rounded monomials (the overflow audit's B1, B2): ADR 0002 #27 … #30 ────────────────────────────────────

# The factor limits (the fast path's error budget above, the significand tables below).
const _BJ_K_MONO_NMAX = 6;

const _BJ_K_MONO_DMAX = 4;

# (a_h + a_l)·b as a normalised double-double (h, l), for a normalised a (|a_l| ≤ u·|a_h|, u = 2⁻⁵³) and a double b with
# |a_h|, |b| < 2⁹⁹⁶ and |a_h·b| ≥ 2⁻⁹⁰⁰ (TwoProduct's conditions): a_h·b = p + e exactly; c = RN(a_l·b), within
# u·|a_l·b| ≤ u²·P (P = |a_h·b|); t = RN(e + c), within 2u²(1 + u)·P (|e| ≤ u·|p| and |c| ≤ u(1 + u)·P);
# FastTwoSum(p, t) exact (|t| ≤ 2.01u·|p|). So h + l = a·b + δ with |δ| ≤ (3 + 2u)u²·P ≤ 3.01u²·|a·b|
# (P ≤ |a·b|/(1 − u)), and |l| ≤ u·|h|.
#must_use
fn _bj_k_dd_mul_d(ah: f64, al: f64, b: f64): (f64, f64) {
    var p: f64 = ah * b;                            # a_h·b = p + e: TwoProduct, inline (Veltkamp's 2^27 + 1 split)
    var sp: f64 = 134217729.0;
    var ca: f64 = sp * ah;
    var ahh: f64 = ca - (ca - ah);
    var ahl: f64 = ah - ahh;
    var cb: f64 = sp * b;
    var bh: f64 = cb - (cb - b);
    var bl: f64 = b - bh;
    var e: f64 = (ahl * bl) - (((p - (ahh * bh)) - (ahl * bh)) - (ahh * bl));
    var c: f64 = al * b;
    var t: f64 = e + c;
    var h: f64 = p + t;                             # FastTwoSum(p, t), inline
    var l: f64 = t - (h - p);
    return (h, l);
}

# _bj_k_dd_div_cr's steps without the verdict: (z₁, z₂) = (RN(y₀ + RN(d − ε)), RN(y₀ + RN(d + ε))) for the quotient n/d
# of normalised double-doubles under _bj_k_dd_div_cr's conditions, whose proof gives y₀ + RN(d − ε) < v < y₀ + RN(d + ε)
# for the exact value v: z₁ = z₂ is RN(v), and otherwise v lies strictly between two points within 2⁻⁹⁸·v of each other
# that round to z₁ and z₂.
#must_use
fn _bj_k_dd_div_ends(nh: f64, nl: f64, dh: f64, dl: f64): (f64, f64) {
    var y0: f64 = nh / dh;
    var a: f64 = y0 * dh;                           # y0·d_h = a + b: TwoProduct, inline (Veltkamp's 2^27 + 1 split)
    var sp: f64 = 134217729.0;
    var cy: f64 = sp * y0;
    var yh: f64 = cy - (cy - y0);
    var yl: f64 = y0 - yh;
    var cd: f64 = sp * dh;
    var dhh: f64 = cd - (cd - dh);
    var dhl: f64 = dh - dhh;
    var b: f64 = (yl * dhl) - (((a - (yh * dhh)) - (yl * dhh)) - (yh * dhl));
    var s: f64 = nh - a;
    var s1: f64 = s - b;
    var s2: f64 = s1 + nl;
    var s3: f64 = y0 * dl;
    var r: f64 = s2 - s3;
    var d: f64 = r / dh;
    var k100: f64 = 0x39B0000000000000;             # 2^-100
    var eps: f64 = y0 * k100;
    var lo: f64 = d - eps;
    var hi: f64 = d + eps;
    var z1: f64 = y0 + lo;
    var z2: f64 = y0 + hi;
    return (z1, z2);
}

# The sign (−1, 0 or 1) of the exact sum of the n doubles at p (finite, every partial sum far below DBL_MAX; n ≤ 16), by
# Shewchuk's Grow-Expansion with zero elimination ("Adaptive Precision Floating-Point Arithmetic and Fast Robust
# Geometric Predicates", Discrete Comput. Geom. 18 (1997), Theorem 10): each term is added to a nonoverlapping expansion
# kept in increasing magnitude by a chain of TwoSums (Knuth's, inline), which keeps it nonoverlapping and its sum exact;
# zero components are dropped. Each nonzero component then exceeds the sum of all smaller ones in magnitude, so the
# largest one's sign is the sum's, and an empty expansion is the sum 0.
#must_use
fn _bj_k_exp_sign(p, n): i64 {
    var ex: f64[16];
    var m = 0;
    var i = 0;
    while (i < n) {
        var q: f64 = load64(p + 8 * i);
        var j = 0;
        var w = 0;
        while (j < m) {
            var ej: f64 = load64(&ex + 8 * j);
            var s: f64 = q + ej;
            var bb: f64 = s - q;
            var er: f64 = (q - (s - bb)) + (ej - bb);
            if (er != 0.0) {
                store64(&ex + 8 * w, er);
                w = w + 1;
            }
            q = s;
            j = j + 1;
        }
        if (q != 0.0) {
            store64(&ex + 8 * w, q);
            w = w + 1;
        }
        m = w;
        i = i + 1;
    }
    if (m == 0) { return 0; }
    var top: f64 = load64(&ex + 8 * (m - 1));
    if (top > 0.0) { return 1; }
    return 0 - 1;
}

# For the n doubles at p: (g + 2·f, c, e) with g the xor of their sign bits, f = 1 if one is ±0 or 2 if one is not
# finite (else 0), c the count of significands other than 1, stored at out as f64 words in [1, 2), and e the sum of
# their exponents. A subnormal is first scaled by 2⁵⁴ (exactly).
#must_use
fn _bj_k_mono_sig(p, n, out): (i64, i64, i64) {
    var sg = 0;
    var flag = 0;
    var c = 0;
    var e = 0;
    var i = 0;
    while (i < n) {
        var b = load64(p + 8 * i);
        sg = sg ^ (b >> 63);
        var a = b & 0x7FFFFFFFFFFFFFFF;
        var be = a >> 52;
        if (be == 0x7FF) {
            flag = 2;
        } elif (a == 0) {
            if (flag == 0) { flag = 1; }
        } else {
            if (be == 0) {
                var xs: f64 = a;
                var p54: f64 = 0x4350000000000000;  # 2^54
                var ys: f64 = xs * p54;
                a = _bj_k_bits(ys);
                be = (a >> 52) - 54;
            }
            e = e + be - 1023;
            var m = a & 0x000FFFFFFFFFFFFF;
            if (m != 0) {
                store64(out + 8 * c, m | 0x3FF0000000000000);
                c = c + 1;
            }
        }
        i = i + 1;
    }
    return (sg + 2 * flag, c, e);
}

# The product of the c significands at s (in [1, 2) each) as a normalised double-double: 1, the one factor, an exact
# TwoProduct, then _bj_k_dd_mul_d per further factor.
#must_use
fn _bj_k_mono_prod(s, c): (f64, f64) {
    if (c == 0) { return (1.0, 0.0); }
    var h: f64 = load64(s);
    var l: f64 = 0.0;
    if (c == 1) { return (h, l); }
    var s1: f64 = load64(s + 8);
    var ph, pl = _bj_k_two_prod(h, s1);
    h = ph;
    l = pl;
    var i = 2;
    while (i < c) {
        var si: f64 = load64(s + 8 * i);
        var qh, ql = _bj_k_dd_mul_d(h, l, si);
        h = qh;
        l = ql;
        i = i + 1;
    }
    return (h, l);
}

# RN(F) for F = N/D (the cn significands at sn, the cd at sd; cn ≤ 3, cd ≤ 2) where the rounding test left the adjacent
# doubles z₁ < z₂ with their midpoint μ the one boundary between (the section comment): the sign of N − D·μ, an exact
# sum of doubles — N exactly (1, s₀, p_h + p_l, or the TwoProducts p_h·s₂ and p_l·s₂: s₀s₁ = p_h + p_l, every product of
# numbers in [2⁻¹⁰⁴, 8) with an error far above the subnormal range), and −D·μ = −Σ (dⱼ·z₁ + dⱼ·(u/2)) with
# D = d₀ (+ d₁) exactly, dⱼ·z₁ TwoProducts and dⱼ·(u/2) exact (u = z₂ − z₁ is exact by Sterbenz, a power of two at least
# 2⁻⁵⁸) — by _bj_k_exp_sign. D > 0, so F > μ gives z₂, F < μ gives z₁, and F = μ the even one.
#must_use
fn _bj_k_mono_tie(sn, cn, sd, cd, z1: f64, z2: f64): f64 {
    var tb: f64[10];
    var nt = 1;
    if (cn == 0) {
        var one: f64 = 1.0;
        store64(&tb, one);
    } elif (cn == 1) {
        store64(&tb, load64(sn));
    } else {
        var s0: f64 = load64(sn);
        var s1: f64 = load64(sn + 8);
        var ph, pl = _bj_k_two_prod(s0, s1);
        if (cn == 2) {
            store64(&tb, ph);
            store64(&tb + 8, pl);
            nt = 2;
        } else {
            var s2: f64 = load64(sn + 16);
            var a, b = _bj_k_two_prod(ph, s2);
            var c, d = _bj_k_two_prod(pl, s2);
            store64(&tb, a);
            store64(&tb + 8, b);
            store64(&tb + 16, c);
            store64(&tb + 24, d);
            nt = 4;
        }
    }
    var d0: f64 = 1.0;
    var d1: f64 = 0.0;
    if (cd >= 1) { d0 = load64(sd); }
    if (cd == 2) {
        var t1: f64 = load64(sd + 8);
        var qh, ql = _bj_k_two_prod(d0, t1);
        d0 = qh;
        d1 = ql;
    }
    var u: f64 = z2 - z1;
    var hu: f64 = u * 0.5;
    var a0, b0 = _bj_k_two_prod(d0, z1);
    var h0: f64 = d0 * hu;
    var na0: f64 = -a0;
    var nb0: f64 = -b0;
    var nh0: f64 = -h0;
    store64(&tb + 8 * nt, na0);
    store64(&tb + 8 * nt + 8, nb0);
    store64(&tb + 8 * nt + 16, nh0);
    nt = nt + 3;
    if (d1 != 0.0) {
        var a1, b1 = _bj_k_two_prod(d1, z1);
        var h1: f64 = d1 * hu;
        var na1: f64 = -a1;
        var nb1: f64 = -b1;
        var nh1: f64 = -h1;
        store64(&tb + 8 * nt, na1);
        store64(&tb + 8 * nt + 8, nb1);
        store64(&tb + 8 * nt + 16, nh1);
        nt = nt + 3;
    }
    var sg = _bj_k_exp_sign(&tb, nt);
    if (sg > 0) { return z2; }
    if (sg < 0) { return z1; }
    if ((_bj_k_bits(z1) & 1) == 0) { return z1; }
    return z2;
}

# RN(Π num / Π den) by the fast path (the section comment), for the nn doubles at num and the nd at den: (RN, 1), or
# (0, 0) when the result may be subnormal or the rounding test fails beyond _bj_k_mono_tie's shapes. NaN (with 1)
# outside the domain: more than _BJ_K_MONO_NMAX or _BJ_K_MONO_DMAX factors, a non-finite factor, a zero denominator
# factor.
#must_use
fn _bj_k_cr_mono_fast(num, nn, den, nd): (f64, i64) {
    if (nn < 0 || nd < 0 || nn > _BJ_K_MONO_NMAX || nd > _BJ_K_MONO_DMAX) {
        var nan0: f64 = _bj_k_nan();
        return (nan0, 1);
    }
    var sn: f64[6];
    var sd: f64[4];
    var gfn, cn, en = _bj_k_mono_sig(num, nn, &sn);
    var gfd, cd, ed = _bj_k_mono_sig(den, nd, &sd);
    if ((gfn >> 1) == 2 || (gfd >> 1) != 0) {
        var nan1: f64 = _bj_k_nan();
        return (nan1, 1);
    }
    var neg = (gfn ^ gfd) & 1;
    if ((gfn >> 1) == 1) {
        var z: f64 = 0.0;
        if (neg == 1) { z = -z; }
        return (z, 1);
    }
    var nh, nl = _bj_k_mono_prod(&sn, cn);
    var dh, dl = _bj_k_mono_prod(&sd, cd);
    var z1, z2 = _bj_k_dd_div_ends(nh, nl, dh, dl);
    var y: f64 = z1;
    if (z1 != z2) {
        if (cn > 3 || cd > 2) { return (0.0, 0); }
        y = _bj_k_mono_tie(&sn, cn, &sd, cd, z1, z2);
    }
    var k = en - ed;
    var yb = _bj_k_bits(y);
    var kk = k + (yb >> 52) - 1023;                # K = k + e_y
    if (kk > 1023) {
        var inf: f64 = _BJ_K_INF;
        if (neg == 1) { inf = -inf; }
        return (inf, 1);
    }
    if (kk < 0 - 1075) {
        var zu: f64 = 0.0;
        if (neg == 1) { zu = -zu; }
        return (zu, 1);
    }
    if (kk < 0 - 1021) { return (0.0, 0); }
    var rb = yb + (k << 52);                        # the exponent field + k, in 2 … 2046
    if (neg == 1) { rb = rb | 0x8000000000000000; }
    var r: f64 = rb;
    return (r, 1);
}

# RN(Π num / Π den) by the exact path alone (the section comment), for every argument of the domain; NaN outside it (as
# _bj_k_cr_mono_fast, and past the 253-bit capacity).
#must_use
fn _bj_k_cr_mono_acc(num, nn, den, nd): f64 {
    var nan: f64 = _bj_k_nan();
    if (nn < 0 || nd < 0 || nn > _BJ_K_MONO_NMAX || nd > _BJ_K_MONO_DMAX) { return nan; }
    var pb[64];
    var qb[64];
    var tb[64];
    var rb[64];
    var neg = 0;
    var zero = 0;
    var ee = 0;
    var side = 0;
    while (side < 2) {
        var p = num;
        var n = nn;
        var acc = &pb;
        if (side == 1) {
            p = den;
            n = nd;
            acc = &qb;
        }
        _bj_k_bn_set(acc, 1);
        var bits = 0;
        var i = 0;
        while (i < n) {
            var b = load64(p + 8 * i);
            neg = neg ^ (b >> 63);
            var a = b & 0x7FFFFFFFFFFFFFFF;
            if ((a >> 52) == 0x7FF) { return nan; }
            if (a == 0) {
                if (side == 1) { return nan; }
                zero = 1;
            } else {
                var mm, e = _bj_k_f64_int(a);
                while ((mm & 1) == 0) {
                    mm = mm >> 1;
                    e = e + 1;
                }
                var t = mm;
                while (t != 0) {
                    t = t >> 1;
                    bits = bits + 1;
                }
                if (side == 0) { ee = ee + e; } else { ee = ee - e; }
                _bj_k_bn_set(&tb, mm);
                _bj_k_bn_mul(&rb, acc, &tb);
                _bj_k_bn_copy(acc, &rb);
            }
            i = i + 1;
        }
        if (bits > 253) { return nan; }
        side = side + 1;
    }
    var r: f64 = 0.0;
    if (zero == 0) { r = _bj_k_cr_ratio(&pb, &qb, ee); }
    if (neg == 1) { r = -r; }
    return r;
}

# RN(Π num / Π den), correctly rounded (the section comment): the fast path, then the exact path where it declines.
#must_use
fn _bj_k_cr_mono(num, nn, den, nd): f64 {
    var r, ok = _bj_k_cr_mono_fast(num, nn, den, nd);
    if (ok == 1) { return r; }
    var a: f64 = _bj_k_cr_mono_acc(num, nn, den, nd);
    return a;
}

# (z₁, z₂) = (RN(h + RN(l − ε)), RN(h + RN(l + ε))), ε = 2⁻¹⁰⁰·h, for a positive normalised double-double h + l within
# 32u² of an exact value N (the section comment): z₁ = z₂ is RN(N).
#must_use
fn _bj_k_dd_round_ends(h: f64, l: f64): (f64, f64) {
    var k100: f64 = 0x39B0000000000000;             # 2^-100
    var eps: f64 = h * k100;
    var lo: f64 = l - eps;
    var hi: f64 = l + eps;
    var z1: f64 = h + lo;
    var z2: f64 = h + hi;
    return (z1, z2);
}

# (±y·2^k, 1) for y = RN(F) positive and normal, when the result's exponent K = k + e_y lies in [−1021, 1023], (±∞, 1)
# past 1023, (0, 0) below −1021 (the section comment).
#must_use
fn _bj_k_mono_fin(y: f64, k, neg): (f64, i64) {
    var yb = load64(&y);
    var kk = k + (yb >> 52) - 1023;
    if (kk > 1023) {
        var inf: f64 = _BJ_K_INF;
        if (neg == 1) { inf = -inf; }
        return (inf, 1);
    }
    if (kk < 0 - 1021) { return (0.0, 0); }
    var rb = yb + (k << 52);
    if (neg == 1) { rb = rb | 0x8000000000000000; }
    var r: f64 = rb;
    return (r, 1);
}

# RN(x·y/z) by its fast path: (RN, 1), or (0, 0) to fall back. M4f-2's _bj_k_mul_div_fast (stoichiometry.cyr), now for
# both signs. N = sₓ·s_y = p_h + p_l exactly (TwoProduct), D = s_z exact, so _bj_k_dd_div_cr's steps (inline, d_l = 0)
# have exact operands and its test proves RN(F) when z₁ = z₂ (F in (½, 4)); otherwise the one boundary between, the
# midpoint of z₁ and z₂, decides exactly (_bj_k_mul_div_tie; midpoints are common here: m·3/2 is one whenever 3m has 54
# bits).
#must_use
fn _bj_k_mul_div_fast(x: f64, y: f64, z: f64): (f64, i64) {
    var bx = load64(&x);
    var by = load64(&y);
    var bz = load64(&z);
    var neg = (bx ^ by ^ bz) >> 63;
    var abs = 0x7FFFFFFFFFFFFFFF;
    var ax = bx & abs;
    var ay = by & abs;
    var az = bz & abs;
    var nmin = 0x0010000000000000;
    var nmax = 0x7FF0000000000000;
    if (ax < nmin || ay < nmin || az < nmin || ax >= nmax || ay >= nmax || az >= nmax) { return (0.0, 0); }
    var k = (ax >> 52) + (ay >> 52) - (az >> 52) - 1023;                # eₓ + e_y − e_z
    var mask = 0x000FFFFFFFFFFFFF;
    var one = 0x3FF0000000000000;
    var sxb = (ax & mask) | one;
    var syb = (ay & mask) | one;
    var szb = (az & mask) | one;
    var sx: f64 = sxb;
    var sy: f64 = syb;
    var sz: f64 = szb;
    var ph, pl = _bj_k_two_prod(sx, sy);
    var y0: f64 = ph / sz;
    var ta, tb = _bj_k_two_prod(y0, sz);
    var s0: f64 = ph - ta;
    var s1: f64 = s0 - tb;
    var rr: f64 = s1 + pl;
    var dq: f64 = rr / sz;
    var k100: f64 = 0x39B0000000000000;     # 2⁻¹⁰⁰
    var eps: f64 = y0 * k100;
    var lo: f64 = dq - eps;
    var hi: f64 = dq + eps;
    var z1: f64 = y0 + lo;
    var z2: f64 = y0 + hi;
    var f: f64 = z1;
    if (z1 != z2) { f = _bj_k_mul_div_tie(ph, pl, sz, z1, z2); }
    var r, ok = _bj_k_mono_fin(f, k, neg);
    return (r, ok);
}

# RN(F) for F = N/D (N = p_h + p_l, D = s_z, as in _bj_k_mul_div_fast) where the rounding test left two adjacent doubles
# z₁ < z₂ and F strictly between points that round to them: the midpoint μ = z₁ + u/2 (u = z₂ − z₁, exact) is the only
# boundary there, so RN(F) is z₁ if F < μ, z₂ if F > μ, and the even one of the two if F = μ. The sign of F − μ is that
# of T = N − D·μ = (p_h − a) + p_l − b − h, with D·z₁ = a + b (TwoProduct) and h = D·(u/2) exact: p_h − a is exact by
# Sterbenz (a and p_h are within 2⁻⁵¹ of N), and each of the four terms is a multiple of 2⁻¹⁰⁷ (p_h, p_l of 2⁻¹⁰⁴; z₁ ≥
# ½ − 2⁻⁵⁴ of 2⁻⁵⁴, so a, b of 2⁻¹⁰⁶; u/2 ≥ 2⁻⁵⁵, so h of 2⁻¹⁰⁷) below 2⁻⁴⁸ in magnitude (|N − D·z₁| ≤ D·u < 2⁻⁴⁹):
# scaled by 2¹⁰⁷ (exact) each is an integer below 2⁵⁹, so T·2¹⁰⁷ is their exact sum in 64-bit integers. (M4f-2's, moved
# with it; _bj_k_mono_tie is its general form.)
#must_use
fn _bj_k_mul_div_tie(ph: f64, pl: f64, sz: f64, z1: f64, z2: f64): f64 {
    var u: f64 = z2 - z1;
    var hu: f64 = u * 0.5;
    var a, b = _bj_k_two_prod(sz, z1);
    var h: f64 = sz * hu;
    var e1: f64 = ph - a;
    var p107: f64 = 0x46A0000000000000;     # 2¹⁰⁷
    var ie: f64 = e1 * p107;
    var il: f64 = pl * p107;
    var ib: f64 = b * p107;
    var ih: f64 = h * p107;
    var t = f64_to(ie) + f64_to(il) - f64_to(ib) - f64_to(ih);
    if (t > 0) { return z2; }
    if (t < 0) { return z1; }
    if ((_bj_k_bits(z1) & 1) == 0) { return z1; }
    return z2;
}

