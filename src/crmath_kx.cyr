# RN(x·y·z) by its fast path: N = sₓs_ys_z by _bj_k_dd_mul_d on the exact TwoProduct sₓs_y (within 3.01u², N in [1, 8)),
# rounded by _bj_k_dd_round_ends; a failed test (a midpoint or near one) falls back.
#must_use
fn _bj_k_mul3_fast(x: f64, y: f64, z: f64): (f64, i64) {
    var bx = load64(&x);
    var by = load64(&y);
    var bz = load64(&z);
    var neg = (bx ^ by ^ bz) >> 63;
    var abs = 0x7FFFFFFFFFFFFFFF;
    var ax = bx & abs;
    var ay = by & abs;
    var az = bz & abs;
    var nmin = 0x0010000000000000;
    var nmax = 0x7FF0000000000000;
    if (ax < nmin || ay < nmin || az < nmin || ax >= nmax || ay >= nmax || az >= nmax) { return (0.0, 0); }
    var k = (ax >> 52) + (ay >> 52) + (az >> 52) - 3069;                # eₓ + e_y + e_z
    var mask = 0x000FFFFFFFFFFFFF;
    var one = 0x3FF0000000000000;
    var sxb = (ax & mask) | one;
    var syb = (ay & mask) | one;
    var szb = (az & mask) | one;
    var sx: f64 = sxb;
    var sy: f64 = syb;
    var sz: f64 = szb;
    var ph, pl = _bj_k_two_prod(sx, sy);
    var h, l = _bj_k_dd_mul_d(ph, pl, sz);
    var z1, z2 = _bj_k_dd_round_ends(h, l);
    if (z1 != z2) { return (0.0, 0); }
    var r, ok = _bj_k_mono_fin(z1, k, neg);
    return (r, ok);
}

