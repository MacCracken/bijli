# circuit.cyr — Ohm's law, series and parallel combinations, capacitance and inductance, the RC and RL transients and
# the series RLC relations (port of rust-old/src/circuit.rs, M2 part 1c).
#
# SI units: ohms, farads, henries, volts, amperes, seconds. Every formula is Rust's in Rust's order: the golden rows
# compare bit for bit (class A), and the transients take bijli's correctly rounded exp and expm1 (class C). A
# series sum is Rust's `Sum`, a left fold from −0.0. Rust's `&[f64]` is a pointer and a count. Two of Rust's faults are
# fixed: bj_resistance_from_geometry and bj_parallel_plate_capacitance refuse a NaN area or separation, which Rust's
# `<= 0` let through (ADR 0002 row 26, rows 19 and 23's rule), and the charging transients take 1 − e^(−t/τ) as
# −expm1(−t/τ), with no cancellation (row 29, the user's answer of 2026-11-12). The products, quotients and roots of
# inputs and constants are rounded once (ADR 0002 row 13, M2 part 2b-3): ρL/A, εA/d, the two energies, μn²Al (bijli's
# exact product of five doubles, src/crmath_mono.cyr), the resonances, Q and ζ; a constant enters as its double (2π as
# Rust's π doubled), and a non-finite operand keeps Rust's chain. The combinations, the transients and the impedance
# (sums inside) are Rust's. A fallible function
# returns a value-form Result, the error in the last-error record (src/error.cyr). The impedance here is a magnitude,
# so no time convention (src/complex.cyr) is involved.

private

# ── Ohm's law ────────────────────────────────────────────────────────────────────────────────────────────────────

# V = IR. Mirrors `circuit::voltage`.
#must_use
#pure
public fn bj_voltage(current: f64, resistance: f64): f64 {
    var v: f64 = current * resistance;
    return v;
}

# I = V/R. DivisionByZero when |R| < 1e-30. Mirrors `circuit::current`.
public fn bj_current(voltage: f64, resistance: f64): Result {
    var a: f64 = f64_abs(resistance);
    if (a < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("resistance cannot be zero for Ohm's law"));
    }
    var i: f64 = voltage / resistance;
    return Ok(i);
}

# R = V/I. DivisionByZero when |I| < 1e-30. Mirrors `circuit::resistance`.
public fn bj_resistance(voltage: f64, current: f64): Result {
    var a: f64 = f64_abs(current);
    if (a < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("current cannot be zero for resistance calculation"));
    }
    var r: f64 = voltage / current;
    return Ok(r);
}

# P = IV (W). Mirrors `circuit::power`.
#must_use
#pure
public fn bj_power(current: f64, voltage: f64): f64 {
    var p: f64 = current * voltage;
    return p;
}

# R = ρL/A, correctly rounded (ADR 0002 row 13; a non-finite ρ, L or A keeps Rust's (ρ·L)/A). InvalidParameter unless
# A > 0, a NaN area too (row 26; Rust's `A <= 0` let it through). Mirrors `circuit::resistance_from_geometry`.
public fn bj_resistance_from_geometry(resistivity: f64, length: f64, cross_section_area: f64): Result {
    if (!(cross_section_area > 0.0)) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "cross-section area must be positive, got ");
        _bj_fmt_f64_display(t, cross_section_area);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (_bj_is_finite(resistivity) == 0 || _bj_is_finite(length) == 0 || _bj_is_finite(cross_section_area) == 0) {
        var rl: f64 = resistivity * length;
        var r: f64 = rl / cross_section_area;
        return Ok(r);
    }
    var cr: f64 = _bj_k_cr_mul_div(resistivity, length, cross_section_area);
    return Ok(cr);
}

# ── series and parallel ──────────────────────────────────────────────────────────────────────────────────────────

# The InvalidParameter of an empty combination: "at least one <what> value is required".
fn _bj_circuit_empty(what): i64 {
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, "at least one ");
    _bj_tx_cstr(t, what);
    _bj_tx_cstr(t, " value is required");
    return BJ_ERR_INVALID_PARAMETER;
}

# x₁ + x₂ + …, Rust's `Sum` (a left fold from −0.0); InvalidParameter for n = 0.
fn _bj_circuit_sum(xs: *f64, n, what): Result {
    if (n <= 0) { return Err(_bj_circuit_empty(what)); }
    var acc: f64 = -0.0;
    for (var i = 0; i < n; i = i + 1) { acc = acc + xs[i]; }
    return Ok(acc);
}

# 1/(1/x₁ + 1/x₂ + …): InvalidParameter for n = 0; DivisionByZero "<what> cannot be zero in <kind> combination" for an
# |xᵢ| < 1e-30, and "sum of inverse <what>s is zero" when |Σ 1/xᵢ| < 1e-30.
fn _bj_circuit_inverse(xs: *f64, n, what, kind): Result {
    if (n <= 0) { return Err(_bj_circuit_empty(what)); }
    var s: f64 = 0.0;
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = xs[i];
        var a: f64 = f64_abs(x);
        if (a < 0.000000000000000000000000000001) {
            var t = _bj_err_reason(BJ_ERR_DIVISION_BY_ZERO);
            _bj_tx_cstr(t, what);
            _bj_tx_cstr(t, " cannot be zero in ");
            _bj_tx_cstr(t, kind);
            _bj_tx_cstr(t, " combination");
            return Err(BJ_ERR_DIVISION_BY_ZERO);
        }
        var inv: f64 = 1.0 / x;
        s = s + inv;
    }
    var sa: f64 = f64_abs(s);
    if (sa < 0.000000000000000000000000000001) {
        var u = _bj_err_reason(BJ_ERR_DIVISION_BY_ZERO);
        _bj_tx_cstr(u, "sum of inverse ");
        _bj_tx_cstr(u, what);
        _bj_tx_cstr(u, "s is zero");
        return Err(BJ_ERR_DIVISION_BY_ZERO);
    }
    var r: f64 = 1.0 / s;
    return Ok(r);
}

# R = R₁ + R₂ + … over the n values at resistances. InvalidParameter for n = 0. Mirrors `circuit::resistance_series`.
public fn bj_resistance_series(resistances: *f64, n): Result {
    var t, v = _bj_circuit_sum(resistances, n, "resistance");
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# 1/R = 1/R₁ + 1/R₂ + …. InvalidParameter for n = 0; DivisionByZero for an |Rᵢ| < 1e-30 or an |Σ 1/Rᵢ| < 1e-30.
# Mirrors `circuit::resistance_parallel`.
public fn bj_resistance_parallel(resistances: *f64, n): Result {
    var t, v = _bj_circuit_inverse(resistances, n, "resistance", "parallel");
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# 1/C = 1/C₁ + 1/C₂ + …. As bj_resistance_parallel. Mirrors `circuit::capacitance_series`.
public fn bj_capacitance_series(capacitances: *f64, n): Result {
    var t, v = _bj_circuit_inverse(capacitances, n, "capacitance", "series");
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# C = C₁ + C₂ + …. InvalidParameter for n = 0. Mirrors `circuit::capacitance_parallel`.
public fn bj_capacitance_parallel(capacitances: *f64, n): Result {
    var t, v = _bj_circuit_sum(capacitances, n, "capacitance");
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# L = L₁ + L₂ + …. InvalidParameter for n = 0. Mirrors `circuit::inductance_series`.
public fn bj_inductance_series(inductances: *f64, n): Result {
    var t, v = _bj_circuit_sum(inductances, n, "inductance");
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# 1/L = 1/L₁ + 1/L₂ + …. As bj_resistance_parallel. Mirrors `circuit::inductance_parallel`.
public fn bj_inductance_parallel(inductances: *f64, n): Result {
    var t, v = _bj_circuit_inverse(inductances, n, "inductance", "parallel");
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# ── capacitance and inductance ───────────────────────────────────────────────────────────────────────────────────

# C = εA/d, correctly rounded (ADR 0002 row 13; a non-finite ε, A or d keeps Rust's (ε·A)/d). InvalidParameter unless
# d > 0, a NaN separation too (row 26; Rust's `d <= 0` let it through). Mirrors `circuit::parallel_plate_capacitance`.
public fn bj_parallel_plate_capacitance(permittivity: f64, area: f64, separation: f64): Result {
    if (!(separation > 0.0)) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "plate separation must be positive, got ");
        _bj_fmt_f64_display(t, separation);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (_bj_is_finite(permittivity) == 0 || _bj_is_finite(area) == 0 || _bj_is_finite(separation) == 0) {
        var ea: f64 = permittivity * area;
        var c: f64 = ea / separation;
        return Ok(c);
    }
    var cr: f64 = _bj_k_cr_mul_div(permittivity, area, separation);
    return Ok(cr);
}

# U = CV²/2 (J), correctly rounded (ADR 0002 row 13; a non-finite C or V keeps Rust's 0.5·C·V·V). Mirrors
# `circuit::capacitor_energy`.
#must_use
#pure
public fn bj_capacitor_energy(capacitance: f64, voltage: f64): f64 {
    if (_bj_is_finite(capacitance) == 0 || _bj_is_finite(voltage) == 0) {
        var u: f64 = 0.5 * capacitance * voltage * voltage;
        return u;
    }
    var cr: f64 = _bj_k_cr_mul4(0.5, capacitance, voltage, voltage);
    return cr;
}

# Q = CV (C). Mirrors `circuit::capacitor_charge`.
#must_use
#pure
public fn bj_capacitor_charge(capacitance: f64, voltage: f64): f64 {
    var q: f64 = capacitance * voltage;
    return q;
}

# L = μn²Al (H): n turns per unit length, A the cross-section, l the length; correctly rounded (ADR 0002 row 13: five
# full-precision doubles, bijli's _bj_cr_mul5; a non-finite operand keeps Rust's μ·n·n·A·l). Mirrors
# `circuit::solenoid_inductance`.
#must_use
#pure
public fn bj_solenoid_inductance(permeability: f64, turns_per_length: f64, area: f64, length: f64): f64 {
    if (_bj_is_finite(permeability) == 0 || _bj_is_finite(turns_per_length) == 0 || _bj_is_finite(area) == 0
      || _bj_is_finite(length) == 0) {
        var l: f64 = permeability * turns_per_length * turns_per_length * area * length;
        return l;
    }
    var cr: f64 = _bj_cr_mul5(permeability, turns_per_length, turns_per_length, area, length);
    return cr;
}

# U = LI²/2 (J), correctly rounded (ADR 0002 row 13; a non-finite L or I keeps Rust's 0.5·L·I·I). Mirrors
# `circuit::inductor_energy`.
#must_use
#pure
public fn bj_inductor_energy(inductance: f64, current: f64): f64 {
    if (_bj_is_finite(inductance) == 0 || _bj_is_finite(current) == 0) {
        var u: f64 = 0.5 * inductance * current * current;
        return u;
    }
    var cr: f64 = _bj_k_cr_mul4(0.5, inductance, current, current);
    return cr;
}

# ── RC and RL transients ─────────────────────────────────────────────────────────────────────────────────────────

# 1 when the exact |R·C| < 10^-30 (an instant transient), else 0: the rounded τ = RC decides outside 64 ulps of the
# double nearest 10^-30, the exact product inside (src/crmath_cmp.cyr; ADR 0002 row 17's rule, M2 part 2c-1). A NaN τ
# is not instant, as Rust's test.
#must_use
fn _bj_circuit_instant_rc(r: f64, c: f64, tau: f64): i64 {
    var a: f64 = f64_abs(tau);
    var band = _bj_x_band(a, _BJ_FIELD_R2_MIN);
    if (band == 2) { band = _bj_x_prod_below(r, c, 30); }
    return band;
}

# 1 when the exact |L/R| < 10^-30, else 0, as _bj_circuit_instant_rc (R nonzero: the callers refuse |R| < 1e-30).
#must_use
fn _bj_circuit_instant_rl(l: f64, r: f64, tau: f64): i64 {
    var a: f64 = f64_abs(tau);
    var band = _bj_x_band(a, _BJ_FIELD_R2_MIN);
    if (band == 2) { band = _bj_x_quot_below(l, r, 30); }
    return band;
}

# τ = RC (s). Mirrors `circuit::rc_time_constant`.
#must_use
#pure
public fn bj_rc_time_constant(resistance: f64, capacitance: f64): f64 {
    var tau: f64 = resistance * capacitance;
    return tau;
}

# V(t) = V₀(1 − e^(−t/RC)); V₀ when the exact |RC| < 10^-30 (an instant charge; ADR 0002 row 17's rule, M2 part 2c-1:
# Rust tested the rounded product). 1 − e^(−t/RC) is −expm1(−t/RC), correctly rounded (row 29: Rust's subtraction
# cancelled for t ≪ RC, and gave 0 below t/RC ≈ 1.1e-16). Mirrors `circuit::rc_charging_voltage`.
#must_use
#pure
public fn bj_rc_charging_voltage(v0: f64, resistance: f64, capacitance: f64, t: f64): f64 {
    var tau: f64 = resistance * capacitance;
    var a: f64 = f64_abs(tau);                     # far from 1e-30 the rounded τ decides at once
    if (a < 0.0000000000000000000000000000005) { return v0; }
    if (a <= 0.000000000000000000000000000002 && _bj_circuit_instant_rc(resistance, capacitance, tau) == 1) {
        return v0;
    }
    var x: f64 = -t / tau;
    var em1: f64 = _bj_expm1(x);
    var w: f64 = -em1;
    var v: f64 = v0 * w;
    return v;
}

# V(t) = V₀e^(−t/RC); 0 when the exact |RC| < 10^-30 (an instant discharge; row 17's rule). Mirrors
# `circuit::rc_discharging_voltage`.
#must_use
#pure
public fn bj_rc_discharging_voltage(v0: f64, resistance: f64, capacitance: f64, t: f64): f64 {
    var tau: f64 = resistance * capacitance;
    var a: f64 = f64_abs(tau);
    if (a < 0.0000000000000000000000000000005) { return 0.0; }
    if (a <= 0.000000000000000000000000000002 && _bj_circuit_instant_rc(resistance, capacitance, tau) == 1) {
        return 0.0;
    }
    var x: f64 = -t / tau;
    var e: f64 = _bj_exp(x);
    var v: f64 = v0 * e;
    return v;
}

# τ = L/R (s). DivisionByZero when |R| < 1e-30. Mirrors `circuit::rl_time_constant`.
public fn bj_rl_time_constant(inductance: f64, resistance: f64): Result {
    var a: f64 = f64_abs(resistance);
    if (a < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("resistance cannot be zero for RL time constant"));
    }
    var tau: f64 = inductance / resistance;
    return Ok(tau);
}

# I(t) = (V/R)(1 − e^(−tR/L)); V/R when the exact |L/R| < 10^-30 (an instant rise; row 17's rule), 1 − e^(−tR/L) as
# −expm1(−tR/L) (ADR 0002 row 29). DivisionByZero when |R| < 1e-30. Mirrors `circuit::rl_current_rise`.
public fn bj_rl_current_rise(voltage: f64, resistance: f64, inductance: f64, t: f64): Result {
    var a: f64 = f64_abs(resistance);
    if (a < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("resistance cannot be zero for RL current"));
    }
    var tau: f64 = inductance / resistance;
    var i_max: f64 = voltage / resistance;
    var at: f64 = f64_abs(tau);                    # far from 1e-30 the rounded τ decides at once
    if (at < 0.0000000000000000000000000000005) { return Ok(i_max); }
    if (at <= 0.000000000000000000000000000002 && _bj_circuit_instant_rl(inductance, resistance, tau) == 1) {
        return Ok(i_max);
    }
    var x: f64 = -t / tau;
    var em1: f64 = _bj_expm1(x);
    var w: f64 = -em1;
    var i: f64 = i_max * w;
    return Ok(i);
}

# I(t) = I₀e^(−tR/L); 0 when the exact |L/R| < 10^-30 (row 17's rule). DivisionByZero when |R| < 1e-30. Mirrors
# `circuit::rl_current_decay`.
public fn bj_rl_current_decay(i0: f64, resistance: f64, inductance: f64, t: f64): Result {
    var a: f64 = f64_abs(resistance);
    if (a < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("resistance cannot be zero for RL decay"));
    }
    var tau: f64 = inductance / resistance;
    var at: f64 = f64_abs(tau);
    if (at < 0.0000000000000000000000000000005) { return Ok(0.0); }
    if (at <= 0.000000000000000000000000000002 && _bj_circuit_instant_rl(inductance, resistance, tau) == 1) {
        return Ok(0.0);
    }
    var x: f64 = -t / tau;
    var e: f64 = _bj_exp(x);
    var i: f64 = i0 * e;
    return Ok(i);
}

# ── series RLC ───────────────────────────────────────────────────────────────────────────────────────────────────

# 0, or the InvalidParameter "L and C must be finite and positive, got L=…, C=…".
fn _bj_circuit_check_lc(inductance: f64, capacitance: f64): i64 {
    var l: f64 = inductance;
    var c: f64 = capacitance;
    if (_bj_is_finite(l) == 1 && l > 0.0 && _bj_is_finite(c) == 1 && c > 0.0) { return 0; }
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, "L and C must be finite and positive, got L=");
    _bj_fmt_f64_display(t, l);
    _bj_tx_cstr(t, ", C=");
    _bj_fmt_f64_display(t, c);
    return BJ_ERR_INVALID_PARAMETER;
}

# 0, or the InvalidParameter "resistance must be finite and non-negative, got …".
fn _bj_circuit_check_r(resistance: f64): i64 {
    var r: f64 = resistance;
    if (_bj_is_finite(r) == 1 && r >= 0.0) { return 0; }
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, "resistance must be finite and non-negative, got ");
    _bj_fmt_f64_display(t, r);
    return BJ_ERR_INVALID_PARAMETER;
}

# f₀ = 1/(2π√(LC)) (Hz), correctly rounded (ADR 0002 row 13: √(1/((2π)²LC)), 2π Rust's π doubled). InvalidParameter
# unless L and C are finite and positive. Mirrors `circuit::resonant_frequency`.
public fn bj_resonant_frequency(inductance: f64, capacitance: f64): Result {
    var c = _bj_circuit_check_lc(inductance, capacitance);
    if (c != 0) { return Err(c); }
    var den: f64[4];
    den[0] = 2.0 * _BJ_PI;
    den[1] = 2.0 * _BJ_PI;
    den[2] = inductance;
    den[3] = capacitance;
    var f: f64 = _bj_cr_sqrt_mono(0, 0, &den, 4);
    return Ok(f);
}

# ω₀ = 1/√(LC) (rad/s), correctly rounded (ADR 0002 row 13). As bj_resonant_frequency. Mirrors
# `circuit::resonant_angular_frequency`.
public fn bj_resonant_angular_frequency(inductance: f64, capacitance: f64): Result {
    var c = _bj_circuit_check_lc(inductance, capacitance);
    if (c != 0) { return Err(c); }
    var den: f64[2];
    den[0] = inductance;
    den[1] = capacitance;
    var w: f64 = _bj_cr_sqrt_mono(0, 0, &den, 2);
    return Ok(w);
}

# Q = (1/R)√(L/C) = ω₀L/R, a series RLC's quality factor (a parallel tank's R√(C/L) is not this): Q = 1/(2ζ),
# correctly rounded (ADR 0002 row 13: √(L/(C·R²))).
# InvalidParameter unless R is finite and non-negative; DivisionByZero for R < 1e-30; then InvalidParameter unless L
# and C are finite and positive. Mirrors `circuit::quality_factor`.
public fn bj_quality_factor(resistance: f64, inductance: f64, capacitance: f64): Result {
    var cr = _bj_circuit_check_r(resistance);
    if (cr != 0) { return Err(cr); }
    if (resistance < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("resistance cannot be zero for quality factor"));
    }
    var c = _bj_circuit_check_lc(inductance, capacitance);
    if (c != 0) { return Err(c); }
    var num: f64[1];
    var den: f64[3];
    num[0] = inductance;
    den[0] = capacitance;
    den[1] = resistance;
    den[2] = resistance;
    var q: f64 = _bj_cr_sqrt_mono(&num, 1, &den, 3);
    return Ok(q);
}

# ζ = (R/2)√(C/L), a series RLC's damping ratio: underdamped below 1, critical at 1, overdamped above; ζ = 1/(2Q).
# Correctly rounded for R > 0 (ADR 0002 row 13: kimiya's RN(R·√((C/L)·2^-2))); a zero R keeps Rust's chain (±0).
# InvalidParameter unless R is finite and non-negative, then unless L and C are finite and positive. Mirrors
# `circuit::damping_ratio`.
public fn bj_damping_ratio(resistance: f64, inductance: f64, capacitance: f64): Result {
    var cr = _bj_circuit_check_r(resistance);
    if (cr != 0) { return Err(cr); }
    var c = _bj_circuit_check_lc(inductance, capacitance);
    if (c != 0) { return Err(c); }
    if (resistance == 0.0) {
        var q0: f64 = capacitance / inductance;
        var s: f64 = f64_sqrt(q0);
        var half_r: f64 = resistance * 0.5;
        var z: f64 = half_r * s;
        return Ok(z);
    }
    var zr: f64 = _bj_k_cr_mul_sqrt_ratio(resistance, capacitance, inductance, 0 - 2);
    return Ok(zr);
}

# |Z| = √(R² + (ωL − 1/(ωC))²) (Ω), a series RLC's impedance magnitude at ω. DivisionByZero when |ω| < 1e-30, then
# when |C| < 1e-30. Mirrors `circuit::rlc_impedance`.
public fn bj_rlc_impedance(resistance: f64, inductance: f64, capacitance: f64, angular_freq: f64): Result {
    var w: f64 = angular_freq;
    var aw: f64 = f64_abs(w);
    if (aw < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("angular frequency cannot be zero for impedance"));
    }
    var ac: f64 = f64_abs(capacitance);
    if (ac < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("capacitance cannot be zero for impedance"));
    }
    var wl: f64 = w * inductance;
    var wc: f64 = w * capacitance;
    var inv: f64 = 1.0 / wc;
    var x: f64 = wl - inv;
    var s: f64 = resistance * resistance + x * x;
    var z: f64 = f64_sqrt(s);
    return Ok(z);
}
