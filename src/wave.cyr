# wave.cyr — electromagnetic waves: the Poynting vector and the plane-wave relations, Snell's law and the Fresnel
# coefficients (the angle forms and the trig-free family: *_direct, unpolarized, Schlick), the material-based interface,
# rectangular and circular waveguides, and the dipole antennas (port of rust-old/src/wave.rs, M2 part 1b).
#
# SI units. A plane wave here is the real E(x, t) = E₀ sin(kx − ωt + φ), so no complex phasor and no time convention
# (src/complex.cyr) is involved. Every formula is Rust's in Rust's order: the golden rows compare bit for bit (class A),
# and the functions that call sin, cos, asin or atan take bijli's correctly rounded ones (src/crmath.cyr, class C
# against tests/golden/wave.cr.tsv). The Poynting vector and the momentum density are BjFieldVector's cross, so their
# range edges follow ADR 0002 row 18 (src/field.cyr). Four of Rust's inconsistencies are fixed (ADR 0002, the user's
# answers of 2026-11-12): the dipoles use bijli's η₀ = √(μ₀/ε₀) and the exact Cin(2π), not 120π's textbook figures
# (row 22, the constants in src/wave_data.cyr); bj_effective_aperture refuses a NaN wavelength (row 23);
# bj_schlick_reflectance takes R₀ without reflectance_normal's |n₁ + n₂| < 1e-30 guard (row 24); and
# bj_material_reflection_coefficient's Γ is on the relative impedances, so Γ² is bj_reflectance_normal_materials' R
# (row 25). And bj_half_wave_dipole_pattern's numerator is computed with no cancellation near the axis (row 28, M2's
# range-edge Part). The products and quotients of inputs and constants are rounded once (ADR 0002 row 13, M2 part 2b-2,
# src/crmath_kx.cyr's monomials): the plane-wave intensity, the reflected radiation pressure, the wave number, the
# circular cutoff, the Hertzian resistance, the effective aperture and Friis's ratio; a constant enters as its double
# (2π and 4π as Rust's π times an exact power of two), and a non-finite operand keeps Rust's chain. The thresholds
# are exact (ADR 0002 row 17): reflectance_normal's |n₁ + n₂| against 10^-30 (M2 part 2c-1), and the trig-free
# family's total internal reflection, with its cos θ_t correctly rounded (2c-3, src/crmath_edge.cyr).
#
# A fallible function returns a value-form Result, the error in the last-error record (src/error.cyr). Rust's
# `Result<Option<f64>>` is `Ok(Some)` with the value in *out, or `Ok(None)` under total internal reflection (out
# untouched, as on an error). The trig-free family takes n₁ (the incident side) and n₂ positive and finite, and cos θ_i
# in [0, 1] against the incident-side normal, clamping a rounding excursion of up to 1e-6; it never flips sides.

private

# ── plane waves ──────────────────────────────────────────────────────────────────────────────────────────────────

# One part of S = (E × B)/μ₀ (mode 0) or of g = S/c² (mode 1), from the cross component ci = a·b − c·d as
# BjFieldVector's cross gives it (src/crmath_vx.cyr's band, its unbounded fallback rounded once). Rust's ci·k (then ·k2)
# where ci is normal (it is then the chain's 53-bit value) and, for g, S finite; an exact 0 (zero factors, or two
# normal products) and a non-finite operand keep it, and so does S past DBL_MAX (k > 1: the cross is past it too).
# Otherwise (ci below 2^-1022 or 0 by underflow, or g's S or cross past DBL_MAX where g is representable) the chain runs
# with an unbounded exponent from the products, its last product rounded once (ADR 0002 row 18's rule, M2 part 2d-2b).
#must_use
fn _bj_wave_flux_part(a: f64, b: f64, c: f64, d: f64, ci: f64, k: f64, k2: f64, mode): f64 {
    var s: f64 = ci * k;
    var r: f64 = s;
    if (mode == 1) { r = s * k2; }
    var ac: f64 = f64_abs(ci);
    var asv: f64 = f64_abs(s);
    if (ac >= _BJ_VX_MN && ac <= _BJ_VX_HI && (mode == 0 || asv <= _BJ_VX_HI)) { return r; }
    if (_bj_vx_finite4(a, b, c, d) == 0) { return r; }
    if (mode == 0 && ac > _BJ_VX_HI) { return r; }
    if (ci == 0.0) {
        var pp: f64 = a * b;
        var qq: f64 = c * d;
        if (_bj_vx_exact(a, b, pp) == 1 && _bj_vx_exact(c, d, qq) == 1) { return r; }
    }
    var cs, ce = _bj_vx_cross1(a, b, c, d);
    var ks, ke = _bj_k_ux_from(k);
    if (mode == 0) {
        var u0: f64 = _bj_k_ux_mul_f64(cs, ce, ks, ke);
        return u0;
    }
    var ss, se = _bj_k_ux_mul(cs, ce, ks, ke);
    var ts, te = _bj_k_ux_from(k2);
    var u1: f64 = _bj_k_ux_mul_f64(ss, se, ts, te);
    return u1;
}

# 1 when every part of the cross c = E × B is normal or an exact 0 through zero factors (and, mode 1, its product by k
# finite): the common case, where every part's _bj_wave_flux_part is Rust's ci·k (·k2).
#must_use
fn _bj_wave_cross_plain(e: BjFieldVector, b: BjFieldVector, c: BjFieldVector, k: f64, mode): i64 {
    var lo: f64 = _BJ_VX_MN;
    var hi: f64 = _BJ_VX_HI;
    var cx: f64 = c.x;
    var cy: f64 = c.y;
    var cz: f64 = c.z;
    var ax: f64 = f64_abs(cx);
    var ay: f64 = f64_abs(cy);
    var az: f64 = f64_abs(cz);
    var ox = 0;
    var oy = 0;
    var oz = 0;
    if (ax >= lo && ax <= hi) { ox = 1; }
    if (ay >= lo && ay <= hi) { oy = 1; }
    if (az >= lo && az <= hi) { oz = 1; }
    if (ox == 0 && cx == 0.0 && (e.y == 0.0 || b.z == 0.0) && (e.z == 0.0 || b.y == 0.0)) { ox = 1; }
    if (oy == 0 && cy == 0.0 && (e.z == 0.0 || b.x == 0.0) && (e.x == 0.0 || b.z == 0.0)) { oy = 1; }
    if (oz == 0 && cz == 0.0 && (e.x == 0.0 || b.y == 0.0) && (e.y == 0.0 || b.x == 0.0)) { oz = 1; }
    if (ox == 0 || oy == 0 || oz == 0) { return 0; }
    if (mode == 1) {
        var m: f64 = ax;
        if (ay > m) { m = ay; }
        if (az > m) { m = az; }
        var sm: f64 = m * k;
        if (sm > hi) { return 0; }
    }
    return 1;
}

# S = E × B/μ₀ (W/m²), the energy flux: BjFieldVector's cross (ADR 0002 row 18 at a range edge), then each part by
# 1/μ₀, with an unbounded exponent where a part of the cross falls below 2^-1022 (_bj_wave_flux_part). Mirrors
# `wave::poynting_vector`.
#must_use
public fn bj_poynting_vector(e: BjFieldVector, b: BjFieldVector): BjFieldVector {
    var c: BjFieldVector = e.cross(b);
    var k: f64 = 1.0 / BJ_MU_0;
    if (_bj_wave_cross_plain(e, b, c, 0.0, 0) == 1) {
        var s0: BjFieldVector = c.scale(k);
        return s0;
    }
    var sx: f64 = _bj_wave_flux_part(e.y, b.z, e.z, b.y, c.x, k, 0.0, 0);
    var sy: f64 = _bj_wave_flux_part(e.z, b.x, e.x, b.z, c.y, k, 0.0, 0);
    var sz: f64 = _bj_wave_flux_part(e.x, b.y, e.y, b.x, c.z, k, 0.0, 0);
    var s: BjFieldVector = BjFieldVector_new(sx, sy, sz);
    return s;
}

# I = c·ε₀·E₀²/2 (W/m²), a plane wave's time-averaged intensity, correctly rounded (ADR 0002 row 13; a non-finite E₀
# keeps Rust's 0.5·c·ε₀·E₀·E₀). Mirrors `wave::plane_wave_intensity`.
#must_use
#pure
public fn bj_plane_wave_intensity(e_amplitude: f64): f64 {
    if (_bj_is_finite(e_amplitude) == 0) {
        var i: f64 = 0.5 * BJ_SPEED_OF_LIGHT * BJ_EPSILON_0 * e_amplitude * e_amplitude;
        return i;
    }
    var cr: f64 = _bj_k_cr_mul5(0.5, BJ_SPEED_OF_LIGHT, BJ_EPSILON_0, e_amplitude, e_amplitude);
    return cr;
}

# P = I/c (Pa), the radiation pressure on a perfect absorber. Mirrors `wave::radiation_pressure_absorbed`.
#must_use
#pure
public fn bj_radiation_pressure_absorbed(intensity: f64): f64 {
    var p: f64 = intensity / BJ_SPEED_OF_LIGHT;
    return p;
}

# P = 2I/c (Pa), on a perfect reflector, correctly rounded (ADR 0002 row 13): for |I| ≤ DBL_MAX/2 Rust's 2I is exact,
# so 2I/c rounds once; above it Rust's 2I overflows, and RN(I/c)·2 is RN(2I/c) exactly (I/c is normal, the doubling
# exact). Mirrors `wave::radiation_pressure_reflected`.
#must_use
#pure
public fn bj_radiation_pressure_reflected(intensity: f64): f64 {
    var half_max: f64 = _bj_from_bits(0x7FDFFFFFFFFFFFFF);    # DBL_MAX/2
    var a: f64 = f64_abs(intensity);
    if (a > half_max) {
        var q: f64 = intensity / BJ_SPEED_OF_LIGHT;
        var p2: f64 = q * 2.0;
        return p2;
    }
    var two_i: f64 = 2.0 * intensity;
    var p: f64 = two_i / BJ_SPEED_OF_LIGHT;
    return p;
}

# E₀ = c·B₀. Mirrors `wave::e_from_b`.
#must_use
#pure
public fn bj_e_from_b(b_amplitude: f64): f64 {
    var e: f64 = BJ_SPEED_OF_LIGHT * b_amplitude;
    return e;
}

# B₀ = E₀/c. Mirrors `wave::b_from_e`.
#must_use
#pure
public fn bj_b_from_e(e_amplitude: f64): f64 {
    var b: f64 = e_amplitude / BJ_SPEED_OF_LIGHT;
    return b;
}

# E(x, t) = E₀ sin(kx − ωt + φ), a plane wave along +x. Rust's chain, or at a range edge (a product below 2^-1022 or 0
# by underflow, a sum past DBL_MAX) the unbounded one: kx, ωt and the sums to 53 bits, the sine of that argument to 53
# bits (past DBL_MAX by Payne–Hanek, src/crmath_ux.cyr), the product by E₀ rounded once (ADR 0002 row 18's rule, M2
# part 2d-2b: Rust's sin(±∞) was NaN for an argument whose sine exists). A non-finite operand keeps Rust's chain.
# Mirrors `wave::plane_wave_e`.
#must_use
#pure
public fn bj_plane_wave_e(e_amplitude: f64, k: f64, x: f64, omega: f64, t: f64, phase: f64): f64 {
    var kx: f64 = k * x;
    var wt: f64 = omega * t;
    var d: f64 = kx - wt;
    var arg: f64 = d + phase;
    var ak: f64 = f64_abs(kx);
    var aw: f64 = f64_abs(wt);
    var ad: f64 = f64_abs(d);
    var aa: f64 = f64_abs(arg);
    var plain = 0;
    if (ak > _BJ_VX_MN && aw > _BJ_VX_MN && ad <= _BJ_VX_HI && aa <= _BJ_VX_HI) { plain = 1; }
    if (plain == 0) {
        var fin: f64 = (phase - phase) + (e_amplitude - e_amplitude);
        if (_bj_vx_finite4(k, x, omega, t) == 0 || fin != 0.0) { plain = 1; }
    }
    if (plain == 0) {
        if (_bj_vx_exact(k, x, kx) == 1 && _bj_vx_exact(omega, t, wt) == 1 && ad <= _BJ_VX_HI && aa <= _BJ_VX_HI) {
            plain = 1;
        }
    }
    if (plain == 1) {
        var s: f64 = _bj_sin(arg);
        var e: f64 = e_amplitude * s;
        return e;
    }
    var ps, pe = _bj_vx_mul(k, x);
    var qs, qe = _bj_vx_mul(omega, t);
    var ds, de = _bj_k_ux_sub(ps, pe, qs, qe);
    var fs, fe = _bj_k_ux_from(phase);
    var as2, ae2 = _bj_k_ux_add(ds, de, fs, fe);
    var ss, se = _bj_vx_sin53(as2, ae2);
    var es, ee = _bj_k_ux_from(e_amplitude);
    var u: f64 = _bj_k_ux_mul_f64(es, ee, ss, se);
    return u;
}

# k = 2πf/v, correctly rounded (ADR 0002 row 13; a non-finite f or v keeps Rust's (2π·f)/v). DivisionByZero when
# |v| < 1e-30 (a NaN v passes, as Rust's test). Mirrors `wave::wave_number`.
public fn bj_wave_number(frequency: f64, velocity: f64): Result {
    var a: f64 = f64_abs(velocity);
    if (a < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("velocity cannot be zero for wave number"));
    }
    var two_pi: f64 = 2.0 * _BJ_PI;
    if (_bj_is_finite(frequency) == 0 || _bj_is_finite(velocity) == 0) {
        var w: f64 = two_pi * frequency;
        var k: f64 = w / velocity;
        return Ok(k);
    }
    var cr: f64 = _bj_k_cr_mul_div(two_pi, frequency, velocity);
    return Ok(cr);
}

# ω = 2πf. Mirrors `wave::angular_frequency`.
#must_use
#pure
public fn bj_angular_frequency(frequency: f64): f64 {
    var w: f64 = 2.0 * _BJ_PI * frequency;
    return w;
}

# g = S/c² (kg/(m²·s)), the momentum density: S as bj_poynting_vector's, then each part by 1/c²; with an unbounded
# exponent where S or the cross passes DBL_MAX while g = (E × B)ε₀ is representable, or a part of the cross falls below
# 2^-1022 (_bj_wave_flux_part). Mirrors `wave::momentum_density`.
#must_use
public fn bj_momentum_density(e: BjFieldVector, b: BjFieldVector): BjFieldVector {
    var c: BjFieldVector = e.cross(b);
    var k: f64 = 1.0 / BJ_MU_0;
    var c2: f64 = BJ_SPEED_OF_LIGHT * BJ_SPEED_OF_LIGHT;
    var k2: f64 = 1.0 / c2;
    if (_bj_wave_cross_plain(e, b, c, k, 1) == 1) {
        var sv: BjFieldVector = c.scale(k);
        var g0: BjFieldVector = sv.scale(k2);
        return g0;
    }
    var gx: f64 = _bj_wave_flux_part(e.y, b.z, e.z, b.y, c.x, k, k2, 1);
    var gy: f64 = _bj_wave_flux_part(e.z, b.x, e.x, b.z, c.y, k, k2, 1);
    var gz: f64 = _bj_wave_flux_part(e.x, b.y, e.y, b.x, c.z, k, k2, 1);
    var g: BjFieldVector = BjFieldVector_new(gx, gy, gz);
    return g;
}

# ── refraction and reflection, the angle forms ───────────────────────────────────────────────────────────────────
# These take any index (a negative one refracts negatively) and any angle; only a zero divisor is refused.

# θ_t = asin(n₁ sin θ_i/n₂), Snell's law: Ok(Some) with θ_t in *out, or Ok(None) when |n₁ sin θ_i/n₂| > 1 (total
# internal reflection). DivisionByZero when |n₂| < 1e-30. An n₁ sin θ_i below 2^-1022 (or 0 by underflow) runs with an
# unbounded exponent, the quotient rounded once (ADR 0002 row 18's rule, M2 part 2d-2b). Mirrors
# `wave::snell_refraction_angle`.
public fn bj_snell_refraction_angle(n1: f64, n2: f64, theta_i: f64, out: *f64): Result {
    var a: f64 = f64_abs(n2);
    if (a < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("refractive index n₂ cannot be zero"));
    }
    var s: f64 = _bj_sin(theta_i);
    var p: f64 = n1 * s;
    var sin_t: f64 = p / n2;
    var ap: f64 = f64_abs(p);
    if (!(ap > _BJ_VX_MN) && _bj_vx_finite4(n1, s, n2, 0.0) == 1 && _bj_vx_exact(n1, s, p) == 0) {
        var ps, pe = _bj_vx_mul(n1, s);             # n₁ sin θ_i below 2^-1022: unbounded, the quotient rounded once
        var ns, ne = _bj_k_ux_from(n2);
        sin_t = _bj_k_ux_div_f64(ps, pe, ns, ne);
    }
    var m: f64 = f64_abs(sin_t);
    if (m > 1.0) { return Ok(None); }
    var t: f64 = _bj_asin(sin_t);
    out[0] = t;
    return Ok(Some);
}

# θ_c = asin(n₂/n₁): Ok(Some) with θ_c in *out, or Ok(None) when n₂/n₁ ≥ 1 (no total internal reflection).
# DivisionByZero when |n₁| < 1e-30. Mirrors `wave::critical_angle`.
public fn bj_critical_angle(n1: f64, n2: f64, out: *f64): Result {
    var a: f64 = f64_abs(n1);
    if (a < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("refractive index n₁ cannot be zero"));
    }
    var ratio: f64 = n2 / n1;
    if (ratio >= 1.0) { return Ok(None); }
    var t: f64 = _bj_asin(ratio);
    out[0] = t;
    return Ok(Some);
}

# θ_B = atan(n₂/n₁), where the reflection is purely s-polarized. DivisionByZero when |n₁| < 1e-30. Mirrors
# `wave::brewster_angle`.
public fn bj_brewster_angle(n1: f64, n2: f64): Result {
    var a: f64 = f64_abs(n1);
    if (a < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("refractive index n₁ cannot be zero"));
    }
    var ratio: f64 = n2 / n1;
    var t: f64 = _bj_atan(ratio);
    return Ok(t);
}

# (a·x − b·y)/(a·x + b·y), the Fresnel ratios' and reflectance_normal's chain: Rust's, or at a range edge (a sum past
# DBL_MAX, a product below 2^-1022 or 0 from nonzero factors) the unbounded one, each step to 53 bits and the quotient
# rounded once (src/crmath_vx.cyr; ADR 0002 row 18's rule, M2 part 2d-2a: the ratio is scale-free, so Rust's 1/3 of
# DBL_MAX and DBL_MAX/2 came out 0). DivisionByZero "Fresnel denominator is zero" when the chain's denominator has a
# magnitude below 1e-30 (strict = 1, the angle forms) or is 0 (strict = 0, the trig-free family).
fn _bj_wave_ratio_of(a: f64, x: f64, b: f64, y: f64, strict): Result {
    var p: f64 = a * x;
    var q: f64 = b * y;
    var num: f64 = p - q;
    var den: f64 = p + q;
    var pa: f64 = f64_abs(p);                       # the common case, inline: both products normal and both sums
    var qa: f64 = f64_abs(q);                       # finite (an ∞ product fails the sums' test, a NaN every test)
    var na: f64 = f64_abs(num);
    var da: f64 = f64_abs(den);
    var plain = 0;
    if (pa > _BJ_VX_MN && qa > _BJ_VX_MN && na <= _BJ_VX_HI && da <= _BJ_VX_HI) { plain = 1; }
    if (plain == 0) { plain = _bj_vx_ratio_plain(a, x, b, y, p, q, num, den); }
    if (plain == 0) {
        var st: i64[1];
        var ru: f64 = _bj_vx_ratio_ux(a, x, b, y, &st);
        if (st[0] == 1 || (strict == 1 && st[0] == 2)) {
            return Err(_bj_err_division_by_zero("Fresnel denominator is zero"));
        }
        return Ok(ru);
    }
    if (strict == 1) {
        var m: f64 = f64_abs(den);
        if (m < 0.000000000000000000000000000001) {
            return Err(_bj_err_division_by_zero("Fresnel denominator is zero"));
        }
        var r: f64 = num / den;
        return Ok(r);
    }
    var tr, vr = _bj_wave_ratio(num, den);
    if (is_err_result(tr) == 1) { return Err(vr); }
    return Ok(vr);
}

# (a cos θ_i − b cos θ_t)/(a cos θ_i + b cos θ_t): r_s with (a, b) = (n₁, n₂), r_p with (n₂, n₁). DivisionByZero when
# the denominator's magnitude is below 1e-30; a range edge as _bj_wave_ratio_of.
fn _bj_wave_fresnel_angles(a: f64, theta_i: f64, b: f64, theta_t: f64): Result {
    var ci: f64 = _bj_cos(theta_i);
    var ct: f64 = _bj_cos(theta_t);
    var t, v = _bj_wave_ratio_of(a, ci, b, ct, 1);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# r_s = (n₁ cos θ_i − n₂ cos θ_t)/(n₁ cos θ_i + n₂ cos θ_t), TE. DivisionByZero when the denominator's magnitude is
# below 1e-30. Mirrors `wave::fresnel_rs`.
public fn bj_fresnel_rs(n1: f64, theta_i: f64, n2: f64, theta_t: f64): Result {
    var t, v = _bj_wave_fresnel_angles(n1, theta_i, n2, theta_t);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# r_p = (n₂ cos θ_i − n₁ cos θ_t)/(n₂ cos θ_i + n₁ cos θ_t), TM. As bj_fresnel_rs. Mirrors `wave::fresnel_rp`.
public fn bj_fresnel_rp(n1: f64, theta_i: f64, n2: f64, theta_t: f64): Result {
    var t, v = _bj_wave_fresnel_angles(n2, theta_i, n1, theta_t);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# R_s = r_s². As bj_fresnel_rs. Mirrors `wave::reflectance_s`.
public fn bj_reflectance_s(n1: f64, theta_i: f64, n2: f64, theta_t: f64): Result {
    var t, v = _bj_wave_fresnel_angles(n1, theta_i, n2, theta_t);
    if (is_err_result(t) == 1) { return Err(v); }
    var r: f64 = v;
    var rr: f64 = r * r;
    return Ok(rr);
}

# R_p = r_p². As bj_fresnel_rp. Mirrors `wave::reflectance_p`.
public fn bj_reflectance_p(n1: f64, theta_i: f64, n2: f64, theta_t: f64): Result {
    var t, v = _bj_wave_fresnel_angles(n2, theta_i, n1, theta_t);
    if (is_err_result(t) == 1) { return Err(v); }
    var r: f64 = v;
    var rr: f64 = r * r;
    return Ok(rr);
}

# R = ((n₁ − n₂)/(n₁ + n₂))² at normal incidence. DivisionByZero when the exact |n₁ + n₂| < 10^-30 (ADR 0002 row
# 17's rule, M2 part 2c-1: the rounded sum decides outside 64 ulps of the double nearest 10^-30, src/crmath_cmp.cyr's
# exact sum inside; a NaN sum passes, as Rust's test). The ratio as _bj_wave_ratio_of (a sum past DBL_MAX). Mirrors
# `wave::reflectance_normal`.
public fn bj_reflectance_normal(n1: f64, n2: f64): Result {
    var den: f64 = n1 + n2;
    var m: f64 = f64_abs(den);
    var band = _bj_x_band(m, _BJ_FIELD_R2_MIN);
    if (band == 2) { band = _bj_x_sum_below(n1, n2, 30); }
    if (band == 1) {
        return Err(_bj_err_division_by_zero("sum of refractive indices cannot be zero"));
    }
    var tq, vq = _bj_wave_ratio_of(n1, 1.0, n2, 1.0, 0);
    var r: f64 = vq;
    var rr: f64 = r * r;
    return Ok(rr);
}

# T = 1 − R at normal incidence; bj_reflectance_normal's error. Mirrors `wave::transmittance_normal`.
public fn bj_transmittance_normal(n1: f64, n2: f64): Result {
    var t, v = bj_reflectance_normal(n1, n2);
    if (is_err_result(t) == 1) { return Err(v); }
    var r: f64 = v;
    var tt: f64 = 1.0 - r;
    return Ok(tt);
}

# ── the trig-free Fresnel family ─────────────────────────────────────────────────────────────────────────────────

# Validated (cos θ_i, cos θ_t) into cs[0], cs[1]: Ok(Some), or Ok(None) under total internal reflection (cs[0] only).
# DivisionByZero for n₂ = 0; InvalidParameter unless both indices are positive and finite, then unless cos θ_i is in
# [0, 1] (a value within 1e-6 outside it is clamped). cos θ_t = √(1 − (n₁/n₂)²(1 − cos²θ_i)), None when the sine²
# passes 1: the test exact (n₁²(1 − cos²θ_i) > n₂²) and cos θ_t = √(n₂² − n₁²(1 − cos²θ_i))/n₂ correctly rounded (ADR
# 0002 row 17, M2 part 2c-3, src/crmath_edge.cyr). Mirrors wave.rs's `check_indices`, `check_cos_theta_i` and
# `fresnel_cosines`.
fn _bj_wave_cosines(n1: f64, n2: f64, cos_theta_i: f64, cs: *f64): Result {
    if (n2 == 0.0) { return Err(_bj_err_division_by_zero("refractive index n₂ cannot be zero")); }
    if (!(_bj_is_finite(n1) == 1 && n1 > 0.0 && _bj_is_finite(n2) == 1 && n2 > 0.0)) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "refractive indices must be positive and finite, got n₁=");
        _bj_fmt_f64_display(t, n1);
        _bj_tx_cstr(t, ", n₂=");
        _bj_fmt_f64_display(t, n2);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var ci: f64 = cos_theta_i;
    var hi: f64 = 1.0 + 0.000001;
    if (!(ci >= 0.0 && ci <= 1.0)) {
        if (ci >= -0.000001 && ci <= hi) {
            if (ci < 0.0) { ci = 0.0; } else { ci = 1.0; }
        } else {
            var u = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(u, "cos θ_i must lie in [0, 1] (measured against the incident-side normal), got ");
            _bj_fmt_f64_display(u, cos_theta_i);
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
    }
    cs[0] = ci;
    var co: f64[1];
    if (_bj_cr_cos_t(n1, n2, ci, 0, &co) == 1) { return Ok(None); }
    var ct: f64 = co[0];
    cs[1] = ct;
    return Ok(Some);
}

# num/den for a Fresnel ratio whose denominator is a sum of non-negative terms: DivisionByZero when it is 0.
fn _bj_wave_ratio(num: f64, den: f64): Result {
    if (den == 0.0) { return Err(_bj_err_division_by_zero("Fresnel denominator is zero")); }
    var r: f64 = num / den;
    return Ok(r);
}

# 0.5·(r_s² + r_p²), r_s = (a cos θ_i − b cos θ_t)/(a cos θ_i + b cos θ_t) and r_p the same with a and b swapped: the
# index form passes (n₁, n₂), the material form (η₂, η₁). Each ratio as _bj_wave_ratio_of; r_s² + r_p² never nears the
# underflow (r_s vanishes only for n₁ = n₂, a shortcut, so |r_s| ≳ 2^-53 for distinct doubles).
fn _bj_wave_unpolarized(a: f64, b: f64, ci: f64, ct: f64): Result {
    var t1, v1 = _bj_wave_ratio_of(a, ci, b, ct, 0);
    if (is_err_result(t1) == 1) { return Err(v1); }
    var t2, v2 = _bj_wave_ratio_of(b, ci, a, ct, 0);
    if (is_err_result(t2) == 1) { return Err(v2); }
    var rs: f64 = v1;
    var rp: f64 = v2;
    var s: f64 = rs * rs + rp * rp;
    var r: f64 = 0.5 * s;
    return Ok(r);
}

# r for (a, b): None (TIR), 0 when n₁ = n₂ (also at grazing incidence, where the formula is 0/0), else the ratio.
fn _bj_wave_direct(n1: f64, n2: f64, cos_theta_i: f64, swap, out: *f64): Result {
    var cs: f64[2];
    var t, v = _bj_wave_cosines(n1, n2, cos_theta_i, &cs);
    if (is_err_result(t) == 1) { return Err(v); }
    if (v == None) { return Ok(None); }
    if (n1 == n2) {
        out[0] = 0.0;
        return Ok(Some);
    }
    var a: f64 = n1;
    var b: f64 = n2;
    if (swap == 1) {
        a = n2;
        b = n1;
    }
    var ci: f64 = cs[0];
    var ct: f64 = cs[1];
    var tr, vr = _bj_wave_ratio_of(a, ci, b, ct, 0);
    if (is_err_result(tr) == 1) { return Err(vr); }
    out[0] = vr;
    return Ok(Some);
}

# cos θ_t = √(1 − (n₁/n₂)²(1 − cos²θ_i)), no trig: Ok(Some) with it in *out, or Ok(None) under total internal
# reflection. DivisionByZero for n₂ = 0; InvalidParameter for an index that is not positive and finite, or cos θ_i
# outside [0, 1] beyond the 1e-6 clamp. Mirrors `wave::snell_cos_theta_t`.
public fn bj_snell_cos_theta_t(n1: f64, n2: f64, cos_theta_i: f64, out: *f64): Result {
    var cs: f64[2];
    var t, v = _bj_wave_cosines(n1, n2, cos_theta_i, &cs);
    if (is_err_result(t) == 1) { return Err(v); }
    if (v == None) { return Ok(None); }
    out[0] = cs[1];
    return Ok(Some);
}

# r_s from cos θ_i, no trig: Ok(Some) with r_s in *out (exactly 0 for n₁ = n₂, grazing incidence included), or Ok(None)
# under total internal reflection (|r_s| = 1). The errors of bj_snell_cos_theta_t. Mirrors `wave::fresnel_rs_direct`.
public fn bj_fresnel_rs_direct(n1: f64, n2: f64, cos_theta_i: f64, out: *f64): Result {
    var t, v = _bj_wave_direct(n1, n2, cos_theta_i, 0, out);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# r_p from cos θ_i, no trig: as bj_fresnel_rs_direct with n₁ and n₂ swapped in the ratio. Mirrors
# `wave::fresnel_rp_direct`.
public fn bj_fresnel_rp_direct(n1: f64, n2: f64, cos_theta_i: f64, out: *f64): Result {
    var t, v = _bj_wave_direct(n1, n2, cos_theta_i, 1, out);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# R_s = r_s² from cos θ_i, 1 under total internal reflection. Mirrors `wave::reflectance_s_direct`.
public fn bj_reflectance_s_direct(n1: f64, n2: f64, cos_theta_i: f64): Result {
    var r: f64[1];
    var t, v = _bj_wave_direct(n1, n2, cos_theta_i, 0, &r);
    if (is_err_result(t) == 1) { return Err(v); }
    if (v == None) { return Ok(1.0); }
    var x: f64 = r[0];
    var xx: f64 = x * x;
    return Ok(xx);
}

# R_p = r_p² from cos θ_i, 1 under total internal reflection. Mirrors `wave::reflectance_p_direct`.
public fn bj_reflectance_p_direct(n1: f64, n2: f64, cos_theta_i: f64): Result {
    var r: f64[1];
    var t, v = _bj_wave_direct(n1, n2, cos_theta_i, 1, &r);
    if (is_err_result(t) == 1) { return Err(v); }
    if (v == None) { return Ok(1.0); }
    var x: f64 = r[0];
    var xx: f64 = x * x;
    return Ok(xx);
}

# R = (R_s + R_p)/2 from cos θ_i, in [0, 1]: 1 under total internal reflection, 0 for n₁ = n₂; cos θ_t is computed
# once for both polarizations. The errors of bj_snell_cos_theta_t. Mirrors `wave::reflectance_unpolarized`.
public fn bj_reflectance_unpolarized(n1: f64, n2: f64, cos_theta_i: f64): Result {
    var cs: f64[2];
    var t, v = _bj_wave_cosines(n1, n2, cos_theta_i, &cs);
    if (is_err_result(t) == 1) { return Err(v); }
    if (v == None) { return Ok(1.0); }
    if (n1 == n2) { return Ok(0.0); }
    var tu, vu = _bj_wave_unpolarized(n1, n2, cs[0], cs[1]);
    if (is_err_result(tu) == 1) { return Err(vu); }
    return Ok(vu);
}

# T = 1 − R from cos θ_i, in [0, 1]; bj_reflectance_unpolarized's errors. Mirrors `wave::transmittance_unpolarized`.
public fn bj_transmittance_unpolarized(n1: f64, n2: f64, cos_theta_i: f64): Result {
    var t, v = bj_reflectance_unpolarized(n1, n2, cos_theta_i);
    if (is_err_result(t) == 1) { return Err(v); }
    var r: f64 = v;
    var tt: f64 = 1.0 - r;
    return Ok(tt);
}

# Schlick's R ≈ R₀ + (1 − R₀)(1 − cos θ)⁵, R₀ = ((n₁ − n₂)/(n₁ + n₂))², with θ on the optically thinner side: θ_i for
# n₁ ≤ n₂, θ_t for n₁ > n₂, and exactly 1 under total internal reflection (de Greve 2006). The errors of
# bj_snell_cos_theta_t; R₀ needs no guard of its own, since the indices are positive and finite (ADR 0002 row 24: Rust
# refused indices summing below 1e-30 through reflectance_normal), and its ratio is _bj_wave_ratio_of's (a sum past
# DBL_MAX). Mirrors `wave::schlick_reflectance`.
public fn bj_schlick_reflectance(n1: f64, n2: f64, cos_theta_i: f64): Result {
    var cs: f64[2];
    var t, v = _bj_wave_cosines(n1, n2, cos_theta_i, &cs);
    if (is_err_result(t) == 1) { return Err(v); }
    var c: f64 = cs[0];
    if (n1 > n2) {
        if (v == None) { return Ok(1.0); }
        c = cs[1];
    }
    var tq, vq = _bj_wave_ratio_of(n1, 1.0, n2, 1.0, 0);
    var r: f64 = vq;
    var r0: f64 = r * r;
    var omc: f64 = 1.0 - c;
    var omc2: f64 = omc * omc;
    var omc5: f64 = omc2 * omc2 * omc;
    var w: f64 = 1.0 - r0;
    var rs: f64 = r0 + w * omc5;
    return Ok(rs);
}

# ── the material-based interface ─────────────────────────────────────────────────────────────────────────────────

# R = (r_s² + r_p²)/2 between two lossless materials from cos θ_i, valid for magnetic media: Snell's law on
# n = √(ε_r μ_r), the amplitudes on the relative impedance η = √(μ_r/ε_r), r_s = (η₂ cos θ_i − η₁ cos θ_t)/(η₂ cos θ_i +
# η₁ cos θ_t) and r_p with η₁, η₂ swapped; 1 under total internal reflection, and Γ² = ((η₂ − η₁)/(η₂ + η₁))² for
# n₁ = n₂. The errors of _bj_material_lossless_optical_constants (mat1's first), then of bj_snell_cos_theta_t. A
# subnormal n, or an η past DBL_MAX or subnormal, runs on the roots to 53 bits with an unbounded exponent (row 18's
# rule, M2 part 2d-2c). Mirrors `wave::reflectance_at_interface`.
public fn bj_reflectance_at_interface(mat1: BjMaterial, mat2: BjMaterial, cos_theta_i: f64): Result {
    var o1: f64[2];
    var o2: f64[2];
    var t1, v1 = _bj_material_lossless_optical_constants(mat1, &o1);
    if (is_err_result(t1) == 1) { return Err(v1); }
    var t2, v2 = _bj_material_lossless_optical_constants(mat2, &o2);
    if (is_err_result(t2) == 1) { return Err(v2); }
    var n1: f64 = o1[0];
    var eta1: f64 = o1[1];
    var n2: f64 = o2[0];
    var eta2: f64 = o2[1];
    var lo: f64 = _BJ_VX_MN;
    var hi: f64 = _BJ_VX_HI;
    var same = 0;
    if (n1 == n2) { same = 1; }
    if (!(n1 > lo && n2 > lo)) {
        # An index at or below 2^-1022 (coarse, or a subnormal root rounded up): the TIR test and cos θ_t depend only on
        # n₁/n₂, so they run on the 53-bit indices scaled together into the normal range, the smaller clamped at
        # 2^-200 below the larger (past a ratio of 2^27 both decide alike: TIR below grazing, or cos θ_t = 1).
        var a1s, a1e = _bj_vx_sqrt_ux(mat1.eps_r, mat1.mu_r, 1);
        var a2s, a2e = _bj_vx_sqrt_ux(mat2.eps_r, mat2.mu_r, 1);
        var top = a1e;
        if (a2e > top) { top = a2e; }
        var d1 = a1e - top;
        var d2 = a2e - top;
        if (d1 < 0 - 200) { d1 = 0 - 200; }
        if (d2 < 0 - 200) { d2 = 0 - 200; }
        var s1: f64 = a1s;
        var s2: f64 = a2s;
        var p1: f64 = _bj_k_cr_pow2(d1);
        var p2: f64 = _bj_k_cr_pow2(d2);
        n1 = s1 * p1;
        n2 = s2 * p2;
        same = 0;
        if (s1 == s2 && a1e == a2e) { same = 1; }
    }
    var cs: f64[2];
    var t, v = _bj_wave_cosines(n1, n2, cos_theta_i, &cs);
    if (is_err_result(t) == 1) { return Err(v); }
    if (v == None) { return Ok(1.0); }
    if (same == 1) {
        var g: f64 = _bj_vx_gamma(eta1, eta2, mat1.eps_r, mat1.mu_r, mat2.eps_r, mat2.mu_r);
        var gg: f64 = g * g;
        return Ok(gg);
    }
    if (eta1 > lo && eta1 <= hi && eta2 > lo && eta2 <= hi) {
        var tu, vu = _bj_wave_unpolarized(eta2, eta1, cs[0], cs[1]);
        if (is_err_result(tu) == 1) { return Err(vu); }
        return Ok(vu);
    }
    # An η past DBL_MAX or at or below 2^-1022: the ratios on η's rounded to 53 bits with an unbounded exponent.
    var b1s, b1e = _bj_vx_sqrt_ux(mat1.mu_r, mat1.eps_r, 0);
    var b2s, b2e = _bj_vx_sqrt_ux(mat2.mu_r, mat2.eps_r, 0);
    var ci: f64 = cs[0];
    var ct: f64 = cs[1];
    var st: i64[1];
    var rs: f64 = _bj_vx_ratio_ux2(b2s, b2e, ci, b1s, b1e, ct, &st);
    if (st[0] == 1) { return Err(_bj_err_division_by_zero("Fresnel denominator is zero")); }
    var rp: f64 = _bj_vx_ratio_ux2(b1s, b1e, ci, b2s, b2e, ct, &st);
    if (st[0] == 1) { return Err(_bj_err_division_by_zero("Fresnel denominator is zero")); }
    var sq: f64 = rs * rs + rp * rp;
    var r: f64 = 0.5 * sq;
    return Ok(r);
}

# R = ((η₂ − η₁)/(η₂ + η₁))² at normal incidence between two lossless materials: BjMaterial.try_reflectance_at.
# Mirrors `wave::reflectance_normal_materials`.
public fn bj_reflectance_normal_materials(mat1: BjMaterial, mat2: BjMaterial): Result {
    var t, v = mat1.try_reflectance_at(mat2);
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

# Γ = (η₂ − η₁)/(η₂ + η₁), the reflection coefficient between two lossless materials, on the relative impedances
# η = √(μ_r/ε_r) (ADR 0002 row 25: Rust took the absolute √(μ_rμ₀/(ε_rε₀)), whose Γ² missed
# bj_reflectance_normal_materials' R in the last bits). The errors of _bj_material_lossless_optical_constants, mat1's
# first. Rust's |η₁ + η₂| < 1e-30 guard is gone (row 25, amended in M2 part 2d-1, the user's answer of 2026-11-13):
# both η are positive, so their sum never vanishes, and the guard refused only pairs of tiny impedances whose Γ is
# well defined. An η past DBL_MAX or subnormal, or a sum past DBL_MAX, runs with an unbounded exponent
# (src/crmath_vx.cyr's _bj_vx_gamma; row 18's rule, M2 part 2d-2c). Mirrors `wave::material_reflection_coefficient`.
public fn bj_material_reflection_coefficient(mat1: BjMaterial, mat2: BjMaterial): Result {
    var o1: f64[2];
    var o2: f64[2];
    var t1, v1 = _bj_material_lossless_optical_constants(mat1, &o1);
    if (is_err_result(t1) == 1) { return Err(v1); }
    var t2, v2 = _bj_material_lossless_optical_constants(mat2, &o2);
    if (is_err_result(t2) == 1) { return Err(v2); }
    var eta1: f64 = o1[1];
    var eta2: f64 = o2[1];
    var g: f64 = _bj_vx_gamma(eta1, eta2, mat1.eps_r, mat1.mu_r, mat2.eps_r, mat2.mu_r);
    return Ok(g);
}

# ── waveguides ───────────────────────────────────────────────────────────────────────────────────────────────────

# 0, or the InvalidParameter of a rectangular waveguide: the Cyrius-only m or n outside a u32 (Rust's type), then a or
# b not positive and finite, then m = n = 0 (there is no TE₀₀ or TM₀₀ mode).
fn _bj_wave_check_rect(a: f64, b: f64, m, n): i64 {
    if (m < 0 || m > 4294967295 || n < 0 || n > 4294967295) {
        var u = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(u, "m and n must be u32s, got m=");
        _bj_tx_i64(u, m);
        _bj_tx_cstr(u, ", n=");
        _bj_tx_i64(u, n);
        return BJ_ERR_INVALID_PARAMETER;
    }
    if (!(_bj_is_finite(a) == 1 && a > 0.0 && _bj_is_finite(b) == 1 && b > 0.0)) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "waveguide dimensions must be positive and finite, got a=");
        _bj_fmt_f64_display(t, a);
        _bj_tx_cstr(t, ", b=");
        _bj_fmt_f64_display(t, b);
        return BJ_ERR_INVALID_PARAMETER;
    }
    if (m == 0 && n == 0) { return _bj_err_invalid_parameter("both m and n cannot be zero (no TE₀₀/TM₀₀ mode)"); }
    return 0;
}

# 0, or InvalidParameter "<what> must be positive and finite, got <x>".
fn _bj_wave_check_positive(what, x: f64): i64 {
    if (_bj_is_finite(x) == 1 && x > 0.0) { return 0; }
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, what);
    _bj_tx_cstr(t, " must be positive and finite, got ");
    _bj_fmt_f64_display(t, x);
    return BJ_ERR_INVALID_PARAMETER;
}

# √((m/a)² + (n/b)²), and pl[0] = 1 when that is the unbounded chain's (row 18's rule, M2 part 2d-2c): each square
# above 2^-1022 or an exact 0 (m or n = 0) and their sum finite, so every step is its 53-bit value; else 0.
#must_use
fn _bj_wave_rect_root(a: f64, b: f64, m, n, pl: *i64): f64 {
    var mf: f64 = f64_from(m);
    var nf: f64 = f64_from(n);
    var ma: f64 = mf / a;
    var nb: f64 = nf / b;
    var m2: f64 = ma * ma;
    var n2: f64 = nb * nb;
    var s: f64 = m2 + n2;
    var r: f64 = f64_sqrt(s);
    var ok = 1;
    if (s > _BJ_VX_HI) { ok = 0; }
    if (m != 0 && !(m2 > _BJ_VX_MN)) { ok = 0; }
    if (n != 0 && !(n2 > _BJ_VX_MN)) { ok = 0; }
    pl[0] = ok;
    return r;
}

# √((m/a)² + (n/b)²) with an unbounded exponent, each step to 53 bits: (s, e).
#must_use
fn _bj_wave_rect_root_ux(a: f64, b: f64, m, n): (f64, i64) {
    var mf: f64 = f64_from(m);
    var nf: f64 = f64_from(n);
    var ms, me = _bj_k_ux_from(mf);
    var ns, ne = _bj_k_ux_from(nf);
    var as1, ae1 = _bj_k_ux_from(a);
    var bs1, be1 = _bj_k_ux_from(b);
    var qs, qe = _bj_k_ux_div(ms, me, as1, ae1);
    var ps, pe = _bj_k_ux_div(ns, ne, bs1, be1);
    var q2s, q2e = _bj_k_ux_mul(qs, qe, qs, qe);
    var p2s, p2e = _bj_k_ux_mul(ps, pe, ps, pe);
    var ss, se = _bj_k_ux_add(q2s, q2e, p2s, p2e);
    var rs, re = _bj_k_ux_sqrt(ss, se);
    return (rs, re);
}

# f_c = (v/2)√((m/a)² + (n/b)²) (Hz), the cutoff of a rectangular waveguide's TE_mn or TM_mn mode: a, b its sides
# (a ≥ b by convention), v the filling medium's phase velocity (c for air), m and n u32s. The errors of the check
# (m, n, then a, b, then m = n = 0), then InvalidParameter unless v is positive and finite. Where the root's squares
# under- or overflow, or v/2 is subnormal, the chain runs with an unbounded exponent and f_c rounds once (row 18's rule,
# M2 part 2d-2c). Mirrors `wave::rectangular_waveguide_cutoff`.
public fn bj_rectangular_waveguide_cutoff(a: f64, b: f64, m, n, velocity: f64): Result {
    var c = _bj_wave_check_rect(a, b, m, n);
    if (c != 0) { return Err(c); }
    var cv = _bj_wave_check_positive("wave velocity", velocity);
    if (cv != 0) { return Err(cv); }
    var pl: i64[1];
    var r: f64 = _bj_wave_rect_root(a, b, m, n, &pl);
    var hv: f64 = 0.5 * velocity;
    var fc: f64 = hv * r;
    var hm: f64 = _BJ_VX_MN;
    if (pl[0] == 1 && hv > hm) { return Ok(fc); }
    var rs, re = _bj_wave_rect_root_ux(a, b, m, n);
    var vs, ve = _bj_k_ux_from(velocity);
    var u: f64 = _bj_k_ux_mul_f64(vs, ve - 1, rs, re);
    return Ok(u);
}

# λ_c = 2/√((m/a)² + (n/b)²) (m). The check's errors, then InvalidParameter when λ_c is not representable: Rust's root
# 0 or NaN, and at a range edge (squares under- or overflowing) the unbounded chain's λ_c past DBL_MAX; there a
# representable λ_c is computed and rounded once (row 18's rule, M2 part 2d-2c: Rust gave 0 for an ∞ root and refused
# sides of 10^300 m). Mirrors `wave::rectangular_waveguide_cutoff_wavelength`.
public fn bj_rectangular_waveguide_cutoff_wavelength(a: f64, b: f64, m, n): Result {
    var c = _bj_wave_check_rect(a, b, m, n);
    if (c != 0) { return Err(c); }
    var pl: i64[1];
    var r: f64 = _bj_wave_rect_root(a, b, m, n, &pl);
    if (pl[0] == 0) {
        # At a range edge: λ_c = 2/r rounded once from the unbounded root, "not representable" when it passes DBL_MAX.
        var rs, re = _bj_wave_rect_root_ux(a, b, m, n);
        var lu: f64 = _bj_k_ux_div_f64(1.0, 1, rs, re);
        if (lu <= _BJ_VX_HI) { return Ok(lu); }
        r = 0.0;
    }
    if (r != r || r <= 0.0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "cutoff wavelength not representable for a=");
        _bj_fmt_f64_display(t, a);
        _bj_tx_cstr(t, ", b=");
        _bj_fmt_f64_display(t, b);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var lc: f64 = 2.0 / r;
    return Ok(lc);
}

# λ_g = λ/√(1 − (λ/λ_c)²) (m), above cutoff (λ < λ_c); λ_c = +∞ (a TEM line) gives λ. DivisionByZero for λ_c = 0;
# InvalidParameter for a NaN or negative λ_c, then a λ that is not positive and finite, then λ/λ_c ≥ 1 (its text
# gives the ratio to 4 decimals, Rust's `{ratio:.4}`). Mirrors `wave::guide_wavelength`.
public fn bj_guide_wavelength(free_space_wavelength: f64, cutoff_wavelength: f64): Result {
    var lc: f64 = cutoff_wavelength;
    var lam: f64 = free_space_wavelength;
    if (lc == 0.0) { return Err(_bj_err_division_by_zero("cutoff wavelength cannot be zero")); }
    if (lc != lc || lc < 0.0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "cutoff wavelength must be positive, got ");
        _bj_fmt_f64_display(t, lc);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (!(_bj_is_finite(lam) == 1 && lam > 0.0)) {
        var u = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(u, "wavelength must be positive and finite, got ");
        _bj_fmt_f64_display(u, lam);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var ratio: f64 = lam / lc;
    var rr: f64 = ratio * ratio;
    var rad: f64 = 1.0 - rr;
    if (rad != rad || rad <= 0.0) {
        var w = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(w, "frequency below cutoff: λ/λ_c = ");
        _bj_fmt_f64_fixed(w, ratio, 4);
        _bj_tx_cstr(w, " (must be < 1)");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var s: f64 = f64_sqrt(rad);
    var lg: f64 = lam / s;
    return Ok(lg);
}

# f_c = x·v/(2πa) (Hz), the cutoff of a circular waveguide's mode: a its radius, v the filling medium's phase velocity,
# x the mode's root: x′_mn of J′_m for TE_mn (TE₁₁ 1.8412, the dominant mode; TE₂₁ 3.0542; TE₀₁ 3.8317), x_mn of J_m for
# TM_mn (TM₀₁ 2.4048, TM₁₁ 3.8317), correctly rounded (ADR 0002 row 13: Rust's x·v and 2πa over- or underflowed
# where f_c is representable). InvalidParameter unless the radius, then the root, then v is positive and finite.
# Mirrors `wave::cylindrical_waveguide_cutoff`.
public fn bj_cylindrical_waveguide_cutoff(radius: f64, bessel_root: f64, velocity: f64): Result {
    var c = _bj_wave_check_positive("waveguide radius", radius);
    if (c == 0) { c = _bj_wave_check_positive("Bessel root", bessel_root); }
    if (c == 0) { c = _bj_wave_check_positive("wave velocity", velocity); }
    if (c != 0) { return Err(c); }
    var two_pi: f64 = 2.0 * _BJ_PI;
    var fc: f64 = _bj_k_cr_mul2_div2(bessel_root, velocity, two_pi, radius);
    return Ok(fc);
}

# ── antennas ─────────────────────────────────────────────────────────────────────────────────────────────────────

# U(θ) = sin²θ, a Hertzian (short) dipole's normalized pattern (peak 1 at θ = π/2). Mirrors
# `wave::hertzian_dipole_pattern`.
#must_use
#pure
public fn bj_hertzian_dipole_pattern(theta: f64): f64 {
    var s: f64 = _bj_sin(theta);
    var u: f64 = s * s;
    return u;
}

# U(θ) = [cos((π/2) cos θ)/sin θ]², a half-wave dipole's normalized pattern; 0 where |sin θ| < 1e-15 (the axis nulls).
# The numerator is sin(π·sin²(θ/2)), or sin(π·cos²(θ/2)) where cos θ < 0: the same real number with no cancellation
# near either axis, where Rust's cos((π/2)·cos θ) lost every digit below θ ≈ 10^-8 (ADR 0002 row 28; a few ulps
# everywhere). Mirrors `wave::half_wave_dipole_pattern`.
#must_use
#pure
public fn bj_half_wave_dipole_pattern(theta: f64): f64 {
    var sp, cp = _bj_sin_cos(theta);
    var s: f64 = sp;
    var c: f64 = cp;
    var a: f64 = f64_abs(s);
    if (a < 0.000000000000001) { return 0.0; }
    var h: f64 = 0.5 * theta;
    var m: f64 = 0.0;
    if (c >= 0.0) {
        var sh: f64 = _bj_sin(h);
        m = sh * sh;
    } else {
        var ch: f64 = _bj_cos(h);
        m = ch * ch;
    }
    var arg: f64 = _BJ_PI * m;
    var num: f64 = _bj_sin(arg);
    var f: f64 = num / s;
    var u: f64 = f * f;
    return u;
}

# D = 1.5 (1.76 dBi), a Hertzian dipole's directivity. Mirrors `wave::hertzian_dipole_directivity`.
#must_use
#pure
public fn bj_hertzian_dipole_directivity(): f64 {
    return 1.5;
}

# D = 4/Cin(2π) = 1.6409224 (2.15 dBi), a half-wave dipole's directivity, Cin the cosine integral: the double nearest
# the exact value (ADR 0002 row 22; Rust returned 1.6409). Mirrors `wave::half_wave_dipole_directivity`.
#must_use
#pure
public fn bj_half_wave_dipole_directivity(): f64 {
    var d: f64 = _BJ_WAVE_HALF_WAVE_D;
    return d;
}

# R_rad = (2π/3)·η₀·(dl/λ)² (Ω), a Hertzian dipole's radiation resistance, η₀ = √(μ₀/ε₀) (bj_free_space_impedance):
# (2π/3)·η₀ is the double nearest 789.0221 (ADR 0002 row 22; Rust's 80π² = 789.5684 assumed η₀ = 120π), and the
# product with (dl/λ)² is rounded once on that double (row 13; a non-finite dl or λ keeps K·(dl/λ)·(dl/λ)).
# DivisionByZero when |λ| < 1e-30. Mirrors `wave::hertzian_dipole_radiation_resistance`.
public fn bj_hertzian_dipole_radiation_resistance(dipole_length: f64, wavelength: f64): Result {
    var a: f64 = f64_abs(wavelength);
    if (a < 0.000000000000000000000000000001) {
        return Err(_bj_err_division_by_zero("wavelength cannot be zero"));
    }
    if (_bj_is_finite(dipole_length) == 0 || _bj_is_finite(wavelength) == 0) {
        var ratio: f64 = dipole_length / wavelength;
        var r: f64 = _BJ_WAVE_HERTZ_K * ratio * ratio;
        return Ok(r);
    }
    var cr: f64 = _bj_k_cr_mul3_div2(_BJ_WAVE_HERTZ_K, dipole_length, dipole_length, wavelength, wavelength);
    return Ok(cr);
}

# R_rad = η₀·Cin(2π)/(4π) = 73.079 Ω, a half-wave dipole's radiation resistance on bijli's η₀ (bj_free_space_impedance):
# the double nearest the exact value (ADR 0002 row 22; Rust returned 73.1, 120π's 73.13 rounded). Mirrors
# `wave::half_wave_dipole_radiation_resistance`.
#must_use
#pure
public fn bj_half_wave_dipole_radiation_resistance(): f64 {
    var r: f64 = _BJ_WAVE_HALF_WAVE_R;
    return r;
}

# A_e = λ²D/(4π) (m²), an antenna's effective aperture, correctly rounded (ADR 0002 row 13; a non-finite λ or D keeps
# Rust's λ·λ·D/(4π)). InvalidParameter unless λ ≥ 0: a NaN λ too (row 23; Rust's `λ < 0` let it through as NaN).
# Mirrors `wave::effective_aperture`.
public fn bj_effective_aperture(wavelength: f64, directivity: f64): Result {
    if (!(wavelength >= 0.0)) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "wavelength must be non-negative, got ");
        _bj_fmt_f64_display(t, wavelength);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var fp: f64 = 4.0 * _BJ_PI;
    if (_bj_is_finite(wavelength) == 0 || _bj_is_finite(directivity) == 0) {
        var l2d: f64 = wavelength * wavelength * directivity;
        var ae: f64 = l2d / fp;
        return Ok(ae);
    }
    var cr: f64 = _bj_k_cr_mul3_div(wavelength, wavelength, directivity, fp);
    return Ok(cr);
}

# P_r/P_t = G_t·G_r·(λ/(4πd))², Friis's transmission equation (a power ratio), correctly rounded (ADR 0002 row 13; a
# non-finite operand keeps Rust's G_t·G_r·ratio·ratio). Singularity when |d| < 1e-30. Mirrors
# `wave::friis_transmission`.
public fn bj_friis_transmission(gain_tx: f64, gain_rx: f64, wavelength: f64, distance: f64): Result {
    var a: f64 = f64_abs(distance);
    if (a < 0.000000000000000000000000000001) { return Err(_bj_err_singularity()); }
    var fp: f64 = 4.0 * _BJ_PI;
    if (_bj_is_finite(gain_tx) == 0 || _bj_is_finite(gain_rx) == 0 || _bj_is_finite(wavelength) == 0
      || _bj_is_finite(distance) == 0) {
        var d: f64 = fp * distance;
        var ratio: f64 = wavelength / d;
        var p: f64 = gain_tx * gain_rx * ratio * ratio;
        return Ok(p);
    }
    var num: f64[4];
    var den: f64[4];
    num[0] = gain_tx;
    num[1] = gain_rx;
    num[2] = wavelength;
    num[3] = wavelength;
    den[0] = fp;
    den[1] = fp;
    den[2] = distance;
    den[3] = distance;
    var cr: f64 = _bj_k_cr_mono(&num, 4, &den, 4);
    return Ok(cr);
}
