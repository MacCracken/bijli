# fdtd1d.cyr — fdtd.rs's 1D solver (M5 part 1a): `Fdtd1d`, the Yee algorithm for E_z and H_y travelling along x,
# with a first-order Mur absorbing boundary at each end, matched to the medium beside it. SI units.
#
# e_field[i] lives at x = i·dx and h_field[i] at x = (i + ½)·dx; h_field[num_cells − 1] lies outside the E domain and
# is never updated. The time step is half the 1D Courant limit, dt = dx/(2c).
#
# A grid's six arrays (E, H, ε_r, μ_r and the two update coefficients), and a scratch row for the update, are one
# anonymous mmap, fixed at construction and given back by BjFdtd1d_free (port plan §9.5). Rust's public, resizable
# `Vec` fields, and the per-step layout check that guarded them, are gone (ADR 0002 row 2): the fields `e_field` and
# `h_field` are the arrays' addresses and `num_cells` their length, and nothing can resize them. No step allocates.
# The Mur coefficients take a cancellation-free form where Rust's cancelled (`_bj_fd1_mur`, ADR 0002 row 40).
# The updates run on the packed f64v_* verbs, each lane rounding Rust's three operations, so the bits are Rust's
# (port plan §9.3, probe p10), except where a cell's update leaves the normal range: that cell runs it with an unbounded
# exponent (ADR 0002 row 18, src/crmath_edge.cyr's _bj_e_cell_row). The file is time-domain only; bijli's one harmonic
# convention, e^{+jωt}, is stated in src/complex.cyr's header.

private

var _BJ_FD1_INF: f64 = 0x7FF0000000000000;
# std::f64::consts::PI, as src/mathx.cyr's _BJ_PI (private to that file).
var _BJ_FD1_PI: f64 = 3.141592653589793;
# The grid's arrays, each num_cells f64, in one mapping: E, H, ε_r, μ_r, the E coefficients, the H coefficients and
# the update's scratch row.
var _BJ_FD1_ARRAYS = 7;
# The largest num_cells whose mapping (56 bytes a cell) a 64-bit length can hold.
var _BJ_FD1_MAX_CELLS = 164703072086692425;

# Rust's `run(steps, None, ..)`: no source cell. Rust's Some(cell) with cell ≥ num_cells injects nothing either, so
# usize::MAX (−1) is None exactly.
public const BJ_FDTD_NO_SOURCE = -1;

# 1D FDTD simulation state: E_z and H_y along x. `e_field` and `h_field` are the addresses of num_cells f64 (read and
# write them, as Rust's public vectors); `permittivity` and `permeability` hold ε_r per E node and μ_r per H node,
# `e_coeff` dt/(ε₀ε_r dx) and `h_coeff` dt/(μ₀μ_r dx). `dx` (m) and `dt` (s) are the steps, `step` the time-step
# index, `abc_left` and `abc_right` the Mur coefficients (v·dt − dx)/(v·dt + dx) with v the phase velocity beside each
# end. `work` is the update's scratch row (no Rust counterpart) and `map_bytes` the mapping's length (0 once freed).
# Mirrors `Fdtd1d`.
public struct BjFdtd1d {
    e_field;
    h_field;
    permittivity;
    permeability;
    e_coeff;
    h_coeff;
    dx: f64;
    dt: f64;
    step;
    num_cells;
    abc_left: f64;
    abc_right: f64;
    work;
    map_bytes;
}

# A word as a *f64 (the typed return keeps the binding typed).
#must_use
fn _bj_fd1_f64p(a): *f64 {
    return a;
}

# 1 when x is finite and strictly positive (NaN-safe). Mirrors fdtd.rs's `is_positive_finite`.
#must_use
fn _bj_fd1_pos(x: f64): i64 {
    if (x > 0.0 && x < _BJ_FD1_INF) { return 1; }
    return 0;
}

# 2^-1022: the normal range's floor.
var _BJ_FD1_DMIN: f64 = 0x0010000000000000;

# 1 when x is 0, or finite with |x| ≥ 2^-1022.
#must_use
fn _bj_fd1_normal(x: f64): i64 {
    if (x == 0.0) { return 1; }
    var a: f64 = f64_abs(x);
    if (a >= _BJ_FD1_DMIN && a < _BJ_FD1_INF) { return 1; }
    return 0;
}

# 1 when the product z = x·y kept the normal range: z normal, or 0 from a zero factor (not an underflow).
#must_use
fn _bj_fd1_prod_ok(z: f64, x: f64, y: f64): i64 {
    if (_bj_fd1_normal(z) == 0) { return 0; }
    if (z == 0.0 && x != 0.0 && y != 0.0) { return 0; }
    return 1;
}

# x·y to 53 bits with an unbounded exponent, from the doubles x and y.
#must_use
fn _bj_fd1_mul2(x: f64, y: f64): (f64, i64) {
    var xs, xe = _bj_k_ux_from(x);
    var ys, ye = _bj_k_ux_from(y);
    var ps, pe = _bj_k_ux_mul(xs, xe, ys, ye);
    return (ps, pe);
}

# The value s·2^e as a double when it is normal (or zero): (1, it), else (0, 0.0).
#must_use
fn _bj_fd1_exact(s: f64, e): (i64, f64) {
    if (s == 0.0) { return (1, s); }
    if (e < 0 - 1022 || e > 1023) { return (0, 0.0); }
    var x: f64 = _bj_k_ux_round(s, e, 0.0);
    return (1, x);
}

# The cancellation-free form (c²dt² − ε_rμ_r·dx²)/(c·dt + dx·√(ε_rμ_r))² (ADR 0002 row 40, M5 part 2a-1b) on dt and dx
# scaled by the power of two 2^s that brings c·dt into [1, 2) (M5 part 2d-2b: the form is scale-free and the scaling
# exact, so in range the bits are part 2a-1b's, and it now holds at every scale). (cs, ce) is c·dt and (rs, re) is
# √(ε_rμ_r), each to 53 bits with an unbounded exponent. Returns (1, k), or (0, 0.0) where dt·2^s or dx·2^s isn't a
# normal double.
#must_use
fn _bj_fd1_mur_band(dt: f64, dx: f64, eps_r: f64, mu_r: f64, cs: f64, ce, rs: f64, re): (i64, f64) {
    var ts, te = _bj_k_ux_from(dt);
    var xs, xe = _bj_k_ux_from(dx);
    var ok1, dt2 = _bj_fd1_exact(ts, te - ce);
    var ok2, dx2 = _bj_fd1_exact(xs, xe - ce);
    if (ok1 == 0 || ok2 == 0) { return (0, 0.0); }
    var rv: f64[5];
    rv[0] = BJ_SPEED_OF_LIGHT;
    rv[1] = dt2;
    rv[2] = eps_r;
    rv[3] = mu_r;
    rv[4] = dx2;
    var ro: f64[1];
    if (_bj_cr_rat(&rv, 5, _bj_cr_rat_spec(11), 0, &ro) == 0) { return (0, 0.0); }
    var bs, be = _bj_k_ux_mul(xs, xe - ce, rs, re);
    var ok3, b2 = _bj_fd1_exact(bs, be);
    if (ok3 == 0) { return (0, 0.0); }
    var s: f64 = cs + b2;
    var s2: f64 = s * s;
    var n: f64 = ro[0];
    var k: f64 = n / s2;
    return (1, k);
}

# The first-order Mur coefficient (v·dt − dx)/(v·dt + dx), v = c/√(ε_r μ_r): Rust's c·dt/√(ε_r μ_r). For finite,
# positive arguments:
# - where the unbounded v·dt lies in (2dx/3, 2dx), its difference with dx at least doubles v·dt's rounding error,
#   cancelling outright at ε_rμ_r = 1/4 (k = 0, perfect absorption at dt = dx/2c), so there it takes the
#   cancellation-free form (_bj_fd1_mur_band; ADR 0002 row 40, M5 parts 2a-1b and 2d-2b);
# - elsewhere, where ε_rμ_r, its root, c·dt, v·dt, v·dt − dx or v·dt + dx leaves the normal range, the chain runs with
#   an unbounded exponent and the quotient is rounded once (ADR 0002 row 18, M5 part 2d-2b: ε_rμ_r below the range gave
#   v·dt = ∞ and k = NaN where it is near 1);
# - and otherwise, as for any other argument, Rust's chain. Mirrors fdtd.rs's `mur_coefficient`.
#must_use
fn _bj_fd1_mur(dt: f64, dx: f64, eps_r: f64, mu_r: f64): f64 {
    var em: f64 = eps_r * mu_r;
    var root: f64 = f64_sqrt(em);
    var c: f64 = BJ_SPEED_OF_LIGHT;
    var cdt: f64 = c * dt;
    var v_dt: f64 = cdt / root;
    var num: f64 = v_dt - dx;
    var den: f64 = v_dt + dx;
    var k: f64 = num / den;
    var z: f64 = dt * 0.0 + dx * 0.0 + eps_r * 0.0 + mu_r * 0.0;
    if (z != 0.0 || dt <= 0.0 || dx <= 0.0 || eps_r <= 0.0 || mu_r <= 0.0) { return k; }
    var as, ae = _bj_k_ux_from(eps_r);
    var bs, be = _bj_k_ux_from(mu_r);
    var es, ee = _bj_k_ux_mul(as, ae, bs, be);
    var rs, re = _bj_k_ux_sqrt(es, ee);
    var cxs, cxe = _bj_k_ux_from(c);
    var ts, te = _bj_k_ux_from(dt);
    var cs, ce = _bj_k_ux_mul(cxs, cxe, ts, te);
    var vs, ve = _bj_k_ux_div(cs, ce, rs, re);
    var xs, xe = _bj_k_ux_from(dx);
    var v3s, v3e = _bj_k_ux_mul(3.0, 0, vs, ve);
    if (_bj_k_ux_cmp(v3s, v3e, xs, xe + 1) == 1 && _bj_k_ux_cmp(vs, ve, xs, xe + 1) == 0 - 1) {
        var ok, kb = _bj_fd1_mur_band(dt, dx, eps_r, mu_r, cs, ce, rs, re);
        if (ok == 1) { return kb; }
    }
    var nrm = _bj_fd1_normal(em) & _bj_fd1_normal(root) & _bj_fd1_normal(cdt) & _bj_fd1_normal(v_dt);
    nrm = nrm & _bj_fd1_normal(num) & _bj_fd1_normal(den);
    if (nrm == 1) { return k; }
    var ns, ne = _bj_k_ux_sub(vs, ve, xs, xe);
    var qs, qe = _bj_k_ux_add(vs, ve, xs, xe);
    var ku: f64 = _bj_k_ux_div_f64(ns, ne, qs, qe);
    return ku;
}

# Creates a 1D grid of num_cells cells (a usize) and spacing dx (m) into *out, every field zero, vacuum everywhere,
# dt = dx/(2c) and the vacuum Mur coefficient at both ends: Ok(0); or, with out empty, Err(InsufficientResolution)
# for num_cells < 2, Err(InvalidParameter) "dx must be finite and positive, got {dx}", Err(Allocation) when the
# grid's mapping can't be had (Rust's vec! aborts there; ADR 0002 row 9). Give the grid back with BjFdtd1d_free.
# Mirrors `Fdtd1d::new`.
#must_use
public fn BjFdtd1d_new(num_cells, dx: f64, out: *BjFdtd1d): Result {
    memset(out, 0, sizeof(BjFdtd1d));
    if (num_cells >= 0 && num_cells < 2) {
        var nf: f64 = f64_from(num_cells);
        var size: f64 = nf * dx;
        return Err(_bj_err_insufficient_resolution(num_cells, size));
    }
    if (_bj_fd1_pos(dx) == 0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "dx must be finite and positive, got ");
        _bj_fmt_f64_display(t, dx);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var map = 0;
    if (num_cells > 0 && num_cells <= _BJ_FD1_MAX_CELLS) { map = mmap_anon(num_cells * 8 * _BJ_FD1_ARRAYS); }
    if (map == 0) {
        var ta = _bj_err_reason(BJ_ERR_ALLOCATION);
        _bj_tx_cstr(ta, "a 1D FDTD grid of ");
        _bj_tx_u64(ta, num_cells);
        _bj_tx_cstr(ta, " cells");
        return Err(BJ_ERR_ALLOCATION);
    }
    var c: f64 = BJ_SPEED_OF_LIGHT;
    var c2: f64 = 2.0 * c;
    var dt: f64 = dx / c2;
    var ce: f64 = _bj_e_fd_coeff(dt, BJ_EPSILON_0, dx, 1.0);
    var ch: f64 = _bj_e_fd_coeff(dt, BJ_MU_0, dx, 1.0);
    var abc: f64 = _bj_fd1_mur(dt, dx, 1.0, 1.0);
    var n = num_cells;
    var eps: *f64 = _bj_fd1_f64p(map + 2 * n * 8);
    var mu: *f64 = _bj_fd1_f64p(map + 3 * n * 8);
    var cep: *f64 = _bj_fd1_f64p(map + 4 * n * 8);
    var chp: *f64 = _bj_fd1_f64p(map + 5 * n * 8);
    for (var i = 0; i < n; i = i + 1) {
        eps[i] = 1.0;
        mu[i] = 1.0;
        cep[i] = ce;
        chp[i] = ch;
    }
    out.e_field = map;
    out.h_field = map + n * 8;
    out.permittivity = map + 2 * n * 8;
    out.permeability = map + 3 * n * 8;
    out.e_coeff = map + 4 * n * 8;
    out.h_coeff = map + 5 * n * 8;
    out.work = map + 6 * n * 8;
    out.dx = dx;
    out.dt = dt;
    out.step = 0;
    out.num_cells = n;
    out.abc_left = abc;
    out.abc_right = abc;
    out.map_bytes = n * 8 * _BJ_FD1_ARRAYS;
    if (_bj_log_on(4) == 1) {
        var lb[256];
        var lt[24];
        _bj_tx_init(&lt, &lb, 256);
        _bj_tx_cstr(&lt, "FDTD 1D simulation created num_cells=");
        _bj_tx_u64(&lt, n);
        _bj_tx_cstr(&lt, " dx=");
        _bj_fmt_f64_debug(&lt, dx);
        _bj_tx_cstr(&lt, " dt=");
        _bj_fmt_f64_debug(&lt, dt);
        _bj_tx_cstr(&lt, " abc_coeff=");
        _bj_fmt_f64_debug(&lt, abc);
        _bj_log_text(4, &lt);
    }
    return Ok(0);
}

# Gives a grid's mapping back and empties it (num_cells 0, every address 0); a second call does nothing.
public fn BjFdtd1d_free(sim: *BjFdtd1d): i64 {
    if (sim.map_bytes > 0) { cyr_munmap(sim.e_field, sim.map_bytes); }
    sim.e_field = 0;
    sim.h_field = 0;
    sim.permittivity = 0;
    sim.permeability = 0;
    sim.e_coeff = 0;
    sim.h_coeff = 0;
    sim.work = 0;
    sim.num_cells = 0;
    sim.map_bytes = 0;
    return 0;
}

# min(end, n) for usize words: a negative word is past 2^63, so above n.
#must_use
fn _bj_fd1_umin(end, n): i64 {
    if (end < 0 || end > n) { return n; }
    return end;
}

# 1 when every field, ε_r, μ_r and dx of the grid is finite.
#must_use
fn _bj_fd1_finite_fields(sim: *BjFdtd1d): i64 {
    var e: *f64 = _bj_fd1_f64p(sim.e_field);
    var h: *f64 = _bj_fd1_f64p(sim.h_field);
    var eps: *f64 = _bj_fd1_f64p(sim.permittivity);
    var mu: *f64 = _bj_fd1_f64p(sim.permeability);
    var z: f64 = sim.dx * 0.0;
    for (var i = 0; i < sim.num_cells; i = i + 1) {
        var zi: f64 = e[i] * 0.0 + h[i] * 0.0 + eps[i] * 0.0 + mu[i] * 0.0;
        z = z + zi;
    }
    if (z == 0.0) { return 1; }
    return 0;
}

# total_energy's chain with an unbounded exponent (ADR 0002 row 18, M5 part 2d-2b): each product, term and partial sum
# to 53 bits, the sum from −0.0, and sum·dx rounded once.
#must_use
fn _bj_fd1_energy_ux(sim: *BjFdtd1d): f64 {
    var e: *f64 = _bj_fd1_f64p(sim.e_field);
    var h: *f64 = _bj_fd1_f64p(sim.h_field);
    var eps: *f64 = _bj_fd1_f64p(sim.permittivity);
    var mu: *f64 = _bj_fd1_f64p(sim.permeability);
    var ss: f64 = -0.0;
    var se = 0;
    var e0s, e0e = _bj_k_ux_from(BJ_EPSILON_0);
    var m0s, m0e = _bj_k_ux_from(BJ_MU_0);
    for (var i = 0; i < sim.num_cells; i = i + 1) {
        var es, ee = _bj_k_ux_from(e[i]);
        var hs, he = _bj_k_ux_from(h[i]);
        var a1s, a1e = _bj_fd1_mul2(0.5, eps[i]);
        var a2s, a2e = _bj_k_ux_mul(a1s, a1e, e0s, e0e);
        var a3s, a3e = _bj_k_ux_mul(a2s, a2e, es, ee);
        var as, ae = _bj_k_ux_mul(a3s, a3e, es, ee);
        var b1s, b1e = _bj_fd1_mul2(0.5, mu[i]);
        var b2s, b2e = _bj_k_ux_mul(b1s, b1e, m0s, m0e);
        var b3s, b3e = _bj_k_ux_mul(b2s, b2e, hs, he);
        var bs, be = _bj_k_ux_mul(b3s, b3e, hs, he);
        var ts, te = _bj_k_ux_add(as, ae, bs, be);
        var ns, ne = _bj_k_ux_add(ss, se, ts, te);
        ss = ns;
        se = ne;
    }
    var xs, xe = _bj_k_ux_from(sim.dx);
    var en: f64 = _bj_k_ux_mul_f64(ss, se, xs, xe);
    return en;
}

impl BjFdtd1d {
    # Recomputes the Mur coefficients from the medium beside each end: ε_r of E node 1 and μ_r of H node 0 on the
    # left, both at n − 2 on the right. Mirrors `update_abc_coefficients`.
    fn update_abc_coefficients(self) {
        var n = self.num_cells;
        if (n < 2) { return 0; }
        var eps: *f64 = _bj_fd1_f64p(self.permittivity);
        var mu: *f64 = _bj_fd1_f64p(self.permeability);
        var dt: f64 = self.dt;
        var dx: f64 = self.dx;
        var e1: f64 = eps[1];
        var m0: f64 = mu[0];
        var kl: f64 = _bj_fd1_mur(dt, dx, e1, m0);
        var er: f64 = eps[n - 2];
        var mr: f64 = mu[n - 2];
        var kr: f64 = _bj_fd1_mur(dt, dx, er, mr);
        self.abc_left = kl;
        self.abc_right = kr;
        return 0;
    }

    # Sets ε_r on cells start..end (usize; end clamped to the grid) and recomputes the Mur coefficients: Ok(0), or
    # Err(InvalidPermittivity) with the grid untouched unless eps_r is finite and positive. Mirrors
    # `Fdtd1d::set_permittivity`.
    #must_use
    public fn set_permittivity(self, start, end, eps_r: f64): Result {
        if (_bj_fd1_pos(eps_r) == 0) { return Err(_bj_err_invalid_permittivity(eps_r)); }
        var hi = _bj_fd1_umin(end, self.num_cells);
        var ce: f64 = _bj_e_fd_coeff(self.dt, BJ_EPSILON_0, self.dx, eps_r);
        var eps: *f64 = _bj_fd1_f64p(self.permittivity);
        var cep: *f64 = _bj_fd1_f64p(self.e_coeff);
        if (start >= 0) {
            for (var i = start; i < hi; i = i + 1) {
                eps[i] = eps_r;
                cep[i] = ce;
            }
        }
        self.update_abc_coefficients();
        return Ok(0);
    }

    # Sets μ_r on cells start..end (usize; end clamped to the grid) and recomputes the Mur coefficients: Ok(0), or
    # Err(InvalidPermeability) with the grid untouched unless mu_r is finite and positive. Mirrors
    # `Fdtd1d::set_permeability`.
    #must_use
    public fn set_permeability(self, start, end, mu_r: f64): Result {
        if (_bj_fd1_pos(mu_r) == 0) { return Err(_bj_err_invalid_permeability(mu_r)); }
        var hi = _bj_fd1_umin(end, self.num_cells);
        var ch: f64 = _bj_e_fd_coeff(self.dt, BJ_MU_0, self.dx, mu_r);
        var mu: *f64 = _bj_fd1_f64p(self.permeability);
        var chp: *f64 = _bj_fd1_f64p(self.h_coeff);
        if (start >= 0) {
            for (var i = start; i < hi; i = i + 1) {
                mu[i] = mu_r;
                chp[i] = ch;
            }
        }
        self.update_abc_coefficients();
        return Ok(0);
    }

    # Adds value to E at cell (a soft source); a cell outside the grid is ignored. Mirrors `Fdtd1d::add_source`.
    public fn add_source(self, cell, value: f64) {
        if (cell >= 0 && cell < self.num_cells) {
            var e: *f64 = _bj_fd1_f64p(self.e_field);
            var x: f64 = e[cell];
            e[cell] = x + value;
        }
        return 0;
    }

    # Advances one time step: H from E, then the interior E from H, then the Mur boundaries,
    # E₀ⁿ⁺¹ = E₁ⁿ + k (E₁ⁿ⁺¹ − E₀ⁿ) and its mirror at the right end (Mur 1981; Taflove & Hagness, ch. 7); a cell whose
    # update leaves the normal range runs it with an unbounded exponent, rounded once (ADR 0002 row 18, M5 parts 2d-2a
    # and 2d-3: src/crmath_edge.cyr's _bj_e_cell_row). Mirrors `Fdtd1d::step_once`.
    public fn step_once(self) {
        var n = self.num_cells;
        if (n < 2) {
            self.step = self.step + 1;
            return 0;
        }
        var e: *f64 = _bj_fd1_f64p(self.e_field);
        var h: *f64 = _bj_fd1_f64p(self.h_field);
        var ce: *f64 = _bj_fd1_f64p(self.e_coeff);
        var ch: *f64 = _bj_fd1_f64p(self.h_coeff);
        var w: *f64 = _bj_fd1_f64p(self.work);
        var e_left: f64 = e[1];
        var e_right: f64 = e[n - 2];
        # H[i] += c_h[i]·(E[i + 1] − E[i]) for i < n − 1, then E[i] += c_e[i]·(H[i] − H[i − 1]) for 0 < i < n − 1.
        _bj_e_cell_row(h, ch, 8, e + 1, e, w, n - 1);
        _bj_e_cell_row(e + 1, ce + 1, 8, h + 1, h, w, n - 2);
        e[0] = _bj_e_cell_one(e_left, self.abc_left, e[1], e[0]);
        e[n - 1] = _bj_e_cell_one(e_right, self.abc_right, e[n - 2], e[n - 1]);
        self.step = self.step + 1;
        return 0;
    }

    # Runs `steps` time steps (a usize). Before each, when source_cell is in the grid, adds
    # source_amplitude·sin(2π·source_frequency·t) at it, t = step·dt; BJ_FDTD_NO_SOURCE (or any cell outside the
    # grid) injects nothing, as Rust's None. Where t, 2πf or the phase leaves the normal range for finite arguments
    # (the phase past DBL_MAX, where Rust took the sine of ∞), the sample runs with an unbounded exponent, the sine past
    # DBL_MAX by Payne–Hanek (ADR 0002 row 18, M5 part 2d-2b; src/crmath_edge.cyr's _bj_e_fd_source, which the 2D and
    # 3D grids share since M6 part 4f). A step past 2^63 is read unsigned, as Rust's `step as f64`. Mirrors
    # `Fdtd1d::run`.
    public fn run(self, steps, source_cell, source_frequency: f64, source_amplitude: f64) {
        if (_bj_log_on(4) == 1) {
            var lb[256];
            var lt[24];
            _bj_tx_init(&lt, &lb, 256);
            _bj_tx_cstr(&lt, "FDTD run started steps=");
            _bj_tx_u64(&lt, steps);
            _bj_tx_cstr(&lt, " source_cell=");
            if (source_cell == BJ_FDTD_NO_SOURCE) { _bj_tx_cstr(&lt, "None"); }
            else {
                _bj_tx_cstr(&lt, "Some(");
                _bj_tx_u64(&lt, source_cell);
                _bj_tx_cstr(&lt, ")");
            }
            _bj_tx_cstr(&lt, " source_frequency=");
            _bj_fmt_f64_debug(&lt, source_frequency);
            _bj_tx_cstr(&lt, " source_amplitude=");
            _bj_fmt_f64_debug(&lt, source_amplitude);
            _bj_log_text(4, &lt);
        }
        var inject = 0;
        if (source_cell >= 0 && source_cell < self.num_cells) { inject = 1; }
        var w: f64 = 2.0 * _BJ_FD1_PI;
        for (var k = 0; k != steps; k = k + 1) {
            if (inject == 1) {
                var sf: f64 = _bj_e_u2f(self.step);
                var v: f64 = _bj_e_fd_source(sf, self.dt, w, source_frequency, source_amplitude);
                self.add_source(source_cell, v);
            }
            self.step_once();
        }
        return 0;
    }

    # The simulation time step·dt (s), rounded once: a step past 2^53 (a written field) is split exactly as
    # s_hi + s_lo, where Rust's `step as f64` rounded first (ADR 0002 row 13, M5 part 2b; src/crmath_edge.cyr's
    # _bj_e_fd_time). Mirrors `Fdtd1d::time`.
    #must_use
    public fn time(self): f64 {
        var t: f64 = _bj_e_fd_time(self.step, self.dt);
        return t;
    }

    # The field energy per unit area, dx·Σ(½ε_rε₀E² + ½μ_rμ₀H²), summed from −0.0 as Rust's `Sum`. Where a product,
    # a term or the running sum leaves the normal range for finite fields (E² past DBL_MAX, or below the range, while
    # the energy is representable), the whole chain runs with an unbounded exponent and the last product is rounded
    # once (ADR 0002 row 18, M5 part 2d-2b). Mirrors `Fdtd1d::total_energy`.
    #must_use
    public fn total_energy(self): f64 {
        var e: *f64 = _bj_fd1_f64p(self.e_field);
        var h: *f64 = _bj_fd1_f64p(self.h_field);
        var eps: *f64 = _bj_fd1_f64p(self.permittivity);
        var mu: *f64 = _bj_fd1_f64p(self.permeability);
        var sum: f64 = -0.0;
        var ok = 1;
        for (var i = 0; i < self.num_cells; i = i + 1) {
            var ei: f64 = e[i];
            var hi: f64 = h[i];
            var ep: f64 = eps[i];
            var mp: f64 = mu[i];
            var a1: f64 = 0.5 * ep;
            var a2: f64 = a1 * BJ_EPSILON_0;
            var a3: f64 = a2 * ei;
            var a: f64 = a3 * ei;
            var b1: f64 = 0.5 * mp;
            var b2: f64 = b1 * BJ_MU_0;
            var b3: f64 = b2 * hi;
            var b: f64 = b3 * hi;
            var term: f64 = a + b;
            sum = sum + term;
            if (ok == 1) {
                ok = _bj_fd1_prod_ok(a1, 0.5, ep) & _bj_fd1_prod_ok(a2, a1, BJ_EPSILON_0) & _bj_fd1_prod_ok(a3, a2, ei);
                ok = ok & _bj_fd1_prod_ok(a, a3, ei) & _bj_fd1_prod_ok(b1, 0.5, mp) & _bj_fd1_prod_ok(b2, b1, BJ_MU_0);
                ok = ok & _bj_fd1_prod_ok(b3, b2, hi) & _bj_fd1_prod_ok(b, b3, hi);
                ok = ok & _bj_fd1_normal(term) & _bj_fd1_normal(sum);
            }
        }
        var dx: f64 = self.dx;
        var energy: f64 = sum * dx;
        if (ok == 0 && _bj_fd1_finite_fields(self) == 1) { energy = _bj_fd1_energy_ux(self); }
        return energy;
    }
}
