# Thresholds, each the last double before the result changes (bisection over bit patterns with
# MPFR's correctly rounded function): EXP_OVF the largest x with exp(x) finite, EXP_UNF the
# most negative x with exp(x) > 0 (below it exp(x) < 2^-1075 rounds to +0), the same for exp10,
# EXPM1_OVF the largest x with expm1(x) finite, EXPM1_M1 the most negative x with expm1(x) > −1.
var _BJ_K_CR_EXP_OVF = 0x40862E42FEFA39EF;   # 709.782712893384
var _BJ_K_CR_EXP_UNF = 0xC0874910D52D3051;   # -745.1332191019411
var _BJ_K_CR_EXP10_OVF = 0x40734413509F79FE;   # 308.2547155599167
var _BJ_K_CR_EXP10_UNF = 0xC07439B746E36B52;   # -323.60724533877976
var _BJ_K_CR_EXPM1_OVF = 0x40862E42FEFA39EF;   # 709.782712893384
var _BJ_K_CR_EXPM1_M1 = 0xC042B708872320E1;   # -37.42994775023704

