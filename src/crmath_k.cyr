# crmath_k.cyr — correctly rounded acos, asin and log10 (bijli ADR 0001), on kimiya's correctly rounded cores.
#
# acos and log10 are kimiya's (src/mathx.cyr, its ADR 0006), copied function for function with the prefixes renamed
# (_km_ → _bj_k_, _KM_ → _BJ_K_): the 24 functions their call closure reaches — the atan and ln cores (fast:
# double-double with a proven bound and a rounding test; accurate: triple-double) and the triple-double arithmetic
# under them. asin is bijli's, at the end of this file, on the same atan core as kimiya's acos. Tables:
# src/crmath_k_data.cyr, generated by scripts/oracle/crtables_k.py (kimiya's mathx_tables.py, its ln and atan
# tables), every value equal to kimiya's. src/crmath.cyr (impetus's) holds exp, sin, cos, hypot, pow and atan2;
# the two libraries share nothing but the IEEE primitives.

# +∞ (0x7FF0000000000000), a compile-time constant.
const _BJ_K_INF = 1.0 / 0.0;

# The quiet NaN Rust's f64::NAN is (0x7FF8000000000000). The parity rules match any NaN.
#must_use
fn _bj_k_nan(): f64 {
    var n: f64 = 0x7FF8000000000000;
    return n;
}

# a + b = s + e exactly (Knuth's TwoSum).
#must_use
fn _bj_k_two_sum(a: f64, b: f64): (f64, f64) {
    var s: f64 = a + b;
    var bb: f64 = s - a;
    var e: f64 = (a - (s - bb)) + (b - bb);
    return (s, e);
}

# a + b = s + e exactly, for |a| ≥ |b| or a = 0 (Dekker's FastTwoSum): s = RN(a + b).
#must_use
fn _bj_k_fast_two_sum(a: f64, b: f64): (f64, f64) {
    var s: f64 = a + b;
    var e: f64 = b - (s - a);
    return (s, e);
}

# a·b = p + e exactly (Dekker's TwoProduct with Veltkamp's 2²⁷ + 1 split), for |a|, |b| < 2⁹⁹⁶
# and no underflow in e.
#must_use
fn _bj_k_two_prod(a: f64, b: f64): (f64, f64) {
    var p: f64 = a * b;
    var split: f64 = 134217729.0;
    var ca: f64 = split * a;
    var ah: f64 = ca - (ca - a);
    var al: f64 = a - ah;
    var cb: f64 = split * b;
    var bh: f64 = cb - (cb - b);
    var bl: f64 = b - bh;
    var e: f64 = (al * bl) - (((p - (ah * bh)) - (al * bh)) - (ah * bl));
    return (p, e);
}

# RO(a + b): a + b rounded to odd (of the two doubles around an inexact sum, the one with an odd last
# bit; exact sums are returned as they are). TwoSum's error e gives the side of the exact sum; an inexact
# sum is never 0, so the bit step stays in range.
#must_use
fn _bj_k_ro_sum(a: f64, b: f64): f64 {
    var s, e = _bj_k_two_sum(a, b);
    if (e == 0.0) { return s; }
    var sb = load64(&s);
    if ((sb & 1) != 0) { return s; }
    var up = 0;
    if (e > 0.0) { up = 1; }
    var pos = 0;
    if (s > 0.0) { pos = 1; }
    if (up == pos) { sb = sb + 1; } else { sb = sb - 1; }   # away from zero is the larger magnitude word
    var r: f64 = sb;
    return r;
}

# RN(a + b + c) exactly, for any three doubles without underflow in the TwoSums: Boldo and Melquiond's
# rounding-to-odd algorithm ("Emulation of FMA and correctly rounded sums", IEEE TC 2008): b + c = uh + ul
# and a + uh = th + tl exactly, then RN(th + RO(tl + ul)). (300,000 adversarial triples — ties, near-ties,
# binade edges, cancellation — agree with exact rational rounding.)
#must_use
fn _bj_k_rn3(a: f64, b: f64, c: f64): f64 {
    var uh, ul = _bj_k_two_sum(b, c);
    var th, tl = _bj_k_two_sum(a, uh);
    var v: f64 = _bj_k_ro_sum(tl, ul);
    var z: f64 = th + v;
    return z;
}

# Triple-doubles (h, m, l), normalised (|m| ≲ ulp(h), |l| ≲ ulp(m)). Every step is TwoSum or TwoProduct
# (exact) except the rounded sums of the third-order terms and the dropped products below 2^-158 of the
# result, so each operation's error is below 2^-155·max(|a|, |b|) for a sum and 2^-153·|a·b| for a
# product. The renormalising TwoSums keep the sum exact whatever the magnitudes, so a cancellation costs
# only its relative factor.
#must_use
fn _bj_k_td_add(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64): (f64, f64, f64) {
    var s0, e0 = _bj_k_two_sum(a0, b0);
    var s1, e1 = _bj_k_two_sum(a1, b1);
    var s2: f64 = a2 + b2;
    var t1, f1 = _bj_k_two_sum(e0, s1);
    var t2: f64 = (f1 + e1) + s2;
    var h, u = _bj_k_two_sum(s0, t1);
    var m, l = _bj_k_two_sum(u, t2);
    return (h, m, l);
}

# (a0, a1, a2) + d.
#must_use
fn _bj_k_td_add_d(a0: f64, a1: f64, a2: f64, d: f64): (f64, f64, f64) {
    var s0, e0 = _bj_k_two_sum(a0, d);
    var t1, f1 = _bj_k_two_sum(e0, a1);
    var t2: f64 = f1 + a2;
    var h, u = _bj_k_two_sum(s0, t1);
    var m, l = _bj_k_two_sum(u, t2);
    return (h, m, l);
}

# (a0, a1, a2)·(b0, b1, b2): a0b0, a0b1, a1b0 exact (TwoProduct), the 2^-106 terms rounded, the 2^-159 ones
# (a1b2, a2b1, a2b2) dropped.
#must_use
fn _bj_k_td_mul(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64): (f64, f64, f64) {
    var p0, q0 = _bj_k_two_prod(a0, b0);
    var p1, q1 = _bj_k_two_prod(a0, b1);
    var p2, q2 = _bj_k_two_prod(a1, b0);
    var r: f64 = ((a0 * b2) + (a1 * b1)) + (a2 * b0);
    var s1, e1 = _bj_k_two_sum(p1, p2);
    var s2, e2 = _bj_k_two_sum(q0, s1);
    var t: f64 = (((e1 + e2) + q1) + q2) + r;
    var h, u = _bj_k_two_sum(p0, s2);
    var m, l = _bj_k_two_sum(u, t);
    return (h, m, l);
}

# (a0, a1, a2)·d for a double d.
#must_use
fn _bj_k_td_mul_d(a0: f64, a1: f64, a2: f64, d: f64): (f64, f64, f64) {
    var p0, q0 = _bj_k_two_prod(a0, d);
    var p1, q1 = _bj_k_two_prod(a1, d);
    var r: f64 = a2 * d;
    var s, e = _bj_k_two_sum(q0, p1);
    var t: f64 = (e + q1) + r;
    var h, u = _bj_k_two_sum(p0, s);
    var m, l = _bj_k_two_sum(u, t);
    return (h, m, l);
}

# The ln fast core for the bits ui of a positive normal x (ebias −54 for a subnormal pre-scaled by 2^54):
# (hi, lo, err) with |hi + lo − ln x| < err minus the test's own rounding (the bound above).
#must_use
fn _bj_k_ln_core(ui, ebias): (f64, f64, f64) {
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_BJ_K_CR_LN_T + ti);
    var lh: f64 = load64(&_BJ_K_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_BJ_K_CR_LN_T + ti + 16);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var cc: f64 = r * 134217729.0;
    var ra: f64 = cc - (cc - r);
    var rb: f64 = r - ra;
    var t1: f64 = -0.5 * (ra * ra);             # −ra²/2, exact
    var nrb: f64 = -rb;
    var t2: f64 = nrb * (ra + (0.5 * rb));
    var c3: f64 = _BJ_K_CR_LN_C3;
    var c4: f64 = _BJ_K_CR_LN_C4;
    var c5: f64 = _BJ_K_CR_LN_C5;
    var c6: f64 = _BJ_K_CR_LN_C6;
    var c7: f64 = _BJ_K_CR_LN_C7;
    var c8: f64 = _BJ_K_CR_LN_C8;
    var z: f64 = r * r;
    var pz: f64 = ((c3 + (r * c4)) + (z * (c5 + (r * c6)))) + ((z * z) * (c7 + (r * c8)));   # Estrin
    var p: f64 = (z * r) * pz;
    var e = e0 + ebias;
    var ef: f64 = f64_from(e);
    var ln2h: f64 = _BJ_K_CR_LN_LN2H;
    var ln2m: f64 = _BJ_K_CR_LN_LN2M;
    var a: f64 = ef * ln2h;                      # exact: LN2H has 42 bits, |E| < 2^11
    var s0: f64 = a + lh;
    var d0: f64 = lh - (s0 - a);
    var s1: f64 = s0 + r;
    var d1: f64 = r - (s1 - s0);
    var s2: f64 = s1 + t1;
    var d2: f64 = t1 - (s2 - s1);
    var lo: f64 = (((ef * ln2m) + lm) + (t2 + p)) + ((d0 + d1) + d2);   # short chains (latency)
    var ap: f64 = f64_abs(p);
    var ah: f64 = f64_abs(s2);
    var ae: f64 = f64_abs(ef);
    var k49: f64 = 0x3CE0000000000000;          # 2^-49
    var k83: f64 = 0x3AC0000000000000;          # 2^-83
    var k93: f64 = 0x3A20000000000000;          # 2^-93
    var err: f64 = ((ap * k49) + (ah * k83)) + (ae * k93);
    return (s2, lo, err);
}

# The accurate ln of a positive finite x ≠ 1 as a triple-double at out[0..2]: the fast path's E, j and the
# exact r; log1p(r) by Horner in triple-double on the exact r to r^16/16 (truncation 2^-144·|r|);
# E·ln 2 = E·LN2H (exact) + E·LN2M (TwoProduct) + E·LN2L (rounded, 2^-138); then E·ln2 + L_j + log1p(r)
# with at most 1.3 bits of cancellation. Measured relative error 2^-150.
fn _bj_k_ln_acc_td(x: f64, out) {
    var ui = load64(&x);
    var eb = 0;
    if (ui < 0x0010000000000000) {
        var p54: f64 = 0x4350000000000000;
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_BJ_K_CR_LN_T + ti);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var sh: f64 = load64(&_BJ_K_CR_LN_ACC + 336);     # −1/16 (index 3·(16 − 2))
    var sm: f64 = load64(&_BJ_K_CR_LN_ACC + 344);
    var sl: f64 = load64(&_BJ_K_CR_LN_ACC + 352);
    var n = 15;
    while (n >= 2) {
        var th, tm, tl = _bj_k_td_mul_d(sh, sm, sl, r);
        var off = (n - 2) * 24;
        var ch: f64 = load64(&_BJ_K_CR_LN_ACC + off);
        var cm: f64 = load64(&_BJ_K_CR_LN_ACC + off + 8);
        var cl: f64 = load64(&_BJ_K_CR_LN_ACC + off + 16);
        var uh, um, ul = _bj_k_td_add(ch, cm, cl, th, tm, tl);
        sh = uh;
        sm = um;
        sl = ul;
        n = n - 1;
    }
    var vh, vm, vl = _bj_k_td_mul_d(sh, sm, sl, r);
    var wh, wm, wl = _bj_k_td_add_d(vh, vm, vl, 1.0);
    var ph, pm, pl = _bj_k_td_mul_d(wh, wm, wl, r);       # log1p(r)
    var lh: f64 = load64(&_BJ_K_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_BJ_K_CR_LN_T + ti + 16);
    var ll: f64 = load64(&_BJ_K_CR_LN_T + ti + 24);
    var ef: f64 = f64_from(e0 + eb);
    var ln2h: f64 = _BJ_K_CR_LN_LN2H;
    var ln2m: f64 = _BJ_K_CR_LN_LN2M;
    var ln2l: f64 = _BJ_K_CR_LN_LN2L;
    var a0: f64 = ef * ln2h;
    var a1, a1e = _bj_k_two_prod(ef, ln2m);
    var a2: f64 = ef * ln2l;
    var h0, u0 = _bj_k_fast_two_sum(a0, a1);
    var a12: f64 = a1e + a2;
    var m0, l0 = _bj_k_two_sum(u0, a12);
    var bh, bm, bl = _bj_k_td_add(h0, m0, l0, lh, lm, ll);
    var zh, zm, zl = _bj_k_td_add(bh, bm, bl, ph, pm, pl);
    store64(out, zh);
    store64(out + 8, zm);
    store64(out + 16, zl);
}

# log10(x), correctly rounded. log10(10^k) = k (k = 0 … 22), log10(1) = +0, log10(±0) = −∞, log10(+∞) = +∞,
# NaN for NaN and x < 0. The ln core's (hi, lo, ε), then (hi + lo)·(IVH + IVM) (Dekker's product with IVH
# pre-split) and the rounding test, else the accurate path.
#must_use
fn _bj_k_cr_log10(x: f64): f64 {
    var ui = load64(&x);
    var eb = 0;
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {   # as in _bj_k_cr_ln
        if (x != x) { return x; }
        if (x == 0.0) {
            var m1: f64 = -1.0;
            var ninf: f64 = m1 / 0.0;
            return ninf;
        }
        if (x < 0.0) {
            var nan: f64 = _bj_k_nan();
            return nan;
        }
        if (x == _BJ_K_INF) { return x; }
        var p54: f64 = 0x4350000000000000;          # a subnormal x, scaled exactly by 2^54
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var hi, lo, eln = _bj_k_ln_core(ui, eb);
    var ivh: f64 = _BJ_K_CR_LN_IVH;
    var ivm: f64 = _BJ_K_CR_LN_IVM;
    var i1: f64 = _BJ_K_CR_LN_IVH1;
    var i2: f64 = _BJ_K_CR_LN_IVH2;
    var ph: f64 = hi * ivh;
    var c: f64 = 134217729.0 * hi;
    var h1: f64 = c - (c - hi);
    var h2: f64 = hi - h1;
    var pe: f64 = ((((h1 * i1) - ph) + (h1 * i2)) + (h2 * i1)) + (h2 * i2);
    var pl: f64 = pe + ((hi * ivm) + (lo * ivh));
    # The error: 0.4343·(ln's error) plus the product's roundings (hi·IVM, lo·IVH, pl's sum, the test's own:
    # below 2^-52.4·|lo| + 2^-101·|ph|, which eln's slack and 0.5 − 0.4343 cover) and IVL (2^-111·|ln x|):
    # err10 = eln/2 + 2^-100·|ph|.
    var ap: f64 = f64_abs(ph);
    var k100: f64 = 0x39B0000000000000;     # 2^-100
    var err: f64 = (eln * 0.5) + (ap * k100);
    var u: f64 = ph + (pl - err);
    var v: f64 = ph + (pl + err);
    if (u == v) { return u; }
    var z: f64 = _bj_k_cr_log10_acc(x);
    return z;
}

# log10 by the accurate path alone: the triple-double ln times 1/ln 10 = IVH + IVM + IVL.
#must_use
fn _bj_k_cr_log10_acc(x: f64): f64 {
    if (x != x) { return x; }
    if (x == 0.0) {
        var m1: f64 = -1.0;
        var ninf: f64 = m1 / 0.0;
        return ninf;
    }
    if (x < 0.0) {
        var nan: f64 = _bj_k_nan();               # the same quiet NaN on every target
        return nan;
    }
    if (x == _BJ_K_INF) { return x; }
    if (x == 1.0) { return 0.0; }
    var buf: f64[3];
    _bj_k_ln_acc_td(x, &buf);
    var ivh: f64 = _BJ_K_CR_LN_IVH;
    var ivm: f64 = _BJ_K_CR_LN_IVM;
    var ivl: f64 = _BJ_K_CR_LN_IVL;
    var zh, zm, zl = _bj_k_td_mul(buf[0], buf[1], buf[2], ivh, ivm, ivl);
    var r: f64 = _bj_k_rn3(zh, zm, zl);
    return r;
}

# The fast atan core for n = nh + nl, d = dh + dl with 0 < n ≤ d (1 + 2^-50), dh in [1/2, 2), nh ≥ 2^-62·dh:
# (hi, lo, err) for offset ± atan(n/d) by oct.
#must_use
fn _bj_k_atan_core(nh: f64, nl: f64, dh: f64, dl: f64, oct): (f64, f64, f64) {
    var zh: f64 = nh / dh;
    var cz: f64 = zh + 26388279066624.0;          # 1.5·2^44: rounds n/d to a multiple of 2^-8
    var c: f64 = cz - 26388279066624.0;
    var j = load64(&cz) - 0x42B8000000000000;
    var sh: f64 = nh;
    var sl: f64 = nl;
    var eh: f64 = dh;
    var el: f64 = dl;
    if (j != 0) {
        var d1: f64 = (dh + 384.0) - 384.0;       # 1.5·2^8: dh on the 2^-44 grid
        var d2: f64 = dh - d1;
        var n1: f64 = (nh + 384.0) - 384.0;
        var n2: f64 = nh - n1;
        var p1: f64 = c * d1;                     # exact
        var np1: f64 = -p1;
        var u: f64 = nh + np1;                    # TwoSum(nh, −c·d1)
        var ub: f64 = u - nh;
        var ue: f64 = (nh - (u - ub)) + (np1 - ub);
        sh = u;
        sl = ((ue - (c * d2)) + nl) - (c * dl);
        var q1: f64 = c * n1;                     # exact
        var v: f64 = dh + q1;                     # TwoSum(dh, c·n1)
        var vb: f64 = v - dh;
        var ve: f64 = (dh - (v - vb)) + (q1 - vb);
        eh = v;
        el = ((ve + (c * n2)) + dl) + (c * nl);
    }
    var qh: f64 = sh / eh;                        # δ = qh + ql: Dekker's division
    var cq: f64 = 134217729.0 * qh;
    var q1h: f64 = cq - (cq - qh);
    var q1l: f64 = qh - q1h;
    var ce: f64 = 134217729.0 * eh;
    var e1h: f64 = ce - (ce - eh);
    var e1l: f64 = eh - e1h;
    var pp: f64 = qh * eh;
    var pe: f64 = (((q1h * e1h) - pp) + (q1h * e1l) + (q1l * e1h)) + (q1l * e1l);
    var ql: f64 = ((((sh - pp) - pe) + sl) - (qh * el)) / eh;
    var a3: f64 = _BJ_K_CR_SC_A3;
    var a5: f64 = _BJ_K_CR_SC_A5;
    var a7: f64 = _BJ_K_CR_SC_A7;
    var a9: f64 = _BJ_K_CR_SC_A9;
    var z: f64 = qh * qh;
    var pz: f64 = ((qh * z) * (a3 + (z * (a5 + (z * (a7 + (z * a9))))))) - (ql * z);
    var ah: f64 = load64(&_BJ_K_CR_ATAN_T + 24 * j);
    var am: f64 = load64(&_BJ_K_CR_ATAN_T + 24 * j + 8);
    var oh: f64 = 0.0;
    var om: f64 = 0.0;
    var sg: f64 = 1.0;
    if (oct == 1) {
        oh = _BJ_K_CR_SC_PIH;
        om = _BJ_K_CR_SC_PIM;
        sg = -1.0;
    }
    if (oct >= 2) {
        oh = _BJ_K_CR_SC_PIO2H;
        om = _BJ_K_CR_SC_PIO2M;
        if (oct == 2) { sg = -1.0; }
    }
    var sah: f64 = sg * ah;
    var h1: f64 = oh + sah;                       # Fast2Sum: |oh| ≥ |ah| or oh = 0
    var f1: f64 = sah - (h1 - oh);
    var sqh: f64 = sg * qh;
    var hi: f64 = h1 + sqh;                       # Fast2Sum: |h1| ≥ |qh| or h1 = 0
    var f2: f64 = sqh - (hi - h1);
    var tl: f64 = (am + ql) + pz;
    var lo: f64 = ((f1 + f2) + om) + (sg * tl);
    var ahi: f64 = f64_abs(hi);
    var k68: f64 = 0x3BA6A09E667F3BCD;            # 2^-68.5 (√2·2^-69)
    var err: f64 = ahi * k68;
    return (hi, lo, err);
}

# A triple-double renormalised (two bottom-up TwoSum passes): after a cancellation _bj_k_td_add's leading word can
# be far from the sum (its last renormalisation does not see the rounded third-order term), and the corrections
# below need the leading word to be the sum to 2^-52. The sum is unchanged (every step is exact).
#must_use
fn _bj_k_td_norm(a0: f64, a1: f64, a2: f64): (f64, f64, f64) {
    var s, e = _bj_k_two_sum(a1, a2);
    var h, u = _bj_k_two_sum(a0, s);
    var m, l = _bj_k_two_sum(u, e);
    var h2, u2 = _bj_k_two_sum(h, m);
    var m2, l2 = _bj_k_two_sum(u2, l);
    return (h2, m2, l2);
}

# (a0, a1, a2)/(b0, b1, b2) as a triple-double at out[0..2], b ≠ 0 normalised: q0 = a0/b0 (a renormalised first),
# then two corrections from the remainder a − q·b, computed in triple-double (each below 2^-153 of a) and
# renormalised: relative error below 2^-151.
fn _bj_k_td_div(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64, out) {
    var n0, n1, n2 = _bj_k_td_norm(a0, a1, a2);
    var q0: f64 = n0 / b0;
    var t0, t1, t2 = _bj_k_td_mul_d(b0, b1, b2, q0);
    var ra, rb, rc = _bj_k_td_add(n0, n1, n2, -t0, -t1, -t2);
    var r0, r1, r2 = _bj_k_td_norm(ra, rb, rc);
    var q1: f64 = r0 / b0;
    var u0, u1, u2 = _bj_k_td_mul_d(b0, b1, b2, q1);
    var sa, sb, sc = _bj_k_td_add(r0, r1, r2, -u0, -u1, -u2);
    var s0, s1, s2 = _bj_k_td_norm(sa, sb, sc);
    var q2: f64 = s0 / b0;
    var h, m0 = _bj_k_fast_two_sum(q0, q1);
    var m, l = _bj_k_two_sum(m0, q2);
    store64(out, h);
    store64(out + 8, m);
    store64(out + 16, l);
}

# offset ± atan(n/d) as a triple-double at out[0..2] (the accurate atan core before its rounding).
fn _bj_k_atan_acc_td(n0: f64, n1: f64, n2: f64, d0: f64, d1: f64, d2: f64, oct, out) {
    var zh: f64 = n0 / d0;
    var cz: f64 = zh + 26388279066624.0;
    var c: f64 = cz - 26388279066624.0;
    var j = load64(&cz) - 0x42B8000000000000;
    var a0: f64 = n0;
    var a1: f64 = n1;
    var a2: f64 = n2;
    var b0: f64 = d0;
    var b1: f64 = d1;
    var b2: f64 = d2;
    if (j != 0) {                                 # num = n − c·d, den = d + c·n
        var cd0, cd1, cd2 = _bj_k_td_mul_d(d0, d1, d2, c);
        var x0, x1, x2 = _bj_k_td_add(n0, n1, n2, -cd0, -cd1, -cd2);
        var cn0, cn1, cn2 = _bj_k_td_mul_d(n0, n1, n2, c);
        var y0, y1, y2 = _bj_k_td_add(d0, d1, d2, cn0, cn1, cn2);
        a0 = x0;
        a1 = x1;
        a2 = x2;
        b0 = y0;
        b1 = y1;
        b2 = y2;
    }
    var db: f64[3];
    _bj_k_td_div(a0, a1, a2, b0, b1, b2, &db);
    var dh: f64 = db[0];
    var dm: f64 = db[1];
    var dl: f64 = db[2];
    var wh, wm, wl = _bj_k_td_mul(dh, dm, dl, dh, dm, dl);
    var ph: f64 = load64(&_BJ_K_CR_ATAN_ACC + 168);  # 1/17 (index 3·(8 − 1))
    var pm: f64 = load64(&_BJ_K_CR_ATAN_ACC + 176);
    var pl: f64 = load64(&_BJ_K_CR_ATAN_ACC + 184);
    var k = 7;
    while (k >= 1) {                              # (−1)^k/(2k + 1) + w·P
        var th, tm, tl = _bj_k_td_mul(ph, pm, pl, wh, wm, wl);
        var off = (k - 1) * 24;
        var ch: f64 = load64(&_BJ_K_CR_ATAN_ACC + off);
        var cm: f64 = load64(&_BJ_K_CR_ATAN_ACC + off + 8);
        var cl: f64 = load64(&_BJ_K_CR_ATAN_ACC + off + 16);
        var uh, um, ul = _bj_k_td_add(ch, cm, cl, th, tm, tl);
        ph = uh;
        pm = um;
        pl = ul;
        k = k - 1;
    }
    var vh, vm, vl = _bj_k_td_mul(wh, wm, wl, ph, pm, pl);
    var xh, xm, xl = _bj_k_td_mul(vh, vm, vl, dh, dm, dl);
    var th2, tm2, tl2 = _bj_k_td_add(dh, dm, dl, xh, xm, xl);          # atan δ
    var ah: f64 = load64(&_BJ_K_CR_ATAN_T + 24 * j);
    var am: f64 = load64(&_BJ_K_CR_ATAN_T + 24 * j + 8);
    var al: f64 = load64(&_BJ_K_CR_ATAN_T + 24 * j + 16);
    var gh, gm, gl = _bj_k_td_add(ah, am, al, th2, tm2, tl2);          # θ
    if (oct == 0) {
        store64(out, gh);
        store64(out + 8, gm);
        store64(out + 16, gl);
        return;
    }
    var oh: f64 = _BJ_K_CR_SC_PIO2H;
    var om: f64 = _BJ_K_CR_SC_PIO2M;
    var ol: f64 = _BJ_K_CR_SC_PIO2L;
    if (oct == 1) {
        oh = _BJ_K_CR_SC_PIH;
        om = _BJ_K_CR_SC_PIM;
        ol = _BJ_K_CR_SC_PIL;
    }
    if (oct != 3) {
        gh = -gh;
        gm = -gm;
        gl = -gl;
    }
    var rh, rm, rl = _bj_k_td_add(oh, om, ol, gh, gm, gl);
    store64(out, rh);
    store64(out + 8, rm);
    store64(out + 16, rl);
}

# acos x = atan2(s, x), s = √(1 − x²) ≥ 0: θ = atan(s/|x|) (s ≤ |x|, oct 0 or 1 by x's sign) or
# atan(|x|/s) (oct 2 or 3). Fast path: 1 − x² as a double-double, exact but for a rounding at 2^-106
# ((1 − |x|)·(1 + |x|) for |x| ≥ 1/2, 1 − |x| exact by Sterbenz; 1 − x² by TwoProduct below), s by one Newton
# step from √ (2^-104 relative); the atan core's 2^-69.44 bound absorbs it. Accurate path: 1 − x² as an exact
# sum of four doubles, s by two Newton steps in triple-double (2^-150), the accurate atan core. Special values:
# acos(1) = +0, acos(−1) = π and acos(±0) = π/2 rounded; |x| < 2^-56 gives π/2 (acos x = π/2 − x − …, and
# π/2 is 2^-54.15 inside its rounding interval); NaN for NaN and |x| > 1. Mirrors `f64::acos`.
#must_use
fn _bj_k_cr_acos(x: f64): f64 {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax >= 0x3C70000000000000 && ax < 0x3FF0000000000000) {   # 2^-56 ≤ |x| < 1: the fast core inline
        var hi, lo, err = _bj_k_acos_core(x);
        var u: f64 = hi + (lo - err);
        var v: f64 = hi + (lo + err);
        if (u == v) { return u; }
        var a: f64 = _bj_k_cr_acos_acc(x);
        return a;
    }
    var r, ok = _bj_k_acos_special(x);              # every other x is a special value
    return r;
}

# The special values of acos: (result, 1), or (0, 0) for 2^-56 ≤ |x| < 1.
#must_use
fn _bj_k_acos_special(x: f64): (f64, i64) {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax > 0x7FF0000000000000) { return (x, 1); }
    if (ax > 0x3FF0000000000000) {
        var nan: f64 = _bj_k_nan();
        return (nan, 1);
    }
    if (x == 1.0) { return (0.0, 1); }
    if (x == -1.0) {
        var pi: f64 = _BJ_K_CR_SC_PIH;
        return (pi, 1);
    }
    if (ax < 0x3C70000000000000) {                # |x| < 2^-56, ±0 included
        var p2: f64 = _BJ_K_CR_SC_PIO2H;
        return (p2, 1);
    }
    return (0.0, 0);
}

# The fast core of acos for 2^-56 ≤ |x| < 1: (hi, lo, err) from the atan core.
#must_use
fn _bj_k_acos_core(x: f64): (f64, f64, f64) {
    var ax: f64 = f64_abs(x);
    var wh: f64 = 0.0;
    var wl: f64 = 0.0;
    if (ax >= 0.5) {
        var a: f64 = 1.0 - ax;                    # exact (Sterbenz)
        var bh: f64 = 1.0 + ax;                   # Fast2Sum(1, |x|)
        var bl: f64 = ax - (bh - 1.0);
        var ca: f64 = 134217729.0 * a;            # (1 − |x|)·bh by Dekker's product
        var a1: f64 = ca - (ca - a);
        var a2: f64 = a - a1;
        var cb: f64 = 134217729.0 * bh;
        var b1: f64 = cb - (cb - bh);
        var b2: f64 = bh - b1;
        wh = a * bh;
        var we: f64 = (((a1 * b1) - wh) + (a1 * b2) + (a2 * b1)) + (a2 * b2);
        wl = we + (a * bl);
    } else {
        var cx: f64 = 134217729.0 * ax;           # x² = p + pe (Dekker)
        var x1: f64 = cx - (cx - ax);
        var x2: f64 = ax - x1;
        var p: f64 = ax * ax;
        var pe: f64 = (((x1 * x1) - p) + (2.0 * (x1 * x2))) + (x2 * x2);
        wh = 1.0 - p;                             # Fast2Sum(1, −p)
        var we2: f64 = (1.0 - wh) - p;
        wl = we2 - pe;
    }
    var sh: f64 = f64_sqrt(wh);                   # s = sh + sl, one Newton step
    var cs: f64 = 134217729.0 * sh;
    var s1: f64 = cs - (cs - sh);
    var s2: f64 = sh - s1;
    var sp2: f64 = sh * sh;
    var spe: f64 = (((s1 * s1) - sp2) + (2.0 * (s1 * s2))) + (s2 * s2);
    var sl: f64 = (((wh - sp2) - spe) + wl) / (2.0 * sh);
    var neg = 0;
    if (x < 0.0) { neg = 1; }
    if (sh <= ax) {
        var h1, l1, e1 = _bj_k_atan_core(sh, sl, ax, 0.0, neg);
        return (h1, l1, e1);
    }
    var h2, l2, e2 = _bj_k_atan_core(ax, 0.0, sh, sl, 2 + neg);
    return (h2, l2, e2);
}

# √(w0 + w1 + w2) for w > 0 as a triple-double at out[0..2]: two Newton corrections of √w0, each from the
# renormalised residual w − s² (2^-150).
fn _bj_k_td_sqrt(w0: f64, w1: f64, w2: f64, out) {
    var s0: f64 = f64_sqrt(w0);
    var p, pe = _bj_k_two_prod(s0, s0);
    var ra, rb, rc = _bj_k_td_add(w0, w1, w2, -p, -pe, 0.0);
    var r0, r1, r2 = _bj_k_td_norm(ra, rb, rc);     # the residual w − s0², renormalised
    var tw: f64 = 2.0 * s0;
    var c1: f64 = r0 / tw;
    var h, m = _bj_k_fast_two_sum(s0, c1);
    var q0, q1, q2 = _bj_k_td_mul(h, m, 0.0, h, m, 0.0);
    var ua, ub, uc = _bj_k_td_add(w0, w1, w2, -q0, -q1, -q2);
    var u0, u1, u2 = _bj_k_td_norm(ua, ub, uc);
    var c2: f64 = u0 / tw;
    var v0, v1, v2 = _bj_k_td_add_d(h, m, 0.0, c2);
    store64(out, v0);
    store64(out + 8, v1);
    store64(out + 16, v2);
}

# acos x by the accurate path alone.
#must_use
fn _bj_k_cr_acos_acc(x: f64): f64 {
    var s, sp = _bj_k_acos_special(x);
    if (sp == 1) { return s; }
    var rb: f64[3];
    _bj_k_acos_acc_td(x, &rb);
    var r: f64 = _bj_k_rn3(rb[0], rb[1], rb[2]);
    return r;
}

# acos x for 2^-56 ≤ |x| < 1 as a triple-double at out[0..2] (the accurate path before its rounding).
fn _bj_k_acos_acc_td(x: f64, out) {
    var ax: f64 = f64_abs(x);
    var w0: f64 = 0.0;
    var w1: f64 = 0.0;
    var w2: f64 = 0.0;
    if (ax >= 0.5) {                              # (1 − |x|)·(1 + |x|): four exact products
        var a: f64 = 1.0 - ax;
        var bh, bl = _bj_k_fast_two_sum(1.0, ax);
        var p0, e0 = _bj_k_two_prod(a, bh);
        var p1, e1 = _bj_k_two_prod(a, bl);
        var g0, g1, g2 = _bj_k_td_add_d(p0, e0, 0.0, p1);
        var h0, h1, h2 = _bj_k_td_add_d(g0, g1, g2, e1);
        w0 = h0;
        w1 = h1;
        w2 = h2;
    } else {
        var p, pe = _bj_k_two_prod(ax, ax);
        var k0, k1, k2 = _bj_k_td_add_d(1.0, 0.0, 0.0, -p);
        var m0, m1, m2 = _bj_k_td_add_d(k0, k1, k2, -pe);
        w0 = m0;
        w1 = m1;
        w2 = m2;
    }
    var sb: f64[3];
    _bj_k_td_sqrt(w0, w1, w2, &sb);
    var neg = 0;
    if (x < 0.0) { neg = 1; }
    if (sb[0] <= ax) {
        _bj_k_atan_acc_td(sb[0], sb[1], sb[2], ax, 0.0, 0.0, neg, out);
        return;
    }
    _bj_k_atan_acc_td(ax, 0.0, 0.0, sb[0], sb[1], sb[2], 2 + neg, out);
}

# ── asin: bijli's, on kimiya's atan core ────────────────────────────────────────────

# The special values of asin: (result, 1), or (0, 0) for 2^-26 ≤ |x| < 1. NaN for NaN; NaN for |x| > 1, ±∞ included;
# asin(±1) = ±π/2 rounded; |x| < 2^-26 gives x itself, ±0 and the subnormals included: asin x − x < x³/6·(1 + x²),
# which is below 2^-54.5·|x| there, while half an ulp of x is at least 2^-54·|x|, and asin x lies strictly between x
# and the next double away from zero, so no tie can occur.
#must_use
fn _bj_k_asin_special(x: f64): (f64, i64) {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax > 0x7FF0000000000000) { return (x, 1); }
    if (ax > 0x3FF0000000000000) {
        var nan: f64 = _bj_k_nan();
        return (nan, 1);
    }
    if (ax == 0x3FF0000000000000) {
        var p2: f64 = _BJ_K_CR_SC_PIO2H;
        if (x < 0.0) { p2 = -p2; }
        return (p2, 1);
    }
    if (ax < 0x3E50000000000000) { return (x, 1); }      # |x| < 2^-26
    return (0.0, 0);
}

# The fast core of asin |x| for 2^-26 ≤ |x| < 1: (hi, lo, err) from the atan core. asin |x| = atan2(|x|, s) with
# s = √(1 − x²): θ = atan(|x|/s) when |x| ≤ s (oct 0), else π/2 − atan(s/|x|) (oct 2). 1 − x² and s exactly as
# kimiya's acos core computes them (a double-double, s by one Newton step, 2^-104 relative); the denominator is
# max(|x|, s) ≥ 1/√2 and the numerator at least 2^-26.5, inside the core's domain, and its 2^-69.44 bound absorbs
# s's error as it does for acos.
#must_use
fn _bj_k_asin_core(x: f64): (f64, f64, f64) {
    var ax: f64 = f64_abs(x);
    var wh: f64 = 0.0;
    var wl: f64 = 0.0;
    if (ax >= 0.5) {
        var a: f64 = 1.0 - ax;                    # exact (Sterbenz)
        var bh: f64 = 1.0 + ax;                   # Fast2Sum(1, |x|)
        var bl: f64 = ax - (bh - 1.0);
        var ca: f64 = 134217729.0 * a;            # (1 − |x|)·bh by Dekker's product
        var a1: f64 = ca - (ca - a);
        var a2: f64 = a - a1;
        var cb: f64 = 134217729.0 * bh;
        var b1: f64 = cb - (cb - bh);
        var b2: f64 = bh - b1;
        wh = a * bh;
        var we: f64 = (((a1 * b1) - wh) + (a1 * b2) + (a2 * b1)) + (a2 * b2);
        wl = we + (a * bl);
    } else {
        var cx: f64 = 134217729.0 * ax;           # x² = p + pe (Dekker)
        var x1: f64 = cx - (cx - ax);
        var x2: f64 = ax - x1;
        var p: f64 = ax * ax;
        var pe: f64 = (((x1 * x1) - p) + (2.0 * (x1 * x2))) + (x2 * x2);
        wh = 1.0 - p;                             # Fast2Sum(1, −p)
        var we2: f64 = (1.0 - wh) - p;
        wl = we2 - pe;
    }
    var sh: f64 = f64_sqrt(wh);                   # s = sh + sl, one Newton step
    var cs: f64 = 134217729.0 * sh;
    var s1: f64 = cs - (cs - sh);
    var s2: f64 = sh - s1;
    var sp2: f64 = sh * sh;
    var spe: f64 = (((s1 * s1) - sp2) + (2.0 * (s1 * s2))) + (s2 * s2);
    var sl: f64 = (((wh - sp2) - spe) + wl) / (2.0 * sh);
    if (ax <= sh) {
        var h1, l1, e1 = _bj_k_atan_core(ax, 0.0, sh, sl, 0);
        return (h1, l1, e1);
    }
    var h2, l2, e2 = _bj_k_atan_core(sh, sl, ax, 0.0, 2);
    return (h2, l2, e2);
}

# asin |x| for 2^-26 ≤ |x| < 1 as a triple-double at out[0..2] (the accurate path before its rounding): 1 − x² as an
# exact sum of doubles and s by kimiya's triple-double square root, as in kimiya's accurate acos, then the accurate
# atan core in octant 0 or 2.
fn _bj_k_asin_acc_td(x: f64, out) {
    var ax: f64 = f64_abs(x);
    var w0: f64 = 0.0;
    var w1: f64 = 0.0;
    var w2: f64 = 0.0;
    if (ax >= 0.5) {                              # (1 − |x|)·(1 + |x|): four exact products
        var a: f64 = 1.0 - ax;
        var bh, bl = _bj_k_fast_two_sum(1.0, ax);
        var p0, e0 = _bj_k_two_prod(a, bh);
        var p1, e1 = _bj_k_two_prod(a, bl);
        var g0, g1, g2 = _bj_k_td_add_d(p0, e0, 0.0, p1);
        var h0, h1, h2 = _bj_k_td_add_d(g0, g1, g2, e1);
        w0 = h0;
        w1 = h1;
        w2 = h2;
    } else {
        var p, pe = _bj_k_two_prod(ax, ax);
        var k0, k1, k2 = _bj_k_td_add_d(1.0, 0.0, 0.0, -p);
        var m0, m1, m2 = _bj_k_td_add_d(k0, k1, k2, -pe);
        w0 = m0;
        w1 = m1;
        w2 = m2;
    }
    var sb: f64[3];
    _bj_k_td_sqrt(w0, w1, w2, &sb);
    if (ax <= sb[0]) {
        _bj_k_atan_acc_td(ax, 0.0, 0.0, sb[0], sb[1], sb[2], 0, out);
        return;
    }
    _bj_k_atan_acc_td(sb[0], sb[1], sb[2], ax, 0.0, 0.0, 2, out);
}

# asin x by the accurate path alone.
#must_use
fn _bj_k_cr_asin_acc(x: f64): f64 {
    var s, sp = _bj_k_asin_special(x);
    if (sp == 1) { return s; }
    var rb: f64[3];
    _bj_k_asin_acc_td(x, &rb);
    var r: f64 = _bj_k_rn3(rb[0], rb[1], rb[2]);
    if (x < 0.0) { r = -r; }
    return r;
}

# asin x, correctly rounded: the odd function's value at |x| from the fast core and its rounding test, else the
# accurate path, then x's sign (negation is exact, and round-to-nearest is symmetric). Mirrors `f64::asin`.
#must_use
fn _bj_k_cr_asin(x: f64): f64 {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax >= 0x3E50000000000000 && ax < 0x3FF0000000000000) {   # 2^-26 ≤ |x| < 1
        var hi, lo, err = _bj_k_asin_core(x);
        var u: f64 = hi + (lo - err);
        var v: f64 = hi + (lo + err);
        if (u == v) {
            if (x < 0.0) { u = -u; }
            return u;
        }
        var a: f64 = _bj_k_cr_asin_acc(x);
        return a;
    }
    var r, ok = _bj_k_asin_special(x);
    return r;
}
