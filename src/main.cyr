# bijli — Cyrius port
# Ported from 22696 lines of Rust

# Stdlib auto-included via cyrius.cyml

# Entry point of the scaffold binary: initialises the heap and prints a readiness line.
fn main() {
    alloc_init();
    println("bijli ready");
    return 0;
}

var r = main();
# sys_exit_group, not syscall(SYS_EXIT, ...): SYS_EXIT ends only the calling
# thread, so the bare syscall hangs once this program spawns its first worker.
sys_exit_group(r);
