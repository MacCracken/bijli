# beam.cyr — beam.rs (M3 part 1c-1): Gaussian beams, ABCD ray transfer matrices, resonator stability, and the
# higher-order Hermite–Gaussian and Laguerre–Gaussian modes. SI units: wavelengths and distances in metres.
#
# - BjGaussianBeam.wavelength is the wavelength in the medium the beam propagates in (λ₀/n). The complex beam
#   parameter is q = (z − z_waist) + j·z_R with z_R = πw₀²/λ.
# - ABCD matrices act on (height, actual ray angle), so a system that ends in another medium has det = n_in/n_out,
#   and its output wavelength is λ_out = λ_in·det.
# - The time convention is bijli's one, e^{+jωt} (src/complex.cyr's header; ADR 0002 row 5, D3): a mode field is
#   ∝ e^{−jkz}, as Siegman's *Lasers* writes it. beam.rs wrote the complex field in e^{−iωt}, so
#   bj_hermite_gaussian_field is its complex conjugate. Every other value here is real or convention-free: q = z + j·z_R
#   is already Siegman's form (1/q = 1/R − jλ/(πw²)), so q, its ABCD propagation and the transformed beams keep Rust's
#   numbers, and the Gouy phase ζ(z) = arctan(z/z_R) is a geometric angle.
#
# The resonators decide their stability exactly and compute w₀ without cancellation (ADR 0002 row 34, M3 part 2a-2,
# the user's answer of 2026-11-14): 0 ≤ (1 − L/R₁)(1 − L/R₂) ≤ 1 on the exact value, and w₀ from the inputs' own
# differences and sums, where Rust's g = 1 − L/R rounded L/R's digits away near the planar edge.
#
# Mode indices are Rust's: m, n and p are u32 (0 ≤ m < 2³²) and l is an i32. The polynomials are their recurrences
# in Rust's order; exp and atan are correctly rounded (src/crmath.cyr), and so are acos and sqrt.

private

# std::f64::consts::SQRT_2.
var _BJ_BEAM_SQRT_2: f64 = 0x3FF6A09E667F3BCD;

# ── the Gaussian beam ───────────────────────────────────────────────────────────────────────────────────────────

# A fundamental Gaussian beam at a reference plane: its wavelength λ in the medium (m), its waist radius w₀ (the 1/e²
# intensity radius at the focus, m) and its Rayleigh range z_R = πw₀²/λ (m). Mirrors `GaussianBeam`.
public struct BjGaussianBeam {
    wavelength: f64;
    waist: f64;
    rayleigh_range: f64;
}

# Records InvalidParameter "<head>{v}<tail>", v in Rust's Display form. Returns the code.
fn _bj_beam_bad(head, v: f64, tail): i64 {
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, head);
    _bj_fmt_f64_display(t, v);
    _bj_tx_cstr(t, tail);
    return BJ_ERR_INVALID_PARAMETER;
}

# 1 when x is finite and positive.
#must_use
fn _bj_beam_pos(x: f64): i64 {
    if (_bj_is_finite(x) == 1 && x > 0.0) { return 1; }
    return 0;
}

# A Gaussian beam of wavelength λ (in the medium) and waist w₀ into *out: Ok(0), or Err(InvalidParameter) with out
# untouched unless both are positive and finite and z_R = πw₀²/λ is positive and finite. z_R is rounded once (ADR 0002
# row 13, M3 part 2b): Rust's three roundings overflowed at λ = 1e10, w₀ = 1e155 for 3e300, and underflowed at
# λ = 5e-324, w₀ = 1e-162 to 1.0 for 0.63. Mirrors `GaussianBeam::new`.
#must_use
public fn BjGaussianBeam_new(wavelength: f64, waist: f64, out: *BjGaussianBeam): Result {
    if (_bj_beam_pos(wavelength) == 0) {
        return Err(_bj_beam_bad("wavelength must be positive and finite, got ", wavelength, ""));
    }
    if (_bj_beam_pos(waist) == 0) {
        return Err(_bj_beam_bad("beam waist must be positive and finite, got ", waist, ""));
    }
    var zn: f64[3];
    var zd: f64[1];
    zn[0] = _BJ_PI;
    zn[1] = waist;
    zn[2] = waist;
    zd[0] = wavelength;
    var zr: f64 = _bj_cr_mono_wide(&zn, 3, &zd, 1);
    if (_bj_beam_pos(zr) == 0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "Rayleigh range πw₀²/λ = ");
        _bj_fmt_f64_display(t, zr);
        _bj_tx_cstr(t, " is not representable (w₀ = ");
        _bj_fmt_f64_display(t, waist);
        _bj_tx_cstr(t, ", λ = ");
        _bj_fmt_f64_display(t, wavelength);
        _bj_tx_cstr(t, ")");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (_bj_log_on(4) == 1) {
        var lb[200];
        var lt[24];
        _bj_tx_init(&lt, &lb, 200);
        _bj_tx_cstr(&lt, "Gaussian beam created wavelength=");
        _bj_fmt_f64_debug(&lt, wavelength);
        _bj_tx_cstr(&lt, " waist=");
        _bj_fmt_f64_debug(&lt, waist);
        _bj_tx_cstr(&lt, " rayleigh_range=");
        _bj_fmt_f64_debug(&lt, zr);
        _bj_log_text(4, &lt);
    }
    out.wavelength = wavelength;
    out.waist = waist;
    out.rayleigh_range = zr;
    return Ok(0);
}

impl BjGaussianBeam {
    # The complex beam parameter q(z) = z + j·z_R, z the distance from the waist: (Re q, Im q). Mirrors
    # `GaussianBeam::q`.
    #must_use
    public fn q(self, z: f64): (f64, f64) {
        var zr: f64 = self.rayleigh_range;
        return (z, zr);
    }

    # w(z) = w₀·√(1 + (z/z_R)²), the 1/e² intensity radius at distance z from the waist. Mirrors
    # `GaussianBeam::spot_size`.
    #must_use
    public fn spot_size(self, z: f64): f64 {
        var ratio: f64 = z / self.rayleigh_range;
        var root: f64 = f64_sqrt(1.0 + ratio * ratio);
        var w: f64 = self.waist * root;
        return w;
    }

    # R(z) = z·(1 + (z_R/z)²), the wavefront's radius of curvature; InvalidParameter at the waist (|z| < 1e-30, where
    # R is infinite). Mirrors `GaussianBeam::radius_of_curvature`.
    #must_use
    public fn radius_of_curvature(self, z: f64): Result {
        var az: f64 = f64_abs(z);
        if (az < 0.000000000000000000000000000001) {
            _bj_tx_cstr(_bj_err_reason(BJ_ERR_INVALID_PARAMETER), "radius of curvature is infinite at the beam waist");
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        var ratio: f64 = self.rayleigh_range / z;
        var r: f64 = z * (1.0 + ratio * ratio);
        return Ok(r);
    }

    # ζ(z) = arctan(z/z_R), the Gouy phase at distance z from the waist (a geometric angle, convention-free). Mirrors
    # `GaussianBeam::gouy_phase`.
    #must_use
    public fn gouy_phase(self, z: f64): f64 {
        var a: f64 = _bj_atan(z / self.rayleigh_range);
        return a;
    }

    # θ = λ/(πw₀), the far-field half-angle divergence, rounded once for finite fields and a nonzero waist (ADR 0002
    # row 13; Rust's two roundings otherwise). Mirrors `GaussianBeam::divergence`.
    #must_use
    public fn divergence(self): f64 {
        var lam: f64 = self.wavelength;
        var w0: f64 = self.waist;
        var dl: f64 = (lam - lam) + (w0 - w0);
        if (dl == 0.0 && w0 != 0.0) {
            var dn: f64[1];
            var dd: f64[2];
            dn[0] = lam;
            dd[0] = _BJ_PI;
            dd[1] = w0;
            var cr: f64 = _bj_cr_mono_wide(&dn, 1, &dd, 2);
            return cr;
        }
        var d: f64 = lam / (_BJ_PI * w0);
        return d;
    }

    # 2/(πw(z)²), the factor that multiplies the total power P to give the peak intensity I₀ = 2P/(πw²). Mirrors
    # `GaussianBeam::peak_intensity_factor`.
    #must_use
    public fn peak_intensity_factor(self, z: f64): f64 {
        var w: f64 = self.spot_size(z);
        var f: f64 = 2.0 / (_BJ_PI * w * w);
        return f;
    }

    # b = 2z_R, the confocal parameter. Mirrors `GaussianBeam::confocal_parameter`.
    #must_use
    public fn confocal_parameter(self): f64 {
        var b: f64 = 2.0 * self.rayleigh_range;
        return b;
    }

    # 2z_R, the depth of focus (where the spot grows by √2). Mirrors `GaussianBeam::depth_of_focus`.
    #must_use
    public fn depth_of_focus(self): f64 {
        var d: f64 = 2.0 * self.rayleigh_range;
        return d;
    }
}

# ── ABCD matrices ───────────────────────────────────────────────────────────────────────────────────────────────

# ── the exact determinant (ADR 0002 row 35, M3 part 2a-3) ──
# transform_beam decides det > 0 and det = 1 on the exact AD − BC of finite entries, and takes λ·det rounded once from
# it, where Rust tested the rounded AD − BC and kept λ within 10⁻¹² of 1. The products are integers (each a product of
# two significands, at most 106 bits, times a power of two) in src/fmtf.cyr's bignums (word 0 the limb count, then
# 32-bit limbs; 41 words, 1,280 bits). A product more than 220 bits below the other only decides roundings as a sticky
# bit, so it becomes a unit 230 bits below the other: every shift stays under 330 bits and every value under 2^500.

# |x₁·x₂| as a bignum into dst, for finite x₁, x₂ (t scratch): (its exponent, its sign −1, 0 or 1).
fn _bj_beam_prod(x1: f64, x2: f64, dst, t): (i64, i64) {
    if (x1 == 0.0 || x2 == 0.0) {
        store64(dst, 0);
        return (0, 0);
    }
    var me1: i64[2];
    var me2: i64[2];
    _bj_g_split(x1, &me1);
    _bj_g_split(x2, &me2);
    _bj_bn_set(dst, me1[0]);
    _bj_g_mul(dst, me2[0], t);
    var s = 1;
    if (x1 < 0.0) { s = 0 - s; }
    if (x2 < 0.0) { s = 0 - s; }
    return (me1[1] + me2[1], s);
}

# 1 when x is 0 or 2^-450 ≤ |x| ≤ 2^450 (TwoProduct is exact on two such, and their product is 0 or at least 2^-900).
#must_use
fn _bj_beam_mid(x: f64): i64 {
    var u = _bj_bits(x) & 0x7FFFFFFFFFFFFFFF;
    if (u == 0) { return 1; }
    if (u < 0x23D0000000000000 || u > 0x5C10000000000000) { return 0; }
    return 1;
}

# _bj_beam_det35's fast path, for entries 0 or of magnitude in [2^-450, 2^450]: AD − BC as Shewchuk's exact expansion
# of p₁ + e₁ − p₂ − e₂ (TwoProduct; crmath_gamma's _bj_g_grow), whose sign is its largest component's and which is 1
# when it less 1 is empty. λ·det from the compressed top two components (within 2^-104) times |λ| (_bj_k_dd_mul_d,
# 3.01u²): kimiya's rounding test (_bj_k_dd_round_ends, a 32u² budget) proves the correctly rounded value. The same
# results as the exact path, which takes over (2, 0) where this declines: an entry outside the range, |λ·det| outside
# [2^-900, 2^900], or a value within about 2^-100 of a midpoint.
#must_use
fn _bj_beam_det35_fast(a: f64, b: f64, c: f64, d: f64, lam: f64, out: *f64): (i64, i64) {
    if (_bj_beam_mid(a) == 0 || _bj_beam_mid(b) == 0 || _bj_beam_mid(c) == 0 || _bj_beam_mid(d) == 0) {
        return (2, 0);
    }
    var p1, e1 = _bj_cr_two_prod(a, d);
    var p2, e2 = _bj_cr_two_prod(b, c);
    var p1v: f64 = p1;
    var e1v: f64 = e1;
    var np2: f64 = -p2;
    var ne2: f64 = -e2;
    var ex: f64[8];
    var k = _bj_g_grow(&ex, 0, e1v);
    k = _bj_g_grow(&ex, k, ne2);
    k = _bj_g_grow(&ex, k, p1v);
    k = _bj_g_grow(&ex, k, np2);
    if (k == 0) { return (0, 0); }
    var top: f64 = ex[k - 1];
    if (top < 0.0) { return (0 - 1, 0); }
    var ey: f64[8];
    for (var j = 0; j < k; j = j + 1) { ey[j] = ex[j]; }
    if (_bj_g_grow(&ey, k, -1.0) == 0) { return (1, 1); }
    var dl: f64 = lam - lam;
    if (lam == 0.0 || dl != 0.0) { return (1, 0); }
    var al: f64 = f64_abs(lam);
    var dh, dlo = _bj_g_compress(&ex, k);
    var dhv: f64 = dh;
    var pp: f64 = dhv * al;
    var pu = _bj_bits(pp) & 0x7FFFFFFFFFFFFFFF;
    if (_bj_beam_mid(al) == 0 || pu < 0x07B0000000000000 || pu > 0x7830000000000000) { return (2, 0); }
    var h, l = _bj_k_dd_mul_d(dhv, dlo, al);
    var z1, z2 = _bj_k_dd_round_ends(h, l);
    var z1v: f64 = z1;
    var z2v: f64 = z2;
    if (z1v != z2v) { return (2, 0); }
    if (lam < 0.0) { z1v = -z1v; }
    out[0] = z1v;
    return (1, 0);
}

# The exact AD − BC of finite a, b, c, d: (its sign −1, 0 or 1; 1 when it is exactly 1), and, when it is positive and
# not 1, RN(λ·(AD − BC)) into out[0] for a finite nonzero λ: λ's significand times the determinant, its top 60 bits
# and a sticky bit for the rest, rounded once by kimiya's _bj_k_cr_from_int (the subnormal grid, ties to even, +∞
# past DBL_MAX). out is untouched otherwise. The fast path (_bj_beam_det35_fast) answers first where it can.
#must_use
fn _bj_beam_det35(a: f64, b: f64, c: f64, d: f64, lam: f64, out: *f64): (i64, i64) {
    var fs, fo = _bj_beam_det35_fast(a, b, c, d, lam, out);
    if (fs != 2) { return (fs, fo); }
    var xb: i64[41];
    var yb: i64[41];
    var tb: i64[41];
    var vb: i64[41];
    var ex, sx = _bj_beam_prod(a, d, &xb, &tb);
    var ey, sy = _bj_beam_prod(b, c, &yb, &tb);
    if (sx != 0 && sy != 0) {
        var tx = ex + _bj_g_bitlen(&xb);
        var ty = ey + _bj_g_bitlen(&yb);
        if (tx - ty > 220) {
            _bj_bn_set(&yb, 1);
            ey = tx - 230;
        } elif (ty - tx > 220) {
            _bj_bn_set(&xb, 1);
            ex = ty - 230;
        }
    }
    if (sx == 0 && sy == 0) { return (0, 0); }
    var k = ex;
    if (sx == 0 || (sy != 0 && ey < ex)) { k = ey; }
    if (sx != 0) { _bj_bn_shl(&xb, ex - k); }
    if (sy != 0) { _bj_bn_shl(&yb, ey - k); }
    var sgn = 0;
    if (sy == 0) {
        _bj_bn_copy(&vb, &xb);
        sgn = sx;
    } elif (sx == 0) {
        _bj_bn_copy(&vb, &yb);
        sgn = 0 - sy;
    } elif (sx != sy) {
        _bj_bn_sum(&vb, &xb, &yb);
        sgn = sx;
    } else {
        var cm = _bj_bn_cmp(&xb, &yb);
        if (cm == 0) { return (0, 0); }
        if (cm > 0) {
            _bj_bn_copy(&vb, &xb);
            _bj_bn_sub(&vb, &yb);
            sgn = sx;
        } else {
            _bj_bn_copy(&vb, &yb);
            _bj_bn_sub(&vb, &xb);
            sgn = 0 - sx;
        }
    }
    if (sgn < 0) { return (0 - 1, 0); }
    var nb = _bj_g_bitlen(&vb);
    if (k <= 0 && nb == 1 - k && _bj_bn_any_below(&vb, 0 - k) == 0) { return (1, 1); }
    var dl: f64 = lam - lam;
    if (lam == 0.0 || dl != 0.0) { return (1, 0); }
    var mel: i64[2];
    _bj_g_split(lam, &mel);
    _bj_g_mul(&vb, mel[0], &tb);
    var e2 = k + mel[1];
    var n = _bj_g_bitlen(&vb);
    var mm = _bj_g_limb(&vb, 0) | (_bj_g_limb(&vb, 1) << 32);
    var s = e2;
    if (n > 61) {
        var sh = n - 60;
        _bj_bn_copy(&tb, &vb);
        _bj_bn_shr(&tb, sh);
        var top = _bj_g_limb(&tb, 0) | (_bj_g_limb(&tb, 1) << 32);
        mm = 2 * top + _bj_bn_any_below(&vb, sh);
        s = e2 + sh - 1;
    }
    var r: f64 = _bj_k_cr_from_int(mm, s);
    if (lam < 0.0) { r = -r; }
    out[0] = r;
    return (1, 0);
}

# A paraxial ray transfer matrix acting on (y, θ): y' = A·y + B·θ, θ' = C·y + D·θ. Mirrors `AbcdMatrix`.
public struct BjAbcdMatrix {
    a: f64;
    b: f64;
    c: f64;
    d: f64;
}

# The matrix (A, B; C, D). Mirrors `AbcdMatrix::new`.
#must_use
#pure
public fn BjAbcdMatrix_new(a: f64, b: f64, c: f64, d: f64): BjAbcdMatrix {
    var m: BjAbcdMatrix;
    m.a = a;
    m.b = b;
    m.c = c;
    m.d = d;
    return m;
}

# The identity (no element). Mirrors `AbcdMatrix::identity`.
#must_use
#pure
public fn BjAbcdMatrix_identity(): BjAbcdMatrix {
    var m: BjAbcdMatrix = BjAbcdMatrix_new(1.0, 0.0, 0.0, 1.0);
    return m;
}

# The identity. Mirrors `Default for AbcdMatrix`.
#must_use
#pure
public fn BjAbcdMatrix_default(): BjAbcdMatrix {
    var m: BjAbcdMatrix = BjAbcdMatrix_new(1.0, 0.0, 0.0, 1.0);
    return m;
}

# Free space of length d: (1, d; 0, 1). Mirrors `AbcdMatrix::free_space`.
#must_use
#pure
public fn BjAbcdMatrix_free_space(distance: f64): BjAbcdMatrix {
    var m: BjAbcdMatrix = BjAbcdMatrix_new(1.0, distance, 0.0, 1.0);
    return m;
}

# Records DivisionByZero with Rust's context. Returns the code.
fn _bj_beam_dz(context): i64 {
    return _bj_err_division_by_zero(context);
}

# A thin lens of focal length f (positive converging, negative diverging) into *out: (1, 0; −1/f, 1).
# InvalidParameter for a NaN f, DivisionByZero when |f| < 1e-30. Mirrors `AbcdMatrix::thin_lens`.
#must_use
public fn BjAbcdMatrix_thin_lens(focal_length: f64, out: *BjAbcdMatrix): Result {
    if (focal_length != focal_length) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_INVALID_PARAMETER), "focal length must not be NaN");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var af: f64 = f64_abs(focal_length);
    if (af < 0.000000000000000000000000000001) { return Err(_bj_beam_dz("focal length cannot be zero")); }
    var c: f64 = -1.0 / focal_length;
    out.a = 1.0;
    out.b = 0.0;
    out.c = c;
    out.d = 1.0;
    return Ok(0);
}

# A curved mirror of radius R (concave R > 0 focuses), a thin lens of f = R/2, into *out: (1, 0; −2/R, 1).
# InvalidParameter for a NaN R, DivisionByZero when |R| < 1e-30. Mirrors `AbcdMatrix::curved_mirror`.
#must_use
public fn BjAbcdMatrix_curved_mirror(radius: f64, out: *BjAbcdMatrix): Result {
    if (radius != radius) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_INVALID_PARAMETER), "mirror radius must not be NaN");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var ar: f64 = f64_abs(radius);
    if (ar < 0.000000000000000000000000000001) { return Err(_bj_beam_dz("mirror radius cannot be zero")); }
    var c: f64 = -2.0 / radius;
    out.a = 1.0;
    out.b = 0.0;
    out.c = c;
    out.d = 1.0;
    return Ok(0);
}

# A flat interface from index n₁ to n₂ into *out: (1, 0; 0, n₁/n₂). InvalidParameter for a NaN index,
# DivisionByZero when |n₂| < 1e-30. Mirrors `AbcdMatrix::flat_interface`.
#must_use
public fn BjAbcdMatrix_flat_interface(n1: f64, n2: f64, out: *BjAbcdMatrix): Result {
    if (n1 != n1 || n2 != n2) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_INVALID_PARAMETER), "refractive indices must not be NaN");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var a2: f64 = f64_abs(n2);
    if (a2 < 0.000000000000000000000000000001) { return Err(_bj_beam_dz("refractive index n₂ cannot be zero")); }
    var d: f64 = n1 / n2;
    out.a = 1.0;
    out.b = 0.0;
    out.c = 0.0;
    out.d = d;
    return Ok(0);
}

# A curved interface of radius R (R > 0 with the centre of curvature on the transmission side) from n₁ to n₂ into
# *out: (1, 0; (n₁ − n₂)/(n₂R), n₁/n₂). InvalidParameter for a NaN input, DivisionByZero when |n₂| < 1e-30 or
# |R| < 1e-30. Mirrors `AbcdMatrix::curved_interface`.
#must_use
public fn BjAbcdMatrix_curved_interface(n1: f64, n2: f64, radius: f64, out: *BjAbcdMatrix): Result {
    if (n1 != n1 || n2 != n2 || radius != radius) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_INVALID_PARAMETER), "refractive indices and radius must not be NaN");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var a2: f64 = f64_abs(n2);
    if (a2 < 0.000000000000000000000000000001) { return Err(_bj_beam_dz("refractive index n₂ cannot be zero")); }
    var ar: f64 = f64_abs(radius);
    if (ar < 0.000000000000000000000000000001) { return Err(_bj_beam_dz("interface radius cannot be zero")); }
    var c: f64 = (n1 - n2) / (n2 * radius);
    var d: f64 = n1 / n2;
    out.a = 1.0;
    out.b = 0.0;
    out.c = c;
    out.d = d;
    return Ok(0);
}

impl BjAbcdMatrix {
    # (A·y + B·θ, C·y + D·θ), the ray (y, θ) after this element. Mirrors `AbcdMatrix::apply_ray`.
    #must_use
    public fn apply_ray(self, y: f64, theta: f64): (f64, f64) {
        var y2: f64 = self.a * y + self.b * theta;
        var t2: f64 = self.c * y + self.d * theta;
        return (y2, t2);
    }

    # self × other: other first, then self. Mirrors `AbcdMatrix::compose`.
    #must_use
    public fn compose(self, other: *BjAbcdMatrix): BjAbcdMatrix {
        var m: BjAbcdMatrix;
        m.a = self.a * other.a + self.b * other.c;
        m.b = self.a * other.b + self.b * other.d;
        m.c = self.c * other.a + self.d * other.c;
        m.d = self.c * other.b + self.d * other.d;
        return m;
    }

    # AD − BC: 1 in one medium, n₁/n₂ across media. Mirrors `AbcdMatrix::determinant`.
    #must_use
    public fn determinant(self): f64 {
        var det: f64 = self.a * self.d - self.b * self.c;
        return det;
    }

    # q_out = (A·q + B)/(C·q + D) for q = q_re + j·q_im into out[0], out[1]: Ok(0), or DivisionByZero when
    # |C·q + D|² < 1e-60 (a NaN passes, as Rust's test). Mirrors `AbcdMatrix::propagate_beam`.
    #must_use
    public fn propagate_beam(self, q_re: f64, q_im: f64, out: *f64): Result {
        var num_re: f64 = self.a * q_re + self.b;
        var num_im: f64 = self.a * q_im;
        var den_re: f64 = self.c * q_re + self.d;
        var den_im: f64 = self.c * q_im;
        var den_sq: f64 = den_re * den_re + den_im * den_im;
        if (den_sq < 0.000000000000000000000000000000000000000000000000000000000001) {
            return Err(_bj_beam_dz("ABCD beam propagation denominator is zero"));
        }
        var r0: f64 = (num_re * den_re + num_im * den_im) / den_sq;
        var r1: f64 = (num_im * den_re - num_re * den_im) / den_sq;
        out[0] = r0;
        out[1] = r1;
        return Ok(0);
    }

    # The output beam into *out, and the signed distance from the output plane to its waist into *distance, for an
    # input beam whose waist lies at the input plane. q_out = (A·j z_R + B)/(C·j z_R + D); z_R′ = Im q_out;
    # λ′ = λ·det rounded once from the exact AD − BC (λ kept only when it is exactly 1; a zero, infinite or NaN λ as it
    # is), w₀′ = √(z_R′λ′/π); distance = −Re q_out (positive downstream: a converging beam). InvalidParameter when the
    # exact det of finite entries isn't positive (Rust's rounded det isn't positive and finite, for another), the
    # reason quoting the rounded det, or when z_R′ isn't positive and finite; DivisionByZero when C·q + D = 0; and
    # BjGaussianBeam_new's errors. out and distance are untouched by an error. ADR 0002 row 35: Rust tested the rounded
    # det and kept λ within 10⁻¹² of 1. Mirrors `AbcdMatrix::transform_beam_with_waist_position`.
    #must_use
    public fn transform_beam_with_waist_position(self, beam: *BjGaussianBeam, out: *BjGaussianBeam,
      distance: *f64): Result {
        var det: f64 = self.determinant();
        var pos = _bj_beam_pos(det);
        var exact = _bj_vx_finite4(self.a, self.b, self.c, self.d);
        var lx: f64[1];
        lx[0] = beam.wavelength;
        var one = 0;
        if (exact == 1) {
            var dsg, dn = _bj_beam_det35(self.a, self.b, self.c, self.d, beam.wavelength, &lx);
            pos = 0;
            if (dsg > 0) { pos = 1; }
            one = dn;
        }
        if (pos == 0) {
            return Err(_bj_beam_bad("ABCD determinant must be positive and finite (det = n_in/n_out), got ", det, ""));
        }
        var qo: f64[2];
        var zr: f64 = beam.rayleigh_range;
        var t, v = self.propagate_beam(0.0, zr, &qo);
        if (is_err_result(t) == 1) { return Err(v); }
        var zr2: f64 = qo[1];
        if (_bj_beam_pos(zr2) == 0) {
            _bj_tx_cstr(_bj_err_reason(BJ_ERR_INVALID_PARAMETER), "transformed beam has non-physical Rayleigh range");
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        var lam: f64 = beam.wavelength;
        if (exact == 1) {
            if (one == 0) { lam = lx[0]; }
        } else {
            var dd: f64 = f64_abs(det - 1.0);
            if (dd > 0.000000000001) { lam = beam.wavelength * det; }
        }
        var w0: f64 = f64_sqrt(zr2 * lam / _BJ_PI);
        var nb: BjGaussianBeam;
        var t2, v2 = BjGaussianBeam_new(lam, w0, &nb);
        if (is_err_result(t2) == 1) { return Err(v2); }
        var d: f64 = -qo[0];
        out.wavelength = nb.wavelength;
        out.waist = nb.waist;
        out.rayleigh_range = nb.rayleigh_range;
        distance[0] = d;
        return Ok(0);
    }

    # The output beam into *out for an input beam whose waist lies at the input plane, as
    # transform_beam_with_waist_position without the waist's position. Mirrors `AbcdMatrix::transform_beam`.
    #must_use
    public fn transform_beam(self, beam: *BjGaussianBeam, out: *BjGaussianBeam): Result {
        var d: f64[1];
        var t, v = self.transform_beam_with_waist_position(beam, out, &d);
        if (is_err_result(t) == 1) { return Err(v); }
        return Ok(0);
    }
}

# ── resonators ──────────────────────────────────────────────────────────────────────────────────────────────────

# A two-mirror cavity's stability: g₁ = 1 − L/R₁, g₂ = 1 − L/R₂, their product, and whether 0 ≤ g₁g₂ ≤ 1 (1 stable,
# 0 not). Mirrors `ResonatorStability`.
public struct BjResonatorStability {
    g1: f64;
    g2: f64;
    g_product: f64;
    is_stable;
}

# ── the exact edges (ADR 0002 row 34) ──

# 1 when 0 ≤ (1 − L/R₁)(1 − L/R₂) ≤ 1 in exact value, else 0, for a positive finite L and radii neither NaN nor below
# 1e-30 in magnitude (±∞ is a flat mirror, L/R = 0). With a = L/R₁, b = L/R₂:
# - the product is ≥ 0 when its factors' signs don't differ: 1 − L/R is positive for a convex (R < 0) or flat mirror
#   and for R > L, 0 at R = L, negative for 0 < R < L;
# - it is ≤ 1 when ab ≤ a + b: always for two flat mirrors, for R > 0 with one, and otherwise L ≤ R₁ + R₂ where
#   R₁R₂ > 0, L ≥ R₁ + R₂ where R₁R₂ < 0 (the inequality times R₁R₂/L). L is compared with s = RN(R₁ + R₂), and at
#   L = s with TwoSum's exact error t: s is the double nearest R₁ + R₂, so a double L other than s lies on the same
#   side of R₁ + R₂ as of s; an s past DBL_MAX is past every finite L.
#must_use
fn _bj_beam_stable34(length: f64, r1: f64, r2: f64): i64 {
    var s1 = 1;
    if (r1 > 0.0 && r1 < length) { s1 = 0 - 1; }
    if (r1 == length) { s1 = 0; }
    var s2 = 1;
    if (r2 > 0.0 && r2 < length) { s2 = 0 - 1; }
    if (r2 == length) { s2 = 0; }
    if (s1 * s2 < 0) { return 0; }
    var d1: f64 = r1 - r1;
    var d2: f64 = r2 - r2;
    if (d1 != 0.0 || d2 != 0.0) {
        if (d1 != 0.0 && d2 != 0.0) { return 1; }
        if (d1 != 0.0 && r2 > 0.0) { return 1; }
        if (d2 != 0.0 && r1 > 0.0) { return 1; }
        return 0;
    }
    var s: f64 = r1 + r2;
    var c = 0;
    if (s - s != 0.0) {
        c = 1;
        if (s > 0.0) { c = 0 - 1; }
    } elif (length < s) { c = 0 - 1; }
    elif (length > s) { c = 1; }
    else {
        var bb: f64 = s - r1;
        var tt: f64 = (r1 - (s - bb)) + (r2 - bb);
        if (tt > 0.0) { c = 0 - 1; }
        if (tt < 0.0) { c = 1; }
    }
    if ((r1 > 0.0 && r2 > 0.0) || (r1 < 0.0 && r2 < 0.0)) {
        if (c <= 0) { return 1; }
        return 0;
    }
    if (c >= 0) { return 1; }
    return 0;
}

# 1 when 0 ≤ g₁·g₂ ≤ 1 in exact value, else 0, for finite g₁, g₂ with gp = RN(g₁·g₂): the sign from the factors' (a
# product that underflows keeps it), then gp's side of 1 (gp is the double nearest the product, and 1 is a double),
# but at gp = 1, where the exact sign of g₁g₂ − 1 decides (src/crmath_cmp.cyr's _bj_x_sign).
#must_use
fn _bj_beam_gg_ok(g1: f64, g2: f64, gp: f64): i64 {
    if ((g1 < 0.0 && g2 > 0.0) || (g1 > 0.0 && g2 < 0.0)) { return 0; }
    if (gp > 1.0) { return 0; }
    if (gp < 1.0) { return 1; }
    var tm: i64[14];
    _bj_x_put2(&tm, 0, g1, g2, 0, 0);
    _bj_x_put2(&tm, 1, 1.0, 1.0, 0, 1);
    if (_bj_x_sign(&tm, 2) > 0) { return 0; }
    return 1;
}

# a + b + c, within about an ulp and a half, and the exact sum rounded once where it cancels: s₁ + t₁ = a + b and
# s₂ + t₂ = s₁ + c exactly (TwoSum), then s₂ + (t₁ + t₂). Where s₁ and c cancel, s₁ + c is exact (Sterbenz), so t₂ = 0
# and the result is RN(s₂ + t₁); elsewhere nothing cancels. The callers keep |a| + |b| + |c| below 2^1023.
#must_use
fn _bj_beam_sum3(a: f64, b: f64, c: f64): f64 {
    var s1, t1 = _bj_k_two_sum(a, b);
    var s1v: f64 = s1;
    var t1v: f64 = t1;
    var s2, t2 = _bj_k_two_sum(s1v, c);
    var s2v: f64 = s2;
    var t2v: f64 = t2;
    var tt: f64 = t1v + t2v;
    var r: f64 = s2v + tt;
    return r;
}

# 2^1020: a cavity whose L or finite radius reaches it is scaled by 2^-4 for w₀'s sums.
var _BJ_BEAM_2P1020: f64 = 0x7FB0000000000000;

# w₀ for a stable cavity that is neither planar nor confocal: w₀² = (λ/π)·√(L(R₁ − L)(R₂ − L)(R₁ + R₂ − L))/
# |R₁ + R₂ − 2L| (Kogelnik and Li: g₁g₂(1 − g₁g₂) and g₁ + g₂ − 2g₁g₂ written in the inputs), or (λ/π)·√(L(R − L)) with
# one flat mirror (the limit as the other R → ∞). Each factor is a difference or a compensated sum of the inputs, so
# none cancels; past 2^1020 they are summed scaled by 2^-4 (the form is homogeneous, and the scale comes back exactly
# in the exponent). The products run with an unbounded exponent (kimiya's _bj_k_ux_*, _bj_beam_waist34_ux), and w₀ is
# rounded once: within one ulp of the exact value on every golden row (validate.py's bound is four). The fast path
# runs the same operations on doubles: where every result is normal (kimiya's _bj_k_ux_normal) each is the same
# 53-bit rounding of the same exact value, so the bits are the unbounded chain's, and only an edge takes the slow
# path. (w₀, 1), or (0, 0) where R₁ + R₂ − 2L is 0 (only the confocal and planar cavities, which the caller has taken).
#must_use
fn _bj_beam_waist34(length: f64, r1: f64, r2: f64, wavelength: f64): (f64, i64) {
    var d1: f64 = r1 - r1;
    var d2: f64 = r2 - r2;
    var mx: f64 = length;
    var x1: f64 = f64_abs(r1);
    var x2: f64 = f64_abs(r2);
    if (d1 == 0.0 && x1 > mx) { mx = x1; }
    if (d2 == 0.0 && x2 > mx) { mx = x2; }
    var k = 0;
    var sc: f64 = 1.0;
    if (mx >= _BJ_BEAM_2P1020) {
        k = 4;
        sc = 0.0625;
    }
    var l: f64 = length * sc;
    var a: f64 = r1 * sc;
    var b: f64 = r2 * sc;
    var lp: f64 = wavelength / _BJ_PI;
    if (d1 != 0.0 || d2 != 0.0) {
        var rf: f64 = a;
        if (d1 != 0.0) { rf = b; }
        var fv: f64 = rf - l;
        var fa: f64 = f64_abs(fv);
        var p1: f64 = length * fa;
        var q1: f64 = f64_sqrt(p1);
        var w1: f64 = q1 * lp;
        var okf = 0;
        if (_bj_k_ux_normal(lp) == 1 && _bj_k_ux_normal(p1) == 1) { okf = 1; }
        if (okf == 1 && _bj_k_ux_normal(q1) == 1 && _bj_k_ux_normal(w1) == 1) {
            var r1v: f64 = f64_sqrt(w1);
            if (k == 4) { r1v = 2.0 * r1v; }
            return (r1v, 1);
        }
        var u1: f64 = _bj_beam_waist34_ux(length, fa, 1.0, 1.0, 1.0, wavelength, k, 1);
        return (u1, 1);
    }
    var f1: f64 = a - l;
    var f2: f64 = b - l;
    var nl: f64 = -l;
    var f3: f64 = _bj_beam_sum3(a, b, nl);
    var l2: f64 = 2.0 * l;
    var n2l: f64 = -l2;
    var f4: f64 = _bj_beam_sum3(a, b, n2l);
    if (f4 == 0.0) { return (0.0, 0); }
    var a1: f64 = f64_abs(f1);
    var a2: f64 = f64_abs(f2);
    var a3: f64 = f64_abs(f3);
    var a4: f64 = f64_abs(f4);
    var m1: f64 = length * a1;
    var m2: f64 = m1 * a2;
    var m3: f64 = m2 * a3;
    var rt: f64 = f64_sqrt(m3);
    var nm: f64 = rt * lp;
    var w2: f64 = nm / a4;
    var ok = 0;
    if (_bj_k_ux_normal(lp) == 1 && _bj_k_ux_normal(m1) == 1 && _bj_k_ux_normal(m2) == 1 && _bj_k_ux_normal(m3) == 1) {
        ok = 1;
    }
    if (ok == 1 && _bj_k_ux_normal(rt) == 1 && _bj_k_ux_normal(nm) == 1 && _bj_k_ux_normal(w2) == 1) {
        var r2v: f64 = f64_sqrt(w2);
        if (k == 4) { r2v = 2.0 * r2v; }
        return (r2v, 1);
    }
    var u2: f64 = _bj_beam_waist34_ux(length, a1, a2, a3, a4, wavelength, k, 0);
    return (u2, 1);
}

# _bj_beam_waist34's slow path, its chain with an unbounded exponent for the factors' magnitudes f₁ … f₄ (sums scaled
# by 2^-k): Q = √(L·f₁·f₂·f₃) (flat = 1: √(L·f₁)), W = Q·(λ/π) (/f₄ unless flat), w₀ = √(W·2^(k/2)) rounded once into
# binary64; 0 for a zero factor.
#must_use
fn _bj_beam_waist34_ux(length: f64, f1: f64, f2: f64, f3: f64, f4: f64, wavelength: f64, k, flat): f64 {
    var lms, lme = _bj_k_ux_from(wavelength);
    var pis, pie = _bj_k_ux_from(_BJ_PI);
    var lps, lpe = _bj_k_ux_div(lms, lme, pis, pie);
    var lns, lne = _bj_k_ux_from(length);
    var u1s, u1e = _bj_k_ux_from(f1);
    var ps, pe = _bj_k_ux_mul(lns, lne, u1s, u1e);
    if (flat == 0) {
        var u2s, u2e = _bj_k_ux_from(f2);
        var u3s, u3e = _bj_k_ux_from(f3);
        var m2s, m2e = _bj_k_ux_mul(ps, pe, u2s, u2e);
        var m3s, m3e = _bj_k_ux_mul(m2s, m2e, u3s, u3e);
        ps = m3s;
        pe = m3e;
    }
    var rts, rte = _bj_k_ux_sqrt(ps, pe);
    var ws, we = _bj_k_ux_mul(rts, rte, lps, lpe);
    if (flat == 0) {
        var u4s, u4e = _bj_k_ux_from(f4);
        var qs, qe = _bj_k_ux_div(ws, we, u4s, u4e);
        ws = qs;
        we = qe;
    }
    var wsv: f64 = ws;
    if (wsv == 0.0) { return 0.0; }
    var w0: f64 = _bj_k_ux_sqrt_f64(wsv, we + k / 2);
    return w0;
}

# ── the resonator functions ──

# The stability of a cavity of length L between mirrors of radii R₁ and R₂ (positive concave, ±∞ flat) into *out:
# Ok(0), or with out untouched InvalidParameter for an L not positive and finite or a NaN radius, DivisionByZero when
# |R₁| or |R₂| < 1e-30. g₁, g₂ and g₁g₂ are Rust's rounded values; is_stable is decided on the exact
# (1 − L/R₁)(1 − L/R₂) (ADR 0002 row 34), so it may disagree with g_product's rounding at the edges: two convex
# mirrors are never stable, though their rounded g can be 1. Mirrors `resonator_stability`.
#must_use
public fn bj_resonator_stability(length: f64, r1: f64, r2: f64, out: *BjResonatorStability): Result {
    if (_bj_beam_pos(length) == 0) {
        return Err(_bj_beam_bad("cavity length must be positive and finite, got ", length, ""));
    }
    if (r1 != r1 || r2 != r2) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_INVALID_PARAMETER), "mirror radii must not be NaN");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var a1: f64 = f64_abs(r1);
    var a2: f64 = f64_abs(r2);
    if (a1 < 0.000000000000000000000000000001 || a2 < 0.000000000000000000000000000001) {
        return Err(_bj_beam_dz("mirror radius of curvature cannot be zero"));
    }
    var g1: f64 = 1.0 - length / r1;
    var g2: f64 = 1.0 - length / r2;
    var gp: f64 = g1 * g2;
    var st = _bj_beam_stable34(length, r1, r2);
    out.g1 = g1;
    out.g2 = g2;
    out.g_product = gp;
    out.is_stable = st;
    return Ok(0);
}

# Records InvalidParameter "<head>{gp:.4}<tail>", Rust's four-decimal form of g₁g₂. Returns the code.
fn _bj_beam_unstable(gp: f64, tail): i64 {
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, "cavity is unstable (g₁g₂ = ");
    _bj_fmt_f64_fixed(t, gp, 4);
    _bj_tx_cstr(t, tail);
    return BJ_ERR_INVALID_PARAMETER;
}

# The fundamental mode's waist in a stable cavity, w₀ = √[(Lλ/π)·√(g₁g₂(1 − g₁g₂))/|g₁ + g₂ − 2g₁g₂|] (Siegman, ch. 19),
# computed in the inputs without cancellation (_bj_beam_waist34, ADR 0002 row 34), with the symmetric confocal limit
# w₀ = √(Lλ/2π) at R₁ = R₂ = L, rounded once (ADR 0002 row 13). bj_resonator_stability's errors, then InvalidParameter
# for an unstable cavity (on the exact product; the reason quotes Rust's rounded g₁g₂) or a λ not positive and finite,
# DivisionByZero for the planar cavity (two flat mirrors). A near-planar cavity of finite radii has its finite waist,
# where Rust's g rounded to 1. Mirrors `resonator_beam_waist`.
#must_use
public fn bj_resonator_beam_waist(length: f64, r1: f64, r2: f64, wavelength: f64): Result {
    var st: BjResonatorStability;
    var t, v = bj_resonator_stability(length, r1, r2, &st);
    if (is_err_result(t) == 1) { return Err(v); }
    var gp: f64 = st.g_product;
    if (st.is_stable == 0) { return Err(_bj_beam_unstable(gp, "), no confined mode exists")); }
    if (_bj_beam_pos(wavelength) == 0) {
        return Err(_bj_beam_bad("wavelength must be positive and finite, got ", wavelength, ""));
    }
    if (_bj_is_finite(r1) == 0 && _bj_is_finite(r2) == 0) {
        return Err(_bj_beam_dz("planar cavity (g₁ = g₂ = 1) has no confined mode"));
    }
    if (r1 == length && r2 == length) {
        var cn: f64[2];
        var cd: f64[1];
        cn[0] = length;
        cn[1] = wavelength;
        cd[0] = 2.0 * _BJ_PI;
        var c: f64 = _bj_cr_sqrt_mono(&cn, 2, &cd, 1);
        return Ok(c);
    }
    var w0, ok = _bj_beam_waist34(length, r1, r2, wavelength);
    if (ok == 0) { return Err(_bj_beam_dz("planar cavity (g₁ = g₂ = 1) has no confined mode")); }
    var wv: f64 = w0;
    return Ok(wv);
}

# Δν_T = (Δν_FSR/π)·arccos(±√(g₁g₂)), the frequency step per unit of m + n: + when g₁, g₂ ≥ 0, − when either is
# negative (Siegman, ch. 19), so Δν_T ∈ [0, Δν_FSR]. InvalidParameter for an fsr not positive and finite or an
# unstable (or NaN) g₁g₂, decided on the exact product of finite g's (ADR 0002 row 34; Rust's rounded one otherwise).
# Mirrors `transverse_mode_spacing`.
#must_use
public fn bj_transverse_mode_spacing(fsr: f64, g1: f64, g2: f64): Result {
    if (_bj_beam_pos(fsr) == 0) {
        return Err(_bj_beam_bad("free spectral range must be positive and finite, got ", fsr, ""));
    }
    var gp: f64 = g1 * g2;
    var stable = 0;
    if (gp >= 0.0 && gp <= 1.0) { stable = 1; }
    if (_bj_is_finite(g1) == 1 && _bj_is_finite(g2) == 1) { stable = _bj_beam_gg_ok(g1, g2, gp); }
    if (stable == 0) { return Err(_bj_beam_unstable(gp, ")")); }
    var root: f64 = f64_sqrt(gp);
    var arg: f64 = root;
    if (g1 < 0.0 || g2 < 0.0) { arg = -root; }
    var ac: f64 = _bj_acos(arg);
    var s: f64 = fsr / _BJ_PI * ac;
    return Ok(s);
}

# ── the modes ───────────────────────────────────────────────────────────────────────────────────────────────────

# H_n(x) by the recurrence H₀ = 1, H₁ = 2x, H_k = 2x·H_{k−1} − 2(k − 1)·H_{k−2}, n ≥ 0 (Rust's u32). Mirrors beam.rs's
# `hermite_polynomial` (bijli-internal; its tests reach it).
#must_use
public fn _bj_hermite_polynomial(n, x: f64): f64 {
    if (n == 0) { return 1.0; }
    var two_x: f64 = 2.0 * x;
    if (n == 1) { return two_x; }
    var h_prev: f64 = 1.0;
    var h_curr: f64 = two_x;
    for (var k = 2; k <= n; k = k + 1) {
        var km: f64 = f64_from(k - 1);
        var h_next: f64 = two_x * h_curr - 2.0 * km * h_prev;
        h_prev = h_curr;
        h_curr = h_next;
    }
    return h_curr;
}

# L_p^l(x) by the recurrence L₀ = 1, L₁ = 1 + l − x, L_k = ((2k + l − 1 − x)·L_{k−1} − (k + l − 1)·L_{k−2})/k, p and
# l ≥ 0 (Rust's u32). Mirrors beam.rs's `laguerre_polynomial` (bijli-internal; its tests reach it).
#must_use
public fn _bj_laguerre_polynomial(p, l, x: f64): f64 {
    if (p == 0) { return 1.0; }
    var lf: f64 = f64_from(l);
    var l1: f64 = 1.0 + lf - x;
    if (p == 1) { return l1; }
    var l_prev: f64 = 1.0;
    var l_curr: f64 = l1;
    for (var k = 2; k <= p; k = k + 1) {
        var kf: f64 = f64_from(k);
        var l_next: f64 = ((2.0 * kf + lf - 1.0 - x) * l_curr - (kf + lf - 1.0) * l_prev) / kf;
        l_prev = l_curr;
        l_curr = l_next;
    }
    return l_curr;
}

# The Hermite–Gaussian envelope u_mn(x, y, z) = (w₀/w)·H_m(√2x/w)·H_n(√2y/w)·e^{−(x² + y²)/w²}, the field with every
# propagation phase removed (|u_mn| = |E|, u_mn² the intensity), the lobes' signs kept. The TEM₀₀ prefactor serves
# every mode (HG₀₀(0, 0, 0) = 1): HG_mn carries 2^{m+n}·m!·n! times TEM₀₀'s power. m, n ≥ 0 (Rust's u32). Mirrors
# `hermite_gaussian`.
#must_use
public fn bj_hermite_gaussian(beam: *BjGaussianBeam, m, n, x: f64, y: f64, z: f64): f64 {
    var w: f64 = beam.spot_size(z);
    var w0: f64 = beam.waist;
    var sx: f64 = _BJ_BEAM_SQRT_2 * x / w;
    var sy: f64 = _BJ_BEAM_SQRT_2 * y / w;
    var hm: f64 = _bj_hermite_polynomial(m, sx);
    var hn: f64 = _bj_hermite_polynomial(n, sy);
    var r_sq: f64 = x * x + y * y;
    var e: f64 = _bj_exp(-r_sq / (w * w));
    var scale: f64 = w0 / w;
    var u: f64 = scale * hm * hn * e;
    return u;
}

# The complex Hermite–Gaussian field E_mn = u_mn·e^{−j[kz + k(x² + y²)/(2R(z)) − (m + n + 1)ζ(z)]} in e^{+jωt} (field
# ∝ e^{−jkz}, Siegman's), u_mn = bj_hermite_gaussian, k = 2π/λ, 1/R(z) = z/(z² + z_R²) (finite at the waist),
# ζ(z) = arctan(z/z_R). The conjugate of beam.rs's e^{−iωt} field, part for part: Rust's phase, then (u·cos φ,
# −(u·sin φ)) (ADR 0002 row 5). Normalization as bj_hermite_gaussian's. Mirrors `hermite_gaussian_field`.
#must_use
public fn bj_hermite_gaussian_field(beam: *BjGaussianBeam, m, n, x: f64, y: f64, z: f64): BjComplex {
    var amp: f64 = bj_hermite_gaussian(beam, m, n, x, y, z);
    var two_pi: f64 = 2.0 * _BJ_PI;
    var k: f64 = two_pi / beam.wavelength;
    var zr: f64 = beam.rayleigh_range;
    var inv_r: f64 = z / (z * z + zr * zr);
    var mf: f64 = f64_from(m);
    var nf: f64 = f64_from(n);
    var order: f64 = mf + nf + 1.0;
    var gouy: f64 = beam.gouy_phase(z);
    var phase: f64 = k * z + 0.5 * k * (x * x + y * y) * inv_r - order * gouy;
    # Complex::from_polar's (u·cos φ, u·sin φ), with one sincos as Rust's compiles it (correctly rounded, so the
    # bits of separate cos and sin), then conjugated.
    var sp, cp = _bj_sin_cos(phase);
    var sv: f64 = sp;
    var cv: f64 = cp;
    var e: BjComplex;
    e.re = amp * cv;
    e.im = -(amp * sv);
    return e;
}

# The Laguerre–Gaussian intensity I_pl(r, z) = (w₀/w)²·(2r²/w²)^|l|·[L_p^|l|(2r²/w²)]²·e^{−2r²/w²}, |E|² (the vortex
# phase e^{jlφ} and the Gouy phase drop out). The TEM₀₀ prefactor serves every mode (LG₀₀(0, 0) = 1): LG_pl carries
# (p + |l|)!/p! times TEM₀₀'s power. p ≥ 0 (Rust's u32), l Rust's i32. For l = i32::MIN the power is (2r²/w²)^{2³¹}
# (ADR 0002 row 32: Rust's `l.unsigned_abs() as i32` wraps to −2³¹, the reciprocal). Mirrors
# `laguerre_gaussian_intensity`.
#must_use
public fn bj_laguerre_gaussian_intensity(beam: *BjGaussianBeam, p, l, r: f64, z: f64): f64 {
    var w: f64 = beam.spot_size(z);
    var w0: f64 = beam.waist;
    var rho: f64 = _BJ_BEAM_SQRT_2 * r / w;
    var rho_sq: f64 = rho * rho;
    var la = l;
    if (la < 0) { la = 0 - la; }
    var lp: f64 = _bj_laguerre_polynomial(p, la, rho_sq);
    var e: f64 = _bj_exp(-2.0 * r * r / (w * w));
    var scale: f64 = w0 * w0 / (w * w);
    var pw: f64 = _bj_powi(rho_sq, la);
    var i: f64 = scale * pw * lp * lp * e;
    return i;
}
