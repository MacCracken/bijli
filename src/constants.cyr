# 4th-order spatial derivative coefficients for FDTD.
#
# Uses the 4-point staggered stencil
# f'(x_{i+½}) ≈ (c₁(f\[i+1\]-f\[i\]) + c₂(f\[i+2\]-f\[i-1\])) / dx
# where c₁ = 9/8, c₂ = -1/24 (Yee fourth-order).
# Rust: bijli::fdtd::FOURTH_ORDER_C1
const BJ_FOURTH_ORDER_C1 = 1.125;

# Second coefficient for 4th-order stencil.
# Rust: bijli::fdtd::FOURTH_ORDER_C2
const BJ_FOURTH_ORDER_C2 = -0.041666666666666664;

# Permittivity of free space ε₀ (F/m), CODATA 2018: 8.854 187 8128(13) × 10⁻¹² F/m.
# Rust: bijli::field::EPSILON_0
const BJ_EPSILON_0 = 0.0000000000088541878128;

# Permeability of free space μ₀ (H/m), CODATA 2018: 1.256 637 062 12(19) × 10⁻⁶ H/m.
# Rust: bijli::field::MU_0
const BJ_MU_0 = 0.00000125663706212;

# Speed of light in vacuum c (m/s), exact by definition of the metre.
#
# c = 1/√(ε₀μ₀); with the CODATA 2018 [`EPSILON_0`] and [`MU_0`] above,
# ε₀μ₀c² − 1 ≈ −4 × 10⁻¹⁴ (well inside their 1.5 × 10⁻¹⁰ uncertainty).
# Rust: bijli::field::SPEED_OF_LIGHT
const BJ_SPEED_OF_LIGHT = 299792458.0;

