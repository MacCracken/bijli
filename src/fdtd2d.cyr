# fdtd2d.cyr — fdtd.rs's 2D solver (M6 part 1b-1): `Fdtd2d`, the Yee algorithm on an nx × ny grid in TM mode (E_z at
# the integer nodes (x, y), H_x at (x, y + ½), H_y at (x + ½, y)) or TE mode (H_z, E_x, E_y at the same places), SI
# units. Fields are row-major, index y·nx + x. The time step is half the 2D Courant limit, dt = dx/(2√2·c), a Courant
# number of 1/(2√2). dt, the update coefficients and `time()` are rounded once (ADR 0002 row 13), and the lossy C_a and
# C_b once from their exact rationals (row 40), as the 1D grid's (M6 part 4a).
#
# The outer walls reflect: the out-of-plane field is held at zero on the outermost ring of nodes, a perfect electric
# conductor in TM (E_z = 0) and a perfect magnetic conductor in TE (H_z = 0). Per-cell ε_r, μ_r and conductivity σ
# (the lossy E update E ← C_a·E + C_b·∇×H, C_a = (1 − σΔt/2ε)/(1 + σΔt/2ε), C_b = (Δt/εΔx)/(1 + σΔt/2ε)) are set by
# region. A CPML absorbing layer (src/cpml.cyr) can replace the walls' reflection: it occupies the outermost `thickness`
# cells, ends on the same wall, and corrects the updates in its strips after each phase (Rust's `correct_fx`,
# `correct_fy`, `correct_fz`, in Rust's order).
#
# A grid's seven arrays (f_z, f_x, f_y, the C_b and H coefficients, ε_r and μ_r) and three scratch rows are one
# anonymous mmap, fixed at construction; the first lossy region maps C_a and σ beside them. BjFdtd2d_free gives both
# back. Rust's public, resizable `Vec` fields and the per-step layout check that guarded them are gone (ADR 0002 row 2):
# the fields are the arrays' addresses and nx·ny their length. No step allocates. The updates run on the packed f64v_*
# verbs, each lane rounding Rust's operations in Rust's order, so the bits are Rust's (port plan §9.3, probe p10), on
# lane multiples with a scalar tail (probe p19). The file is time-domain only; bijli's one harmonic convention,
# e^{+jωt}, is stated in src/complex.cyr's header.

private

var _BJ_FD2_INF: f64 = 0x7FF0000000000000;
# std::f64::consts::PI and SQRT_2.
var _BJ_FD2_PI: f64 = 3.141592653589793;
var _BJ_FD2_SQRT_2: f64 = 1.4142135623730951;
# The grid's arrays, each nx·ny f64, in one mapping: f_z, f_x, f_y, C_b, the H coefficients, ε_r and μ_r (then three
# scratch rows of nx).
var _BJ_FD2_ARRAYS = 7;
# The largest nx·ny whose mapping (under 64 bytes a cell with the scratch rows) a 64-bit length holds.
var _BJ_FD2_MAX_CELLS = 144115188075855871;

# The polarization of a 2D grid. TM: E_z, H_x, H_y (E perpendicular to the plane; the walls PEC, E_z = 0). TE: H_z,
# E_x, E_y (H perpendicular; the walls PMC, H_z = 0). Mirrors `Mode2d`.
public enum BjMode2d {
    BJ_MODE2D_TM = 0;
    BJ_MODE2D_TE = 1;
}

# Rust's `run(steps, None, ..)`: no source. Rust's Some((x, y)) outside the grid injects nothing either, so usize::MAX
# (−1) for x is None exactly.
public var BJ_FDTD2D_NO_SOURCE = 0 - 1;

# A 2D FDTD simulation. `mode` is BJ_MODE2D_TM or BJ_MODE2D_TE; nx × ny the nodes; `dx` (m) the uniform spacing in x
# and y, `dt` (s) the step, `step` the time-step index. `fz` (E_z in TM, H_z in TE), `fx` (H_x, E_x) and `fy` (H_y,
# E_y) are the addresses of nx·ny f64 each (read and write the values, as Rust's public vectors). `ce` holds C_b per
# cell (Δt/(ε₀ε_r·Δx), divided by 1 + σΔt/2ε where lossy), `ch` Δt/(μ₀μ_r·Δx), `ca` C_a and `conductivity` σ (S/m),
# both 0 while every cell is lossless (Rust's empty vectors), `permittivity` ε_r and `permeability` μ_r. `cpml` is the
# attached layer's address (a freelist block holding a BjCpml, attached to this grid), 0 for none; read it through
# `cpml()`. `work` holds the update's three scratch rows, `map_bytes` and `lossy_bytes` the mappings' lengths (0 once
# freed). Mirrors `Fdtd2d`.
public struct BjFdtd2d {
    mode;
    nx;
    ny;
    dx: f64;
    dt: f64;
    step;
    fz;
    fx;
    fy;
    ce;
    ch;
    ca;
    permittivity;
    permeability;
    conductivity;
    cpml;
    work;
    map_bytes;
    lossy_bytes;
}

# The helpers below marked public are shared with src/fdtd3d.cyr (`_bj_` names stay out of the API).

# A word as a *f64 (the typed return keeps the binding typed).
#must_use
public fn _bj_fd2_f64p(a): *f64 {
    return a;
}

# A word as a *BjCpml.
#must_use
fn _bj_fd2_cpmlp(a): *BjCpml {
    return a;
}

# 1 when a ≥ b as usize words (a negative word is past 2^63).
#must_use
public fn _bj_fd2_uge(a, b): i64 {
    if ((a < 0) == (b < 0)) {
        if (a >= b) { return 1; }
        return 0;
    }
    if (a < 0) { return 1; }
    return 0;
}

# The usize product a·b into *out: 1, or 0 when it overflows 64 bits (Rust's `checked_mul` None).
public fn _bj_fd2_umul(a, b, out: *i64): i64 {
    var ah = a >> 32;
    var al = a & 0xFFFFFFFF;
    var bh = b >> 32;
    var bl = b & 0xFFFFFFFF;
    if (ah != 0 && bh != 0) { return 0; }
    var cross = ah * bl + al * bh;
    if ((cross >> 32) != 0) { return 0; }
    var lo = al * bl;
    var hi = cross << 32;
    var s = lo + hi;
    if (_bj_fd2_uge(s, lo) == 0) { return 0; }
    out[0] = s;
    return 1;
}

# Rust's `n as f64` for a usize: the word read unsigned, rounded to nearest even.
#must_use
public fn _bj_fd2_u2f(n): f64 {
    if (n >= 0) {
        var r: f64 = f64_from(n);
        return r;
    }
    var h: f64 = f64_from((n >> 1) | (n & 1));
    var r2: f64 = h * 2.0;
    return r2;
}

# 1 when x is finite and strictly positive (NaN-safe). Mirrors fdtd.rs's `is_positive_finite`.
#must_use
public fn _bj_fd2_pos(x: f64): i64 {
    if (x > 0.0 && x < _BJ_FD2_INF) { return 1; }
    return 0;
}

# Records InvalidParameter "cannot allocate {n} grid values" (Rust's `try_filled`); returns its code.
public fn _bj_fd2_alloc_err(n): i64 {
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, "cannot allocate ");
    _bj_tx_u64(t, n);
    _bj_tx_cstr(t, " grid values");
    return BJ_ERR_INVALID_PARAMETER;
}

# The E-update coefficients (C_a, C_b) for ε_r and σ: C_a = (1 − σΔt/2ε)/(1 + σΔt/2ε), C_b = (Δt/(εΔx))/(1 +
# σΔt/2ε), ε = ε_rε₀; the lossless case (1, Δt/(ε₀Δx·ε_r)). Rust's `e_update_coefficients` is `LossyMaterial`'s chain,
# so the lossy pair is BjLossyMaterial's, each rounded once from its exact rational (ADR 0002 row 40, M6 part 4a), and
# the lossless C_b is rounded once (row 13). Mirrors fdtd.rs's `e_update_coefficients`.
#must_use
public fn _bj_fd2_e_coefficients(dt: f64, dx: f64, eps_r: f64, sigma: f64): (f64, f64) {
    if (sigma > 0.0) {
        var m: BjLossyMaterial = BjLossyMaterial_new(eps_r, sigma);
        var ca, cb = m.update_coefficients(dt, dx);
        var cav: f64 = ca;
        var cbv: f64 = cb;
        return (cav, cbv);
    }
    var cb0: f64 = _bj_e_fd_coeff(dt, BJ_EPSILON_0, dx, eps_r);
    return (1.0, cb0);
}

# d[i] ± k[i]·(a[i] − b[i]) into d for i < n (add 1: `+=`, 0: `-=`), Rust's `row_diff`: the packed f64v_sub into the
# scratch row w2, f64v_mul into w and f64v_add or f64v_sub on the largest multiple of 4, then a scalar tail (probe p19).
# Each cell at its range edge reruns with an unbounded exponent (ADR 0002 row 18, M6 part 4c: src/crmath_edge.cyr's 2D
# rule, the product row scanned between the multiply and the add, the difference row its zero test).
public fn _bj_fd2_diff(d: *f64, k: *f64, a: *f64, b: *f64, w: *f64, w2: *f64, n, add) {
    var m = n & (0 - 4);
    var sg = 0;
    var sub = 1;
    if (add == 1) { sub = 0; }
    else { sg = 0 - 9223372036854775807 - 1; }
    if (m > 0) {
        f64v_sub(w2, a, b, m);
        f64v_mul(w, k, w2, m);
        _bj_e_diff_fix(d, k, a, b, w2, w, m, sg);
        if (add == 1) { f64v_add(d, d, w, m); }
        else { f64v_sub(d, d, w, m); }
    }
    for (var i = m; i < n; i = i + 1) { d[i] = _bj_e_diff_one(d[i], k[i], a[i], b[i], sub); }
    return 0;
}

# One row's interior curl update, x ∈ 1..n − 1: d[x] ± k[x]·((a[x] − a[x − 1]) − (b[x] − bp[x])) (add 1: `+=`, 0:
# `-=`), Rust's `row_curl`, on the packed verbs through the scratch rows w (the inner difference) and w2 (the product),
# lane multiples and a scalar tail; each cell at its range edge reruns with an unbounded exponent (ADR 0002 row 18, M6
# part 4c).
public fn _bj_fd2_curl(d: *f64, k: *f64, a: *f64, b: *f64, bp: *f64, w: *f64, w2: *f64, n, add) {
    if (n < 3) { return 0; }
    var c = n - 2;
    var m = c & (0 - 4);
    var sg = 0;
    var sub = 1;
    if (add == 1) { sub = 0; }
    else { sg = 0 - 9223372036854775807 - 1; }
    if (m > 0) {
        f64v_sub(w, a + 1, a, m);
        f64v_sub(w2, b + 1, bp + 1, m);
        f64v_sub(w, w, w2, m);
        f64v_mul(w2, k + 1, w, m);
        _bj_e_curl_fix(d + 1, k + 1, a + 1, a, b + 1, bp + 1, w, w2, m, sg);
        if (add == 1) { f64v_add(d + 1, d + 1, w2, m); }
        else { f64v_sub(d + 1, d + 1, w2, m); }
    }
    for (var x = m + 1; x < n - 1; x = x + 1) {
        d[x] = _bj_e_curl_one(d[x], k[x], a[x], a[x - 1], b[x], bp[x], sub);
    }
    return 0;
}

# f[i] ·= factor[i] for i < n (lossy cells' C_a; the packed f64v_mul on lane multiples, a scalar tail). Mirrors
# fdtd.rs's `scale_by`.
public fn _bj_fd2_scale(f: *f64, factor: *f64, n) {
    var m = n & (0 - 4);
    if (m > 0) { f64v_mul(f, f, factor, m); }
    for (var i = m; i < n; i = i + 1) { f[i] = f[i] * factor[i]; }
    return 0;
}

# Zeroes the outermost ring of a row-major nx-wide field of nx·ny cells (the PEC or PMC wall). Mirrors fdtd.rs's
# `zero_walls`.
public fn _bj_fd2_walls(f: *f64, nx, ny) {
    var n = nx * ny;
    for (var x = 0; x < nx; x = x + 1) {
        f[x] = 0.0;
        f[n - nx + x] = 0.0;
    }
    for (var y = 0; y < ny; y = y + 1) {
        f[y * nx] = 0.0;
        f[y * nx + nx - 1] = 0.0;
    }
    return 0;
}

# Records InvalidParameter "region {axis} range {lo}..{hi} is invalid for a grid of {n} cells" when lo ≥ n or hi < lo
# (usize compares) and returns its code; else 0 with the range clamped to n in r[0..2]. Mirrors fdtd.rs's
# `region_range`.
public fn _bj_fd2_range(axis, lo, hi, n, r: *i64): i64 {
    if (_bj_fd2_uge(lo, n) == 1 || _bj_fd2_uge(hi, lo) == 0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "region ");
        _bj_tx_cstr(t, axis);
        _bj_tx_cstr(t, " range ");
        _bj_tx_u64(t, lo);
        _bj_tx_cstr(t, "..");
        _bj_tx_u64(t, hi);
        _bj_tx_cstr(t, " is invalid for a grid of ");
        _bj_tx_u64(t, n);
        _bj_tx_cstr(t, " cells");
        return BJ_ERR_INVALID_PARAMETER;
    }
    r[0] = lo;
    r[1] = hi;
    if (_bj_fd2_uge(hi, n) == 1) { r[1] = n; }
    return 0;
}

# 0 for a finite and strictly positive ε_r, else InvalidPermittivity { value } recorded and its code. Mirrors
# fdtd.rs's `validate_eps_r`.
public fn _bj_fd2_check_eps(eps_r: f64): i64 {
    if (_bj_fd2_pos(eps_r) == 1) { return 0; }
    return _bj_err_invalid_permittivity(eps_r);
}

# 0 for a finite and strictly positive μ_r, else InvalidPermeability { value } recorded and its code. Mirrors
# fdtd.rs's `validate_mu_r`.
public fn _bj_fd2_check_mu(mu_r: f64): i64 {
    if (_bj_fd2_pos(mu_r) == 1) { return 0; }
    return _bj_err_invalid_permeability(mu_r);
}

# 0 for a finite σ ≥ 0, else InvalidParameter "conductivity must be finite and ≥ 0 S/m, got {σ}" recorded and its
# code. Mirrors fdtd.rs's `validate_conductivity`.
public fn _bj_fd2_check_sigma(sigma: f64): i64 {
    if (sigma >= 0.0 && sigma < _BJ_FD2_INF) { return 0; }
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, "conductivity must be finite and ≥ 0 S/m, got ");
    _bj_fmt_f64_display(t, sigma);
    return BJ_ERR_INVALID_PARAMETER;
}

# One CPML strip row on the packed verbs: for i < n, d = hi[i] − lo[i], Ψ ← b·Ψ + c·d, and f ± (sign·k)·((1/κ − 1)·d +
# Ψ) (sub 0: `+=`, 1: `-=`), Rust's `*psi = b * *psi + c * d; *f += sign * kk * (km1 * d + *psi)` lane by lane (IEEE's
# products and sums are commutative, so each lane's operands may swap), through the scratch rows w1, w2, w3 on lane
# multiples, then a scalar tail. Each statement's products are scanned before its last operation, and a cell at a
# range edge reruns that statement with an unbounded exponent (src/crmath_edge.cyr's CPML rule; ADR 0002 row 18, M6
# part 4e): d stays in w1 until km1·d is in w2, then w1 takes u = km1·d + Ψ and the product, w3 takes s·k.
public fn _bj_fd2_strip(f: *f64, hi: *f64, lo: *f64, k: *f64, psi: *f64, n, pr: *f64, w: *f64, sub) {
    var b: f64 = pr[0];
    var c: f64 = pr[1];
    var km1: f64 = pr[2];
    var sign: f64 = pr[3];
    var w1: *f64 = w;
    var w2: *f64 = w + n;
    var w3: *f64 = w + 2 * n;
    var m = n & (0 - 4);
    if (m > 0) {
        f64v_sub(w1, hi, lo, m);
        f64v_scale(w2, psi, b, m);
        f64v_scale(w3, w1, c, m);
        _bj_e_psi_fix(hi, lo, psi, w1, w2, w3, m, pr);
        f64v_add(psi, w2, w3, m);
        f64v_scale(w2, w1, km1, m);
        f64v_add(w1, w2, psi, m);
        f64v_scale(w3, k, sign, m);
        f64v_mul(w1, w3, w1, m);
        _bj_e_cpmlf_fix(f, hi, lo, psi, w2, w3, w1, m, pr, sub);
        if (sub == 0) { f64v_add(f, f, w1, m); }
        else { f64v_sub(f, f, w1, m); }
    }
    if (m < n) { _bj_e_cpml_run(f + m, psi + m, k + m, hi + m, lo + m, n - m, 1, 1, pr, sub); }
    return 0;
}

# The CPML term for f_x at (x, y + ½) in the y-strips (rows y = l and ny − 2 − l, the half-node profiles):
# Ψ ← b·Ψ + c·Δ_y f_z, f_x += sign·k·((1/κ − 1)·Δ + Ψ). The layer is attached to this grid. Mirrors `Cpml::correct_fx`.
fn _bj_fd2_cpml_fx(c: *BjCpml, fx: *f64, fz: *f64, k: *f64, nx, ny, sign: f64, w: *f64) {
    var t = c.thickness;
    var bh: *f64 = _bj_fd2_f64p(c.b_half);
    var chf: *f64 = _bj_fd2_f64p(c.c_half);
    var kh: *f64 = _bj_fd2_f64p(c.km1_half);
    var psi: *f64 = _bj_fd2_f64p(c.psi_fx_y);
    var pr: f64[4];
    pr[3] = sign;
    for (var side = 0; side < 2; side = side + 1) {
        for (var l = 0; l < t; l = l + 1) {
            var y = l;
            if (side == 1) { y = ny - 2 - l; }
            pr[0] = bh[l];
            pr[1] = chf[l];
            pr[2] = kh[l];
            var r0 = y * nx;
            _bj_fd2_strip(fx + r0, fz + r0 + nx, fz + r0, k + r0, psi + (side * t + l) * nx, nx, &pr, w, 0);
        }
    }
    return 0;
}

# The CPML term for f_y at (x + ½, y) in the x-strips (columns x = l and nx − 2 − l on every row, the half-node
# profiles): Ψ ← b·Ψ + c·Δ_x f_z, f_y += sign·k·((1/κ − 1)·Δ + Ψ). Mirrors `Cpml::correct_fy`.
fn _bj_fd2_cpml_fy(c: *BjCpml, fy: *f64, fz: *f64, k: *f64, nx, ny, sign: f64) {
    var t = c.thickness;
    var bh: *f64 = _bj_fd2_f64p(c.b_half);
    var chf: *f64 = _bj_fd2_f64p(c.c_half);
    var kh: *f64 = _bj_fd2_f64p(c.km1_half);
    var pp: *f64 = _bj_fd2_f64p(c.psi_fy_x);
    var pr: f64[4];
    pr[3] = sign;
    for (var l = 0; l < t; l = l + 1) {
        pr[0] = bh[l];
        pr[1] = chf[l];
        pr[2] = kh[l];
        _bj_e_cpml_run(fy + l, pp + l, k + l, fz + l + 1, fz + l, ny, nx, 2 * t, &pr, 0);
        var x = nx - 2 - l;
        _bj_e_cpml_run(fy + x, pp + t + l, k + x, fz + x + 1, fz + x, ny, nx, 2 * t, &pr, 0);
    }
    return 0;
}

# The CPML terms for f_z at the integer nodes, the node profiles, layers l = 1..t (the wall node l = 0 is reset by the
# boundary): first the x-strips on the interior rows (columns l and nx − 1 − l: Ψ ← b·Ψ + c·Δ_x f_y, f_z +=
# sign·k·((1/κ − 1)·Δ + Ψ)), then the y-strips on the interior columns (rows l and ny − 1 − l: Ψ ← b·Ψ + c·Δ_y f_x,
# f_z −= sign·k·((1/κ − 1)·Δ + Ψ)); a corner cell takes both, in that order. Mirrors `Cpml::correct_fz`.
fn _bj_fd2_cpml_fz(c: *BjCpml, fz: *f64, fx: *f64, fy: *f64, k: *f64, nx, ny, sign: f64, w: *f64) {
    var t = c.thickness;
    var bn: *f64 = _bj_fd2_f64p(c.b_node);
    var cn: *f64 = _bj_fd2_f64p(c.c_node);
    var kn: *f64 = _bj_fd2_f64p(c.km1_node);
    var pp: *f64 = _bj_fd2_f64p(c.psi_fz_x + 2 * t * 8);
    var pr: f64[4];
    pr[3] = sign;
    for (var l = 1; l < t; l = l + 1) {
        pr[0] = bn[l];
        pr[1] = cn[l];
        pr[2] = kn[l];
        var o = nx + l;
        _bj_e_cpml_run(fz + o, pp + l, k + o, fy + o, fy + o - 1, ny - 2, nx, 2 * t, &pr, 0);
        var o2 = nx + nx - 1 - l;
        _bj_e_cpml_run(fz + o2, pp + t + l, k + o2, fy + o2, fy + o2 - 1, ny - 2, nx, 2 * t, &pr, 0);
    }
    var psi: *f64 = _bj_fd2_f64p(c.psi_fz_y);
    for (var side = 0; side < 2; side = side + 1) {
        for (var l2 = 1; l2 < t; l2 = l2 + 1) {
            var y2 = l2;
            if (side == 1) { y2 = ny - 1 - l2; }
            pr[0] = bn[l2];
            pr[1] = cn[l2];
            pr[2] = kn[l2];
            var r0 = y2 * nx + 1;
            _bj_fd2_strip(fz + r0, fx + r0, fx + r0 - nx, k + r0, psi + (side * t + l2) * nx + 1, nx - 2, &pr, w, 1);
        }
    }
    return 0;
}

# 1 when a cell of total_energy leaves the normal range for finite operands, the exact test (ADR 0002 row 18, M6 part
# 4f): a product neither normal nor 0 from a zero factor, or f_x² + f_y² neither normal nor 0. z, x and y are the
# cell's fields, mz and mxy its media and zc, xyc their constants (the mode's order).
#must_use
fn _bj_fd2_energy_cell(z: f64, mz: f64, zc: f64, x: f64, y: f64, mxy: f64, xyc: f64): i64 {
    var a: f64 = 0.5 * mz;
    var b: f64 = a * zc;
    var c: f64 = b * z;
    var d: f64 = c * z;
    var xx: f64 = x * x;
    var yy: f64 = y * y;
    var s: f64 = xx + yy;
    var a2: f64 = 0.5 * mxy;
    var b2: f64 = a2 * xyc;
    var c2: f64 = b2 * s;
    var hw: f64 = 0.5;
    var ok = _bj_e_zok(a, hw, mz) & _bj_e_zok(b, a, zc) & _bj_e_zok(c, b, z) & _bj_e_zok(d, c, z);
    ok = ok & _bj_e_zok(xx, x, x) & _bj_e_zok(yy, y, y) & _bj_e_zok(a2, hw, mxy) & _bj_e_zok(b2, a2, xyc);
    ok = ok & _bj_e_zok(c2, b2, s);
    var sw = s;
    if (_bj_e_nrm(sw) < 0 && (sw << 1) != 0) { ok = 0; }
    return 1 - ok;
}

# 1 when every field, ε_r, μ_r and dx of the grid is finite.
#must_use
fn _bj_fd2_finite_grid(sim: *BjFdtd2d): i64 {
    var n = sim.nx * sim.ny;
    var fz: *f64 = _bj_fd2_f64p(sim.fz);
    var fx: *f64 = _bj_fd2_f64p(sim.fx);
    var fy: *f64 = _bj_fd2_f64p(sim.fy);
    var eps: *f64 = _bj_fd2_f64p(sim.permittivity);
    var mu: *f64 = _bj_fd2_f64p(sim.permeability);
    var z: f64 = sim.dx * 0.0;
    for (var i = 0; i < n; i = i + 1) {
        var zi: f64 = fz[i] * 0.0 + fx[i] * 0.0 + fy[i] * 0.0 + eps[i] * 0.0 + mu[i] * 0.0;
        z = z + zi;
    }
    if (z == 0.0) { return 1; }
    return 0;
}

# total_energy's chain with an unbounded exponent (ADR 0002 row 18, M6 part 4f): each product and sum to 53 bits, the
# sum from +0, and its product with dx² (to 53 bits) rounded once.
#must_use
fn _bj_fd2_energy_ux(sim: *BjFdtd2d): f64 {
    var n = sim.nx * sim.ny;
    var zm: *f64 = _bj_fd2_f64p(sim.permittivity);
    var zc: f64 = BJ_EPSILON_0;
    var xym: *f64 = _bj_fd2_f64p(sim.permeability);
    var xyc: f64 = BJ_MU_0;
    if (sim.mode == BJ_MODE2D_TE) {
        zm = _bj_fd2_f64p(sim.permeability);
        zc = BJ_MU_0;
        xym = _bj_fd2_f64p(sim.permittivity);
        xyc = BJ_EPSILON_0;
    }
    var fz: *f64 = _bj_fd2_f64p(sim.fz);
    var fx: *f64 = _bj_fd2_f64p(sim.fx);
    var fy: *f64 = _bj_fd2_f64p(sim.fy);
    var hs, he = _bj_k_ux_from(0.5);
    var zs, ze = _bj_k_ux_from(zc);
    var ks, ke = _bj_k_ux_from(xyc);
    var es: f64 = 0.0;
    var ee = 0;
    for (var i = 0; i < n; i = i + 1) {
        var ms, me = _bj_k_ux_from(zm[i]);
        var as, ae = _bj_k_ux_mul(hs, he, ms, me);
        var bs, be = _bj_k_ux_mul(as, ae, zs, ze);
        var fs, fe = _bj_k_ux_from(fz[i]);
        var cs, ce = _bj_k_ux_mul(bs, be, fs, fe);
        var ds, de = _bj_k_ux_mul(cs, ce, fs, fe);
        var e1s, e1e = _bj_k_ux_add(es, ee, ds, de);
        var xs, xe = _bj_k_ux_from(fx[i]);
        var ys, ye = _bj_k_ux_from(fy[i]);
        var x2s, x2e = _bj_k_ux_mul(xs, xe, xs, xe);
        var y2s, y2e = _bj_k_ux_mul(ys, ye, ys, ye);
        var ss, se = _bj_k_ux_add(x2s, x2e, y2s, y2e);
        var m2s, m2e = _bj_k_ux_from(xym[i]);
        var a2s, a2e = _bj_k_ux_mul(hs, he, m2s, m2e);
        var b2s, b2e = _bj_k_ux_mul(a2s, a2e, ks, ke);
        var c2s, c2e = _bj_k_ux_mul(b2s, b2e, ss, se);
        var e2s, e2e = _bj_k_ux_add(e1s, e1e, c2s, c2e);
        es = e2s;
        ee = e2e;
    }
    var dxs, dxe = _bj_k_ux_from(sim.dx);
    var qs, qe = _bj_k_ux_mul(dxs, dxe, dxs, dxe);
    var en: f64 = _bj_k_ux_mul_f64(es, ee, qs, qe);
    return en;
}

# A vacuum grid of nx × ny nodes at spacing dx in `mode` into *out, the walls reflecting: Ok(0), or with out untouched
# Err(InsufficientResolution) when nx < 3 or ny < 3 (cells min(nx, ny), domain min(nx, ny)·dx), Err(InvalidParameter)
# "dx must be finite and positive, got {dx}", "grid [{nx}, {ny}] is too large" (nx·ny past 2^64) or "cannot allocate
# {n} grid values", in Rust's order. A mode word that is no BjMode2d (Rust's enum has no other) is refused first,
# InvalidParameter "unknown 2D mode {mode}", as bj_try_write_touchstone's format. dt = dx/(2√2·c). Give it back with
# BjFdtd2d_free. dt and the coefficients are rounded once (ADR 0002 row 13, M6 part 4a). Mirrors `Fdtd2d::new`.
#must_use
public fn BjFdtd2d_new(nx, ny, dx: f64, mode, out: *BjFdtd2d): Result {
    if (mode != BJ_MODE2D_TM && mode != BJ_MODE2D_TE) {
        var tm = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(tm, "unknown 2D mode ");
        _bj_tx_i64(tm, mode);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if ((nx >= 0 && nx < 3) || (ny >= 0 && ny < 3)) {
        var mn = nx;
        if (_bj_fd2_uge(nx, ny) == 1) { mn = ny; }
        var mf: f64 = _bj_fd2_u2f(mn);
        var size: f64 = mf * dx;
        return Err(_bj_err_insufficient_resolution(mn, size));
    }
    if (_bj_fd2_pos(dx) == 0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "dx must be finite and positive, got ");
        _bj_fmt_f64_display(t, dx);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var cells: i64[1];
    if (_bj_fd2_umul(nx, ny, &cells) == 0) {
        var tg = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(tg, "grid [");
        _bj_tx_u64(tg, nx);
        _bj_tx_cstr(tg, ", ");
        _bj_tx_u64(tg, ny);
        _bj_tx_cstr(tg, "] is too large");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var n = cells[0];
    var r2: f64 = 2.0 * _BJ_FD2_SQRT_2;
    var dt: f64 = _bj_e_fd_courant(dx, r2);
    var map = 0;
    var bytes = 0;
    if (n >= 0 && n <= _BJ_FD2_MAX_CELLS) {
        bytes = (n * _BJ_FD2_ARRAYS + 3 * nx) * 8;
        map = mmap_anon(bytes);
    }
    if (map == 0) { return Err(_bj_fd2_alloc_err(n)); }
    var ce: f64 = _bj_e_fd_coeff(dt, BJ_EPSILON_0, dx, 1.0);
    var ch: f64 = _bj_e_fd_coeff(dt, BJ_MU_0, dx, 1.0);
    var cep: *f64 = _bj_fd2_f64p(map + 3 * n * 8);
    var chp: *f64 = _bj_fd2_f64p(map + 4 * n * 8);
    var eps: *f64 = _bj_fd2_f64p(map + 5 * n * 8);
    var mu: *f64 = _bj_fd2_f64p(map + 6 * n * 8);
    for (var i = 0; i < n; i = i + 1) {
        cep[i] = ce;
        chp[i] = ch;
        eps[i] = 1.0;
        mu[i] = 1.0;
    }
    out.mode = mode;
    out.nx = nx;
    out.ny = ny;
    out.dx = dx;
    out.dt = dt;
    out.step = 0;
    out.fz = map;
    out.fx = map + n * 8;
    out.fy = map + 2 * n * 8;
    out.ce = map + 3 * n * 8;
    out.ch = map + 4 * n * 8;
    out.permittivity = map + 5 * n * 8;
    out.permeability = map + 6 * n * 8;
    out.work = map + 7 * n * 8;
    out.ca = 0;
    out.conductivity = 0;
    out.cpml = 0;
    out.map_bytes = bytes;
    out.lossy_bytes = 0;
    if (_bj_log_on(4) == 1) {
        var lb[256];
        var lt[24];
        _bj_tx_init(&lt, &lb, 256);
        _bj_tx_cstr(&lt, "2D FDTD simulation created nx=");
        _bj_tx_u64(&lt, nx);
        _bj_tx_cstr(&lt, " ny=");
        _bj_tx_u64(&lt, ny);
        _bj_tx_cstr(&lt, " dx=");
        _bj_fmt_f64_debug(&lt, dx);
        _bj_tx_cstr(&lt, " dt=");
        _bj_fmt_f64_debug(&lt, dt);
        _bj_tx_cstr(&lt, " mode=");
        if (mode == BJ_MODE2D_TE) { _bj_tx_cstr(&lt, "Te"); }
        else { _bj_tx_cstr(&lt, "Tm"); }
        _bj_log_text(4, &lt);
    }
    return Ok(0);
}

# Gives a grid's mappings and its CPML back and empties it (nx = ny = 0, every address 0); a second call does nothing.
public fn BjFdtd2d_free(sim: *BjFdtd2d): i64 {
    if (sim.cpml != 0) {
        BjCpml_free(sim.cpml);
        fl_free(sim.cpml);
    }
    sim.cpml = 0;
    if (sim.map_bytes > 0) { cyr_munmap(sim.fz, sim.map_bytes); }
    if (sim.lossy_bytes > 0) { cyr_munmap(sim.ca, sim.lossy_bytes); }
    sim.fz = 0;
    sim.fx = 0;
    sim.fy = 0;
    sim.ce = 0;
    sim.ch = 0;
    sim.ca = 0;
    sim.permittivity = 0;
    sim.permeability = 0;
    sim.conductivity = 0;
    sim.work = 0;
    sim.nx = 0;
    sim.ny = 0;
    sim.map_bytes = 0;
    sim.lossy_bytes = 0;
    return 0;
}

impl BjFdtd2d {
    # The linear index of node (x, y): y·nx + x. Mirrors `Fdtd2d::idx`.
    #must_use
    public fn idx(self, x, y): i64 {
        return y * self.nx + x;
    }

    # Writes material values to an already validated region [x0, x1) × [y0, y1) and refreshes the update coefficients;
    # a flag of 0 leaves that property as it is (Rust's None). The first region with σ > 0 maps C_a (1) and σ (0) for
    # every cell: Ok(0), or Err(InvalidParameter) "cannot allocate {n} grid values" with nothing written. Mirrors
    # `Fdtd2d::apply_region`.
    fn apply_region(self, r: *i64, has_eps, eps_r: f64, has_mu, mu_r: f64, has_sigma, sigma: f64): Result {
        var nx = self.nx;
        var n = nx * self.ny;
        if (has_sigma == 1 && sigma > 0.0 && self.ca == 0) {
            var map = mmap_anon(2 * n * 8);
            if (map == 0) { return Err(_bj_fd2_alloc_err(n)); }
            var cap: *f64 = _bj_fd2_f64p(map);
            for (var i = 0; i < n; i = i + 1) { cap[i] = 1.0; }
            self.ca = map;
            self.conductivity = map + n * 8;
            self.lossy_bytes = 2 * n * 8;
        }
        if (_bj_log_on(4) == 1) {
            var lb[256];
            var lt[24];
            _bj_tx_init(&lt, &lb, 256);
            _bj_tx_cstr(&lt, "2D FDTD material region set xs=");
            _bj_tx_u64(&lt, r[0]);
            _bj_tx_cstr(&lt, "..");
            _bj_tx_u64(&lt, r[1]);
            _bj_tx_cstr(&lt, " ys=");
            _bj_tx_u64(&lt, r[2]);
            _bj_tx_cstr(&lt, "..");
            _bj_tx_u64(&lt, r[3]);
            _bj_log_text(4, &lt);
        }
        var dt: f64 = self.dt;
        var dx: f64 = self.dx;
        var hm: f64 = 0.0;
        if (has_mu == 1) { hm = _bj_e_fd_coeff(dt, BJ_MU_0, dx, mu_r); }
        # The last cell's (ε_r, σ) as words and its (C_a, C_b): a region's cells mostly share them, and each pair is
        # rounded once (a few hundred ns), so a repeated pair reuses it.
        var lw_e = 0;
        var lw_s = 0;
        var lca: f64 = 0.0;
        var lcb: f64 = 0.0;
        var have = 0;
        var eps: *f64 = _bj_fd2_f64p(self.permittivity);
        var mu: *f64 = _bj_fd2_f64p(self.permeability);
        var ce: *f64 = _bj_fd2_f64p(self.ce);
        var ch: *f64 = _bj_fd2_f64p(self.ch);
        var ca: *f64 = _bj_fd2_f64p(self.ca);
        var cond: *f64 = _bj_fd2_f64p(self.conductivity);
        for (var y = r[2]; y < r[3]; y = y + 1) {
            for (var x = r[0]; x < r[1]; x = x + 1) {
                var i = y * nx + x;
                if (has_mu == 1) {
                    mu[i] = mu_r;
                    ch[i] = hm;
                }
                if (has_eps == 1 || has_sigma == 1) {
                    if (has_eps == 1) { eps[i] = eps_r; }
                    if (has_sigma == 1 && self.conductivity != 0) { cond[i] = sigma; }
                    var s: f64 = 0.0;
                    if (self.conductivity != 0) { s = cond[i]; }
                    var we = _bj_k_bits(eps[i]);
                    var ws = _bj_k_bits(s);
                    if (have == 0 || we != lw_e || ws != lw_s) {
                        var cav, cbv = _bj_fd2_e_coefficients(dt, dx, eps[i], s);
                        lca = cav;
                        lcb = cbv;
                        lw_e = we;
                        lw_s = ws;
                        have = 1;
                    }
                    ce[i] = lcb;
                    if (self.ca != 0) { ca[i] = lca; }
                }
            }
        }
        return Ok(0);
    }

    # The validated region [x0, x1) × [y0, y1) into r[0..4] (x0, x1, y0, y1, each end clamped to the grid): 0, or
    # InvalidParameter (x's first) recorded and its code. Mirrors `Fdtd2d::region`.
    fn region(self, x0, y0, x1, y1, r: *i64): i64 {
        var rx: i64[2];
        var ry: i64[2];
        var e = _bj_fd2_range("x", x0, x1, self.nx, &rx);
        if (e != 0) { return e; }
        e = _bj_fd2_range("y", y0, y1, self.ny, &ry);
        if (e != 0) { return e; }
        r[0] = rx[0];
        r[1] = rx[1];
        r[2] = ry[0];
        r[3] = ry[1];
        return 0;
    }

    # Sets ε_r over [x0, x1) × [y0, y1), the ends clamped to the grid; σ already set there is kept. Ok(0), or with
    # nothing modified Err(InvalidPermittivity) for an ε_r not finite and positive, Err(InvalidParameter) for a region
    # that starts outside the grid or is inverted. Mirrors `Fdtd2d::set_permittivity`.
    public fn set_permittivity(self, x0, y0, x1, y1, eps_r: f64): Result {
        var e = _bj_fd2_check_eps(eps_r);
        if (e != 0) { return Err(e); }
        var r: i64[4];
        e = self.region(x0, y0, x1, y1, &r);
        if (e != 0) { return Err(e); }
        return self.apply_region(&r, 1, eps_r, 0, 1.0, 0, 0.0);
    }

    # Sets μ_r over [x0, x1) × [y0, y1), the ends clamped. Ok(0), or with nothing modified Err(InvalidPermeability) for
    # a μ_r not finite and positive, Err(InvalidParameter) for a bad region. Mirrors `Fdtd2d::set_permeability`.
    public fn set_permeability(self, x0, y0, x1, y1, mu_r: f64): Result {
        var e = _bj_fd2_check_mu(mu_r);
        if (e != 0) { return Err(e); }
        var r: i64[4];
        e = self.region(x0, y0, x1, y1, &r);
        if (e != 0) { return Err(e); }
        return self.apply_region(&r, 0, 1.0, 1, mu_r, 0, 0.0);
    }

    # Sets σ (S/m) over [x0, x1) × [y0, y1), the ends clamped: lossy cells take E ← C_a·E + C_b·∇×H (the file
    # comment); the first lossy region maps C_a and σ, and a lossless grid keeps the cheaper lossless update. Ok(0), or
    # with nothing modified Err(InvalidParameter) for a σ negative or not finite, or a bad region. Mirrors
    # `Fdtd2d::set_conductivity`.
    public fn set_conductivity(self, x0, y0, x1, y1, sigma: f64): Result {
        var e = _bj_fd2_check_sigma(sigma);
        if (e != 0) { return Err(e); }
        var r: i64[4];
        e = self.region(x0, y0, x1, y1, &r);
        if (e != 0) { return Err(e); }
        return self.apply_region(&r, 0, 1.0, 0, 1.0, 1, sigma);
    }

    # Sets ε_r, μ_r and σ over [x0, x1) × [y0, y1) from a material, every input validated (ε_r, μ_r, σ, then the
    # region) before anything is written. Mirrors `Fdtd2d::set_material`.
    public fn set_material(self, x0, y0, x1, y1, mat: *BjMaterial): Result {
        var e = _bj_fd2_check_eps(mat.eps_r);
        if (e == 0) { e = _bj_fd2_check_mu(mat.mu_r); }
        if (e == 0) { e = _bj_fd2_check_sigma(mat.conductivity); }
        if (e != 0) { return Err(e); }
        var r: i64[4];
        e = self.region(x0, y0, x1, y1, &r);
        if (e != 0) { return Err(e); }
        return self.apply_region(&r, 1, mat.eps_r, 1, mat.mu_r, 1, mat.conductivity);
    }

    # Adds `value` to the out-of-plane field (E_z in TM, H_z in TE) at node (x, y), a soft source; a node outside the
    # grid is ignored (usize compares), and one on the outermost ring is cleared by the wall on the next step. Mirrors
    # `Fdtd2d::add_source`.
    public fn add_source(self, x, y, value: f64) {
        if (_bj_fd2_uge(x, self.nx) == 1 || _bj_fd2_uge(y, self.ny) == 1) { return 0; }
        var f: *f64 = _bj_fd2_f64p(self.fz);
        var i = y * self.nx + x;
        f[i] = f[i] + value;
        return 0;
    }

    # Replaces the reflecting walls by a CPML of the classic grading (BjCpmlParams_new) `thickness` cells a side;
    # calling it again replaces the layer (Ψ restarts at zero). Ok(0), or with the boundaries unchanged
    # Err(InvalidParameter) as try_enable_cpml_with. Mirrors `Fdtd2d::try_enable_cpml`.
    public fn try_enable_cpml(self, thickness): Result {
        var p: BjCpmlParams = BjCpmlParams_new(thickness);
        return self.try_enable_cpml_with(&p);
    }

    # Replaces the reflecting walls by a CPML of params' grading (κ and CFS-α profiles, grading order, σ_max's scale),
    # occupying the outermost thickness cells; calling it again replaces the layer. Ok(0), or with the boundaries
    # unchanged Err(InvalidParameter): "CPML thickness {t} is invalid for a {nx}×{ny} grid (need thickness ≥ 1 and
    # 2·thickness + 3 ≤ min(nx, ny))", any refusal of BjCpml_with_params, or "cannot allocate CPML auxiliary fields for
    # a {nx}×{ny} grid". Mirrors `Fdtd2d::try_enable_cpml_with`.
    public fn try_enable_cpml_with(self, params: *BjCpmlParams): Result {
        var nx = self.nx;
        var ny = self.ny;
        var t = params.thickness;
        var md = nx;
        if (_bj_fd2_uge(nx, ny) == 1) { md = ny; }
        if (_bj_cpml_fits(t, md) == 0) {
            var e1 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(e1, "CPML thickness ");
            _bj_tx_u64(e1, t);
            _bj_tx_cstr(e1, " is invalid for a ");
            _bj_tx_u64(e1, nx);
            _bj_tx_cstr(e1, "×");
            _bj_tx_u64(e1, ny);
            _bj_tx_cstr(e1, " grid (need thickness ≥ 1 and 2·thickness + 3 ≤ min(nx, ny))");
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        var blk = fl_alloc(sizeof(BjCpml));
        if (blk != 0) {
            var t2, v2 = BjCpml_with_params(params, self.dx, self.dt, blk);
            if (is_err_result(t2) == 1) {
                fl_free(blk);
                return Err(v2);
            }
            var c: *BjCpml = _bj_fd2_cpmlp(blk);
            c.attach(nx, ny);
            if (_bj_cpml_is_attached_to(blk, nx, ny) == 0) {
                BjCpml_free(blk);
                fl_free(blk);
                blk = 0;
            }
        }
        if (blk == 0) {
            var e3 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(e3, "cannot allocate CPML auxiliary fields for a ");
            _bj_tx_u64(e3, nx);
            _bj_tx_cstr(e3, "×");
            _bj_tx_u64(e3, ny);
            _bj_tx_cstr(e3, " grid");
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        if (_bj_log_on(4) == 1) {
            var cl: *BjCpml = _bj_fd2_cpmlp(blk);
            var lb[256];
            var lt[24];
            _bj_tx_init(&lt, &lb, 256);
            _bj_tx_cstr(&lt, "2D CPML enabled thickness=");
            _bj_tx_u64(&lt, t);
            _bj_tx_cstr(&lt, " sigma_max=");
            _bj_fmt_f64_debug(&lt, cl.sigma_max);
            _bj_tx_cstr(&lt, " kappa_max=");
            _bj_fmt_f64_debug(&lt, cl.kappa_max);
            _bj_tx_cstr(&lt, " alpha_max=");
            _bj_fmt_f64_debug(&lt, cl.alpha_max);
            _bj_tx_cstr(&lt, " mode=");
            if (self.mode == BJ_MODE2D_TE) { _bj_tx_cstr(&lt, "Te"); }
            else { _bj_tx_cstr(&lt, "Tm"); }
            _bj_log_text(4, &lt);
        }
        if (self.cpml != 0) {
            BjCpml_free(self.cpml);
            fl_free(self.cpml);
        }
        self.cpml = blk;
        return Ok(0);
    }

    # try_enable_cpml without the error: on invalid input (thickness 0, or 2·thickness + 3 > min(nx, ny)) logs a
    # warning and leaves the boundaries as they are. Mirrors `Fdtd2d::enable_cpml`.
    public fn enable_cpml(self, thickness) {
        var t, v = self.try_enable_cpml(thickness);
        if (is_err_result(t) == 1 && _bj_log_on(2) == 1) {
            var lb[512];
            var lt[24];
            _bj_tx_init(&lt, &lb, 512);
            _bj_tx_cstr(&lt, "enable_cpml ignored; boundaries unchanged thickness=");
            _bj_tx_u64(&lt, thickness);
            _bj_tx_cstr(&lt, " error=");
            _bj_tx_cstr(&lt, bj_last_error_display());
            _bj_log_text(2, &lt);
        }
        return 0;
    }

    # Removes the CPML (giving its storage back) and returns to the reflecting PEC (TM) or PMC (TE) walls. Mirrors
    # `Fdtd2d::disable_cpml`.
    public fn disable_cpml(self) {
        if (self.cpml != 0) {
            BjCpml_free(self.cpml);
            fl_free(self.cpml);
            self.cpml = 0;
            _bj_log(4, "2D CPML disabled");
        }
        return 0;
    }

    # The active CPML layer's address (a *BjCpml), or 0 (Rust's None). Mirrors `Fdtd2d::cpml`.
    #must_use
    public fn cpml(self): i64 {
        return self.cpml;
    }

    # The TM update, E_z, H_x, H_y, in Rust's order: H_x −= C_h·(E_z[y + 1] − E_z[y]) on rows 0..ny − 1, H_y +=
    # C_h·(E_z[x + 1] − E_z[x]) for x < nx − 1 on every row (each cell's update reads only E_z, so the rows
    # interleave), the CPML's H terms, E_z ← C_a·E_z where lossy, E_z += C_b·((H_y[x] − H_y[x − 1]) − (H_x[y] −
    # H_x[y − 1])) on the interior, the CPML's E_z terms, the PEC wall. Mirrors `Fdtd2d::step_tm`.
    fn step_tm(self) {
        var nx = self.nx;
        var ny = self.ny;
        var n = nx * ny;
        var fz: *f64 = _bj_fd2_f64p(self.fz);
        var fx: *f64 = _bj_fd2_f64p(self.fx);
        var fy: *f64 = _bj_fd2_f64p(self.fy);
        var ce: *f64 = _bj_fd2_f64p(self.ce);
        var ch: *f64 = _bj_fd2_f64p(self.ch);
        var w: *f64 = _bj_fd2_f64p(self.work);
        var w2: *f64 = _bj_fd2_f64p(self.work + nx * 8);
        for (var y = 0; y < ny; y = y + 1) {
            var r = y * nx;
            if (y < ny - 1) { _bj_fd2_diff(fx + r, ch + r, fz + r + nx, fz + r, w, w2, nx, 0); }
            _bj_fd2_diff(fy + r, ch + r, fz + r + 1, fz + r, w, w2, nx - 1, 1);
        }
        if (self.cpml != 0) {
            _bj_fd2_cpml_fx(self.cpml, fx, fz, ch, nx, ny, -1.0, w);
            _bj_fd2_cpml_fy(self.cpml, fy, fz, ch, nx, ny, 1.0);
        }
        if (self.ca != 0) { _bj_fd2_scale(fz, _bj_fd2_f64p(self.ca), n); }
        for (var y2 = 1; y2 < ny - 1; y2 = y2 + 1) {
            var r2 = y2 * nx;
            _bj_fd2_curl(fz + r2, ce + r2, fy + r2, fx + r2, fx + r2 - nx, w, w2, nx, 1);
        }
        if (self.cpml != 0) { _bj_fd2_cpml_fz(self.cpml, fz, fx, fy, ce, nx, ny, 1.0, w); }
        _bj_fd2_walls(fz, nx, ny);
        return 0;
    }

    # The TE update, H_z, E_x, E_y, in Rust's order: E ← C_a·E where lossy, E_x += C_b·(H_z[y + 1] − H_z[y]) on rows
    # 0..ny − 1, E_y −= C_b·(H_z[x + 1] − H_z[x]) for x < nx − 1 on every row, the CPML's E terms, H_z −=
    # C_h·((E_y[x] − E_y[x − 1]) − (E_x[y] − E_x[y − 1])) on the interior, the CPML's H_z terms, the PMC wall. Mirrors
    # `Fdtd2d::step_te`.
    fn step_te(self) {
        var nx = self.nx;
        var ny = self.ny;
        var n = nx * ny;
        var fz: *f64 = _bj_fd2_f64p(self.fz);
        var fx: *f64 = _bj_fd2_f64p(self.fx);
        var fy: *f64 = _bj_fd2_f64p(self.fy);
        var ce: *f64 = _bj_fd2_f64p(self.ce);
        var ch: *f64 = _bj_fd2_f64p(self.ch);
        var w: *f64 = _bj_fd2_f64p(self.work);
        var w2: *f64 = _bj_fd2_f64p(self.work + nx * 8);
        if (self.ca != 0) {
            var ca: *f64 = _bj_fd2_f64p(self.ca);
            _bj_fd2_scale(fx, ca, n);
            _bj_fd2_scale(fy, ca, n);
        }
        for (var y = 0; y < ny; y = y + 1) {
            var r = y * nx;
            if (y < ny - 1) { _bj_fd2_diff(fx + r, ce + r, fz + r + nx, fz + r, w, w2, nx, 1); }
            _bj_fd2_diff(fy + r, ce + r, fz + r + 1, fz + r, w, w2, nx - 1, 0);
        }
        if (self.cpml != 0) {
            _bj_fd2_cpml_fx(self.cpml, fx, fz, ce, nx, ny, 1.0, w);
            _bj_fd2_cpml_fy(self.cpml, fy, fz, ce, nx, ny, -1.0);
        }
        for (var y2 = 1; y2 < ny - 1; y2 = y2 + 1) {
            var r2 = y2 * nx;
            _bj_fd2_curl(fz + r2, ch + r2, fy + r2, fx + r2, fx + r2 - nx, w, w2, nx, 0);
        }
        if (self.cpml != 0) { _bj_fd2_cpml_fz(self.cpml, fz, fx, fy, ch, nx, ny, -1.0, w); }
        _bj_fd2_walls(fz, nx, ny);
        return 0;
    }

    # Advances the simulation one time step: the mode's update, the outermost ring always the PEC (TM) or PMC (TE)
    # wall. Mirrors `Fdtd2d::step_once`.
    public fn step_once(self) {
        if (self.mode == BJ_MODE2D_TE) { self.step_te(); }
        else { self.step_tm(); }
        self.step = self.step + 1;
        return 0;
    }

    # Runs `steps` time steps (a usize). Before each, when (sx, sy) is in the grid, adds amplitude·sin(2π·frequency·t)
    # at it as a soft source, t = step·dt; BJ_FDTD2D_NO_SOURCE for sx (or any node outside the grid) injects nothing,
    # as Rust's None. The sample at its range edges runs with an unbounded exponent (src/crmath_edge.cyr's
    # _bj_e_fd_source; ADR 0002 row 18, M6 part 4f). Mirrors `Fdtd2d::run`.
    public fn run(self, steps, sx, sy, frequency: f64, amplitude: f64) {
        if (_bj_log_on(4) == 1) {
            var lb[256];
            var lt[24];
            _bj_tx_init(&lt, &lb, 256);
            _bj_tx_cstr(&lt, "2D FDTD run started steps=");
            _bj_tx_u64(&lt, steps);
            _bj_tx_cstr(&lt, " source=");
            if (sx == BJ_FDTD2D_NO_SOURCE) {
                _bj_tx_cstr(&lt, "None");
            } else {
                _bj_tx_cstr(&lt, "Some((");
                _bj_tx_u64(&lt, sx);
                _bj_tx_cstr(&lt, ", ");
                _bj_tx_u64(&lt, sy);
                _bj_tx_cstr(&lt, "))");
            }
            _bj_tx_cstr(&lt, " frequency=");
            _bj_fmt_f64_debug(&lt, frequency);
            _bj_tx_cstr(&lt, " amplitude=");
            _bj_fmt_f64_debug(&lt, amplitude);
            if (self.cpml == 0) { _bj_tx_cstr(&lt, " cpml=None"); }
            else {
                var lc: *BjCpml = _bj_fd2_cpmlp(self.cpml);
                _bj_tx_cstr(&lt, " cpml=Some(");
                _bj_tx_u64(&lt, lc.thickness);
                _bj_tx_cstr(&lt, ")");
            }
            _bj_log_text(4, &lt);
        }
        var w2pi: f64 = 2.0 * _BJ_FD2_PI;
        for (var k = 0; _bj_fd2_uge(k, steps) == 0; k = k + 1) {
            if (sx != BJ_FDTD2D_NO_SOURCE) {
                var sf: f64 = _bj_fd2_u2f(self.step);
                var value: f64 = _bj_e_fd_source(sf, self.dt, w2pi, frequency, amplitude);
                self.add_source(sx, sy, value);
            }
            self.step_once();
        }
        return 0;
    }

    # The simulation time step·dt in seconds, rounded once past 2^53 (ADR 0002 row 13, M6 part 4a). Mirrors
    # `Fdtd2d::time`.
    #must_use
    public fn time(self): f64 {
        var t: f64 = _bj_e_fd_time(self.step, self.dt);
        return t;
    }

    # The total electromagnetic energy in the grid, Σ ½·m_z·k_z·f_z² + ½·m_xy·k_xy·(f_x² + f_y²) times dx², in Rust's
    # order from +0: TM's (ε_r, ε₀) for f_z and (μ_r, μ₀) for f_x, f_y; TE's the other way. Where a product or a sum
    # leaves the normal range for finite fields, media and dx (f² past DBL_MAX where dx² brings the energy back, or
    # below the range), the whole sum runs with an unbounded exponent and its product with dx² is rounded once (ADR
    # 0002 row 18, M6 part 4f): each cell tests a band (f_z 0 or of 2^±400, ½·m·k of 2^±200, f_x² + f_y² 0 from zero
    # fields or of 2^-800 to 2^802) inside which every product provably stays normal, and a cell outside it takes the
    # exact test (_bj_fd2_energy_cell). A medium's band result is kept while the next cell's medium is the same (a NaN
    # medium is retested). Mirrors `Fdtd2d::total_energy`.
    #must_use
    public fn total_energy(self): f64 {
        var n = self.nx * self.ny;
        var dx: f64 = self.dx;
        var area: f64 = dx * dx;
        var zm: *f64 = _bj_fd2_f64p(self.permittivity);
        var zc: f64 = BJ_EPSILON_0;
        var xym: *f64 = _bj_fd2_f64p(self.permeability);
        var xyc: f64 = BJ_MU_0;
        if (self.mode == BJ_MODE2D_TE) {
            zm = _bj_fd2_f64p(self.permeability);
            zc = BJ_MU_0;
            xym = _bj_fd2_f64p(self.permittivity);
            xyc = BJ_EPSILON_0;
        }
        var fz: *f64 = _bj_fd2_f64p(self.fz);
        var fx: *f64 = _bj_fd2_f64p(self.fx);
        var fy: *f64 = _bj_fd2_f64p(self.fy);
        var energy: f64 = 0.0;
        var edge = 0;
        var pmz: f64 = -1.0;
        var pmx: f64 = -1.0;
        var tz = 0;
        var tx = 0;
        for (var i = 0; i < n; i = i + 1) {
            var z: f64 = fz[i];
            var mzv: f64 = zm[i];
            var a: f64 = 0.5 * mzv;
            var b: f64 = a * zc;
            var c: f64 = b * z;
            var d: f64 = c * z;
            energy = energy + d;
            var x: f64 = fx[i];
            var y: f64 = fy[i];
            var xx: f64 = x * x;
            var yy: f64 = y * y;
            var s: f64 = xx + yy;
            var mxv: f64 = xym[i];
            var a2: f64 = 0.5 * mxv;
            var b2: f64 = a2 * xyc;
            var c2: f64 = b2 * s;
            energy = energy + c2;
            if (mzv != pmz) {
                var bw = b;
                var bq = bw << 1;
                tz = ((bq >> 53) - 823) | (1223 - (bq >> 53));
                pmz = mzv;
            }
            if (mxv != pmx) {
                var b2w = b2;
                var b2q = b2w << 1;
                tx = ((b2q >> 53) - 823) | (1223 - (b2q >> 53));
                pmx = mxv;
            }
            var zw = z;
            var sw = s;
            var zq = zw << 1;
            var sq = sw << 1;
            var t = ((((zq - 1) >> 53) - 623) | (1423 - (zq >> 53))) | tz | tx;
            t = t | ((((sq - 1) >> 53) - 223) | (1825 - (sq >> 53)));
            if (sq == 0) {
                var xw = x;
                var yw = y;
                if (((xw | yw) << 1) != 0) { t = -1; }
            }
            if (t < 0 && edge == 0) { edge = _bj_fd2_energy_cell(z, mzv, zc, x, y, mxv, xyc); }
        }
        var ew = energy;
        var aw = area;
        var dw = dx;
        if (edge == 0 && ((_bj_e_nrm(ew) < 0 && (ew << 1) != 0) || _bj_e_zok(aw, dw, dw) == 0)) { edge = 1; }
        var e: f64 = energy * area;
        if (edge == 1 && _bj_fd2_finite_grid(self) == 1) { e = _bj_fd2_energy_ux(self); }
        return e;
    }
}
