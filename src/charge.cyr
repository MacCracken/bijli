# charge.cyr — point charges, Coulomb's law, the Lorentz force, cyclotron motion (port of rust-old/src/charge.rs,
# M1 part 3d).
#
# SI units: coulombs, newtons, metres, seconds. Every formula is Rust's in Rust's order (the golden rows compare bit for
# bit, class A), but for the three that are one product or quotient of inputs and constants (the Coulomb energy,
# cyclotron frequency and Larmor radius), which are rounded once (ADR 0002 row 13). The constants (BJ_ELEMENTARY_CHARGE,
# BJ_ELECTRON_MASS, BJ_PROTON_MASS) are src/constants.cyr's. Shapes as src/field.cyr's: a `[f64; 3]` is the address of
# three f64; a `Result<FieldVector>` writes through an out pointer; a fallible constructor of a struct over 16 bytes
# writes through `out` too.

private

# A point charge with its position and velocity. Mirrors `charge::PointCharge`; Rust's `[f64; 3]` fields are
# `(f64, f64, f64)` tuples stored inline (`q.position.0` for `q.position[0]`; probe p15), 64 bytes, by value.
public struct BjPointCharge {
    charge: f64;
    mass: f64;
    position: (f64, f64, f64);
    velocity: (f64, f64, f64);
}

# A point charge into out; InvalidParameter when mass is NaN or not positive, out untouched. Mirrors
# `PointCharge::new`.
public fn BjPointCharge_new(charge: f64, mass: f64, position: *f64, velocity: *f64, out: *BjPointCharge): Result {
    if (mass != mass || mass <= 0.0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "mass must be positive, got ");
        _bj_fmt_f64_display(t, mass);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    out.charge = charge;
    out.mass = mass;
    out.position = (position[0], position[1], position[2]);
    out.velocity = (velocity[0], velocity[1], velocity[2]);
    return Ok(0);
}

# A particle of charge q and mass m at rest at `position`.
#must_use
fn _bj_particle_at(q: f64, m: f64, position: *f64): BjPointCharge {
    var p: BjPointCharge;
    p.charge = q;
    p.mass = m;
    p.position = (position[0], position[1], position[2]);
    p.velocity = (0.0, 0.0, 0.0);
    return p;
}

# An electron at rest at `position`: charge −e, the electron mass. Mirrors `PointCharge::electron`.
#must_use
public fn BjPointCharge_electron(position: *f64): BjPointCharge {
    var q: f64 = -BJ_ELEMENTARY_CHARGE;
    var p: BjPointCharge = _bj_particle_at(q, BJ_ELECTRON_MASS, position);
    return p;
}

# A proton at rest at `position`: charge e, the proton mass. Mirrors `PointCharge::proton`.
#must_use
public fn BjPointCharge_proton(position: *f64): BjPointCharge {
    var p: BjPointCharge = _bj_particle_at(BJ_ELEMENTARY_CHARGE, BJ_PROTON_MASS, position);
    return p;
}

# Writes a `(f64, f64, f64)` tuple's elements to p[0..3]: the `[f64; 3]` the field functions take.
fn _bj_tuple3_put(t: (f64, f64, f64), p: *f64): i64 {
    p[0] = t.0;
    p[1] = t.1;
    p[2] = t.2;
    return 0;
}

impl BjPointCharge {
    # E at field_pos from this charge, into out: bj_electric_field_point_charge's value and errors. Mirrors
    # `PointCharge::electric_field_at`.
    public fn electric_field_at(self, field_pos: *f64, out: *BjFieldVector): Result {
        var pos: f64[3];
        _bj_tuple3_put(self.position, &pos);
        return bj_electric_field_point_charge(self.charge, &pos, field_pos, out);
    }

    # V at field_pos from this charge: bj_electric_potential_point_charge's value and errors. Mirrors
    # `PointCharge::electric_potential_at`.
    public fn electric_potential_at(self, field_pos: *f64): Result {
        var pos: f64[3];
        _bj_tuple3_put(self.position, &pos);
        return bj_electric_potential_point_charge(self.charge, &pos, field_pos);
    }

    # B at field_pos from this moving charge (Biot–Savart), into out: bj_magnetic_field_moving_charge's. Mirrors
    # `PointCharge::magnetic_field_at`.
    public fn magnetic_field_at(self, field_pos: *f64, out: *BjFieldVector): Result {
        var pos: f64[3];
        var vel: f64[3];
        _bj_tuple3_put(self.position, &pos);
        _bj_tuple3_put(self.velocity, &vel);
        return bj_magnetic_field_moving_charge(self.charge, &pos, &vel, field_pos, out);
    }

    # The Lorentz force on this charge, moving with its velocity, in fields E and B: bj_lorentz_force's. Mirrors
    # `PointCharge::lorentz_force_in`.
    #must_use
    public fn lorentz_force_in(self, electric_field: BjFieldVector, magnetic_field: BjFieldVector): BjFieldVector {
        var v: BjFieldVector = BjFieldVector_new(self.velocity.0, self.velocity.1, self.velocity.2);
        var f: BjFieldVector = bj_lorentz_force(self.charge, v, electric_field, magnetic_field);
        return f;
    }
}

# F = kq₁q₂/r²·r̂ (N) on q1 from q2, as k·q₁·q₂·(1/r)³ times the offset q1 − q2 (away from q2 when they repel).
# Singularity when the exact r² < 10^-30 (ADR 0002 row 17). Mirrors `charge::coulomb_force`.
public fn bj_coulomb_force(q1: BjPointCharge, q2: BjPointCharge, out: *BjFieldVector): Result {
    var dx: f64 = q1.position.0 - q2.position.0;
    var dy: f64 = q1.position.1 - q2.position.1;
    var dz: f64 = q1.position.2 - q2.position.2;
    var r_sq: f64 = dx * dx + dy * dy + dz * dz;
    var band = _bj_x_band(r_sq, _BJ_FIELD_R2_MIN);
    if (band == 2) {
        var pa: f64[3];
        var pb: f64[3];
        pa[0] = q1.position.0;
        pa[1] = q1.position.1;
        pa[2] = q1.position.2;
        pb[0] = q2.position.0;
        pb[1] = q2.position.1;
        pb[2] = q2.position.2;
        band = _bj_x_r2_below(&pa, &pb, 30);
    }
    if (band == 1) { return Err(_bj_err_singularity()); }
    var rt: f64 = f64_sqrt(r_sq);
    var inv_r: f64 = 1.0 / rt;
    var factor: f64 = BJ_COULOMB_K * q1.charge * q2.charge * inv_r * inv_r * inv_r;
    out.x = factor * dx;
    out.y = factor * dy;
    out.z = factor * dz;
    return Ok(0);
}

# One component of the Lorentz force, (e + (a·b − c·d))·q, given Rust's s = e + (a·b − c·d): s·q where Rust's chain is
# the unbounded one (s in the band, an exact 0 from exact products, or a part not finite: src/crmath_vx.cyr's guard),
# else the chain with an unbounded exponent and the product by q rounded once.
#must_use
fn _bj_ch_lorentz1(e: f64, a: f64, b: f64, c: f64, d: f64, s: f64, q: f64): f64 {
    var f: f64 = s * q;
    var dq: f64 = (q - q) + (e - e);
    if (_bj_vx_band(s) == 1 || dq != 0.0 || _bj_vx_finite4(a, b, c, d) == 0) { return f; }
    if (s == 0.0) {
        var p: f64 = a * b;
        var r: f64 = c * d;
        if (_bj_vx_exact(a, b, p) == 1 && _bj_vx_exact(c, d, r) == 1) { return f; }
    }
    var vs, ve = _bj_vx_cross1(a, b, c, d);
    var es, ee = _bj_k_ux_from(e);
    var ss, se = _bj_k_ux_add(es, ee, vs, ve);
    var qs, qe = _bj_k_ux_from(q);
    var u: f64 = _bj_k_ux_mul_f64(ss, se, qs, qe);
    return u;
}

# F = q(E + v × B) (N), as (E + v × B)·q; at a range edge (a product past DBL_MAX or below 2^-1022 that the result can
# see) the chain with an unbounded exponent, each product by q rounded once (ADR 0002 row 18). Mirrors
# `charge::lorentz_force`.
#must_use
#pure
public fn bj_lorentz_force(charge: f64, velocity: BjFieldVector, electric_field: BjFieldVector,
  magnetic_field: BjFieldVector): BjFieldVector {
    var v: BjFieldVector = velocity;
    var b: BjFieldVector = magnetic_field;
    var e: BjFieldVector = electric_field;
    var sx: f64 = e.x + (v.y * b.z - v.z * b.y);
    var sy: f64 = e.y + (v.z * b.x - v.x * b.z);
    var sz: f64 = e.z + (v.x * b.y - v.y * b.x);
    var w: BjFieldVector;
    w.x = sx * charge;
    w.y = sy * charge;
    w.z = sz * charge;
    # Each s's biased exponent in [123, 2046] is |s| ∈ [2^-900, DBL_MAX] (src/crmath_vx.cyr's band); q finite.
    var cq: f64 = charge;
    var ex = (load64(&sx) >> 52) & 0x7FF;
    var ey = (load64(&sy) >> 52) & 0x7FF;
    var ez = (load64(&sz) >> 52) & 0x7FF;
    var eq = (load64(&cq) >> 52) & 0x7FF;
    if (((ex - 123) | (ey - 123) | (ez - 123) | (2046 - ex) | (2046 - ey) | (2046 - ez) | (2046 - eq)) >= 0) {
        return w;
    }
    # A component that is 0 through zero factors and a zero E is exact; so is one in the band.
    var hard = 0;
    if (((ex - 123) | (2046 - ex)) < 0 && !(sx == 0.0 && e.x == 0.0 && (v.y == 0.0 || b.z == 0.0) && (v.z == 0.0
          || b.y == 0.0))) { hard = 1; }
    if (((ey - 123) | (2046 - ey)) < 0 && !(sy == 0.0 && e.y == 0.0 && (v.z == 0.0 || b.x == 0.0) && (v.x == 0.0
          || b.z == 0.0))) { hard = 1; }
    if (((ez - 123) | (2046 - ez)) < 0 && !(sz == 0.0 && e.z == 0.0 && (v.x == 0.0 || b.y == 0.0) && (v.y == 0.0
          || b.x == 0.0))) { hard = 1; }
    if (hard == 0 && eq != 2047) { return w; }
    var dq: f64 = charge - charge;
    var dv: f64 = (v.x - v.x) + (v.y - v.y) + (v.z - v.z) + (e.x - e.x) + (e.y - e.y) + (e.z - e.z);
    dv = dv + (b.x - b.x) + (b.y - b.y) + (b.z - b.z) + dq;
    if (dv != 0.0) { return w; }                            # a non-finite part keeps Rust's chain
    var fx: f64 = _bj_ch_lorentz1(e.x, v.y, b.z, v.z, b.y, sx, charge);
    var fy: f64 = _bj_ch_lorentz1(e.y, v.z, b.x, v.x, b.z, sy, charge);
    var fz: f64 = _bj_ch_lorentz1(e.z, v.x, b.y, v.y, b.x, sz, charge);
    w.x = fx;
    w.y = fy;
    w.z = fz;
    return w;
}

# p = qd (C·m). Mirrors `charge::dipole_moment`.
#must_use
#pure
public fn bj_dipole_moment(charge: f64, separation: f64): f64 {
    var p: f64 = charge * separation;
    return p;
}

# U = qV (J). Mirrors `charge::potential_energy`.
#must_use
#pure
public fn bj_potential_energy(charge: f64, potential: f64): f64 {
    var u: f64 = charge * potential;
    return u;
}

# U = kq₁q₂/r (J), correctly rounded (ADR 0002 row 13; an infinite or NaN operand keeps Rust's (k·q₁·q₂)/r).
# InvalidParameter when r is NaN or negative, Singularity below 1e-30 m (field.rs's check_radial_distance). Mirrors
# `charge::coulomb_potential_energy`.
public fn bj_coulomb_potential_energy(q1: f64, q2: f64, distance: f64): Result {
    var t, v = _bj_check_radial_distance(distance);
    if (is_err_result(t) == 1) { return Err(v); }
    if (_bj_is_finite(q1) == 0 || _bj_is_finite(q2) == 0 || _bj_is_finite(distance) == 0) {
        var u: f64 = BJ_COULOMB_K * q1 * q2 / distance;
        return Ok(u);
    }
    var cr: f64 = _bj_k_cr_mul3_div(BJ_COULOMB_K, q1, q2, distance);
    return Ok(cr);
}

# A particle mass's error for `what`: DivisionByZero "mass cannot be zero for <what>" for 0, InvalidParameter "mass
# must be positive for <what>, got <mass>" for NaN or negative; else 0. Mirrors charge.rs's private `check_mass`.
fn _bj_check_mass(mass: f64, what): i64 {
    if (mass == 0.0) {
        var t = _bj_err_reason(BJ_ERR_DIVISION_BY_ZERO);
        _bj_tx_cstr(t, "mass cannot be zero for ");
        _bj_tx_cstr(t, what);
        return BJ_ERR_DIVISION_BY_ZERO;
    }
    if (mass != mass || mass <= 0.0) {
        var t2 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t2, "mass must be positive for ");
        _bj_tx_cstr(t2, what);
        _bj_tx_cstr(t2, ", got ");
        _bj_fmt_f64_display(t2, mass);
        return BJ_ERR_INVALID_PARAMETER;
    }
    return 0;
}

# ω_c = |q|B/m (rad/s) for |B| ≥ 0 (T), correctly rounded (ADR 0002 row 13; an infinite operand keeps Rust's
# (|q|·B)/m). DivisionByZero for a zero mass; InvalidParameter for a negative mass, a NaN
# charge, or a negative or NaN |B| (in that order). Mirrors `charge::cyclotron_frequency`.
public fn bj_cyclotron_frequency(charge: f64, mass: f64, b_magnitude: f64): Result {
    var c = _bj_check_mass(mass, "cyclotron frequency");
    if (c != 0) { return Err(c); }
    if (charge != charge) { return Err(_bj_err_invalid_parameter("charge must not be NaN")); }
    if (b_magnitude != b_magnitude || b_magnitude < 0.0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "|B| must be non-negative, got ");
        _bj_fmt_f64_display(t, b_magnitude);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var aq: f64 = f64_abs(charge);
    if (_bj_is_finite(aq) == 0 || _bj_is_finite(b_magnitude) == 0 || _bj_is_finite(mass) == 0) {
        var w: f64 = aq * b_magnitude / mass;
        return Ok(w);
    }
    var cr: f64 = _bj_k_cr_mul_div(aq, b_magnitude, mass);
    return Ok(cr);
}

# r_L = m|v⊥|/(|q|B) (m) for |B| > 0, correctly rounded (ADR 0002 row 13: Rust divides in two steps, m·|v⊥|/|q|/B,
# so a tiny |q|·B can't underflow, but m·|v⊥| still can; an infinite operand keeps that chain). DivisionByZero for a
# zero mass, charge or |B|; InvalidParameter for a negative mass or |B|, or a NaN argument (in Rust's order). Mirrors
# `charge::larmor_radius`.
public fn bj_larmor_radius(mass: f64, v_perp: f64, charge: f64, b_magnitude: f64): Result {
    var c = _bj_check_mass(mass, "Larmor radius");
    if (c != 0) { return Err(c); }
    if (v_perp != v_perp || charge != charge) {
        return Err(_bj_err_invalid_parameter("v_perp and charge must not be NaN"));
    }
    if (charge == 0.0) { return Err(_bj_err_division_by_zero("charge cannot be zero for Larmor radius")); }
    if (b_magnitude == 0.0) { return Err(_bj_err_division_by_zero("|B| cannot be zero for Larmor radius")); }
    if (b_magnitude != b_magnitude || b_magnitude <= 0.0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "|B| must be positive, got ");
        _bj_fmt_f64_display(t, b_magnitude);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var av: f64 = f64_abs(v_perp);
    var aq: f64 = f64_abs(charge);
    var fin = _bj_is_finite(mass) + _bj_is_finite(av) + _bj_is_finite(aq) + _bj_is_finite(b_magnitude);
    if (fin != 4) {
        var r: f64 = mass * av / aq / b_magnitude;
        return Ok(r);
    }
    var cr: f64 = _bj_k_cr_mul2_div2(mass, av, aq, b_magnitude);
    return Ok(cr);
}
