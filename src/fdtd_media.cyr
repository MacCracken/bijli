# fdtd_media.cyr — fdtd.rs's FDTD media (M5 part 1c): the lossy material's update coefficients, the Drude, Lorentz and
# Debye models' auxiliary-differential-equation (ADE) coefficients with the gold, silver and water presets, and the
# subpixel permittivity averages. SI units: conductivities in S/m, angular frequencies in rad/s, times in seconds.
#
# Each material is a small struct passed by value. Its `new` stores the fields unchecked, as Rust's does, and
# `try_new` validates them. The coefficients are Rust's chains, as written. The presets' fields are generated from
# the oracle into src/fdtd_media_data.cyr.
#
# bijli's one harmonic convention is e^{+jωt} with IEEE handedness (src/complex.cyr's header; ADR 0002 row 5). Rust
# stated the Drude, Lorentz and Debye permittivities in e^{−iωt}; they are stated here in e^{+jωt}. The ADE
# coefficients are time-domain, so no number changes.

private

var _BJ_FM_INF: f64 = 0x7FF0000000000000;
var _BJ_FM_NAN: f64 = 0x7FF8000000000000;

# 1 when x is finite and strictly positive (NaN-safe). Mirrors fdtd.rs's `is_positive_finite`.
#must_use
fn _bj_fm_pos(x: f64): i64 {
    if (x > 0.0 && x < _BJ_FM_INF) { return 1; }
    return 0;
}

# 0 when value is a valid relative permittivity (finite, > 0), else InvalidPermittivity recorded and its code. Mirrors
# fdtd.rs's `check_permittivity`.
fn _bj_fm_perm(value: f64): i64 {
    if (_bj_fm_pos(value) == 1) { return 0; }
    return _bj_err_invalid_permittivity(value);
}

# 0 when value is finite and non-negative (−0 included), else InvalidParameter "{name} must be finite and
# non-negative, got {value}" recorded and its code. Mirrors fdtd.rs's `check_non_negative`.
fn _bj_fm_nonneg(name, value: f64): i64 {
    if (value >= 0.0 && value < _BJ_FM_INF) { return 0; }
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, name);
    _bj_tx_cstr(t, " must be finite and non-negative, got ");
    _bj_fmt_f64_display(t, value);
    return BJ_ERR_INVALID_PARAMETER;
}

# 0 when value is finite and strictly positive, else InvalidParameter "{name} must be finite and positive, got
# {value}" recorded and its code. Mirrors fdtd.rs's `check_positive`.
fn _bj_fm_positive(name, value: f64): i64 {
    if (_bj_fm_pos(value) == 1) { return 0; }
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, name);
    _bj_tx_cstr(t, " must be finite and positive, got ");
    _bj_fmt_f64_display(t, value);
    return BJ_ERR_INVALID_PARAMETER;
}

# ── the lossy material ──────────────────────────────────────────────────────────────────────────────────────────────

# A lossy material with static conductivity σ: E^{n+1} = C_a·E^n + C_b·(∇×H), C_a = (1 − σΔt/2ε)/(1 + σΔt/2ε),
# C_b = (Δt/ε)/(1 + σΔt/2ε). `eps_r` is the relative permittivity, `conductivity` σ in S/m. Mirrors `LossyMaterial`.
public struct BjLossyMaterial {
    eps_r: f64;
    conductivity: f64;
}

# A lossy material, unchecked (ε_r ≤ 0 makes the coefficients meaningless; BjLossyMaterial_try_new checks). Mirrors
# `LossyMaterial::new`.
#must_use
public fn BjLossyMaterial_new(eps_r: f64, conductivity: f64): BjLossyMaterial {
    var m: BjLossyMaterial;
    m.eps_r = eps_r;
    m.conductivity = conductivity;
    return m;
}

# A lossy material into *out: Ok(0), or with out untouched Err(InvalidPermittivity) unless ε_r is finite and positive,
# Err(InvalidParameter) "conductivity must be finite and non-negative, got {σ}". Mirrors `LossyMaterial::try_new`.
#must_use
public fn BjLossyMaterial_try_new(eps_r: f64, conductivity: f64, out: *BjLossyMaterial): Result {
    var e = _bj_fm_perm(eps_r);
    if (e == 0) { e = _bj_fm_nonneg("conductivity", conductivity); }
    if (e != 0) { return Err(e); }
    out.eps_r = eps_r;
    out.conductivity = conductivity;
    return Ok(0);
}

impl BjLossyMaterial {
    # The E-update coefficients (C_a, C_b) for steps dt and dx; dt > 0, dx > 0 and a valid material assumed. Mirrors
    # `LossyMaterial::update_coefficients`.
    #must_use
    public fn update_coefficients(self, dt: f64, dx: f64): (f64, f64) {
        var eps: f64 = self.eps_r * BJ_EPSILON_0;
        var sdt: f64 = self.conductivity * dt;
        var eps2: f64 = 2.0 * eps;
        var s: f64 = sdt / eps2;
        var num: f64 = 1.0 - s;
        var den: f64 = 1.0 + s;
        var ca: f64 = num / den;
        var edx: f64 = eps * dx;
        var q: f64 = dt / edx;
        var cb: f64 = q / den;
        return (ca, cb);
    }
}

# ── the Drude model ─────────────────────────────────────────────────────────────────────────────────────────────────

# The Drude model of metals and plasmas: ε(ω) = ε_∞ − ω_p²/(ω² − jγω) (e^{+jωt}). Its polarization current obeys
# dJ/dt + γJ = ε₀ω_p²E. `eps_inf` is ε_∞, `omega_p` the plasma frequency ω_p and `gamma` the collision frequency γ,
# both in rad/s. Mirrors `DrudeMaterial`.
public struct BjDrudeMaterial {
    eps_inf: f64;
    omega_p: f64;
    gamma: f64;
}

# A Drude material, unchecked (ε_∞ = 0 makes κ infinite; BjDrudeMaterial_try_new checks). Mirrors
# `DrudeMaterial::new`.
#must_use
public fn BjDrudeMaterial_new(eps_inf: f64, omega_p: f64, gamma: f64): BjDrudeMaterial {
    var m: BjDrudeMaterial;
    m.eps_inf = eps_inf;
    m.omega_p = omega_p;
    m.gamma = gamma;
    return m;
}

# A Drude material into *out: Ok(0), or with out untouched Err(InvalidPermittivity) unless ε_∞ is finite and positive,
# Err(InvalidParameter) when ω_p ("plasma frequency omega_p") or γ ("damping gamma") is negative or not finite. Mirrors
# `DrudeMaterial::try_new`.
#must_use
public fn BjDrudeMaterial_try_new(eps_inf: f64, omega_p: f64, gamma: f64, out: *BjDrudeMaterial): Result {
    var e = _bj_fm_perm(eps_inf);
    if (e == 0) { e = _bj_fm_nonneg("plasma frequency omega_p", omega_p); }
    if (e == 0) { e = _bj_fm_nonneg("damping gamma", gamma); }
    if (e != 0) { return Err(e); }
    out.eps_inf = eps_inf;
    out.omega_p = omega_p;
    out.gamma = gamma;
    return Ok(0);
}

# Gold at optical frequencies (approximate). Mirrors `DrudeMaterial::gold`.
#must_use
public fn BjDrudeMaterial_gold(): BjDrudeMaterial {
    var m: BjDrudeMaterial = BjDrudeMaterial_new(_BJ_GOLD_EPS_INF, _BJ_GOLD_OMEGA_P, _BJ_GOLD_GAMMA);
    return m;
}

# Silver at optical frequencies (approximate). Mirrors `DrudeMaterial::silver`.
#must_use
public fn BjDrudeMaterial_silver(): BjDrudeMaterial {
    var m: BjDrudeMaterial = BjDrudeMaterial_new(_BJ_SILVER_EPS_INF, _BJ_SILVER_OMEGA_P, _BJ_SILVER_GAMMA);
    return m;
}

impl BjDrudeMaterial {
    # The ADE coefficients (α, β, κ) of the current J: α = (2 − γΔt)/(2 + γΔt), β = ε₀ω_p²Δt/(2 + γΔt) and
    # κ = Δt/(ε₀ε_∞), for the trapezoidal J^{n+1} = αJ^n + β(E^{n+1} + E^n) and
    # E^{n+1} = E^n + κ[(∇×H)^{n+½} − ½(J^{n+1} + J^n)] (Taflove & Hagness, ch. 9); dt > 0 and a valid material
    # assumed. Mirrors `DrudeMaterial::ade_coefficients`.
    #must_use
    public fn ade_coefficients(self, dt: f64): (f64, f64, f64) {
        var gdt: f64 = self.gamma * dt;
        var am: f64 = 2.0 - gdt;
        var ap: f64 = 2.0 + gdt;
        var alpha: f64 = am / ap;
        var b: f64 = BJ_EPSILON_0 * self.omega_p;
        b = b * self.omega_p;
        b = b * dt;
        var beta: f64 = b / ap;
        var ei: f64 = BJ_EPSILON_0 * self.eps_inf;
        var kappa: f64 = dt / ei;
        return (alpha, beta, kappa);
    }
}

# ── the Lorentz model ───────────────────────────────────────────────────────────────────────────────────────────────

# The Lorentz oscillator of a dielectric resonance: ε(ω) = ε_∞ + Δε·ω₀²/(ω₀² − ω² + jγω) (e^{+jωt}). Its polarization
# obeys d²P/dt² + γ·dP/dt + ω₀²P = ε₀Δεω₀²E. `eps_inf` is ε_∞, `delta_eps` the oscillator strength Δε, `omega_0` the
# resonance ω₀ and `gamma` the damping γ, in rad/s. Mirrors `LorentzMaterial`.
public struct BjLorentzMaterial {
    eps_inf: f64;
    delta_eps: f64;
    omega_0: f64;
    gamma: f64;
}

# A Lorentz material, unchecked (BjLorentzMaterial_try_new checks). Mirrors `LorentzMaterial::new`.
#must_use
public fn BjLorentzMaterial_new(eps_inf: f64, delta_eps: f64, omega_0: f64, gamma: f64): BjLorentzMaterial {
    var m: BjLorentzMaterial;
    m.eps_inf = eps_inf;
    m.delta_eps = delta_eps;
    m.omega_0 = omega_0;
    m.gamma = gamma;
    return m;
}

# A Lorentz material into *out: Ok(0), or with out untouched Err(InvalidPermittivity) unless ε_∞ is finite and
# positive, Err(InvalidParameter) when Δε ("oscillator strength delta_eps") or γ ("damping gamma") is negative or not
# finite, or ω₀ ("resonance frequency omega_0") not finite and positive. Mirrors `LorentzMaterial::try_new`.
#must_use
public fn BjLorentzMaterial_try_new(eps_inf: f64, delta_eps: f64, omega_0: f64, gamma: f64,
  out: *BjLorentzMaterial): Result {
    var e = _bj_fm_perm(eps_inf);
    if (e == 0) { e = _bj_fm_nonneg("oscillator strength delta_eps", delta_eps); }
    if (e == 0) { e = _bj_fm_positive("resonance frequency omega_0", omega_0); }
    if (e == 0) { e = _bj_fm_nonneg("damping gamma", gamma); }
    if (e != 0) { return Err(e); }
    out.eps_inf = eps_inf;
    out.delta_eps = delta_eps;
    out.omega_0 = omega_0;
    out.gamma = gamma;
    return Ok(0);
}

impl BjLorentzMaterial {
    # The ADE coefficients (α, β, γ_c) of the central-difference P^{n+1} = αP^n + βP^{n−1} + γ_c·E^n:
    # α = (2 − ω₀²Δt²)/(1 + γΔt/2), β = −(1 − γΔt/2)/(1 + γΔt/2), γ_c = ε₀Δεω₀²Δt²/(1 + γΔt/2); stable only for
    # ω₀Δt < 2. Mirrors `LorentzMaterial::ade_coefficients`.
    #must_use
    public fn ade_coefficients(self, dt: f64): (f64, f64, f64) {
        var gdt: f64 = self.gamma * dt;
        var w0dt: f64 = self.omega_0 * dt;
        var half: f64 = gdt / 2.0;
        var denom: f64 = 1.0 + half;
        var w2: f64 = w0dt * w0dt;
        var an: f64 = 2.0 - w2;
        var alpha: f64 = an / denom;
        var bn: f64 = 1.0 - half;
        var nb: f64 = -bn;
        var beta: f64 = nb / denom;
        var g: f64 = BJ_EPSILON_0 * self.delta_eps;
        g = g * w0dt;
        g = g * w0dt;
        var gamma_c: f64 = g / denom;
        return (alpha, beta, gamma_c);
    }
}

# ── the Debye model ─────────────────────────────────────────────────────────────────────────────────────────────────

# The Debye relaxation of polar molecules: ε(ω) = ε_∞ + (ε_s − ε_∞)/(1 + jωτ) (e^{+jωt}). Its polarization obeys
# τ·dP/dt + P = ε₀(ε_s − ε_∞)E. `eps_inf` is ε_∞, `eps_s` the static ε_s and `tau` the relaxation time τ in s. Mirrors
# `DebyeMaterial`.
public struct BjDebyeMaterial {
    eps_inf: f64;
    eps_s: f64;
    tau: f64;
}

# A Debye material, unchecked (BjDebyeMaterial_try_new checks). Mirrors `DebyeMaterial::new`.
#must_use
public fn BjDebyeMaterial_new(eps_inf: f64, eps_s: f64, tau: f64): BjDebyeMaterial {
    var m: BjDebyeMaterial;
    m.eps_inf = eps_inf;
    m.eps_s = eps_s;
    m.tau = tau;
    return m;
}

# A Debye material into *out: Ok(0), or with out untouched Err(InvalidPermittivity) unless ε_∞ and then ε_s are finite
# and positive, Err(InvalidParameter) "Debye eps_s ({ε_s}) must be >= eps_inf ({ε_∞})", or "relaxation time tau must
# be finite and positive, got {τ}". Mirrors `DebyeMaterial::try_new`.
#must_use
public fn BjDebyeMaterial_try_new(eps_inf: f64, eps_s: f64, tau: f64, out: *BjDebyeMaterial): Result {
    var e = _bj_fm_perm(eps_inf);
    if (e == 0) { e = _bj_fm_perm(eps_s); }
    if (e == 0 && eps_s < eps_inf) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "Debye eps_s (");
        _bj_fmt_f64_display(t, eps_s);
        _bj_tx_cstr(t, ") must be >= eps_inf (");
        _bj_fmt_f64_display(t, eps_inf);
        _bj_tx_cstr(t, ")");
        e = BJ_ERR_INVALID_PARAMETER;
    }
    if (e == 0) { e = _bj_fm_positive("relaxation time tau", tau); }
    if (e != 0) { return Err(e); }
    out.eps_inf = eps_inf;
    out.eps_s = eps_s;
    out.tau = tau;
    return Ok(0);
}

# Water at 25 °C, a single-pole Debye fit. Mirrors `DebyeMaterial::water`.
#must_use
public fn BjDebyeMaterial_water(): BjDebyeMaterial {
    var m: BjDebyeMaterial = BjDebyeMaterial_new(_BJ_WATER_EPS_INF, _BJ_WATER_EPS_S, _BJ_WATER_TAU);
    return m;
}

impl BjDebyeMaterial {
    # The ADE coefficients (α, β) of the trapezoidal P^{n+1} = αP^n + β(E^{n+1} + E^n): α = (2τ/Δt − 1)/(2τ/Δt + 1),
    # β = ε₀(ε_s − ε_∞)/(2τ/Δt + 1); dt > 0 and a valid material assumed. Mirrors `DebyeMaterial::ade_coefficients`.
    #must_use
    public fn ade_coefficients(self, dt: f64): (f64, f64) {
        var tdt: f64 = self.tau / dt;
        var t2: f64 = 2.0 * tdt;
        var am: f64 = t2 - 1.0;
        var ap: f64 = t2 + 1.0;
        var alpha: f64 = am / ap;
        var de: f64 = self.eps_s - self.eps_inf;
        var b: f64 = BJ_EPSILON_0 * de;
        var beta: f64 = b / ap;
        return (alpha, beta);
    }
}

# ── subpixel smoothing ──────────────────────────────────────────────────────────────────────────────────────────────

# 0 when both permittivities are valid and fill_fraction lies in [0, 1], else the error recorded and its code
# (InvalidPermittivity for ε₁, then ε₂; InvalidParameter "fill_fraction must be in [0, 1], got {f}"). Mirrors
# fdtd.rs's `check_subpixel`.
fn _bj_fm_subpixel(eps1: f64, eps2: f64, fill_fraction: f64): i64 {
    var e = _bj_fm_perm(eps1);
    if (e == 0) { e = _bj_fm_perm(eps2); }
    if (e != 0) { return e; }
    if (fill_fraction >= 0.0 && fill_fraction <= 1.0) { return 0; }
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, "fill_fraction must be in [0, 1], got ");
    _bj_fmt_f64_display(t, fill_fraction);
    return BJ_ERR_INVALID_PARAMETER;
}

# The effective permittivity for E parallel to an interface, the arithmetic mean f·ε₂ + (1 − f)·ε₁ (tangential E is
# continuous: capacitors in parallel; Farjadpour et al., Opt. Lett. 31, 2972 (2006)); f is the fraction of the cell
# that ε₂ fills. Ok(⟨ε⟩), or Err(InvalidPermittivity) unless both are finite and positive, Err(InvalidParameter)
# unless f is in [0, 1]. Mirrors `subpixel_permittivity_parallel`.
#must_use
public fn bj_subpixel_permittivity_parallel(eps1: f64, eps2: f64, fill_fraction: f64): Result {
    var e = _bj_fm_subpixel(eps1, eps2, fill_fraction);
    if (e != 0) { return Err(e); }
    var a: f64 = fill_fraction * eps2;
    var g: f64 = 1.0 - fill_fraction;
    var b: f64 = g * eps1;
    var r: f64 = a + b;
    return Ok(r);
}

# The effective permittivity for E perpendicular to an interface, the harmonic mean 1/(f/ε₂ + (1 − f)/ε₁) (normal D
# is continuous: capacitors in series). Unchecked, as Rust's: NaN unless both permittivities are finite and positive;
# f clamped to [0, 1], NaN taken as 0. Mirrors `subpixel_permittivity_perpendicular`.
#must_use
public fn bj_subpixel_permittivity_perpendicular(eps1: f64, eps2: f64, fill_fraction: f64): f64 {
    if (_bj_fm_pos(eps1) == 0 || _bj_fm_pos(eps2) == 0) { return _BJ_FM_NAN; }
    var f: f64 = fill_fraction;
    if (f != f) { f = 0.0; }
    if (f < 0.0) { f = 0.0; }
    if (f > 1.0) { f = 1.0; }
    var a: f64 = f / eps2;
    var g: f64 = 1.0 - f;
    var b: f64 = g / eps1;
    var s: f64 = a + b;
    var r: f64 = 1.0 / s;
    return r;
}

# The harmonic mean, checked as the parallel one: Ok(⟨ε⁻¹⟩⁻¹), or its errors. Mirrors
# `subpixel_permittivity_perpendicular_checked`.
#must_use
public fn bj_subpixel_permittivity_perpendicular_checked(eps1: f64, eps2: f64, fill_fraction: f64): Result {
    var e = _bj_fm_subpixel(eps1, eps2, fill_fraction);
    if (e != 0) { return Err(e); }
    var r: f64 = bj_subpixel_permittivity_perpendicular(eps1, eps2, fill_fraction);
    return Ok(r);
}
