# rf.cyr — rf.rs (M4 part 1a): transmission lines, the reflection coefficient, VSWR and the mismatch losses, the Smith
# chart, matching, and the antenna array factors. SI units: impedances in ohms, admittances in siemens, frequencies
# in Hz, lengths in metres, angles in radians.
#
# The time convention is bijli's one, e^{+jωt} (src/complex.cyr's header; ADR 0002 row 5). rf.rs already used it
# (an inductive reactance is +jωL, a lossless line has γ = jβ), so nothing here changes.
#
# Complex values are BjComplex. Their arithmetic is hisab's, written out on f64 locals in Rust's order: |z| is
# √(re² + im²), arg z is atan2(im, re), from_polar(r, θ) is (r·cos θ, r·sin θ). The division is rf.rs's own Smith
# algorithm (src/crmath_vx.cyr's _bj_vx_cdiv, the same as scattering.rs's). sin, cos, atan, atan2, log10 and acos are
# correctly rounded (src/crmath.cyr). An element count is Rust's usize: its 64-bit word read unsigned (−1 is
# usize::MAX).
#
# An S-parameter matrix (M4 part 1b) is a BjSMatrix whose shape is fixed at construction (ADR 0002 row 36): Rust's
# public, resizable fields and their per-call shape checks are gone. Its reference impedances compare equal only when
# both are finite (row 37). Touchstone I/O follows in M4 part 1c.

private

# std::f64::consts::TAU.
var _BJ_RF_TAU: f64 = 6.283185307179586;
# rf.rs's thresholds: 10⁻³⁰ (a reference impedance, Z_L + Z₀), 10⁻⁶⁰ (|Z_L + Z₀|², |S21|²), 10⁻¹⁵ (the unbounded
# input impedance, relative to Z₀ + |Z_L|), 10⁻¹² (a matched stub, relative to Z₀; z0_equal). The tests against
# 10⁻³⁰, 10⁻⁶⁰ and 10⁻¹² are decided exactly on the inputs (ADR 0002 row 17, M4 part 2c), as decimals; the input
# impedance's 10⁻¹⁵ stays on its rounded den (the user's answer of 2026-11-15).
var _BJ_RF_TINY30: f64 = 0.000000000000000000000000000001;
var _BJ_RF_TINY60: f64 = 0.000000000000000000000000000000000000000000000000000000000001;
var _BJ_RF_REL15: f64 = 0.000000000000001;
var _BJ_RF_REL12: f64 = 0.000000000001;
# 2·10⁻³⁰ and 2·10⁻⁶⁰: a rounded |Z_L + Z₀| (or sum of squares) at or above them is far above 10⁻³⁰ (10⁻⁶⁰), so the
# exact tests (ADR 0002 row 17) start below them.
var _BJ_RF_TWO30: f64 = 0.000000000000000000000000000002;
var _BJ_RF_TWO60: f64 = 0.000000000000000000000000000000000000000000000000000000000002;
# The smallest normal double and the largest finite one: |z|² is a normal double between them.
var _BJ_RF_MIN_NORMAL: f64 = 0x0010000000000000;
var _BJ_RF_MAX_FINITE: f64 = 0x7FEFFFFFFFFFFFFF;
var _BJ_RF_INF: f64 = 0x7FF0000000000000;
var _BJ_RF_NAN: f64 = 0x7FF8000000000000;
# 2^-480: the stub match's cancellation-free root (ADR 0002 row 39) needs its scaled inputs at or above it.
var _BJ_RF_2M480: f64 = 0x21F0000000000000;

# ── internal helpers ────────────────────────────────────────────────────────────────────────────────────────────

# 1 when x is finite and positive.
#must_use
fn _bj_rf_pos(x: f64): i64 {
    if (_bj_is_finite(x) == 1 && x > 0.0) { return 1; }
    return 0;
}

# 1 when both parts are finite. Mirrors rf.rs's `is_finite_complex`.
#must_use
fn _bj_rf_fin2(re: f64, im: f64): i64 {
    if (_bj_is_finite(re) == 1 && _bj_is_finite(im) == 1) { return 1; }
    return 0;
}

# Records InvalidParameter "<head>{v}<tail>", v in Rust's Display form. Returns the code.
fn _bj_rf_bad(head, v: f64, tail): i64 {
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, head);
    _bj_fmt_f64_display(t, v);
    _bj_tx_cstr(t, tail);
    return BJ_ERR_INVALID_PARAMETER;
}

# Records InvalidParameter "<head>{z}", z = re + j·im in Rust's Display form. Returns the code.
fn _bj_rf_bad_cx(head, re: f64, im: f64): i64 {
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, head);
    var z: BjComplex = BjComplex_new(re, im);
    z.display(t);
    return BJ_ERR_INVALID_PARAMETER;
}

# 0 when value is finite and positive, else InvalidParameter "{name} must be finite and positive, got {value}"
# recorded and its code returned. Mirrors rf.rs's `require_positive_finite` (public for src/touchstone.cyr).
public fn _bj_rf_require(name, value: f64): i64 {
    if (_bj_rf_pos(value) == 1) { return 0; }
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, name);
    _bj_tx_cstr(t, " must be finite and positive, got ");
    _bj_fmt_f64_display(t, value);
    return BJ_ERR_INVALID_PARAMETER;
}

# Rust's `n as f64` for a usize: the 64-bit word read unsigned, rounded to nearest even. Above 2^63 the halved word
# keeps its last bit as a sticky bit, so the one rounding is the conversion's, and doubling is exact.
#must_use
fn _bj_rf_u2f(n): f64 {
    if (n >= 0) {
        var r: f64 = f64_from(n);
        return r;
    }
    var h: f64 = f64_from((n >> 1) | (n & 1));
    var r2: f64 = h * 2.0;
    return r2;
}

# 1/z: one division when |z|² is a normal double, Smith's algorithm otherwise (NaN parts for z = 0). Mirrors rf.rs's
# `crecip`.
#must_use
fn _bj_rf_recip(re: f64, im: f64): (f64, f64) {
    var d: f64 = re * re + im * im;
    var lo: f64 = _BJ_RF_MIN_NORMAL;
    var hi: f64 = _BJ_RF_MAX_FINITE;
    if (d >= lo && d <= hi) {
        var inv: f64 = 1.0 / d;
        var r1: f64 = re * inv;
        var i1: f64 = -im * inv;
        return (r1, i1);
    }
    var qr, qi = _bj_vx_cdiv(1.0, 0.0, re, im);
    return (qr, qi);
}

# from_polar(√|z|, arg z / 2), |z| = √(re² + im²): hisab's Complex::sqrt in Rust's order, and the last step of the
# lossy impedance and the propagation constant.
#must_use
fn _bj_rf_sqrt_polar(re: f64, im: f64): BjComplex {
    var n2: f64 = re * re + im * im;
    var a: f64 = f64_sqrt(n2);
    var mag: f64 = f64_sqrt(a);
    var g: f64 = _bj_atan2(im, re);
    var ph: f64 = g / 2.0;
    var s, c = _bj_sin_cos(ph);
    var z: BjComplex;
    var zr: f64 = mag * c;
    var zi: f64 = mag * s;
    z.re = zr;
    z.im = zi;
    return z;
}

# ── transmission lines ──────────────────────────────────────────────────────────────────────────────────────────

# Z₀ = √(L′/C′) of a lossless line, L′ in H/m and C′ in F/m, correctly rounded (ADR 0002 row 13, M4 part 2b): Ok(Z₀),
# or Err(InvalidParameter) unless both are finite and positive. Mirrors `rf::characteristic_impedance_lossless`.
#must_use
public fn bj_characteristic_impedance_lossless(inductance_per_m: f64, capacitance_per_m: f64): Result {
    if (_bj_rf_pos(inductance_per_m) == 0 || _bj_rf_pos(capacitance_per_m) == 0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "L' and C' must be finite and positive, got L'=");
        _bj_fmt_f64_display(t, inductance_per_m);
        _bj_tx_cstr(t, ", C'=");
        _bj_fmt_f64_display(t, capacitance_per_m);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var z: f64 = _bj_k_cr_sqrt_div(inductance_per_m, capacitance_per_m);   # kimiya's √(x/y)
    return Ok(z);
}

# Z₀ = √((R′ + jωL′)/(G′ + jωC′)) of a lossy line, the principal branch (Re Z₀ ≥ 0): R′ in Ω/m, L′ in H/m, G′ in
# S/m, C′ in F/m, ω in rad/s. Where G′ + jωC′ = 0, the DC limit ω → 0⁺ for ω = 0, G′ = 0 and C′ > 0: √(L′/C′) when
# R′ = 0, +∞ − j∞ when R′ > 0; NaN parts otherwise. Mirrors `rf::characteristic_impedance_lossy`.
#must_use
public fn bj_characteristic_impedance_lossy(r: f64, l: f64, g: f64, c: f64, omega: f64): BjComplex {
    var ni: f64 = omega * l;
    var di: f64 = omega * c;
    if (g == 0.0 && di == 0.0) {
        if (omega == 0.0 && g == 0.0 && c > 0.0) {
            if (r == 0.0) {
                var q: f64 = l / c;
                var w: BjComplex = _bj_rf_sqrt_polar(q, 0.0);
                return w;
            }
            if (r > 0.0) {
                var inf: f64 = _BJ_RF_INF;
                var ninf: f64 = -inf;
                return BjComplex_new(inf, ninf);
            }
        }
        var nan: f64 = _BJ_RF_NAN;
        return BjComplex_new(nan, nan);
    }
    var qr, qi = _bj_vx_cdiv(r, ni, g, di);
    var z: BjComplex = _bj_rf_sqrt_polar(qr, qi);
    return z;
}

# γ = α + jβ = √((R′ + jωL′)(G′ + jωC′)), the principal branch (α ≥ 0, β ≥ 0 for a passive line at ω > 0): α in Np/m,
# β in rad/m. Mirrors `rf::propagation_constant`.
#must_use
public fn bj_propagation_constant(r: f64, l: f64, g: f64, c: f64, omega: f64): BjComplex {
    var ai: f64 = omega * l;
    var bi: f64 = omega * c;
    var pr: f64 = r * g - ai * bi;
    var pi: f64 = r * bi + ai * g;
    var z: BjComplex = _bj_rf_sqrt_polar(pr, pi);
    return z;
}

# v_p = 1/√(L′C′) on a lossless line (m/s), correctly rounded (ADR 0002 row 13, M4 part 2b): Ok(v_p), or
# Err(InvalidParameter) unless both are finite and positive. Mirrors `rf::phase_velocity`.
#must_use
public fn bj_phase_velocity(inductance_per_m: f64, capacitance_per_m: f64): Result {
    if (_bj_rf_pos(inductance_per_m) == 0 || _bj_rf_pos(capacitance_per_m) == 0) {
        return Err(_bj_err_invalid_parameter("L' and C' must be finite and positive"));
    }
    var den: f64[2];
    den[0] = inductance_per_m;
    den[1] = capacitance_per_m;
    var v: f64 = _bj_cr_sqrt_mono(0, 0, &den, 2);
    return Ok(v);
}

# Z_in = Z₀(Z_L cos βl + jZ₀ sin βl)/(Z₀ cos βl + jZ_L sin βl) of a lossless line of characteristic impedance z0
# terminated in z_load, into *out: Ok(0), or Err with out untouched. Only βl matters, so beta = 2π with length in
# wavelengths works too. InvalidParameter unless z0 is finite and positive and z_load and βl are finite;
# DivisionByZero where |Z₀ cos βl + jZ_L sin βl| ≤ 10⁻¹⁵·(Z₀ + |Z_L|), an unbounded Z_in (a shorted λ/4 line).
# Mirrors `rf::input_impedance_lossless_complex`.
#must_use
public fn bj_input_impedance_lossless_complex(z0: f64, z_load: BjComplex, beta: f64, length: f64,
  out: *BjComplex): Result {
    var e = _bj_rf_require("Z₀", z0);
    if (e != 0) { return Err(e); }
    var zr: f64 = z_load.re;
    var zi: f64 = z_load.im;
    if (_bj_rf_fin2(zr, zi) == 0) { return Err(_bj_rf_bad_cx("Z_L must be finite, got ", zr, zi)); }
    var bl: f64 = beta * length;
    if (_bj_is_finite(bl) == 0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "electrical length βl must be finite, got β=");
        _bj_fmt_f64_display(t, beta);
        _bj_tx_cstr(t, ", l=");
        _bj_fmt_f64_display(t, length);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var s, c = _bj_sin_cos(bl);
    var nr: f64 = zr * c;
    var ni: f64 = zi * c + z0 * s;
    var dr: f64 = z0 * c - zi * s;
    var di: f64 = zr * s;
    var zm: f64 = f64_sqrt(zr * zr + zi * zi);
    var scale: f64 = z0 + zm;
    var dm: f64 = f64_sqrt(dr * dr + di * di);
    var lim: f64 = _BJ_RF_REL15 * scale;
    if (dm != dm || dm <= lim) {
        var context = "transmission line input impedance is unbounded (Z₀cos βl + jZ_L sin βl = 0)";
        return Err(_bj_err_division_by_zero(context));
    }
    var qr, qi = _bj_vx_cdiv(nr, ni, dr, di);
    var wr: f64 = qr * z0;
    var wi: f64 = qi * z0;
    out.re = wr;
    out.im = wi;
    return Ok(0);
}

# ── reflection and the losses ───────────────────────────────────────────────────────────────────────────────────

# Γ = (Z_L − Z₀)/(Z_L + Z₀) for real impedances: Ok(Γ); Err(InvalidParameter) unless both are finite,
# Err(DivisionByZero) when |Z_L + Z₀| < 10⁻³⁰, exactly (ADR 0002 row 17). Mirrors `rf::reflection_coefficient`.
#must_use
public fn bj_reflection_coefficient(z_load: f64, z0: f64): Result {
    if (_bj_is_finite(z_load) == 0 || _bj_is_finite(z0) == 0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "Z_L and Z₀ must be finite, got Z_L=");
        _bj_fmt_f64_display(t, z_load);
        _bj_tx_cstr(t, ", Z₀=");
        _bj_fmt_f64_display(t, z0);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var den: f64 = z_load + z0;
    var ad: f64 = f64_abs(den);
    if (ad < _BJ_RF_TWO30) {                                        # else far above: one compare on the common path
        var band = _bj_x_band(ad, _BJ_RF_TINY30);                   # |Z_L + Z₀| < 10⁻³⁰ exactly (ADR 0002 row 17)
        if (band == 2) { band = _bj_x_sum_below(z_load, z0, 30); }
        if (band == 1) { return Err(_bj_err_division_by_zero("Z_L + Z₀ = 0")); }
    }
    var g: f64 = (z_load - z0) / den;
    return Ok(g);
}

# Γ = (Z_L − Z₀)/(Z_L + Z₀) for complex impedances, into *out: Ok(0), or Err with out untouched;
# Err(InvalidParameter) unless every part is finite, Err(DivisionByZero) when |Z_L + Z₀|² < 10⁻⁶⁰, exactly (ADR 0002
# row 17). Mirrors `rf::reflection_coefficient_complex`.
#must_use
public fn bj_reflection_coefficient_complex(z_load: BjComplex, z0: BjComplex, out: *BjComplex): Result {
    var ar: f64 = z_load.re;
    var ai: f64 = z_load.im;
    var br: f64 = z0.re;
    var bi: f64 = z0.im;
    if (_bj_rf_fin2(ar, ai) == 0 || _bj_rf_fin2(br, bi) == 0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "Z_L and Z₀ must be finite, got Z_L=");
        z_load.display(t);
        _bj_tx_cstr(t, ", Z₀=");
        z0.display(t);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var dr: f64 = ar + br;
    var di: f64 = ai + bi;
    var n2: f64 = dr * dr + di * di;
    if (n2 < _BJ_RF_TWO60) {                                        # |Z_L + Z₀|² < 10⁻⁶⁰ exactly (ADR 0002 row 17)
        if (_bj_rf_sq_below60(n2, ar, ai, -br, -bi) == 1) { return Err(_bj_err_division_by_zero("Z_L + Z₀ = 0")); }
    }
    var nr: f64 = ar - br;
    var ni: f64 = ai - bi;
    var qr, qi = _bj_vx_cdiv(nr, ni, dr, di);
    out.re = qr;
    out.im = qi;
    return Ok(0);
}

# VSWR = (1 + |Γ|)/(1 − |Γ|): Ok(VSWR), or Err(InvalidParameter) unless 0 ≤ |Γ| < 1. Mirrors `rf::vswr`.
#must_use
public fn bj_vswr(gamma_mag: f64): Result {
    if (gamma_mag >= 1.0) { return Err(_bj_rf_bad("|Γ| must be < 1, got ", gamma_mag, "")); }
    if (gamma_mag != gamma_mag || gamma_mag < 0.0) {
        return Err(_bj_rf_bad("|Γ| must be ≥ 0, got ", gamma_mag, ""));
    }
    var v: f64 = (1.0 + gamma_mag) / (1.0 - gamma_mag);
    return Ok(v);
}

# Return loss RL = −20 log₁₀|Γ| in dB: Ok(RL), or Err(InvalidParameter) unless 0 < |Γ| ≤ 1 (a perfect match has an
# infinite return loss). Mirrors `rf::return_loss`.
#must_use
public fn bj_return_loss(gamma_mag: f64): Result {
    var ok = 0;
    if (gamma_mag > 0.0 && gamma_mag <= 1.0) { ok = 1; }
    if (ok == 0) { return Err(_bj_rf_bad("|Γ| must be in (0, 1] for return loss, got ", gamma_mag, "")); }
    var lg: f64 = _bj_log10(gamma_mag);
    var rl: f64 = -20.0 * lg;
    return Ok(rl);
}

# Insertion loss from mismatch alone, IL = −10 log₁₀(1 − |Γ|²) in dB: Ok(IL), or Err(InvalidParameter) unless
# 0 ≤ |Γ| < 1 (|Γ| = 1 is total reflection, an infinite loss). Mirrors `rf::insertion_loss`.
#must_use
public fn bj_insertion_loss(gamma_mag: f64): Result {
    if (gamma_mag >= 1.0) {
        return Err(_bj_err_invalid_parameter("total reflection — infinite insertion loss"));
    }
    if (gamma_mag != gamma_mag || gamma_mag < 0.0) {
        return Err(_bj_rf_bad("|Γ| must be in [0, 1), got ", gamma_mag, ""));
    }
    var a: f64 = 1.0 - gamma_mag * gamma_mag;
    var lg: f64 = _bj_log10(a);
    var il: f64 = -10.0 * lg;
    return Ok(il);
}

# Mismatch loss ML = −10 log₁₀(1 − |Γ|²) in dB, the insertion loss of a lossless network: as bj_insertion_loss.
# Mirrors `rf::mismatch_loss`.
#must_use
public fn bj_mismatch_loss(gamma_mag: f64): Result {
    return bj_insertion_loss(gamma_mag);
}

# ── the Smith chart ─────────────────────────────────────────────────────────────────────────────────────────────

# z = Z/Z₀, each part one IEEE division (ADR 0002 row 13, M4 part 2b: Rust's Z·(1/Z₀) rounded twice), into *out:
# Ok(0), or Err with out untouched; Err(InvalidParameter) for a non-finite Z₀, Err(DivisionByZero) when
# |Z₀| < 10⁻³⁰. Mirrors `rf::normalize_impedance`.
#must_use
public fn bj_normalize_impedance(z: BjComplex, z0: f64, out: *BjComplex): Result {
    if (_bj_is_finite(z0) == 0) {
        return Err(_bj_rf_bad("reference impedance Z₀ must be finite, got ", z0, ""));
    }
    var a0: f64 = f64_abs(z0);
    var tiny: f64 = _BJ_RF_TINY30;
    if (a0 < tiny) { return Err(_bj_err_division_by_zero("reference impedance Z₀ cannot be zero")); }
    var wr: f64 = z.re / z0;
    var wi: f64 = z.im / z0;
    out.re = wr;
    out.im = wi;
    return Ok(0);
}

# Z = z·Z₀. Mirrors `rf::denormalize_impedance`.
#must_use
#pure
public fn bj_denormalize_impedance(z_norm: BjComplex, z0: f64): BjComplex {
    var w: BjComplex;
    var wr: f64 = z_norm.re * z0;
    var wi: f64 = z_norm.im * z0;
    w.re = wr;
    w.im = wi;
    return w;
}

# Γ = (z − 1)/(z + 1) from a normalized impedance. z = −1 maps to complex infinity, +∞ + j0; an infinite z (an open
# circuit, either part ±∞) to Γ = 1; a NaN part to NaN parts. The inverse of bj_z_from_gamma at their poles. Mirrors
# `rf::gamma_from_z`.
#must_use
#pure
public fn bj_gamma_from_z(z_norm: BjComplex): BjComplex {
    var re: f64 = z_norm.re;
    var im: f64 = z_norm.im;
    if (re != re || im != im) {
        var nan: f64 = _BJ_RF_NAN;
        return BjComplex_new(nan, nan);
    }
    if (_bj_rf_fin2(re, im) == 0) { return BjComplex_new(1.0, 0.0); }
    var dr: f64 = re + 1.0;
    var di: f64 = im + 0.0;
    if (dr == 0.0 && di == 0.0) {
        var inf: f64 = _BJ_RF_INF;
        return BjComplex_new(inf, 0.0);
    }
    var nr: f64 = re - 1.0;
    var ni: f64 = im - 0.0;
    var qr, qi = _bj_vx_cdiv(nr, ni, dr, di);
    return BjComplex_new(qr, qi);
}

# z = (1 + Γ)/(1 − Γ) from a reflection coefficient. Γ = 1 (an open circuit) maps to complex infinity, +∞ + j0; an
# infinite Γ to z = −1; a NaN part to NaN parts. Mirrors `rf::z_from_gamma`.
#must_use
#pure
public fn bj_z_from_gamma(gamma: BjComplex): BjComplex {
    var re: f64 = gamma.re;
    var im: f64 = gamma.im;
    if (re != re || im != im) {
        var nan: f64 = _BJ_RF_NAN;
        return BjComplex_new(nan, nan);
    }
    if (_bj_rf_fin2(re, im) == 0) { return BjComplex_new(-1.0, 0.0); }
    var dr: f64 = 1.0 - re;
    var di: f64 = 0.0 - im;
    if (dr == 0.0 && di == 0.0) {
        var inf: f64 = _BJ_RF_INF;
        return BjComplex_new(inf, 0.0);
    }
    var nr: f64 = 1.0 + re;
    var ni: f64 = 0.0 + im;
    var qr, qi = _bj_vx_cdiv(nr, ni, dr, di);
    return BjComplex_new(qr, qi);
}

# ── matching ────────────────────────────────────────────────────────────────────────────────────────────────────

# The quarter-wave transformer's impedance Z_t = √(Z₀·Z_L), matching a real load to a line, correctly rounded (ADR 0002
# row 13, M4 part 2b): Ok(Z_t), or Err(InvalidParameter) unless both are finite and positive. Mirrors
# `rf::quarter_wave_transformer`.
#must_use
public fn bj_quarter_wave_transformer(z0: f64, z_load: f64): Result {
    if (_bj_rf_pos(z0) == 0 || _bj_rf_pos(z_load) == 0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "Z₀ and Z_L must be finite and positive for a quarter-wave transformer, got Z₀=");
        _bj_fmt_f64_display(t, z0);
        _bj_tx_cstr(t, ", Z_L=");
        _bj_fmt_f64_display(t, z_load);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var num: f64[2];
    num[0] = z0;
    num[1] = z_load;
    var zt: f64 = _bj_cr_sqrt_mono(&num, 2, 0, 0);
    return Ok(zt);
}

# d/λ from t = tan βd, wrapped into [0, ½): atan(t)/2π, plus ½ when negative; `+ 0.0` turns −0 into +0.
#must_use
fn _bj_rf_d_from_t(t: f64): f64 {
    var a: f64 = _bj_atan(t);
    var d: f64 = a / _BJ_RF_TAU;
    if (d < 0.0) {
        var w: f64 = d + 0.5;
        return w;
    }
    var p: f64 = d + 0.0;
    return p;
}

# The stub match's cancelling root without its cancellation (ADR 0002 row 39, M4 part 2a-1), or NaN to keep Rust's.
# For X_L > 0 the root (X_L − disc)/(R_L − Z₀), for X_L < 0 the root (X_L + disc)/(R_L − Z₀), cancels where disc lies
# within a factor 2 of |X_L|: as R_L → Z₀, and as R_L(Z₀ − R_L) → X_L² (the root → 0). Since
# X_L² − disc² = −(R_L − Z₀)(X_L² + R_L(R_L − Z₀))/Z₀, the same root is N/(Z₀(X_L ± disc)), N = R_L(Z₀ − R_L) − X_L²,
# whose denominator adds like signs. N is R_L·Z₀ − R_L² − X_L² from TwoProduct's exact parts grown into one expansion
# (src/crmath_gamma.cyr), compressed and rounded, on the inputs scaled by the power of two that brings
# max(Z₀, |X_L|) into [1, 2) (exact, and the root is scale-free). In the region R_L ≤ 4·Z₀, so the scaled values lie
# in [2^-480, 8] unless one is below 2^-480: there, and for max(Z₀, |X_L|) outside [2^-1022, 2^1023), NaN (Rust's
# chain). The root is within a few ulps of the exact one (validate.py checks every golden row).
#must_use
fn _bj_rf_stub_root(rl: f64, xl: f64, z0: f64, disc: f64): f64 {
    var ax: f64 = f64_abs(xl);
    if (xl > 0.0) {
        var lo: f64 = 2.0 * disc;
        var hi: f64 = 2.0 * xl;
        if (lo < xl || disc > hi) { return _BJ_RF_NAN; }
    } else {
        if (xl == 0.0) { return _BJ_RF_NAN; }
        var lo2: f64 = 2.0 * disc;
        var hi2: f64 = 2.0 * ax;
        if (lo2 < ax || disc > hi2) { return _BJ_RF_NAN; }
    }
    var m: f64 = z0;
    if (ax > m) { m = ax; }
    var be = (_bj_bits(m) >> 52) & 2047;
    if (be < 1 || be > 2045) { return _BJ_RF_NAN; }
    var s: f64 = _bj_from_bits((2046 - be) << 52);
    var r: f64 = rl * s;
    var z: f64 = z0 * s;
    var x: f64 = xl * s;
    var d: f64 = disc * s;
    var axs: f64 = f64_abs(x);
    if (r < _BJ_RF_2M480 || z < _BJ_RF_2M480 || axs < _BJ_RF_2M480) { return _BJ_RF_NAN; }
    var p1, e1 = _bj_k_two_prod(r, z);
    var p2, e2 = _bj_k_two_prod(r, r);
    var p3, e3 = _bj_k_two_prod(x, x);
    var a1: f64 = p1;
    var b1: f64 = e1;
    var a2: f64 = p2;
    var b2: f64 = e2;
    var a3: f64 = p3;
    var b3: f64 = e3;
    var parts: f64[6];
    parts[0] = a1;
    parts[1] = -a2;
    parts[2] = -a3;
    parts[3] = b1;
    parts[4] = -b2;
    parts[5] = -b3;
    var ex: f64[6];
    var k = 0;
    for (var i = 0; i < 6; i = i + 1) {
        var pv: f64 = parts[i];
        k = _bj_g_grow(&ex, k, pv);
    }
    var n: f64 = 0.0;
    if (k > 0) {
        var h, l = _bj_g_compress(&ex, k);
        var hv: f64 = h;
        n = hv;
    }
    var w: f64 = x + d;
    if (xl < 0.0) { w = x - d; }
    var den: f64 = z * w;
    var root: f64 = n / den;
    return root;
}

# The single shunt short-circuited stub match of a complex load (Pozar §5.2, eqs. 5.9–5.11): both (d, ℓ) solutions in
# wavelengths, sorted by increasing d, into out[0] = d₁, out[1] = ℓ₁, out[2] = d₂, out[3] = ℓ₂: Ok(0), or Err with out
# untouched. With Z_L = R_L + jX_L and t = tan βd: t = [X_L ± √(R_L((Z₀ − R_L)² + X_L²)/Z₀)]/(R_L − Z₀), the root
# that cancels taken without its cancellation (_bj_rf_stub_root, ADR 0002 row 39), or, when |R_L − Z₀| ≤ 10⁻¹²·Z₀,
# t = −X_L/(2Z₀) and the t → ∞ solution d = λ/4. The stub cancels the line's susceptance B
# there: ℓ/λ = atan2(Y₀, B)/2π ∈ (0, ½). InvalidParameter unless z0 is finite and positive and z_load is finite with
# R_L > 0 (a lossless stub can't match a purely reactive or an active load). Mirrors `rf::single_stub_match_complex`.
#must_use
public fn bj_single_stub_match_complex(z_load: BjComplex, z0: f64, out: *f64): Result {
    var e = _bj_rf_require("Z₀", z0);
    if (e != 0) { return Err(e); }
    var rl: f64 = z_load.re;
    var xl: f64 = z_load.im;
    if (_bj_rf_fin2(rl, xl) == 0) { return Err(_bj_rf_bad_cx("Z_L must be finite, got ", rl, xl)); }
    if (rl <= 0.0) {
        return Err(_bj_rf_bad("load resistance must be positive for a stub match, got ", rl, ""));
    }
    var d1: f64 = 0.25;
    var d2: f64 = 0.25;
    var df: f64 = rl - z0;
    if (_bj_rf_within12(rl, z0, z0) == 1) {                         # |R_L − Z₀| ≤ 10⁻¹²·Z₀ exactly (row 17)
        var t0: f64 = -xl / (2.0 * z0);
        d1 = _bj_rf_d_from_t(t0);
    } else {
        var zd: f64 = z0 - rl;
        var inner: f64 = rl * (zd * zd + xl * xl) / z0;
        var disc: f64 = f64_sqrt(inner);
        var ta: f64 = (xl + disc) / df;
        var tb: f64 = (xl - disc) / df;
        var tc: f64 = _bj_rf_stub_root(rl, xl, z0, disc);
        if (tc == tc) {
            if (xl > 0.0) { tb = tc; } else { ta = tc; }
        }
        d1 = _bj_rf_d_from_t(ta);
        d2 = _bj_rf_d_from_t(tb);
    }
    var y0: f64 = 1.0 / z0;
    var zin: BjComplex;
    var t1, v1 = bj_input_impedance_lossless_complex(z0, z_load, _BJ_RF_TAU, d1, &zin);
    if (is_err_result(t1) == 1) { return Err(v1); }
    var yr, yi = _bj_rf_recip(zin.re, zin.im);
    var g1: f64 = _bj_atan2(y0, yi);
    var l1: f64 = g1 / _BJ_RF_TAU;
    var t2, v2 = bj_input_impedance_lossless_complex(z0, z_load, _BJ_RF_TAU, d2, &zin);
    if (is_err_result(t2) == 1) { return Err(v2); }
    var yr2, yi2 = _bj_rf_recip(zin.re, zin.im);
    var g2: f64 = _bj_atan2(y0, yi2);
    var l2: f64 = g2 / _BJ_RF_TAU;
    if (d2 < d1) {
        out[0] = d2;
        out[1] = l2;
        out[2] = d1;
        out[3] = l1;
    } else {
        out[0] = d1;
        out[1] = l1;
        out[2] = d2;
        out[3] = l2;
    }
    if (_bj_log_on(4) == 1) {
        var lb[320];
        var lt[24];
        _bj_tx_init(&lt, &lb, 320);
        _bj_tx_cstr(&lt, "single shunt stub match z_load=");
        z_load.display(&lt);
        _bj_tx_cstr(&lt, " z0=");
        _bj_fmt_f64_debug(&lt, z0);
        _bj_tx_cstr(&lt, " d1=");
        _bj_fmt_f64_debug(&lt, out[0]);
        _bj_tx_cstr(&lt, " l1=");
        _bj_fmt_f64_debug(&lt, out[1]);
        _bj_tx_cstr(&lt, " d2=");
        _bj_fmt_f64_debug(&lt, out[2]);
        _bj_tx_cstr(&lt, " l2=");
        _bj_fmt_f64_debug(&lt, out[3]);
        _bj_log_text(4, &lt);
    }
    return Ok(0);
}

# The single shunt short-circuited stub match of a real load: (d, ℓ) in wavelengths into out[0], out[1], the
# solution of bj_single_stub_match_complex with the smaller d: Ok(0), or Err with out untouched. A matched load
# (z_load = z0) gives (0, 0.25): a λ/4 shorted stub presents zero admittance, the same as no stub. InvalidParameter
# unless both are finite and positive. Mirrors `rf::single_stub_match`.
#must_use
public fn bj_single_stub_match(z_load: f64, z0: f64, out: *f64): Result {
    var e = _bj_rf_require("Z_L", z_load);
    if (e != 0) { return Err(e); }
    var both: f64[4];
    var t, v = bj_single_stub_match_complex(BjComplex_new(z_load, 0.0), z0, &both);
    if (is_err_result(t) == 1) { return Err(v); }
    out[0] = both[0];
    out[1] = both[1];
    return Ok(0);
}

# ── antenna arrays ──────────────────────────────────────────────────────────────────────────────────────────────

# The uniform linear array factor |sin(Nψ/2)/(N sin(ψ/2))|, ψ = kd cos θ + β: n_elements elements (a usize), spacing
# d (m), wavenumber k = 2π/λ, progressive phase β between elements (rad), observation angle θ from the array axis
# (rad). 0 for no element, 1 for one, and 1 where |sin(ψ/2)| < 10⁻¹⁵ (the main beam and the grating lobes, by
# L'Hôpital). Mirrors `rf::linear_array_factor`.
#must_use
public fn bj_linear_array_factor(n_elements, spacing: f64, wavenumber: f64, progressive_phase: f64,
  theta: f64): f64 {
    if (n_elements == 0) { return 0.0; }
    if (n_elements == 1) { return 1.0; }
    var ct: f64 = _bj_cos(theta);
    var psi: f64 = wavenumber * spacing * ct + progressive_phase;
    var half: f64 = psi / 2.0;
    var n: f64 = _bj_rf_u2f(n_elements);
    var sn: f64 = _bj_sin(n * half);
    var sh: f64 = _bj_sin(half);
    var ash: f64 = f64_abs(sh);
    var lim: f64 = _BJ_RF_REL15;
    if (ash < lim) { return 1.0; }
    var q: f64 = sn / (n * sh);
    var af: f64 = f64_abs(q);
    return af;
}

# The rectangular planar array factor AF_x·AF_y: the linear factors of nx elements spaced dx with phase β_x, at the
# angle acos(sin θ cos φ) from the x axis, and of ny spaced dy with β_y, at acos(sin θ sin φ) from the y axis.
# Mirrors `rf::planar_array_factor`.
#must_use
public fn bj_planar_array_factor(nx, ny, dx: f64, dy: f64, wavenumber: f64, beta_x: f64, beta_y: f64, theta: f64,
  phi: f64): f64 {
    var st: f64 = _bj_sin(theta);
    var cp: f64 = _bj_cos(phi);
    var tx: f64 = _bj_acos(st * cp);
    var afx: f64 = bj_linear_array_factor(nx, dx, wavenumber, beta_x, tx);
    var sp: f64 = _bj_sin(phi);
    var ty: f64 = _bj_acos(st * sp);
    var afy: f64 = bj_linear_array_factor(ny, dy, wavenumber, beta_y, ty);
    var af: f64 = afx * afy;
    return af;
}

# The uniform circular array factor |Σₙ exp(j(ka sin θ cos(φ − φₙ) + nβ))|/N: n_elements elements (a usize) at
# φₙ = 2πn/N on a circle of radius a (m), wavenumber k, observation angles θ and φ (rad), progressive phase β (rad).
# 0 for no element. Mirrors `rf::circular_array_factor`.
#must_use
public fn bj_circular_array_factor(n_elements, radius: f64, wavenumber: f64, theta: f64, phi: f64,
  progressive_phase: f64): f64 {
    if (n_elements == 0) { return 0.0; }
    var n: f64 = _bj_rf_u2f(n_elements);
    var sr: f64 = 0.0;
    var si: f64 = 0.0;
    var two_pi: f64 = 2.0 * _BJ_PI;
    var i = 0;
    while (i != n_elements) {
        var fi: f64 = _bj_rf_u2f(i);
        var phi_n: f64 = two_pi * fi / n;
        var st: f64 = _bj_sin(theta);
        var cd: f64 = _bj_cos(phi - phi_n);
        var psi: f64 = wavenumber * radius * st * cd + progressive_phase * fi;
        var s, c = _bj_sin_cos(psi);
        sr = sr + c;
        si = si + s;
        i = i + 1;
    }
    var m: f64 = f64_sqrt(sr * sr + si * si);
    var af: f64 = m / n;
    return af;
}

# ── the S-parameter matrices (M4 part 1b) ───────────────────────────────────────────────────────────────────────

# An N-port network's S-parameter matrix. Its shape is fixed at construction (ADR 0002 row 36): `ports` (a usize);
# `s`, the address of ports² BjComplex, row-major, S_ij at index (i − 1)·ports + j − 1; `z0`, the address of `ports`
# reference impedances (Ω, f64), in the same fl_alloc block after s. Both are 0 for ports = 0. Read the entries with
# get, s_at or the address, the impedances with z0_at; give the block back with BjSMatrix_free. Rust's public `s` and
# `z0` vectors could be reshaped, so its methods checked the shape on every call; here nothing can reshape them.
# Mirrors `SMatrix`.
public struct BjSMatrix {
    ports;
    s;
    z0;
}

# Allocates a ports-port matrix's block into *out (entries 0, every reference impedance z0): 0, or the Allocation code
# recorded (out untouched) when the block can't be had.
fn _bj_rf_sm_alloc(ports, z0: f64, out: *BjSMatrix): i64 {
    if (ports == 0) {
        out.ports = 0;
        out.s = 0;
        out.z0 = 0;
        return 0;
    }
    var blk = 0;
    if (ports > 0 && ports < 268435456) { blk = fl_calloc(ports * ports * 16 + ports * 8); }
    if (blk == 0) {
        var t = _bj_err_reason(BJ_ERR_ALLOCATION);
        _bj_tx_cstr(t, "an S-matrix of ");
        _bj_tx_u64(t, ports);
        _bj_tx_cstr(t, " ports");
        return BJ_ERR_ALLOCATION;
    }
    var zp = blk + ports * ports * 16;
    for (var k = 0; k < ports; k = k + 1) { store64(zp + k * 8, _bj_bits(z0)); }
    out.ports = ports;
    out.s = blk;
    out.z0 = zp;
    return 0;
}

# An N-port matrix with every entry 0 and every reference impedance z0, into *out: Ok(0), or Err(Allocation) with out
# untouched when its block can't be had (Rust aborts). Mirrors `SMatrix::new`.
#must_use
public fn BjSMatrix_new(ports, z0: f64, out: *BjSMatrix): Result {
    var e = _bj_rf_sm_alloc(ports, z0, out);
    if (e != 0) { return Err(e); }
    return Ok(0);
}

# A 2-port matrix [[S11, S12], [S21, S22]] with both reference impedances z0, into *out: Ok(0), or Err(Allocation)
# with out untouched. Mirrors `SMatrix::two_port`.
#must_use
public fn BjSMatrix_two_port(s11: BjComplex, s12: BjComplex, s21: BjComplex, s22: BjComplex, z0: f64,
  out: *BjSMatrix): Result {
    var m: BjSMatrix;
    var e = _bj_rf_sm_alloc(2, z0, &m);
    if (e != 0) { return Err(e); }
    store64(m.s, _bj_bits(s11.re));
    store64(m.s + 8, _bj_bits(s11.im));
    store64(m.s + 16, _bj_bits(s12.re));
    store64(m.s + 24, _bj_bits(s12.im));
    store64(m.s + 32, _bj_bits(s21.re));
    store64(m.s + 40, _bj_bits(s21.im));
    store64(m.s + 48, _bj_bits(s22.re));
    store64(m.s + 56, _bj_bits(s22.im));
    out.ports = 2;
    out.s = m.s;
    out.z0 = m.z0;
    return Ok(0);
}

# Gives m's block back and empties it (ports 0).
public fn BjSMatrix_free(m: *BjSMatrix): i64 {
    if (m.s != 0) { fl_free(m.s); }
    m.ports = 0;
    m.s = 0;
    m.z0 = 0;
    return 0;
}

# 0 when 1 ≤ i, j ≤ ports, else InvalidParameter "port indices must be 1..={ports}, got ({i}, {j})" recorded and its
# code returned (i and j are usize words: one past 2^63 is negative here, and refused).
fn _bj_rf_index(ports, i, j): i64 {
    if (i > 0 && j > 0 && i <= ports && j <= ports) { return 0; }
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, "port indices must be 1..=");
    _bj_tx_u64(t, ports);
    _bj_tx_cstr(t, ", got (");
    _bj_tx_u64(t, i);
    _bj_tx_cstr(t, ", ");
    _bj_tx_u64(t, j);
    _bj_tx_cstr(t, ")");
    return BJ_ERR_INVALID_PARAMETER;
}

# rf.rs's z0_equal, |a − b| ≤ 10⁻¹²·max(|a|, |b|), with both values finite: Rust's accepted an infinite impedance as
# equal to any finite one (∞ ≤ 10⁻¹²·∞; ADR 0002 row 37). Decided exactly (_bj_rf_within12; row 17, M4 part 2c).
# Public for src/touchstone.cyr's writer.
#must_use
public fn _bj_rf_z0_equal(a: f64, b: f64): i64 {
    if (_bj_rf_fin2(a, b) == 0) { return 0; }
    var aa: f64 = f64_abs(a);
    var ab: f64 = f64_abs(b);
    var mx: f64 = aa;
    if (ab > aa) { mx = ab; }
    var w = _bj_rf_within12(a, b, mx);
    return w;
}

# 1 when the exact (a₀ − b₀)² + (a₁ − b₁)² < 10⁻⁶⁰, else 0, for finite parts, given its rounded value n2 (NaN: 0):
# src/crmath_cmp.cyr's band on n2, then the exact sum of squares (ADR 0002 row 17, M4 part 2c).
#must_use
fn _bj_rf_sq_below60(n2: f64, a0: f64, a1: f64, b0: f64, b1: f64): i64 {
    var band = _bj_x_band(n2, _BJ_RF_TINY60);
    if (band != 2) { return band; }
    var pa: f64[3];
    var pb: f64[3];
    pa[0] = a0;
    pa[1] = a1;
    pa[2] = 0.0;
    pb[0] = b0;
    pb[1] = b1;
    pb[2] = 0.0;
    var r = _bj_x_r2_below(&pa, &pb, 60);
    return r;
}

# 2^±600 and 2^±900: _bj_rf_within12's scaling.
var _BJ_RF_2P600: f64 = 0x6570000000000000;
var _BJ_RF_2M600: f64 = 0x1A70000000000000;
var _BJ_RF_2P900: f64 = 0x7830000000000000;
var _BJ_RF_2M900: f64 = 0x07B0000000000000;

# 1 when |a − b| ≤ 10⁻¹²·m exactly, the decimal 10⁻¹² (ADR 0002 row 17's rule for a literal threshold, M4 part 2c),
# for finite a and b and a finite m ≥ 0 that is |b| or max(|a|, |b|). With m scaled into [2^-900, 2^900] by 2^±600
# (exact near the cut, where a and b agree to 39 bits), the rounded |a − b| against RN(RN(1e-12)·m) decides outside
# ±0.1 % (their errors are below 2^-52). Inside, a − b is exact (Sterbenz), |a − b|·10^12 = p + e exactly (TwoProduct;
# 10^12 is a double), and the sign of the exact m − p − e (Grow-Expansion) decides.
#must_use
fn _bj_rf_within12(a: f64, b: f64, m: f64): i64 {
    if (m == 0.0) {
        if (a == b) { return 1; }
        return 0;
    }
    var x: f64 = a;
    var y: f64 = b;
    var z: f64 = m;
    var lo2: f64 = _BJ_RF_2M900;
    var hi2: f64 = _BJ_RF_2P900;
    if (z < lo2) {
        var up: f64 = _BJ_RF_2P600;
        x = x * up;
        y = y * up;
        z = z * up;
    } elif (z > hi2) {
        var dn: f64 = _BJ_RF_2M600;
        x = x * dn;
        y = y * dn;
        z = z * dn;
    }
    var d: f64 = x - y;
    var ad: f64 = f64_abs(d);
    var t: f64 = _BJ_RF_REL12 * z;
    var near: f64 = t * 0.999;
    var far: f64 = t * 1.001;
    if (ad <= near) { return 1; }
    if (ad >= far) { return 0; }
    var p, e = _bj_k_two_prod(ad, 1000000000000.0);
    var pv: f64 = p;
    var ev: f64 = e;
    var ex: f64[3];
    var k = _bj_g_grow(&ex, 0, z);
    k = _bj_g_grow(&ex, k, -pv);
    k = _bj_g_grow(&ex, k, -ev);
    if (k == 0) { return 1; }
    var top: f64 = ex[k - 1];
    if (top > 0.0) { return 1; }
    return 0;
}

# The common reference impedance of m's ports into out[0]: 0, or the InvalidParameter code recorded unless the first
# is finite and positive and every other equals it (z0_equal). Mirrors `SMatrix::uniform_z0`.
fn _bj_rf_uniform_z0(m: *BjSMatrix, out: *f64): i64 {
    var n = m.ports;
    if (n == 0) { return _bj_err_invalid_parameter("SMatrix has no reference impedances"); }
    var zp: *f64 = _bj_rf_f64p(m.z0);
    var first: f64 = zp[0];
    var e = _bj_rf_require("port reference impedance", first);
    if (e != 0) { return e; }
    var same = 1;
    for (var k = 0; k < n; k = k + 1) {
        if (_bj_rf_z0_equal(zp[k], first) == 0) { same = 0; }
    }
    if (same == 0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "all port reference impedances must be equal, got [");
        for (var j = 0; j < n; j = j + 1) {
            if (j > 0) { _bj_tx_cstr(t, ", "); }
            _bj_fmt_f64_debug(t, zp[j]);
        }
        _bj_tx_cstr(t, "]");
        return BJ_ERR_INVALID_PARAMETER;
    }
    out[0] = first;
    return 0;
}

# The address a as a *f64 (an untyped word stored into a typed pointer warns; a typed return does not).
#must_use
fn _bj_rf_f64p(a): *f64 {
    return a;
}

# (ar + j·ai)(br + j·bi), hisab's product in Rust's order.
#must_use
fn _bj_rf_cmul(ar: f64, ai: f64, br: f64, bi: f64): (f64, f64) {
    var re: f64 = ar * br - ai * bi;
    var im: f64 = ar * bi + ai * br;
    return (re, im);
}

# A 2-port's T (transfer) parameters from s = [S11, S12, S21, S22] (re, im each) into t = [T11, T12, T21, T22], with
# [b₁, a₁]ᵀ = T [a₂, b₂]ᵀ, T = (1/S21) [[−ΔS, S11], [−S22, 1]]: 0, or the DivisionByZero code recorded when
# |S21|² < 10⁻⁶⁰, exactly for a finite S21 (ADR 0002 row 17). Mirrors rf.rs's `s_to_t`.
fn _bj_rf_s_to_t(s: *f64, t: *f64): i64 {
    var n2: f64 = s[4] * s[4] + s[5] * s[5];
    if (n2 < _BJ_RF_TWO60) {                                        # |S21|² < 10⁻⁶⁰ exactly (ADR 0002 row 17)
        if (_bj_rf_sq_below60(n2, s[4], s[5], 0.0, 0.0) == 1) {
            return _bj_err_division_by_zero("S21 = 0, cannot convert to T-parameters");
        }
    }
    var ir, ii = _bj_rf_recip(s[4], s[5]);
    var ar, ai = _bj_rf_cmul(s[0], s[1], s[6], s[7]);
    var br, bi = _bj_rf_cmul(s[2], s[3], s[4], s[5]);
    var dr: f64 = ar - br;
    var di: f64 = ai - bi;
    var p0, p1 = _bj_rf_cmul(dr, di, ir, ii);
    var q0, q1 = _bj_rf_cmul(s[0], s[1], ir, ii);
    var r0, r1 = _bj_rf_cmul(s[6], s[7], ir, ii);
    t[0] = -p0;
    t[1] = -p1;
    t[2] = q0;
    t[3] = q1;
    t[4] = -r0;
    t[5] = -r1;
    t[6] = ir;
    t[7] = ii;
    return 0;
}

# Rust's cascade through the transfer matrices t1 (self's) and t2 (other's): T = t1·t2, then S = [T12/T22, det T/T22,
# 1/T22, −T21/T22] (re, im each) into o[0..8] and 0, or 1 (nothing recorded) when |T22|² < 10⁻⁶⁰ on the rounded T22.
# Mirrors rf.rs's `cascade` and `t_to_s`; the cascade takes it for non-finite entries, and for the sign of a part
# that is exactly 0 (ADR 0002 row 17, M4 part 2a-2).
fn _bj_rf_cascade_chain(t1: *f64, t2: *f64, o: *f64): i64 {
    var tt: f64[8];
    _bj_rf_tdot(t1, t2, 0, 0, &tt, 0);
    _bj_rf_tdot(t1, t2, 0, 1, &tt, 2);
    _bj_rf_tdot(t1, t2, 1, 0, &tt, 4);
    _bj_rf_tdot(t1, t2, 1, 1, &tt, 6);
    var n2: f64 = tt[6] * tt[6] + tt[7] * tt[7];
    var tiny: f64 = _BJ_RF_TINY60;
    if (n2 < tiny) { return 1; }
    var ir, ii = _bj_rf_recip(tt[6], tt[7]);
    var a0, a1 = _bj_rf_cmul(tt[2], tt[3], ir, ii);
    var b0, b1 = _bj_rf_cmul(tt[0], tt[1], tt[6], tt[7]);
    var c0, c1 = _bj_rf_cmul(tt[2], tt[3], tt[4], tt[5]);
    var d0: f64 = b0 - c0;
    var d1: f64 = b1 - c1;
    var e0, ee1 = _bj_rf_cmul(d0, d1, ir, ii);
    var f0, f1 = _bj_rf_cmul(tt[4], tt[5], ir, ii);
    o[0] = a0;
    o[1] = a1;
    o[2] = e0;
    o[3] = ee1;
    o[4] = ir;
    o[5] = ii;
    o[6] = -f0;
    o[7] = -f1;
    return 0;
}

# Entry (r, c) of the product of 2 × 2 complex matrices a and b, a[r][0]·b[0][c] + a[r][1]·b[1][c], into out[k],
# out[k + 1] (each matrix 8 f64, row-major (re, im)).
fn _bj_rf_tdot(a: *f64, b: *f64, r, c, out: *f64, k) {
    var x0, x1 = _bj_rf_cmul(a[4 * r], a[4 * r + 1], b[2 * c], b[2 * c + 1]);
    var y0, y1 = _bj_rf_cmul(a[4 * r + 2], a[4 * r + 3], b[4 + 2 * c], b[5 + 2 * c]);
    out[k] = x0 + y0;
    out[k + 1] = x1 + y1;
    return 0;
}

impl BjSMatrix {
    # S_ij (ports numbered from 1) into *out: Ok(0), or Err(InvalidParameter) with out untouched unless
    # 1 ≤ i, j ≤ ports. Mirrors `SMatrix::get`.
    #must_use
    public fn get(self, i, j, out: *BjComplex): Result {
        var e = _bj_rf_index(self.ports, i, j);
        if (e != 0) { return Err(e); }
        var p = self.s + ((i - 1) * self.ports + j - 1) * 16;
        out.re = load64(p);
        out.im = load64(p + 8);
        return Ok(0);
    }

    # Sets S_ij (ports numbered from 1) to value: Ok(0), or Err(InvalidParameter) with the matrix untouched unless
    # 1 ≤ i, j ≤ ports. Mirrors `SMatrix::set`.
    #must_use
    public fn set(self, i, j, value: BjComplex): Result {
        var e = _bj_rf_index(self.ports, i, j);
        if (e != 0) { return Err(e); }
        var p = self.s + ((i - 1) * self.ports + j - 1) * 16;
        store64(p, _bj_bits(value.re));
        store64(p + 8, _bj_bits(value.im));
        return Ok(0);
    }

    # Rust's `s[i][j]`, indices from 0 (0 ≤ i, j < ports; unchecked, as the entry's address is).
    #must_use
    public fn s_at(self, i, j): BjComplex {
        var p = self.s + (i * self.ports + j) * 16;
        var z: BjComplex;
        z.re = load64(p);
        z.im = load64(p + 8);
        return z;
    }

    # Rust's `z0[k]`, the reference impedance of port k + 1 (Ω); NaN unless 0 ≤ k < ports.
    #must_use
    public fn z0_at(self, k): f64 {
        if (k < 0 || k >= self.ports) {
            var nan: f64 = _BJ_RF_NAN;
            return nan;
        }
        var zp: *f64 = _bj_rf_f64p(self.z0);
        var z: f64 = zp[k];
        return z;
    }

    # Sets the reference impedance of port k + 1 (Rust's `z0[k] = value`): Ok(0), or Err(InvalidParameter) unless
    # 0 ≤ k < ports. The value is not checked, as Rust's field isn't: cascade and s_to_z check it.
    #must_use
    public fn set_z0(self, k, value: f64): Result {
        if (k < 0 || k >= self.ports) {
            var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(t, "reference impedance index must be below ");
            _bj_tx_u64(t, self.ports);
            _bj_tx_cstr(t, ", got ");
            _bj_tx_u64(t, k);
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        store64(self.z0 + k * 8, _bj_bits(value));
        return Ok(0);
    }

    # The cascade of two 2-ports, self then other (self's port 2 to other's port 1), into a new matrix in *out: Ok(0),
    # or Err with out untouched (and never read). For finite entries, Redheffer's star product with each part rounded
    # once from the exact value (src/crmath_edge.cyr's _bj_cr_cascade; ADR 0002 row 17, M4 part 2a-2): S11 = A11 +
    # A12·A21·B11/D, S12 = A12·B12/D, S21 = A21·B21/D, S22 = B22 + A22·B12·B21/D, D = 1 − A22·B11; a part exactly 0
    # keeps Rust's zero where Rust's chain gives one (+0 otherwise). With a non-finite entry, Rust's chain through the
    # transfer matrices, T = T_self·T_other. InvalidParameter unless both are 2-ports
    # whose reference impedances are all equal (finite, positive); DivisionByZero where S21 of either is 0
    # (|S21|² < 10⁻⁶⁰: no T-parameters) or T22 = D/(S21·S21′) of the product is (|T22|² < 10⁻⁶⁰, exactly for finite
    # entries: a lossless loop, S22·S11′ = 1); Allocation when the result's block, or the exact path's, can't be had.
    # Mirrors `SMatrix::cascade`.
    #must_use
    public fn cascade(self, other: *BjSMatrix, out: *BjSMatrix): Result {
        if (self.ports != 2 || other.ports != 2) {
            return Err(_bj_err_invalid_parameter("cascade requires two 2-port networks"));
        }
        var za: f64[1];
        var zb: f64[1];
        var e1 = _bj_rf_uniform_z0(self, &za);
        if (e1 != 0) { return Err(e1); }
        var e2 = _bj_rf_uniform_z0(other, &zb);
        if (e2 != 0) { return Err(e2); }
        var z0: f64 = za[0];
        var z0o: f64 = zb[0];
        if (_bj_rf_z0_equal(z0, z0o) == 0) {
            var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(t, "cascade requires equal reference impedances, got ");
            _bj_fmt_f64_display(t, z0);
            _bj_tx_cstr(t, " Ω and ");
            _bj_fmt_f64_display(t, z0o);
            _bj_tx_cstr(t, " Ω");
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        if (_bj_log_on(5) == 1) {
            var lb[96];
            var lt[24];
            _bj_tx_init(&lt, &lb, 96);
            _bj_tx_cstr(&lt, "cascading 2-port S-matrices z0=");
            _bj_fmt_f64_debug(&lt, z0);
            _bj_log_text(5, &lt);
        }
        var t1: f64[8];
        var t2: f64[8];
        var e3 = _bj_rf_s_to_t(_bj_rf_f64p(self.s), &t1);
        if (e3 != 0) { return Err(e3); }
        var e4 = _bj_rf_s_to_t(_bj_rf_f64p(other.s), &t2);
        if (e4 != 0) { return Err(e4); }
        var v: f64[16];
        var pa: *f64 = _bj_rf_f64p(self.s);
        var pb: *f64 = _bj_rf_f64p(other.s);
        var fin: f64 = 0.0;
        for (var k = 0; k < 8; k = k + 1) {
            var xa: f64 = pa[k];
            var xb: f64 = pb[k];
            v[k] = xa;
            v[k + 8] = xb;
            fin = fin + (xa - xa) + (xb - xb);
        }
        var r: f64[8];
        if (fin == 0.0) {
            var o: f64[8];
            var f = _bj_cr_cascade(&v, 0, &o);
            if (f == 0) { return Err(_bj_err_division_by_zero("T22 = 0, cannot convert to S-parameters")); }
            if (f == 2) {
                var ta = _bj_err_reason(BJ_ERR_ALLOCATION);
                _bj_tx_cstr(ta, "the cascade's exact buffers");
                return Err(BJ_ERR_ALLOCATION);
            }
            var zm = f >> 2;
            if (zm != 0 && _bj_rf_cascade_chain(&t1, &t2, &r) == 0) {
                for (var k2 = 0; k2 < 8; k2 = k2 + 1) {
                    var rk: f64 = r[k2];
                    if (((zm >> k2) & 1) == 1 && rk == 0.0) { o[k2] = rk; }
                }
            }
            return BjSMatrix_two_port(BjComplex_new(o[0], o[1]), BjComplex_new(o[2], o[3]), BjComplex_new(o[4], o[5]),
              BjComplex_new(o[6], o[7]), z0, out);
        }
        if (_bj_rf_cascade_chain(&t1, &t2, &r) == 1) {
            return Err(_bj_err_division_by_zero("T22 = 0, cannot convert to S-parameters"));
        }
        return BjSMatrix_two_port(BjComplex_new(r[0], r[1]), BjComplex_new(r[2], r[3]), BjComplex_new(r[4], r[5]),
          BjComplex_new(r[6], r[7]), z0, out);
    }
}

# A 2-port's Z-parameters (Ω), Z = Z₀(I + S)(I − S)⁻¹ for a common real reference impedance Z₀ (Pozar Table 4.2), into
# out[0..4] as [[Z11, Z12], [Z21, Z22]], row-major BjComplex: Ok(0), or Err with out untouched. For finite entries
# each part is rounded once from the exact value (src/crmath_edge.cyr's _bj_cr_s2z; ADR 0002 row 17, M4 part 2a-3):
# Z11 = Z₀((1 + S11)(1 − S22) + S12·S21)/det, Z12 = 2Z₀·S12/det, Z21 = 2Z₀·S21/det, Z22 = Z₀((1 − S11)(1 + S22) +
# S12·S21)/det, det = (1 − S11)(1 − S22) − S12·S21; a part exactly 0 keeps Rust's zero where Rust's chain gives one
# (+0 otherwise). With a non-finite entry, Rust's chain. InvalidParameter unless s is a 2-port whose reference
# impedances are all equal (finite, positive); DivisionByZero where I − S is singular (|det(I − S)|² < 10⁻⁶⁰, exactly
# for finite entries: an ideal thru has no Z-parameters); Allocation when the exact path's buffers can't be had.
# Mirrors `rf::s_to_z`.
#must_use
public fn bj_s_to_z(s: *BjSMatrix, out: *BjComplex): Result {
    if (s.ports != 2) { return Err(_bj_err_invalid_parameter("S→Z conversion requires 2-port network")); }
    var zw: f64[1];
    var e = _bj_rf_uniform_z0(s, &zw);
    if (e != 0) { return Err(e); }
    var z0: f64 = zw[0];
    if (_bj_log_on(5) == 1) {
        var lb[96];
        var lt[24];
        _bj_tx_init(&lt, &lb, 96);
        _bj_tx_cstr(&lt, "converting 2-port S-parameters to Z z0=");
        _bj_fmt_f64_debug(&lt, z0);
        _bj_log_text(5, &lt);
    }
    var p: *f64 = _bj_rf_f64p(s.s);
    var v: f64[9];
    var fin: f64 = 0.0;
    for (var k = 0; k < 8; k = k + 1) {
        var x: f64 = p[k];
        v[k] = x;
        fin = fin + (x - x);
    }
    v[8] = z0;
    var o: f64[8];
    var r: f64[8];
    var q: *f64 = _bj_rf_f64p(out);
    if (fin == 0.0) {
        var f = _bj_cr_s2z(&v, 0, &o);
        if (f == 0) { return Err(_bj_err_division_by_zero("singular S→Z conversion")); }
        if (f == 2) {
            var ta = _bj_err_reason(BJ_ERR_ALLOCATION);
            _bj_tx_cstr(ta, "the S→Z conversion's exact buffers");
            return Err(BJ_ERR_ALLOCATION);
        }
        var zm = f >> 2;
        if (zm != 0 && _bj_rf_s2z_chain(p, z0, &r) == 0) {
            for (var k2 = 0; k2 < 8; k2 = k2 + 1) {
                var rk: f64 = r[k2];
                if (((zm >> k2) & 1) == 1 && rk == 0.0) { o[k2] = rk; }
            }
        }
        for (var k3 = 0; k3 < 8; k3 = k3 + 1) { q[k3] = o[k3]; }
        return Ok(0);
    }
    if (_bj_rf_s2z_chain(p, z0, &r) == 1) { return Err(_bj_err_division_by_zero("singular S→Z conversion")); }
    for (var k4 = 0; k4 < 8; k4 = k4 + 1) { q[k4] = r[k4]; }
    return Ok(0);
}

# Rust's S → Z chain for the 2-port entries at p (S11, S12, S21, S22 as (re, im)) and Z₀: det = (1 − S11)(1 − S22) −
# S12·S21, then Z11, Z12, Z21, Z22 (re, im each) into o[0..8] and 0, or 1 (nothing recorded) when |det|² < 10⁻⁶⁰ on
# the rounded det. Mirrors rf.rs's `s_to_z`; bj_s_to_z takes it for non-finite entries, and for the sign of a part
# that is exactly 0 (ADR 0002 row 17, M4 part 2a-3).
fn _bj_rf_s2z_chain(p: *f64, z0: f64, o: *f64): i64 {
    var m11r: f64 = 1.0 - p[0];
    var m11i: f64 = 0.0 - p[1];
    var m22r: f64 = 1.0 - p[6];
    var m22i: f64 = 0.0 - p[7];
    var u11r: f64 = 1.0 + p[0];
    var u11i: f64 = 0.0 + p[1];
    var u22r: f64 = 1.0 + p[6];
    var u22i: f64 = 0.0 + p[7];
    var ar, ai = _bj_rf_cmul(m11r, m11i, m22r, m22i);
    var br, bi = _bj_rf_cmul(p[2], p[3], p[4], p[5]);
    var dr: f64 = ar - br;
    var di: f64 = ai - bi;
    var n2: f64 = dr * dr + di * di;
    var tiny: f64 = _BJ_RF_TINY60;
    if (n2 < tiny) { return 1; }
    var ir, ii = _bj_rf_recip(dr, di);
    var cr, ci = _bj_rf_cmul(u11r, u11i, m22r, m22i);
    var x1r: f64 = cr + br;
    var x1i: f64 = ci + bi;
    var gr, gi = _bj_rf_cmul(m11r, m11i, u22r, u22i);
    var x2r: f64 = gr + br;
    var x2i: f64 = gi + bi;
    var h0, h1 = _bj_rf_cmul(z0, 0.0, x1r, x1i);
    var z11r, z11i = _bj_rf_cmul(h0, h1, ir, ii);
    var w0, w1 = _bj_rf_cmul(z0, 0.0, 2.0, 0.0);
    var k0, k1 = _bj_rf_cmul(w0, w1, p[2], p[3]);
    var z12r, z12i = _bj_rf_cmul(k0, k1, ir, ii);
    var l0, l1 = _bj_rf_cmul(w0, w1, p[4], p[5]);
    var z21r, z21i = _bj_rf_cmul(l0, l1, ir, ii);
    var o0, o1 = _bj_rf_cmul(z0, 0.0, x2r, x2i);
    var z22r, z22i = _bj_rf_cmul(o0, o1, ir, ii);
    o[0] = z11r;
    o[1] = z11i;
    o[2] = z12r;
    o[3] = z12i;
    o[4] = z21r;
    o[5] = z21i;
    o[6] = z22r;
    o[7] = z22i;
    return 0;
}
