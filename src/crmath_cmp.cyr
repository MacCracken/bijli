# crmath_cmp.cyr — the exact Singularity threshold (bijli, M1 part 5d-1, ADR 0002 row 17).
#
# field.rs and charge.rs refuse a field point closer to its source than √(1e-30) m by testing the rounded
# r² = dx² + dy² + dz² against the double nearest 10^-30, and the Green's functions test the rounded R = √r² the same
# way. The user's decision of 2026-11-12 makes the test exact: the exact Σ (aᵢ − bᵢ)² of the inputs themselves against
# 10^-30, or against 10^-60 for R < 10^-30.
#
# The band. The rounded r² is within a few ulps of the exact one: each difference, square and sum is rounded once
# (five roundings, each within half an ulp), and a square that underflows costs at most 2^-1074 absolute, nothing at
# this scale (10^-30 is about 2^-100). R adds one correctly rounded root. A non-finite input makes the rounded value NaN
# or +∞, and Rust's comparison stands. So outside 64 ulps of the double nearest 10^-30 the rounded comparison is the
# exact one, and only inside that band (_bj_x_band's 2) does _bj_x_r2_below run.
#
# The exact test. Each difference is s + t exactly (TwoSum, exact in binary64 with gradual underflow), so
# r² = Σ (s² + 2st + t²): nine products of two doubles, each ±m·2^k with m < 2^107. Times 10^p the sum is compared with
# 1 in integers: Σ ±m·5^p·2^(k + p − b) against 2^(−b), b the least exponent (or 0). In the band no term exceeds
# about 2^-98 (r² is near 10^-30) and none has a bit below 2^-2148 (t² of a subnormal t), so the integers span at most
# about 2,300 bits, inside the 2,560 the 80 limbs of 32 bits hold.

const _BJ_XN_L = 80;
const _BJ_XN_M = 4294967295;

# The origin, for a test of |a|² (b = 0).
var _bj_x_origin[24];

# a = 0.
fn _bj_xn_zero(a) {
    for (var i = 0; i < _BJ_XN_L; i = i + 1) { store64(a + i * 8, 0); }
    return 0;
}

# a = m, for 0 ≤ m < 2^63.
fn _bj_xn_set(a, m) {
    _bj_xn_zero(a);
    store64(a, m & _BJ_XN_M);
    store64(a + 8, m >> 32);
    return 0;
}

# a = a·v, for 0 < v < 2^30: no limb product or carry leaves 2^62.
fn _bj_xn_mul_small(a, v) {
    var carry = 0;
    for (var i = 0; i < _BJ_XN_L; i = i + 1) {
        var t = load64(a + i * 8) * v + carry;
        store64(a + i * 8, t & _BJ_XN_M);
        carry = t >> 32;
    }
    return 0;
}

# acc = acc + a·2^sh, for sh ≥ 0, the sum below 2^2560.
fn _bj_xn_add_shl(acc, a, sh) {
    var q = sh / 32;
    var r = sh % 32;
    var carry = 0;
    for (var i = 0; i + q < _BJ_XN_L; i = i + 1) {
        var x = load64(a + i * 8);
        var lo = (x << r) & _BJ_XN_M;
        var hi = 0;
        if (r > 0) { hi = x >> (32 - r); }
        var t = load64(acc + (i + q) * 8) + lo + carry;
        store64(acc + (i + q) * 8, t & _BJ_XN_M);
        carry = (t >> 32) + hi;
    }
    return 0;
}

# −1, 0 or 1 as a <, =, > b.
#must_use
fn _bj_xn_cmp(a, b): i64 {
    var i = _BJ_XN_L - 1;
    while (i >= 0) {
        var x = load64(a + i * 8);
        var y = load64(b + i * 8);
        if (x < y) { return 0 - 1; }
        if (x > y) { return 1; }
        i = i - 1;
    }
    return 0;
}

# dst = m1·m2·c·5^p, for m1, m2 < 2^53, c 1 or 2, p ≥ 0: m2 in two parts below 2^27, 5^p twelve fives at a time.
fn _bj_xn_term(dst, m1, m2, c, p) {
    var lo[640];
    var hi[640];
    _bj_xn_set(&lo, m1);
    _bj_xn_mul_small(&lo, m2 & 67108863);
    _bj_xn_set(&hi, m1);
    _bj_xn_mul_small(&hi, m2 >> 26);
    _bj_xn_zero(dst);
    _bj_xn_add_shl(dst, &lo, 0);
    _bj_xn_add_shl(dst, &hi, 26);
    if (c == 2) { _bj_xn_mul_small(dst, 2); }
    var f12 = 1;
    for (var k = 0; k < 12; k = k + 1) { f12 = f12 * 5; }
    var q = p;
    while (q >= 12) {
        _bj_xn_mul_small(dst, f12);
        q = q - 12;
    }
    var f = 1;
    for (var j = 0; j < q; j = j + 1) { f = f * 5; }
    if (f > 1) { _bj_xn_mul_small(dst, f); }
    return 0;
}

# The finite double x ≠ 0 as ±m·2^k: m (below 2^53) into out[0], k into out[1]; returns 1 for a negative x.
fn _bj_x_split(x: f64, out): i64 {
    var w = _bj_cr_word(x);
    var a = w & 9223372036854775807;
    var be = a >> 52;
    var m = a & 4503599627370495;
    var k = 0 - 1074;
    if (be != 0) {
        m = m | 4503599627370496;
        k = be - 1075;
    }
    store64(out, m);
    store64(out + 8, k);
    if (w < 0) { return 1; }
    return 0;
}

# 1 when the exact Σᵢ (aᵢ − bᵢ)² (i < 3) is below 10^-p, for finite aᵢ, bᵢ whose differences don't overflow and
# 0 < p ≤ 60 (the section comment).
#must_use
fn _bj_x_r2_below(a: *f64, b: *f64, p): i64 {
    var tm: i64[54];                                         # per term: m1, k1, m2, k2, c, negative
    var nt = 0;
    var sp: i64[2];
    var tp: i64[2];
    for (var i = 0; i < 3; i = i + 1) {
        var ai: f64 = a[i];
        var nb: f64 = -b[i];
        var s, t = _bj_cr_two_sum(ai, nb);
        var sv: f64 = s;
        var tv: f64 = t;
        var sn = 0;
        var tn = 0;
        if (sv != 0.0) { sn = _bj_x_split(sv, &sp); }
        if (tv != 0.0) { tn = _bj_x_split(tv, &tp); }
        if (sv != 0.0) {
            tm[nt * 6] = sp[0];
            tm[nt * 6 + 1] = sp[1];
            tm[nt * 6 + 2] = sp[0];
            tm[nt * 6 + 3] = sp[1];
            tm[nt * 6 + 4] = 1;
            tm[nt * 6 + 5] = 0;
            nt = nt + 1;
        }
        if (sv != 0.0 && tv != 0.0) {
            tm[nt * 6] = sp[0];
            tm[nt * 6 + 1] = sp[1];
            tm[nt * 6 + 2] = tp[0];
            tm[nt * 6 + 3] = tp[1];
            tm[nt * 6 + 4] = 2;
            tm[nt * 6 + 5] = sn ^ tn;
            nt = nt + 1;
        }
        if (tv != 0.0) {
            tm[nt * 6] = tp[0];
            tm[nt * 6 + 1] = tp[1];
            tm[nt * 6 + 2] = tp[0];
            tm[nt * 6 + 3] = tp[1];
            tm[nt * 6 + 4] = 1;
            tm[nt * 6 + 5] = 0;
            nt = nt + 1;
        }
    }
    var base = 0;
    for (var j = 0; j < nt; j = j + 1) {
        var e = tm[j * 6 + 1] + tm[j * 6 + 3] + p;
        if (e < base) { base = e; }
    }
    var P[640];
    var N[640];
    var T[640];
    _bj_xn_zero(&P);
    _bj_xn_zero(&N);
    for (var u = 0; u < nt; u = u + 1) {
        _bj_xn_term(&T, tm[u * 6], tm[u * 6 + 2], tm[u * 6 + 4], p);
        var sh = tm[u * 6 + 1] + tm[u * 6 + 3] + p - base;
        if (tm[u * 6 + 5] == 1) { _bj_xn_add_shl(&N, &T, sh); } else { _bj_xn_add_shl(&P, &T, sh); }
    }
    _bj_xn_set(&T, 1);
    _bj_xn_add_shl(&N, &T, 0 - base);
    if (_bj_xn_cmp(&P, &N) < 0) { return 1; }
    return 0;
}

# The band test for a rounded value v (r² against the double t nearest 10^-30, or R against it): 0 when v is NaN or
# more than 64 ulps above t (not singular), 1 when more than 64 ulps below (singular), 2 inside the band (the exact
# test decides). v is non-negative or NaN.
#must_use
fn _bj_x_band(v: f64, t: f64): i64 {
    if (v != v) { return 0; }
    var w = _bj_cr_word(v) - _bj_cr_word(t);
    if (w > 64) { return 0; }
    if (w < -64) { return 1; }
    return 2;
}

# ── M2's exact thresholds (M2 part 2c-1, ADR 0002 row 17's rule) ────────────────────────────────────────────────────

# M2's tests against 10^-30 of one rounded product, quotient or sum of two inputs (|R·C|, |L/R|, |μ_r·μ₀|,
# |n₁ + n₂|): that value is rounded once, within half an ulp of the exact one, so outside _bj_x_band's 64 ulps the
# rounded comparison is the exact one, and inside it the exact sign below decides. In the band the terms lie within a
# few hundred bits of each other (the value is near 10^-30, so its parts are), well inside the 2,560 bits.

# The sign (−1, 0 or 1) of Σ ±cᵢ·m₁ᵢ·m₂ᵢ·2^(k₁ᵢ + k₂ᵢ)·10^(qᵢ) over the nt terms at tm, seven words each (m₁, k₁, m₂,
# k₂, c, negative, q; m₁, m₂ < 2^53, c 1 or 2, 0 ≤ q ≤ 60), exactly: each term times 5^q in integers, aligned on the
# least exponent of 2 (the callers keep the span inside the capacity).
#must_use
fn _bj_x_sign(tm: *i64, nt): i64 {
    var base = 0;
    for (var j = 0; j < nt; j = j + 1) {
        var e = tm[j * 7 + 1] + tm[j * 7 + 3] + tm[j * 7 + 6];
        if (j == 0 || e < base) { base = e; }
    }
    var P[640];
    var N[640];
    var T[640];
    _bj_xn_zero(&P);
    _bj_xn_zero(&N);
    for (var u = 0; u < nt; u = u + 1) {
        _bj_xn_term(&T, tm[u * 7], tm[u * 7 + 2], tm[u * 7 + 4], tm[u * 7 + 6]);
        var sh = tm[u * 7 + 1] + tm[u * 7 + 3] + tm[u * 7 + 6] - base;
        if (tm[u * 7 + 5] == 1) { _bj_xn_add_shl(&N, &T, sh); } else { _bj_xn_add_shl(&P, &T, sh); }
    }
    var r = _bj_xn_cmp(&P, &N);
    return r;
}

# tm's term j := ±x·y·10^q for finite nonzero x and y (y = 1 for a single double), its sign flipped when flip is 1.
fn _bj_x_put2(tm: *i64, j, x: f64, y: f64, q, flip) {
    var sx: i64[2];
    var sy: i64[2];
    var nx = _bj_x_split(x, &sx);
    var ny = _bj_x_split(y, &sy);
    tm[j * 7] = sx[0];
    tm[j * 7 + 1] = sx[1];
    tm[j * 7 + 2] = sy[0];
    tm[j * 7 + 3] = sy[1];
    tm[j * 7 + 4] = 1;
    tm[j * 7 + 5] = nx ^ ny ^ flip;
    tm[j * 7 + 6] = q;
    return 0;
}

# 1 when the exact |x·y| < 10^-p, else 0, for finite nonzero x and y (0 < p ≤ 60).
#must_use
fn _bj_x_prod_below(x: f64, y: f64, p): i64 {
    var tm: i64[14];
    var ax: f64 = f64_abs(x);
    var ay: f64 = f64_abs(y);
    _bj_x_put2(&tm, 0, ax, ay, p, 0);
    _bj_x_put2(&tm, 1, 1.0, 1.0, 0, 1);
    if (_bj_x_sign(&tm, 2) < 0) { return 1; }
    return 0;
}

# 1 when the exact |x/y| < 10^-p (|x|·10^p < |y|), else 0, for finite nonzero x and y (0 < p ≤ 60).
#must_use
fn _bj_x_quot_below(x: f64, y: f64, p): i64 {
    var tm: i64[14];
    var ax: f64 = f64_abs(x);
    var ay: f64 = f64_abs(y);
    _bj_x_put2(&tm, 0, ax, 1.0, p, 0);
    _bj_x_put2(&tm, 1, ay, 1.0, 0, 1);
    if (_bj_x_sign(&tm, 2) < 0) { return 1; }
    return 0;
}

# 1 when the exact |x + y| < 10^-p, else 0, for finite x and y (0 < p ≤ 60): x + y = s + t exactly (TwoSum), and
# |s + t| = sign(s)·(s + t) since |t| ≤ half an ulp of s.
#must_use
fn _bj_x_sum_below(x: f64, y: f64, p): i64 {
    var s, t = _bj_cr_two_sum(x, y);
    var sv: f64 = s;
    var tv: f64 = t;
    if (sv == 0.0) { return 1; }
    var tm: i64[21];
    var flip = 0;
    if (sv < 0.0) { flip = 1; }
    _bj_x_put2(&tm, 0, sv, 1.0, p, flip);
    var nt = 1;
    if (tv != 0.0) {
        _bj_x_put2(&tm, 1, tv, 1.0, p, flip);
        nt = 2;
    }
    _bj_x_put2(&tm, nt, 1.0, 1.0, 0, 1);
    if (_bj_x_sign(&tm, nt + 1) < 0) { return 1; }
    return 0;
}

# ── M3's exact thresholds (M3 part 2c, ADR 0002 row 17 amended) ─────────────────────────────────────────────────────

# The sign of S − 10^p, S = (a·b + c)² + (e·f)², for finite doubles: Mie's |m|·x against 10⁷, squared (X = Re m·x,
# Y = Im m·x), and the shape of propagate_beam's |C·q + D|² against 10^-60 (X = C·q₀ + D, Y = C·q₁).
# - The band. The rounded X̃ = (a·b) + c and Ỹ = e·f lie within 2^-53·(|a·b| + |X̃|) + 2^-1075 and 2^-53·|Ỹ| + 2^-1075
#   of X and Y (one rounding each, a subnormal one absolute), so bounds on |X| and |Y| widened by 2^-52·(|a·b| + |X̃|) +
#   2^-1022 and 2^-52·|Ỹ| + 2^-1022 give S within a few roundings of [S_lo, S_hi]. S_lo above t·(1 + 2^-40) or S_hi
#   below t·(1 − 2^-40), t the double nearest 10^p, decides; only inside that band, or after a cancellation in X̃, does
#   the exact test below run.
# - The exact test. X is exact as a signed bignum (src/fmtf.cyr's, 32-bit limbs; buffers of 160 words, 5,088 bits)
#   aligned on its terms' least exponent of 2. An |X| or |Y| at or past 2^elim decides (the caller's 2^elim is at least
#   2·√(10^p), and elim ≤ 52). Else X², Y² and 10^p = 5^p·2^p are compared as integers aligned on the least exponent:
#   every term lies below 2^(2·elim + 1) and none has a bit under 2^-4296 (the square of a product of subnormals), so
#   with 5^60 the integers stay under 4,600 bits. Near the threshold X's terms are both small, or within a factor of
#   about 2 of each other (a cancellation), so X spans at most about 2,200 bits. Any finite operands keep X under 3,200
#   bits, so the exact test is sound on its own too (cr_verify.py's `sumsq_exact` runs it alone).

# The band's constants: DBL_MAX, 2^-52, 2^-1022 (an absolute bound above every subnormal rounding error), 2^-40.
var _BJ_X_BIG: f64 = 0x7FEFFFFFFFFFFFFF;
var _BJ_X_U52: f64 = 0x3CB0000000000000;
var _BJ_X_TINY: f64 = 0x0010000000000000;
var _BJ_X_U40: f64 = 0x3D70000000000000;

# dst := a·b (dst distinct from a and b), schoolbook on b's 32-bit limbs through _bj_g_mul; t and u scratch.
fn _bj_xq_mul(dst, a, b, t, u) {
    store64(dst, 0);
    var nb = load64(b);
    for (var j = 0; j < nb; j = j + 1) {
        var l = load64(b + 8 + j * 8);
        if (l != 0) {
            _bj_bn_copy(t, a);
            _bj_g_mul(t, l, u);
            _bj_bn_shl(t, 32 * j);
            _bj_g_add_to(dst, t);
        }
    }
    return 0;
}

# a := a·5^q for 0 ≤ q ≤ 60, in steps of 5^13 (below 2^31).
fn _bj_xq_mul5(a, q) {
    var left = q;
    while (left >= 13) {
        _bj_bn_mul_small(a, 1220703125);
        left = left - 13;
    }
    var f = 1;
    for (var i = 0; i < left; i = i + 1) { f = f * 5; }
    if (f > 1) { _bj_bn_mul_small(a, f); }
    return 0;
}

# |x·y| as a bignum into dst (t scratch), for finite nonzero x and y; returns its exponent of 2.
fn _bj_xq_prod(x: f64, y: f64, dst, t): i64 {
    var mx: i64[2];
    var my: i64[2];
    _bj_g_split(x, &mx);
    _bj_g_split(y, &my);
    _bj_bn_set(dst, mx[0]);
    _bj_g_mul(dst, my[0], t);
    return mx[1] + my[1];
}

# The exact sign (−1, 0 or 1) of (a·b + c)² + (e·f)² − 10^p for finite doubles, −60 ≤ p ≤ 60 and the caller's elim
# (the section comment).
#must_use
fn _bj_x_sumsq_exact(a: f64, b: f64, c: f64, e: f64, f: f64, p, elim): i64 {
    var pb: i64[160];
    var cb: i64[160];
    var xb: i64[160];
    var yb: i64[160];
    var tb: i64[160];
    var ub: i64[160];
    var sp = 0;
    var ep = 0;
    if (a != 0.0 && b != 0.0) {
        ep = _bj_xq_prod(a, b, &pb, &tb);
        sp = 1;
        if (a < 0.0) { sp = 0 - sp; }
        if (b < 0.0) { sp = 0 - sp; }
    }
    var sc = 0;
    var ec = 0;
    if (c != 0.0) {
        var mc: i64[2];
        _bj_g_split(c, &mc);
        _bj_bn_set(&cb, mc[0]);
        ec = mc[1];
        sc = 1;
        if (c < 0.0) { sc = 0 - 1; }
    }
    var sx = 0;
    var kx = 0;
    if (sp != 0 && sc != 0) {
        kx = ep;
        if (ec < kx) { kx = ec; }
        _bj_bn_shl(&pb, ep - kx);
        _bj_bn_shl(&cb, ec - kx);
        if (sp == sc) {
            _bj_bn_sum(&xb, &pb, &cb);
            sx = 1;
        } else {
            var cm = _bj_bn_cmp(&pb, &cb);
            if (cm > 0) {
                _bj_bn_copy(&xb, &pb);
                _bj_bn_sub(&xb, &cb);
                sx = 1;
            } elif (cm < 0) {
                _bj_bn_copy(&xb, &cb);
                _bj_bn_sub(&xb, &pb);
                sx = 1;
            }
        }
    } elif (sp != 0) {
        _bj_bn_copy(&xb, &pb);
        sx = 1;
        kx = ep;
    } elif (sc != 0) {
        _bj_bn_copy(&xb, &cb);
        sx = 1;
        kx = ec;
    }
    if (sx != 0 && _bj_g_bitlen(&xb) + kx > elim) { return 1; }
    var sy = 0;
    var ky = 0;
    if (e != 0.0 && f != 0.0) {
        ky = _bj_xq_prod(e, f, &yb, &tb);
        sy = 1;
        if (_bj_g_bitlen(&yb) + ky > elim) { return 1; }
    }
    # X² into pb, Y² into cb, aligned on g, the least exponent of 2 among them and 10^p's.
    var g = p;
    store64(&pb, 0);
    store64(&cb, 0);
    if (sx != 0) {
        _bj_xq_mul(&pb, &xb, &xb, &tb, &ub);
        if (2 * kx < g) { g = 2 * kx; }
    }
    if (sy != 0) {
        _bj_xq_mul(&cb, &yb, &yb, &tb, &ub);
        if (2 * ky < g) { g = 2 * ky; }
    }
    if (sx != 0) { _bj_bn_shl(&pb, 2 * kx - g); }
    if (sy != 0) { _bj_bn_shl(&cb, 2 * ky - g); }
    _bj_bn_sum(&xb, &pb, &cb);
    _bj_bn_set(&yb, 1);
    if (p >= 0) {
        _bj_xq_mul5(&yb, p);
    } else {
        _bj_xq_mul5(&xb, 0 - p);
    }
    _bj_bn_shl(&yb, p - g);
    var r = _bj_bn_cmp(&xb, &yb);
    return r;
}

# The sign (−1, 0 or 1) of (a·b + c)² + (e·f)² − 10^p for finite doubles, t the double nearest 10^p (−60 ≤ p ≤ 60),
# and elim the caller's (the section comment): the band on the rounded values, then the exact test.
#must_use
fn _bj_x_sumsq_sign(a: f64, b: f64, c: f64, e: f64, f: f64, t: f64, p, elim): i64 {
    var pr: f64 = a * b;
    var xr: f64 = pr + c;
    var yr: f64 = e * f;
    var ax: f64 = f64_abs(xr);
    var ay: f64 = f64_abs(yr);
    var big: f64 = _BJ_X_BIG;
    if (ax > big || ay > big) { return 1; }
    var u: f64 = _BJ_X_U52;
    var tiny: f64 = _BJ_X_TINY;
    var ap: f64 = f64_abs(pr);
    var ex: f64 = ap * u + ax * u + tiny;
    var ey: f64 = ay * u + tiny;
    var lx: f64 = ax - ex;
    var ly: f64 = ay - ey;
    if (lx < 0.0) { lx = 0.0; }
    if (ly < 0.0) { ly = 0.0; }
    var hx: f64 = ax + ex;
    var hy: f64 = ay + ey;
    var slo: f64 = lx * lx + ly * ly;
    var shi: f64 = hx * hx + hy * hy;
    var m: f64 = t * _BJ_X_U40;
    var thi: f64 = t + m;
    var tlo: f64 = t - m;
    if (slo > thi) { return 1; }
    if (shi < tlo) { return 0 - 1; }
    var r = _bj_x_sumsq_exact(a, b, c, e, f, p, elim);
    return r;
}
