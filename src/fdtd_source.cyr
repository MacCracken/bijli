# fdtd_source.cyr — fdtd.rs's sources (M5 part 1b): the Gaussian pulse, the Ricker wavelet, the differentiated and the
# modulated Gaussian, and the total-field/scattered-field plane-wave source `TfsfSource`. SI units: times in seconds,
# frequencies in Hz, lengths in metres.
#
# The pulses are Rust's chains on src/crmath.cyr's correctly rounded exp and sin. A width τ of 0 or NaN gives 0.0.
#
# A BjTfsfSource holds the 1D auxiliary grid that carries the incident plane wave (E_z, H_y travelling in +x), with a
# first-order Mur boundary at each end. Its two arrays and a scratch row are one anonymous mmap, fixed at construction
# and given back by BjTfsfSource_free (ADR 0002 row 2): `inc_e` and `inc_h` are their addresses and `nx` their length.
# The updates run on the packed f64v_* verbs, each lane rounding Rust's three operations (port plan §9.3), and a cell
# whose update leaves the normal range runs it with an unbounded exponent (ADR 0002 row 18). Rust's
# `TfsfSource::new` clamped invalid input with a warning; here both constructors validate and return Err, as
# `try_new` does (ADR 0002 row 3). The file is time-domain only; bijli's one harmonic convention, e^{+jωt}, is stated
# in src/complex.cyr's header.

private

var _BJ_FS_INF: f64 = 0x7FF0000000000000;
# std::f64::consts::PI, as src/mathx.cyr's _BJ_PI (private to that file).
var _BJ_FS_PI: f64 = 3.141592653589793;
# 10⁻¹²: the tolerance on the 1D Courant limit c·dt ≤ dx·(1 + 10⁻¹²), so dt = dx/c computed in binary64 passes.
var _BJ_FS_REL12: f64 = 0.000000000001;
# The largest nx whose mapping (24 bytes a cell: E, H and the scratch row) a 64-bit length can hold.
var _BJ_FS_MAX_CELLS = 384307168202282325;

# A word as a *f64 (the typed return keeps the binding typed).
#must_use
fn _bj_fs_f64p(a): *f64 {
    return a;
}

# 1 when c·dt > dx·(1 + 10⁻¹²) exactly, the decimal 10⁻¹² (ADR 0002 row 17, M5 part 2c), for finite dt, dx > 0: the
# rounded c·dt against RN(dx·RN(1 + 1e-12)) decides outside ±10⁻⁶ (their errors are below 2^-51); inside, and where
# either is ∞ or below DBL_MIN, the sign of the exact 10¹²·c·dt − (10¹² + 1)·dx (src/crmath_edge.cyr's rational 15).
# Rust's rounded test accepted dt up to a few ulps past the limit (the double 1 + 1e-12 lies above 1 + 10⁻¹²).
#must_use
fn _bj_fs_courant_over(dt: f64, dx: f64): i64 {
    var c: f64 = BJ_SPEED_OF_LIGHT;
    var cdt: f64 = c * dt;
    var tol: f64 = 1.0 + _BJ_FS_REL12;
    var lim: f64 = dx * tol;
    var dmin: f64 = 0x0010000000000000;
    if (cdt < _BJ_FS_INF && lim < _BJ_FS_INF && cdt >= dmin && lim >= dmin) {
        var lo: f64 = lim * 0.999999;
        var hi: f64 = lim * 1.000001;
        if (cdt < lo) { return 0; }
        if (cdt > hi) { return 1; }
    }
    var rv: f64[5];
    rv[0] = 1000000000000.0;
    rv[1] = c;
    rv[2] = dt;
    rv[3] = 1000000000001.0;
    rv[4] = dx;
    var ro: f64[1];
    var k = _bj_cr_rat(&rv, 5, _bj_cr_rat_spec(15), 0, &ro);
    var s: f64 = ro[0];
    if (s > 0.0) { return 1; }
    return 0;
}

# 1 when x is finite and strictly positive (NaN-safe). Mirrors fdtd.rs's `is_positive_finite`.
#must_use
fn _bj_fs_pos(x: f64): i64 {
    if (x > 0.0 && x < _BJ_FS_INF) { return 1; }
    return 0;
}

# 1 when a ≥ b as usize words (a negative word is past 2^63).
#must_use
fn _bj_fs_uge(a, b): i64 {
    if ((a < 0) == (b < 0)) {
        if (a >= b) { return 1; }
        return 0;
    }
    if (a < 0) { return 1; }
    return 0;
}

# ── the pulses ──────────────────────────────────────────────────────────────────────────────────────────────────────

# 2^-1022 and 2^-300: the normal range's floor, and the |x| below which e^x is 1 at 53 bits.
var _BJ_FS_DMIN: f64 = 0x0010000000000000;
var _BJ_FS_2M300: f64 = 0x2D30000000000000;

# 1 when x is 0, or finite with |x| ≥ 2^-1022: an intermediate the pulses' chains can keep (ADR 0002 row 18).
#must_use
fn _bj_fs_normal(x: f64): i64 {
    if (x == 0.0) { return 1; }
    var a: f64 = f64_abs(x);
    if (a >= _BJ_FS_DMIN && a < _BJ_FS_INF) { return 1; }
    return 0;
}

# 1 when every one of t, t₀ and τ is finite.
#must_use
fn _bj_fs_fin3(t: f64, t0: f64, tau: f64): i64 {
    var z: f64 = t * 0.0 + t0 * 0.0 + tau * 0.0;
    if (z == 0.0) { return 1; }
    return 0;
}

# u = (t − t₀)/τ, each operation to 53 bits with an unbounded exponent: (s, e).
#must_use
fn _bj_fs_arg_ux(t: f64, t0: f64, tau: f64): (f64, i64) {
    var ts, te = _bj_k_ux_from(t);
    var us, ue = _bj_k_ux_from(t0);
    var ds, de = _bj_k_ux_sub(ts, te, us, ue);
    var vs, ve = _bj_k_ux_from(tau);
    var as, ae = _bj_k_ux_div(ds, de, vs, ve);
    return (as, ae);
}

# e^x to 53 bits with an unbounded exponent for the 53-bit x = xs·2^xe: 1 for x = 0 or |x| < 2^-300 (e^x rounds to 1),
# _bj_ux_exp_wide's value to |x| = 2^47, and its far stand-in (1, ±_BJ_UX_FAR) beyond.
#must_use
fn _bj_fs_exp_ux(xs: f64, xe): (f64, i64) {
    if (xs == 0.0) { return (1.0, 0); }
    if (xe > 46) {
        if (xs > 0.0) { return (1.0, _BJ_UX_FAR); }
        return (1.0, 0 - _BJ_UX_FAR);
    }
    var x: f64 = _bj_k_ux_round(xs, xe, 0.0);
    var ax: f64 = f64_abs(x);
    if (ax < _BJ_FS_2M300) { return (1.0, 0); }
    var gs, ge = _bj_ux_exp_wide(x);
    return (gs, ge);
}

# 1 when τ is 0 or NaN, where every pulse is 0.0.
#must_use
fn _bj_fs_no_width(tau: f64): i64 {
    if (tau == 0.0 || tau != tau) { return 1; }
    return 0;
}

# The Gaussian pulse exp(−((t − t₀)/τ)²): 1 at t₀; 0.0 for τ = 0 or NaN. Where t − t₀ overflows for finite arguments
# (against a τ that brings u back), the chain runs with an unbounded exponent to its exp (ADR 0002 row 18, M5 part
# 2d-1); its other edges need nothing (a subnormal t − t₀ is exact, a subnormal u gives e⁰ = 1, an infinite one 0, as
# the unbounded chain does). Mirrors `gaussian_pulse`.
#must_use
public fn bj_gaussian_pulse(t: f64, t0: f64, tau: f64): f64 {
    if (_bj_fs_no_width(tau) == 1) { return 0.0; }
    var d: f64 = t - t0;
    var arg: f64 = d / tau;
    var na: f64 = -arg;
    var x: f64 = na * arg;
    var g: f64 = _bj_exp(x);
    var ad: f64 = f64_abs(d);
    if (ad == _BJ_FS_INF && _bj_fs_fin3(t, t0, tau) == 1) {
        var as, ae = _bj_fs_arg_ux(t, t0, tau);
        var ns, ne = _bj_k_ux_neg(as, ae);
        var xs, xe = _bj_k_ux_mul(ns, ne, as, ae);
        if (xs == 0.0) { return 1.0; }
        if (xe > 10) { return 0.0; }
        var xd: f64 = _bj_k_ux_round(xs, xe, 0.0);
        g = _bj_exp(xd);
    }
    return g;
}

# The Ricker wavelet (1 − 2u²)·exp(−u²), u = (t − t₀)/τ: even, 1 at t₀, no DC content; 0.0 for τ = 0 or NaN. Where an
# intermediate leaves the normal range for finite arguments (u² past DBL_MAX, where Rust's −∞·0 was NaN for −0;
# e^{−u²} below 2^-1022 while 1 − 2u² lifts the product back; t − t₀ or u past either end), the chain runs with an
# unbounded exponent and the product is rounded once (ADR 0002 row 18, M5 part 2d-1). Mirrors `ricker_wavelet`.
#must_use
public fn bj_ricker_wavelet(t: f64, t0: f64, tau: f64): f64 {
    if (_bj_fs_no_width(tau) == 1) { return 0.0; }
    var d: f64 = t - t0;
    var arg: f64 = d / tau;
    var arg2: f64 = arg * arg;
    var a: f64 = 2.0 * arg2;
    var c: f64 = 1.0 - a;
    var na: f64 = -arg2;
    var g: f64 = _bj_exp(na);
    var r: f64 = c * g;
    var ok = _bj_fs_normal(d) & _bj_fs_normal(arg) & _bj_fs_normal(arg2) & _bj_fs_normal(g);
    if (_bj_fs_fin3(t, t0, tau) == 1 && ok == 0) {
        var as, ae = _bj_fs_arg_ux(t, t0, tau);
        var a2s, a2e = _bj_k_ux_mul(as, ae, as, ae);
        var cs, ce = _bj_k_ux_sub(1.0, 0, a2s, a2e + 1);
        var ns, ne = _bj_k_ux_neg(a2s, a2e);
        var gs, ge = _bj_fs_exp_ux(ns, ne);
        r = _bj_k_ux_mul_f64(cs, ce, gs, ge);
    }
    return r;
}

# The differentiated Gaussian −2(t − t₀)/τ²·exp(−((t − t₀)/τ)²), the time derivative of the Gaussian pulse, as Rust's
# (−2u/τ)·exp(−u²); 0.0 for τ = 0 or NaN. Where an intermediate leaves the normal range for finite arguments (−2u/τ
# past DBL_MAX against an e^{−u²} below 2^-1022, Rust's ∞·0 = NaN; u subnormal), the chain runs with an unbounded
# exponent and the product is rounded once (ADR 0002 row 18, M5 part 2d-1). Mirrors `differentiated_gaussian`.
#must_use
public fn bj_differentiated_gaussian(t: f64, t0: f64, tau: f64): f64 {
    if (_bj_fs_no_width(tau) == 1) { return 0.0; }
    var d: f64 = t - t0;
    var arg: f64 = d / tau;
    var m: f64 = -2.0 * arg;
    var q: f64 = m / tau;
    var na: f64 = -arg;
    var x: f64 = na * arg;
    var g: f64 = _bj_exp(x);
    var r: f64 = q * g;
    var ok = _bj_fs_normal(d) & _bj_fs_normal(arg) & _bj_fs_normal(q) & _bj_fs_normal(g);
    if (_bj_fs_fin3(t, t0, tau) == 1 && ok == 0) {
        var as, ae = _bj_fs_arg_ux(t, t0, tau);
        var ms, me = _bj_k_ux_neg(as, ae + 1);
        var vs, ve = _bj_k_ux_from(tau);
        var qs, qe = _bj_k_ux_div(ms, me, vs, ve);
        var ns, ne = _bj_k_ux_neg(as, ae);
        var xs, xe = _bj_k_ux_mul(ns, ne, as, ae);
        var gs, ge = _bj_fs_exp_ux(xs, xe);
        r = _bj_k_ux_mul_f64(qs, qe, gs, ge);
    }
    return r;
}

# The modulated Gaussian exp(−((t − t₀)/τ)²)·sin(2πf₀(t − t₀)), its sine's argument Rust's (2π·f₀)·(t − t₀); 0.0 for
# τ = 0 or NaN. Where an intermediate leaves the normal range for finite arguments (the phase past DBL_MAX, where Rust
# took the sine of ∞; e^{−u²} below 2^-1022; t − t₀, u or 2πf₀ past either end), the chain runs with an unbounded
# exponent, the sine past DBL_MAX by Payne–Hanek (_bj_vx_sin53), and the product is rounded once (ADR 0002 row 18, M5
# part 2d-1). Mirrors `modulated_gaussian_pulse`.
#must_use
public fn bj_modulated_gaussian_pulse(t: f64, t0: f64, tau: f64, frequency: f64): f64 {
    if (_bj_fs_no_width(tau) == 1) { return 0.0; }
    var d: f64 = t - t0;
    var arg: f64 = d / tau;
    var na: f64 = -arg;
    var x: f64 = na * arg;
    var g: f64 = _bj_exp(x);
    var w: f64 = 2.0 * _BJ_FS_PI;
    var wf: f64 = w * frequency;
    var ph: f64 = wf * d;
    var s: f64 = _bj_sin(ph);
    var r: f64 = g * s;
    var ok = _bj_fs_normal(d) & _bj_fs_normal(arg) & _bj_fs_normal(g) & _bj_fs_normal(wf) & _bj_fs_normal(ph);
    var zf: f64 = frequency * 0.0;
    if (_bj_fs_fin3(t, t0, tau) == 1 && zf == 0.0 && ok == 0) {
        var as, ae = _bj_fs_arg_ux(t, t0, tau);
        var ns, ne = _bj_k_ux_neg(as, ae);
        var xs, xe = _bj_k_ux_mul(ns, ne, as, ae);
        var gs, ge = _bj_fs_exp_ux(xs, xe);
        var ts, te = _bj_k_ux_from(t);
        var us, ue = _bj_k_ux_from(t0);
        var ds, de = _bj_k_ux_sub(ts, te, us, ue);
        var ws, we = _bj_k_ux_from(w);
        var fs, fe = _bj_k_ux_from(frequency);
        var wfs, wfe = _bj_k_ux_mul(ws, we, fs, fe);
        var ps, pe = _bj_k_ux_mul(wfs, wfe, ds, de);
        var ss, se = _bj_vx_sin53(ps, pe);
        r = _bj_k_ux_mul_f64(gs, ge, ss, se);
    }
    return r;
}

# ── the TF/SF source ────────────────────────────────────────────────────────────────────────────────────────────────

# A TF/SF plane-wave source: the 1D auxiliary grid of the incident wave. `inc_e` and `inc_h` are the addresses of nx
# f64 each: E^inc at x = i·dx and H^inc at x = (i + ½)·dx (inc_h[nx − 1] stays 0); after k calls to step, E^inc is at
# time k·dt and H^inc at (k − ½)·dt. `boundary_x` is the first total-field column and `source_cell` the soft source's
# node; both stay writable, as Rust's public fields, and step and the incident_* readers guard them. `e_coeff_1d`
# dt/(ε₀dx), `h_coeff_1d` dt/(μ₀dx) and `abc_coeff` (S − 1)/(S + 1), S = c·dt/dx, are fixed. `work` is the update's
# scratch row (no Rust counterpart) and `map_bytes` the mapping's length (0 once freed). `abc_coeff` is rounded once
# from the exact (c·dt − dx)/(c·dt + dx) (ADR 0002 row 40). Mirrors `TfsfSource`.
#
# The left-edge recipe for a boundary at bx, with updates H[i] += c_h·(E[i + 1] − E[i]) and E[i] += c_e·(H[i] − H[i −
# 1]) (BjFdtd1d's, and the 2D TM grid's H_y and E_z): update H, then H[bx − 1] −= c_h·incident_e(); call step(source);
# update E, then E[bx] −= c_e·incident_h() (Schneider, *Understanding the FDTD Method*, §3.10–3.11).
public struct BjTfsfSource {
    inc_e;
    inc_h;
    boundary_x;
    source_cell;
    nx;
    e_coeff_1d: f64;
    h_coeff_1d: f64;
    abc_coeff: f64;
    work;
    map_bytes;
}

# Records InvalidParameter "<head>{n}<mid>{m}" with n and m usize; returns its code.
fn _bj_fs_bad_range(head, n, mid, m): i64 {
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, head);
    _bj_tx_u64(t, n);
    _bj_tx_cstr(t, mid);
    _bj_tx_u64(t, m);
    return BJ_ERR_INVALID_PARAMETER;
}

# Creates a TF/SF source over nx cells (a usize) with its boundary at column boundary_x into *out: the soft source at
# max(boundary_x/4, 1) (at most nx − 2), every field zero. Ok(0), or with out empty:
# - Err(InsufficientResolution) for nx < 3;
# - Err(InvalidParameter) "TFSF boundary_x must be in 1..{nx}, got {boundary_x}" unless 1 ≤ boundary_x < nx;
# - Err(InvalidParameter) "dx must be finite and positive, got {dx}";
# - Err(InvalidParameter) "dt must be in (0, dx/c] = (0, {dx/c}], got {dt}" unless 0 < dt and c·dt ≤ dx·(1 + 10⁻¹²)
#   (the 1D Courant limit, decided exactly: ADR 0002 row 17);
# - Err(Allocation) when the grid's mapping can't be had (Rust's vec! aborts; ADR 0002 row 9).
# Give it back with BjTfsfSource_free. Mirrors `TfsfSource::try_new`.
#must_use
public fn BjTfsfSource_try_new(nx, boundary_x, dx: f64, dt: f64, out: *BjTfsfSource): Result {
    memset(out, 0, sizeof(BjTfsfSource));
    if (nx >= 0 && nx < 3) {
        var nf: f64 = f64_from(nx);
        var size: f64 = nf * dx;
        return Err(_bj_err_insufficient_resolution(nx, size));
    }
    if (boundary_x == 0 || _bj_fs_uge(boundary_x, nx) == 1) {
        return Err(_bj_fs_bad_range("TFSF boundary_x must be in 1..", nx, ", got ", boundary_x));
    }
    if (_bj_fs_pos(dx) == 0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "dx must be finite and positive, got ");
        _bj_fmt_f64_display(t, dx);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var c: f64 = BJ_SPEED_OF_LIGHT;
    var cdt: f64 = c * dt;
    if (_bj_fs_pos(dt) == 0 || _bj_fs_courant_over(dt, dx) == 1) {
        var td = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(td, "dt must be in (0, dx/c] = (0, ");
        var dxc: f64 = dx / c;
        _bj_fmt_f64_display(td, dxc);
        _bj_tx_cstr(td, "], got ");
        _bj_fmt_f64_display(td, dt);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var map = 0;
    if (nx > 0 && nx <= _BJ_FS_MAX_CELLS) { map = mmap_anon(nx * 24); }
    if (map == 0) {
        var ta = _bj_err_reason(BJ_ERR_ALLOCATION);
        _bj_tx_cstr(ta, "a TFSF auxiliary grid of ");
        _bj_tx_u64(ta, nx);
        _bj_tx_cstr(ta, " cells");
        return Err(BJ_ERR_ALLOCATION);
    }
    # dt/(ε₀dx) and dt/(μ₀dx), each rounded once (ADR 0002 row 13, M5 part 2b).
    var mn: f64[1];
    var md: f64[2];
    mn[0] = dt;
    md[0] = BJ_EPSILON_0;
    md[1] = dx;
    var ec: f64 = _bj_k_cr_mono(&mn, 1, &md, 2);
    md[0] = BJ_MU_0;
    var hc: f64 = _bj_k_cr_mono(&mn, 1, &md, 2);
    var s: f64 = cdt / dx;
    var sm: f64 = s - 1.0;
    var sp: f64 = s + 1.0;
    var abc: f64 = sm / sp;
    # (S − 1)/(S + 1) = (c·dt − dx)/(c·dt + dx), rounded once (ADR 0002 row 40, M5 part 2a-1b): Rust's cancelled at
    # the magic time step S = 1. The arguments are finite and positive here, so the denominator isn't 0.
    var rv: f64[3];
    rv[0] = dt;
    rv[1] = dx;
    rv[2] = c;
    var ro: f64[1];
    if (_bj_cr_rat(&rv, 3, _bj_cr_rat_spec(10), 0, &ro) == 1) { abc = ro[0]; }
    var sc = boundary_x / 4;
    if (sc < 1) { sc = 1; }
    if (sc > nx - 2) { sc = nx - 2; }
    out.inc_e = map;
    out.inc_h = map + nx * 8;
    out.work = map + nx * 16;
    out.boundary_x = boundary_x;
    out.source_cell = sc;
    out.nx = nx;
    out.e_coeff_1d = ec;
    out.h_coeff_1d = hc;
    out.abc_coeff = abc;
    out.map_bytes = nx * 24;
    if (_bj_log_on(4) == 1) {
        var lb[256];
        var lt[24];
        _bj_tx_init(&lt, &lb, 256);
        _bj_tx_cstr(&lt, "TFSF source created nx=");
        _bj_tx_u64(&lt, nx);
        _bj_tx_cstr(&lt, " boundary_x=");
        _bj_tx_u64(&lt, boundary_x);
        _bj_tx_cstr(&lt, " source_cell=");
        _bj_tx_u64(&lt, sc);
        _bj_tx_cstr(&lt, " dx=");
        _bj_fmt_f64_debug(&lt, dx);
        _bj_tx_cstr(&lt, " dt=");
        _bj_fmt_f64_debug(&lt, dt);
        _bj_tx_cstr(&lt, " courant=");
        _bj_fmt_f64_debug(&lt, s);
        _bj_log_text(4, &lt);
    }
    return Ok(0);
}

# As BjTfsfSource_try_new. Rust's `TfsfSource::new` clamped invalid input with a warning (nx to 3, boundary_x into
# 1..nx, dx or dt replaced so S = 1, dt clamped to dx/c); the port refuses the same inputs as try_new does, with its
# error (ADR 0002 row 3). Mirrors `TfsfSource::new`.
#must_use
public fn BjTfsfSource_new(nx, boundary_x, dx: f64, dt: f64, out: *BjTfsfSource): Result {
    memset(out, 0, sizeof(BjTfsfSource));
    return BjTfsfSource_try_new(nx, boundary_x, dx, dt, out);
}

# Gives a source's mapping back and empties it (nx 0, both addresses 0); a second call does nothing.
public fn BjTfsfSource_free(src: *BjTfsfSource): i64 {
    if (src.map_bytes > 0) { cyr_munmap(src.inc_e, src.map_bytes); }
    src.inc_e = 0;
    src.inc_h = 0;
    src.work = 0;
    src.nx = 0;
    src.map_bytes = 0;
    return 0;
}

impl BjTfsfSource {
    # Advances the auxiliary grid one step: H from E, then source_value added at source_cell (clamped to 1..nx − 2,
    # since the field is writable), then the interior E from H, then the Mur boundaries at both ends. A cell whose
    # update leaves the normal range runs it with an unbounded exponent, rounded once (ADR 0002 row 18, M5 part 2d-3:
    # src/crmath_edge.cyr's _bj_e_cell_row, the 1D grid's rule). A grid under three cells (a freed one) is left alone.
    # Mirrors `TfsfSource::step`.
    public fn step(self, source_value: f64) {
        var n = self.nx;
        if (n < 3) { return 0; }
        var e: *f64 = _bj_fs_f64p(self.inc_e);
        var h: *f64 = _bj_fs_f64p(self.inc_h);
        var hc: f64[1];
        var ec: f64[1];
        hc[0] = self.h_coeff_1d;
        ec[0] = self.e_coeff_1d;
        var w: *f64 = _bj_fs_f64p(self.work);
        var e_left: f64 = e[1];
        var e_right: f64 = e[n - 2];
        # H[i] += c_h·(E[i + 1] − E[i]) for i < n − 1.
        _bj_e_cell_row(h, &hc, 0, e + 1, e, w, n - 1);
        var sc = self.source_cell;
        if (sc < 0 || sc > n - 2) { sc = n - 2; }
        if (sc < 1) { sc = 1; }
        var x: f64 = e[sc];
        e[sc] = x + source_value;
        # E[i] += c_e·(H[i] − H[i − 1]) for 0 < i < n − 1.
        _bj_e_cell_row(e + 1, &ec, 0, h + 1, h, w, n - 2);
        var k: f64 = self.abc_coeff;
        e[0] = _bj_e_cell_one(e_left, k, e[1], e[0]);
        e[n - 1] = _bj_e_cell_one(e_right, k, e[n - 2], e[n - 1]);
        return 0;
    }

    # E^inc at the boundary node x = boundary_x·dx, or 0.0 when boundary_x is outside the grid. Mirrors
    # `TfsfSource::incident_e`.
    #must_use
    public fn incident_e(self): f64 {
        var bx = self.boundary_x;
        if (bx < 0 || bx >= self.nx) { return 0.0; }
        var e: *f64 = _bj_fs_f64p(self.inc_e);
        var v: f64 = e[bx];
        return v;
    }

    # H^inc at x = (boundary_x − ½)·dx, inc_h[boundary_x − 1], the scattered-field node beside the boundary, or 0.0 when
    # it doesn't exist (boundary_x 0 or outside the grid). Mirrors `TfsfSource::incident_h`.
    #must_use
    public fn incident_h(self): f64 {
        var i = self.boundary_x - 1;
        if (self.boundary_x == 0 || i < 0 || i >= self.nx) { return 0.0; }
        var h: *f64 = _bj_fs_f64p(self.inc_h);
        var v: f64 = h[i];
        return v;
    }
}
