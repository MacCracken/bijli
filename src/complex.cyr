# complex.cyr — BjComplex, complex numbers by value, and bijli's one time convention.
#
# ── The time convention (ADR 0002 row 5, port plan §4.4) ────────────────────────────────────────────────────────
# Stated here once: every module's doc points here instead of carrying its own.
# - A time-harmonic quantity is the real part of a phasor times e^{+jωt}: a(t) = Re{A·e^{+jωt}}, with j = √−1
#   written as an engineer writes it. So a wave travelling toward +z is A·e^{−jkz}; an inductor's impedance is
#   +jωL and a capacitor's 1/(jωC); a lossy permittivity is ε' − jε'', and an absorbing index is n − jκ
#   (Im < 0). This is the convention of FDTD (Taflove & Hagness), RF (Pozar), antennas (Balanis) and Gaussian
#   beams (Siegman), and the one Touchstone files and Smith charts are defined in.
# - Circular polarization is named with IEEE handedness (IEEE Std 145): right-hand circular rotates with the
#   fingers of a right hand whose thumb points along the propagation (clockwise when the wave is viewed receding
#   from the observer). For a wave along +z, the right-hand circular Jones vector is (1, −j)/√2: at z = 0 its field
#   is x̂·cos ωt + ŷ·sin ωt, turning from x̂ to ŷ.
# - Rust bijli 1.2.0 mixed this with e^{−iωt} in polarization, beam, the field Green's function and the FDTD media.
#   The port uses the one convention everywhere: those modules' complex amplitudes are the oracle's conjugates
#   and their phases its negations, mapped exactly in the parity harness (ADR 0002 row 5).
#
# ── BjComplex ────────────────────────────────────────────────────────────────────────────────────────────────────
# Port of Rust hisab 1.4.0's `num::Complex`, which bijli 1.2.0 re-exports (`bijli::polarization::Complex`), and of
# polarization.rs's `complex_real` / `complex_zero` / `complex_from_polar` and `ComplexExt::norm`. Every operation
# is hisab's formula in hisab's order of operations (port plan §9.2), so each golden row compares bit for bit:
# no hypot rescue in `abs`, the textbook division, `sqrt` through polar form.
#
# Range edges (ADR 0002 row 14, the user's decision of 2026-11-12, kimiya ADR 0002 #20). Where a component leaves
# [2^-511, 2^511), re², a cross product or their sum can over- or underflow although the result is representable:
# abs(1e160, 1e160) is ∞, (1e200, 1e200)² has a real part ∞ − ∞ = NaN for 0, 1/(1e160, 0) is 0 for 1e-160. There hisab's
# chain is evaluated with an unbounded exponent (src/crmath_kx.cyr's _bj_k_ux_*: every operation rounded to 53 bits,
# nothing over- or underflowing) and its last operation rounded once into binary64 — abs, norm_sq, the product, inv, the
# quotient, is_zero's comparison, and sqrt's root and polar products. When every nonzero component lies in [2^-511,
# 2^511) no square or product leaves the normal range, so that evaluation IS hisab's in binary64, and the rows keep
# Rust's bits; a NaN or infinite component keeps hisab's chain as it is. ln and powf take |z| from the same evaluation
# (row 14). The chain's transcendental steps follow the same rule (ADR 0002 row 16, M1 part 5c-2): where e^re (exp),
# cosh and sinh of im (sin, cos), ln or pow of |z|, the power |z|^n, or an angle (sqrt's arg z / 2, powf's n·arg z)
# is not a normal double, it is taken to 53 bits with an unbounded exponent (src/crmath_ux.cyr) and each final product
# rounded once: exp(710 + j0) is (∞, 0) where hisab's is (∞, NaN), sin(j800) (0, ∞) for (NaN, ∞). powf has no cutoff
# (row 15): hisab returned 0 for every |z|² < 1e-300, whatever the exponent. The transcendentals are bijli's correctly
# rounded ones (src/mathx.cyr, src/crmath_ux.cyr), so the results are the same on every target and match the corrected
# oracle where glibc misrounds.
#
# A BjComplex is a 16-byte struct value: returned in two registers, passed by address and copied on entry. Rust's
# operators are the operator fns, `a + b`, `a - b`, `a * b`, `a / b`; with an f64 operand, `a.scale(s)` (Rust's
# `a * s` and `s * a`: the same two products) and `a.div_f64(s)`. A compound assignment is `a = a + b` (Cyrius
# refuses `+=` on a struct value; hisab's `+=` computes the same). `From<f64>` is BjComplex_from_real, `From<(f64,
# f64)>` is BjComplex_new, `Default` is BjComplex_default. `sin` and `cos` take bijli's correctly rounded sinh and
# cosh (src/crmath.cyr, M1 part 2d).

private

public struct BjComplex {
    re: f64;
    im: f64;
}

# ── the range edges (ADR 0002 row 14) ─────────────────────────────────────────────────────────────────────────────

# 1 when x is ±0 or 2^-511 ≤ |x| < 2^511: its square, and its product with any other such value, is normal (or
# exactly 0), and so is a sum of two of them, unless it is past DBL_MAX: < 2^1023.
#must_use
fn _bj_cx_ok(x: f64): i64 {
    var b = _bj_bits(x) & 0x7FFFFFFFFFFFFFFF;
    if (b == 0) { return 1; }
    var be = b >> 52;
    if (be >= 512 && be < 1534) { return 1; }
    return 0;
}

# 1 when hisab's chain on x and y is the unbounded one (both components in range), or must stay hisab's (one not
# finite); 0 at a range edge.
#must_use
fn _bj_cx_plain(x: f64, y: f64): i64 {
    var ex = (load64(&x) >> 52) & 0x7FF;
    var ey = (load64(&y) >> 52) & 0x7FF;
    if (((ex - 512) | (ey - 512) | (1533 - ex) | (1533 - ey)) >= 0) { return 1; }   # the common case: one test
    if (ex == 2047 || ey == 2047) { return 1; }
    if (_bj_cx_ok(x) == 1 && _bj_cx_ok(y) == 1) { return 1; }
    return 0;
}

# _bj_cx_plain for an operation on two complex values: hisab's chain when any of the four parts is not finite, or
# all are in range.
#must_use
fn _bj_cx_plain4(a: f64, b: f64, c: f64, d: f64): i64 {
    var ea = (load64(&a) >> 52) & 0x7FF;
    var eb = (load64(&b) >> 52) & 0x7FF;
    var ec = (load64(&c) >> 52) & 0x7FF;
    var ed = (load64(&d) >> 52) & 0x7FF;
    # the common case, every biased exponent in [512, 1533]: each difference below is ≥ 0, so their OR is (one test)
    var lo = (ea - 512) | (eb - 512) | (ec - 512) | (ed - 512);
    var hi = (1533 - ea) | (1533 - eb) | (1533 - ec) | (1533 - ed);
    if ((lo | hi) >= 0) { return 1; }
    if (ea == 2047 || eb == 2047 || ec == 2047 || ed == 2047) { return 1; }
    if (_bj_cx_ok(a) + _bj_cx_ok(b) + _bj_cx_ok(c) + _bj_cx_ok(d) == 4) { return 1; }
    return 0;
}

# x·y with an unbounded exponent, rounded to 53 bits: (s, e).
#must_use
fn _bj_cx_ux_mul(x: f64, y: f64): (f64, i64) {
    var xs, xe = _bj_k_ux_from(x);
    var ys, ye = _bj_k_ux_from(y);
    var s, e = _bj_k_ux_mul(xs, xe, ys, ye);
    return (s, e);
}

# x² + y², each operation with an unbounded exponent and rounded to 53 bits: (s, e).
#must_use
fn _bj_cx_ux_sumsq(x: f64, y: f64): (f64, i64) {
    var as2, ae2 = _bj_cx_ux_mul(x, x);
    var bs2, be2 = _bj_cx_ux_mul(y, y);
    var s, e = _bj_k_ux_add(as2, ae2, bs2, be2);
    return (s, e);
}

# |x + jy| with an unbounded exponent, to 53 bits: (s, e).
#must_use
fn _bj_cx_ux_abs(x: f64, y: f64): (f64, i64) {
    var s, e = _bj_cx_ux_sumsq(x, y);
    var rs, re2 = _bj_k_ux_sqrt(s, e);
    return (rs, re2);
}

# ── the transcendental range edges (ADR 0002 row 16) ──────────────────────────────────────────────────────────────

# arg z with an unbounded exponent, to 53 bits, given its binary64 value g: g itself when it is exact (im = ±0: ±0 or
# ±π) or normal and above 2^-1022 (binary64's rounding is then the 53-bit one); else im/re to 53 bits. An arg that
# small has re > 0 and |im/re| < 2^-1021, where atan2(im, re) = (im/re)(1 − δ) with δ < 2^-2042, while a quotient of
# two doubles that is not a 53-bit value lies at least 2^-107 (relative) from every 53-bit midpoint: both round alike.
#must_use
fn _bj_cx_arg_ux(g: f64, re: f64, im: f64): (f64, i64) {
    var gb = _bj_bits(g) & 0x7FFFFFFFFFFFFFFF;
    if (im == 0.0 || gb > 0x0010000000000000) {
        var s, e = _bj_k_ux_from(g);
        return (s, e);
    }
    var ys, ye = _bj_k_ux_from(im);
    var xs, xe = _bj_k_ux_from(re);
    var qs, qe = _bj_k_ux_div(ys, ye, xs, xe);
    return (qs, qe);
}

# cos t to 53 bits, for the 53-bit t = ts·2^te: 1 below 2^-1022 (and at 0); past DBL_MAX by _bj_ux_sin_cos; else the
# double t's correctly rounded cosine (binary64's rounding of a normal value is the 53-bit one).
#must_use
fn _bj_cx_cos_ux(ts: f64, te): (f64, i64) {
    if (ts == 0.0 || te < 0 - 1022) { return (1.0, 0); }
    if (te > 1023) {
        var cb: f64 = _bj_ux_sin_cos(ts, te, 0);
        var bs, be = _bj_k_ux_from(cb);
        return (bs, be);
    }
    var t: f64 = _bj_k_ux_round(ts, te, 0.0);
    var c: f64 = _bj_cos(t);
    var s, e = _bj_k_ux_from(c);
    return (s, e);
}

# sin t to 53 bits, for the 53-bit t = ts·2^te: t itself below 2^-1022 (sin t = t(1 − t²/6) rounds to t; ±0 keeps
# its sign); past DBL_MAX by _bj_ux_sin_cos; else the double t's correctly rounded sine.
#must_use
fn _bj_cx_sin_ux(ts: f64, te): (f64, i64) {
    if (ts == 0.0 || te < 0 - 1022) { return (ts, te); }
    if (te > 1023) {
        var sb: f64 = _bj_ux_sin_cos(ts, te, 1);
        var bs, be = _bj_k_ux_from(sb);
        return (bs, be);
    }
    var t: f64 = _bj_k_ux_round(ts, te, 0.0);
    var sn: f64 = _bj_sin(t);
    var s, e = _bj_k_ux_from(sn);
    return (s, e);
}

# z^n = from_polar(|z|^n, n·arg z) with an unbounded exponent, for the 53-bit |z| = as·2^ae (positive, normal) and a
# finite n: |z|^n by _bj_ux_pow, arg z by _bj_cx_arg_ux, their product n·arg to 53 bits, its cosine and sine, each
# polar product rounded once.
#must_use
fn _bj_cx_powf_edge(as: f64, ae, n: f64, g: f64, re: f64, im: f64): BjComplex {
    var ps, pe = _bj_ux_pow(as, ae, n);
    var gs, ge = _bj_cx_arg_ux(g, re, im);
    var ns, ne = _bj_k_ux_from(n);
    var ts, te = _bj_k_ux_mul(gs, ge, ns, ne);
    var cs, ce = _bj_cx_cos_ux(ts, te);
    var ss, se = _bj_cx_sin_ux(ts, te);
    var wr: f64 = _bj_k_ux_mul_f64(ps, pe, cs, ce);
    var wi: f64 = _bj_k_ux_mul_f64(ps, pe, ss, se);
    var w: BjComplex;
    w.re = wr;
    w.im = wi;
    return w;
}

# 1 when complex sin and cos keep hisab's chain: |im| ≤ 710 (cosh and sinh are normal, or sinh is im itself), or a part
# is not finite; 0 at an edge.
#must_use
fn _bj_cx_hyp_plain(re: f64, im: f64): i64 {
    var ib = _bj_bits(im) & 0x7FFFFFFFFFFFFFFF;
    if (ib <= 0x4086300000000000) { return 1; }                                 # |im| ≤ 710
    if (ib >= 0x7FF0000000000000) { return 1; }
    if ((_bj_bits(re) & 0x7FF0000000000000) == 0x7FF0000000000000) { return 1; }
    return 0;
}

# 1 when powf's binary64 chain is the unbounded one: |z|^n = r normal and above 2^-1022, arg z = g exact or above
# 2^-1022, and θ = g·n exactly 0 or normal and above 2^-1022 (every intermediate's rounding is then the 53-bit one);
# 0 at an edge.
#must_use
fn _bj_cx_powf_plain(r: f64, g: f64, theta: f64, n: f64, im: f64): i64 {
    var rb = _bj_bits(r) & 0x7FFFFFFFFFFFFFFF;
    if (rb <= 0x0010000000000000 || rb >= 0x7FF0000000000000) { return 0; }
    var gb = _bj_bits(g) & 0x7FFFFFFFFFFFFFFF;
    if (im != 0.0 && gb <= 0x0010000000000000) { return 0; }
    var tb = _bj_bits(theta) & 0x7FFFFFFFFFFFFFFF;
    if (tb == 0) {
        if (gb == 0 || n == 0.0) { return 1; }
        return 0;
    }
    if (tb <= 0x0010000000000000 || tb >= 0x7FF0000000000000) { return 0; }
    return 1;
}

# The product (ar + j·ai)(br + j·bi) at a range edge: hisab's chain with an unbounded exponent, each sum rounded once.
#must_use
fn _bj_cx_mul_edge(ar: f64, ai: f64, br: f64, bi: f64): BjComplex {
    var ps, pe = _bj_cx_ux_mul(ar, br);
    var qs, qe = _bj_cx_ux_mul(ai, bi);
    var r: f64 = _bj_k_ux_sub_f64(ps, pe, qs, qe);
    var us, ue = _bj_cx_ux_mul(ar, bi);
    var vs, ve = _bj_cx_ux_mul(ai, br);
    var i: f64 = _bj_k_ux_add_f64(us, ue, vs, ve);
    var z: BjComplex;
    z.re = r;
    z.im = i;
    return z;
}

# The quotient (ar + j·ai)/(br + j·bi) at a range edge: hisab's chain with an unbounded exponent, each quotient rounded
# once.
#must_use
fn _bj_cx_div_edge(ar: f64, ai: f64, br: f64, bi: f64): BjComplex {
    var ds, de = _bj_cx_ux_sumsq(br, bi);
    var ps, pe = _bj_cx_ux_mul(ar, br);
    var qs, qe = _bj_cx_ux_mul(ai, bi);
    var ns, ne = _bj_k_ux_add(ps, pe, qs, qe);
    var us, ue = _bj_cx_ux_mul(ai, br);
    var vs, ve = _bj_cx_ux_mul(ar, bi);
    var ms, me = _bj_k_ux_sub(us, ue, vs, ve);
    var r: f64 = _bj_k_ux_div_f64(ns, ne, ds, de);
    var i: f64 = _bj_k_ux_div_f64(ms, me, ds, de);
    var z: BjComplex;
    z.re = r;
    z.im = i;
    return z;
}

# re + j·im. Mirrors `Complex::new` (and `From<(f64, f64)>`).
#must_use
#pure
public fn BjComplex_new(re: f64, im: f64): BjComplex {
    var z: BjComplex;
    z.re = re;
    z.im = im;
    return z;
}

# re + j·0. Mirrors `Complex::from_real` (and `From<f64>`).
#must_use
#pure
public fn BjComplex_from_real(re: f64): BjComplex {
    var z: BjComplex;
    z.re = re;
    z.im = 0.0;
    return z;
}

# 0 + j·0. Mirrors `Complex::default`.
#must_use
#pure
public fn BjComplex_default(): BjComplex {
    var z: BjComplex;
    z.re = 0.0;
    z.im = 0.0;
    return z;
}

# r·e^{jθ} = (r·cos θ, r·sin θ). Mirrors `Complex::from_polar`.
#must_use
#pure
public fn BjComplex_from_polar(r: f64, theta: f64): BjComplex {
    var c: f64 = _bj_cos(theta);
    var s: f64 = _bj_sin(theta);
    var z: BjComplex;
    z.re = r * c;
    z.im = r * s;
    return z;
}

# a + b. Mirrors `Add for Complex` (and `+=`).
#must_use
#pure
public fn BjComplex_add(a: BjComplex, b: BjComplex): BjComplex {
    var z: BjComplex;
    z.re = a.re + b.re;
    z.im = a.im + b.im;
    return z;
}

# a − b. Mirrors `Sub for Complex` (and `-=`).
#must_use
#pure
public fn BjComplex_sub(a: BjComplex, b: BjComplex): BjComplex {
    var z: BjComplex;
    z.re = a.re - b.re;
    z.im = a.im - b.im;
    return z;
}

# a·b = (a.re·b.re − a.im·b.im, a.re·b.im + a.im·b.re), each product rounded (no fused multiply-add, as rustc
# compiles it); at a range edge with an unbounded exponent, the sum rounded once (ADR 0002 row 14). Mirrors
# `Mul for Complex` (and `*=`).
#must_use
#pure
public fn BjComplex_mul(a: BjComplex, b: BjComplex): BjComplex {
    if (_bj_cx_plain4(a.re, a.im, b.re, b.im) == 0) {
        var w: BjComplex = _bj_cx_mul_edge(a.re, a.im, b.re, b.im);
        return w;
    }
    var z: BjComplex;
    z.re = a.re * b.re - a.im * b.im;
    z.im = a.re * b.im + a.im * b.re;
    return z;
}

# a / b by the textbook formula: ((a.re·b.re + a.im·b.im)/d, (a.im·b.re − a.re·b.im)/d), d = b.re² + b.im²; at a
# range edge with an unbounded exponent, each quotient rounded once (ADR 0002 row 14). Mirrors `Div for Complex`.
#must_use
#pure
public fn BjComplex_div(a: BjComplex, b: BjComplex): BjComplex {
    if (_bj_cx_plain4(a.re, a.im, b.re, b.im) == 0) {
        var w: BjComplex = _bj_cx_div_edge(a.re, a.im, b.re, b.im);
        return w;
    }
    var d: f64 = b.re * b.re + b.im * b.im;
    var z: BjComplex;
    z.re = (a.re * b.re + a.im * b.im) / d;
    z.im = (a.im * b.re - a.re * b.im) / d;
    return z;
}

# −a. Mirrors `Neg for Complex`.
#must_use
#pure
public fn BjComplex_neg(a: BjComplex): BjComplex {
    var z: BjComplex;
    z.re = -a.re;
    z.im = -a.im;
    return z;
}

impl BjComplex {
    # √(re² + im²), no rescaling; at a range edge with an unbounded exponent, the root rounded once (see the header,
    # ADR 0002 row 14). Mirrors `Complex::abs`.
    #must_use
    #pure
    public fn abs(self): f64 {
        if (_bj_cx_plain(self.re, self.im) == 1) {
            var s: f64 = self.re * self.re + self.im * self.im;
            var r: f64 = f64_sqrt(s);
            return r;
        }
        var us, ue = _bj_cx_ux_sumsq(self.re, self.im);
        var u: f64 = _bj_k_ux_sqrt_f64(us, ue);
        return u;
    }

    # |z|, the same as abs. Mirrors bijli's `ComplexExt::norm`.
    #must_use
    #pure
    public fn norm(self): f64 {
        var r: f64 = BjComplex_abs(self);
        return r;
    }

    # re − j·im. Mirrors `Complex::conj`.
    #must_use
    #pure
    public fn conj(self): BjComplex {
        var z: BjComplex;
        z.re = self.re;
        z.im = -self.im;
        return z;
    }

    # re² + im²; at a range edge with an unbounded exponent, the sum rounded once (ADR 0002 row 14). Mirrors
    # `Complex::norm_sq` (and `ComplexExt::norm_sq`).
    #must_use
    #pure
    public fn norm_sq(self): f64 {
        if (_bj_cx_plain(self.re, self.im) == 1) {
            var r: f64 = self.re * self.re + self.im * self.im;
            return r;
        }
        var as2, ae2 = _bj_cx_ux_mul(self.re, self.re);
        var bs2, be2 = _bj_cx_ux_mul(self.im, self.im);
        var u: f64 = _bj_k_ux_add_f64(as2, ae2, bs2, be2);
        return u;
    }

    # atan2(im, re), in [−π, π]. Mirrors `Complex::arg` (and `ComplexExt::arg`).
    #must_use
    #pure
    public fn arg(self): f64 {
        var r: f64 = _bj_atan2(self.im, self.re);
        return r;
    }

    # e^re·(cos im, sin im); for a finite z with re outside [−708, 709] (e^re past DBL_MAX or below 2^-1022) e^re
    # with an unbounded exponent and each product rounded once (ADR 0002 row 16). Mirrors `Complex::exp`.
    #must_use
    #pure
    public fn exp(self): BjComplex {
        var c: f64 = _bj_cos(self.im);
        var s: f64 = _bj_sin(self.im);
        var z: BjComplex;
        var dr: f64 = self.re - self.re;
        var di: f64 = self.im - self.im;
        if ((self.re >= -708.0 && self.re <= 709.0) || dr != 0.0 || di != 0.0) {
            var r: f64 = _bj_exp(self.re);
            z.re = r * c;
            z.im = r * s;
            return z;
        }
        var es, ee = _bj_ux_exp(self.re);
        var cs, ce = _bj_k_ux_from(c);
        var ss, se = _bj_k_ux_from(s);
        var wr: f64 = _bj_k_ux_mul_f64(es, ee, cs, ce);
        var wi: f64 = _bj_k_ux_mul_f64(es, ee, ss, se);
        z.re = wr;
        z.im = wi;
        return z;
    }

    # (ln |z|, arg z), the principal branch; at a range edge |z| with an unbounded exponent (ADR 0002 row 14), and its
    # logarithm with one where it is past DBL_MAX or below 2^-1022 (row 16). Mirrors `Complex::ln`.
    #must_use
    #pure
    public fn ln(self): BjComplex {
        var g: f64 = BjComplex_arg(self);
        var z: BjComplex;
        z.im = g;
        if (_bj_cx_plain(self.re, self.im) == 1) {
            var p: f64 = self.re * self.re + self.im * self.im;
            var a: f64 = f64_sqrt(p);
            var l: f64 = _bj_ln(a);
            z.re = l;
            return z;
        }
        var as, ae = _bj_cx_ux_abs(self.re, self.im);
        if (ae < 0 - 1022 || ae > 1023) {
            var lu: f64 = _bj_ux_ln(as, ae);
            z.re = lu;
            return z;
        }
        var a2: f64 = _bj_k_ux_round(as, ae, 0.0);
        var l2: f64 = _bj_ln(a2);
        z.re = l2;
        return z;
    }

    # from_polar(√|z|, arg z / 2), the principal branch; at a range edge |z| and its root with an unbounded exponent,
    # the polar products rounded once (ADR 0002 row 14). Where im ≠ 0 and |arg z| < 2^-1020, so that arg z / 2 is not
    # a normal double, the angle with an unbounded exponent too (row 16): its cosine is 1 and its sine itself.
    # Mirrors `Complex::sqrt`.
    #must_use
    #pure
    public fn sqrt(self): BjComplex {
        var g: f64 = BjComplex_arg(self);
        var theta: f64 = g / 2.0;
        var tiny = 0;
        if ((_bj_bits(g) & 0x7FFFFFFFFFFFFFFF) < 0x0030000000000000 && self.im != 0.0) {
            var dr: f64 = self.re - self.re;
            if (dr == 0.0) { tiny = 1; }                    # re = +∞ (arg ±0) keeps hisab's chain
        }
        var plain = _bj_cx_plain(self.re, self.im);
        if (plain == 1 && tiny == 0) {
            var a: f64 = BjComplex_abs(self);
            var r: f64 = f64_sqrt(a);
            var z: BjComplex = BjComplex_from_polar(r, theta);
            return z;
        }
        var as2, ae2 = _bj_cx_ux_abs(self.re, self.im);
        var rs, re2 = _bj_k_ux_sqrt(as2, ae2);
        if (tiny == 1) {
            var gs, ge = _bj_cx_arg_ux(g, self.re, self.im);
            var t: BjComplex;
            var tr: f64 = _bj_k_ux_mul_f64(rs, re2, 1.0, 0);
            var ti: f64 = _bj_k_ux_mul_f64(rs, re2, gs, ge - 1);
            t.re = tr;
            t.im = ti;
            return t;
        }
        var c: f64 = _bj_cos(theta);
        var sn: f64 = _bj_sin(theta);
        var cs, ce = _bj_k_ux_from(c);
        var ss, se = _bj_k_ux_from(sn);
        var w: BjComplex;
        var wr: f64 = _bj_k_ux_mul_f64(rs, re2, cs, ce);
        var wi: f64 = _bj_k_ux_mul_f64(rs, re2, ss, se);
        w.re = wr;
        w.im = wi;
        return w;
    }

    # z^n = from_polar(|z|^n, n·arg z) for every z ≠ 0; at a range edge |z| with an unbounded exponent (ADR 0002 row
    # 14), and where |z|, |z|^n, arg z or n·arg z is not a normal double (past DBL_MAX, below 2^-1022), the whole chain
    # with one, each polar product rounded once (row 16, _bj_cx_powf_edge). z = 0 follows pow's rules for a zero base:
    # 0 for n > 0, 1 for n = 0, +∞ for n < 0 (each with im +0), NaN for a NaN n. hisab returned 0 for every |z|² <
    # 1e-300 (row 15: z⁰ was 0, z⁻¹ 0). A non-finite z or n keeps hisab's chain. Mirrors `Complex::powf`.
    #must_use
    #pure
    public fn powf(self, n: f64): BjComplex {
        if (self.re == 0.0 && self.im == 0.0) {
            var zz: BjComplex;
            zz.im = 0.0;
            if (n != n) {
                zz.re = n;
                zz.im = n;
            } elif (n > 0.0) {
                zz.re = 0.0;
            } elif (n == 0.0) {
                zz.re = 1.0;
            } else {
                zz.re = _BJ_K_INF;
            }
            return zz;
        }
        var g: f64 = BjComplex_arg(self);
        var theta: f64 = g * n;
        var dn: f64 = n - n;
        if (_bj_cx_plain(self.re, self.im) == 1 || dn != 0.0) {
            var p: f64 = self.re * self.re + self.im * self.im;
            var a: f64 = f64_sqrt(p);                       # hisab's |z| (a non-finite n gives NaN whatever |z| is)
            var r: f64 = _bj_powf(a, n);
            var da: f64 = a - a;
            if (da != 0.0 || dn != 0.0 || _bj_cx_powf_plain(r, g, theta, n, self.im) == 1) {
                var z: BjComplex = BjComplex_from_polar(r, theta);
                return z;
            }
            var ps, pe = _bj_k_ux_from(a);
            var w: BjComplex = _bj_cx_powf_edge(ps, pe, n, g, self.re, self.im);
            return w;
        }
        var as, ae = _bj_cx_ux_abs(self.re, self.im);
        if (ae >= 0 - 1022 && ae <= 1023) {
            var a2: f64 = _bj_k_ux_round(as, ae, 0.0);
            var r2: f64 = _bj_powf(a2, n);
            if (_bj_cx_powf_plain(r2, g, theta, n, self.im) == 1) {
                var z2: BjComplex = BjComplex_from_polar(r2, theta);
                return z2;
            }
        }
        var w2: BjComplex = _bj_cx_powf_edge(as, ae, n, g, self.re, self.im);
        return w2;
    }

    # sin z = (sin re·cosh im, cos re·sinh im); for a finite z with |im| > 710 (cosh and sinh past DBL_MAX) cosh and
    # sinh with an unbounded exponent and each product rounded once (ADR 0002 row 16). Mirrors `Complex::sin`.
    #must_use
    #pure
    public fn sin(self): BjComplex {
        var s: f64 = _bj_sin(self.re);
        var c: f64 = _bj_cos(self.re);
        var z: BjComplex;
        if (_bj_cx_hyp_plain(self.re, self.im) == 1) {
            var ch: f64 = _bj_cosh(self.im);
            var sh: f64 = _bj_sinh(self.im);
            z.re = s * ch;
            z.im = c * sh;
            return z;
        }
        var hs, he = _bj_ux_cosh(self.im);
        var ks, ke = _bj_ux_sinh(self.im);
        var ss, se = _bj_k_ux_from(s);
        var cs, ce = _bj_k_ux_from(c);
        var wr: f64 = _bj_k_ux_mul_f64(ss, se, hs, he);
        var wi: f64 = _bj_k_ux_mul_f64(cs, ce, ks, ke);
        z.re = wr;
        z.im = wi;
        return z;
    }

    # cos z = (cos re·cosh im, (−sin re)·sinh im); for a finite z with |im| > 710 as sin. Mirrors `Complex::cos`.
    #must_use
    #pure
    public fn cos(self): BjComplex {
        var c: f64 = _bj_cos(self.re);
        var s: f64 = _bj_sin(self.re);
        var ns: f64 = -s;
        var z: BjComplex;
        if (_bj_cx_hyp_plain(self.re, self.im) == 1) {
            var ch: f64 = _bj_cosh(self.im);
            var sh: f64 = _bj_sinh(self.im);
            z.re = c * ch;
            z.im = ns * sh;
            return z;
        }
        var hs, he = _bj_ux_cosh(self.im);
        var ks, ke = _bj_ux_sinh(self.im);
        var cs, ce = _bj_k_ux_from(c);
        var ns2, nse = _bj_k_ux_from(ns);
        var wr: f64 = _bj_k_ux_mul_f64(cs, ce, hs, he);
        var wi: f64 = _bj_k_ux_mul_f64(ns2, nse, ks, ke);
        z.re = wr;
        z.im = wi;
        return z;
    }

    # 1/z = (re/d, −im/d), d = re² + im²; at a range edge d with an unbounded exponent and each quotient rounded once
    # (ADR 0002 row 14). Mirrors `Complex::inv`.
    #must_use
    #pure
    public fn inv(self): BjComplex {
        var nim: f64 = -self.im;
        var z: BjComplex;
        if (_bj_cx_plain(self.re, self.im) == 1) {
            var d: f64 = self.re * self.re + self.im * self.im;
            z.re = self.re / d;
            z.im = nim / d;
            return z;
        }
        var ds, de = _bj_cx_ux_sumsq(self.re, self.im);
        var xs, xe = _bj_k_ux_from(self.re);
        var ys, ye = _bj_k_ux_from(nim);
        var r: f64 = _bj_k_ux_div_f64(xs, xe, ds, de);
        var i: f64 = _bj_k_ux_div_f64(ys, ye, ds, de);
        z.re = r;
        z.im = i;
        return z;
    }

    # 1 when re² + im² < tol² (0 for NaN); at a range edge both sides with an unbounded exponent, compared exactly
    # (ADR 0002 row 14). Mirrors `Complex::is_zero`.
    #must_use
    #pure
    public fn is_zero(self, tol: f64): i64 {
        if (_bj_cx_plain4(self.re, self.im, tol, 0.0) == 1) {
            var ns: f64 = self.re * self.re + self.im * self.im;
            var t2: f64 = tol * tol;
            if (ns < t2) { return 1; }
            return 0;
        }
        var ns2, ne2 = _bj_cx_ux_sumsq(self.re, self.im);
        var ts, te = _bj_cx_ux_mul(tol, tol);
        if (_bj_k_ux_cmp(ns2, ne2, ts, te) == 0 - 1) { return 1; }
        return 0;
    }

    # (re·s, im·s). Mirrors `Mul<f64> for Complex`, `*=` with an f64, and `Mul<Complex> for f64` (s·re is re·s).
    #must_use
    #pure
    public fn scale(self, s: f64): BjComplex {
        var z: BjComplex;
        z.re = self.re * s;
        z.im = self.im * s;
        return z;
    }

    # (re/s, im/s). Mirrors `Div<f64> for Complex`.
    #must_use
    #pure
    public fn div_f64(self, s: f64): BjComplex {
        var z: BjComplex;
        z.re = self.re / s;
        z.im = self.im / s;
        return z;
    }

    # Writes z as Rust's Display does (`format!("{z}")`): "{re}+{im}i" when im ≥ 0 (−0 included, so 1 − j0 is
    # "1+-0i"), else "{re}{im}i" (a NaN im too), each part in Rust's f64 Display form (src/fmtf.cyr). Mirrors
    # `Display for Complex`.
    public fn display(self, t): i64 {
        _bj_fmt_f64_display(t, self.re);
        var im: f64 = self.im;
        if (im >= 0.0) { _bj_tx_putc(t, 43); }
        _bj_fmt_f64_display(t, im);
        _bj_tx_putc(t, 105);
        return 0;
    }
}

# re + j·0. Mirrors `bijli::polarization::complex_real`.
#must_use
#pure
public fn bj_complex_real(re: f64): BjComplex {
    var z: BjComplex = BjComplex_from_real(re);
    return z;
}

# 0 + j·0. Mirrors `bijli::polarization::complex_zero`.
#must_use
#pure
public fn bj_complex_zero(): BjComplex {
    var z: BjComplex = BjComplex_new(0.0, 0.0);
    return z;
}

# magnitude·e^{j·phase}. Mirrors `bijli::polarization::complex_from_polar`.
#must_use
#pure
public fn bj_complex_from_polar(magnitude: f64, phase: f64): BjComplex {
    var z: BjComplex = BjComplex_from_polar(magnitude, phase);
    return z;
}
