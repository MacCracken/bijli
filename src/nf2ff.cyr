# nf2ff.cyr — fdtd.rs's 2D near-field to far-field transform: `nf2ff_2d_phasor` (M5 part 1e), Love's equivalence on a
# rectangular contour of a TM-mode Yee grid, from CW phasors, and `nf2ff_2d` (M6 part 1c), the same transform of one
# time snapshot of a BjFdtd2d, on the same core.
#
# The phasors are e^{+jωt}, bijli's one convention (src/complex.cyr's header), as the CW accumulator's are: fdtd.rs's
# NF2FF already was. The complex arithmetic is fdtd.rs's own `Cplx`, written out on f64 locals in Rust's order; sin_cos
# and hypot are correctly rounded (src/crmath.cyr).
#
# The range edges (ADR 0002 row 18, M5 part 2d-6). Rust's chain (the frequency ω/2π, k = 2π·frequency/c, the rotation
# e^{+jω·dt/2}, the contour's samples, each angle's sums and √(k/8π)·|η·N_z − L_φ|) differs from its value with an
# unbounded exponent (each operation to 53 bits, the last rounded once) only where an operation leaves the normal
# range. The port keeps Rust's chain wherever it is that value and runs the unbounded one elsewhere:
# - the scalars come from ω to 53 bits (the accumulator's omega_s, omega_e, ADR 0002 row 18's M5 part 2d-4a), which
#   the accumulators' agreement and the frequency's test also read. Where k, the rotation's parts, dx/2, the sides'
#   starts, k/8π and k·dx are doubles (normal, or an exact 0), the transform runs on Rust's chain, else wholly
#   unbounded;
# - a contour sample: each product normal, or 0 from a zero factor, or an underflow beside its sum's other product of
#   at least 2^-960 (which absorbs it in both chains: |x·y| < 2^-1022 is under a quarter of that product's ulp); each
#   sum finite. Else the transform runs wholly unbounded;
# - an angle: each side's ρ̂·ρ' products as a sample's, k·ρ̂·ρ' and k·dx·(d̂·ρ̂) normal or exact zeros; the step
#   e^{jk·dx·(d̂·ρ̂)} with both parts at least 2^-959 (or (1, ±0)), which keeps the rotation's recurrence Rust's, as the
#   DFT's (src/fdtd_util.cyr's _bj_fu_dft); a sample's eight products normal, decided once a sample by the rotation's
#   exponent fields against the samples' smallest (one test; |x·r| ≥ 2^(e_x + e_r − 2046) for biased fields e), and
#   where that fails by each product (an underflow its partner absorbs is kept); the sums finite; the tail's products
#   as a sample's, |η·N_z − L_φ| normal or 0 and finite (its product with √(k/8π) is the last operation). Else that
#   angle runs unbounded (_bj_nf_angle_ux).
# A non-finite field value on the contour keeps Rust's chain throughout, on the scalars rounded into binary64.

private

var _BJ_NF_INF: f64 = 0x7FF0000000000000;
# std::f64::consts::PI, and 10⁻¹² (the accumulators' agreement test).
var _BJ_NF_PI: f64 = 3.141592653589793;
var _BJ_NF_REL12: f64 = 0.000000000001;
# The largest block a size here asks for, 2^60 bytes (2.0.1, H30): below it no size overflows, and freelist maps
# any size it gets, so a block too large to have is the system's to refuse (Allocation). (2.0.0 capped it at
# 2 GiB, the bump allocator's limit, not freelist's.)
var _BJ_NF_FL_MAX = 1152921504606846976;
# 2^-1022, and 2^-959 and 2^-960: the rotation step's and the sums' absorption bounds (M5 part 2d-6).
var _BJ_NF_DMIN: f64 = 0x0010000000000000;
var _BJ_NF_2M959: f64 = 0x0400000000000000;
var _BJ_NF_2M960: f64 = 0x03F0000000000000;

# A word as a *f64 (the typed return keeps the binding typed).
#must_use
fn _bj_nf_f64p(a): *f64 {
    return a;
}

# A word as a *i64.
#must_use
fn _bj_nf_i64p(a): *i64 {
    return a;
}

# 1 when the product (or quotient) p of x and y is its 53-bit value: normal, or 0 from a zero operand.
#must_use
fn _bj_nf_kept(p: f64, x: f64, y: f64): i64 {
    var a: f64 = f64_abs(p);
    if (a >= _BJ_NF_DMIN && a < _BJ_NF_INF) { return 1; }
    if (p == 0.0 && (x == 0.0 || y == 0.0)) { return 1; }
    return 0;
}

# _bj_nf_kept, or p an underflow (a nonzero subnormal, or 0 from nonzero factors) beside its sum's other term o with
# |o| ≥ 2^-960, which absorbs it in Rust's chain and the unbounded one alike (the section comment).
#must_use
fn _bj_nf_kept2(p: f64, x: f64, y: f64, o: f64): i64 {
    if (_bj_nf_kept(p, x, y) == 1) { return 1; }
    var a: f64 = f64_abs(p);
    if (!(a < _BJ_NF_DMIN)) { return 0; }
    var b: f64 = f64_abs(o);
    if (b >= _BJ_NF_2M960) { return 1; }
    return 0;
}

# 1 when x is finite.
#must_use
fn _bj_nf_fin(x: f64): i64 {
    var z: f64 = x * 0.0;
    if (z == 0.0) { return 1; }
    return 0;
}

# 1 when the 53-bit x = s·2^e (finite) is a double: 0, or normal.
#must_use
fn _bj_nf_dbl(s: f64, e): i64 {
    if (s == 0.0) { return 1; }
    if (e < 0 - 1022 || e > 1023) { return 0; }
    return 1;
}

# 1 when the rotation step (c, s) = e^{jθ} keeps Rust's recurrence its 53-bit value: |c| and |s| at least 2^-959, or
# (1, ±0) (the section comment; src/fdtd_util.cyr's _bj_fu_dft has the argument).
#must_use
fn _bj_nf_step_ok(c: f64, s: f64): i64 {
    var ac: f64 = f64_abs(c);
    var an: f64 = f64_abs(s);
    if (ac >= _BJ_NF_2M959 && an >= _BJ_NF_2M959) { return 1; }
    if (c == 1.0 && s == 0.0) { return 1; }
    return 0;
}

# 1 when x is finite and strictly positive (NaN-safe). Mirrors fdtd.rs's `is_positive_finite`.
#must_use
fn _bj_nf_pos(x: f64): i64 {
    if (x > 0.0 && x < _BJ_NF_INF) { return 1; }
    return 0;
}

# 1 when a ≥ b as usize words (a negative word is past 2^63).
#must_use
fn _bj_nf_uge(a, b): i64 {
    if ((a < 0) == (b < 0)) {
        if (a >= b) { return 1; }
        return 0;
    }
    if (a < 0) { return 1; }
    return 0;
}

# The usize product a·b into *out: 1, or 0 when it overflows 64 bits (Rust's `checked_mul` None).
fn _bj_nf_umul(a, b, out: *i64): i64 {
    var ah = a >> 32;
    var al = a & 0xFFFFFFFF;
    var bh = b >> 32;
    var bl = b & 0xFFFFFFFF;
    if (ah != 0 && bh != 0) { return 0; }
    var cross = ah * bl + al * bh;
    if ((cross >> 32) != 0) { return 0; }
    var lo = al * bl;
    var hi = cross << 32;
    var s = lo + hi;
    if (_bj_nf_uge(s, lo) == 0) { return 0; }
    out[0] = s;
    return 1;
}

# Rust's `n as f64` for a usize: the word read unsigned, rounded to nearest even.
#must_use
fn _bj_nf_u2f(n): f64 {
    if (n >= 0) {
        var r: f64 = f64_from(n);
        return r;
    }
    var h: f64 = f64_from((n >> 1) | (n & 1));
    var r2: f64 = h * 2.0;
    return r2;
}

# A far-field pattern: `count` observation angles φ (radians, 0 to 2π from +x towards +y) at `angles`, and the pattern
# lim_{ρ→∞} √ρ·|E_z(ρ, φ)| (≥ 0; V·m^{−½} for phasors in V/m, linear in the inputs) at `pattern`, in one freelist
# block (0 when count is 0). Give it back with BjNf2ffResult_free. Mirrors `Nf2ffResult`.
public struct BjNf2ffResult {
    pattern;
    angles;
    count;
}

# Gives a result's block back and empties it; a second call does nothing.
public fn BjNf2ffResult_free(r: *BjNf2ffResult): i64 {
    if (r.pattern != 0) { fl_free(r.pattern); }
    r.pattern = 0;
    r.angles = 0;
    r.count = 0;
    return 0;
}

# Records InvalidParameter with a fixed reason; returns its code.
fn _bj_nf_bad(reason): i64 {
    _bj_tx_cstr(_bj_err_reason(BJ_ERR_INVALID_PARAMETER), reason);
    return BJ_ERR_INVALID_PARAMETER;
}

# The shared parameter checks, in Rust's order (n_angles, the margin, dx, the frequency): 0 with k = 2πf/c to 53 bits
# with an unbounded exponent in ks[0]·2^ke[0], or the error recorded and its code. The frequency is tested on its
# 53-bit value f = fs·2^fe (ADR 0002 row 18, M5 part 2d-6: past DBL_MAX where ω was) and printed as Rust's double
# `frequency`. Mirrors fdtd.rs's `nf2ff_validate`.
fn _bj_nf_validate(nx, ny, dx: f64, frequency: f64, fs: f64, fe, box_margin, n_angles, ks: *f64, ke: *i64): i64 {
    if (n_angles == 0) { return _bj_nf_bad("need at least one observation angle"); }
    if (box_margin == 0 || _bj_nf_uge(box_margin, nx >> 1) == 1 || _bj_nf_uge(box_margin, ny >> 1) == 1) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "NF2FF box margin must be in 1..min(nx, ny)/2 for a ");
        _bj_tx_u64(t, nx);
        _bj_tx_cstr(t, "x");
        _bj_tx_u64(t, ny);
        _bj_tx_cstr(t, " grid, got ");
        _bj_tx_u64(t, box_margin);
        return BJ_ERR_INVALID_PARAMETER;
    }
    if (_bj_nf_pos(dx) == 0) {
        var t2 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t2, "dx must be finite and positive, got ");
        _bj_fmt_f64_display(t2, dx);
        return BJ_ERR_INVALID_PARAMETER;
    }
    if (_bj_k_ux_is_positive(fs, fe) == 0) {
        var t3 = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t3, "NF2FF frequency must be finite and positive, got ");
        _bj_fmt_f64_display(t3, frequency);
        return BJ_ERR_INVALID_PARAMETER;
    }
    var w: f64 = 2.0 * _BJ_NF_PI;
    var ws, we = _bj_k_ux_from(w);
    var wfs, wfe = _bj_k_ux_mul(ws, we, fs, fe);
    var cs, ce = _bj_k_ux_from(BJ_SPEED_OF_LIGHT);
    var qs, qe = _bj_k_ux_div(wfs, wfe, cs, ce);
    ks[0] = qs;
    ke[0] = qe;
    return 0;
}

# 0 when a field of len samples covers the nx·ny grid, else InvalidParameter "NF2FF field `{name}` has {len} samples,
# need {nx}x{ny}" recorded and its code (also when nx·ny overflows). Mirrors fdtd.rs's `nf2ff_check_len`.
fn _bj_nf_check_len(name, len, nx, ny): i64 {
    var n: i64[1];
    if (_bj_nf_umul(nx, ny, &n) == 1 && _bj_nf_uge(len, n[0]) == 1) { return 0; }
    var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(t, "NF2FF field `");
    _bj_tx_cstr(t, name);
    _bj_tx_cstr(t, "` has ");
    _bj_tx_u64(t, len);
    _bj_tx_cstr(t, " samples, need ");
    _bj_tx_u64(t, nx);
    _bj_tx_cstr(t, "x");
    _bj_tx_u64(t, ny);
    return BJ_ERR_INVALID_PARAMETER;
}

# The phasor at index i of a field held as real parts at re and imaginary parts at im (0: all zero, a snapshot).
#must_use
fn _bj_nf_at(re, im, i): (f64, f64) {
    var rp: *f64 = _bj_nf_f64p(re);
    var r: f64 = rp[i];
    var q: f64 = 0.0;
    if (im != 0) {
        var ip: *f64 = _bj_nf_f64p(im);
        q = ip[i];
    }
    return (r, q);
}

# One contour sample's weighted currents into s[0..4]: J_z = (h_t·rot)·(sign·w) with h_t = (a + b)·½, then the side's
# magnetic current, the E sample e·(sign·w) (M_x on a horizontal side, M_y on a vertical one). Rust's `Cplx` add, scale
# and mul in order. Rust also keeps the other component, zero, and multiplies it by the phasor; that product is ±0 (or
# NaN only where the phasor is NaN, when N_z is NaN as well), so it can't reach the pattern, |η·N_z − L_φ|, and the
# core skips it. 0 when every operation is its 53-bit value (the section comment), 1 where one isn't, 2 for a
# non-finite field value.
fn _bj_nf_sample(s: *f64, ar: f64, ai: f64, br: f64, bi: f64, er: f64, ei: f64, rot_r: f64, rot_i: f64, sw: f64): i64 {
    var sr: f64 = ar + br;
    var si: f64 = ai + bi;
    var hr: f64 = sr * 0.5;
    var hi: f64 = si * 0.5;
    var p1: f64 = hr * rot_r;
    var p2: f64 = hi * rot_i;
    var jr: f64 = p1 - p2;
    var p3: f64 = hr * rot_i;
    var p4: f64 = hi * rot_r;
    var ji: f64 = p3 + p4;
    var s0: f64 = jr * sw;
    var s1: f64 = ji * sw;
    var s2: f64 = er * sw;
    var s3: f64 = ei * sw;
    s[0] = s0;
    s[1] = s1;
    s[2] = s2;
    s[3] = s3;
    var z: f64 = ar * 0.0 + ai * 0.0 + br * 0.0 + bi * 0.0 + er * 0.0 + ei * 0.0;
    if (z != 0.0) { return 2; }
    if (_bj_nf_kept(hr, sr, 0.5) == 0 || _bj_nf_kept(hi, si, 0.5) == 0) { return 1; }
    if (_bj_nf_kept2(p1, hr, rot_r, p2) == 0 || _bj_nf_kept2(p2, hi, rot_i, p1) == 0) { return 1; }
    if (_bj_nf_kept2(p3, hr, rot_i, p4) == 0 || _bj_nf_kept2(p4, hi, rot_r, p3) == 0) { return 1; }
    if (_bj_nf_fin(jr) == 0 || _bj_nf_fin(ji) == 0) { return 1; }
    if (_bj_nf_kept(s0, jr, sw) == 0 || _bj_nf_kept(s1, ji, sw) == 0) { return 1; }
    if (_bj_nf_kept(s2, er, sw) == 0 || _bj_nf_kept(s3, ei, sw) == 0) { return 1; }
    return 0;
}

# _bj_nf_sample with an unbounded exponent (the section comment's slow path): J_z's then M's real and imaginary parts
# as s·2^e, the four significands into the 32 bytes at ps and the four exponents into those at pe, each operation to
# 53 bits. u and ue hold H's rotation (cos at 0, sin at 1) and the weight sign·w (at 4).
fn _bj_nf_sample_ux(ps, pe, ar: f64, ai: f64, br: f64, bi: f64, er: f64, ei: f64, u: *f64, ue: *i64) {
    var xs: *f64 = _bj_nf_f64p(ps);
    var xe: *i64 = _bj_nf_i64p(pe);
    var ars, are = _bj_k_ux_from(ar);
    var brs, bre = _bj_k_ux_from(br);
    var srs, sre = _bj_k_ux_add(ars, are, brs, bre);
    var hrs, hre = _bj_k_ux_mul(srs, sre, 1.0, 0 - 1);
    var ais, aie = _bj_k_ux_from(ai);
    var bis, bie = _bj_k_ux_from(bi);
    var sis, sie = _bj_k_ux_add(ais, aie, bis, bie);
    var his, hie = _bj_k_ux_mul(sis, sie, 1.0, 0 - 1);
    var p1s, p1e = _bj_k_ux_mul(hrs, hre, u[0], ue[0]);
    var p2s, p2e = _bj_k_ux_mul(his, hie, u[1], ue[1]);
    var jrs, jre = _bj_k_ux_sub(p1s, p1e, p2s, p2e);
    var p3s, p3e = _bj_k_ux_mul(hrs, hre, u[1], ue[1]);
    var p4s, p4e = _bj_k_ux_mul(his, hie, u[0], ue[0]);
    var jis, jie = _bj_k_ux_add(p3s, p3e, p4s, p4e);
    var o0s, o0e = _bj_k_ux_mul(jrs, jre, u[4], ue[4]);
    var o1s, o1e = _bj_k_ux_mul(jis, jie, u[4], ue[4]);
    var ers, ere = _bj_k_ux_from(er);
    var o2s, o2e = _bj_k_ux_mul(ers, ere, u[4], ue[4]);
    var eis, eie = _bj_k_ux_from(ei);
    var o3s, o3e = _bj_k_ux_mul(eis, eie, u[4], ue[4]);
    xs[0] = o0s;
    xe[0] = o0e;
    xs[1] = o1s;
    xe[1] = o1e;
    xs[2] = o2s;
    xe[2] = o2e;
    xs[3] = o3s;
    xe[3] = o3e;
    return 0;
}

# The contour's samples in the order the sides run (bottom y₀ and top y₁ along +x, left x₀ and right x₁ along +y; the
# signs +1, −1, −1, +1): as doubles into sb (32 bytes each, by _bj_nf_sample; the result is the worst status, 0, 1
# or 2) when sms is 0, else with an unbounded exponent into sms and sme (32 bytes each, by _bj_nf_sample_ux; 0). The
# fields are
# re/im address pairs at f[0..6] (E_z, H_x, H_y; an im of 0 reads as zero); g holds x₀, x₁, y₀, y₁ and nx; d H's
# rotation (cos, sin), dx and dx/2 as Rust's doubles; u and ue the same with an unbounded exponent (u[4] is scratch).
fn _bj_nf_samples(f: *i64, g: *i64, d: *f64, u: *f64, ue: *i64, sb, sms, sme): i64 {
    var x0 = g[0];
    var x1 = g[1];
    var y0 = g[2];
    var y1 = g[3];
    var nx = g[4];
    var st = 0;
    var at = 0;
    for (var side = 0; side < 4; side = side + 1) {
        var vertical = 0;
        var line = y0;
        var sign: f64 = 1.0;
        if (side == 1) {
            line = y1;
            sign = -1.0;
        }
        if (side == 2) {
            vertical = 1;
            line = x0;
            sign = -1.0;
        }
        if (side == 3) {
            vertical = 1;
            line = x1;
        }
        var n = x1 - x0 + 1;
        if (vertical == 1) { n = y1 - y0 + 1; }
        var last = n - 1;
        for (var i = 0; i < n; i = i + 1) {
            var ia = 0;
            var ib = 0;
            var ha = f[2];
            var hai = f[3];
            if (vertical == 0) {
                ia = (line - 1) * nx + x0 + i;
                ib = line * nx + x0 + i;
            } else {
                ia = (y0 + i) * nx + line - 1;
                ib = (y0 + i) * nx + line;
                ha = f[4];
                hai = f[5];
            }
            var ar, ai = _bj_nf_at(ha, hai, ia);
            var br, bi = _bj_nf_at(ha, hai, ib);
            var er, ei = _bj_nf_at(f[0], f[1], ib);
            if (sms == 0) {
                var w: f64 = d[2];
                if (i == 0 || i == last) { w = d[3]; }
                var sw: f64 = sign * w;
                var r = _bj_nf_sample(_bj_nf_f64p(sb + (at + i) * 32), ar, ai, br, bi, er, ei, d[0], d[1], sw);
                if (r > st) { st = r; }
            } else {
                u[4] = u[2];
                ue[4] = ue[2];
                if (i == 0 || i == last) {
                    u[4] = u[3];
                    ue[4] = ue[3];
                }
                if (sign < 0.0) {
                    var nw: f64 = u[4];
                    u[4] = -nw;
                }
                _bj_nf_sample_ux(sms + (at + i) * 32, sme + (at + i) * 32, ar, ai, br, bi, er, ei, u, ue);
            }
        }
        at = at + n;
    }
    return st;
}

# 1 when one of a sample's eight products, J_z·rot and M·rot, leaves the normal range unabsorbed: not
# _bj_nf_kept2 against its partner in the same sum.
#must_use
fn _bj_nf_low8(jzr: f64, jzi: f64, mxr: f64, mxi: f64, rr: f64, ri: f64): i64 {
    var p1: f64 = jzr * rr;
    var p2: f64 = jzi * ri;
    if (_bj_nf_kept2(p1, jzr, rr, p2) == 0 || _bj_nf_kept2(p2, jzi, ri, p1) == 0) { return 1; }
    var p3: f64 = jzr * ri;
    var p4: f64 = jzi * rr;
    if (_bj_nf_kept2(p3, jzr, ri, p4) == 0 || _bj_nf_kept2(p4, jzi, rr, p3) == 0) { return 1; }
    var p5: f64 = mxr * rr;
    var p6: f64 = mxi * ri;
    if (_bj_nf_kept2(p5, mxr, rr, p6) == 0 || _bj_nf_kept2(p6, mxi, ri, p5) == 0) { return 1; }
    var p7: f64 = mxr * ri;
    var p8: f64 = mxi * rr;
    if (_bj_nf_kept2(p7, mxr, ri, p8) == 0 || _bj_nf_kept2(p8, mxi, rr, p7) == 0) { return 1; }
    return 0;
}

# One side's sums for an angle by Rust's recurrence (N_z += J_z·rot, M += M·rot, rot ← rot·step) over the n samples at
# smp, from rot = (rr, ri) and step = (sc, ss), into acc[0], acc[1] (N_z) and acc[mo], acc[mo + 1] (the side's L
# component): 1, or 0 where a product leaves the normal range unabsorbed (acc is then partial; the angle reruns). t is
# 1024 less the samples' smallest exponent field (the section comment): a sample whose rotation parts' fields are both
# at least t has its eight products normal or exact zeros, else _bj_nf_low8 judges them (−1023: never).
fn _bj_nf_side(smp: *f64, n, rr: f64, ri: f64, sc: f64, ss: f64, t, acc: *f64, mo): i64 {
    var nzr: f64 = acc[0];
    var nzi: f64 = acc[1];
    var mr: f64 = acc[mo];
    var mi: f64 = acc[mo + 1];
    for (var j = 0; j < n; j = j + 1) {
        var q = j * 4;
        var jzr: f64 = smp[q];
        var jzi: f64 = smp[q + 1];
        var mxr: f64 = smp[q + 2];
        var mxi: f64 = smp[q + 3];
        # either rotation part's exponent field below t: (e − t) is then negative, so one test
        if (((((load64(&rr) >> 52) & 2047) - t) | (((load64(&ri) >> 52) & 2047) - t)) < 0) {
            if (_bj_nf_low8(jzr, jzi, mxr, mxi, rr, ri) == 1) { return 0; }
        }
        nzr = nzr + (jzr * rr - jzi * ri);
        nzi = nzi + (jzr * ri + jzi * rr);
        mr = mr + (mxr * rr - mxi * ri);
        mi = mi + (mxr * ri + mxi * rr);
        var nr: f64 = rr * sc - ri * ss;
        ri = rr * ss + ri * sc;
        rr = nr;
    }
    acc[0] = nzr;
    acc[1] = nzi;
    acc[mo] = mr;
    acc[mo + 1] = mi;
    return 1;
}

# An angle's pattern value √(k/8π)·|η·N_z − L_φ| from its sums acc[0..6] (N_z, L_x, L_y), L_φ = −L_x sin φ + L_y cos φ,
# into *out: 1 where every operation before the last product is its 53-bit value (each product as a sample's against
# its sum's other term, the sums finite, the magnitude normal or 0 and finite), else 0 (*out is then Rust's value).
fn _bj_nf_tail(acc: *f64, cp: f64, sp: f64, eta0: f64, norm: f64, out: *f64): i64 {
    var nzr: f64 = acc[0];
    var nzi: f64 = acc[1];
    var lxr: f64 = acc[2];
    var lxi: f64 = acc[3];
    var lyr: f64 = acc[4];
    var lyi: f64 = acc[5];
    var nsp: f64 = -sp;
    var q1: f64 = lyr * cp;
    var q2: f64 = lxr * nsp;
    var lpr: f64 = q1 + q2;
    var q3: f64 = lyi * cp;
    var q4: f64 = lxi * nsp;
    var lpi: f64 = q3 + q4;
    var q5: f64 = nzr * eta0;
    var nlr: f64 = lpr * -1.0;
    var tr: f64 = q5 + nlr;
    var q6: f64 = nzi * eta0;
    var nli: f64 = lpi * -1.0;
    var ti: f64 = q6 + nli;
    var mag: f64 = _bj_hypot(tr, ti);
    var pat: f64 = norm * mag;
    out[0] = pat;
    var z: f64 = nzr * 0.0 + nzi * 0.0 + lxr * 0.0 + lxi * 0.0 + lyr * 0.0 + lyi * 0.0;
    if (z != 0.0) { return 0; }
    if (_bj_nf_kept2(q1, lyr, cp, q2) == 0 || _bj_nf_kept2(q2, lxr, nsp, q1) == 0) { return 0; }
    if (_bj_nf_kept2(q3, lyi, cp, q4) == 0 || _bj_nf_kept2(q4, lxi, nsp, q3) == 0) { return 0; }
    if (_bj_nf_kept2(q5, nzr, eta0, nlr) == 0 || _bj_nf_kept2(q6, nzi, eta0, nli) == 0) { return 0; }
    if (_bj_nf_fin(lpr) == 0 || _bj_nf_fin(lpi) == 0 || _bj_nf_fin(tr) == 0 || _bj_nf_fin(ti) == 0) { return 0; }
    if (_bj_nf_kept(mag, tr, ti) == 0) { return 0; }
    return 1;
}

# One angle's pattern value with an unbounded exponent throughout (the section comment's slow path): Rust's operations
# in its order, each to 53 bits, the sines and cosines of the 53-bit angles (Payne–Hanek past DBL_MAX), the magnitude
# by _bj_vx_hypot_ux and its product with √(k/8π) rounded once. us and ue hold k, k·dx, √(k/8π) and the four sides'
# starts, x then y (at 0, 1, 2, 3–6 and 7–10); dir the sides' unit steps (x at 0–3, y at 4–7) and cnt their sample
# counts. The samples are sms's and sme's (_bj_nf_sample_ux's layout) or, where sms is 0, sb's doubles.
#must_use
fn _bj_nf_angle_ux(cp: f64, sp: f64, us: *f64, ue: *i64, dir: *f64, cnt: *i64, sb, sms, sme, eta0: f64): f64 {
    var cps, cpe = _bj_k_ux_from(cp);
    var sps, spe = _bj_k_ux_from(sp);
    var a: f64[6];
    var ae: i64[6];
    for (var i = 0; i < 6; i = i + 1) {
        a[i] = 0.0;
        ae[i] = 0;
    }
    var base = 0;
    for (var s = 0; s < 4; s = s + 1) {
        var pas, pae = _bj_k_ux_mul(us[3 + s], ue[3 + s], cps, cpe);
        var pbs, pbe = _bj_k_ux_mul(us[7 + s], ue[7 + s], sps, spe);
        var prs, pre = _bj_k_ux_add(pas, pae, pbs, pbe);
        var gs, ge = _bj_k_ux_mul(us[0], ue[0], prs, pre);
        var ris, rie = _bj_vx_sin53(gs, ge);
        var rrs, rre = _bj_vx_cos53(gs, ge);
        var dp: f64 = dir[s] * cp + dir[4 + s] * sp;
        var dps, dpe = _bj_k_ux_from(dp);
        var hs, he = _bj_k_ux_mul(us[1], ue[1], dps, dpe);
        var sss, sse = _bj_vx_sin53(hs, he);
        var scs, sce = _bj_vx_cos53(hs, he);
        var mo = 2;
        if (s >= 2) { mo = 4; }
        var nrs: f64 = a[0];
        var nre = ae[0];
        var nis: f64 = a[1];
        var nie = ae[1];
        var mrs: f64 = a[mo];
        var mre = ae[mo];
        var mis: f64 = a[mo + 1];
        var mie = ae[mo + 1];
        for (var j = 0; j < cnt[s]; j = j + 1) {
            var w = base + j;
            var jrs: f64 = 0.0;
            var jre = 0;
            var jis: f64 = 0.0;
            var jie = 0;
            var xrs: f64 = 0.0;
            var xre = 0;
            var xis: f64 = 0.0;
            var xie = 0;
            if (sms != 0) {
                var xs: *f64 = _bj_nf_f64p(sms + w * 32);
                var xe: *i64 = _bj_nf_i64p(sme + w * 32);
                jrs = xs[0];
                jre = xe[0];
                jis = xs[1];
                jie = xe[1];
                xrs = xs[2];
                xre = xe[2];
                xis = xs[3];
                xie = xe[3];
            } else {
                var dpp: *f64 = _bj_nf_f64p(sb + w * 32);
                var c0s, c0e = _bj_k_ux_from(dpp[0]);
                var c1s, c1e = _bj_k_ux_from(dpp[1]);
                var c2s, c2e = _bj_k_ux_from(dpp[2]);
                var c3s, c3e = _bj_k_ux_from(dpp[3]);
                jrs = c0s;
                jre = c0e;
                jis = c1s;
                jie = c1e;
                xrs = c2s;
                xre = c2e;
                xis = c3s;
                xie = c3e;
            }
            var t1s, t1e = _bj_k_ux_mul(jrs, jre, rrs, rre);
            var t2s, t2e = _bj_k_ux_mul(jis, jie, ris, rie);
            var t3s, t3e = _bj_k_ux_sub(t1s, t1e, t2s, t2e);
            var n1s, n1e = _bj_k_ux_add(nrs, nre, t3s, t3e);
            nrs = n1s;
            nre = n1e;
            var t4s, t4e = _bj_k_ux_mul(jrs, jre, ris, rie);
            var t5s, t5e = _bj_k_ux_mul(jis, jie, rrs, rre);
            var t6s, t6e = _bj_k_ux_add(t4s, t4e, t5s, t5e);
            var n2s, n2e = _bj_k_ux_add(nis, nie, t6s, t6e);
            nis = n2s;
            nie = n2e;
            var v1s, v1e = _bj_k_ux_mul(xrs, xre, rrs, rre);
            var v2s, v2e = _bj_k_ux_mul(xis, xie, ris, rie);
            var v3s, v3e = _bj_k_ux_sub(v1s, v1e, v2s, v2e);
            var m1s, m1e = _bj_k_ux_add(mrs, mre, v3s, v3e);
            mrs = m1s;
            mre = m1e;
            var v4s, v4e = _bj_k_ux_mul(xrs, xre, ris, rie);
            var v5s, v5e = _bj_k_ux_mul(xis, xie, rrs, rre);
            var v6s, v6e = _bj_k_ux_add(v4s, v4e, v5s, v5e);
            var m2s, m2e = _bj_k_ux_add(mis, mie, v6s, v6e);
            mis = m2s;
            mie = m2e;
            var u1s, u1e = _bj_k_ux_mul(rrs, rre, scs, sce);
            var u2s, u2e = _bj_k_ux_mul(ris, rie, sss, sse);
            var u3s, u3e = _bj_k_ux_mul(rrs, rre, sss, sse);
            var u4s, u4e = _bj_k_ux_mul(ris, rie, scs, sce);
            var r1s, r1e = _bj_k_ux_sub(u1s, u1e, u2s, u2e);
            var r2s, r2e = _bj_k_ux_add(u3s, u3e, u4s, u4e);
            rrs = r1s;
            rre = r1e;
            ris = r2s;
            rie = r2e;
        }
        a[0] = nrs;
        ae[0] = nre;
        a[1] = nis;
        ae[1] = nie;
        a[mo] = mrs;
        ae[mo] = mre;
        a[mo + 1] = mis;
        ae[mo + 1] = mie;
        base = base + cnt[s];
    }
    var nsps: f64 = -sps;
    var q1s, q1e = _bj_k_ux_mul(a[4], ae[4], cps, cpe);
    var q2s, q2e = _bj_k_ux_mul(a[2], ae[2], nsps, spe);
    var lrs, lre = _bj_k_ux_add(q1s, q1e, q2s, q2e);
    var q3s, q3e = _bj_k_ux_mul(a[5], ae[5], cps, cpe);
    var q4s, q4e = _bj_k_ux_mul(a[3], ae[3], nsps, spe);
    var lis, lie = _bj_k_ux_add(q3s, q3e, q4s, q4e);
    var hts, hte = _bj_k_ux_from(eta0);
    var q5s, q5e = _bj_k_ux_mul(a[0], ae[0], hts, hte);
    var trs, tre = _bj_k_ux_sub(q5s, q5e, lrs, lre);
    var q6s, q6e = _bj_k_ux_mul(a[1], ae[1], hts, hte);
    var tis, tie = _bj_k_ux_sub(q6s, q6e, lis, lie);
    var ms, me = _bj_vx_hypot_ux(trs, tre, tis, tie);
    var r: f64 = _bj_k_ux_mul_f64(us[2], ue[2], ms, me);
    return r;
}

# The TM-mode NF2FF core (2D Love equivalence, e^{+jωt} phasors) into *out: 0, or the Allocation code recorded. The
# fields are re/im address pairs at f[0..6] (E_z, H_x, H_y; an im of 0 reads as zero); sv and se hold, each s·2^e to
# 53 bits with an unbounded exponent, the rotation of H onto E's time (cos at 0, sin at 1) and k (at 2). The contour
# runs through the E_z nodes x₀ = y₀ = margin, x₁ = nx − 1 − margin, y₁ = ny − 1 − margin; tangential H is the mean of
# the two Yee samples beside it; J = n̂×H, M = −n̂×E, trapezoid weights (half at each side's corners). The pattern is
# √(k/8π)·|η·N_z − L_φ|, N_z and L = (L_x, L_y) summed with e^{jk ρ̂·ρ'} advanced by a constant phasor along each side,
# L_φ = −L_x sin φ + L_y cos φ, at its range edges as the section comment has it (mode 0 Rust's chain, checked; 1
# wholly unbounded; 2 Rust's, for a non-finite field). Callers have validated the arguments. Mirrors fdtd.rs's
# `nf2ff_tm_core`.
fn _bj_nf_core(f: *i64, sv: *f64, se: *i64, nx, ny, dx: f64, margin, n_angles, out: *BjNf2ffResult): i64 {
    var x0 = margin;
    var x1 = nx - 1 - margin;
    var y0 = margin;
    var y1 = ny - 1 - margin;
    var xs: f64 = _bj_nf_u2f(x0 + x1);
    var xc: f64 = 0.5 * xs;
    var ys: f64 = _bj_nf_u2f(y0 + y1);
    var yc: f64 = 0.5 * ys;
    var nhs = x1 - x0 + 1;
    var nvs = y1 - y0 + 1;
    var total = 2 * nhs + 2 * nvs;
    if (n_angles < 0 || n_angles > _BJ_NF_FL_MAX / 16 || total > _BJ_NF_FL_MAX / 32) {
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "an NF2FF result");
        return BJ_ERR_ALLOCATION;
    }
    var sb = fl_alloc(total * 32);
    var rb = fl_alloc(n_angles * 16);
    if (sb == 0 || rb == 0) {
        if (sb != 0) { fl_free(sb); }
        if (rb != 0) { fl_free(rb); }
        _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "an NF2FF result");
        return BJ_ERR_ALLOCATION;
    }
    # The scalars: Rust's doubles (from k and the rotation rounded into binary64), and with an unbounded exponent.
    var mode = 0;
    if (_bj_nf_dbl(sv[0], se[0]) == 0 || _bj_nf_dbl(sv[1], se[1]) == 0 || _bj_nf_dbl(sv[2], se[2]) == 0) { mode = 1; }
    var rot_r: f64 = _bj_k_ux_round(sv[0], se[0], 0.0);
    var rot_i: f64 = _bj_k_ux_round(sv[1], se[1], 0.0);
    var k: f64 = _bj_k_ux_round(sv[2], se[2], 0.0);
    var half: f64 = 0.5 * dx;
    var pi8: f64 = 8.0 * _BJ_NF_PI;
    var kn: f64 = k / pi8;
    var norm: f64 = f64_sqrt(kn);
    var kdx: f64 = k * dx;
    if (_bj_nf_kept(half, 0.5, dx) == 0 || _bj_nf_kept(kn, k, pi8) == 0 || _bj_nf_kept(kdx, k, dx) == 0) { mode = 1; }
    var us: f64[11];
    var ue: i64[11];
    var dxs, dxe = _bj_k_ux_from(dx);
    us[0] = sv[2];
    ue[0] = se[2];
    var kxs, kxe = _bj_k_ux_mul(sv[2], se[2], dxs, dxe);
    us[1] = kxs;
    ue[1] = kxe;
    var p8s, p8e = _bj_k_ux_from(pi8);
    var kns, kne = _bj_k_ux_div(sv[2], se[2], p8s, p8e);
    var nms, nme = _bj_k_ux_sqrt(kns, kne);
    us[2] = nms;
    ue[2] = nme;
    # The four sides: bottom (y₀) and top (y₁) along +x; left (x₀) and right (x₁) along +y.
    var start_x: f64[4];
    var start_y: f64[4];
    var dir: f64[8];
    var cnt: i64[4];
    for (var side = 0; side < 4; side = side + 1) {
        var ox: f64 = _bj_nf_u2f(x0);
        var oy: f64 = _bj_nf_u2f(y0);
        dir[side] = 1.0;
        dir[4 + side] = 0.0;
        cnt[side] = nhs;
        if (side == 1) { oy = _bj_nf_u2f(y1); }
        if (side >= 2) {
            dir[side] = 0.0;
            dir[4 + side] = 1.0;
            cnt[side] = nvs;
        }
        if (side == 3) { ox = _bj_nf_u2f(x1); }
        var rx: f64 = ox - xc;
        var ry: f64 = oy - yc;
        var sx: f64 = rx * dx;
        var sy: f64 = ry * dx;
        start_x[side] = sx;
        start_y[side] = sy;
        if (_bj_nf_kept(sx, rx, dx) == 0 || _bj_nf_kept(sy, ry, dx) == 0) { mode = 1; }
        var rxs, rxe = _bj_k_ux_from(rx);
        var sxs, sxe = _bj_k_ux_mul(rxs, rxe, dxs, dxe);
        us[3 + side] = sxs;
        ue[3 + side] = sxe;
        var rys, rye = _bj_k_ux_from(ry);
        var sys, sye = _bj_k_ux_mul(rys, rye, dxs, dxe);
        us[7 + side] = sys;
        ue[7 + side] = sye;
    }
    # The samples (a non-finite field keeps Rust's chain: mode 2).
    var g: i64[5];
    g[0] = x0;
    g[1] = x1;
    g[2] = y0;
    g[3] = y1;
    g[4] = nx;
    var d: f64[4];
    d[0] = rot_r;
    d[1] = rot_i;
    d[2] = dx;
    d[3] = half;
    var u: f64[5];
    var uxe: i64[5];
    u[0] = sv[0];
    uxe[0] = se[0];
    u[1] = sv[1];
    uxe[1] = se[1];
    u[2] = dxs;
    uxe[2] = dxe;
    var hfs, hfe = _bj_k_ux_mul(dxs, dxe, 1.0, 0 - 1);
    u[3] = hfs;
    uxe[3] = hfe;
    var st = _bj_nf_samples(f, &g, &d, &u, &uxe, sb, 0, 0);
    if (st == 2) {
        mode = 2;
    } elif (st == 1) {
        mode = 1;
    }
    var sms = 0;
    var sme = 0;
    if (mode == 1) {
        sms = fl_alloc(total * 32);
        sme = fl_alloc(total * 32);
        if (sms == 0 || sme == 0) {
            if (sms != 0) { fl_free(sms); }
            if (sme != 0) { fl_free(sme); }
            fl_free(sb);
            fl_free(rb);
            _bj_tx_cstr(_bj_err_reason(BJ_ERR_ALLOCATION), "an NF2FF result");
            return BJ_ERR_ALLOCATION;
        }
        _bj_nf_samples(f, &g, &d, &u, &uxe, sb, sms, sme);
    }
    var smp: *f64 = _bj_nf_f64p(sb);
    var t = 0 - 1023;
    if (mode == 0) {
        var emin = 2047;
        for (var q = 0; q < total * 4; q = q + 1) {
            var x: f64 = smp[q];
            var ex = (load64(&x) >> 52) & 2047;
            if (x != 0.0 && ex < emin) { emin = ex; }
        }
        t = 1024 - emin;
    }
    var mu0: f64 = BJ_MU_0;
    var me: f64 = mu0 / BJ_EPSILON_0;
    var eta0: f64 = f64_sqrt(me);
    var nf: f64 = _bj_nf_u2f(n_angles);
    var w2: f64 = 2.0 * _BJ_NF_PI;
    var pat: *f64 = _bj_nf_f64p(rb);
    var ang: *f64 = _bj_nf_f64p(rb + n_angles * 8);
    var acc: f64[6];
    var po: f64[1];
    for (var a = 0; a < n_angles; a = a + 1) {
        var af: f64 = _bj_nf_u2f(a);
        var wa: f64 = w2 * af;
        var phi: f64 = wa / nf;
        ang[a] = phi;
        var sp, cp = _bj_sin_cos(phi);
        var ok = 1;
        if (mode == 1) { ok = 0; }
        for (var i = 0; i < 6; i = i + 1) { acc[i] = 0.0; }
        var base = 0;
        for (var s = 0; s < 4; s = s + 1) {
            if (ok == 1) {
                var pa: f64 = start_x[s] * cp;
                var pb: f64 = start_y[s] * sp;
                var pr: f64 = pa + pb;
                var rarg: f64 = k * pr;
                var rs, rc = _bj_sin_cos(rarg);
                var dp: f64 = dir[s] * cp + dir[4 + s] * sp;
                var sarg: f64 = kdx * dp;
                var ss, sc = _bj_sin_cos(sarg);
                if (mode == 0) {
                    var sx0: f64 = start_x[s];
                    var sy0: f64 = start_y[s];
                    if (_bj_nf_kept2(pa, sx0, cp, pb) == 0 || _bj_nf_kept2(pb, sy0, sp, pa) == 0) { ok = 0; }
                    if (_bj_nf_fin(pr) == 0 || _bj_nf_kept(rarg, k, pr) == 0) { ok = 0; }
                    if (_bj_nf_kept(sarg, kdx, dp) == 0 || _bj_nf_step_ok(sc, ss) == 0) { ok = 0; }
                }
                if (ok == 1) {
                    var mo = 2;
                    if (s >= 2) { mo = 4; }
                    ok = _bj_nf_side(_bj_nf_f64p(sb + base * 32), cnt[s], rc, rs, sc, ss, t, &acc, mo);
                }
            }
            base = base + cnt[s];
        }
        if (ok == 1) {
            var tk = _bj_nf_tail(&acc, cp, sp, eta0, norm, &po);
            if (mode == 0 && tk == 0) { ok = 0; }
        }
        if (ok == 1) {
            pat[a] = po[0];
        } else {
            var pu: f64 = _bj_nf_angle_ux(cp, sp, &us, &ue, &dir, &cnt, sb, sms, sme, eta0);
            pat[a] = pu;
        }
    }
    fl_free(sb);
    if (sms != 0) {
        fl_free(sms);
        fl_free(sme);
    }
    out.pattern = rb;
    out.angles = rb + n_angles * 8;
    out.count = n_angles;
    return 0;
}

# |a − b| ≤ 10⁻¹²·max(|a|, |b|): for finite a and b decided exactly, the decimal 10⁻¹² (src/crmath_edge.cyr's
# _bj_e_within12, z0_equal's: ADR 0002 row 17, M5 part 2c); otherwise Rust's test with its NaN-ignoring max (a NaN
# difference fails, and ∞ against a finite value passes: ez's ∞ is refused afterwards as an invalid frequency or dt,
# hx's or hy's is not).
#must_use
fn _bj_nf_same(a: f64, b: f64): i64 {
    var za: f64 = a * 0.0;
    var zb: f64 = b * 0.0;
    if (za == 0.0 && zb == 0.0) {
        var fa: f64 = f64_abs(a);
        var fb: f64 = f64_abs(b);
        var fm: f64 = fa;
        if (fb > fa) { fm = fb; }
        return _bj_e_within12(a, b, fm);
    }
    var d: f64 = a - b;
    var ad: f64 = f64_abs(d);
    var aa: f64 = f64_abs(a);
    var ab: f64 = f64_abs(b);
    var m: f64 = _bj_max(aa, ab);
    var lim: f64 = _BJ_NF_REL12 * m;
    if (ad <= lim) { return 1; }
    return 0;
}

# _bj_nf_same on two 53-bit values a = as·2^ae and b = bs·2^be with an unbounded exponent (ω's, kept past DBL_MAX and
# below 2^-1022: ADR 0002 row 18, M5 part 2d-6): for finite ones, the exact test on both scaled by one power of two,
# the larger into [1, 2) (the test is homogeneous; a smaller one scaled below 2^-1022 fails it, as its exact value
# does: |a − b| > (1 − 2^-1021)·|a| then); otherwise _bj_nf_same on Rust's doubles ad and bd.
#must_use
fn _bj_nf_same53(av: f64, ae, bv: f64, be, ad: f64, bd: f64): i64 {
    var za: f64 = av * 0.0;
    var zb: f64 = bv * 0.0;
    if (za == 0.0 && zb == 0.0) {
        if (av == 0.0 || bv == 0.0) {
            if (av == 0.0 && bv == 0.0) { return 1; }
            return 0;
        }
        var m = ae;
        if (be > m) { m = be; }
        var a: f64 = _bj_k_ux_round(av, ae - m, 0.0);
        var b: f64 = _bj_k_ux_round(bv, be - m, 0.0);
        var fa: f64 = f64_abs(a);
        var fb: f64 = f64_abs(b);
        var fm: f64 = fa;
        if (fb > fa) { fm = fb; }
        return _bj_e_within12(a, b, fm);
    }
    var r = _bj_nf_same(ad, bd);
    return r;
}

# The 2D TM NF2FF transform of CW phasors into *out (free a previous result first): ez, hx and hy are accumulators of
# E_z, H_x and H_y on an nx × ny Yee grid laid out as Fdtd2d's TM mode (index y·nx + x; E_z at (x, y), H_x at
# (x, y + ½), H_y at (x + ½, y)), fed after each step with the same time-step index, so H is rotated by e^{+jω·dt/2}
# onto E. The pattern is √ρ·|E_z(ρ, φ)| as ρ → ∞ at n_angles angles from 0, linear in the inputs (a CW steady state's
# running DFT is about the phasor times n_samples·dt/2). Ok(0), or with out empty Err(InvalidParameter), Rust's
# texts in Rust's order: the accumulators disagree on ω or dt (relative 10⁻¹²); n_angles is 0; the margin is 0 or at
# least nx/2 or ny/2; dx isn't finite and positive; the frequency isn't; an accumulator holds fewer than nx·ny
# samples; dt isn't finite. Err(Allocation) when the result can't be had. ω is read to 53 bits with an unbounded
# exponent (omega_s, omega_e) for the agreement, the frequency, k and the rotation, and the transform runs at its
# range edges (ADR 0002 row 18, M5 part 2d-6; the section comment). Mirrors `nf2ff_2d_phasor`.
#must_use
public fn bj_nf2ff_2d_phasor(ez: *BjCwAccumulator, hx: *BjCwAccumulator, hy: *BjCwAccumulator, nx, ny, dx: f64,
  box_margin, n_angles, out: *BjNf2ffResult): Result {
    _bj_zero(out, sizeof(BjNf2ffResult));
    var ok = _bj_nf_same53(ez.omega_s, ez.omega_e, hx.omega_s, hx.omega_e, ez.omega, hx.omega);
    if (ok == 1) { ok = _bj_nf_same53(ez.omega_s, ez.omega_e, hy.omega_s, hy.omega_e, ez.omega, hy.omega); }
    if (ok == 1) { ok = _bj_nf_same(ez.dt, hx.dt); }
    if (ok == 1) { ok = _bj_nf_same(ez.dt, hy.dt); }
    if (ok == 0) { return Err(_bj_nf_bad("NF2FF phasor accumulators must share frequency and dt")); }
    var w: f64 = 2.0 * _BJ_NF_PI;
    var frequency: f64 = ez.omega / w;
    var ws, we = _bj_k_ux_from(w);
    var fs, fe = _bj_k_ux_div(ez.omega_s, ez.omega_e, ws, we);
    var sv: f64[3];
    var se: i64[3];
    var kv: f64[1];
    var kx: i64[1];
    var e = _bj_nf_validate(nx, ny, dx, frequency, fs, fe, box_margin, n_angles, &kv, &kx);
    if (e == 0) { e = _bj_nf_check_len("ez", ez.field_size, nx, ny); }
    if (e == 0) { e = _bj_nf_check_len("hx", hx.field_size, nx, ny); }
    if (e == 0) { e = _bj_nf_check_len("hy", hy.field_size, nx, ny); }
    if (e != 0) { return Err(e); }
    var dt: f64 = ez.dt;
    var z: f64 = dt * 0.0;
    if (z != 0.0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "accumulator dt must be finite, got ");
        _bj_fmt_f64_display(t, dt);
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    if (_bj_log_on(4) == 1) {
        var lb[256];
        var lt[24];
        _bj_tx_init(&lt, &lb, 256);
        _bj_tx_cstr(&lt, "NF2FF (phasor) transform nx=");
        _bj_tx_u64(&lt, nx);
        _bj_tx_cstr(&lt, " ny=");
        _bj_tx_u64(&lt, ny);
        _bj_tx_cstr(&lt, " box_margin=");
        _bj_tx_u64(&lt, box_margin);
        _bj_tx_cstr(&lt, " n_angles=");
        _bj_tx_u64(&lt, n_angles);
        _bj_tx_cstr(&lt, " frequency=");
        var fd: f64 = _bj_k_ux_round(fs, fe, 0.0);
        _bj_fmt_f64_debug(&lt, fd);
        _bj_tx_cstr(&lt, " n_samples=");
        _bj_tx_u64(&lt, ez.n_samples);
        _bj_log_text(4, &lt);
    }
    # ω·dt/2 to 53 bits, Rust's (0.5·ω)·dt, and the rotation e^{+jω·dt/2} of H onto E's time from it.
    var hws, hwe = _bj_k_ux_mul(ez.omega_s, ez.omega_e, 1.0, 0 - 1);
    var ds, de = _bj_k_ux_from(dt);
    var gs, ge = _bj_k_ux_mul(hws, hwe, ds, de);
    var rcs, rce = _bj_vx_cos53(gs, ge);
    var rss, rse = _bj_vx_sin53(gs, ge);
    sv[0] = rcs;
    se[0] = rce;
    sv[1] = rss;
    se[1] = rse;
    sv[2] = kv[0];
    se[2] = kx[0];
    var f: i64[6];
    f[0] = ez.real;
    f[1] = ez.imag;
    f[2] = hx.real;
    f[3] = hx.imag;
    f[4] = hy.real;
    f[5] = hy.imag;
    var r: BjNf2ffResult;
    var ce = _bj_nf_core(&f, &sv, &se, nx, ny, dx, box_margin, n_angles, &r);
    if (ce != 0) { return Err(ce); }
    out.pattern = r.pattern;
    out.angles = r.angles;
    out.count = r.count;
    return Ok(0);
}

# The 2D TM NF2FF transform of one time snapshot of sim into *out (free a previous result first): the contour
# `box_margin` cells inside the grid's edge, J = n̂×H and M = −n̂×E integrated by Love's equivalence, the pattern
# √ρ·|E_z(ρ, φ)| as ρ → ∞ at n_angles angles from 0 (BjNf2ffResult). A monochromatic approximation: the snapshot is
# real, so the fields are taken as the phasor's real part and H (half a step behind E on the Yee grid) as it is, and the
# result depends on the instant; for accurate patterns accumulate E_z, H_x and H_y in BjCwAccumulators and use
# bj_nf2ff_2d_phasor. Ok(0), or with out empty Err(InvalidParameter), Rust's texts in Rust's order: the grid isn't
# TM ("NF2FF requires a TM-mode simulation, got Te"), n_angles is 0, the margin is 0 or at least nx/2 or ny/2, dx isn't
# finite and positive, the frequency isn't. Rust's check that each field holds nx·ny samples goes (ADR 0002 row 2: the
# arrays are fixed at construction). Err(Allocation) when the result can't be had. The core runs at its range edges as
# the phasor form's (ADR 0002 row 18, M5 part 2d-6), its rotation (1, 0) and k = 2π·frequency/c to 53 bits. Mirrors
# `nf2ff_2d`.
#must_use
public fn bj_nf2ff_2d(sim: *BjFdtd2d, box_margin, n_angles, frequency: f64, out: *BjNf2ffResult): Result {
    _bj_zero(out, sizeof(BjNf2ffResult));
    if (sim.mode != BJ_MODE2D_TM) {
        var tm = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(tm, "NF2FF requires a TM-mode simulation, got ");
        if (sim.mode == BJ_MODE2D_TE) { _bj_tx_cstr(tm, "Te"); }
        else { _bj_tx_i64(tm, sim.mode); }
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var nx = sim.nx;
    var ny = sim.ny;
    var dx: f64 = sim.dx;
    var fs, fe = _bj_k_ux_from(frequency);
    var kv: f64[1];
    var kx: i64[1];
    var e = _bj_nf_validate(nx, ny, dx, frequency, fs, fe, box_margin, n_angles, &kv, &kx);
    if (e != 0) { return Err(e); }
    if (_bj_log_on(4) == 1) {
        var lb[256];
        var lt[24];
        _bj_tx_init(&lt, &lb, 256);
        _bj_tx_cstr(&lt, "NF2FF (snapshot) transform nx=");
        _bj_tx_u64(&lt, nx);
        _bj_tx_cstr(&lt, " ny=");
        _bj_tx_u64(&lt, ny);
        _bj_tx_cstr(&lt, " box_margin=");
        _bj_tx_u64(&lt, box_margin);
        _bj_tx_cstr(&lt, " n_angles=");
        _bj_tx_u64(&lt, n_angles);
        _bj_tx_cstr(&lt, " frequency=");
        _bj_fmt_f64_debug(&lt, frequency);
        _bj_log_text(4, &lt);
    }
    var sv: f64[3];
    var se: i64[3];
    sv[0] = 1.0;
    se[0] = 0;
    sv[1] = 0.0;
    se[1] = 0;
    sv[2] = kv[0];
    se[2] = kx[0];
    var f: i64[6];
    f[0] = sim.fz;
    f[1] = 0;
    f[2] = sim.fx;
    f[3] = 0;
    f[4] = sim.fy;
    f[5] = 0;
    var r: BjNf2ffResult;
    var ce = _bj_nf_core(&f, &sv, &se, nx, ny, dx, box_margin, n_angles, &r);
    if (ce != 0) { return Err(ce); }
    out.pattern = r.pattern;
    out.angles = r.angles;
    out.count = r.count;
    return Ok(0);
}
