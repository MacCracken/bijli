# relativity.cyr — relativistic electrodynamics: the Lorentz factor, the EM field tensor, the Lorentz transformation
# of fields, four-vectors, the retarded and Liénard–Wiechert potentials and fields, and the Larmor powers (port of
# rust-old/src/relativity.rs, M2 part 1d-1; the retarded-time solver and lienard_wiechert_fields are part 1d-2's).
#
# SI units; indices 0 = ct, 1 = x, 2 = y, 3 = z. BjFourVector's dot and interval_sq use the (−,+,+,+) metric
# η = diag(−1, 1, 1, 1). BjEmTensor stores F^μν in the Jackson/Griffiths layout (F^{0i} = −Eᵢ/c, F^{12} = −B_z), the
# contravariant tensor of the (+,−,−,−) signature: contract it with g = diag(1, −1, −1, −1), as four_force does. Rust's
# `components: [[f64; 4]; 4]` is a 16-element tuple field, row-major (probe p17), so `components.(4i + j)` is
# F^{ij}. No complex phasor appears, so no time convention (src/complex.cyr) is involved.
#
# Every formula is Rust's in Rust's order (class A). The FieldVector operations Rust calls are BjFieldVector's, so their
# range edges follow ADR 0002 row 18 (src/field.cyr). Two of Rust's faults are fixed: bj_lienard_wiechert_e refuses a
# NaN R as the Liénard–Wiechert potentials do (ADR 0002 row 27, row 20's rule), and every γ (γ² in Liénard–Wiechert's
# E) is correctly rounded from the exact c² − |v|², the |v| < c tests exact (row 30, src/crmath_gamma.cyr). The
# products and quotients of inputs and constants are rounded once (row 13, M2 part 2b-4): the retarded potentials,
# Larmor's power (src/crmath_mono.cyr's six-factor monomial) and the dual tensor, whose components are F's own; a
# non-finite operand keeps Rust's chain. The raw four-vector and tensor chains (BjFourVector's dot, interval_sq,
# spatial_magnitude and boost_x, the four-force, both invariants) keep Rust's chain where its own values pass the
# guards of src/crmath_vx.cyr, and otherwise run with an unbounded exponent and round once (row 18's rule, M2 part
# 2d-3c). The field transforms and the relativistic Larmor power, whose chains amplify a subnormal intermediate by γ and
# v, keep Rust's chain inside a box on their inputs and otherwise run unbounded (part 2d-3d). A fallible function
# returns a value-form Result, the error in the last-error record (src/error.cyr); a vector, four-vector or pair of
# vectors writes through out pointers.

private

# The 4×4 electromagnetic field tensor F^μν (contravariant, the (+,−,−,−) layout above), row-major. Mirrors
# `relativity::EmTensor`.
public struct BjEmTensor {
    components: (f64, f64, f64, f64, f64, f64, f64, f64, f64, f64, f64, f64, f64, f64, f64, f64);
}

# A four-vector (ct, x, y, z). Mirrors `relativity::FourVector`.
public struct BjFourVector {
    t: f64;
    x: f64;
    y: f64;
    z: f64;
}

# The four-potential A^μ = (φ/c, A_x, A_y, A_z): φ/c and the vector potential. Mirrors `relativity::FourPotential`.
public struct BjFourPotential {
    phi_over_c: f64;
    a: BjFieldVector;
}

# An address as a *f64: a BjEmTensor's sixteen components, from `&t` of a local or an untyped `self` (a `*T`).
fn _bj_rel_f64p(p): *f64 {
    return p;
}

# 1 when the exact |R| < 10^-30 (Σ Rᵢ² < 10^-60), else 0: the rounded |R| decides outside 64 ulps of the double
# nearest 10^-30, the exact sum of squares inside (src/crmath_cmp.cyr; ADR 0002 row 17, as the Green's functions'). A
# NaN |R| is not below (Rust's test), and an ∞ one lies far above.
#must_use
fn _bj_rel_r_below(r_vec: BjFieldVector, r_mag: f64): i64 {
    var band = _bj_x_band(r_mag, _BJ_FIELD_R2_MIN);
    if (band == 2) {
        var rp: f64[3];
        _bj_rel_parts(r_vec, &rp);
        band = _bj_x_r2_below(&rp, &_bj_x_origin, 60);
    }
    return band;
}

# g[k] := s·x (s = 1 or −1) for a finite x: a dual component rounded once is F's own (ADR 0002 row 13); a non-finite
# x leaves Rust's.
fn _bj_rel_dual_put(g: *f64, k, x: f64, s) {
    if (_bj_is_finite(x) == 0) { return 0; }
    if (s < 0) {
        var nx: f64 = -x;
        g[k] = nx;
        return 0;
    }
    g[k] = x;
    return 0;
}

# ── the Lorentz factor ───────────────────────────────────────────────────────────────────────────────────────────

# γ = 1/√(1 − v²/c²), correctly rounded: c/√(c² − v²) from the exact difference (src/crmath_gamma.cyr; ADR 0002 row
# 30: Rust's form cancelled near c, 1e-7 relative at β = 1 − 1e-9, and its rounded v²/c² ≥ 1 refused speeds an ulp
# below c). InvalidParameter "speed (v m/s) must be less than c" unless |v| < c exactly (NaN refused). Mirrors
# `relativity::lorentz_factor`.
public fn bj_lorentz_factor(speed: f64): Result {
    var vv: f64[1];
    vv[0] = speed;
    var g: f64[1];
    if (_bj_cr_lorentz(&vv, 0, 1, BJ_SPEED_OF_LIGHT, 0, 0, &g) == 0) {
        var t = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(t, "speed (");
        _bj_fmt_f64_display(t, speed);
        _bj_tx_cstr(t, " m/s) must be less than c");
        return Err(BJ_ERR_INVALID_PARAMETER);
    }
    var gamma: f64 = g[0];
    return Ok(gamma);
}

# The three components of v into p.
fn _bj_rel_parts(v: BjFieldVector, p: *f64) {
    p[0] = v.x;
    p[1] = v.y;
    p[2] = v.z;
    return 0;
}

# β = v/c. Mirrors `relativity::beta`.
#must_use
#pure
public fn bj_beta(speed: f64): f64 {
    var b: f64 = speed / BJ_SPEED_OF_LIGHT;
    return b;
}

# ── the four-vector and tensor chains at a range edge (M2 part 2d-3c) ─────────────────────────────────────────────
# Rust's chains of products and sums over- and underflow where the result is representable (ADR 0002 row 18's rule):
# the guards are src/crmath_vx.cyr's band on Rust's own sums, and the edges run each step to 53 bits with an unbounded
# exponent, the last operation rounded once. A non-finite operand keeps Rust's chain.

# −a₀b₀ + a₁b₁ + a₂b₂ + a₃b₃ at a range edge, Rust's d where its chain is the unbounded one (an exact 0 from exact
# products, or an operand not finite; the band test is the caller's).
#must_use
fn _bj_rel_dot4_edge(a: *f64, b: *f64, d: f64): f64 {
    if (_bj_vx_finite4(a[0], a[1], a[2], a[3]) == 0 || _bj_vx_finite4(b[0], b[1], b[2], b[3]) == 0) { return d; }
    var na: f64 = -a[0];
    if (d == 0.0) {
        var p0: f64 = na * b[0];
        var p1: f64 = a[1] * b[1];
        var p2: f64 = a[2] * b[2];
        var p3: f64 = a[3] * b[3];
        var e = _bj_vx_exact(na, b[0], p0) + _bj_vx_exact(a[1], b[1], p1) + _bj_vx_exact(a[2], b[2], p2)
        + _bj_vx_exact(a[3], b[3], p3);
        if (e == 4) { return d; }
    }
    var s0, e0 = _bj_vx_mul(na, b[0]);
    var s1, e1 = _bj_vx_mul(a[1], b[1]);
    var ss, se = _bj_k_ux_add(s0, e0, s1, e1);
    var s2, e2 = _bj_vx_mul(a[2], b[2]);
    var ts, te = _bj_k_ux_add(ss, se, s2, e2);
    var s3, e3 = _bj_vx_mul(a[3], b[3]);
    var w: f64 = _bj_k_ux_add_f64(ts, te, s3, e3);
    return w;
}

# γ(p − β·q), β = v/c, at a range edge (boost_x's ct' with p = ct and q = x, its x' with them swapped): Rust's γ·d where
# its chain is the unbounded one (β normal or 0 and β·q exact, or d in the band; p or q not finite), else β, β·q and
# p − β·q to 53 bits with an unbounded exponent, the product by γ rounded once.
#must_use
fn _bj_rel_boost_edge(gamma: f64, speed: f64, p: f64, q: f64, d: f64): f64 {
    var r: f64 = gamma * d;
    if (_bj_vx_finite4(p, q, 0.0, 0.0) == 0) { return r; }
    var c: f64 = BJ_SPEED_OF_LIGHT;
    var b: f64 = speed / c;
    var ab: f64 = f64_abs(b);
    if (ab > _BJ_VX_MN || speed == 0.0) {
        var bq: f64 = b * q;
        if (_bj_vx_exact(b, q, bq) == 1 || _bj_vx_band(d) == 1) { return r; }
    }
    var vs, ve = _bj_k_ux_from(speed);
    var cs, ce = _bj_k_ux_from(c);
    var bs, be = _bj_k_ux_div(vs, ve, cs, ce);
    var qs, qe = _bj_k_ux_from(q);
    var ms, me = _bj_k_ux_mul(bs, be, qs, qe);
    var ps, pe = _bj_k_ux_from(p);
    var ds, de = _bj_k_ux_sub(ps, pe, ms, me);
    var gs, ge = _bj_k_ux_from(gamma);
    var u: f64 = _bj_k_ux_mul_f64(gs, ge, ds, de);
    return u;
}

# q·(r₀u₀ + r₁u₁ + r₂u₂ + r₃u₃), one row of the four-force, at a range edge: Rust's k = q·s where its chain is the
# unbounded one (an exact 0 sum of exact products, or an operand not finite; the band test is the caller's), else
# the products and sums to 53 bits with an unbounded exponent, the product by q rounded once.
#must_use
fn _bj_rel_ff_edge(r: *f64, u: *f64, q: f64, s: f64): f64 {
    var k: f64 = q * s;
    if (_bj_vx_finite4(r[0], r[1], r[2], r[3]) == 0 || _bj_vx_finite4(u[0], u[1], u[2], u[3]) == 0
      || _bj_vx_finite4(q, 0.0, 0.0, 0.0) == 0) {
        return k;
    }
    if (s == 0.0) {
        var p0: f64 = r[0] * u[0];
        var p1: f64 = r[1] * u[1];
        var p2: f64 = r[2] * u[2];
        var p3: f64 = r[3] * u[3];
        var e = _bj_vx_exact(r[0], u[0], p0) + _bj_vx_exact(r[1], u[1], p1) + _bj_vx_exact(r[2], u[2], p2)
        + _bj_vx_exact(r[3], u[3], p3);
        if (e == 4) { return k; }
    }
    var s0, e0 = _bj_vx_mul(r[0], u[0]);
    var s1, e1 = _bj_vx_mul(r[1], u[1]);
    var ss, se = _bj_k_ux_add(s0, e0, s1, e1);
    var s2, e2 = _bj_vx_mul(r[2], u[2]);
    var ts, te = _bj_k_ux_add(ss, se, s2, e2);
    var s3, e3 = _bj_vx_mul(r[3], u[3]);
    var ws, we = _bj_k_ux_add(ts, te, s3, e3);
    var qs, qe = _bj_k_ux_from(q);
    var w: f64 = _bj_k_ux_mul_f64(qs, qe, ws, we);
    return w;
}

# 1 when every E component c·F^{i0} of the tensor at f is its exact product (F = 0, or |E| in (2^-1022, DBL_MAX]).
#must_use
fn _bj_rel_e_exact(f: *f64): i64 {
    var c: f64 = BJ_SPEED_OF_LIGHT;
    for (var k = 4; k <= 12; k = k + 4) {
        var fk: f64 = f[k];
        var ek: f64 = fk * c;
        if (_bj_vx_exact(fk, c, ek) == 0) { return 0; }
    }
    return 1;
}

# 1 when the six field components of the tensor at f are finite.
#must_use
fn _bj_rel_fields_finite(f: *f64): i64 {
    if (_bj_vx_finite4(f[4], f[8], f[12], f[14]) == 1 && _bj_vx_finite4(f[7], f[9], 0.0, 0.0) == 1) { return 1; }
    return 0;
}

# 2(B² − E²/c²) at a range edge for the tensor at f: E = c·F^{i0}, E², B², E²/c² and their difference to 53 bits with
# an unbounded exponent, the doubling rounded once; Rust's i for a non-finite component.
#must_use
fn _bj_rel_inv1_edge(f: *f64, i: f64): f64 {
    if (_bj_rel_fields_finite(f) == 0) { return i; }
    var c: f64 = BJ_SPEED_OF_LIGHT;
    var c2: f64 = BJ_SPEED_OF_LIGHT_SQ;
    var xs, xe = _bj_vx_mul(f[4], c);
    var ys, ye = _bj_vx_mul(f[8], c);
    var zs, ze = _bj_vx_mul(f[12], c);
    var x2s, x2e = _bj_k_ux_mul(xs, xe, xs, xe);
    var y2s, y2e = _bj_k_ux_mul(ys, ye, ys, ye);
    var z2s, z2e = _bj_k_ux_mul(zs, ze, zs, ze);
    var es, ee = _bj_k_ux_add(x2s, x2e, y2s, y2e);
    var e2s, e2e = _bj_k_ux_add(es, ee, z2s, z2e);
    var bs, be = _bj_vx_sumsq(f[14], f[7], f[9]);
    var cs, ce = _bj_k_ux_from(c2);
    var qs, qe = _bj_k_ux_div(e2s, e2e, cs, ce);
    var ds, de = _bj_k_ux_sub(bs, be, qs, qe);
    var u: f64 = _bj_k_ux_mul_f64(1.0, 1, ds, de);
    return u;
}

# −E⋅B/c at a range edge for the tensor at f: E = c·F^{i0}, its products with B and their sums to 53 bits with an
# unbounded exponent, the quotient by c rounded once; Rust's i for a non-finite component.
#must_use
fn _bj_rel_inv2_edge(f: *f64, i: f64): f64 {
    if (_bj_rel_fields_finite(f) == 0) { return i; }
    var c: f64 = BJ_SPEED_OF_LIGHT;
    var xs, xe = _bj_vx_mul(f[4], c);
    var ys, ye = _bj_vx_mul(f[8], c);
    var zs, ze = _bj_vx_mul(f[12], c);
    var bxs, bxe = _bj_k_ux_from(f[14]);
    var bys, bye = _bj_k_ux_from(f[7]);
    var bzs, bze = _bj_k_ux_from(f[9]);
    var p0s, p0e = _bj_k_ux_mul(xs, xe, bxs, bxe);
    var p1s, p1e = _bj_k_ux_mul(ys, ye, bys, bye);
    var p2s, p2e = _bj_k_ux_mul(zs, ze, bzs, bze);
    var ss, se = _bj_k_ux_add(p0s, p0e, p1s, p1e);
    var ts, te = _bj_k_ux_add(ss, se, p2s, p2e);
    var nts: f64 = -ts;
    var cs, ce = _bj_k_ux_from(c);
    var u: f64 = _bj_k_ux_div_f64(nts, te, cs, ce);
    return u;
}

# 2^-300 as an f64: the transforms' box's lower bound for a scalar (a speed lies below c, far inside the upper one).
var _BJ_REL_BOX_LO: f64 = 0x2D30000000000000;

# The transforms' box on the BjFieldVector parts at the byte addresses e, b and v (untyped: a typed pointer would cost
# a conversion call on the hot path): each part ±0 or of biased exponent in [723, 1923], i.e. |x| in [2^-300, 2^901),
# on the bit patterns with the sign cleared (a NaN or ±∞ lies above the bound). Straight-line integer tests, one
# helper per caller: on the pinned compiler a call per part, a loop or extra parameters cost more than the margin.
#must_use
fn _bj_rel_box_tf(e, b, v): i64 {
    var m = 0x7FFFFFFFFFFFFFFF;
    var lo = 723 << 52;
    var hi = 1924 << 52;
    var u = 0;
    u = load64(e) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(e + 8) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(e + 16) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(b) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(b + 8) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(b + 16) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(v) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(v + 8) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(v + 16) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    return 1;
}

# lorentz_transform_x's box: the y and z parts of E and B at the byte addresses e and b, the ones it computes with
# (E_x and B_x pass unchanged), tested as _bj_rel_box_tf does; the speed is the caller's (an f64 compare).
#must_use
fn _bj_rel_box_tx(e, b): i64 {
    var m = 0x7FFFFFFFFFFFFFFF;
    var lo = 723 << 52;
    var hi = 1924 << 52;
    var u = 0;
    u = load64(e + 8) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(e + 16) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(b + 8) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(b + 16) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    return 1;
}

# The Larmor power's box on the BjFieldVector parts at the byte addresses v and a: the acceleration's parts in
# [2^-200, 2^481), the velocity's at least 2^-200 (each ±0 allowed), tested as _bj_rel_box_tf does; the charge is the
# caller's (an f64 compare).
#must_use
fn _bj_rel_box_lar(v, a): i64 {
    var m = 0x7FFFFFFFFFFFFFFF;
    var lo = 823 << 52;
    var ha = 1504 << 52;
    var hv = 2047 << 52;
    var u = 0;
    u = load64(a) & m;
    if (u != 0 && (u < lo || u >= ha)) { return 0; }
    u = load64(a + 8) & m;
    if (u != 0 && (u < lo || u >= ha)) { return 0; }
    u = load64(a + 16) & m;
    if (u != 0 && (u < lo || u >= ha)) { return 0; }
    u = load64(v) & m;
    if (u != 0 && (u < lo || u >= hv)) { return 0; }
    u = load64(v + 8) & m;
    if (u != 0 && (u < lo || u >= hv)) { return 0; }
    u = load64(v + 16) & m;
    if (u != 0 && (u < lo || u >= hv)) { return 0; }
    return 1;
}

# 2^-200 and 2^401 as f64s: the Larmor power's bounds on the charge.
var _BJ_REL_LAR_QLO: f64 = 0x3370000000000000;
var _BJ_REL_LAR_QHI: f64 = 0x5900000000000000;

# 1 when none of the n doubles at p is NaN or infinite.
#must_use
fn _bj_rel_finite_n(p: *f64, n): i64 {
    for (var k = 0; k < n; k = k + 1) {
        var x: f64 = p[k];
        var d: f64 = x - x;
        if (d != 0.0) { return 0; }
    }
    return 1;
}

# a⋅b = (a₀b₀ + a₁b₁) + a₂b₂ to 53 bits with an unbounded exponent: (s, e).
#must_use
fn _bj_rel_dot3_ux(a: *f64, b: *f64): (f64, i64) {
    var s0, e0 = _bj_vx_mul(a[0], b[0]);
    var s1, e1 = _bj_vx_mul(a[1], b[1]);
    var ss, se = _bj_k_ux_add(s0, e0, s1, e1);
    var s2, e2 = _bj_vx_mul(a[2], b[2]);
    var ts, te = _bj_k_ux_add(ss, se, s2, e2);
    return (ts, te);
}

# Component i of (a × b)·…: a_j b_k − a_k b_j to 53 bits with an unbounded exponent, for i = 0, 1, 2 (j, k cyclic).
#must_use
fn _bj_rel_cross_ux(a: *f64, b: *f64, i): (f64, i64) {
    var j = (i + 1) % 3;
    var k = (i + 2) % 3;
    var s, e = _bj_vx_cross1(a[j], b[k], a[k], b[j]);
    return (s, e);
}

# Jackson's E' and B' (bj_lorentz_transform_fields' chain) with an unbounded exponent, into e_out and b_out: every
# step to 53 bits, each output's last difference rounded once (ADR 0002 row 18's rule, M2 part 2d-3c's section, part
# 2d-3d). γ is the correctly rounded double; γ + 1, (γ + 1)c², γ² and k run unbounded too.
fn _bj_rel_ltf_edge(e: *f64, b: *f64, v: *f64, gamma: f64, e_out: *f64, b_out: *f64) {
    var c2: f64 = BJ_SPEED_OF_LIGHT_SQ;
    var inv: f64 = 1.0 / c2;
    var gs, ge = _bj_k_ux_from(gamma);
    var g1s, g1e = _bj_k_ux_add(gs, ge, 1.0, 0);
    var cs, ce = _bj_k_ux_from(c2);
    var dns, dne = _bj_k_ux_mul(g1s, g1e, cs, ce);
    var ggs, gge = _bj_k_ux_mul(gs, ge, gs, ge);
    var ks, ke = _bj_k_ux_div(ggs, gge, dns, dne);
    var des, dee = _bj_rel_dot3_ux(v, e);
    var kes, kee = _bj_k_ux_mul(ks, ke, des, dee);
    var dbs, dbe = _bj_rel_dot3_ux(v, b);
    var kbs, kbe = _bj_k_ux_mul(ks, ke, dbs, dbe);
    var is1, ie1 = _bj_k_ux_from(inv);
    for (var i = 0; i < 3; i = i + 1) {
        var xs, xe = _bj_rel_cross_ux(v, b, i);
        var es, ee = _bj_k_ux_from(e[i]);
        var s1s, s1e = _bj_k_ux_add(es, ee, xs, xe);
        var s1gs, s1ge = _bj_k_ux_mul(s1s, s1e, gs, ge);
        var vs, ve = _bj_k_ux_from(v[i]);
        var t1s, t1e = _bj_k_ux_mul(vs, ve, kes, kee);
        var ep: f64 = _bj_k_ux_sub_f64(s1gs, s1ge, t1s, t1e);
        e_out[i] = ep;
        var ys, ye = _bj_rel_cross_ux(v, e, i);
        var qs, qe = _bj_k_ux_mul(ys, ye, is1, ie1);
        var bs, be = _bj_k_ux_from(b[i]);
        var s2s, s2e = _bj_k_ux_sub(bs, be, qs, qe);
        var s2gs, s2ge = _bj_k_ux_mul(s2s, s2e, gs, ge);
        var t2s, t2e = _bj_k_ux_mul(vs, ve, kbs, kbe);
        var bp: f64 = _bj_k_ux_sub_f64(s2gs, s2ge, t2s, t2e);
        b_out[i] = bp;
    }
    return 0;
}

# γ(E_y − vB_z), γ(E_z + vB_y), γ(B_y + vE_z/c²) and γ(B_z − vE_y/c²) (bj_lorentz_transform_x's chain) with an
# unbounded exponent, each product by γ rounded once; E_x and B_x pass unchanged.
fn _bj_rel_ltx_edge(e: *f64, b: *f64, speed: f64, gamma: f64, e_out: *f64, b_out: *f64) {
    var c2: f64 = BJ_SPEED_OF_LIGHT_SQ;
    var gs, ge = _bj_k_ux_from(gamma);
    var cs, ce = _bj_k_ux_from(c2);
    var p1s, p1e = _bj_vx_mul(speed, b[2]);
    var y1s, y1e = _bj_k_ux_from(e[1]);
    var d1s, d1e = _bj_k_ux_sub(y1s, y1e, p1s, p1e);
    var p2s, p2e = _bj_vx_mul(speed, b[1]);
    var z1s, z1e = _bj_k_ux_from(e[2]);
    var d2s, d2e = _bj_k_ux_add(z1s, z1e, p2s, p2e);
    var p3s, p3e = _bj_vx_mul(speed, e[2]);
    var q1s, q1e = _bj_k_ux_div(p3s, p3e, cs, ce);
    var y2s, y2e = _bj_k_ux_from(b[1]);
    var d3s, d3e = _bj_k_ux_add(y2s, y2e, q1s, q1e);
    var p4s, p4e = _bj_vx_mul(speed, e[1]);
    var q2s, q2e = _bj_k_ux_div(p4s, p4e, cs, ce);
    var z2s, z2e = _bj_k_ux_from(b[2]);
    var d4s, d4e = _bj_k_ux_sub(z2s, z2e, q2s, q2e);
    var r1: f64 = _bj_k_ux_mul_f64(gs, ge, d1s, d1e);
    var r2: f64 = _bj_k_ux_mul_f64(gs, ge, d2s, d2e);
    var r3: f64 = _bj_k_ux_mul_f64(gs, ge, d3s, d3e);
    var r4: f64 = _bj_k_ux_mul_f64(gs, ge, d4s, d4e);
    e_out[0] = e[0];
    e_out[1] = r1;
    e_out[2] = r2;
    b_out[0] = b[0];
    b_out[1] = r3;
    b_out[2] = r4;
    return 0;
}

# P = (q²/(6πε₀c³))·γ⁶·(a² − |v × a|²/c²) (bj_relativistic_larmor_power's chain) with an unbounded exponent, the last
# product rounded once; 6πε₀c³ is Rust's double (a normal constant).
#must_use
fn _bj_rel_larmor_edge(charge: f64, v: *f64, a: *f64, gamma: f64, den: f64): f64 {
    var c2: f64 = BJ_SPEED_OF_LIGHT_SQ;
    var gs, ge = _bj_k_ux_from(gamma);
    var g2s, g2e = _bj_k_ux_mul(gs, ge, gs, ge);
    var g4s, g4e = _bj_k_ux_mul(g2s, g2e, g2s, g2e);
    var g6s, g6e = _bj_k_ux_mul(g4s, g4e, g2s, g2e);
    var a2s, a2e = _bj_vx_sumsq(a[0], a[1], a[2]);
    var xs, xe = _bj_rel_cross_ux(v, a, 0);
    var ys, ye = _bj_rel_cross_ux(v, a, 1);
    var zs, ze = _bj_rel_cross_ux(v, a, 2);
    var x2s, x2e = _bj_k_ux_mul(xs, xe, xs, xe);
    var y2s, y2e = _bj_k_ux_mul(ys, ye, ys, ye);
    var z2s, z2e = _bj_k_ux_mul(zs, ze, zs, ze);
    var ws, we = _bj_k_ux_add(x2s, x2e, y2s, y2e);
    var w2s, w2e = _bj_k_ux_add(ws, we, z2s, z2e);
    var qqs, qqe = _bj_vx_mul(charge, charge);
    var dns, dne = _bj_k_ux_from(den);
    var prs, pre = _bj_k_ux_div(qqs, qqe, dns, dne);
    var cs, ce = _bj_k_ux_from(c2);
    var vcs, vce = _bj_k_ux_div(w2s, w2e, cs, ce);
    var ds, de = _bj_k_ux_sub(a2s, a2e, vcs, vce);
    var pgs, pge = _bj_k_ux_mul(prs, pre, g6s, g6e);
    var u: f64 = _bj_k_ux_mul_f64(pgs, pge, ds, de);
    return u;
}

# lienard_wiechert_e's box: the parts of R, β̇ and n̂ − β at the byte addresses r, bd and nm, R's and β̇'s ±0 or in
# [2^-100, 2^201) (biased exponents [923, 1223]), n̂ − β's ±0 or at least 2^-100 (row 17 bounds them by 2): the
# bit-pattern tests of _bj_rel_box_tf. The charge and γ² are the caller's.
#must_use
fn _bj_rel_box_e(r, bd, nm): i64 {
    var m = 0x7FFFFFFFFFFFFFFF;
    var lo = 923 << 52;
    var hi = 1224 << 52;
    var u = 0;
    u = load64(r) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(r + 8) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(r + 16) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(bd) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(bd + 8) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(bd + 16) & m;
    if (u != 0 && (u < lo || u >= hi)) { return 0; }
    u = load64(nm) & m;
    if (u != 0 && u < lo) { return 0; }
    u = load64(nm + 8) & m;
    if (u != 0 && u < lo) { return 0; }
    u = load64(nm + 16) & m;
    if (u != 0 && u < lo) { return 0; }
    return 1;
}

# 2^-100 and 2^201 as f64s: the box's bounds on lienard_wiechert_e's charge.
var _BJ_REL_E_QLO: f64 = 0x39B0000000000000;
var _BJ_REL_E_QHI: f64 = 0x4C80000000000000;

# (a × b)ᵢ for pairs: a_j b_k − a_k b_j to 53 bits with an unbounded exponent, a and b three (s, e) pairs each (s at
# as[k], e at ae[k]).
#must_use
fn _bj_rel_cross_pp(as: *f64, ae: *i64, bs: *f64, be: *i64, i): (f64, i64) {
    var j = (i + 1) % 3;
    var k = (i + 2) % 3;
    var ps, pe = _bj_k_ux_mul(as[j], ae[j], bs[k], be[k]);
    var qs, qe = _bj_k_ux_mul(as[k], ae[k], bs[j], be[j]);
    var s, e = _bj_k_ux_sub(ps, pe, qs, qe);
    return (s, e);
}

# lienard_wiechert_e's tail outside its box (ADR 0002 row 18's rule, M2 part 2d-3f), on R and β̇ as 53-bit pairs (R at
# rs and re, β̇ at bs and be; M2 part 2d-3j): |R|, 1/|R|, n̂ = R/|R|, κ³, q/(4πε₀), γ²κ³R², the velocity factor,
# (n̂ − β) × β̇, n̂ × that, κ³Rc, the acceleration factor and both terms to 53 bits with an unbounded exponent. Into o
# (fifteen f64): E's parts, each sum rounded once (o[0..2]); E's 53-bit pairs (o[3..5], their exponents o[6..8]); n̂'s
# (o[9..11], o[12..14]), for lienard_wiechert_fields' B. κ, n̂ − β (row 17) and γ² (row 30) enter as the doubles their
# rows define; the cross products take Rust's order (BjFieldVector's cross).
fn _bj_rel_e_tail(charge: f64, rs: *f64, re: *i64, kappa: f64, gamma_sq: f64, nm: *f64, bs: *f64, be: *i64, o: *f64) {
    var c: f64 = BJ_SPEED_OF_LIGHT;
    var fpe: f64 = 4.0 * _BJ_PI * BJ_EPSILON_0;
    var q0s, q0e = _bj_k_ux_mul(rs[0], re[0], rs[0], re[0]);
    var q1s, q1e = _bj_k_ux_mul(rs[1], re[1], rs[1], re[1]);
    var q2s, q2e = _bj_k_ux_mul(rs[2], re[2], rs[2], re[2]);
    var s1s, s1e = _bj_k_ux_add(q0s, q0e, q1s, q1e);
    var rs2, re2 = _bj_k_ux_add(s1s, s1e, q2s, q2e);
    var ms, me = _bj_k_ux_sqrt(rs2, re2);
    var is1, ie1 = _bj_k_ux_div(1.0, 0, ms, me);
    var ns: f64[3];
    var ne: i64[3];
    var ms3: f64[3];
    var me3: i64[3];
    var ins: f64[3];
    var ine: i64[3];
    for (var i = 0; i < 3; i = i + 1) {
        var ts, te = _bj_k_ux_mul(rs[i], re[i], is1, ie1);
        ns[i] = ts;
        ne[i] = te;
        var xs, xe = _bj_k_ux_from(nm[i]);
        ms3[i] = xs;
        me3[i] = xe;
    }
    for (var i2 = 0; i2 < 3; i2 = i2 + 1) {
        var cs1, ce1 = _bj_rel_cross_pp(&ms3, &me3, bs, be, i2);
        ins[i2] = cs1;
        ine[i2] = ce1;
    }
    var ks, ke = _bj_k_ux_from(kappa);
    var k2s, k2e = _bj_k_ux_mul(ks, ke, ks, ke);
    var k3s, k3e = _bj_k_ux_mul(k2s, k2e, ks, ke);
    var qs, qe = _bj_k_ux_from(charge);
    var fs, fe = _bj_k_ux_from(fpe);
    var ps, pe = _bj_k_ux_div(qs, qe, fs, fe);
    var gs, ge = _bj_k_ux_from(gamma_sq);
    var d1s, d1e = _bj_k_ux_mul(gs, ge, k3s, k3e);
    var d2s, d2e = _bj_k_ux_mul(d1s, d1e, ms, me);
    var d3s, d3e = _bj_k_ux_mul(d2s, d2e, ms, me);
    var fvs, fve = _bj_k_ux_div(ps, pe, d3s, d3e);
    var a1s, a1e = _bj_k_ux_mul(k3s, k3e, ms, me);
    var cs, ce = _bj_k_ux_from(c);
    var a2s, a2e = _bj_k_ux_mul(a1s, a1e, cs, ce);
    var fas, fae = _bj_k_ux_div(ps, pe, a2s, a2e);
    for (var j = 0; j < 3; j = j + 1) {
        var vts, vte = _bj_k_ux_mul(ms3[j], me3[j], fvs, fve);
        var os, oe = _bj_rel_cross_pp(&ns, &ne, &ins, &ine, j);
        var ats, ate = _bj_k_ux_mul(os, oe, fas, fae);
        var ej: f64 = _bj_k_ux_add_f64(vts, vte, ats, ate);
        var es, ee = _bj_k_ux_add(vts, vte, ats, ate);
        o[j] = ej;
        o[3 + j] = es;
        o[6 + j] = f64_from(ee);
        o[9 + j] = ns[j];
        o[12 + j] = f64_from(ne[j]);
    }
    return 0;
}

# ── the electromagnetic tensor ───────────────────────────────────────────────────────────────────────────────────

# F^μν of (E, B): F^{i0} = Eᵢ/c, F^{0i} = −Eᵢ/c, F^{12} = −B_z, F^{13} = B_y, F^{23} = −B_x and their negatives below
# the diagonal. Mirrors `EmTensor::from_fields`.
#must_use
public fn BjEmTensor_from_fields(e: BjFieldVector, b: BjFieldVector): BjEmTensor {
    var t: BjEmTensor;
    var p: *f64 = _bj_rel_f64p(&t);
    var ex: f64 = e.x / BJ_SPEED_OF_LIGHT;
    var ey: f64 = e.y / BJ_SPEED_OF_LIGHT;
    var ez: f64 = e.z / BJ_SPEED_OF_LIGHT;
    var bx: f64 = b.x;
    var by: f64 = b.y;
    var bz: f64 = b.z;
    p[0] = 0.0;
    p[1] = -ex;
    p[2] = -ey;
    p[3] = -ez;
    p[4] = ex;
    p[5] = 0.0;
    p[6] = -bz;
    p[7] = by;
    p[8] = ey;
    p[9] = bz;
    p[10] = 0.0;
    p[11] = -bx;
    p[12] = ez;
    p[13] = -by;
    p[14] = bx;
    p[15] = 0.0;
    return t;
}

# A tensor of sixteen components from p, row-major (for `EmTensor { components }`, whose field is public in Rust).
#must_use
public fn BjEmTensor_from_components(p: *f64): BjEmTensor {
    var t: BjEmTensor;
    var q: *f64 = _bj_rel_f64p(&t);
    for (var k = 0; k < 16; k = k + 1) { q[k] = p[k]; }
    return t;
}

impl BjEmTensor {
    # E = c·(F^{10}, F^{20}, F^{30}). Mirrors `EmTensor::electric_field`.
    #must_use
    public fn electric_field(self): BjFieldVector {
        var p: *f64 = _bj_rel_f64p(self);
        var x: f64 = p[4] * BJ_SPEED_OF_LIGHT;
        var y: f64 = p[8] * BJ_SPEED_OF_LIGHT;
        var z: f64 = p[12] * BJ_SPEED_OF_LIGHT;
        var e: BjFieldVector = BjFieldVector_new(x, y, z);
        return e;
    }

    # B = (F^{32}, F^{13}, F^{21}). Mirrors `EmTensor::magnetic_field`.
    #must_use
    public fn magnetic_field(self): BjFieldVector {
        var p: *f64 = _bj_rel_f64p(self);
        var x: f64 = p[14];
        var y: f64 = p[7];
        var z: f64 = p[9];
        var b: BjFieldVector = BjFieldVector_new(x, y, z);
        return b;
    }

    # F_μν F^μν = 2(B² − E²/c²), the first Lorentz invariant. Mirrors `EmTensor::first_invariant`.
    #must_use
    public fn first_invariant(self): f64 {
        var e: BjFieldVector = self.electric_field();
        var b: BjFieldVector = self.magnetic_field();
        var b2: f64 = b.magnitude_sq();
        var e2: f64 = e.magnitude_sq();
        var ec: f64 = e2 / BJ_SPEED_OF_LIGHT_SQ;
        var d: f64 = b2 - ec;
        var i: f64 = 2.0 * d;
        var ad: f64 = f64_abs(d);
        if (ad >= _BJ_VX_LO && ad <= _BJ_VX_HI) { return i; }
        var u: f64 = _bj_rel_inv1_edge(_bj_rel_f64p(self), i);
        return u;
    }

    # ε_μνρσ F^μν F^ρσ/8 = −E⋅B/c, the second invariant (ε^{0123} = +1, Jackson's): 0 for radiation fields. Mirrors
    # `EmTensor::second_invariant`.
    #must_use
    public fn second_invariant(self): f64 {
        var e: BjFieldVector = self.electric_field();
        var b: BjFieldVector = self.magnetic_field();
        var d: f64 = e.dot(b);
        var nd: f64 = -d;
        var i: f64 = nd / BJ_SPEED_OF_LIGHT;
        var ad: f64 = f64_abs(d);
        var f: *f64 = _bj_rel_f64p(self);
        if (ad > _BJ_VX_MN && ad <= _BJ_VX_HI && _bj_rel_e_exact(f) == 1) { return i; }
        var u: f64 = _bj_rel_inv2_edge(f, i);
        return u;
    }

    # The dual *F^μν, E → cB and B → −E/c, rounded once (ADR 0002 row 13): its components (cB)/c = B and
    # −(cF^{i0})/c = −F^{i0} are F's own, exactly, where Rust's ×c then ÷c rounded twice and overflowed past DBL_MAX/c;
    # a non-finite component keeps Rust's chain. Mirrors `EmTensor::dual`.
    #must_use
    public fn dual(self): BjEmTensor {
        var f: *f64 = _bj_rel_f64p(self);
        var bx: f64 = f[14];                        # B = (F^{32}, F^{13}, F^{21}); E/c = (F^{10}, F^{20}, F^{30})
        var by: f64 = f[7];
        var bz: f64 = f[9];
        var ex: f64 = f[4];
        var ey: f64 = f[8];
        var ez: f64 = f[12];
        var all = _bj_is_finite(bx) + _bj_is_finite(by) + _bj_is_finite(bz) + _bj_is_finite(ex) + _bj_is_finite(ey)
        + _bj_is_finite(ez);
        if (all == 6) {                             # every component F's own: no arithmetic
            var t: BjEmTensor;
            var q: *f64 = _bj_rel_f64p(&t);
            var nbx: f64 = -bx;
            var nby: f64 = -by;
            var nbz: f64 = -bz;
            var nex: f64 = -ex;
            var ney: f64 = -ey;
            var nez: f64 = -ez;
            q[0] = 0.0;
            q[1] = nbx;
            q[2] = nby;
            q[3] = nbz;
            q[4] = bx;
            q[5] = 0.0;
            q[6] = ez;
            q[7] = ney;
            q[8] = by;
            q[9] = nez;
            q[10] = 0.0;
            q[11] = ex;
            q[12] = bz;
            q[13] = ey;
            q[14] = nex;
            q[15] = 0.0;
            return t;
        }
        var e: BjFieldVector = self.electric_field();
        var b: BjFieldVector = self.magnetic_field();
        var e_dual: BjFieldVector = b.scale(BJ_SPEED_OF_LIGHT);
        var inv: f64 = 1.0 / BJ_SPEED_OF_LIGHT;
        var ninv: f64 = -inv;
        var b_dual: BjFieldVector = e.scale(ninv);
        var d: BjEmTensor = BjEmTensor_from_fields(e_dual, b_dual);
        var g: *f64 = _bj_rel_f64p(&d);
        _bj_rel_dual_put(g, 1, bx, 0 - 1);
        _bj_rel_dual_put(g, 2, by, 0 - 1);
        _bj_rel_dual_put(g, 3, bz, 0 - 1);
        _bj_rel_dual_put(g, 4, bx, 1);
        _bj_rel_dual_put(g, 8, by, 1);
        _bj_rel_dual_put(g, 12, bz, 1);
        _bj_rel_dual_put(g, 6, ez, 1);
        _bj_rel_dual_put(g, 7, ey, 0 - 1);
        _bj_rel_dual_put(g, 9, ez, 0 - 1);
        _bj_rel_dual_put(g, 11, ex, 1);
        _bj_rel_dual_put(g, 13, ey, 1);
        _bj_rel_dual_put(g, 14, ex, 0 - 1);
        return d;
    }

    # K^μ = q F^μν g_νλ u^λ = (γq E⋅v/c, γq(E + v × B)) (N), the Lorentz four-force on a charge with four-velocity
    # u = γ(c, v): q (F^{μ0}u⁰ − F^{μ1}u¹ − F^{μ2}u² − F^{μ3}u³). Mirrors `EmTensor::four_force`.
    #must_use
    public fn four_force(self, charge: f64, four_velocity: BjFourVector): BjFourVector {
        var p: *f64 = _bj_rel_f64p(self);
        var u0: f64 = four_velocity.t;
        var u1: f64 = -four_velocity.x;
        var u2: f64 = -four_velocity.y;
        var u3: f64 = -four_velocity.z;
        var k: f64[4];
        var ul: f64[4];
        ul[0] = u0;
        ul[1] = u1;
        ul[2] = u2;
        ul[3] = u3;
        for (var i = 0; i < 4; i = i + 1) {
            var r0: f64 = p[4 * i];
            var r1: f64 = p[4 * i + 1];
            var r2: f64 = p[4 * i + 2];
            var r3: f64 = p[4 * i + 3];
            var s: f64 = r0 * u0 + r1 * u1 + r2 * u2 + r3 * u3;
            k[i] = charge * s;
            var as2: f64 = f64_abs(s);
            if (!(as2 >= _BJ_VX_LO && as2 <= _BJ_VX_HI)) { k[i] = _bj_rel_ff_edge(p + 4 * i, &ul, charge, s); }
        }
        var f: BjFourVector = BjFourVector_new(k[0], k[1], k[2], k[3]);
        return f;
    }

    # 1 when every component equals o's (IEEE: −0 equals +0, NaN equals nothing). Mirrors the derived `PartialEq`.
    #must_use
    public fn eq(self, o: BjEmTensor): i64 {
        var p: *f64 = _bj_rel_f64p(self);
        var q: *f64 = _bj_rel_f64p(&o);
        for (var k = 0; k < 16; k = k + 1) {
            var a: f64 = p[k];
            var b: f64 = q[k];
            if (!(a == b)) { return 0; }
        }
        return 1;
    }
}

# ── the Lorentz transformation of fields ─────────────────────────────────────────────────────────────────────────

# (E', B') in a frame moving with velocity v, into e_out and b_out, in Jackson's normalization-free form (eq. 11.149):
# E' = γ(E + v × B) − γ²/(γ + 1)·(v⋅E)v/c² and B' = γ(B − v × E/c²) − γ²/(γ + 1)·(v⋅B)v/c², exact for any small v ≠ 0.
# γ is correctly rounded from the exact c² − |v|² (ADR 0002 row 30). InvalidParameter "boost velocity must be less than
# c" unless |v| < c exactly (a NaN part refused); the outs untouched. Mirrors `relativity::lorentz_transform_fields`.
public fn bj_lorentz_transform_fields(e: BjFieldVector, b: BjFieldVector, velocity: BjFieldVector,
  e_out: *BjFieldVector, b_out: *BjFieldVector): Result {
    var vp: f64[3];
    _bj_rel_parts(velocity, &vp);
    var g: f64[1];
    if (_bj_cr_lorentz(&vp, 0, 3, BJ_SPEED_OF_LIGHT, 0, 0, &g) == 0) {
        return Err(_bj_err_invalid_parameter("boost velocity must be less than c"));
    }
    var gamma: f64 = g[0];
    var g1: f64 = gamma + 1.0;
    var den: f64 = g1 * BJ_SPEED_OF_LIGHT_SQ;
    var gg: f64 = gamma * gamma;
    var k: f64 = gg / den;
    var vxb: BjFieldVector = velocity.cross(b);
    var s1: BjFieldVector = BjFieldVector_add(e, vxb);
    var s1g: BjFieldVector = BjFieldVector_mul(s1, gamma);
    var vde: f64 = velocity.dot(e);
    var ke: f64 = k * vde;
    var t1: BjFieldVector = velocity.scale(ke);
    var ep: BjFieldVector = BjFieldVector_sub(s1g, t1);
    var vxe: BjFieldVector = velocity.cross(e);
    var inv: f64 = 1.0 / BJ_SPEED_OF_LIGHT_SQ;
    var vxes: BjFieldVector = vxe.scale(inv);
    var s2: BjFieldVector = BjFieldVector_sub(b, vxes);
    var s2g: BjFieldVector = BjFieldVector_mul(s2, gamma);
    var vdb: f64 = velocity.dot(b);
    var kb: f64 = k * vdb;
    var t2: BjFieldVector = velocity.scale(kb);
    var bp: BjFieldVector = BjFieldVector_sub(s2g, t2);
    var outside = 1;
    if (gamma < 134217728.0) { outside = 1 - _bj_rel_box_tf(&e, &b, &velocity); }
    if (outside == 1) {
        var pe: *f64 = _bj_rel_f64p(&e);
        var pb: *f64 = _bj_rel_f64p(&b);
        var pv: *f64 = _bj_rel_f64p(&velocity);
        if (_bj_rel_finite_n(pe, 3) + _bj_rel_finite_n(pb, 3) + _bj_rel_finite_n(pv, 3) == 3) {
            _bj_rel_ltf_edge(pe, pb, pv, gamma, _bj_rel_f64p(e_out), _bj_rel_f64p(b_out));
            return Ok(0);
        }
    }
    e_out.x = ep.x;
    e_out.y = ep.y;
    e_out.z = ep.z;
    b_out.x = bp.x;
    b_out.y = bp.y;
    b_out.z = bp.z;
    return Ok(0);
}

# (E', B') for a boost of speed v along x, into e_out and b_out: E'_x = E_x, E'_y = γ(E_y − vB_z), E'_z = γ(E_z + vB_y);
# B'_x = B_x, B'_y = γ(B_y + vE_z/c²), B'_z = γ(B_z − vE_y/c²). bj_lorentz_factor's error, the outs untouched. Mirrors
# `relativity::lorentz_transform_x`.
public fn bj_lorentz_transform_x(e: BjFieldVector, b: BjFieldVector, speed: f64, e_out: *BjFieldVector,
  b_out: *BjFieldVector): Result {
    var tg, vg = bj_lorentz_factor(speed);
    if (is_err_result(tg) == 1) { return Err(vg); }
    var gamma: f64 = vg;
    var ex: f64 = e.x;
    var ey: f64 = e.y;
    var ez: f64 = e.z;
    var bx: f64 = b.x;
    var by: f64 = b.y;
    var bz: f64 = b.z;
    var sbz: f64 = speed * bz;
    var sby: f64 = speed * by;
    var d1: f64 = ey - sbz;
    var d2: f64 = ez + sby;
    var sez: f64 = speed * ez;
    var sey: f64 = speed * ey;
    var q1: f64 = sez / BJ_SPEED_OF_LIGHT_SQ;
    var q2: f64 = sey / BJ_SPEED_OF_LIGHT_SQ;
    var d3: f64 = by + q1;
    var d4: f64 = bz - q2;
    var e1: f64 = gamma * d1;
    var e2: f64 = gamma * d2;
    var b1: f64 = gamma * d3;
    var b2: f64 = gamma * d4;
    var asp: f64 = f64_abs(speed);
    if (!(asp >= _BJ_REL_BOX_LO || speed == 0.0) || _bj_rel_box_tx(&e, &b) == 0) {
        var pe: *f64 = _bj_rel_f64p(&e);
        var pb: *f64 = _bj_rel_f64p(&b);
        if (_bj_rel_finite_n(pe, 3) + _bj_rel_finite_n(pb, 3) == 2) {
            _bj_rel_ltx_edge(pe, pb, speed, gamma, _bj_rel_f64p(e_out), _bj_rel_f64p(b_out));
            return Ok(0);
        }
    }
    e_out.x = ex;
    e_out.y = e1;
    e_out.z = e2;
    b_out.x = bx;
    b_out.y = b1;
    b_out.z = b2;
    return Ok(0);
}

# ── four-vectors ─────────────────────────────────────────────────────────────────────────────────────────────────

# (ct, x, y, z). Mirrors `FourVector::new`.
#must_use
#pure
public fn BjFourVector_new(ct: f64, x: f64, y: f64, z: f64): BjFourVector {
    var v: BjFourVector;
    v.t = ct;
    v.x = x;
    v.y = y;
    v.z = z;
    return v;
}

# The four-position (c·time, pos[0], pos[1], pos[2]). Mirrors `FourVector::from_time_position`.
#must_use
public fn BjFourVector_from_time_position(time: f64, pos: *f64): BjFourVector {
    var ct: f64 = BJ_SPEED_OF_LIGHT * time;
    var v: BjFourVector = BjFourVector_new(ct, pos[0], pos[1], pos[2]);
    return v;
}

impl BjFourVector {
    # η_μν A^μ B^ν = −A⁰B⁰ + A¹B¹ + A²B² + A³B³. Mirrors `FourVector::dot`.
    #must_use
    public fn dot(self, other: BjFourVector): f64 {
        var t: f64 = self.t;
        var nt: f64 = -t;
        var x: f64 = self.x;
        var y: f64 = self.y;
        var z: f64 = self.z;
        var d: f64 = nt * other.t + x * other.x + y * other.y + z * other.z;
        var ad: f64 = f64_abs(d);
        if (ad >= _BJ_VX_LO && ad <= _BJ_VX_HI) { return d; }
        var u: f64 = _bj_rel_dot4_edge(_bj_rel_f64p(self), _bj_rel_f64p(&other), d);
        return u;
    }

    # s² = −(ct)² + x² + y² + z². Mirrors `FourVector::interval_sq`.
    #must_use
    public fn interval_sq(self): f64 {
        var t: f64 = self.t;
        var nt: f64 = -t;
        var x: f64 = self.x;
        var y: f64 = self.y;
        var z: f64 = self.z;
        var s: f64 = nt * t + x * x + y * y + z * z;
        var as2: f64 = f64_abs(s);
        if (as2 >= _BJ_VX_LO && as2 <= _BJ_VX_HI) { return s; }
        var sp: *f64 = _bj_rel_f64p(self);
        var u: f64 = _bj_rel_dot4_edge(sp, sp, s);
        return u;
    }

    # √(x² + y² + z²). Mirrors `FourVector::spatial_magnitude`.
    #must_use
    public fn spatial_magnitude(self): f64 {
        var x: f64 = self.x;
        var y: f64 = self.y;
        var z: f64 = self.z;
        var s: f64 = x * x + y * y + z * z;
        if ((s >= _BJ_VX_LO && s <= _BJ_VX_HI) || _bj_vx_sumsq_plain(x, y, z, s) == 1) {
            var m: f64 = f64_sqrt(s);
            return m;
        }
        var us, ue = _bj_vx_sumsq(x, y, z);         # BjFieldVector.magnitude's edge
        var u: f64 = _bj_k_ux_sqrt_f64(us, ue);
        return u;
    }

    # The boost of speed v along x, into out: ct' = γ(ct − βx), x' = γ(x − β·ct). bj_lorentz_factor's error, out
    # untouched. Mirrors `FourVector::boost_x`.
    public fn boost_x(self, speed: f64, out: *BjFourVector): Result {
        var tg, vg = bj_lorentz_factor(speed);
        if (is_err_result(tg) == 1) { return Err(vg); }
        var gamma: f64 = vg;
        var b: f64 = speed / BJ_SPEED_OF_LIGHT;
        var t: f64 = self.t;
        var x: f64 = self.x;
        var bx: f64 = b * x;
        var bt: f64 = b * t;
        var d1: f64 = t - bx;
        var d2: f64 = x - bt;
        var t2: f64 = gamma * d1;
        var x2: f64 = gamma * d2;
        var ab: f64 = f64_abs(b);
        var a1: f64 = f64_abs(d1);
        var a2: f64 = f64_abs(d2);
        if (!(ab > _BJ_VX_MN && a1 >= _BJ_VX_LO && a1 <= _BJ_VX_HI && a2 >= _BJ_VX_LO && a2 <= _BJ_VX_HI)) {
            t2 = _bj_rel_boost_edge(gamma, speed, t, x, d1);
            x2 = _bj_rel_boost_edge(gamma, speed, x, t, d2);
        }
        out.t = t2;
        out.x = x2;
        out.y = self.y;
        out.z = self.z;
        return Ok(0);
    }

    # 1 when every component equals o's (IEEE). Mirrors the derived `PartialEq`.
    #must_use
    public fn eq(self, o: BjFourVector): i64 {
        var t: f64 = self.t;
        var x: f64 = self.x;
        var y: f64 = self.y;
        var z: f64 = self.z;
        if (t == o.t && x == o.x && y == o.y && z == o.z) { return 1; }
        return 0;
    }
}

# ── retarded and Liénard–Wiechert potentials ─────────────────────────────────────────────────────────────────────

# φ = q/(4πε₀R_eff) (V), R_eff the Liénard–Wiechert effective distance |R| − R⋅β at the retarded time (for a charge at
# rest |R|, and this is Coulomb's potential), correctly rounded (ADR 0002 row 13; a non-finite q or R_eff keeps Rust's
# q/(4π·ε₀·R_eff)). The radial distance's errors (InvalidParameter when negative or NaN, Singularity below 1e-30).
# Mirrors `relativity::retarded_scalar_potential`.
public fn bj_retarded_scalar_potential(charge: f64, retarded_distance: f64): Result {
    var tc, vc = _bj_check_radial_distance(retarded_distance);
    if (is_err_result(tc) == 1) { return Err(vc); }
    var fp: f64 = 4.0 * _BJ_PI;
    if (_bj_is_finite(charge) == 0 || _bj_is_finite(retarded_distance) == 0) {
        var d: f64 = fp * BJ_EPSILON_0 * retarded_distance;
        var phi: f64 = charge / d;
        return Ok(phi);
    }
    var cr: f64 = _bj_k_cr_div3(charge, fp, BJ_EPSILON_0, retarded_distance);
    return Ok(cr);
}

# A = μ₀qv/(4πR_eff) (T⋅m) into out, v and R_eff at the retarded time, each part correctly rounded (ADR 0002 row 13; a
# non-finite q or R_eff keeps Rust's v·(μ₀q/(4πR_eff)), and a non-finite part its own). As
# bj_retarded_scalar_potential, out untouched on an error. Mirrors `relativity::retarded_vector_potential`.
public fn bj_retarded_vector_potential(charge: f64, velocity: BjFieldVector, retarded_distance: f64,
  out: *BjFieldVector): Result {
    var tc, vc = _bj_check_radial_distance(retarded_distance);
    if (is_err_result(tc) == 1) { return Err(vc); }
    var num: f64 = BJ_MU_0 * charge;
    var fp: f64 = 4.0 * _BJ_PI;
    var den: f64 = fp * retarded_distance;
    var k: f64 = num / den;
    var a: BjFieldVector = velocity.scale(k);
    if (_bj_is_finite(charge) == 1 && _bj_is_finite(retarded_distance) == 1) {
        var vp: f64[3];
        _bj_rel_parts(velocity, &vp);
        var ap: f64[3];
        for (var i = 0; i < 3; i = i + 1) {
            var vi: f64 = vp[i];
            var ai: f64 = vi * k;
            if (_bj_is_finite(vi) == 1) { ai = _bj_k_cr_mul3_div2(BJ_MU_0, charge, vi, fp, retarded_distance); }
            ap[i] = ai;
        }
        a = BjFieldVector_new(ap[0], ap[1], ap[2]);
    }
    out.x = a.x;
    out.y = a.y;
    out.z = a.z;
    return Ok(0);
}

# R_eff = |R| − R⋅β (> 0 for |β| < 1): InvalidParameter "R vector must not contain NaN", Singularity for
# |R| < 10^-30 exactly (row 17's rule), InvalidParameter "β must be < 1" unless |β| < 1 exactly (a NaN part refused;
# ADR 0002 row 30). For a finite R, R_eff is rounded once from the exact S and P (src/crmath_edge.cyr; ADR 0002 row
# 17, M2 part 2c-4), where Rust's difference cancelled as n̂⋅β → 1; an ∞ part keeps Rust's |R| − R⋅β.
fn _bj_rel_effective_distance(r_vec: BjFieldVector, beta_vec: BjFieldVector): Result {
    var r_mag: f64 = r_vec.magnitude();
    if (r_mag != r_mag) { return Err(_bj_err_invalid_parameter("R vector must not contain NaN")); }
    if (_bj_vx_finite4(r_vec.x, r_vec.y, r_vec.z, 0.0) == 0) {
        return Err(_bj_err_invalid_parameter("R vector must be finite"));
    }
    if (r_mag < 0.0000000000000000000000000000005) { return Err(_bj_err_singularity()); }
    if (r_mag <= 0.000000000000000000000000000002 && _bj_rel_r_below(r_vec, r_mag) == 1) {
        return Err(_bj_err_singularity());
    }
    var bp: f64[3];
    _bj_rel_parts(beta_vec, &bp);
    if (_bj_cr_lorentz_ok(&bp, 3, 1.0) == 0) { return Err(_bj_err_invalid_parameter("β must be < 1")); }
    var rp: f64[3];
    _bj_rel_parts(r_vec, &rp);
    var o: f64[1];
    var z = _bj_cr_lw(&rp, &bp, 0, 0, 0, &o);
    var re: f64 = o[0];
    return Ok(re);
}

# R_eff = |R| − R⋅β to 53 bits with an unbounded exponent (src/crmath_edge.cyr's _bj_cr_lw, mode 3), for a finite R the
# effective-distance checks passed: (s, e). The potentials' range edge, an R_eff past DBL_MAX (M2 part 2d-3e).
#must_use
fn _bj_rel_reff_ux(r_vec: BjFieldVector, beta_vec: BjFieldVector): (f64, i64) {
    var rp: f64[3];
    var bp: f64[3];
    _bj_rel_parts(r_vec, &rp);
    _bj_rel_parts(beta_vec, &bp);
    var o: f64[2];
    var z = _bj_cr_lw(&rp, &bp, 0, 3, 0, &o);
    var y: f64 = o[0];
    var kf: f64 = o[1];
    var ys, ye = _bj_k_ux_from(y);
    return (ys, ye + f64_to(kf));
}

# φ = q/(4πε₀(|R| − R⋅β)) (V), the Liénard–Wiechert scalar potential (Griffiths 10.46, Jackson 14.8): R = r − r'(t_r)
# from the retarded position to the field point, β = v(t_r)/c. Singularity for R = 0; InvalidParameter for |β| ≥ 1 or
# a NaN input, and for an R with an infinite part ("R vector must be finite": ADR 0002 row 27, amended in M2 part 2d-3e
# on the user's answer of 2026-11-13; Rust went on to NaN). An R_eff past DBL_MAX runs to 53 bits with an unbounded
# exponent and φ rounds once (row 18's rule). Mirrors `relativity::lienard_wiechert_scalar_potential`.
public fn bj_lienard_wiechert_scalar_potential(charge: f64, r_vec: BjFieldVector, beta_vec: BjFieldVector): Result {
    var t, v = _bj_rel_effective_distance(r_vec, beta_vec);
    if (is_err_result(t) == 1) { return Err(v); }
    var r_eff: f64 = v;
    var d: f64 = 4.0 * _BJ_PI * BJ_EPSILON_0 * r_eff;
    var phi: f64 = charge / d;
    if (r_eff <= _BJ_VX_HI || _bj_is_finite(charge) == 0) { return Ok(phi); }
    # R_eff past DBL_MAX (row 18's rule, M2 part 2d-3e): R_eff, 4πε₀R_eff to 53 bits, the quotient rounded once.
    var rs, re = _bj_rel_reff_ux(r_vec, beta_vec);
    var fpe: f64 = 4.0 * _BJ_PI * BJ_EPSILON_0;
    var fs, fe = _bj_k_ux_from(fpe);
    var ds, de = _bj_k_ux_mul(fs, fe, rs, re);
    var qs, qe = _bj_k_ux_from(charge);
    var u: f64 = _bj_k_ux_div_f64(qs, qe, ds, de);
    return Ok(u);
}

# A = μ₀qcβ/(4π(|R| − R⋅β)) = (β/c)φ (T⋅m) into out (Griffiths 10.47). As bj_lienard_wiechert_scalar_potential, out
# untouched on an error; where μ₀q, μ₀qc or their quotient by 4πR_eff leaves the normal range, or R_eff passes DBL_MAX,
# the chain runs with an unbounded exponent and each part rounds once (row 18's rule, M2 part 2d-3e). Mirrors
# `relativity::lienard_wiechert_vector_potential`.
public fn bj_lienard_wiechert_vector_potential(charge: f64, r_vec: BjFieldVector, beta_vec: BjFieldVector,
  out: *BjFieldVector): Result {
    var t, v = _bj_rel_effective_distance(r_vec, beta_vec);
    if (is_err_result(t) == 1) { return Err(v); }
    var r_eff: f64 = v;
    var mq: f64 = BJ_MU_0 * charge;
    var num: f64 = mq * BJ_SPEED_OF_LIGHT;
    var den: f64 = 4.0 * _BJ_PI * r_eff;
    var k: f64 = num / den;
    var amq: f64 = f64_abs(mq);
    var ank: f64 = f64_abs(num);
    var ak: f64 = f64_abs(k);
    var plain = 0;                                  # every product and quotient its 53-bit value, or an exact 0
    if (r_eff <= _BJ_VX_HI && (charge == 0.0 || (amq > _BJ_VX_MN && ank > _BJ_VX_MN && ank <= _BJ_VX_HI))) {
        if (charge == 0.0 || (ak > _BJ_VX_MN && ak <= _BJ_VX_HI)) { plain = 1; }
    }
    if (plain == 1 || _bj_is_finite(charge) == 0) {
        var a: BjFieldVector = beta_vec.scale(k);
        out.x = a.x;
        out.y = a.y;
        out.z = a.z;
        return Ok(0);
    }
    _bj_rel_avec_edge(charge, r_vec, beta_vec, r_eff, out);
    return Ok(0);
}

# A = β·μ₀qc/(4πR_eff) at a range edge into out (row 18's rule, M2 part 2d-3e): μ₀q, μ₀qc, R_eff (past DBL_MAX by
# _bj_rel_reff_ux), 4πR_eff and their quotient to 53 bits with an unbounded exponent, each part's product rounded once.
fn _bj_rel_avec_edge(charge: f64, r_vec: BjFieldVector, beta_vec: BjFieldVector, r_eff: f64, out: *BjFieldVector) {
    var c: f64 = BJ_SPEED_OF_LIGHT;
    var ms, me = _bj_vx_mul(BJ_MU_0, charge);
    var cs, ce = _bj_k_ux_from(c);
    var ns, ne = _bj_k_ux_mul(ms, me, cs, ce);
    var rs, re = _bj_k_ux_from(r_eff);
    if (r_eff > _BJ_VX_HI) {
        var us, ue = _bj_rel_reff_ux(r_vec, beta_vec);
        rs = us;
        re = ue;
    }
    var fp: f64 = 4.0 * _BJ_PI;
    var fs, fe = _bj_k_ux_from(fp);
    var ds, de = _bj_k_ux_mul(fs, fe, rs, re);
    var ks, ke = _bj_k_ux_div(ns, ne, ds, de);
    var bx, bxe = _bj_k_ux_from(beta_vec.x);
    var by, bye = _bj_k_ux_from(beta_vec.y);
    var bz, bze = _bj_k_ux_from(beta_vec.z);
    var ax: f64 = _bj_k_ux_mul_f64(bx, bxe, ks, ke);
    var ay: f64 = _bj_k_ux_mul_f64(by, bye, ks, ke);
    var az: f64 = _bj_k_ux_mul_f64(bz, bze, ks, ke);
    out.x = ax;
    out.y = ay;
    out.z = az;
    return 0;
}

# ── Liénard–Wiechert fields and the Larmor powers ────────────────────────────────────────────────────────────────

# E = (q/4πε₀)(n̂ − β)/(γ²κ³R²) + (q/4πε₀c) n̂ × [(n̂ − β) × β̇]/(κ³R) (V/m) into out, κ = 1 − n̂⋅β: the velocity
# (Coulomb, ∝ 1/R²) and acceleration (radiation, ∝ 1/R) fields; r_vec from the retarded position to the field point,
# β = v/c and β̇ = a/c at the retarded time. InvalidParameter for a NaN R ("R vector must not contain NaN", as the
# potentials: ADR 0002 row 27, where Rust went on to NaN) and for an infinite part ("R vector must be finite", row 27
# amended, M2 part 2d-3e), Singularity for |R| < 10^-30 exactly, InvalidParameter
# unless |β| < 1 exactly, DivisionByZero for κ < 10^-30 exactly; out untouched on an error. γ² = 1/(1 − |β|²) is
# correctly rounded from the exact difference (ADR 0002 row 30). For a finite R, κ = (|R| − R⋅β)/|R| is rounded once
# from the exact S and P, and its test decided on the exact κ (src/crmath_edge.cyr; ADR 0002 row 17, M2 part 2c-4):
# Rust's 1 − n̂⋅β cancelled as n̂⋅β → 1, and refused a κ of 6e-17 as zero. n̂ − β, which vanishes with κ, is rounded
# once part by part from the same exact parts (row 17, M2 part 2d-1, the user's answer of 2026-11-13). The tail
# (γ²κ³R², the two factors, the cross products) keeps Rust's chain inside a box on q, R, β̇, n̂ − β and γ², and
# otherwise runs with an unbounded exponent, |R| and 1/|R| included, each part's sum rounded once (row 18's rule, M2
# part 2d-3f). Mirrors `relativity::lienard_wiechert_e`.
public fn bj_lienard_wiechert_e(charge: f64, r_vec: BjFieldVector, beta_vec: BjFieldVector, beta_dot: BjFieldVector,
  out: *BjFieldVector): Result {
    return _bj_rel_e_impl(charge, r_vec, beta_vec, beta_dot, out, 0);
}

# bj_lienard_wiechert_e's body; *boxed (when boxed is not 0) := 1 when Rust's chain ran inside its box, so each part of
# E is ±0 exactly or normal and its double is its 53-bit value (lienard_wiechert_fields' B needs that, M2 part 2d-3j).
fn _bj_rel_e_impl(charge: f64, r_vec: BjFieldVector, beta_vec: BjFieldVector, beta_dot: BjFieldVector,
  out: *BjFieldVector, boxed): Result {
    var r_mag: f64 = r_vec.magnitude();
    if (r_mag != r_mag) { return Err(_bj_err_invalid_parameter("R vector must not contain NaN")); }
    if (_bj_vx_finite4(r_vec.x, r_vec.y, r_vec.z, 0.0) == 0) {
        return Err(_bj_err_invalid_parameter("R vector must be finite"));
    }
    if (r_mag < 0.0000000000000000000000000000005) { return Err(_bj_err_singularity()); }
    if (r_mag <= 0.000000000000000000000000000002 && _bj_rel_r_below(r_vec, r_mag) == 1) {
        return Err(_bj_err_singularity());
    }
    var bp: f64[3];
    _bj_rel_parts(beta_vec, &bp);
    var g2: f64[1];
    if (_bj_cr_lorentz(&bp, 0, 3, 1.0, 1, 0, &g2) == 0) { return Err(_bj_err_invalid_parameter("β must be < 1")); }
    var inv_r: f64 = 1.0 / r_mag;
    var n_hat: BjFieldVector = r_vec.scale(inv_r);
    var rp: f64[3];
    _bj_rel_parts(r_vec, &rp);
    var ko: f64[4];
    if (_bj_cr_lw(&rp, &bp, 0, 2, 0, &ko) == 1) {
        return Err(_bj_err_division_by_zero("Liénard-Wiechert denominator (1 − n̂⋅β) is zero"));
    }
    var kappa: f64 = ko[0];
    var n_minus_beta: BjFieldVector = BjFieldVector_new(ko[1], ko[2], ko[3]);
    var gamma_sq: f64 = g2[0];
    var kappa3: f64 = kappa * kappa * kappa;
    var four_pi_eps0: f64 = 4.0 * _BJ_PI * BJ_EPSILON_0;
    var pre: f64 = charge / four_pi_eps0;
    var dv: f64 = gamma_sq * kappa3 * r_mag * r_mag;
    var fv: f64 = pre / dv;
    var velocity_term: BjFieldVector = n_minus_beta.scale(fv);
    var inner: BjFieldVector = n_minus_beta.cross(beta_dot);
    var outer: BjFieldVector = n_hat.cross(inner);
    var da: f64 = kappa3 * r_mag * BJ_SPEED_OF_LIGHT;
    var fa: f64 = pre / da;
    var accel_term: BjFieldVector = outer.scale(fa);
    var e: BjFieldVector = BjFieldVector_add(velocity_term, accel_term);
    var aq: f64 = f64_abs(charge);
    if ((charge == 0.0 || (aq >= _BJ_REL_E_QLO && aq < _BJ_REL_E_QHI)) && gamma_sq < 1267650600228229401496703205376.0
      && _bj_rel_box_e(&r_vec, &beta_dot, &n_minus_beta) == 1) {
        out.x = e.x;
        out.y = e.y;
        out.z = e.z;
        if (boxed != 0) { store64(boxed, 1); }
        return Ok(0);
    }
    _bj_rel_e_slow(charge, r_vec, kappa, gamma_sq, n_minus_beta, beta_dot, e, out);
    return Ok(0);
}

# lienard_wiechert_e outside its box: _bj_rel_e_tail on R's and β̇'s pairs for a finite charge and β̇, else Rust's
# chain e (a non-finite operand keeps it).
fn _bj_rel_e_slow(charge: f64, r_vec: BjFieldVector, kappa: f64, gamma_sq: f64, nmb: BjFieldVector,
  beta_dot: BjFieldVector, e: BjFieldVector, out: *BjFieldVector) {
    if (_bj_vx_finite4(charge, beta_dot.x, beta_dot.y, beta_dot.z) == 1) {
        var rp: *f64 = _bj_rel_f64p(&r_vec);
        var dp: *f64 = _bj_rel_f64p(&beta_dot);
        var rs: f64[3];
        var re: i64[3];
        var ds: f64[3];
        var de: i64[3];
        for (var i = 0; i < 3; i = i + 1) {
            var xs, xe = _bj_k_ux_from(rp[i]);
            rs[i] = xs;
            re[i] = xe;
            var ys, ye = _bj_k_ux_from(dp[i]);
            ds[i] = ys;
            de[i] = ye;
        }
        var o: f64[15];
        _bj_rel_e_tail(charge, &rs, &re, kappa, gamma_sq, _bj_rel_f64p(&nmb), &ds, &de, &o);
        out.x = o[0];
        out.y = o[1];
        out.z = o[2];
        return 0;
    }
    out.x = e.x;
    out.y = e.y;
    out.z = e.z;
    return 0;
}

# B = n̂ × E/c (T), perpendicular to n̂ and E. A component keeps Rust's chain where its cross component is normal or
# ±0: that double is then its 53-bit value, and B's product rounds once (ADR 0002 row 18's rule, M2 part 2d-3h). A
# cross component past DBL_MAX or subnormal, for finite n̂ and E, runs to 53 bits with an unbounded exponent and B's
# product rounds once; Rust gave ∞ for a cross past DBL_MAX, where B is representable. A non-finite part keeps Rust's
# chain. Mirrors `relativity::lienard_wiechert_b`.
#must_use
public fn bj_lienard_wiechert_b(n_hat: BjFieldVector, e_field: BjFieldVector): BjFieldVector {
    var c: BjFieldVector = n_hat.cross(e_field);
    var inv: f64 = 1.0 / BJ_SPEED_OF_LIGHT;
    var b: BjFieldVector = c.scale(inv);
    # Each cross component ±0 or normal: |bits| 0, or in [2^-1022, ∞) below ∞ (integer compares on the bit patterns).
    var m = 0x7FFFFFFFFFFFFFFF;
    var u = load64(&c) & m;
    var bad = 0;
    if (u != 0 && (u < 0x0010000000000000 || u >= 0x7FF0000000000000)) { bad = 1; }
    u = load64(&c + 8) & m;
    if (u != 0 && (u < 0x0010000000000000 || u >= 0x7FF0000000000000)) { bad = 1; }
    u = load64(&c + 16) & m;
    if (u != 0 && (u < 0x0010000000000000 || u >= 0x7FF0000000000000)) { bad = 1; }
    if (bad == 1) { _bj_rel_b_edge(&n_hat, &e_field, &c, inv, &b); }
    return b;
}

# lienard_wiechert_b off its common case (M2 part 2d-3h), into out (Rust's B on entry): for finite n̂ and E (at the
# byte addresses n and e, the cross at c), each component whose cross is past DBL_MAX or subnormal takes
# n̂ⱼEₖ − n̂ₖEⱼ to 53 bits with an unbounded exponent (_bj_vx_cross1) times 1/c, rounded once.
fn _bj_rel_b_edge(n, e, c, inv: f64, out) {
    var np: *f64 = _bj_rel_f64p(n);
    var ep: *f64 = _bj_rel_f64p(e);
    var cp: *f64 = _bj_rel_f64p(c);
    var op: *f64 = _bj_rel_f64p(out);
    if (_bj_rel_finite_n(np, 3) == 0 || _bj_rel_finite_n(ep, 3) == 0) { return 0; }
    var is, ie = _bj_k_ux_from(inv);
    for (var i = 0; i < 3; i = i + 1) {
        var x: f64 = cp[i];
        var ax: f64 = f64_abs(x);
        if (x == 0.0 || (ax >= _BJ_VX_MN && ax <= _BJ_VX_HI)) { continue; }
        var j = (i + 1) % 3;
        var k = (i + 2) % 3;
        var ps, pe = _bj_vx_cross1(np[j], ep[k], np[k], ep[j]);
        var bi: f64 = _bj_k_ux_mul_f64(ps, pe, is, ie);
        op[i] = bi;
    }
    return 0;
}

# P = q²a²/(6πε₀c³) (W), Larmor's formula (non-relativistic), correctly rounded (ADR 0002 row 13: c³ of c's double, π
# Rust's; six factors below, src/crmath_mono.cyr's _bj_cr_mono_wide; a non-finite q or a keeps Rust's chain on
# c·c² and 6π rounded). Mirrors `relativity::larmor_power`.
#must_use
#pure
public fn bj_larmor_power(charge: f64, acceleration: f64): f64 {
    if (_bj_is_finite(charge) == 0 || _bj_is_finite(acceleration) == 0) {
        var c3: f64 = BJ_SPEED_OF_LIGHT * BJ_SPEED_OF_LIGHT_SQ;
        var num0: f64 = charge * charge * acceleration * acceleration;
        var den0: f64 = 6.0 * _BJ_PI * BJ_EPSILON_0 * c3;
        var p: f64 = num0 / den0;
        return p;
    }
    var num: f64[4];
    var den: f64[6];
    num[0] = charge;
    num[1] = charge;
    num[2] = acceleration;
    num[3] = acceleration;
    den[0] = 6.0;
    den[1] = _BJ_PI;
    den[2] = BJ_EPSILON_0;
    den[3] = BJ_SPEED_OF_LIGHT;
    den[4] = BJ_SPEED_OF_LIGHT;
    den[5] = BJ_SPEED_OF_LIGHT;
    var cr: f64 = _bj_cr_mono_wide(&num, 4, &den, 6);
    return cr;
}

# P = q²γ⁶/(6πε₀c³)·[a² − |v × a|²/c²] (W), Liénard's relativistic Larmor formula, γ correctly rounded from the exact
# c² − |v|² (ADR 0002 row 30). InvalidParameter "velocity must be less than c" unless |v| < c exactly. Mirrors
# `relativity::relativistic_larmor_power`.
public fn bj_relativistic_larmor_power(charge: f64, velocity: BjFieldVector, acceleration: BjFieldVector): Result {
    var vp: f64[3];
    _bj_rel_parts(velocity, &vp);
    var gg: f64[1];
    if (_bj_cr_lorentz(&vp, 0, 3, BJ_SPEED_OF_LIGHT, 0, 0, &gg) == 0) {
        return Err(_bj_err_invalid_parameter("velocity must be less than c"));
    }
    var gamma: f64 = gg[0];
    var g2: f64 = gamma * gamma;
    var g6: f64 = g2 * g2 * g2;
    var a_sq: f64 = acceleration.magnitude_sq();
    var vxa: BjFieldVector = velocity.cross(acceleration);
    var vxa_sq: f64 = vxa.magnitude_sq();
    var c3: f64 = BJ_SPEED_OF_LIGHT * BJ_SPEED_OF_LIGHT_SQ;
    var qq: f64 = charge * charge;
    var den: f64 = 6.0 * _BJ_PI * BJ_EPSILON_0 * c3;
    var pre: f64 = qq / den;
    var vc: f64 = vxa_sq / BJ_SPEED_OF_LIGHT_SQ;
    var d: f64 = a_sq - vc;
    var pg: f64 = pre * g6;
    var p: f64 = pg * d;
    var aq: f64 = f64_abs(charge);
    if ((charge == 0.0 || (aq >= _BJ_REL_LAR_QLO && aq < _BJ_REL_LAR_QHI)) && gamma < 134217728.0
      && _bj_rel_box_lar(&velocity, &acceleration) == 1) {
        return Ok(p);
    }
    var pv: *f64 = _bj_rel_f64p(&velocity);
    var pa: *f64 = _bj_rel_f64p(&acceleration);
    var dq: f64 = charge - charge;
    if (dq != 0.0 || _bj_rel_finite_n(pa, 3) == 0) { return Ok(p); }
    var u: f64 = _bj_rel_larmor_edge(charge, pv, pa, gamma, den);
    return Ok(u);
}

# ── the retarded-time solver ─────────────────────────────────────────────────────────────────────────────────────
# A trajectory is a closure (or `&fn`) called through callptr as `trajectory_fn(t, out)`, t an f64 in a word (rebind it
# inside as `var tt: f64 = t;`, probe p18): it writes the charge's position, then its velocity (six f64) at out, and for
# bj_lienard_wiechert_fields its acceleration after them (nine). Its return value is ignored: Rust's trajectory can't
# fail. The motion must be subluminal.

# One light-cone sample g(τ) = |r_obs − r(t − τ)| − cτ into s: τ, g, dg/dτ = R̂⋅v − c (−c at R = 0), the rounding
# scale of g, 2ε·max(|R|, cτ, ‖r_obs‖∞, ‖r(t_r)‖∞, ‖v‖∞|t_r|), and g's 53-bit pair (s[4], s[5]; s[5] NaN when g is its
# own). The light-travel term is c·(t − t_r) with the rounded t_r. The maxima are f64::max's folds: every operand is
# finite or +∞ and none is −0 or NaN, so compares give the same value in any order. The trajectory's state is left in
# st. 0, or the InvalidParameter of a non-finite state.
fn _bj_rel_sample(obs: *f64, t: f64, tau: f64, traj, st: *f64, s: *f64): i64 {
    var t_r: f64 = t - tau;
    callptr(traj, t_r, st);
    var z: f64 = (st[0] - st[0]) + (st[1] - st[1]) + (st[2] - st[2]);   # x − x: +0 when x is finite, else NaN
    z = z + (st[3] - st[3]) + (st[4] - st[4]) + (st[5] - st[5]);
    if (z != 0.0) { return _bj_rel_state_error(t_r); }
    var dx: f64 = obs[0] - st[0];
    var dy: f64 = obs[1] - st[1];
    var dz: f64 = obs[2] - st[2];
    var d2: f64 = dx * dx + dy * dy + dz * dz;
    var dist: f64 = f64_sqrt(d2);
    var dt: f64 = t - t_r;
    var light: f64 = BJ_SPEED_OF_LIGHT * dt;
    # The common case of _bj_rel_sample_edge's test: d2 in [2^-900, DBL_MAX] (then the noise's maximum is at least
    # |R| ≥ 2^-450), c·(t − t_r) 0 (then t − t_r is 0) or normal, |R⋅v| in the band and ‖v‖∞·|t_r| finite.
    var ok = 1;
    if (!(d2 >= _BJ_VX_LO && d2 <= _BJ_VX_HI)) { ok = 0; }
    if (light != 0.0 && !(light > _BJ_VX_MN && light <= _BJ_VX_HI)) { ok = 0; }
    var dg: f64 = -BJ_SPEED_OF_LIGHT;
    if (dist > 0.0) {
        var rv: f64 = dx * st[3] + dy * st[4] + dz * st[5];
        var q: f64 = rv / dist;
        dg = q - BJ_SPEED_OF_LIGHT;
        q = f64_abs(rv);
        if (!(q >= _BJ_VX_LO && q <= _BJ_VX_HI)) { ok = 0; }
    }
    var m: f64 = f64_abs(obs[0]);                   # max(‖r_obs‖∞, ‖r(t_r)‖∞)
    var w: f64 = f64_abs(obs[1]);
    if (w > m) { m = w; }
    w = f64_abs(obs[2]);
    if (w > m) { m = w; }
    w = f64_abs(st[0]);
    if (w > m) { m = w; }
    w = f64_abs(st[1]);
    if (w > m) { m = w; }
    w = f64_abs(st[2]);
    if (w > m) { m = w; }
    var mv: f64 = f64_abs(st[3]);                   # ‖v‖∞
    w = f64_abs(st[4]);
    if (w > mv) { mv = w; }
    w = f64_abs(st[5]);
    if (w > mv) { mv = w; }
    w = f64_abs(t_r);
    w = mv * w;
    if (!(w <= _BJ_VX_HI)) { ok = 0; }
    if (w > m) { m = w; }
    if (dist > m) { m = dist; }
    if (light > m) { m = light; }
    s[0] = tau;
    s[1] = dist - light;
    s[2] = dg;
    s[3] = 0.000000000000000444089209850062616169452667236328125 * m;   # 2ε = 2^-51
    s[4] = 0.0;
    s[5] = _BJ_REL_NAN;                             # g is its own 53-bit value
    if (ok == 0) { _bj_rel_sample_edge(obs, t, st, s); }
    return 0;
}

# The InvalidParameter of a non-finite trajectory state: "trajectory returned a non-finite state at t = ..".
fn _bj_rel_state_error(t_r: f64): i64 {
    var e = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(e, "trajectory returned a non-finite state at t = ");
    _bj_fmt_f64_display(e, t_r);
    return BJ_ERR_INVALID_PARAMETER;
}

# A quiet NaN, the marker of a sample whose g is its own 53-bit value.
var _BJ_REL_NAN: f64 = 0x7FF8000000000000;

# DBL_MAX/2 (the largest double below 2^1023): 2g is finite and exact up to it.
var _BJ_REL_HALF_MAX: f64 = 0x7FDFFFFFFFFFFFFF;

# The light-cone sample off its common case (M2 part 2d-3g): s holds Rust's sample at τ = s[0], kept where Rust's chain
# is the unbounded one (ADR 0002 row 18's rule), else replaced by _bj_rel_sample_ux's. The chain is the unbounded one
# when dx, dy and dz are finite (a difference of finite doubles is otherwise exact); dx² + dy² + dz² is in the band
# [2^-900, DBL_MAX] or every d is 0, so |R| is its 53-bit value; c·(t − t_r) is normal or 0; R⋅v is in the band, or 0
# from exact products (or |R| = 0, where dg is −c), so R̂⋅v − c absorbs a degraded part; ‖v‖·|t_r| is finite and the
# noise's maximum at least 2^-900 (or all 0).
fn _bj_rel_sample_edge(obs: *f64, t: f64, st: *f64, s: *f64) {
    var tau: f64 = s[0];
    var t_r: f64 = t - tau;
    var dx: f64 = obs[0] - st[0];
    var dy: f64 = obs[1] - st[1];
    var dz: f64 = obs[2] - st[2];
    var d2: f64 = dx * dx + dy * dy + dz * dz;
    var dt: f64 = t - t_r;
    var light: f64 = BJ_SPEED_OF_LIGHT * dt;
    var at: f64 = f64_abs(t_r);
    var mv: f64 = _bj_rel_max_abs3(st, 3);
    var mvt: f64 = mv * at;
    var plain = 1;
    var dd: f64 = (dx - dx) + (dy - dy) + (dz - dz);
    if (dd != 0.0) { plain = 0; }
    if (!(d2 >= _BJ_VX_LO && d2 <= _BJ_VX_HI) && !(dx == 0.0 && dy == 0.0 && dz == 0.0)) { plain = 0; }
    if (!(light <= _BJ_VX_HI && (light > _BJ_VX_MN || dt == 0.0))) { plain = 0; }
    if (plain == 1 && d2 > 0.0) {
        var p0: f64 = dx * st[3];
        var p1: f64 = dy * st[4];
        var p2: f64 = dz * st[5];
        var rv: f64 = p0 + p1 + p2;
        var arv: f64 = f64_abs(rv);
        if (!(arv >= _BJ_VX_LO && arv <= _BJ_VX_HI)) {
            if (rv != 0.0) { plain = 0; }
            var ex = _bj_vx_exact(dx, st[3], p0) + _bj_vx_exact(dy, st[4], p1) + _bj_vx_exact(dz, st[5], p2);
            if (ex != 3) { plain = 0; }
        }
    }
    if (!(mvt <= _BJ_VX_HI)) { plain = 0; }
    if (plain == 1) {
        var dist: f64 = f64_sqrt(d2);
        var m_obs: f64 = _bj_rel_max_abs3(obs, 0);
        var m_pos: f64 = _bj_rel_max_abs3(st, 0);
        var m: f64 = _bj_max(dist, light);
        m = _bj_max(m, m_obs);
        m = _bj_max(m, m_pos);
        m = _bj_max(m, mvt);
        if (m >= _BJ_VX_LO) { return 0; }
        if (m == 0.0 && (at == 0.0 || mv == 0.0)) { return 0; }
    }
    _bj_rel_sample_ux(obs, t, tau, st, s);
    return 0;
}

# The light-cone sample with an unbounded exponent into s (row 18's rule, M2 part 2d-3g): R = r_obs − r(t_r) part by
# part, |R|, c·(t − t_r), g = |R| − c(t − t_r) (s[1] rounded once, s[4] and s[5] its 53-bit pair), R⋅v, dg = R̂⋅v − c
# rounded once (−c at R = 0), and the noise 2ε·max(|R|, c(t − t_r), ‖r_obs‖∞, ‖r(t_r)‖∞, ‖v‖∞|t_r|) rounded once. The
# trajectory's state is st's (finite).
fn _bj_rel_sample_ux(obs: *f64, t: f64, tau: f64, st: *f64, s: *f64) {
    var t_r: f64 = t - tau;
    var dt: f64 = t - t_r;
    var c: f64 = BJ_SPEED_OF_LIGHT;
    var ds: f64[3];
    var de: i64[3];
    for (var i = 0; i < 3; i = i + 1) {
        var os, oe = _bj_k_ux_from(obs[i]);
        var ps, pe = _bj_k_ux_from(st[i]);
        var xs, xe = _bj_k_ux_sub(os, oe, ps, pe);
        ds[i] = xs;
        de[i] = xe;
    }
    var q0s, q0e = _bj_k_ux_mul(ds[0], de[0], ds[0], de[0]);
    var q1s, q1e = _bj_k_ux_mul(ds[1], de[1], ds[1], de[1]);
    var q2s, q2e = _bj_k_ux_mul(ds[2], de[2], ds[2], de[2]);
    var s1s, s1e = _bj_k_ux_add(q0s, q0e, q1s, q1e);
    var s2s, s2e = _bj_k_ux_add(s1s, s1e, q2s, q2e);
    var ms, me = _bj_k_ux_sqrt(s2s, s2e);
    var cs, ce = _bj_k_ux_from(c);
    var ts, te = _bj_k_ux_from(dt);
    var ls, le = _bj_k_ux_mul(cs, ce, ts, te);
    var gs, ge = _bj_k_ux_sub(ms, me, ls, le);
    var g: f64 = _bj_k_ux_sub_f64(ms, me, ls, le);
    var dg: f64 = -c;
    if (ms != 0.0) {
        var v0s, v0e = _bj_k_ux_from(st[3]);
        var v1s, v1e = _bj_k_ux_from(st[4]);
        var v2s, v2e = _bj_k_ux_from(st[5]);
        var r0s, r0e = _bj_k_ux_mul(ds[0], de[0], v0s, v0e);
        var r1s, r1e = _bj_k_ux_mul(ds[1], de[1], v1s, v1e);
        var r2s, r2e = _bj_k_ux_mul(ds[2], de[2], v2s, v2e);
        var u1s, u1e = _bj_k_ux_add(r0s, r0e, r1s, r1e);
        var u2s, u2e = _bj_k_ux_add(u1s, u1e, r2s, r2e);
        var qs, qe = _bj_k_ux_div(u2s, u2e, ms, me);
        dg = _bj_k_ux_sub_f64(qs, qe, cs, ce);
    }
    var mxs, mxe = _bj_k_ux_max(ms, me, ls, le);
    var mo: f64 = _bj_rel_max_abs3(obs, 0);
    var mp: f64 = _bj_rel_max_abs3(st, 0);
    var mv: f64 = _bj_rel_max_abs3(st, 3);
    var at: f64 = f64_abs(t_r);
    var mos, moe = _bj_k_ux_from(mo);
    var mps, mpe = _bj_k_ux_from(mp);
    var mvs, mve = _bj_k_ux_from(mv);
    var ats, ate = _bj_k_ux_from(at);
    var mts, mte = _bj_k_ux_mul(mvs, mve, ats, ate);
    var a1s, a1e = _bj_k_ux_max(mxs, mxe, mos, moe);
    var a2s, a2e = _bj_k_ux_max(a1s, a1e, mps, mpe);
    var a3s, a3e = _bj_k_ux_max(a2s, a2e, mts, mte);
    var noise: f64 = _bj_k_ux_mul_f64(1.0, 0 - 51, a3s, a3e);
    s[0] = tau;
    s[1] = g;
    s[2] = dg;
    s[3] = noise;
    s[4] = gs;
    s[5] = f64_from(ge);
    return 0;
}

# The 53-bit pair of a sample's g: its own where the sample computed one, else g's (exact then).
#must_use
fn _bj_rel_gp(s: *f64): (f64, i64) {
    var e5: f64 = s[5];
    if (e5 != e5) {
        var gs, ge = _bj_k_ux_from(s[1]);
        return (gs, ge);
    }
    var s4: f64 = s[4];
    return (s4, f64_to(e5));
}

# The sign of a sample's g (−1, 0 or 1), from its pair: an unbounded g below 2^-1074 still has its sign.
#must_use
fn _bj_rel_gsign(s: *f64): i64 {
    var e5: f64 = s[5];
    var x: f64 = s[1];
    if (e5 == e5) { x = s[4]; }
    if (x > 0.0) { return 1; }
    if (x < 0.0) { return 0 - 1; }
    return 0;
}

# 1 when |g_a| < |g_b| exactly for two samples (the solver calls it only where one g is not normal).
#must_use
fn _bj_rel_gabs_lt(a: *f64, b: *f64): i64 {
    var xs, xe = _bj_rel_gp(a);
    var ys, ye = _bj_rel_gp(b);
    var ax: f64 = f64_abs(xs);
    var ay: f64 = f64_abs(ys);
    if (_bj_k_ux_cmp(ax, xe, ay, ye) == 0 - 1) { return 1; }
    return 0;
}

# The solver's step tests on g's 53-bit pair for a sample (exact for every sample), as fl's flags: 1 when g = 0 (then
# alone), else 2 when |g| ≤ the noise and 4 when |2g| ≤ |last_step·dg|; for dg < 0 the Newton point τ − g/dg into
# out[0] and |g/dg| into out[1] (g/dg to 53 bits with an unbounded exponent, each rounded once).
fn _bj_rel_step_ux(s: *f64, last_step: f64, out: *f64): i64 {
    var gs, ge = _bj_rel_gp(s);
    if (gs == 0.0) { return 1; }
    var fl = 0;
    var ag: f64 = f64_abs(gs);
    var ns, ne = _bj_k_ux_from(s[3]);
    if (_bj_k_ux_cmp(ag, ge, ns, ne) <= 0) { fl = 2; }
    var cd: f64 = s[2];
    var ds, de = _bj_k_ux_from(cd);
    var ls1, le1 = _bj_k_ux_from(last_step);
    var ps, pe = _bj_k_ux_mul(ls1, le1, ds, de);
    var ap: f64 = f64_abs(ps);
    if (_bj_k_ux_cmp(ag, ge + 1, ap, pe) <= 0) { fl = fl + 4; }
    if (cd < 0.0) {
        var qs, qe = _bj_k_ux_div(gs, ge, ds, de);
        var ts, te = _bj_k_ux_from(s[0]);
        var nu: f64 = _bj_k_ux_sub_f64(ts, te, qs, qe);
        var aq: f64 = f64_abs(qs);
        var st: f64 = _bj_k_ux_mul_f64(aq, qe, 1.0, 0);
        out[0] = nu;
        out[1] = st;
    }
    return fl;
}

# max(|p[k]|, |p[k + 1]|, |p[k + 2]|), Rust's f64::max fold.
fn _bj_rel_max_abs3(p: *f64, k): f64 {
    var a: f64 = f64_abs(p[k]);
    var b: f64 = f64_abs(p[k + 1]);
    var c: f64 = f64_abs(p[k + 2]);
    var ab: f64 = _bj_max(a, b);
    var m: f64 = _bj_max(ab, c);
    return m;
}

# dst := src, a light-cone sample (six f64: τ, g, dg, noise and g's 53-bit pair, M2 part 2d-3g).
fn _bj_rel_copy6(dst: *f64, src: *f64) {
    dst[0] = src[0];
    dst[1] = src[1];
    dst[2] = src[2];
    dst[3] = src[3];
    dst[4] = src[4];
    dst[5] = src[5];
    return 0;
}

# The InvalidParameter of an observer that is not finite: "observer position and time must be finite, got [..] at
# t = ..".
fn _bj_rel_observer_error(obs: *f64, t: f64): i64 {
    var e = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
    _bj_tx_cstr(e, "observer position and time must be finite, got ");
    _bj_fmt_f64x3_debug(e, obs);
    _bj_tx_cstr(e, " at t = ");
    _bj_fmt_f64_display(e, t);
    return BJ_ERR_INVALID_PARAMETER;
}

# Logs one of the solver's debug events, a message and its fields: t_r and τ (`what` 1: converged, with the
# iteration and expansion counts), t_r alone (2: the observer on the trajectory), or the budget and the bracket (3).
fn _bj_rel_solve_log(what, a: f64, b: f64, n1, n2) {
    if (_bj_log_on(4) == 0) { return 0; }
    var lb[256];
    var lt[24];
    _bj_tx_init(&lt, &lb, 256);
    if (what == 1) {
        _bj_tx_cstr(&lt, "retarded time converged t_r=");
        _bj_fmt_f64_debug(&lt, a);
        _bj_tx_cstr(&lt, " tau=");
        _bj_fmt_f64_debug(&lt, b);
        _bj_tx_cstr(&lt, " iterations=");
        _bj_tx_u64(&lt, n1);
        _bj_tx_cstr(&lt, " expansions=");
        _bj_tx_u64(&lt, n2);
    } elif (what == 2) {
        _bj_tx_cstr(&lt, "retarded time: observer on the trajectory t_r=");
        _bj_fmt_f64_debug(&lt, a);
    } else {
        _bj_tx_cstr(&lt, "retarded time solver did not converge max_iterations=");
        _bj_tx_u64(&lt, n1);
        _bj_tx_cstr(&lt, " lo=");
        _bj_fmt_f64_debug(&lt, a);
        _bj_tx_cstr(&lt, " hi=");
        _bj_fmt_f64_debug(&lt, b);
    }
    _bj_log_text(4, &lt);
    return 0;
}

# The solver over traj into *out, the trajectory's state left in st (nine f64): the body of bj_solve_retarded_time.
fn _bj_rel_solve(obs: *f64, t: f64, traj, max_iterations, st: *f64, out: *f64): Result {
    if (!(_bj_is_finite(t) == 1 && _bj_is_finite(obs[0]) == 1 && _bj_is_finite(obs[1]) == 1
        && _bj_is_finite(obs[2]) == 1)) {
        return Err(_bj_rel_observer_error(obs, t));
    }
    if (_bj_log_on(4) == 1) {
        var lb[256];
        var lt[24];
        _bj_tx_init(&lt, &lb, 256);
        _bj_tx_cstr(&lt, "solving retarded time observer_pos=");
        _bj_fmt_f64x3_debug(&lt, obs);
        _bj_tx_cstr(&lt, " observation_time=");
        _bj_fmt_f64_debug(&lt, t);
        _bj_tx_cstr(&lt, " max_iterations=");
        _bj_tx_u64(&lt, max_iterations);
        _bj_log_text(4, &lt);
    }
    var lo: f64[6];
    var hi: f64[6];
    var cur: f64[6];
    var c0 = _bj_rel_sample(obs, t, 0.0, traj, st, &lo);
    if (c0 != 0) { return Err(c0); }
    # g's sign, |g| and the Newton point come from Rust's doubles where g is normal (so its double is its 53-bit
    # value) and from g's 53-bit pair otherwise (ADR 0002 row 18's rule, M2 part 2d-3g): the pair helpers run only
    # off the normal case.
    var g0: f64 = lo[1];
    if (g0 == 0.0) {
        if (_bj_rel_gsign(&lo) == 0) {
            _bj_rel_solve_log(2, t, 0.0, 0, 0);
            out[0] = t;
            return Ok(0);
        }
    }
    var tau0: f64 = g0 / BJ_SPEED_OF_LIGHT;
    var ag0: f64 = f64_abs(g0);
    if (!(ag0 > _BJ_VX_MN && ag0 <= _BJ_VX_HI)) {  # g past DBL_MAX or subnormal: τ₀ from its 53-bit pair
        var g0s, g0e = _bj_rel_gp(&lo);
        var cs, ce = _bj_k_ux_from(BJ_SPEED_OF_LIGHT);
        tau0 = _bj_k_ux_div_f64(g0s, g0e, cs, ce);
    }
    var min_pos: f64 = _bj_from_bits(0x0010000000000000);
    var tau1: f64 = _bj_max(tau0, min_pos);
    var c1 = _bj_rel_sample(obs, t, tau1, traj, st, &hi);
    if (c1 != 0) { return Err(c1); }
    var expansions = 0;
    while (1 == 1) {
        var hg: f64 = hi[1];
        if (!(hg > 0.0)) {
            if (hg != 0.0 || _bj_rel_gsign(&hi) <= 0) { break; }
        }
        var ht: f64 = hi[0];
        var next_tau: f64 = 2.0 * ht;
        if (expansions >= 2100 || _bj_is_finite(next_tau) == 0) {
            var be = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(be, "retarded time solver could not bracket the light-cone root ");
            _bj_tx_cstr(be, "(is the trajectory faster than light?)");
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        _bj_rel_copy6(&lo, &hi);
        var c2 = _bj_rel_sample(obs, t, next_tau, traj, st, &hi);
        if (c2 != 0) {
            # A non-finite state while the bracket still expands: the doubling drove the trajectory past the range,
            # so no bracket was found (ADR 0002 row 31, the user's answer of 2026-11-13; Rust reported the state).
            var bf = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(bf, "retarded time solver could not bracket the light-cone root ");
            _bj_tx_cstr(bf, "(is the trajectory faster than light?)");
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        expansions = expansions + 1;
    }
    var alo: f64 = f64_abs(lo[1]);
    var ahi: f64 = f64_abs(hi[1]);
    var lo_cur = 0;
    if (alo > _BJ_VX_MN && alo <= _BJ_VX_HI && ahi > _BJ_VX_MN && ahi <= _BJ_VX_HI) {
        if (alo < ahi) { lo_cur = 1; }
    } else {
        lo_cur = _bj_rel_gabs_lt(&lo, &hi);
    }
    if (lo_cur == 1) { _bj_rel_copy6(&cur, &lo); } else { _bj_rel_copy6(&cur, &hi); }
    var last_step: f64 = hi[0] - lo[0];
    var iterations = 0;
    var tau: f64 = 0.0;
    var nw: f64[2];
    var at: f64 = f64_abs(t);
    while (1 == 1) {
        var ct: f64 = cur[0];
        var cg: f64 = cur[1];
        var cd: f64 = cur[2];
        var gd: f64 = cg / cd;
        var newton: f64 = ct - gd;
        var step_n: f64 = f64_abs(gd);
        # Rust's doubles where g is normal with 2g finite and g/dg normal: g's double is its 53-bit value, g/dg's
        # rounding is the chain's, and |2g| ≤ |last_step·dg| is decided alike for a product that underflows (both
        # false, |2g| > 2^-1021) or overflows (both true). g's 53-bit pair otherwise. fl: 1 g = 0, 2 |g| ≤ noise,
        # 4 |2g| ≤ |last_step·dg|.
        var fl = 0;
        var acg: f64 = f64_abs(cg);
        if (acg > _BJ_VX_MN && acg <= _BJ_REL_HALF_MAX && step_n > _BJ_VX_MN && step_n <= _BJ_VX_HI) {
            var cn: f64 = cur[3];
            if (acg <= cn) { fl = 2; }
            var g2: f64 = 2.0 * acg;
            var ls: f64 = last_step * cd;
            var als: f64 = f64_abs(ls);
            if (g2 <= als) { fl = fl + 4; }
        } else {
            fl = _bj_rel_step_ux(&cur, last_step, &nw);
            newton = nw[0];
            step_n = nw[1];
        }
        if (fl == 1) {
            tau = ct;
            break;
        }
        if ((fl & 2) != 0) {
            tau = ct;
            if (cd < 0.0) {
                var pl: f64 = _bj_max(newton, lo[0]);
                tau = _bj_min(pl, hi[0]);
            }
            break;
        }
        if (iterations == max_iterations) {
            _bj_rel_solve_log(3, lo[0], hi[0], max_iterations, 0);
            var ne = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(ne, "retarded time solver did not converge in ");
            _bj_tx_u64(ne, max_iterations);
            _bj_tx_cstr(ne, " iterations");
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
        iterations = iterations + 1;
        var next: f64 = 0.0;
        var step: f64 = 0.0;
        if (cd < 0.0 && newton >= lo[0] && newton <= hi[0] && (fl & 4) != 0) {
            next = newton;
            step = step_n;
        } else {
            var w: f64 = hi[0] - lo[0];
            var half: f64 = 0.5 * w;
            next = lo[0] + half;
            step = half;
        }
        var mt: f64 = next;                         # f64::max(|t|, next): neither is NaN
        if (at > mt) { mt = at; }
        var tol: f64 = 0.00000000000000088817841970012523233890533447265625 * mt;   # 4ε = 2^-50
        if (step <= tol || next == ct) {
            tau = next;
            break;
        }
        last_step = step;
        var c3 = _bj_rel_sample(obs, t, next, traj, st, &cur);
        if (c3 != 0) { return Err(c3); }
        var ng: f64 = cur[1];
        var up = 0;
        if (ng > 0.0) {
            up = 1;
        } elif (ng == 0.0) {
            if (_bj_rel_gsign(&cur) > 0) { up = 1; }
        }
        if (up == 1) { _bj_rel_copy6(&lo, &cur); } else { _bj_rel_copy6(&hi, &cur); }
    }
    var t_r: f64 = t - tau;
    _bj_rel_solve_log(1, t_r, tau, iterations, expansions);
    out[0] = t_r;
    return Ok(0);
}

# The retarded time t_r ≤ t with |r_obs − r(t_r)| = c(t − t_r), unique for a subluminal charge. On the delay τ = t − t_r
# with g(τ) = |r_obs − r(t − τ)| − cτ (g(0) ≥ 0, g′ < 0): from the static estimate τ₀ = |r_obs − r(t)|/c a bracket
# g(lo) > 0 ≥ g(hi) by doubling, then Newton steps safeguarded by bisection, until the step is at most 4ε·max(|t|, τ)
# or |g| reaches its own rounding level (then one last Newton correction). `observer_pos` is three f64, the trajectory
# a callback (above) writing position and velocity, `max_iterations` Rust's usize (−1 is usize::MAX) counting the
# refinement steps (the bracket's doublings are not counted). InvalidParameter when the observer or the time is not
# finite, the trajectory returns a non-finite state, no bracket exists (a superluminal trajectory: a non-finite state
# met while the bracket expands reports this error, ADR 0002 row 31, the user's answer of 2026-11-13), or the
# refinement has not converged in max_iterations steps. Mirrors `relativity::solve_retarded_time`.
public fn bj_solve_retarded_time(observer_pos: *f64, observation_time: f64, trajectory_fn, max_iterations): Result {
    var st: f64[9];
    var r: f64[1];
    var t, v = _bj_rel_solve(observer_pos, observation_time, trajectory_fn, max_iterations, &st, &r);
    if (is_err_result(t) == 1) { return Err(v); }
    var t_r: f64 = r[0];
    return Ok(t_r);
}

# (E, B) (V/m, T) at the observer, into e_out and b_out: bj_solve_retarded_time with a budget of 200 refinement steps,
# then bj_lienard_wiechert_e and bj_lienard_wiechert_b at the retarded position, β = v/c and β̇ = a/c. The trajectory
# writes position, velocity and acceleration (nine f64). The solver's errors; InvalidParameter for a non-finite
# acceleration; Singularity when the observer sits on the retarded position; bj_lienard_wiechert_e's errors; the outs
# untouched on an error. Rust's chain is kept where its own values make it the unbounded one (_bj_rel_fields_plain,
# and E's parts normal or exact zeros); otherwise R, β, β̇, E, n̂ and B run to 53 bits with an unbounded exponent and
# each output rounds once (ADR 0002 row 18's rule, M2 part 2d-3j): an R past DBL_MAX (Rust: ∞, then NaN fields), a
# 1/|R| or n̂ below 2^-1022, a β or β̇ below 2^-1022, or an E that B would see degraded. A non-finite charge keeps
# Rust's chain (NaN fields where R passes DBL_MAX). Mirrors `relativity::lienard_wiechert_fields`.
public fn bj_lienard_wiechert_fields(charge: f64, observer_pos: *f64, observation_time: f64, trajectory_fn,
  e_out: *BjFieldVector, b_out: *BjFieldVector): Result {
    if (_bj_log_on(5) == 1) {
        var lb[256];
        var lt[24];
        _bj_tx_init(&lt, &lb, 256);
        _bj_tx_cstr(&lt, "Liénard-Wiechert fields charge=");
        _bj_fmt_f64_debug(&lt, charge);
        _bj_tx_cstr(&lt, " observer_pos=");
        _bj_fmt_f64x3_debug(&lt, observer_pos);
        _bj_tx_cstr(&lt, " observation_time=");
        _bj_fmt_f64_debug(&lt, observation_time);
        _bj_log_text(5, &lt);
    }
    var st: f64[9];
    var r: f64[1];
    var ts, vs = _bj_rel_solve(observer_pos, observation_time, trajectory_fn, 200, &st, &r);
    if (is_err_result(ts) == 1) { return Err(vs); }
    var t_r: f64 = r[0];
    callptr(trajectory_fn, t_r, &st);
    for (var k = 6; k < 9; k = k + 1) {
        var a: f64 = st[k];
        if (_bj_is_finite(a) == 0) {
            var e = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
            _bj_tx_cstr(e, "trajectory returned a non-finite acceleration at t = ");
            _bj_fmt_f64_display(e, t_r);
            return Err(BJ_ERR_INVALID_PARAMETER);
        }
    }
    var rx: f64 = observer_pos[0] - st[0];
    var ry: f64 = observer_pos[1] - st[1];
    var rz: f64 = observer_pos[2] - st[2];
    var r_vec: BjFieldVector = BjFieldVector_new(rx, ry, rz);
    var r_mag: f64 = r_vec.magnitude();
    var band = _bj_x_band(r_mag, _BJ_FIELD_R2_MIN);       # the exact |observer − position| (ADR 0002 row 17's rule)
    if (band == 2) { band = _bj_x_r2_below(observer_pos, &st, 60); }
    if (band == 1) { return Err(_bj_err_singularity()); }
    var inv: f64 = 1.0 / r_mag;
    var n_hat: BjFieldVector = r_vec.scale(inv);
    var bx: f64 = st[3] / BJ_SPEED_OF_LIGHT;
    var by: f64 = st[4] / BJ_SPEED_OF_LIGHT;
    var bz: f64 = st[5] / BJ_SPEED_OF_LIGHT;
    var dx: f64 = st[6] / BJ_SPEED_OF_LIGHT;
    var dy: f64 = st[7] / BJ_SPEED_OF_LIGHT;
    var dz: f64 = st[8] / BJ_SPEED_OF_LIGHT;
    var beta_vec: BjFieldVector = BjFieldVector_new(bx, by, bz);
    var beta_dot: BjFieldVector = BjFieldVector_new(dx, dy, dz);
    var dq: f64 = charge - charge;
    if (dq != 0.0) {
        if (_bj_vx_finite4(rx, ry, rz, 0.0) == 0) {    # Rust's ∞ R makes n̂, κ and every part NaN
            var nan: f64 = _BJ_REL_NAN;
            e_out.x = nan;
            e_out.y = nan;
            e_out.z = nan;
            b_out.x = nan;
            b_out.y = nan;
            b_out.z = nan;
            return Ok(0);
        }
    } elif (_bj_rel_fields_plain(&r_vec, &n_hat, &beta_vec, &beta_dot, &st, r_mag) == 0) {
        var t1, v1 = _bj_rel_fields_edge(charge, observer_pos, &st, e_out, b_out);
        if (is_err_result(t1) == 1) { return Err(v1); }
        return Ok(0);
    }
    var e: BjFieldVector;
    var boxed: i64[1];
    boxed[0] = 0;
    var te, ve = _bj_rel_e_impl(charge, r_vec, beta_vec, beta_dot, &e, &boxed);
    if (is_err_result(te) == 1) { return Err(ve); }
    if (dq == 0.0 && _bj_rel_e_exact3(&e, boxed[0]) == 0) {
        var t2, v2 = _bj_rel_fields_edge(charge, observer_pos, &st, e_out, b_out);
        if (is_err_result(t2) == 1) { return Err(v2); }
        return Ok(0);
    }
    var b: BjFieldVector = bj_lienard_wiechert_b(n_hat, e);
    e_out.x = e.x;
    e_out.y = e.y;
    e_out.z = e.z;
    b_out.x = b.x;
    b_out.y = b.y;
    b_out.z = b.z;
    return Ok(0);
}

# 2^1022: an |R| above it makes 1/|R| subnormal.
var _BJ_REL_R_INV: f64 = 0x7FD0000000000000;

# 1 when lienard_wiechert_fields' chain up to E is the unbounded one (ADR 0002 row 18's rule, M2 part 2d-3j), given R,
# n̂ = R·(1/|R|), β = v/c and β̇ = a/c (at the byte addresses r, n, bv and bd), the trajectory's state st and |R|: R
# finite (a difference of finite doubles is otherwise its 53-bit value, a subnormal one exact), |R| ≤ 2^1022 (1/|R|
# normal), and each part of n̂, β and β̇ normal or an exact zero (of a zero part of R, v or a).
#must_use
fn _bj_rel_fields_plain(r, n, bv, bd, st: *f64, r_mag: f64): i64 {
    if (!(r_mag <= _BJ_REL_R_INV)) { return 0; }
    var rp: *f64 = _bj_rel_f64p(r);
    var np: *f64 = _bj_rel_f64p(n);
    var bp: *f64 = _bj_rel_f64p(bv);
    var dp: *f64 = _bj_rel_f64p(bd);
    for (var i = 0; i < 3; i = i + 1) {
        var x: f64 = rp[i];
        var ax: f64 = f64_abs(x);
        if (!(ax <= _BJ_VX_HI)) { return 0; }
        var an: f64 = f64_abs(np[i]);
        if (!(an >= _BJ_VX_MN) && x != 0.0) { return 0; }
        var ab: f64 = f64_abs(bp[i]);
        if (!(ab >= _BJ_VX_MN) && st[3 + i] != 0.0) { return 0; }
        var ad: f64 = f64_abs(dp[i]);
        if (!(ad >= _BJ_VX_MN) && st[6 + i] != 0.0) { return 0; }
    }
    return 1;
}

# 1 when each part of E (at the byte address e) is its 53-bit value, as B needs it: normal and finite, or 0 where Rust's
# chain ran inside E's box (its zeros exact there).
#must_use
fn _bj_rel_e_exact3(e, boxed): i64 {
    var ep: *f64 = _bj_rel_f64p(e);
    for (var i = 0; i < 3; i = i + 1) {
        var x: f64 = ep[i];
        var ax: f64 = f64_abs(x);
        if (x == 0.0) {
            if (boxed == 0) { return 0; }
        } elif (!(ax >= _BJ_VX_MN && ax <= _BJ_VX_HI)) {
            return 0;
        }
    }
    return 1;
}

# lienard_wiechert_fields off its common case (ADR 0002 row 18's rule, M2 part 2d-3j), for a finite charge, into e_out
# and b_out: R = r_obs − r(t_r), β = v/c and β̇ = a/c to 53 bits with an unbounded exponent (an R past DBL_MAX and a β
# below 2^-1022 in the exact kernels' offset forms, M2 part 2d-3i); E's checks on them (|β| < 1 and γ² by
# _bj_cr_lorentz, κ < 10^-30 and n̂ − β by _bj_cr_lw); E's tail on the pairs (_bj_rel_e_tail); B = n̂ × E/c from n̂'s
# and E's 53-bit values, each part rounded once. The Singularity test is the caller's (exact on r_obs and r(t_r)); the
# outs untouched on an error.
fn _bj_rel_fields_edge(charge: f64, obs: *f64, st: *f64, e_out: *BjFieldVector, b_out: *BjFieldVector): Result {
    var cs, ce = _bj_k_ux_from(BJ_SPEED_OF_LIGHT);
    var rs: f64[3];
    var re: i64[3];
    var rd: f64[3];
    var bv: f64[3];
    var ds: f64[3];
    var de: i64[3];
    var xo: i64[6];
    var bo: i64[3];
    for (var i = 0; i < 3; i = i + 1) {
        var os, oe = _bj_k_ux_from(obs[i]);
        var ps, pe = _bj_k_ux_from(st[i]);
        var xs, xe = _bj_k_ux_sub(os, oe, ps, pe);
        rs[i] = xs;
        re[i] = xe;
        var x: f64 = obs[i] - st[i];                # Rust's double: the pair's value unless it passed DBL_MAX
        var ax: f64 = f64_abs(x);
        rd[i] = x;
        xo[i] = 0;
        if (!(ax <= _BJ_VX_HI)) {
            rd[i] = xs;
            xo[i] = xe;
        }
        var vs, ve = _bj_k_ux_from(st[3 + i]);
        var qs, qe = _bj_k_ux_div(vs, ve, cs, ce);
        var bq: f64 = _bj_k_ux_mul_f64(qs, qe, 1.0, 0);
        bv[i] = bq;
        bo[i] = 0;
        if (qs != 0.0 && qe < 0 - 1022) {           # below 2^-1022: the offset form, its significand normal
            bv[i] = qs;
            bo[i] = qe;
        }
        xo[3 + i] = bo[i];
        var as, ae = _bj_k_ux_from(st[6 + i]);
        var us, ue = _bj_k_ux_div(as, ae, cs, ce);
        ds[i] = us;
        de[i] = ue;
    }
    var g2: f64[1];
    if (_bj_cr_lorentz(&bv, &bo, 3, 1.0, 1, 0, &g2) == 0) { return Err(_bj_err_invalid_parameter("β must be < 1")); }
    var ko: f64[4];
    if (_bj_cr_lw(&rd, &bv, &xo, 2, 0, &ko) == 1) {
        return Err(_bj_err_division_by_zero("Liénard-Wiechert denominator (1 − n̂⋅β) is zero"));
    }
    var nm: f64[3];
    nm[0] = ko[1];
    nm[1] = ko[2];
    nm[2] = ko[3];
    var o: f64[15];
    _bj_rel_e_tail(charge, &rs, &re, ko[0], g2[0], &nm, &ds, &de, &o);
    var es: f64[3];
    var ee: i64[3];
    var ns: f64[3];
    var ne: i64[3];
    for (var j = 0; j < 3; j = j + 1) {
        es[j] = o[3 + j];
        ee[j] = f64_to(o[6 + j]);
        ns[j] = o[9 + j];
        ne[j] = f64_to(o[12 + j]);
    }
    var inv: f64 = 1.0 / BJ_SPEED_OF_LIGHT;
    var is, ie = _bj_k_ux_from(inv);
    var bb: f64[3];
    for (var j2 = 0; j2 < 3; j2 = j2 + 1) {
        var cps, cpe = _bj_rel_cross_pp(&ns, &ne, &es, &ee, j2);
        var bj: f64 = _bj_k_ux_mul_f64(cps, cpe, is, ie);
        bb[j2] = bj;
    }
    e_out.x = o[0];
    e_out.y = o[1];
    e_out.z = o[2];
    b_out.x = bb[0];
    b_out.y = bb[1];
    b_out.z = bb[2];
    return Ok(0);
}
