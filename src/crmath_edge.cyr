# crmath_edge.cyr — bijli's values at their own pole or zero (M2 part 2c, ADR 0002 row 17, the user's answer of
# 2026-11-12: exact tests, accurate values). A test that decides where its value has a pole or a zero is made on the
# exact quantity, and the value beside it comes from exact differences, correctly rounded, so the two agree: an input
# the exact test accepts never gets a value of ∞, 0 or NaN from a cancellation, and one it refuses carries the exact
# value's sign. Clausius–Mossotti's ε_r (M2 part 2c-2), the trig-free Fresnel cosine (2c-3), the Liénard–Wiechert
# R_eff and κ (2c-4) and the parallel combinations (2c-5) are here.
#
# Clausius–Mossotti (M2 part 2c-2). ε_r = (1 + 2X)/(1 − X) with X = Nα/(3ε₀) is (3ε₀ + 2P)/(3ε₀ − P), P = Nα exactly
# and ε₀ its double. X ≥ 1 is 3ε₀ − P ≤ 0, and below it ε_r ≤ 0 is 3ε₀ + 2P ≤ 0. The value ε_r is rounded once (to
# nearest, ties to even). The parts: 3ε₀ = t_h + t_l (FastTwoSum(2ε₀, ε₀)) and P = b_h + b_l (TwoProduct) exactly, so
# num = t_h + t_l + 2b_h + 2b_l and den = t_h + t_l − b_h − b_l, four doubles each.
#
# The rough X. χ = RN(RN(Nα)/RN(3ε₀)) is within 3.02u of X (u = 2^-53) when Nα doesn't under- or overflow. |χ| < 2^-60
# (Nα underflowing included) puts |ε_r − 1| = 3|X|/(1 − X) below 2^-57, inside 1's rounding interval: ε_r rounds to
# 1. |χ| ≥ 2^136 (Nα overflowing included) puts |X| above 2^135: X ≥ 1 for α > 0, and for α < 0 ε_r = −2 + 3/(1 − X)
# lies within 2^-133 above −2, so it rounds to −2. Between, |P| lies in [2^-95.4, 2^101.6], so its exponent sum is in
# [−97, 101], b_h in [2^-97, 2^103], and b_l a multiple of 2^-201: no part under- or overflows, and every step is
# exact. With both exponents in [−500, 500], TwoProduct runs on α and N themselves (inline; Veltkamp's split doesn't
# overflow, and every partial product's least bit is at least lsb(α)·lsb(N) = 2^(e_N + e_α − 104) ≥ 2^-201, so each
# is exact); otherwise on α and N scaled to [1, 2), its parts then scaled by 2^(e_N + e_α). Both give the same
# b_h = RN(P) and b_l.
#
# Fast region, χ ∈ [−0.24, 0.49] (X ∈ [−¼, ½], no cancellation): (s, e) = TwoSum(t_h, 2b_h) exactly, then
# RN(RN(e + t_l) + 2b_l), then FastTwoSum: within 5.02u²·(|t_h| + 2|b_h|), relative 5.02u²·(1 + 2|X|)/(1 + 2X)
# ≤ 15.06u²; likewise den within 5.02u²·(1 + |X|)/(1 − X) ≤ 15.06u², and the two together never above 20.1u² (at
# X = −¼ or ½).
# Elsewhere num and den are Shewchuk expansions of their four parts (src/crmath_gamma.cyr's _bj_g_grow, exact): the
# largest component's sign is the sum's, which decides X ≥ 1 and ε_r ≤ 0 exactly, and Compress gives each within
# 2^-104. kimiya's rounding test (_bj_k_dd_div_cr, src/crmath_kx.cyr: inputs within 32u² together) then rounds
# |num|/den.
#
# The range. A nonzero num is a multiple of 2^min(−89, e − 103) and den of 2^min(−89, e − 104), e the exponent sum, and
# they cancel only when |P| is near 1.5ε₀ or 3ε₀ (e in [−38, −35]), so a nonzero |ε_r| lies in [2^-109, 2^110].
#
# The exact check, when the test fails (a value within about 2^-99 of a midpoint, relative; or always, for slow = 1):
# the candidate y = z₁ of _bj_k_dd_div_ends lies within an ulp of RN(v), v = |num|/den, so the signs of v − μ at the
# midpoints μ = y ± ulp/2 decide it, ties to even. With den > 0, v − μ has the sign of |num| − y·den − h·den
# (h = ±ulp/2, a power of two): sixteen doubles (num's four; y·dᵢ by TwoProduct, eight; h·dᵢ exactly, four), summed
# exactly by kimiya's _bj_k_exp_sign. Their least bit is 2^-362 or above (y ≥ 2^-109, dᵢ a multiple of 2^-201), and
# their sum below 2^215: no product under- or overflows. cr_verify.py's cm and cm_slow families check every path
# against Python's Fraction, on x86_64 and aarch64.

# (s, e) with x = s·2^e and 1 ≤ |s| < 2, s keeping x's sign, exactly, for a finite nonzero x (a subnormal is scaled by
# 2^54 first).
#must_use
fn _bj_e_frexp(x: f64): (f64, i64) {
    var b = _bj_bits(x);
    var ex = (b >> 52) & 0x7FF;
    var adj = 0;
    if (ex == 0) {
        var k54: f64 = 0x4350000000000000;          # 2^54
        var y: f64 = x * k54;
        b = _bj_bits(y);
        ex = (b >> 52) & 0x7FF;
        adj = 54;
    }
    var sg = b - (b & 0x7FFFFFFFFFFFFFFF);
    var s: f64 = _bj_from_bits(sg | (b & 0xFFFFFFFFFFFFF) | 0x3FF0000000000000);
    var e = ex - 1023 - adj;
    return (s, e);
}

# The sign (−1, 0 or 1) of g·num − (y + h)·den, exactly, for the parts c = (t_h, t_l, b_h, b_l) (num = t_h + t_l + 2b_h
# + 2b_l, den = t_h + t_l − b_h − b_l), g = ±1, y ≥ 2^-110 and h ±(a power of two) (the header's exact check).
#must_use
fn _bj_e_side(c: *f64, g: f64, y: f64, h: f64): i64 {
    var t: f64[16];
    var th: f64 = c[0];
    var tl: f64 = c[1];
    var bh: f64 = c[2];
    var bl: f64 = c[3];
    t[0] = g * th;
    t[1] = g * tl;
    var bh2: f64 = bh * 2.0;
    var bl2: f64 = bl * 2.0;
    t[2] = g * bh2;
    t[3] = g * bl2;
    var d: f64[4];
    d[0] = th;
    d[1] = tl;
    d[2] = -bh;
    d[3] = -bl;
    for (var i = 0; i < 4; i = i + 1) {
        var di: f64 = d[i];
        var p, e = _bj_k_two_prod(y, di);
        var pp: f64 = p;
        var pe: f64 = e;
        t[4 + 2 * i] = -pp;
        t[5 + 2 * i] = -pe;
        var hd: f64 = h * di;
        t[12 + i] = -hd;
    }
    return _bj_k_exp_sign(&t, 16);
}

# RN(v) for v = g·num/den > 0, from a candidate y within an ulp of it (the header's exact check).
#must_use
fn _bj_e_settle(c: *f64, g: f64, y: f64): f64 {
    var up: f64 = _bj_g_step(y, 1);
    var hu: f64 = (up - y) * 0.5;
    var su = _bj_e_side(c, g, y, hu);
    if (su > 0) { return up; }
    if (su == 0) {
        var eu: f64 = _bj_g_even(y, up);
        return eu;
    }
    var dn: f64 = _bj_g_step(y, 0 - 1);
    var hd: f64 = (dn - y) * 0.5;
    var sd = _bj_e_side(c, g, y, hd);
    if (sd < 0) { return dn; }
    if (sd == 0) {
        var ed: f64 = _bj_g_even(dn, y);
        return ed;
    }
    return y;
}

# Clausius–Mossotti (the header): 1 when X = Nα/(3ε₀) ≥ 1 exactly; otherwise 0, with out[0] := RN(ε_r) for
# ε_r = (3ε₀ + 2Nα)/(3ε₀ − Nα), which is ≤ 0 exactly when ε_r is. For finite α and N ≥ 0. slow = 1 skips the rounding
# test, so the exact check always runs (cr_verify.py's cm_slow).
#must_use
fn _bj_cr_clausius(alpha: f64, n: f64, slow, out: *f64): i64 {
    var na: f64 = n * alpha;
    var three: f64 = 3.0 * BJ_EPSILON_0;
    var chi: f64 = na / three;
    var ac: f64 = f64_abs(chi);
    var lo60: f64 = 0x3C30000000000000;             # 2^-60
    if (ac < lo60) {
        out[0] = 1.0;
        return 0;
    }
    var hi136: f64 = 0x4870000000000000;            # 2^136
    if (ac >= hi136) {
        if (chi > 0.0) { return 1; }
        out[0] = -2.0;
        return 0;
    }
    var t_h: f64 = three;
    var two: f64 = 2.0 * BJ_EPSILON_0;
    var t_l: f64 = BJ_EPSILON_0 - (three - two);   # FastTwoSum(2ε₀, ε₀)'s error: 3ε₀ = t_h + t_l
    var bh: f64 = na;
    var bl: f64 = 0.0;
    var xn = (_bj_bits(n) >> 52) - 1023;            # n > 0 here
    var xa = ((_bj_bits(alpha) >> 52) & 0x7FF) - 1023;
    if (xn >= 0 - 500 && xn <= 500 && xa >= 0 - 500 && xa <= 500) {
        var sp: f64 = 134217729.0;                  # n·α = b_h + b_l: TwoProduct, inline (Veltkamp's 2^27 + 1 split)
        var cn: f64 = sp * n;
        var nhh: f64 = cn - (cn - n);
        var nhl: f64 = n - nhh;
        var ca: f64 = sp * alpha;
        var ahh: f64 = ca - (ca - alpha);
        var ahl: f64 = alpha - ahh;
        bl = (nhl * ahl) - (((na - (nhh * ahh)) - (nhl * ahh)) - (nhh * ahl));
    } else {
        var sn, en = _bj_e_frexp(n);
        var sa, ea = _bj_e_frexp(alpha);
        var fn1: f64 = sn;
        var fa1: f64 = sa;
        var ph, pl = _bj_k_two_prod(fn1, fa1);
        var k: f64 = _bj_g_pow2(en + ea);
        var p_h: f64 = ph;
        var p_l: f64 = pl;
        bh = p_h * k;
        bl = p_l * k;
    }
    var c: f64[4];
    c[0] = t_h;
    c[1] = t_l;
    c[2] = bh;
    c[3] = bl;
    var nh: f64 = 0.0;
    var nl: f64 = 0.0;
    var dh: f64 = 0.0;
    var dl: f64 = 0.0;
    var g: f64 = 1.0;
    if (chi >= -0.24 && chi <= 0.49) {
        var bh2: f64 = bh * 2.0;
        var bl2: f64 = bl * 2.0;
        var s1: f64 = t_h + bh2;                    # num: TwoSum(t_h, 2b_h), inline
        var v1: f64 = s1 - t_h;
        var e1: f64 = (t_h - (s1 - v1)) + (bh2 - v1);
        var r1: f64 = (e1 + t_l) + bl2;
        nh = s1 + r1;                               # FastTwoSum(s1, r1)
        nl = r1 - (nh - s1);
        var mbh: f64 = -bh;
        var s2: f64 = t_h + mbh;                    # den: TwoSum(t_h, −b_h), inline
        var v2: f64 = s2 - t_h;
        var e2: f64 = (t_h - (s2 - v2)) + (mbh - v2);
        var r2: f64 = (e2 + t_l) - bl;
        dh = s2 + r2;                               # FastTwoSum(s2, r2)
        dl = r2 - (dh - s2);
    } else {
        var de: f64[4];
        var kd = 0;
        var mbl: f64 = -bl;
        var mbh2: f64 = -bh;
        kd = _bj_g_grow(&de, kd, t_l);
        kd = _bj_g_grow(&de, kd, t_h);
        kd = _bj_g_grow(&de, kd, mbl);
        kd = _bj_g_grow(&de, kd, mbh2);
        if (kd == 0) { return 1; }
        var dtop: f64 = de[kd - 1];
        if (dtop < 0.0) { return 1; }
        var ne: f64[4];
        var kn = 0;
        var nbl: f64 = bl * 2.0;
        var nbh: f64 = bh * 2.0;
        kn = _bj_g_grow(&ne, kn, t_l);
        kn = _bj_g_grow(&ne, kn, t_h);
        kn = _bj_g_grow(&ne, kn, nbl);
        kn = _bj_g_grow(&ne, kn, nbh);
        if (kn == 0) {
            out[0] = 0.0;
            return 0;
        }
        var ntop: f64 = ne[kn - 1];
        if (ntop < 0.0) { g = -1.0; }
        var ch, cl = _bj_g_compress(&ne, kn);
        var c_h: f64 = ch;
        var c_l: f64 = cl;
        nh = g * c_h;
        nl = g * c_l;
        var gh, gl = _bj_g_compress(&de, kd);
        dh = gh;
        dl = gl;
    }
    if (slow == 0) {
        var q, ok = _bj_k_dd_div_cr(nh, nl, dh, dl);
        if (ok == 1) {
            var qq: f64 = q;
            var r: f64 = g * qq;
            out[0] = r;
            return 0;
        }
    }
    var z1, z2 = _bj_k_dd_div_ends(nh, nl, dh, dl);
    var zz: f64 = z1;
    var y: f64 = _bj_e_settle(&c, g, zz);
    var ry: f64 = g * y;
    out[0] = ry;
    return 0;
}

# ── the trig-free Fresnel cosine (M2 part 2c-3) ──────────────────────────────────────────────────────────────────────
#
# cos θ_t = √(1 − (n₁/n₂)²(1 − c²)) for c = cos θ_i in [0, 1] is √D/b with D = b² − a²(1 − c²) = b² − a² + (ac)²,
# where a = n₁·2^-k and b = n₂·2^-k ∈ [1, 2) (k n₂'s exponent: the scaling is exact and changes nothing). Total
# internal reflection, sin²θ_t > 1, is D < 0 exactly, and cos θ_t is √D/b rounded once.
#
# Shortcuts. n₁ = n₂ gives D = (ac)², so cos θ_t = |c| exactly (+0 for c = −0); c = 1 gives cos θ_t = 1. Otherwise
# c < 1, so 1 − c² ≥ 2^-52: a ratio n₁/n₂ above 2^27 (exponent difference d ≥ 28) is TIR, and one below 2^-61
# (d ≤ −62) leaves cos θ_t within 2^-122 of 1, which rounds to 1. Between, a lies in (2^-62, 2^29), and every square
# below is exact.
#
# A c below 2^-300 is taken as 0 in D. With c = 0, D = b² − a² is a nonzero multiple of 2^-228 (a ≠ b), and D − μ²b² is
# never 0 at a dyadic μ: μb = p and a² + p² = b² would make a Pythagorean triple whose hypotenuse b·2^j has an odd part
# dividing p's, so the odd part is 1 and a or p is 0. So D − μ²b² is a nonzero multiple of 2^-442 at every midpoint μ
# (μ ≥ 2^-115 there), far above (ac)² < 2^-542: dropping c moves neither the sign of D nor any midpoint comparison.
#
# The range. A nonzero D lies in [2^-620, 4]: if (ac)² < 2^-229, |D| ≥ |b² − a²| − (ac)² ≥ 2^-229; otherwise
# c ≥ 2^-143.5, and every part of D is a multiple of 2^-620. So cos θ_t ≥ 2^-311.
#
# Fast region, M = a²(1 − c²) ≤ b²/2 (sin²θ_t ≤ ½): 1 − c² = s_h + s_l from TwoProduct(c, c) and FastTwoSum(1, −c²)
# (exact for c² ≥ ½, within 1.5u² relative below), M by kimiya's _bj_k_dd_mul (8.01u²), D = b² − M by TwoSum within
# 9.05u², so 18.6u² with M's error carried (D ≥ M); √D by src/crmath_gamma.cyr's _bj_g_sqrt_dd (half of that, plus
# 6.06u²): 15.4u², inside _bj_k_dd_div_cr's 32u². Near the critical angle (M > b²/2) D is the Shewchuk expansion of
# its ten parts (b², −a², (ac)² = t_h² + 2t_h·t_l + t_l², TwoProducts), whose top component's sign decides TIR,
# compressed to within 2^-104 (with the root's 6.06u²: 8.06u²). The exact check, when a rounding test fails (or always,
# for slow = 1): at the candidate y's two neighbouring midpoints μ = y ± h, D − (μb)² is exactly the sum of D's ten
# parts and the twelve of −(g₁ + g₂ + w)² (y·b = g₁ + g₂ by TwoProduct, w = h·b exactly: three squares and three
# doubled products), whose least bits are at or above 2^-834 (y ≥ 2^-311), ties to even. cr_verify.py's cos_t and
# cos_t_slow families check it against Python's Fraction and an integer square root, on x86_64 and aarch64.

# D's parts into t (b², −a², and (ac)²'s six when c ≠ 0, each by TwoProduct); returns their count.
#must_use
fn _bj_e_dparts(a: f64, b: f64, c: f64, t: *f64): i64 {
    var bh, bl = _bj_k_two_prod(b, b);
    var ah, al = _bj_k_two_prod(a, a);
    var b_h: f64 = bh;
    var b_l: f64 = bl;
    var a_h: f64 = ah;
    var a_l: f64 = al;
    t[0] = b_h;
    t[1] = b_l;
    t[2] = -a_h;
    t[3] = -a_l;
    if (c == 0.0) { return 4; }
    var th, tl = _bj_k_two_prod(a, c);
    var t_h: f64 = th;
    var t_l: f64 = tl;
    var p1, e1 = _bj_k_two_prod(t_h, t_h);
    var p2, e2 = _bj_k_two_prod(t_h, t_l);
    var p3, e3 = _bj_k_two_prod(t_l, t_l);
    var q1: f64 = p1;
    var r1: f64 = e1;
    var q2: f64 = p2;
    var r2: f64 = e2;
    var q3: f64 = p3;
    var r3: f64 = e3;
    t[4] = q1;
    t[5] = r1;
    t[6] = q2 * 2.0;
    t[7] = r2 * 2.0;
    t[8] = q3;
    t[9] = r3;
    return 10;
}

# The sign (−1, 0 or 1) of the exact sum of the n ≤ 24 doubles at t (Shewchuk's Grow-Expansion: the top component's).
#must_use
fn _bj_e_sum_sign(t: *f64, n): i64 {
    var ex: f64[24];
    var k = 0;
    for (var i = 0; i < n; i = i + 1) {
        var ti: f64 = t[i];
        k = _bj_g_grow(&ex, k, ti);
    }
    if (k == 0) { return 0; }
    var top: f64 = ex[k - 1];
    if (top > 0.0) { return 1; }
    return 0 - 1;
}

# The sign of D − ((y + h)·b)², exactly (the section comment's exact check).
#must_use
fn _bj_e_cos_side(a: f64, b: f64, c: f64, y: f64, h: f64): i64 {
    var t: f64[24];
    var n = _bj_e_dparts(a, b, c, &t);
    var g1, g2 = _bj_k_two_prod(y, b);
    var x: f64[3];
    var gg1: f64 = g1;
    var gg2: f64 = g2;
    x[0] = gg1;
    x[1] = gg2;
    x[2] = h * b;
    for (var i = 0; i < 3; i = i + 1) {
        for (var j = i; j < 3; j = j + 1) {
            var xi: f64 = x[i];
            var xj: f64 = x[j];
            var p, e = _bj_k_two_prod(xi, xj);
            var pp: f64 = p;
            var pe: f64 = e;
            if (j != i) {
                pp = pp * 2.0;
                pe = pe * 2.0;
            }
            t[n] = -pp;
            t[n + 1] = -pe;
            n = n + 2;
        }
    }
    return _bj_e_sum_sign(&t, n);
}

# RN(√D/b) from a candidate y within an ulp of it (the section comment's exact check).
#must_use
fn _bj_e_cos_settle(a: f64, b: f64, c: f64, y: f64): f64 {
    var up: f64 = _bj_g_step(y, 1);
    var hu: f64 = (up - y) * 0.5;
    var su = _bj_e_cos_side(a, b, c, y, hu);
    if (su > 0) { return up; }
    if (su == 0) {
        var eu: f64 = _bj_g_even(y, up);
        return eu;
    }
    var dn: f64 = _bj_g_step(y, 0 - 1);
    var hd: f64 = (dn - y) * 0.5;
    var sd = _bj_e_cos_side(a, b, c, y, hd);
    if (sd < 0) { return dn; }
    if (sd == 0) {
        var ed: f64 = _bj_g_even(dn, y);
        return ed;
    }
    return y;
}

# The trig-free Fresnel cosine (the section comment): 1 under total internal reflection (n₁²(1 − c²) > n₂² exactly);
# otherwise 0, with out[0] := RN(cos θ_t), cos θ_t = √(n₂² − n₁²(1 − c²))/n₂. For positive finite n₁, n₂ and c in
# [0, 1]. slow = 1 skips the rounding tests, so the exact check always runs (cr_verify.py's cos_t_slow).
#must_use
fn _bj_cr_cos_t(n1: f64, n2: f64, c: f64, slow, out: *f64): i64 {
    if (n1 == n2) {
        var ac: f64 = f64_abs(c);
        out[0] = ac;
        return 0;
    }
    if (c == 1.0) {
        out[0] = 1.0;
        return 0;
    }
    var w1 = _bj_bits(n1);
    var w2 = _bj_bits(n2);
    var f1 = w1 >> 52;
    var f2 = w2 >> 52;
    var a: f64 = 0.0;
    var b: f64 = 0.0;
    var d = 0;
    if (f1 != 0 && f2 != 0) {
        d = f1 - f2;
        if (d >= 28) { return 1; }
        if (d <= 0 - 62) {
            out[0] = 1.0;
            return 0;
        }
        b = _bj_from_bits((w2 & 0xFFFFFFFFFFFFF) | 0x3FF0000000000000);
        a = _bj_from_bits(w1 - ((f2 - 1023) << 52));
    } else {
        var s1, x1 = _bj_e_frexp(n1);
        var s2, x2 = _bj_e_frexp(n2);
        d = x1 - x2;
        if (d >= 28) { return 1; }
        if (d <= 0 - 62) {
            out[0] = 1.0;
            return 0;
        }
        var ss1: f64 = s1;
        var ss2: f64 = s2;
        b = ss2;
        a = _bj_from_bits(_bj_bits(ss1) + (d << 52));
    }
    var cc: f64 = c;
    var lo300: f64 = 0x2D30000000000000;            # 2^-300
    if (cc < lo300) { cc = 0.0; }
    var sp: f64 = 134217729.0;                      # TwoProducts inline (Veltkamp's 2^27 + 1 split)
    var p: f64 = cc * cc;
    var kc: f64 = sp * cc;
    var ch: f64 = kc - (kc - cc);
    var cl: f64 = cc - ch;
    var pe: f64 = (cl * cl) - (((p - (ch * ch)) - (cl * ch)) - (ch * cl));
    var s1f: f64 = 1.0 - p;                         # 1 − c² = s_h + s_l: FastTwoSum(1, −p), then −pe
    var zf: f64 = s1f - 1.0;
    var mp: f64 = -p;
    var er: f64 = mp - zf;
    var sr: f64 = er - pe;
    var s_h: f64 = s1f + sr;
    var s_l: f64 = sr - (s_h - s1f);
    var a2: f64 = a * a;
    var ka: f64 = sp * a;
    var ahh: f64 = ka - (ka - a);
    var ahl: f64 = a - ahh;
    var a2e: f64 = (ahl * ahl) - (((a2 - (ahh * ahh)) - (ahl * ahh)) - (ahh * ahl));
    var b2: f64 = b * b;
    var kb: f64 = sp * b;
    var bhh: f64 = kb - (kb - b);
    var bhl: f64 = b - bhh;
    var b2e: f64 = (bhl * bhl) - (((b2 - (bhh * bhh)) - (bhl * bhh)) - (bhh * bhl));
    var mh, ml = _bj_k_dd_mul(a2, a2e, s_h, s_l);
    var m_h: f64 = mh;
    var m_l: f64 = ml;
    var half: f64 = 0.5 * b2;
    var rh: f64 = 0.0;
    var rl: f64 = 0.0;
    if (m_h <= half) {
        var mmh: f64 = -m_h;
        var t0: f64 = b2 + mmh;                     # D = b² − M: TwoSum(b², −M_h), inline
        var v0: f64 = t0 - b2;
        var t1: f64 = (b2 - (t0 - v0)) + (mmh - v0);
        var w0: f64 = (t1 + b2e) - m_l;
        var dh: f64 = t0 + w0;                      # FastTwoSum(t0, w0)
        var dl: f64 = w0 - (dh - t0);
        var qh, ql = _bj_g_sqrt_dd(dh, dl);
        rh = qh;
        rl = ql;
    } else {
        var dp: f64[10];
        var nd = _bj_e_dparts(a, b, cc, &dp);
        var ex: f64[16];
        var k = 0;
        for (var i = 0; i < nd; i = i + 1) {
            var di: f64 = dp[i];
            k = _bj_g_grow(&ex, k, di);
        }
        if (k == 0) {
            out[0] = 0.0;
            return 0;
        }
        var top: f64 = ex[k - 1];
        if (top < 0.0) { return 1; }
        var gh, gl = _bj_g_compress(&ex, k);
        var g_h: f64 = gh;
        var g_l: f64 = gl;
        var uh, ul = _bj_g_sqrt_dd(g_h, g_l);
        rh = uh;
        rl = ul;
    }
    if (slow == 0) {
        var y, ok = _bj_k_dd_div_cr(rh, rl, b, 0.0);
        if (ok == 1) {
            var yy: f64 = y;
            out[0] = yy;
            return 0;
        }
    }
    var z1, z2 = _bj_k_dd_div_ends(rh, rl, b, 0.0);
    var zz: f64 = z1;
    var r: f64 = _bj_e_cos_settle(a, b, cc, zz);
    out[0] = r;
    return 0;
}

# ── the Liénard–Wiechert R_eff and κ (M2 part 2c-4) ──────────────────────────────────────────────────────────────────
#
# R_eff = |R| − R⋅β = √S − P and κ = 1 − n̂⋅β = R_eff/√S, S = ΣRᵢ² and P = ΣRᵢβᵢ exactly, for a finite R ≠ 0 and
# |β| < 1 exactly (the callers' checks). Each is rounded once, and κ < 10^-30 (lienard_wiechert_e's DivisionByZero)
# is decided exactly. Rust's |R| − R⋅β and 1 − n̂⋅β cancel as n̂⋅β → 1, a relative error of about 2^-53/κ.
#
# The range. D = 1 − Σβᵢ² ≥ 2^-266 for doubles with |β| < 1. Order |β₁| ≥ |β₂| ≥ |β₃|; |β₁| < ½ gives D > ¼.
# Otherwise T₁ = 1 − β₁² ≥ 2^-53 is a multiple of 2^-106. D < T₁/2 needs β₂² ≥ T₁/4, so |β₂| ≥ 2^-28 and
# T₂ = T₁ − β₂² is a positive multiple of 2^-160. D < T₂/2 needs |β₃| ≥ 2^-81, so D is a positive multiple of 2^-266.
# κ ≥ 1 − |β| > D/2 and κ < 2, so κ lies in (2^-267, 2), and R_eff = κ|R| is never under 2^-367 (|R| ≥ 10^-30).
#
# Scaling. Both are scale-free in R, R_eff but for its factor. R' = R·2^-k, with k the largest component's exponent
# (at most 1022), puts the largest |R'ᵢ| in [1, 4). A component that falls under 2^-1022 rounds, an absolute error
# below 2^-1075.
#
# The parts (u = 2^-53). Each R'ᵢ and βᵢ is split once (Veltkamp), and every product is Dekker's TwoProduct on the
# halves, exact. The double-word sums are AccurateDWPlusDW (Joldes, Muller and Popescu, "Tight and rigorous error
# bounds for basic building blocks of double-word arithmetic", ACM TOMS 44 (2017), Algorithm 6): within 3u²/(1 − 4u)
# of the exact sum of two double-words, whatever their signs.
#   - S: two TwoSums of the squares' heads, then their errors and the squares' lows added in turn, within 12.04u².
#   - P: the same, with a last TwoSum, within 12.05u²·Σ|R'ᵢβᵢ|, at most 12.05u²·√S' (Cauchy–Schwarz, |β| < 1).
#   - √S': _bj_g_sqrt_dd's steps (6.06u²) inline, within 12.08u².
#   - An underflowing term's absolute error stays below 2^-1060, under 2^-790 of every quantity it reaches (each is
#     at least 2^-267).
#
# Far from the cone's edge (P ≤ √S/2, so R_eff ≥ 0.4999√S). R_eff = √S − P by AccurateDWPlusDW, within 51.3u², and
# κ = R_eff/√S, with 63.4u² in its operands.
#
# Near the edge (P > √S/2). Lagrange's identity gives N = S − P² = S·D + |R × β|², a sum of non-negative terms, so N
# comes without cancellation from two pieces:
#   - D: the expansion of 1 − Σβᵢ² (Shewchuk's Grow-Expansion, src/crmath_gamma.cyr's), compressed, within 4u².
#   - The cross components Rⱼβₖ − Rₖβⱼ: two TwoProducts and two TwoSums each, exact, joined by AccurateDWPlusDW
#     (3.01u²) and squared by _bj_k_dd_mul (8.01u²).
# N is within 27.1u² (S·D 24.05u², the squares' sum 20.05u²). √S + P is within 19.1u². Then R_eff = N/(√S + P),
# with 46.2u² in its operands, and κ = N/(√S·(√S + P)), with 66.3u².
#
# The rounding test is kimiya's _bj_k_dd_div_cr, with ε = 2^-98 (256u²) in place of 2^-100. It rounds correctly any
# quotient whose operands carry up to 239u² together, and fails about once in 2^44 (_bj_e_round_ends does the same
# for the far R_eff, a double-word within 254u²).
#
# The exact check runs when the test fails (or always, for slow = 1). The candidate's two neighbouring midpoints μ
# decide exactly, ties to even.
#   - Ties occur: R along (1, 2, 2) with β = (½ − 3·2^-54, ½, 0) puts κ on the midpoint ½ + 2^-54.
#   - R_eff − μ has the sign of S − (P + μ)² when P + μ > 0; otherwise it is positive.
#   - κ − μ has the sign of (1 − μ)√S − P: from the signs of 1 − μ and P, or else of (1 − μ)²S − P².
#   - κ < 10^-30 is decided by the test's ends where they clear 10^-30 by 2^-40 (always exactly for slow = 1).
#     Otherwise it is (10^30 − 1)²S < 10^60·P², with P > 0.
# These signs are bignum comparisons (src/fmtf.cyr's bignum, with a product here) in units of 2^m, m the terms' least
# exponent: below 2^6,560, in buffers of 216 words. cr_verify.py's lw_* families check them against Python's
# Fraction and an integer square root, on x86_64 and aarch64.

# AccurateDWPlusDW (the section comment): (x_h + x_l) + (y_h + y_l) as a double-word within 3u²/(1 − 4u) of the exact
# sum, for double-words x and y (x_h = RN(x_h + x_l), likewise y).
#must_use
fn _bj_e_dw_add(xh: f64, xl: f64, yh: f64, yl: f64): (f64, f64) {
    var sh: f64 = xh + yh;                          # TwoSum(x_h, y_h)
    var b1: f64 = sh - xh;
    var sl: f64 = (xh - (sh - b1)) + (yh - b1);
    var th: f64 = xl + yl;                          # TwoSum(x_l, y_l)
    var b2: f64 = th - xl;
    var tl: f64 = (xl - (th - b2)) + (yl - b2);
    var c: f64 = sl + th;
    var vh: f64 = sh + c;                           # FastTwoSum(s_h, c)
    var vl: f64 = c - (vh - sh);
    var w: f64 = tl + vl;
    var zh: f64 = vh + w;                           # FastTwoSum(v_h, w)
    var zl: f64 = w - (zh - vh);
    return (zh, zl);
}

# kimiya's _bj_k_dd_div_cr steps (src/crmath_kx.cyr) with ε = 2^-98·y₀ (256u²) in place of 2^-100: (z₁, z₂), z₁ = z₂
# being RN(n/d) of the exact value whenever the operands' relative errors total at most 239u² (the steps' own 16.2u²
# on top). Otherwise RN of the exact value is z₁ or the double above it. kimiya's conditions on n and d.
#must_use
fn _bj_e_div_ends(nh: f64, nl: f64, dh: f64, dl: f64): (f64, f64) {
    var y0: f64 = nh / dh;
    var a: f64 = y0 * dh;                           # y0·d_h = a + b: TwoProduct, inline (Veltkamp's 2^27 + 1 split)
    var sp: f64 = 134217729.0;
    var cy: f64 = sp * y0;
    var yh: f64 = cy - (cy - y0);
    var yl: f64 = y0 - yh;
    var cd: f64 = sp * dh;
    var dhh: f64 = cd - (cd - dh);
    var dhl: f64 = dh - dhh;
    var b: f64 = (yl * dhl) - (((a - (yh * dhh)) - (yl * dhh)) - (yh * dhl));
    var s: f64 = nh - a;
    var s1: f64 = s - b;
    var s2: f64 = s1 + nl;
    var s3: f64 = y0 * dl;
    var r: f64 = s2 - s3;
    var d: f64 = r / dh;
    var k98: f64 = 0x39D0000000000000;              # 2^-98
    var eps: f64 = y0 * k98;
    var lo: f64 = d - eps;
    var hi: f64 = d + eps;
    var z1: f64 = y0 + lo;
    var z2: f64 = y0 + hi;
    return (z1, z2);
}

# d := a·b for bignums (src/fmtf.cyr's layout), schoolbook on 32-bit limbs with a's limbs in 16-bit halves (every
# partial sum below 2^49). d is distinct from a and b and holds both counts.
fn _bj_e_bn_mul(d, a, b) {
    var na = load64(a);
    var nb = load64(b);
    if (na == 0 || nb == 0) {
        store64(d, 0);
        return 0;
    }
    var n = na + nb;
    for (var i = 0; i < n; i = i + 1) { store64(d + 8 + i * 8, 0); }
    for (var i2 = 0; i2 < na; i2 = i2 + 1) {
        var x = load64(a + 8 + i2 * 8);
        if (x == 0) { continue; }
        var xl = x & 0xFFFF;
        var xh = x >> 16;
        var carry = 0;
        for (var j = 0; j < nb; j = j + 1) {
            var yv = load64(b + 8 + j * 8);
            var lo = xl * yv;
            var hi = xh * yv;
            var at = d + 8 + (i2 + j) * 8;
            var tt = load64(at) + lo + ((hi & 0xFFFF) << 16) + carry;
            store64(at, tt & 0xFFFFFFFF);
            carry = (tt >> 32) + (hi >> 16);
        }
        var kk = i2 + nb;
        while (carry != 0) {
            var at2 = d + 8 + kk * 8;
            var t2 = load64(at2) + carry;
            store64(at2, t2 & 0xFFFFFFFF);
            carry = t2 >> 32;
            kk = kk + 1;
        }
    }
    while (n > 0 && load64(d + n * 8) == 0) { n = n - 1; }
    store64(d, n);
    return 0;
}

# The exact parts as bignums (the section comment), for R' = R·2^-k: s := S_int and pa := |P|_int, with
# S' = S_int·2^u[0] and P' = sgn·|P|_int·2^u[1]; returns sgn (−1, 0 or 1). ng, w and t are scratch bignums.
fn _bj_e_lw_parts(r: *f64, b: *f64, k, s, pa, ng, w, t, u: *i64): i64 {
    var me[16];
    var rm: i64[3];
    var re: i64[3];
    var bm: i64[3];
    var be: i64[3];
    var us = 0;
    var have = 0;
    for (var i = 0; i < 3; i = i + 1) {
        var x: f64 = r[i];
        rm[i] = 0;
        if (x == 0.0) { continue; }
        _bj_g_split(x, &me);
        rm[i] = load64(&me);
        re[i] = load64(&me + 8) - k;
        if (have == 0 || 2 * re[i] < us) {
            us = 2 * re[i];
            have = 1;
        }
    }
    for (var i2 = 0; i2 < 3; i2 = i2 + 1) {
        var y: f64 = b[i2];
        bm[i2] = 0;
        if (y == 0.0) { continue; }
        _bj_g_split(y, &me);
        bm[i2] = load64(&me);
        be[i2] = load64(&me + 8);
    }
    store64(s, 0);
    for (var i3 = 0; i3 < 3; i3 = i3 + 1) {
        if (rm[i3] == 0) { continue; }
        _bj_bn_set(w, rm[i3]);
        _bj_g_mul(w, rm[i3], t);
        _bj_bn_shl(w, 2 * re[i3] - us);
        _bj_g_add_to(s, w);
    }
    var up = 0;
    have = 0;
    for (var i4 = 0; i4 < 3; i4 = i4 + 1) {
        if (rm[i4] == 0 || bm[i4] == 0) { continue; }
        var e = re[i4] + be[i4];
        if (have == 0 || e < up) {
            up = e;
            have = 1;
        }
    }
    store64(pa, 0);
    store64(ng, 0);
    for (var i5 = 0; i5 < 3; i5 = i5 + 1) {
        if (rm[i5] == 0 || bm[i5] == 0) { continue; }
        _bj_bn_set(w, rm[i5]);
        _bj_g_mul(w, bm[i5], t);
        _bj_bn_shl(w, re[i5] + be[i5] - up);
        var neg = ((_bj_bits(r[i5]) ^ _bj_bits(b[i5])) >> 63) & 1;
        if (neg == 1) { _bj_g_add_to(ng, w); } else { _bj_g_add_to(pa, w); }
    }
    u[0] = us;
    u[1] = up;
    var c = _bj_bn_cmp(pa, ng);
    if (c >= 0) {
        _bj_bn_sub(pa, ng);
        return c;
    }
    _bj_bn_sub(ng, pa);
    _bj_bn_copy(pa, ng);
    return 0 - 1;
}

# The exact sign (−1, 0 or 1), for R' = R·2^-k and μ = mm·2^f > 0 (the section comment): of R_eff' − μ (mode 0), of
# κ − μ (mode 1, f < 0), or of κ − 10^-30 (mode 2; mm and f unused).
#must_use
fn _bj_e_lw_sign(r: *f64, b: *f64, k, mode, mm, f): i64 {
    var s[1728];
    var pa[1728];
    var x[1728];
    var y[1728];
    var w[1728];
    var t[1728];
    var u: i64[2];
    var sp = _bj_e_lw_parts(r, b, k, &s, &pa, &x, &w, &t, &u);
    var us = u[0];
    var up = u[1];
    if (mode == 0) {
        var ub = f;                                 # B = P' + μ in units of 2^ub
        if (sp != 0 && up < ub) { ub = up; }
        _bj_bn_set(&x, mm);
        _bj_bn_shl(&x, f - ub);
        if (sp != 0) {
            _bj_bn_copy(&y, &pa);
            _bj_bn_shl(&y, up - ub);
        }
        if (sp > 0) { _bj_g_add_to(&x, &y); }
        if (sp < 0) {
            if (_bj_bn_cmp(&x, &y) <= 0) { return 1; }
            _bj_bn_sub(&x, &y);
        }
        _bj_e_bn_mul(&y, &x, &x);
        var d = us - 2 * ub;
        if (d >= 0) { _bj_bn_shl(&s, d); } else { _bj_bn_shl(&y, 0 - d); }
        var c0 = _bj_bn_cmp(&s, &y);
        return c0;
    }
    var sa = 1;                                     # A = 1 − μ = ±|A_int|·2^ua, or (10^30 − 1)·10^-30 (mode 2)
    var ua = 0;
    if (mode == 1) {
        _bj_bn_set(&x, 1);
        _bj_bn_shl(&x, 0 - f);
        _bj_bn_set(&y, mm);
        var ca = _bj_bn_cmp(&x, &y);
        if (ca > 0) { _bj_bn_sub(&x, &y); }
        if (ca < 0) {
            _bj_bn_sub(&y, &x);
            _bj_bn_copy(&x, &y);
            sa = 0 - 1;
        }
        if (ca == 0) { sa = 0; }
        ua = f;
    } else {
        _bj_bn_set(&x, 1);
        _bj_bn_mul_pow10(&x, 30);
        _bj_bn_set(&y, 1);
        _bj_bn_sub(&x, &y);
    }
    if (sa >= 0 && sp <= 0) {
        if (sa == 0 && sp == 0) { return 0; }
        return 1;
    }
    if (sa <= 0 && sp >= 0) { return 0 - 1; }
    _bj_e_bn_mul(&y, &x, &x);                       # A² in units of 2^(2ua)
    _bj_e_bn_mul(&w, &y, &s);                       # A²S', 2^(2ua + us)
    _bj_e_bn_mul(&y, &pa, &pa);                     # P'², 2^(2up)
    if (mode == 2) { _bj_bn_mul_pow10(&y, 60); }
    var dd = 2 * ua + us - 2 * up;
    if (dd >= 0) { _bj_bn_shl(&w, dd); } else { _bj_bn_shl(&y, 0 - dd); }
    var c2 = _bj_bn_cmp(&w, &y);
    if (sa > 0) { return c2; }
    return 0 - c2;
}

# RN of R_eff' (mode 0) or κ (mode 1) from a candidate y within an ulp of it (the section comment's exact check).
#must_use
fn _bj_e_lw_settle(r: *f64, b: *f64, k, mode, y: f64): f64 {
    var me[16];
    var up: f64 = _bj_g_step(y, 1);
    _bj_g_mid(y, up, &me);
    var su = _bj_e_lw_sign(r, b, k, mode, load64(&me), load64(&me + 8));
    if (su > 0) { return up; }
    if (su == 0) {
        var eu: f64 = _bj_g_even(y, up);
        return eu;
    }
    var dn: f64 = _bj_g_step(y, 0 - 1);
    _bj_g_mid(dn, y, &me);
    var sd = _bj_e_lw_sign(r, b, k, mode, load64(&me), load64(&me + 8));
    if (sd < 0) { return dn; }
    if (sd == 0) {
        var ed: f64 = _bj_g_even(dn, y);
        return ed;
    }
    return y;
}

# z₁ = RN(h + RN(l − ε)) and z₂ = RN(h + RN(l + ε)), ε = 2^-98·h, for a positive double-word h + l within 254u² of an
# exact value v: z₁ = z₂ is RN(v) (RN(l ∓ ε) is within 1.01u²·h of l ∓ ε, so h + RN(l − ε) < v < h + RN(l + ε));
# otherwise RN(v) is z₁ or the double above it.
#must_use
fn _bj_e_round_ends(h: f64, l: f64): (f64, f64) {
    var k98: f64 = 0x39D0000000000000;              # 2^-98
    var eps: f64 = h * k98;
    var lo: f64 = l - eps;
    var hi: f64 = l + eps;
    var z1: f64 = h + lo;
    var z2: f64 = h + hi;
    return (z1, z2);
}

# The cross component x₁y₂ − x₂y₁ as a double-word within 3.01u², from the four doubles and their Veltkamp halves
# (two TwoProducts and two TwoSums, exact, then AccurateDWPlusDW).
#must_use
fn _bj_e_cross_dw(x1: f64, x1h: f64, x1l: f64, y2: f64, y2h: f64, y2l: f64, x2: f64, x2h: f64, x2l: f64, y1: f64,
  y1h: f64, y1l: f64): (f64, f64) {
    var pa: f64 = x1 * y2;                          # x₁y₂ = pa + ea, x₂y₁ = pb + eb (Dekker's, on the halves)
    var ea: f64 = ((((x1h * y2h) - pa) + (x1h * y2l)) + (x1l * y2h)) + (x1l * y2l);
    var pb: f64 = x2 * y1;
    var eb: f64 = ((((x2h * y1h) - pb) + (x2h * y1l)) + (x2l * y1h)) + (x2l * y1l);
    var mb: f64 = -pb;
    var sh: f64 = pa + mb;                          # TwoSum(pa, −pb)
    var b1: f64 = sh - pa;
    var sl: f64 = (pa - (sh - b1)) + (mb - b1);
    var meb: f64 = -eb;
    var th: f64 = ea + meb;                         # TwoSum(ea, −eb)
    var b2: f64 = th - ea;
    var tl: f64 = (ea - (th - b2)) + (meb - b2);
    var zh, zl = _bj_e_dw_add(sh, sl, th, tl);
    return (zh, zl);
}

# The Liénard–Wiechert R_eff (mode 0) or κ (mode 1), the section comment's, for a finite R ≠ 0 at r and |β| < 1
# exactly at b. Mode 0: out[0] := RN(|R| − R⋅β), returning 0. Mode 1: 1 when κ < 10^-30 exactly; otherwise 0, with
# out[0] := RN(1 − R⋅β/|R|). slow = 1 skips the rounding test, so the exact checks always run (cr_verify.py's
# lw_*_slow).
#must_use
fn _bj_cr_lw(r: *f64, b: *f64, mode, slow, out: *f64): i64 {
    var w0 = _bj_bits(r[0]);
    var w1 = _bj_bits(r[1]);
    var w2 = _bj_bits(r[2]);
    var emax = (w0 >> 52) & 0x7FF;
    var e1x = (w1 >> 52) & 0x7FF;
    var e2x = (w2 >> 52) & 0x7FF;
    if (e1x > emax) { emax = e1x; }
    if (e2x > emax) { emax = e2x; }
    var k = emax - 1023;
    if (k > 1022) { k = 1022; }
    var sc: f64 = _bj_from_bits((1023 - k) << 52);  # 2^-k
    var sp: f64 = 134217729.0;                      # Veltkamp's 2^27 + 1: each part split once
    var rr0: f64 = r[0];
    var rr1: f64 = r[1];
    var rr2: f64 = r[2];
    var x0: f64 = rr0 * sc;
    var x1: f64 = rr1 * sc;
    var x2: f64 = rr2 * sc;
    var y0: f64 = b[0];
    var y1: f64 = b[1];
    var y2: f64 = b[2];
    var cx0: f64 = sp * x0;
    var x0h: f64 = cx0 - (cx0 - x0);
    var x0l: f64 = x0 - x0h;
    var cx1: f64 = sp * x1;
    var x1h: f64 = cx1 - (cx1 - x1);
    var x1l: f64 = x1 - x1h;
    var cx2: f64 = sp * x2;
    var x2h: f64 = cx2 - (cx2 - x2);
    var x2l: f64 = x2 - x2h;
    var cy0: f64 = sp * y0;
    var y0h: f64 = cy0 - (cy0 - y0);
    var y0l: f64 = y0 - y0h;
    var cy1: f64 = sp * y1;
    var y1h: f64 = cy1 - (cy1 - y1);
    var y1l: f64 = y1 - y1h;
    var cy2: f64 = sp * y2;
    var y2h: f64 = cy2 - (cy2 - y2);
    var y2l: f64 = y2 - y2h;
    var a0: f64 = x0 * x0;                          # R'ᵢ² = aᵢ + eᵢ, R'ᵢβᵢ = cᵢ + fᵢ (Dekker's, on the halves)
    var m0: f64 = x0h * x0l;
    var e0: f64 = ((((x0h * x0h) - a0) + m0) + m0) + (x0l * x0l);
    var a1: f64 = x1 * x1;
    var m1: f64 = x1h * x1l;
    var e1: f64 = ((((x1h * x1h) - a1) + m1) + m1) + (x1l * x1l);
    var a2: f64 = x2 * x2;
    var m2: f64 = x2h * x2l;
    var e2: f64 = ((((x2h * x2h) - a2) + m2) + m2) + (x2l * x2l);
    var c0: f64 = x0 * y0;
    var f0: f64 = ((((x0h * y0h) - c0) + (x0h * y0l)) + (x0l * y0h)) + (x0l * y0l);
    var c1: f64 = x1 * y1;
    var f1: f64 = ((((x1h * y1h) - c1) + (x1h * y1l)) + (x1l * y1h)) + (x1l * y1l);
    var c2: f64 = x2 * y2;
    var f2: f64 = ((((x2h * y2h) - c2) + (x2h * y2l)) + (x2l * y2h)) + (x2l * y2l);
    var u1: f64 = a0 + a1;                          # S = s_h + s_l within 12.04u² (TwoSums, then the lows)
    var w1v: f64 = u1 - a0;
    var t1: f64 = (a0 - (u1 - w1v)) + (a1 - w1v);
    var u2: f64 = u1 + a2;
    var w2v: f64 = u2 - u1;
    var t2: f64 = (u1 - (u2 - w2v)) + (a2 - w2v);
    var lo: f64 = (((t1 + t2) + e0) + e1) + e2;
    var s_h: f64 = u2 + lo;                         # FastTwoSum(u2, lo)
    var s_l: f64 = lo - (s_h - u2);
    var v1: f64 = c0 + c1;                          # P = p_h + p_l within 12.05u²·√S' (TwoSums, the lows, TwoSum)
    var z1v: f64 = v1 - c0;
    var g1: f64 = (c0 - (v1 - z1v)) + (c1 - z1v);
    var v2: f64 = v1 + c2;
    var z2v: f64 = v2 - v1;
    var g2: f64 = (v1 - (v2 - z2v)) + (c2 - z2v);
    var plo: f64 = (((g1 + g2) + f0) + f1) + f2;
    var p_h: f64 = v2 + plo;                        # TwoSum(v2, plo)
    var zp: f64 = p_h - v2;
    var p_l: f64 = (v2 - (p_h - zp)) + (plo - zp);
    var q0: f64 = f64_sqrt(s_h);                    # √S = q_h + q_l within 12.08u² (_bj_g_sqrt_dd's steps, inline)
    var cq: f64 = sp * q0;
    var qh0: f64 = cq - (cq - q0);
    var ql0: f64 = q0 - qh0;
    var qq: f64 = q0 * q0;
    var qhl: f64 = qh0 * ql0;
    var qe: f64 = ((((qh0 * qh0) - qq) + qhl) + qhl) + (ql0 * ql0);
    var qr: f64 = ((s_h - qq) - qe) + s_l;
    var q2: f64 = 2.0 * q0;
    var qs: f64 = qr / q2;
    var q_h: f64 = q0 + qs;                         # FastTwoSum(q0, qs)
    var q_l: f64 = qs - (q_h - q0);
    var near = 0;
    if (p_h > 0.0) {
        var p4: f64 = 4.0 * p_h * p_h;
        if (p4 > s_h) { near = 1; }
    }
    var y: f64 = 0.0;
    var zz: f64 = 0.0;
    if (near == 0) {
        var mph: f64 = -p_h;
        var mpl: f64 = -p_l;
        var fh, fl = _bj_e_dw_add(q_h, q_l, mph, mpl);
        var f_h: f64 = fh;
        var f_l: f64 = fl;
        if (mode == 0) {
            var e1z, e2z = _bj_e_round_ends(f_h, f_l);
            y = e1z;
            zz = e2z;
        } else {
            var k1z, k2z = _bj_e_div_ends(f_h, f_l, q_h, q_l);
            y = k1z;
            zz = k2z;
        }
    } else {
        var pb0: f64 = y0 * y0;                     # D = 1 − Σβᵢ² exactly: βᵢ² by TwoProduct on the halves, grown
        var n0: f64 = y0h * y0l;
        var eb0: f64 = ((((y0h * y0h) - pb0) + n0) + n0) + (y0l * y0l);
        var pb1: f64 = y1 * y1;
        var n1: f64 = y1h * y1l;
        var eb1: f64 = ((((y1h * y1h) - pb1) + n1) + n1) + (y1l * y1l);
        var pb2: f64 = y2 * y2;
        var n2: f64 = y2h * y2l;
        var eb2: f64 = ((((y2h * y2h) - pb2) + n2) + n2) + (y2l * y2l);
        var ex: f64[8];
        ex[0] = 1.0;
        var kd = _bj_g_grow(&ex, 1, -eb2);
        kd = _bj_g_grow(&ex, kd, -eb1);
        kd = _bj_g_grow(&ex, kd, -eb0);
        kd = _bj_g_grow(&ex, kd, -pb2);
        kd = _bj_g_grow(&ex, kd, -pb1);
        kd = _bj_g_grow(&ex, kd, -pb0);
        var dxh, dxl = _bj_g_compress(&ex, kd);
        var d_h: f64 = dxh;
        var d_l: f64 = dxl;
        var c1h, c1l = _bj_e_cross_dw(x1, x1h, x1l, y2, y2h, y2l, x2, x2h, x2l, y1, y1h, y1l);
        var c2h, c2l = _bj_e_cross_dw(x2, x2h, x2l, y0, y0h, y0l, x0, x0h, x0l, y2, y2h, y2l);
        var c3h, c3l = _bj_e_cross_dw(x0, x0h, x0l, y1, y1h, y1l, x1, x1h, x1l, y0, y0h, y0l);
        var u1h, u1l = _bj_k_dd_mul(c1h, c1l, c1h, c1l);
        var u2h, u2l = _bj_k_dd_mul(c2h, c2l, c2h, c2l);
        var u3h, u3l = _bj_k_dd_mul(c3h, c3l, c3h, c3l);
        var vh, vl = _bj_e_dw_add(u1h, u1l, u2h, u2l);
        var ch, cl = _bj_e_dw_add(vh, vl, u3h, u3l);
        var mh, ml = _bj_k_dd_mul(s_h, s_l, d_h, d_l);
        var nh, nl = _bj_e_dw_add(mh, ml, ch, cl);
        var n_h: f64 = nh;
        var n_l: f64 = nl;
        var wh, wl = _bj_e_dw_add(q_h, q_l, p_h, p_l);
        var w_h: f64 = wh;
        var w_l: f64 = wl;
        if (mode == 1) {
            var th, tl = _bj_k_dd_mul(q_h, q_l, w_h, w_l);
            w_h = th;
            w_l = tl;
        }
        var n1z, n2z = _bj_e_div_ends(n_h, n_l, w_h, w_l);
        y = n1z;
        zz = n2z;
    }
    if (mode == 1) {
        var lo_t: f64 = 0x39B4484BFEEBAE57;          # 1e-30·(1 − 2^-40), rounded down
        var hi_t: f64 = 0x39B4484BFEEBD6E9;          # 1e-30·(1 + 2^-40), rounded up
        var band = slow;
        if (zz >= lo_t && y <= hi_t) { band = 1; }
        if (band == 1) {
            if (_bj_e_lw_sign(r, b, k, 2, 0, 0) < 0) { return 1; }
        }
        if (band == 0 && zz < lo_t) { return 1; }
    }
    if (slow == 1 || y != zz) { y = _bj_e_lw_settle(r, b, k, mode, y); }
    if (mode == 0) { y = _bj_g_scale(y, k); }
    out[0] = y;
    return 0;
}

# ── the parallel combinations (M2 part 2c-5) ─────────────────────────────────────────────────────────────────────────
#
# S = Σ 1/xᵢ exactly, for n values none of which is NaN, each finite one with |xᵢ| ≥ 10^-30 (the callers' checks; an
# ±∞ adds 1/±∞ = ±0, exactly as IEEE's). |S| < 10^-30 (the DivisionByZero "sum of inverse … is zero") is decided
# exactly, and the combination 1/S is rounded once. Rust's 1/(Σ RN(1/xᵢ)) rounds n + 1 times and cancels when the
# values' signs differ, so it refused sums above 10^-30 and returned values far from 1/S.
#
# The terms (u = 2^-53). Each 1/xᵢ is q + l: q = RN(1/xᵢ), and below |xᵢ| = 2^900 the remainder r = 1 − q·xᵢ is exact
# (TwoProduct, then (1 − p) − e: 1 − p by Sterbenz, and the remainder of a correctly rounded quotient is a double), so
# l = RN(r·q) is within 2.01u|r/xᵢ| ≤ 2.02u²|q| of r/xᵢ (q's own error, then the product's: a multiplication where a
# second division would do), and exactly it when r = 0. Above 2^900, l = 0 and the term is within u|q| + 2^-1074 of
# 1/xᵢ (q may be subnormal).
#
# Three tiers, each with a rigorous bound E on |S − S_dd|; the first that decides answers.
#   - T1, a compensated sum: TwoSums of the heads into σ, their errors t and the lows added into c (w = t + l, then
#     c + w, each rounded once), S_dd = TwoSum(σ, c). E = 1.01u·Σ(|w| + |c|) + 2.03u²·Σ|q| (inexact l) +
#     1.01(u·Σ|q| + k·2^-1074) (the k terms above 2^900); the hundredths cover the bounds' own roundings for n < 2^43.
#     E/|S| grows as n²u²/2 for like-signed values (12.5u² at n = 5).
#   - T2, the exact Shewchuk expansion of every q and l (Grow-Expansion, at most 252 components, else T3), compressed
#     to a double-word within 2^-104: E = 2.03u²·Σ|q| + the same tail terms + 4.01u²·|S_dd|, about 6u² of S for
#     like-signed values whatever n is, and exact when every reciprocal is (sums that cancel to 0 included).
#   - A tier decides: |S| < 10^-30 when |S_dd| + E, rounded up, lies at or below the double below 1e-30; |S| > 10^-30
#     when |S_dd| − E, rounded down, reaches the double 1e-30 (above 10^-30 by 0.476 ulp); then, with E/|S| ≤ 2^-60,
#     1/S by kimiya's quotient steps (13.12u² on 1/S_dd), whose ends at ε = y₀·(E_rel·(1 + 2^-30) + 2^-101) bracket
#     1/S: equal ends are RN(1/S). Otherwise the next tier runs.
#   - T3, the exact path, takes what neither decides: a sum near 10^-30, a cancellation below the bounds, a value within
#     about 2^-101 of a midpoint (ties among them), or slow = 1.
#
# Exact path. Each finite xᵢ is ±Mᵢ·2^Eᵢ with Mᵢ odd, so S = 2^-G·Σ ±2^(G−Eᵢ)/Mᵢ, G the largest Eᵢ. The terms are sorted
# by M (a heapsort: the order is total, the result exact and so deterministic), each group's dyadic sum A_g (positive
# and negative parts) is formed in integers, and the groups fold into one fraction N/D, D = Π M_g over the distinct
# M_g: N/D + A_g/M_g = (N·M_g + A_g·D)/(D·M_g), N kept as its positive and negative parts. A group of equal Mᵢ adds
# no factor, so [3, −3, 3, −3, …] stays small; n distinct significands make D 53n bits and the fold quadratic in n (a
# finding, recorded; only sums the fast path cannot decide come here). |S| = X/(D·2^G) with X = |N|, so |S| < 10^-30
# is X·5^30·2^30 < D·2^G, and the candidate for 1/|S| = D·2^G/X comes from the two integers' top 62 bits (within 3.1u);
# the neighbouring midpoints μ = m·2^f then decide, D·2^G against m·X·2^f, ties to even. The buffers, sized from n and
# the group count, come from fl_calloc and go back by fl_free; a refused allocation returns 2 (BJ_ERR_ALLOCATION).
# cr_verify.py's par and par_slow families check both paths against Python's Fraction, on x86_64 and aarch64.

# Word i of the sort's triples (M, E, sign) at t.
#must_use
fn _bj_e_par_key(t, i): i64 { return load64(t + 24 * i); }

# Swaps triples i and j at t.
fn _bj_e_par_swap(t, i, j) {
    for (var k = 0; k < 3; k = k + 1) {
        var a = load64(t + 24 * i + 8 * k);
        store64(t + 24 * i + 8 * k, load64(t + 24 * j + 8 * k));
        store64(t + 24 * j + 8 * k, a);
    }
    return 0;
}

# Sifts triple `root` down the max-heap t[0..end) on M.
fn _bj_e_par_sift(t, root, end) {
    var r = root;
    while (2 * r + 1 < end) {
        var c = 2 * r + 1;
        if (c + 1 < end && _bj_e_par_key(t, c) < _bj_e_par_key(t, c + 1)) { c = c + 1; }
        if (_bj_e_par_key(t, r) >= _bj_e_par_key(t, c)) { return 0; }
        _bj_e_par_swap(t, r, c);
        r = c;
    }
    return 0;
}

# Heapsorts the m triples at t by M, ascending.
fn _bj_e_par_sort(t, m) {
    var s = m / 2 - 1;
    while (s >= 0) {
        _bj_e_par_sift(t, s, m);
        s = s - 1;
    }
    var e = m - 1;
    while (e > 0) {
        _bj_e_par_swap(t, 0, e);
        _bj_e_par_sift(t, 0, e);
        e = e - 1;
    }
    return 0;
}

# The top 62 bits of the nonzero bignum a as an integer, its shift into sh[0] (a = top·2^sh, truncated); t scratch.
#must_use
fn _bj_e_par_top(a, t, sh: *i64): i64 {
    _bj_bn_copy(t, a);
    var b = _bj_g_bitlen(t);
    var s = 0;
    if (b > 62) {
        s = b - 62;
        _bj_bn_shr(t, s);
    }
    sh[0] = s;
    return _bj_g_limb(t, 0) + (_bj_g_limb(t, 1) << 32);
}

# The sign of D·2^G − m·2^f·X (the exact path's midpoint test); t1, t2 and t3 scratch bignums.
#must_use
fn _bj_e_par_mid(d, x, g, mm, f, t1, t2, t3): i64 {
    _bj_bn_copy(t1, x);
    _bj_g_mul(t1, mm, t3);
    _bj_bn_copy(t2, d);
    if (g >= f) { _bj_bn_shl(t2, g - f); } else { _bj_bn_shl(t1, f - g); }
    var c = _bj_bn_cmp(t2, t1);
    return c;
}

# The exact path (the section comment): 1 when |Σ 1/xᵢ| < 10^-30, 0 with out[0] := RN(1/Σ 1/xᵢ), 2 when a buffer is
# refused.
fn _bj_e_par_exact(xs: *f64, n, out: *f64): i64 {
    var m = 0;
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = xs[i];
        if (_bj_is_finite(x) == 1) { m = m + 1; }
    }
    if (m == 0) { return 1; }
    var tr = fl_calloc(24 * m);
    if (tr == 0) { return 2; }
    var me[16];
    var j = 0;
    var gmax = 0 - 2000;
    for (var i2 = 0; i2 < n; i2 = i2 + 1) {
        var x2: f64 = xs[i2];
        if (_bj_is_finite(x2) == 0) { continue; }
        _bj_g_split(x2, &me);
        var mm = load64(&me);
        var ee = load64(&me + 8);
        while ((mm & 1) == 0) {
            mm = mm >> 1;
            ee = ee + 1;
        }
        store64(tr + 24 * j, mm);
        store64(tr + 24 * j + 8, ee);
        store64(tr + 24 * j + 16, (_bj_bits(x2) >> 63) & 1);
        if (ee > gmax) { gmax = ee; }
        j = j + 1;
    }
    _bj_e_par_sort(tr, m);
    var ng = 1;
    for (var i3 = 1; i3 < m; i3 = i3 + 1) {
        if (_bj_e_par_key(tr, i3) != _bj_e_par_key(tr, i3 - 1)) { ng = ng + 1; }
    }
    var wb = 8 * ((53 * ng + 3700) / 32 + 8);      # bytes of a big buffer: D, the parts, their shifts and products
    var wa = 8 * (2300 / 32 + 8);                    # a group's dyadic sum (below 2^2100·n)
    var pp = fl_calloc(wb);
    var qq = fl_calloc(wb);
    var dd = fl_calloc(wb);
    var t1 = fl_calloc(wb);
    var t2 = fl_calloc(wb);
    var t3 = fl_calloc(wb);
    var ap = fl_calloc(wa);
    var an = fl_calloc(wa);
    var w = fl_calloc(wa);
    var res = 0;
    if (pp == 0 || qq == 0 || dd == 0 || t1 == 0 || t2 == 0 || t3 == 0 || ap == 0 || an == 0 || w == 0) { res = 2; }
    if (res == 0) {
        _bj_bn_set(dd, 1);
        store64(pp, 0);
        store64(qq, 0);
        var k = 0;
        while (k < m) {
            var mg = _bj_e_par_key(tr, k);
            store64(ap, 0);
            store64(an, 0);
            while (k < m && _bj_e_par_key(tr, k) == mg) {
                _bj_bn_set(w, 1);
                _bj_bn_shl(w, gmax - load64(tr + 24 * k + 8));
                if (load64(tr + 24 * k + 16) == 0) { _bj_g_add_to(ap, w); } else { _bj_g_add_to(an, w); }
                k = k + 1;
            }
            _bj_g_mul(pp, mg, t1);                   # N/D + A/M = (N·M + A·D)/(D·M)
            _bj_g_mul(qq, mg, t1);
            if (load64(ap) != 0) {
                _bj_e_bn_mul(t2, ap, dd);
                _bj_g_add_to(pp, t2);
            }
            if (load64(an) != 0) {
                _bj_e_bn_mul(t2, an, dd);
                _bj_g_add_to(qq, t2);
            }
            _bj_g_mul(dd, mg, t1);
        }
        var c = _bj_bn_cmp(pp, qq);
        var neg = 0;
        var xx = pp;
        if (c > 0) { _bj_bn_sub(pp, qq); }
        if (c < 0) {
            _bj_bn_sub(qq, pp);
            xx = qq;
            neg = 1;
        }
        if (c == 0) { res = 1; }
        if (res == 0) {
            _bj_bn_copy(t1, xx);                     # |S| < 10^-30: X·5^30·2^30 < D·2^G
            _bj_g_mul(t1, 30517578125, t3);
            _bj_g_mul(t1, 30517578125, t3);
            _bj_bn_copy(t2, dd);
            if (gmax >= 30) { _bj_bn_shl(t2, gmax - 30); } else { _bj_bn_shl(t1, 30 - gmax); }
            if (_bj_bn_cmp(t1, t2) < 0) { res = 1; }
        }
        if (res == 0) {
            var sd: i64[1];
            var sx: i64[1];
            var td = _bj_e_par_top(dd, t1, &sd);
            var tx = _bj_e_par_top(xx, t1, &sx);
            var fd: f64 = f64_from(td);
            var fx: f64 = f64_from(tx);
            var y0: f64 = fd / fx;
            var y: f64 = _bj_g_scale(y0, gmax + sd[0] - sx[0]);
            var mid[16];
            for (var it = 0; it < 6; it = it + 1) {
                var up: f64 = _bj_g_step(y, 1);
                _bj_g_mid(y, up, &mid);
                var c1 = _bj_e_par_mid(dd, xx, gmax, load64(&mid), load64(&mid + 8), t1, t2, t3);
                if (c1 > 0) {
                    y = up;
                    continue;
                }
                if (c1 == 0) {
                    y = _bj_g_even(y, up);
                    break;
                }
                var dn: f64 = _bj_g_step(y, 0 - 1);
                _bj_g_mid(dn, y, &mid);
                var c2 = _bj_e_par_mid(dd, xx, gmax, load64(&mid), load64(&mid + 8), t1, t2, t3);
                if (c2 < 0) {
                    y = dn;
                    continue;
                }
                if (c2 == 0) { y = _bj_g_even(dn, y); }
                break;
            }
            if (neg == 1) { y = -y; }
            out[0] = y;
        }
    }
    if (pp != 0) { fl_free(pp); }
    if (qq != 0) { fl_free(qq); }
    if (dd != 0) { fl_free(dd); }
    if (t1 != 0) { fl_free(t1); }
    if (t2 != 0) { fl_free(t2); }
    if (t3 != 0) { fl_free(t3); }
    if (ap != 0) { fl_free(ap); }
    if (an != 0) { fl_free(an); }
    if (w != 0) { fl_free(w); }
    fl_free(tr);
    return res;
}

# (h, l) := the top two components of the nonoverlapping expansion ex[0..k) (k ≥ 1, increasing magnitude) after
# Shewchuk's Compress, within 2^-104 of the sum, relative: src/crmath_gamma.cyr's _bj_g_compress with the caller's
# scratch g (k doubles) in place of its sixteen. ex is overwritten.
#must_use
fn _bj_e_compress(ex: *f64, k, g: *f64): (f64, f64) {
    var q0: f64 = ex[k - 1];
    var bottom = k - 1;
    var i = k - 2;
    while (i >= 0) {
        var e: f64 = ex[i];
        var ss: f64 = q0 + e;                       # FastTwoSum(q0, e)
        var rr: f64 = e - (ss - q0);
        if (rr != 0.0) {
            g[bottom] = ss;
            bottom = bottom - 1;
            q0 = rr;
        } else {
            q0 = ss;
        }
        i = i - 1;
    }
    g[bottom] = q0;
    var top = 0;
    var q1: f64 = g[bottom];
    for (var m = bottom + 1; m < k; m = m + 1) {
        var gm: f64 = g[m];
        var s2: f64 = gm + q1;                      # FastTwoSum(gm, q1)
        var r2: f64 = q1 - (s2 - gm);
        if (r2 != 0.0) {
            ex[top] = r2;
            top = top + 1;
        }
        q1 = s2;
    }
    var lo: f64 = 0.0;
    if (top > 0) { lo = ex[top - 1]; }
    var h: f64 = q1 + lo;
    var l: f64 = lo - (h - q1);
    return (h, l);
}

# A tier's verdict from S_dd = s_h + s_l within E of S (the section comment): 1 when |S| < 10^-30, 0 with out[0] :=
# RN(1/S), −1 when the bound cannot decide.
#must_use
fn _bj_e_par_decide(s_h: f64, s_l: f64, eab: f64, out: *f64): i64 {
    var a: f64 = f64_abs(s_h);
    var em: f64 = eab * 1.0000001;
    var m48: f64 = 0x3CF0000000000000;              # 2^-48
    var hiv: f64 = (a + em) * (1.0 + m48);
    var lov: f64 = (a - em) * (1.0 - m48);
    var c_lo: f64 = 0x39B4484BFEEBC29F;             # the double below 1e-30 (below 10^-30)
    var c_hi: f64 = 0x39B4484BFEEBC2A0;             # 1e-30 (above 10^-30)
    if (hiv <= c_lo) { return 1; }
    if (lov < c_hi) { return 0 - 1; }
    var erel: f64 = (em / lov) * (1.0 + m48);
    var l60: f64 = 0x3C30000000000000;              # 2^-60
    if (erel > l60) { return 0 - 1; }
    var ah: f64 = a;                                # |S_dd| = a_h + a_l
    var al: f64 = s_l;
    if (s_h < 0.0) { al = -s_l; }
    var sp: f64 = 134217729.0;
    var y0: f64 = 1.0 / ah;                         # kimiya's quotient steps for 1/(a_h + a_l), inline
    var pa: f64 = y0 * ah;
    var cy: f64 = sp * y0;
    var yh: f64 = cy - (cy - y0);
    var yl: f64 = y0 - yh;
    var ca: f64 = sp * ah;
    var ahh: f64 = ca - (ca - ah);
    var ahl: f64 = ah - ahh;
    var pb: f64 = (yl * ahl) - (((pa - (yh * ahh)) - (yl * ahh)) - (yh * ahl));
    var s0: f64 = 1.0 - pa;
    var s1: f64 = s0 - pb;
    var s3: f64 = y0 * al;
    var rr: f64 = s1 - s3;
    var d: f64 = rr / ah;
    var g30: f64 = 0x3E10000000000000;              # 2^-30
    var k101: f64 = 0x39A0000000000000;             # 2^-101
    var eps: f64 = y0 * ((erel * (1.0 + g30)) + k101);
    var lo: f64 = d - eps;
    var hi: f64 = d + eps;
    var z1: f64 = y0 + lo;
    var z2: f64 = y0 + hi;
    if (z1 != z2) { return 0 - 1; }
    var res: f64 = z1;
    if (s_h < 0.0) { res = -z1; }
    out[0] = res;
    return 0;
}

# The parallel combination (the section comment) of the n values at xs (none NaN; each finite one |xᵢ| ≥ 10^-30): 1
# when |Σ 1/xᵢ| < 10^-30 exactly; 0 with out[0] := RN(1/Σ 1/xᵢ); 2 when the exact path's buffers are refused. slow = 1
# runs the exact path alone, slow = 2 the expansion and then the exact path (cr_verify.py's par_slow and par_x).
#must_use
fn _bj_cr_parallel(xs: *f64, n, slow, out: *f64): i64 {
    var sp: f64 = 134217729.0;                      # Veltkamp's 2^27 + 1
    var big: f64 = 0x7830000000000000;              # 2^900
    var u2: f64 = 0x3950000000000000;               # 2^-106
    var u1: f64 = 0x3CA0000000000000;               # 2^-53
    var tiny: f64 = _bj_from_bits(1);               # 2^-1074
    if (slow == 0) {
        var sg: f64 = 0.0;                          # Σ (qᵢ + lᵢ) = σ + c: TwoSums of the heads, their errors and the
        var cc: f64 = 0.0;                          # lows added to c, g = Σ(|w| + |c|) bounding c's roundings
        var gb: f64 = 0.0;
        var lsum: f64 = 0.0;
        var tsum: f64 = 0.0;
        var tcnt = 0;
        for (var i = 0; i < n; i = i + 1) {
            var x: f64 = xs[i];
            var dz: f64 = x - x;
            if (dz != 0.0) { continue; }            # ±∞: 1/x = ±0
            var q: f64 = 1.0 / x;
            var ax: f64 = f64_abs(x);
            var l: f64 = 0.0;
            if (ax < big) {
                var p: f64 = q * x;                 # q·x = p + e (TwoProduct, inline), r = (1 − p) − e exactly
                var cq: f64 = sp * q;
                var qh: f64 = cq - (cq - q);
                var ql: f64 = q - qh;
                var cx: f64 = sp * x;
                var xh: f64 = cx - (cx - x);
                var xl: f64 = x - xh;
                var e: f64 = ((((qh * xh) - p) + (qh * xl)) + (ql * xh)) + (ql * xl);
                var r0: f64 = 1.0 - p;
                var r: f64 = r0 - e;
                if (r != 0.0) {
                    l = r * q;
                    var aq: f64 = f64_abs(q);
                    lsum = lsum + aq;
                }
            } else {
                var aq2: f64 = f64_abs(q);
                tsum = tsum + aq2;
                tcnt = tcnt + 1;
            }
            var s1: f64 = sg + q;                   # TwoSum(σ, q)
            var bb: f64 = s1 - sg;
            var t: f64 = (sg - (s1 - bb)) + (q - bb);
            sg = s1;
            var w: f64 = t + l;
            cc = cc + w;
            var aw: f64 = f64_abs(w);
            var ac: f64 = f64_abs(cc);
            gb = (gb + aw) + ac;
        }
        var fh: f64 = sg + cc;                      # TwoSum(σ, c): S_dd
        var fb: f64 = fh - sg;
        var fl: f64 = (sg - (fh - fb)) + (cc - fb);
        var tc: f64 = f64_from(tcnt);
        var e1: f64 = 1.01 * u1 * gb;
        var e2: f64 = 2.03 * u2 * lsum;
        var e3: f64 = 1.01 * ((u1 * tsum) + (tc * tiny));
        var eab: f64 = (e1 + e2) + e3;
        var v1 = _bj_e_par_decide(fh, fl, eab, out);
        if (v1 >= 0) { return v1; }
    }
    if (slow != 1) {
        var ex: f64[256];                           # the expansion of every qᵢ and lᵢ, exact (Grow-Expansion)
        var k = 0;
        var lsum2: f64 = 0.0;
        var tsum2: f64 = 0.0;
        var tcnt2 = 0;
        var room = 1;
        for (var i2 = 0; i2 < n && room == 1; i2 = i2 + 1) {
            var x2: f64 = xs[i2];
            var dz2: f64 = x2 - x2;
            if (dz2 != 0.0) { continue; }
            var q2: f64 = 1.0 / x2;
            var ax2: f64 = f64_abs(x2);
            var l2: f64 = 0.0;
            if (ax2 < big) {
                var p2: f64 = q2 * x2;
                var cq2: f64 = sp * q2;
                var qh2: f64 = cq2 - (cq2 - q2);
                var ql2: f64 = q2 - qh2;
                var cx2: f64 = sp * x2;
                var xh2: f64 = cx2 - (cx2 - x2);
                var xl2: f64 = x2 - xh2;
                var e2x: f64 = ((((qh2 * xh2) - p2) + (qh2 * xl2)) + (ql2 * xh2)) + (ql2 * xl2);
                var r2: f64 = (1.0 - p2) - e2x;
                if (r2 != 0.0) {
                    l2 = r2 * q2;
                    var aq3: f64 = f64_abs(q2);
                    lsum2 = lsum2 + aq3;
                }
            } else {
                var aq4: f64 = f64_abs(q2);
                tsum2 = tsum2 + aq4;
                tcnt2 = tcnt2 + 1;
            }
            if (k > 252) {
                room = 0;
                continue;
            }
            k = _bj_g_grow(&ex, k, q2);
            if (l2 != 0.0) { k = _bj_g_grow(&ex, k, l2); }
        }
        if (room == 1) {
            var gh: f64 = 0.0;
            var gl: f64 = 0.0;
            if (k > 0) {
                var gs: f64[256];
                var ch, cl = _bj_e_compress(&ex, k, &gs);
                gh = ch;
                gl = cl;
            }
            var tc2: f64 = f64_from(tcnt2);
            var f2: f64 = 2.03 * u2 * lsum2;
            var f3: f64 = 1.01 * ((u1 * tsum2) + (tc2 * tiny));
            var agh: f64 = f64_abs(gh);
            var f4: f64 = 4.01 * u2 * agh;          # Compress's 2^-104
            var eab2: f64 = (f2 + f3) + f4;
            var v2 = _bj_e_par_decide(gh, gl, eab2, out);
            if (v2 >= 0) { return v2; }
        }
    }
    var rx = _bj_e_par_exact(xs, n, out);
    return rx;
}
