# crmath_edge.cyr — bijli's values at their own pole or zero (M2 part 2c, ADR 0002 row 17, the user's answer of
# 2026-11-12: exact tests, accurate values). A test that decides where its value has a pole or a zero is made on the
# exact quantity, and the value beside it comes from exact differences, correctly rounded, so the two agree: an input
# the exact test accepts never gets a value of ∞, 0 or NaN from a cancellation, and one it refuses carries the exact
# value's sign. Clausius–Mossotti's ε_r (M2 part 2c-2) and the trig-free Fresnel cosine (2c-3) are here.
#
# Clausius–Mossotti (M2 part 2c-2). ε_r = (1 + 2X)/(1 − X) with X = Nα/(3ε₀) is (3ε₀ + 2P)/(3ε₀ − P), P = Nα exactly
# and ε₀ its double. X ≥ 1 is 3ε₀ − P ≤ 0, and below it ε_r ≤ 0 is 3ε₀ + 2P ≤ 0. The value ε_r is rounded once (to
# nearest, ties to even). The parts: 3ε₀ = t_h + t_l (FastTwoSum(2ε₀, ε₀)) and P = b_h + b_l (TwoProduct) exactly, so
# num = t_h + t_l + 2b_h + 2b_l and den = t_h + t_l − b_h − b_l, four doubles each.
#
# The rough X. χ = RN(RN(Nα)/RN(3ε₀)) is within 3.02u of X (u = 2^-53) when Nα doesn't under- or overflow. |χ| < 2^-60
# (Nα underflowing included) puts |ε_r − 1| = 3|X|/(1 − X) below 2^-57, inside 1's rounding interval: ε_r rounds to
# 1. |χ| ≥ 2^136 (Nα overflowing included) puts |X| above 2^135: X ≥ 1 for α > 0, and for α < 0 ε_r = −2 + 3/(1 − X)
# lies within 2^-133 above −2, so it rounds to −2. Between, |P| lies in [2^-95.4, 2^101.6], so its exponent sum is in
# [−97, 101], b_h in [2^-97, 2^103], and b_l a multiple of 2^-201: no part under- or overflows, and every step is
# exact. With both exponents in [−500, 500], TwoProduct runs on α and N themselves (inline; Veltkamp's split doesn't
# overflow, and every partial product's least bit is at least lsb(α)·lsb(N) = 2^(e_N + e_α − 104) ≥ 2^-201, so each
# is exact); otherwise on α and N scaled to [1, 2), its parts then scaled by 2^(e_N + e_α). Both give the same
# b_h = RN(P) and b_l.
#
# Fast region, χ ∈ [−0.24, 0.49] (X ∈ [−¼, ½], no cancellation): (s, e) = TwoSum(t_h, 2b_h) exactly, then
# RN(RN(e + t_l) + 2b_l), then FastTwoSum: within 5.02u²·(|t_h| + 2|b_h|), relative 5.02u²·(1 + 2|X|)/(1 + 2X)
# ≤ 15.06u²; likewise den within 5.02u²·(1 + |X|)/(1 − X) ≤ 15.06u², and the two together never above 20.1u² (at
# X = −¼ or ½).
# Elsewhere num and den are Shewchuk expansions of their four parts (src/crmath_gamma.cyr's _bj_g_grow, exact): the
# largest component's sign is the sum's, which decides X ≥ 1 and ε_r ≤ 0 exactly, and Compress gives each within
# 2^-104. kimiya's rounding test (_bj_k_dd_div_cr, src/crmath_kx.cyr: inputs within 32u² together) then rounds
# |num|/den.
#
# The range. A nonzero num is a multiple of 2^min(−89, e − 103) and den of 2^min(−89, e − 104), e the exponent sum, and
# they cancel only when |P| is near 1.5ε₀ or 3ε₀ (e in [−38, −35]), so a nonzero |ε_r| lies in [2^-109, 2^110].
#
# The exact check, when the test fails (a value within about 2^-99 of a midpoint, relative; or always, for slow = 1):
# the candidate y = z₁ of _bj_k_dd_div_ends lies within an ulp of RN(v), v = |num|/den, so the signs of v − μ at the
# midpoints μ = y ± ulp/2 decide it, ties to even. With den > 0, v − μ has the sign of |num| − y·den − h·den
# (h = ±ulp/2, a power of two): sixteen doubles (num's four; y·dᵢ by TwoProduct, eight; h·dᵢ exactly, four), summed
# exactly by kimiya's _bj_k_exp_sign. Their least bit is 2^-362 or above (y ≥ 2^-109, dᵢ a multiple of 2^-201), and
# their sum below 2^215: no product under- or overflows. cr_verify.py's cm and cm_slow families check every path
# against Python's Fraction, on x86_64 and aarch64.

# (s, e) with x = s·2^e and 1 ≤ |s| < 2, s keeping x's sign, exactly, for a finite nonzero x (a subnormal is scaled by
# 2^54 first).
#must_use
fn _bj_e_frexp(x: f64): (f64, i64) {
    var b = _bj_bits(x);
    var ex = (b >> 52) & 0x7FF;
    var adj = 0;
    if (ex == 0) {
        var k54: f64 = 0x4350000000000000;          # 2^54
        var y: f64 = x * k54;
        b = _bj_bits(y);
        ex = (b >> 52) & 0x7FF;
        adj = 54;
    }
    var sg = b - (b & 0x7FFFFFFFFFFFFFFF);
    var s: f64 = _bj_from_bits(sg | (b & 0xFFFFFFFFFFFFF) | 0x3FF0000000000000);
    var e = ex - 1023 - adj;
    return (s, e);
}

# The sign (−1, 0 or 1) of g·num − (y + h)·den, exactly, for the parts c = (t_h, t_l, b_h, b_l) (num = t_h + t_l + 2b_h
# + 2b_l, den = t_h + t_l − b_h − b_l), g = ±1, y ≥ 2^-110 and h ±(a power of two) (the header's exact check).
#must_use
fn _bj_e_side(c: *f64, g: f64, y: f64, h: f64): i64 {
    var t: f64[16];
    var th: f64 = c[0];
    var tl: f64 = c[1];
    var bh: f64 = c[2];
    var bl: f64 = c[3];
    t[0] = g * th;
    t[1] = g * tl;
    var bh2: f64 = bh * 2.0;
    var bl2: f64 = bl * 2.0;
    t[2] = g * bh2;
    t[3] = g * bl2;
    var d: f64[4];
    d[0] = th;
    d[1] = tl;
    d[2] = -bh;
    d[3] = -bl;
    for (var i = 0; i < 4; i = i + 1) {
        var di: f64 = d[i];
        var p, e = _bj_k_two_prod(y, di);
        var pp: f64 = p;
        var pe: f64 = e;
        t[4 + 2 * i] = -pp;
        t[5 + 2 * i] = -pe;
        var hd: f64 = h * di;
        t[12 + i] = -hd;
    }
    return _bj_k_exp_sign(&t, 16);
}

# RN(v) for v = g·num/den > 0, from a candidate y within an ulp of it (the header's exact check).
#must_use
fn _bj_e_settle(c: *f64, g: f64, y: f64): f64 {
    var up: f64 = _bj_g_step(y, 1);
    var hu: f64 = (up - y) * 0.5;
    var su = _bj_e_side(c, g, y, hu);
    if (su > 0) { return up; }
    if (su == 0) {
        var eu: f64 = _bj_g_even(y, up);
        return eu;
    }
    var dn: f64 = _bj_g_step(y, 0 - 1);
    var hd: f64 = (dn - y) * 0.5;
    var sd = _bj_e_side(c, g, y, hd);
    if (sd < 0) { return dn; }
    if (sd == 0) {
        var ed: f64 = _bj_g_even(dn, y);
        return ed;
    }
    return y;
}

# Clausius–Mossotti (the header): 1 when X = Nα/(3ε₀) ≥ 1 exactly; otherwise 0, with out[0] := RN(ε_r) for
# ε_r = (3ε₀ + 2Nα)/(3ε₀ − Nα), which is ≤ 0 exactly when ε_r is. For finite α and N ≥ 0. slow = 1 skips the rounding
# test, so the exact check always runs (cr_verify.py's cm_slow).
#must_use
fn _bj_cr_clausius(alpha: f64, n: f64, slow, out: *f64): i64 {
    var na: f64 = n * alpha;
    var three: f64 = 3.0 * BJ_EPSILON_0;
    var chi: f64 = na / three;
    var ac: f64 = f64_abs(chi);
    var lo60: f64 = 0x3C30000000000000;             # 2^-60
    if (ac < lo60) {
        out[0] = 1.0;
        return 0;
    }
    var hi136: f64 = 0x4870000000000000;            # 2^136
    if (ac >= hi136) {
        if (chi > 0.0) { return 1; }
        out[0] = -2.0;
        return 0;
    }
    var t_h: f64 = three;
    var two: f64 = 2.0 * BJ_EPSILON_0;
    var t_l: f64 = BJ_EPSILON_0 - (three - two);   # FastTwoSum(2ε₀, ε₀)'s error: 3ε₀ = t_h + t_l
    var bh: f64 = na;
    var bl: f64 = 0.0;
    var xn = (_bj_bits(n) >> 52) - 1023;            # n > 0 here
    var xa = ((_bj_bits(alpha) >> 52) & 0x7FF) - 1023;
    if (xn >= 0 - 500 && xn <= 500 && xa >= 0 - 500 && xa <= 500) {
        var sp: f64 = 134217729.0;                  # n·α = b_h + b_l: TwoProduct, inline (Veltkamp's 2^27 + 1 split)
        var cn: f64 = sp * n;
        var nhh: f64 = cn - (cn - n);
        var nhl: f64 = n - nhh;
        var ca: f64 = sp * alpha;
        var ahh: f64 = ca - (ca - alpha);
        var ahl: f64 = alpha - ahh;
        bl = (nhl * ahl) - (((na - (nhh * ahh)) - (nhl * ahh)) - (nhh * ahl));
    } else {
        var sn, en = _bj_e_frexp(n);
        var sa, ea = _bj_e_frexp(alpha);
        var fn1: f64 = sn;
        var fa1: f64 = sa;
        var ph, pl = _bj_k_two_prod(fn1, fa1);
        var k: f64 = _bj_g_pow2(en + ea);
        var p_h: f64 = ph;
        var p_l: f64 = pl;
        bh = p_h * k;
        bl = p_l * k;
    }
    var c: f64[4];
    c[0] = t_h;
    c[1] = t_l;
    c[2] = bh;
    c[3] = bl;
    var nh: f64 = 0.0;
    var nl: f64 = 0.0;
    var dh: f64 = 0.0;
    var dl: f64 = 0.0;
    var g: f64 = 1.0;
    if (chi >= -0.24 && chi <= 0.49) {
        var bh2: f64 = bh * 2.0;
        var bl2: f64 = bl * 2.0;
        var s1: f64 = t_h + bh2;                    # num: TwoSum(t_h, 2b_h), inline
        var v1: f64 = s1 - t_h;
        var e1: f64 = (t_h - (s1 - v1)) + (bh2 - v1);
        var r1: f64 = (e1 + t_l) + bl2;
        nh = s1 + r1;                               # FastTwoSum(s1, r1)
        nl = r1 - (nh - s1);
        var mbh: f64 = -bh;
        var s2: f64 = t_h + mbh;                    # den: TwoSum(t_h, −b_h), inline
        var v2: f64 = s2 - t_h;
        var e2: f64 = (t_h - (s2 - v2)) + (mbh - v2);
        var r2: f64 = (e2 + t_l) - bl;
        dh = s2 + r2;                               # FastTwoSum(s2, r2)
        dl = r2 - (dh - s2);
    } else {
        var de: f64[4];
        var kd = 0;
        var mbl: f64 = -bl;
        var mbh2: f64 = -bh;
        kd = _bj_g_grow(&de, kd, t_l);
        kd = _bj_g_grow(&de, kd, t_h);
        kd = _bj_g_grow(&de, kd, mbl);
        kd = _bj_g_grow(&de, kd, mbh2);
        if (kd == 0) { return 1; }
        var dtop: f64 = de[kd - 1];
        if (dtop < 0.0) { return 1; }
        var ne: f64[4];
        var kn = 0;
        var nbl: f64 = bl * 2.0;
        var nbh: f64 = bh * 2.0;
        kn = _bj_g_grow(&ne, kn, t_l);
        kn = _bj_g_grow(&ne, kn, t_h);
        kn = _bj_g_grow(&ne, kn, nbl);
        kn = _bj_g_grow(&ne, kn, nbh);
        if (kn == 0) {
            out[0] = 0.0;
            return 0;
        }
        var ntop: f64 = ne[kn - 1];
        if (ntop < 0.0) { g = -1.0; }
        var ch, cl = _bj_g_compress(&ne, kn);
        var c_h: f64 = ch;
        var c_l: f64 = cl;
        nh = g * c_h;
        nl = g * c_l;
        var gh, gl = _bj_g_compress(&de, kd);
        dh = gh;
        dl = gl;
    }
    if (slow == 0) {
        var q, ok = _bj_k_dd_div_cr(nh, nl, dh, dl);
        if (ok == 1) {
            var qq: f64 = q;
            var r: f64 = g * qq;
            out[0] = r;
            return 0;
        }
    }
    var z1, z2 = _bj_k_dd_div_ends(nh, nl, dh, dl);
    var zz: f64 = z1;
    var y: f64 = _bj_e_settle(&c, g, zz);
    var ry: f64 = g * y;
    out[0] = ry;
    return 0;
}

# ── the trig-free Fresnel cosine (M2 part 2c-3) ──────────────────────────────────────────────────────────────────────
#
# cos θ_t = √(1 − (n₁/n₂)²(1 − c²)) for c = cos θ_i in [0, 1] is √D/b with D = b² − a²(1 − c²) = b² − a² + (ac)²,
# where a = n₁·2^-k and b = n₂·2^-k ∈ [1, 2) (k n₂'s exponent: the scaling is exact and changes nothing). Total
# internal reflection, sin²θ_t > 1, is D < 0 exactly, and cos θ_t is √D/b rounded once.
#
# Shortcuts. n₁ = n₂ gives D = (ac)², so cos θ_t = |c| exactly (+0 for c = −0); c = 1 gives cos θ_t = 1. Otherwise
# c < 1, so 1 − c² ≥ 2^-52: a ratio n₁/n₂ above 2^27 (exponent difference d ≥ 28) is TIR, and one below 2^-61
# (d ≤ −62) leaves cos θ_t within 2^-122 of 1, which rounds to 1. Between, a lies in (2^-62, 2^29), and every square
# below is exact.
#
# A c below 2^-300 is taken as 0 in D. With c = 0, D = b² − a² is a nonzero multiple of 2^-228 (a ≠ b), and D − μ²b² is
# never 0 at a dyadic μ: μb = p and a² + p² = b² would make a Pythagorean triple whose hypotenuse b·2^j has an odd part
# dividing p's, so the odd part is 1 and a or p is 0. So D − μ²b² is a nonzero multiple of 2^-442 at every midpoint μ
# (μ ≥ 2^-115 there), far above (ac)² < 2^-542: dropping c moves neither the sign of D nor any midpoint comparison.
#
# The range. A nonzero D lies in [2^-620, 4]: if (ac)² < 2^-229, |D| ≥ |b² − a²| − (ac)² ≥ 2^-229; otherwise
# c ≥ 2^-143.5, and every part of D is a multiple of 2^-620. So cos θ_t ≥ 2^-311.
#
# Fast region, M = a²(1 − c²) ≤ b²/2 (sin²θ_t ≤ ½): 1 − c² = s_h + s_l from TwoProduct(c, c) and FastTwoSum(1, −c²)
# (exact for c² ≥ ½, within 1.5u² relative below), M by kimiya's _bj_k_dd_mul (8.01u²), D = b² − M by TwoSum within
# 9.05u², so 18.6u² with M's error carried (D ≥ M); √D by src/crmath_gamma.cyr's _bj_g_sqrt_dd (half of that, plus
# 6.06u²): 15.4u², inside _bj_k_dd_div_cr's 32u². Near the critical angle (M > b²/2) D is the Shewchuk expansion of
# its ten parts (b², −a², (ac)² = t_h² + 2t_h·t_l + t_l², TwoProducts), whose top component's sign decides TIR,
# compressed to within 2^-104 (with the root's 6.06u²: 8.06u²). The exact check, when a rounding test fails (or always,
# for slow = 1): at the candidate y's two neighbouring midpoints μ = y ± h, D − (μb)² is exactly the sum of D's ten
# parts and the twelve of −(g₁ + g₂ + w)² (y·b = g₁ + g₂ by TwoProduct, w = h·b exactly: three squares and three
# doubled products), whose least bits are at or above 2^-834 (y ≥ 2^-311), ties to even. cr_verify.py's cos_t and
# cos_t_slow families check it against Python's Fraction and an integer square root, on x86_64 and aarch64.

# D's parts into t (b², −a², and (ac)²'s six when c ≠ 0, each by TwoProduct); returns their count.
#must_use
fn _bj_e_dparts(a: f64, b: f64, c: f64, t: *f64): i64 {
    var bh, bl = _bj_k_two_prod(b, b);
    var ah, al = _bj_k_two_prod(a, a);
    var b_h: f64 = bh;
    var b_l: f64 = bl;
    var a_h: f64 = ah;
    var a_l: f64 = al;
    t[0] = b_h;
    t[1] = b_l;
    t[2] = -a_h;
    t[3] = -a_l;
    if (c == 0.0) { return 4; }
    var th, tl = _bj_k_two_prod(a, c);
    var t_h: f64 = th;
    var t_l: f64 = tl;
    var p1, e1 = _bj_k_two_prod(t_h, t_h);
    var p2, e2 = _bj_k_two_prod(t_h, t_l);
    var p3, e3 = _bj_k_two_prod(t_l, t_l);
    var q1: f64 = p1;
    var r1: f64 = e1;
    var q2: f64 = p2;
    var r2: f64 = e2;
    var q3: f64 = p3;
    var r3: f64 = e3;
    t[4] = q1;
    t[5] = r1;
    t[6] = q2 * 2.0;
    t[7] = r2 * 2.0;
    t[8] = q3;
    t[9] = r3;
    return 10;
}

# The sign (−1, 0 or 1) of the exact sum of the n ≤ 24 doubles at t (Shewchuk's Grow-Expansion: the top component's).
#must_use
fn _bj_e_sum_sign(t: *f64, n): i64 {
    var ex: f64[24];
    var k = 0;
    for (var i = 0; i < n; i = i + 1) {
        var ti: f64 = t[i];
        k = _bj_g_grow(&ex, k, ti);
    }
    if (k == 0) { return 0; }
    var top: f64 = ex[k - 1];
    if (top > 0.0) { return 1; }
    return 0 - 1;
}

# The sign of D − ((y + h)·b)², exactly (the section comment's exact check).
#must_use
fn _bj_e_cos_side(a: f64, b: f64, c: f64, y: f64, h: f64): i64 {
    var t: f64[24];
    var n = _bj_e_dparts(a, b, c, &t);
    var g1, g2 = _bj_k_two_prod(y, b);
    var x: f64[3];
    var gg1: f64 = g1;
    var gg2: f64 = g2;
    x[0] = gg1;
    x[1] = gg2;
    x[2] = h * b;
    for (var i = 0; i < 3; i = i + 1) {
        for (var j = i; j < 3; j = j + 1) {
            var xi: f64 = x[i];
            var xj: f64 = x[j];
            var p, e = _bj_k_two_prod(xi, xj);
            var pp: f64 = p;
            var pe: f64 = e;
            if (j != i) {
                pp = pp * 2.0;
                pe = pe * 2.0;
            }
            t[n] = -pp;
            t[n + 1] = -pe;
            n = n + 2;
        }
    }
    return _bj_e_sum_sign(&t, n);
}

# RN(√D/b) from a candidate y within an ulp of it (the section comment's exact check).
#must_use
fn _bj_e_cos_settle(a: f64, b: f64, c: f64, y: f64): f64 {
    var up: f64 = _bj_g_step(y, 1);
    var hu: f64 = (up - y) * 0.5;
    var su = _bj_e_cos_side(a, b, c, y, hu);
    if (su > 0) { return up; }
    if (su == 0) {
        var eu: f64 = _bj_g_even(y, up);
        return eu;
    }
    var dn: f64 = _bj_g_step(y, 0 - 1);
    var hd: f64 = (dn - y) * 0.5;
    var sd = _bj_e_cos_side(a, b, c, y, hd);
    if (sd < 0) { return dn; }
    if (sd == 0) {
        var ed: f64 = _bj_g_even(dn, y);
        return ed;
    }
    return y;
}

# The trig-free Fresnel cosine (the section comment): 1 under total internal reflection (n₁²(1 − c²) > n₂² exactly);
# otherwise 0, with out[0] := RN(cos θ_t), cos θ_t = √(n₂² − n₁²(1 − c²))/n₂. For positive finite n₁, n₂ and c in
# [0, 1]. slow = 1 skips the rounding tests, so the exact check always runs (cr_verify.py's cos_t_slow).
#must_use
fn _bj_cr_cos_t(n1: f64, n2: f64, c: f64, slow, out: *f64): i64 {
    if (n1 == n2) {
        var ac: f64 = f64_abs(c);
        out[0] = ac;
        return 0;
    }
    if (c == 1.0) {
        out[0] = 1.0;
        return 0;
    }
    var w1 = _bj_bits(n1);
    var w2 = _bj_bits(n2);
    var f1 = w1 >> 52;
    var f2 = w2 >> 52;
    var a: f64 = 0.0;
    var b: f64 = 0.0;
    var d = 0;
    if (f1 != 0 && f2 != 0) {
        d = f1 - f2;
        if (d >= 28) { return 1; }
        if (d <= 0 - 62) {
            out[0] = 1.0;
            return 0;
        }
        b = _bj_from_bits((w2 & 0xFFFFFFFFFFFFF) | 0x3FF0000000000000);
        a = _bj_from_bits(w1 - ((f2 - 1023) << 52));
    } else {
        var s1, x1 = _bj_e_frexp(n1);
        var s2, x2 = _bj_e_frexp(n2);
        d = x1 - x2;
        if (d >= 28) { return 1; }
        if (d <= 0 - 62) {
            out[0] = 1.0;
            return 0;
        }
        var ss1: f64 = s1;
        var ss2: f64 = s2;
        b = ss2;
        a = _bj_from_bits(_bj_bits(ss1) + (d << 52));
    }
    var cc: f64 = c;
    var lo300: f64 = 0x2D30000000000000;            # 2^-300
    if (cc < lo300) { cc = 0.0; }
    var sp: f64 = 134217729.0;                      # TwoProducts inline (Veltkamp's 2^27 + 1 split)
    var p: f64 = cc * cc;
    var kc: f64 = sp * cc;
    var ch: f64 = kc - (kc - cc);
    var cl: f64 = cc - ch;
    var pe: f64 = (cl * cl) - (((p - (ch * ch)) - (cl * ch)) - (ch * cl));
    var s1f: f64 = 1.0 - p;                         # 1 − c² = s_h + s_l: FastTwoSum(1, −p), then −pe
    var zf: f64 = s1f - 1.0;
    var mp: f64 = -p;
    var er: f64 = mp - zf;
    var sr: f64 = er - pe;
    var s_h: f64 = s1f + sr;
    var s_l: f64 = sr - (s_h - s1f);
    var a2: f64 = a * a;
    var ka: f64 = sp * a;
    var ahh: f64 = ka - (ka - a);
    var ahl: f64 = a - ahh;
