# bijli — bridge: cross-crate bridges between other AGNOS science crates' primitive values and bijli's
# electromagnetism parameters (ushma: thermodynamics; prakash: optics; tanmatra: atomic physics; dravya: material
# science). Always available, dependency-free: each function takes and gives f64 values (M7 part 1a).
#
# Each function is bridge.rs's chain in Rust's order of operations: + − × ÷, sqrt (correctly rounded) and a clamp, so
# every result is Rust's bits. The constants are bridge.rs's own (src/bridge_data.cyr, generated from Rust 1.2.0's
# literals by scripts/oracle/validate.py), CODATA 2018 where they are physical. The sentinels are Rust's: 0.0 or 1.0
# where an argument is not positive (NaN included), as each function says.

private

# ── ushma (thermodynamics) ─────────────────────────────────────────────────────────────────────────────────────────

# Joule heating power per unit volume (W/m³), p = J²·ρ, from the current density magnitude J (A/m²) and the bulk
# resistivity ρ (Ω·m); feeds bj_em_energy_to_heating_rate. Mirrors `joule_heating_power_density`.
#must_use
#pure
public fn bj_joule_heating_power_density(current_density_a_m2: f64, resistivity_ohm_m: f64): f64 {
    var jj: f64 = current_density_a_m2 * current_density_a_m2;
    var p: f64 = jj * resistivity_ohm_m;
    return p;
}

# The temperature rise rate (K/s) of an absorbed EM power density p (W/m³) under adiabatic heating, dT/dt = p/(ρ·c_p),
# ρ the mass density (kg/m³) and c_p the specific heat (J/(kg·K)); 0.0 where ρ·c_p is not positive (NaN included).
# Mirrors `em_energy_to_heating_rate`.
#must_use
#pure
public fn bj_em_energy_to_heating_rate(power_density_w_m3: f64, material_density_kg_m3: f64,
  specific_heat_j_per_kg_k: f64): f64 {
    var denom: f64 = material_density_kg_m3 * specific_heat_j_per_kg_k;
    if (denom > 0.0) {
        var r: f64 = power_density_w_m3 / denom;
        return r;
    }
    return 0.0;
}

# ── prakash (optics) ───────────────────────────────────────────────────────────────────────────────────────────────

# Schott N-BK7's refractive index at a vacuum wavelength λ (nm), by the Sellmeier equation with λ in µm: n² = 1 +
# B₁λ²/(λ² − C₁) + B₂λ²/(λ² − C₂) + B₃λ²/(λ² − C₃) (n_d = 1.5168 at 587.56 nm). The fit holds for 300–2500 nm; outside
# it the value is an extrapolation (poles near 77 nm, 141 nm and 10.2 µm). The sentinel 1.0 where λ is not positive
# (NaN included) or n² ≤ 0 (NaN included). Mirrors `wavelength_to_refractive_index_bk7`.
#must_use
#pure
public fn bj_wavelength_to_refractive_index_bk7(wavelength_nm: f64): f64 {
    if (wavelength_nm != wavelength_nm || wavelength_nm <= 0.0) { return 1.0; }
    var um: f64 = wavelength_nm * _BJ_BRIDGE_NM_TO_UM;
    var l2: f64 = um * um;
    var t1: f64 = _BJ_BRIDGE_BK7_B1 * l2;
    var d1: f64 = l2 - _BJ_BRIDGE_BK7_C1;
    var q1: f64 = t1 / d1;
    var n2: f64 = 1.0 + q1;
    var t2: f64 = _BJ_BRIDGE_BK7_B2 * l2;
    var d2: f64 = l2 - _BJ_BRIDGE_BK7_C2;
    var q2: f64 = t2 / d2;
    n2 = n2 + q2;
    var t3: f64 = _BJ_BRIDGE_BK7_B3 * l2;
    var d3: f64 = l2 - _BJ_BRIDGE_BK7_C3;
    var q3: f64 = t3 / d3;
    n2 = n2 + q3;
    if (n2 > 0.0) {
        var n: f64 = f64_sqrt(n2);
        return n;
    }
    return 1.0;
}

# The time-averaged optical intensity (W/m²) of a plane wave in vacuum with peak E-field amplitude E (V/m), I =
# ε₀·c·E²/2. Mirrors `e_field_to_optical_intensity`.
#must_use
#pure
public fn bj_e_field_to_optical_intensity(e_amplitude_v_m: f64): f64 {
    var a: f64 = 0.5 * _BJ_BRIDGE_EPSILON_0;
    var b: f64 = a * _BJ_BRIDGE_C;
    var c: f64 = b * e_amplitude_v_m;
    var i: f64 = c * e_amplitude_v_m;
    return i;
}

# ── tanmatra (atomic and nuclear physics) ──────────────────────────────────────────────────────────────────────────

# The vacuum emission wavelength (nm) of a photon from an electron energy level transition E (eV), λ = hc/E with hc =
# 1239.841984… eV·nm (exact SI h, c and e); 0.0 where E is not positive (NaN included). Mirrors
# `energy_level_to_wavelength_nm`.
#must_use
#pure
public fn bj_energy_level_to_wavelength_nm(energy_ev: f64): f64 {
    if (energy_ev != energy_ev || energy_ev <= 0.0) { return 0.0; }
    var lam: f64 = _BJ_BRIDGE_HC_EV_NM / energy_ev;
    return lam;
}

# The Coulomb potential (V) of a nuclear charge Z at distance r (m), V = k·Z·e/r with k = 1/(4πε₀) and e the
# elementary charge (CODATA 2018). Z is Rust's u32 (0 ≤ Z < 2³²); 0.0 where r is not positive (NaN included), and for
# the Cyrius-only Z outside a u32, which Rust's type can't take. Mirrors `nuclear_charge_potential`.
#must_use
#pure
public fn bj_nuclear_charge_potential(atomic_number, distance_m: f64): f64 {
    if (distance_m != distance_m || distance_m <= 0.0) { return 0.0; }
    if (atomic_number < 0 || atomic_number > 4294967295) { return 0.0; }
    var z: f64 = f64_from(atomic_number);
    var kz: f64 = _BJ_BRIDGE_K * z;
    var kze: f64 = kz * _BJ_BRIDGE_E;
    var v: f64 = kze / distance_m;
    return v;
}

# ── dravya (material science) ──────────────────────────────────────────────────────────────────────────────────────

# The piezoelectric blocking stress (Pa) of a field E (V/m) for one stress coefficient e (C/m², e.g. e₃₃), σ = e·E:
# the stress the material exerts on a rigid clamp, positive where the field drives expansion (IEEE Std 176's clamped
# T = −e·E is its negative). Mirrors `e_field_to_piezo_stress`.
#must_use
#pure
public fn bj_e_field_to_piezo_stress(e_field_v_m: f64, piezo_coeff_c_m2: f64): f64 {
    var s: f64 = e_field_v_m * piezo_coeff_c_m2;
    return s;
}

# The magnetostrictive strain of a flux density B (T) in the quadratic-moment model, ε = (3/2)·λ_s·(B/B_sat)² with
# B/B_sat clamped to [−1, 1] (the strain saturates; NaN stays NaN, as Rust's f64::clamp), λ_s the isotropic saturation
# magnetostriction (signed, e.g. ≈ −7·10⁻⁶ for iron) and B_sat the saturation flux density (T); 0.0 where B_sat is not
# positive (NaN included). Mirrors `magnetic_flux_to_magnetostrictive_strain`.
#must_use
#pure
public fn bj_magnetic_flux_to_magnetostrictive_strain(flux_density_t: f64, saturation_magnetostriction: f64,
  saturation_flux_t: f64): f64 {
    if (saturation_flux_t != saturation_flux_t || saturation_flux_t <= 0.0) { return 0.0; }
    var ratio: f64 = flux_density_t / saturation_flux_t;
    if (ratio < -1.0) { ratio = -1.0; }
    if (ratio > 1.0) { ratio = 1.0; }
    var a: f64 = 1.5 * saturation_magnetostriction;
    var b: f64 = a * ratio;
    var e: f64 = b * ratio;
    return e;
}
