include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/io.cyr"
include "lib/math.cyr"
include "lib/fnptr.cyr"

struct V3 { x: f64; y: f64; z: f64; }

# field fn: (pos: *V3, out: *V3) -> status (0 ok, 1 singular)
fn trace(field_fn, start: *V3, steps, ds: f64, out: *V3): i64 {
    var p: V3; p.x = start.x; p.y = start.y; p.z = start.z;
    var e: V3;
    var i = 0;
    while (i < steps) {
        var st = callptr(field_fn, &p, &e);
        if (st != 0) { break; }
        var m: f64 = f64_sqrt(e.x * e.x + e.y * e.y + e.z * e.z);
        p.x = p.x + ds * e.x / m; p.y = p.y + ds * e.y / m; p.z = p.z + ds * e.z / m;
        i = i + 1;
    }
    out.x = p.x; out.y = p.y; out.z = p.z;
    return i;
}

fn make_point_field(qx: f64, qy: f64, qz: f64, q: f64): i64 {
    return |pos, out| {
        var pp: *V3 = pos; var oo: *V3 = out;
        var dx: f64 = pp.x - qx; var dy: f64 = pp.y - qy; var dz: f64 = pp.z - qz;
        var r2: f64 = dx * dx + dy * dy + dz * dz;
        if (r2 < 0.000000000000000000000000000001) { return 1; }
        var r: f64 = f64_sqrt(r2);
        var k: f64 = q / (r2 * r);
        oo.x = k * dx; oo.y = k * dy; oo.z = k * dz;
        return 0;
    };
}

fn main(): i64 {
    alloc_init();
    var before = alloc_used();
    var f = make_point_field(0.0, 0.0, 0.0, 1.0);
    var mid = alloc_used();
    var s = V3 { 1.0, 0.0, 0.0 };
    var o: V3;
    var n = trace(f, &s, 1000, 0.01, &o);
    var after = alloc_used();
    println_int(n);
    fmt_hex0x(o.x); println("");
    println_int(mid - before);
    println_int(after - mid);
    # closure with 6 params (capturing) should be refused; non-capturing ok?
    return 0;
}
