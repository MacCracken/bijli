# field.tcyr — src/field.cyr (M1 parts 3a and 3b): vectors, point charges, dipoles, the Gauss's-law fields, multipoles,
# images, Green's functions and the stress tensor.
#
# Every group named test_* is rust-old/src/field.rs's test of that name, ported assertion for assertion (the ledger
# matches them by name): all 105, parts 3a, 3b and 3c. tests/golden/field.tsv pins every
# function over its grid against Rust besides.

include "lib/alloc.cyr"    # a capturing closure's heap environment (the compiler asks for it by name)
include "tests/lib.cyr"

# p = (x, y, z), three f64 at p.
fn at3(p: *f64, x: f64, y: f64, z: f64) {
    p[0] = x;
    p[1] = y;
    p[2] = z;
    return 0;
}

# |a − b| < tol.
fn near(a: f64, b: f64, tol: f64): i64 {
    var d: f64 = a - b;
    var ad: f64 = f64_abs(d);
    if (ad < tol) { return 1; }
    return 0;
}

# 1 when the C strings a and b are equal.
fn text_is(a, b): i64 {
    var n = strlen(a);
    if (n != strlen(b)) { return 0; }
    return memeq(a, b, n);
}

# Charge k of a charge list (32 bytes each: q, x, y, z, Rust's `(f64, [f64; 3])`).
fn put4(p: *f64, k, q: f64, x: f64, y: f64, z: f64) {
    p[k * 4] = q;
    p[k * 4 + 1] = x;
    p[k * 4 + 2] = y;
    p[k * 4 + 3] = z;
    return 0;
}

# Σ kq/|p − c| over n charges, each distance √(Σ (pᵢ − cᵢ)²) by powi(2), summed in order from 0: the Rust tests'
# `direct_potential` (rust-old/src/field.rs, its test module).
fn direct_potential(charges: *f64, n, p: *f64): f64 {
    var sum: f64 = 0.0;
    for (var i = 0; i < n; i = i + 1) {
        var c: *f64 = charges + i * 4;
        var dx: f64 = p[0] - c[1];
        var dy: f64 = p[1] - c[2];
        var dz: f64 = p[2] - c[3];
        var sx: f64 = _bj_powi(dx, 2);
        var sy: f64 = _bj_powi(dy, 2);
        var sz: f64 = _bj_powi(dz, 2);
        var d: f64 = f64_sqrt(sx + sy + sz);
        var v: f64 = BJ_COULOMB_K * c[0] / d;
        sum = sum + v;
    }
    return sum;
}

# A closure's untyped parameter as a *f64 (a typed return binds it without a warning).
fn as_f64p(p): *f64 { return p; }

# A closure's untyped parameter as a *BjFieldVector.
fn as_fv(p): *BjFieldVector { return p; }

# The f64 with bit pattern b.
fn fb(b): f64 {
    var x: f64 = 0.0;
    store64(&x, b);
    return x;
}

# 1 when the f64 x has bit pattern b.
fn same_bits(x: f64, b): i64 {
    var w = 0;
    store64(&w, x);
    if (w == b) { return 1; }
    return 0;
}

# 1 when the Ok Result (t, v) holds the f64 with bit pattern b.
fn ok_bits(t, v, b): i64 {
    if (is_ok(t) != 1) { return 0; }
    if (v != b) { return 0; }
    return 1;
}

# Runs field.rs's tests (parts 3a, 3b and 3c).
fn main() {
    alloc_init();
    var o: f64[3];
    var p: f64[3];
    var q: f64[3];
    var b3: f64[3];
    var e: BjFieldVector;
    at3(&o, 0.0, 0.0, 0.0);
    var e10: f64 = 0.0000000001;
    var e6: f64 = 0.000001;
    var q6: f64 = 0.000001;
    var p30: f64 = _bj_from_bits(0x39B4484BFEEBC2A0);          # 1e-30

    test_group("test_field_vector_magnitude");
    var v = BjFieldVector_new(3.0, 4.0, 0.0);
    var vm: f64 = v.magnitude();
    assert(near(vm, 5.0, e10) == 1, "|(3, 4, 0)| = 5");

    test_group("test_field_vector_dot");
    var ax = BjFieldVector_new(1.0, 0.0, 0.0);
    var ay = BjFieldVector_new(0.0, 1.0, 0.0);
    var dt: f64 = ax.dot(ay);
    assert(near(dt, 0.0, e10) == 1, "x̂·ŷ = 0");

    test_group("test_field_vector_cross");
    var xz = ax.cross(ay);
    var xzz: f64 = xz.z;
    assert(near(xzz, 1.0, e10) == 1, "x̂ × ŷ = ẑ");

    test_group("test_electric_field_positive_charge");
    at3(&p, 1.0, 0.0, 0.0);
    var t1, v1 = bj_electric_field_point_charge(q6, &o, &p, &e);
    assert(is_ok(t1) == 1, "ok");
    var ex: f64 = e.x;
    var ey: f64 = e.y;
    assert(ex > 0.0, "E points away from a positive charge");
    assert(near(ey, 0.0, e10) == 1, "no y component");

    test_group("test_electric_field_negative_charge");
    var mq6: f64 = -q6;
    var t2, v2 = bj_electric_field_point_charge(mq6, &o, &p, &e);
    ex = e.x;
    assert(ex < 0.0, "E points toward a negative charge");

    test_group("test_singularity_at_source");
    var t3, v3 = bj_electric_field_point_charge(q6, &o, &o, &e);
    assert(is_err_result(t3) == 1, "the source point is singular");

    test_group("test_electric_potential");
    var t4, v4 = bj_electric_potential_point_charge(q6, &o, &p);
    var pv: f64 = v4;
    assert(near(pv, 8987.551792, 1.0) == 1, "V = kq/r ≈ 8987.55 V");

    test_group("test_inverse_square_law");
    var e1: BjFieldVector;
    var e2: BjFieldVector;
    at3(&q, 2.0, 0.0, 0.0);
    var t5, v5 = bj_electric_field_point_charge(q6, &o, &p, &e1);
    var t6, v6 = bj_electric_field_point_charge(q6, &o, &q, &e2);
    var m1: f64 = e1.magnitude();
    var m2: f64 = e2.magnitude();
    var ratio: f64 = m1 / m2;
    assert(near(ratio, 4.0, e6) == 1, "E at 2r is E at r / 4");

    test_group("test_superposition_cancellation");
    var charges: f64[8];
    charges[0] = q6;
    charges[1] = -1.0;
    charges[2] = 0.0;
    charges[3] = 0.0;
    charges[4] = q6;
    charges[5] = 1.0;
    charges[6] = 0.0;
    charges[7] = 0.0;
    var t7, v7 = bj_electric_field_superposition(&charges, 2, &o, &e);
    assert(is_ok(t7) == 1, "ok");
    ex = e.x;
    assert(near(ex, 0.0, e6) == 1, "symmetric charges cancel at the midpoint");

    test_group("test_magnetic_field_moving_charge");
    var vel: f64[3];
    at3(&vel, 1000000.0, 0.0, 0.0);
    at3(&q, 0.0, 1.0, 0.0);
    var t8, v8 = bj_magnetic_field_moving_charge(q6, &o, &vel, &q, &e);
    var bz: f64 = e.z;
    assert(bz > 0.0, "x̂ × ŷ = ẑ: B along +z");

    test_group("test_energy_density_electric");
    var u: f64 = bj_electric_energy_density(1000.0);
    assert(u > 0.0, "positive");
    var ue: f64 = 0.5 * BJ_EPSILON_0 * 1000000.0;
    assert(near(u, ue, e10) == 1, "ε₀E²/2");

    test_group("test_energy_density_magnetic");
    var um: f64 = bj_magnetic_energy_density(1.0);
    assert(um > 0.0, "positive");

    test_group("test_normalized");
    var n = BjFieldVector_zero();
    var t9, v9 = v.normalized(&n);
    var nm: f64 = n.magnitude();
    assert(near(nm, 1.0, e10) == 1, "a unit vector");

    test_group("test_zero_vector_normalize_fails");
    var z0 = BjFieldVector_zero();
    var t10, v10 = z0.normalized(&n);
    assert(is_err_result(t10) == 1, "the zero vector has no direction");

    test_group("test_ops_add");
    var a = BjFieldVector_new(1.0, 2.0, 3.0);
    var b = BjFieldVector_new(4.0, 5.0, 6.0);
    var c = a + b;
    assert_eq(c.eq(BjFieldVector_new(5.0, 7.0, 9.0)), 1, "a + b");

    test_group("test_ops_sub");
    c = b - a;
    assert_eq(c.eq(BjFieldVector_new(3.0, 3.0, 3.0)), 1, "b - a");

    test_group("test_ops_mul");
    c = a * 2.0;
    assert_eq(c.eq(BjFieldVector_new(2.0, 4.0, 6.0)), 1, "a * 2");

    test_group("test_ops_neg");
    var an = BjFieldVector_new(1.0, -2.0, 3.0);
    c = BjFieldVector_neg(an);
    assert_eq(c.eq(BjFieldVector_new(-1.0, 2.0, -3.0)), 1, "-a");

    test_group("test_partial_eq");
    var a2 = BjFieldVector_new(1.0, 2.0, 3.0);
    assert_eq(a.eq(a2), 1, "equal components are equal");

    test_group("test_magnitude_sq");
    var ms: f64 = a.magnitude_sq();
    assert(near(ms, 14.0, e10) == 1, "1 + 4 + 9");

    test_group("test_ops_add_assign");
    # Rust's `a += b` is `a = a + b` (Cyrius refuses += on a struct value).
    var aa = BjFieldVector_new(1.0, 2.0, 3.0);
    aa = aa + BjFieldVector_new(4.0, 5.0, 6.0);
    assert_eq(aa.eq(BjFieldVector_new(5.0, 7.0, 9.0)), 1, "a += b");

    test_group("test_ops_sub_assign");
    var asb = BjFieldVector_new(4.0, 5.0, 6.0);
    asb = asb - BjFieldVector_new(1.0, 2.0, 3.0);
    assert_eq(asb.eq(BjFieldVector_new(3.0, 3.0, 3.0)), 1, "a -= b");

    test_group("test_ops_mul_assign");
    var am = BjFieldVector_new(1.0, 2.0, 3.0);
    am = am * 2.0;
    assert_eq(am.eq(BjFieldVector_new(2.0, 4.0, 6.0)), 1, "a *= 2");

    test_group("test_ops_scalar_mul_lhs");
    c = BjFieldVector_scale_left(2.0, a);
    assert_eq(c.eq(BjFieldVector_new(2.0, 4.0, 6.0)), 1, "2 * a");

    test_group("test_display");
    var buf[200];
    var tx[24];
    _bj_tx_init(&tx, &buf, 200);
    var dv = BjFieldVector_new(1.0, 2.5, -3.0);
    dv.display(&tx);
    assert(text_is(_bj_tx_ptr(&tx), "(1, 2.5, -3)") == 1, "\"(1, 2.5, -3)\"");

    test_group("test_electric_field_singularity");
    var t11, v11 = bj_electric_field_point_charge(q6, &o, &o, &e);
    assert(is_err_result(t11) == 1, "singular");

    test_group("test_electric_potential_singularity");
    var t12, v12 = bj_electric_potential_point_charge(q6, &o, &o);
    assert(is_err_result(t12) == 1, "singular");

    test_group("test_magnetic_field_singularity");
    var t13, v13 = bj_magnetic_field_moving_charge(q6, &o, &vel, &o, &e);
    assert(is_err_result(t13) == 1, "singular");

    test_group("test_electric_dipole_on_axis");
    var dp = BjFieldVector_new(0.0, 0.0, p30);
    at3(&q, 0.0, 0.0, 1.0);
    var t14, v14 = bj_electric_dipole_field(dp, &q, &e);
    var k4: f64 = 4.0 * _BJ_PI * BJ_EPSILON_0 * 1.0 * 1.0 * 1.0;
    var expz: f64 = 2.0 * p30 / k4;
    var ez: f64 = e.z;
    var rel: f64 = (ez - expz) / expz;
    var arel: f64 = f64_abs(rel);
    assert(arel < e6, "E_z = 2p/(4πε₀d³) on the axis");
    ex = e.x;
    var axx: f64 = f64_abs(ex);
    assert(axx < 0.0000000000000000000000000000000000000001, "|E_x| < 1e-40");

    test_group("test_electric_dipole_equatorial");
    at3(&q, 1.0, 0.0, 0.0);
    var t15, v15 = bj_electric_dipole_field(dp, &q, &e);
    var mp30: f64 = -p30;
    var expe: f64 = mp30 / k4;
    ez = e.z;
    var rel2: f64 = (ez - expe) / f64_abs(expe);
    var arel2: f64 = f64_abs(rel2);
    assert(arel2 < e6, "E = -p/(4πε₀r³) on the equatorial plane");

    test_group("test_electric_dipole_singularity");
    var t16, v16 = bj_electric_dipole_field(dp, &o, &e);
    assert(is_err_result(t16) == 1, "singular at the dipole");

    test_group("test_electric_dipole_potential_on_axis");
    at3(&q, 0.0, 0.0, 1.0);
    var t17, v17 = bj_electric_dipole_potential(dp, &q);
    var dpv: f64 = v17;
    var four: f64 = 4.0 * _BJ_PI * BJ_EPSILON_0;
    var expv: f64 = p30 / four;
    var rel3: f64 = (dpv - expv) / expv;
    var arel3: f64 = f64_abs(rel3);
    assert(arel3 < e6, "V = p/(4πε₀r²) on the axis");

    test_group("test_electric_dipole_potential_equatorial_zero");
    at3(&q, 1.0, 0.0, 0.0);
    var t18, v18 = bj_electric_dipole_potential(dp, &q);
    var dv0: f64 = v18;
    var adv0: f64 = f64_abs(dv0);
    assert(adv0 < 0.00000000000000000000000000000000000000000000000001, "p·r̂ = 0: |V| < 1e-50");

    test_group("test_magnetic_dipole_on_axis");
    var mm = BjFieldVector_new(0.0, 0.0, 1.0);
    at3(&q, 0.0, 0.0, 1.0);
    var t19, v19 = bj_magnetic_dipole_field(mm, &q, &e);
    var kb: f64 = 4.0 * _BJ_PI * 1.0 * 1.0 * 1.0;
    var expb: f64 = 2.0 * BJ_MU_0 / kb;
    var bzz: f64 = e.z;
    var rel4: f64 = (bzz - expb) / expb;
    var arel4: f64 = f64_abs(rel4);
    assert(arel4 < e6, "B_z = 2μ₀m/(4πd³) on the axis");

    test_group("test_magnetic_dipole_singularity");
    var t20, v20 = bj_magnetic_dipole_field(mm, &o, &e);
    assert(is_err_result(t20) == 1, "singular at the dipole");

    test_group("test_default_is_zero");
    var dz = BjFieldVector_default();
    assert_eq(dz.eq(BjFieldVector_zero()), 1, "Default is zero");

    test_group("test_from_array");
    var arr: f64[3];
    at3(&arr, 1.0, 2.0, 3.0);
    var fa = BjFieldVector_from_array(&arr);
    assert_eq(fa.eq(BjFieldVector_new(1.0, 2.0, 3.0)), 1, "from [1, 2, 3]");

    test_group("test_into_array");
    var out3: f64[3];
    a.to_array(&out3);
    var o0: f64 = out3[0];
    var o1: f64 = out3[1];
    var o2: f64 = out3[2];
    assert(o0 == 1.0 && o1 == 2.0 && o2 == 3.0, "into [1, 2, 3]");

    test_group("test_normalized_small_si_magnitudes");
    var scales: f64[4];
    scales[0] = _bj_from_bits(0x3C079CA10C924223);             # 1.6e-19
    scales[1] = _bj_from_bits(0x39DF700F64BA3A77);             # 6.2e-30
    scales[2] = _bj_from_bits(0x16687E92154EF7AC);             # 1e-200
    scales[3] = _bj_from_bits(0x01A56E1FC2F8F359);             # 1e-300
    var e15: f64 = 0.000000000000001;
    for (var k = 0; k < 4; k = k + 1) {
        var s: f64 = scales[k];
        var sv = BjFieldVector_new(3.0 * s, 0.0, 4.0 * s);
        var tn, vn = sv.normalized(&n);
        var nx: f64 = n.x;
        var nz: f64 = n.z;
        assert(is_ok(tn) == 1 && near(nx, 0.6, e15) == 1 && near(nz, 0.8, e15) == 1, "(3s, 0, 4s) -> (0.6, 0, 0.8)");
    }

    test_group("test_normalized_huge_components");
    var h200: f64 = _bj_from_bits(0x6974E718D7D7625A);         # 1e200
    var hv = BjFieldVector_new(h200, h200, 0.0);
    var th, vh = hv.normalized(&n);
    var hh: f64 = 0.7071067811865476;                           # FRAC_1_SQRT_2
    var hx: f64 = n.x;
    var hy: f64 = n.y;
    assert(is_ok(th) == 1 && near(hx, hh, e15) == 1 && near(hy, hh, e15) == 1,
      "|v|² overflows, the direction does not");

    test_group("test_normalized_non_finite_fails");
    var zero: f64 = 0.0;
    var nan: f64 = zero / zero;
    var inf: f64 = 1.0 / zero;
    var nv = BjFieldVector_new(nan, 1.0, 0.0);
    var tq1, vq1 = nv.normalized(&n);
    assert(is_err_result(tq1) == 1, "NaN component");
    var iv = BjFieldVector_new(inf, 1.0, 0.0);
    var tq2, vq2 = iv.normalized(&n);
    assert(is_err_result(tq2) == 1, "infinite component");

    test_group("test_constants_codata_2018_consistent");
    var one: f64 = BJ_EPSILON_0 * BJ_MU_0 * BJ_SPEED_OF_LIGHT_SQ;
    assert(near(one, 1.0, 0.000000000001) == 1, "ε₀μ₀c² = 1 to 1e-12");
    var kk: f64 = 1.0 / (4.0 * _BJ_PI * BJ_EPSILON_0);
    var rk: f64 = (BJ_COULOMB_K - kk) / kk;
    var ark: f64 = f64_abs(rk);
    assert(ark < e15, "k = 1/(4πε₀)");
    assert(near(BJ_EPSILON_0, 0.0000000000088541878128, 0.0000000000000000000001) == 1, "ε₀ = 8.8541878128e-12");
    var rk2: f64 = (BJ_COULOMB_K - 8987551792.3) / BJ_COULOMB_K;
    var ark2: f64 = f64_abs(rk2);
    assert(ark2 < e10, "k = 8.9875517923e9");

    test_group("singular_cutoff_and_records");
    # Cyrius-only: the cutoff is Rust's 1e-30 to the bit, a singular call leaves out alone and records Singularity,
    # and a normalize error records Rust's text.
    assert_eq(_bj_bits(_BJ_FIELD_R2_MIN), _bj_bits(p30), "the r² cutoff is 1e-30");
    var keep = BjFieldVector_new(7.0, 8.0, 9.0);
    var tk, vk = bj_electric_field_point_charge(q6, &o, &o, &keep);
    assert_eq(keep.eq(BjFieldVector_new(7.0, 8.0, 9.0)), 1, "out untouched on an error");
    assert_eq(bj_last_error(), BJ_ERR_SINGULARITY, "Singularity recorded");
    var tq3, vq3 = nv.normalized(&n);
    assert(text_is(bj_last_error_display(), "invalid parameter: cannot normalize non-finite vector (NaN, 1, 0)") == 1,
      "Rust's message");

    # ── part 3b ──
    var cs: f64[16];
    var ip: f64[3];
    var cc: BjComplex;
    var e12: f64 = 0.000000000001;
    var e30: f64 = 0.000000000000000000000000000001;
    var e20: f64 = 0.00000000000000000001;

    test_group("test_infinite_plane");
    var sg: f64 = 0.000001;
    var pe: f64 = bj_electric_field_infinite_plane(sg);
    var pe2: f64 = sg / (2.0 * BJ_EPSILON_0);
    assert(near(pe, pe2, 1.0) == 1, "σ/(2ε₀)");

    test_group("test_charged_sphere_matches_point_charge");
    var tb1, vb1 = bj_electric_field_charged_sphere(q6, 2.0);
    var es1: f64 = vb1;
    at3(&q, 2.0, 0.0, 0.0);
    var tb2, vb2 = bj_electric_field_point_charge(q6, &o, &q, &e);
    var ep1: f64 = e.magnitude();
    assert(f64_abs(es1 - ep1) / ep1 < e6, "the sphere's field is the point charge's");

    test_group("test_charged_sphere_singularity");
    var tb3, vb3 = bj_electric_field_charged_sphere(q6, 0.0);
    assert(is_err_result(tb3) == 1, "r = 0 is singular");

    test_group("test_inside_sphere_zero_at_center");
    var tb4, vb4 = bj_electric_field_inside_sphere(q6, 1.0, 0.0);
    var ei0: f64 = vb4;
    assert(f64_abs(ei0) < e30, "zero at the centre");

    test_group("test_inside_sphere_linear_growth");
    var tb5, vb5 = bj_electric_field_inside_sphere(q6, 1.0, 0.25);
    var tb6, vb6 = bj_electric_field_inside_sphere(q6, 1.0, 0.5);
    var g1: f64 = vb5;
    var g2: f64 = vb6;
    assert(near(g2 / g1, 2.0, e6) == 1, "linear in r");

    test_group("test_infinite_line");
    var tb7, vb7 = bj_electric_field_infinite_line(q6, 1.0);
    var el: f64 = vb7;
    var elx: f64 = q6 / (2.0 * _BJ_PI * BJ_EPSILON_0 * 1.0);
    assert(f64_abs(el - elx) / elx < e6, "λ/(2πε₀r)");

    test_group("test_infinite_line_singularity");
    var tb8, vb8 = bj_electric_field_infinite_line(q6, 0.0);
    assert(is_err_result(tb8) == 1, "r = 0 is singular");

    test_group("test_outside_cylinder_equals_line");
    var tb9, vb9 = bj_electric_field_outside_cylinder(q6, 2.0);
    var tb10, vb10 = bj_electric_field_infinite_line(q6, 2.0);
    var ec1: f64 = vb9;
    var ec2: f64 = vb10;
    assert(f64_abs(ec1 - ec2) < e30, "the same field");

    test_group("test_inside_cylinder");
    var tb11, vb11 = bj_electric_field_inside_cylinder(q6, 0.5);
    var eic: f64 = vb11;
    var eicx: f64 = q6 * 0.5 / (2.0 * BJ_EPSILON_0);
    assert(f64_abs(eic - eicx) / eicx < e6, "ρr/(2ε₀)");

    test_group("test_ring_axis_center");
    var tb12, vb12 = bj_electric_field_ring_axis(q6, 1.0, 0.0);
    var er0: f64 = vb12;
    assert(f64_abs(er0) < e30, "zero at the ring's centre");

    test_group("test_ring_axis_far_field");
    var tb13, vb13 = bj_electric_field_ring_axis(q6, 0.01, 10.0);
    var erf: f64 = vb13;
    var epf: f64 = BJ_COULOMB_K * q6 / (10.0 * 10.0);
    assert(f64_abs(erf - epf) / epf < 0.0001, "a point charge far away");

    test_group("test_disk_axis_far_field_approaches_point");
    var tb14, vb14 = bj_electric_field_disk_axis(q6, 0.01, 100.0);
    var edf: f64 = vb14;
    var qd: f64 = q6 * _BJ_PI * 0.01 * 0.01;
    var epd: f64 = BJ_COULOMB_K * qd / (100.0 * 100.0);
    assert(f64_abs(edf - epd) / epd < 0.01, "a point charge far away");

    test_group("test_disk_axis_close_approaches_infinite_plane");
    var tb15, vb15 = bj_electric_field_disk_axis(q6, 1000.0, 0.001);
    var edc: f64 = vb15;
    var epl: f64 = bj_electric_field_infinite_plane(q6);
    assert(f64_abs(edc - epl) / epl < 0.01, "a plane close up");

    test_group("test_quadrupole_potential_singularity");
    var qt: f64[9];
    for (var k = 0; k < 9; k = k + 1) { qt[k] = 0.0; }
    qt[0] = 1.0;
    qt[4] = -1.0;
    var tb16, vb16 = bj_electric_quadrupole_potential(&qt, &o);
    assert(is_err_result(tb16) == 1, "singular at the origin");

    test_group("test_quadrupole_potential_decays_faster_than_dipole");
    qt[0] = p30;
    qt[4] = -p30;
    at3(&q, 1.0, 0.0, 0.0);
    var tb17, vb17 = bj_electric_quadrupole_potential(&qt, &q);
    at3(&q, 2.0, 0.0, 0.0);
    var tb18, vb18 = bj_electric_quadrupole_potential(&qt, &q);
    var qv1: f64 = vb17;
    var qv2: f64 = vb18;
    var qr: f64 = f64_abs(qv1) / f64_abs(qv2);
    assert(near(qr, 8.0, 0.1) == 1, "1/r³");

    test_group("test_multipole_moment_monopole");
    put4(&cs, 0, q6, 0.0, 0.0, 0.0);
    put4(&cs, 1, 2.0 * q6, 1.0, 0.0, 0.0);
    var tb19, vb19 = bj_multipole_moment(0, 0, &cs, 2);
    var q00: f64 = vb19;
    assert(q00 > 0.0, "the monopole is the total charge");

    test_group("test_multipole_moment_invalid_m");
    var tb20, vb20 = bj_multipole_moment(1, 2, &cs, 0);
    assert(is_err_result(tb20) == 1, "|m| > l");

    test_group("test_associated_legendre_basic");
    var sl: f64 = f64_sqrt(1.0 - 0.25);
    var lp0: f64 = _bj_associated_legendre(0, 0, 0.5, sl);
    var lp1: f64 = _bj_associated_legendre(1, 0, 0.5, sl);
    var lp11: f64 = _bj_associated_legendre(1, 1, 0.5, sl);
    var nsl: f64 = -sl;
    assert(near(lp0, 1.0, e10) == 1 && near(lp1, 0.5, e10) == 1 && near(lp11, nsl, e10) == 1, "P00, P10, P11");

    test_group("test_image_charge_plane");
    at3(&q, 0.0, 0.0, 1.0);
    var qi1: f64 = bj_image_charge_plane(q6, &q, 0.0, &ip);
    var iz: f64 = ip[2];
    var mq: f64 = -q6;
    assert(near(qi1, mq, e20) == 1 && near(iz, -1.0, e10) == 1, "-q at the mirror point");

    test_group("test_image_charge_plane_tangential_zero");
    var on: f64[3];
    at3(&on, 1.0, 0.0, 0.0);
    var er: BjFieldVector;
    var ei: BjFieldVector;
    var tb21, vb21 = bj_electric_field_point_charge(q6, &q, &on, &er);
    var tb22, vb22 = bj_electric_field_point_charge(qi1, &ip, &on, &ei);
    var tx1: f64 = er.x + ei.x;
    var ty1: f64 = er.y + ei.y;
    assert(f64_abs(tx1) < e10 && f64_abs(ty1) < e10, "no tangential field on the plane");

    test_group("test_image_charge_sphere");
    at3(&q, 0.0, 0.0, 2.0);
    var tb23, vb23 = bj_image_charge_sphere(q6, &q, 1.0, &ip);
    var qs1: f64 = vb23;
    var isz: f64 = ip[2];
    assert(near(qs1, -0.0000005, e20) == 1 && near(isz, 0.5, e10) == 1, "-q/2 at R²/d");

    test_group("test_image_charge_sphere_inside_fails");
    at3(&q, 0.0, 0.0, 0.5);
    var tb24, vb24 = bj_image_charge_sphere(q6, &q, 1.0, &ip);
    assert(is_err_result(tb24) == 1, "inside the sphere");

    test_group("test_image_charge_dielectric");
    at3(&q, 0.0, 0.0, 1.0);
    var tb25, vb25 = bj_image_charge_dielectric(q6, &q, 1.0, 4.0, &ip);
    var qd1: f64 = vb25;
    var idz: f64 = ip[2];
    assert(near(qd1, -0.0000006, e12) == 1 && near(idz, -1.0, e10) == 1, "-q(ε₂ − ε₁)/(ε₁ + ε₂)");

    test_group("test_greens_static_coulomb");
    at3(&q, 1.0, 0.0, 0.0);
    var tb26, vb26 = bj_greens_function_static(&q, &o);
    var gs: f64 = vb26;
    assert(near(gs, 1.0 / (4.0 * _BJ_PI), e10) == 1, "1/(4πR)");

    test_group("test_greens_static_singularity");
    var tb27, vb27 = bj_greens_function_static(&o, &o);
    assert(is_err_result(tb27) == 1, "R = 0");

    test_group("test_greens_scalar_k0_matches_static");
    at3(&q, 2.0, 0.0, 0.0);
    var tb28, vb28 = bj_greens_function_scalar(&q, &o, 0.0, &cc);
    var tb29, vb29 = bj_greens_function_static(&q, &o);
    var gre: f64 = cc.re;
    var gim: f64 = cc.im;
    var gst: f64 = vb29;
    assert(near(gre, gst, e10) == 1 && f64_abs(gim) < e10, "k = 0 is the static function");

    test_group("test_stress_tensor_pure_e_field");
    var st: f64[9];
    var ef = BjFieldVector_new(1000.0, 0.0, 0.0);
    var bf = BjFieldVector_zero();
    bj_maxwell_stress_tensor(ef, bf, &st);
    var sx: f64 = 0.5 * BJ_EPSILON_0 * 1000000.0;
    var t00: f64 = st[0];
    var tyy: f64 = st[4];
    var nsx: f64 = -sx;
    assert(f64_abs(t00 - sx) / sx < e6 && f64_abs(tyy - nsx) / sx < e6, "T_xx = ε₀E²/2, T_yy = -ε₀E²/2");

    test_group("test_stress_tensor_force_on_surface");
    var nx1 = BjFieldVector_new(1.0, 0.0, 0.0);
    var fo1: BjFieldVector = bj_stress_tensor_force(&st, nx1);
    var fox: f64 = fo1.x;
    assert(fox > 0.0, "a tension along +x");

    test_group("test_poynting_flux_plane_wave");
    var sm: f64[10];
    at3(&sm, 0.0, 100.0, 0.0);
    sm[3] = 0.0;
    sm[4] = 0.0;
    sm[5] = 100.0 / BJ_SPEED_OF_LIGHT;
    sm[6] = 1.0;
    sm[7] = 0.0;
    sm[8] = 0.0;
    sm[9] = 0.01;
    var pf1: f64 = bj_poynting_flux_surface(&sm, 1);
    assert(pf1 > 0.0, "energy flows out through +x");

    test_group("test_stress_tensor_symmetric");
    var es2 = BjFieldVector_new(100.0, 200.0, 300.0);
    var bs2 = BjFieldVector_new(0.0001, 0.0002, 0.0003);
    bj_maxwell_stress_tensor(es2, bs2, &st);
    var d01: f64 = st[1] - st[3];
    var d02: f64 = st[2] - st[6];
    var d12: f64 = st[5] - st[7];
    assert(f64_abs(d01) < e15 && f64_abs(d02) < e15 && f64_abs(d12) < e15, "T is symmetric");

    test_group("test_stress_tensor_trace");
    bj_maxwell_stress_tensor(ef, bf, &st);
    var tr: f64 = st[0] + st[4] + st[8];
    var trx: f64 = -0.5 * BJ_EPSILON_0 * ef.magnitude_sq();
    assert(f64_abs(tr - trx) / f64_abs(trx) < e6, "tr T = -ε₀E²/2");

    test_group("test_poynting_flux_empty_surface");
    var pf0: f64 = bj_poynting_flux_surface(&sm, 0);
    assert(f64_abs(pf0) < e30, "no samples, no flux");

    test_group("test_greens_function_inverse_r");
    at3(&q, 1.0, 0.0, 0.0);
    var tb30, vb30 = bj_greens_function_static(&q, &o);
    at3(&q, 2.0, 0.0, 0.0);
    var tb31, vb31 = bj_greens_function_static(&q, &o);
    var gi1: f64 = vb30;
    var gi2: f64 = vb31;
    assert(near(gi1 / gi2, 2.0, e6) == 1, "1/R");

    test_group("test_greens_scalar_oscillates");
    at3(&q, 0.01, 0.0, 0.0);
    var tb32, vb32 = bj_greens_function_scalar(&q, &o, 100.0, &cc);
    var im1: f64 = cc.im;
    at3(&q, 0.05, 0.0, 0.0);
    var tb33, vb33 = bj_greens_function_scalar(&q, &o, 100.0, &cc);
    var im2: f64 = cc.im;
    assert(f64_abs(im1) > 0.0 && f64_abs(im2) > 0.0, "a non-zero imaginary part");

    test_group("test_image_charge_dielectric_wrong_halfspace");
    at3(&q, 0.0, 0.0, -1.0);
    var tb34, vb34 = bj_image_charge_dielectric(q6, &q, 1.0, 4.0, &ip);
    assert(is_err_result(tb34) == 1, "z < 0");

    test_group("test_image_charge_dielectric_equal_media");
    at3(&q, 0.0, 0.0, 1.0);
    var tb35, vb35 = bj_image_charge_dielectric(q6, &q, 2.0, 2.0, &ip);
    var qe: f64 = vb35;
    assert(f64_abs(qe) < e20, "no image between equal media");

    test_group("test_image_charge_sphere_on_surface");
    at3(&q, 0.0, 0.0, 1.0);
    var tb36, vb36 = bj_image_charge_sphere(q6, &q, 1.0, &ip);
    assert(is_err_result(tb36) == 1, "on the surface");

    test_group("test_associated_legendre_p20");
    var lx: f64 = 0.5;
    var ls: f64 = f64_sqrt(1.0 - lx * lx);
    var p20: f64 = _bj_associated_legendre(2, 0, lx, ls);
    var p20x: f64 = (3.0 * lx * lx - 1.0) / 2.0;
    assert(near(p20, p20x, e10) == 1, "P2 = (3x² − 1)/2");

    test_group("test_multipole_moment_empty_charges");
    var tb37, vb37 = bj_multipole_moment(1, 0, &cs, 0);
    var me: f64 = vb37;
    assert(f64_abs(me) < e30, "no charges, no moment");

    test_group("test_quadrupole_potential_linear_quadrupole_far_field");
    var lq: f64 = 0.000000001;
    var ld: f64 = 0.001;
    var lch: f64[12];
    put4(&lch, 0, lq, 0.0, 0.0, ld);
    put4(&lch, 1, lq, 0.0, 0.0, -ld);
    put4(&lch, 2, -2.0 * lq, 0.0, 0.0, 0.0);
    var qd2: f64 = lq * ld * ld;
    for (var k = 0; k < 9; k = k + 1) { qt[k] = 0.0; }
    qt[0] = -2.0 * qd2;
    qt[4] = -2.0 * qd2;
    qt[8] = 4.0 * qd2;
    var lps: f64[12];
    at3(&lps, 0.0, 0.0, 1.0);
    lps[3] = 0.3;
    lps[4] = -0.4;
    lps[5] = 0.5;
    lps[6] = 1.0;
    lps[7] = 0.0;
    lps[8] = 0.0;
    lps[9] = 0.2;
    lps[10] = 0.7;
    lps[11] = -0.9;
    var lbad = 0;
    for (var k = 0; k < 4; k = k + 1) {
        var lp: *f64 = &lps + k * 24;
        var tl, vl = bj_electric_quadrupole_potential(&qt, lp);
        var lv: f64 = vl;
        var lref: f64 = direct_potential(&lch, 3, lp);
        if (!(f64_abs(lv - lref) / f64_abs(lref) < 0.00001)) { lbad = lbad + 1; }
    }
    assert_eq(lbad, 0, "the quadrupole term is the far field of +q, -2q, +q");

    test_group("test_disk_axis_below_disk_antisymmetric");
    var tb38, vb38 = bj_electric_field_disk_axis(q6, 1.0, 0.5);
    var tb39, vb39 = bj_electric_field_disk_axis(q6, 1.0, -0.5);
    var dab: f64 = vb38;
    var dbe: f64 = vb39;
    var dsq: f64 = f64_sqrt(0.5 * 0.5 + 1.0 * 1.0);
    var dx2: f64 = q6 / (2.0 * BJ_EPSILON_0) * (1.0 - 0.5 / dsq);
    assert(f64_abs(dab - dx2) / dx2 < e12 && f64_abs(dbe + dx2) / dx2 < e12, "odd in z");

    test_group("test_disk_axis_far_field_no_cancellation");
    var tb40, vb40 = bj_electric_field_disk_axis(q6, 1.0, 100000000.0);
    var dff: f64 = vb40;
    var dpt: f64 = BJ_COULOMB_K * q6 * _BJ_PI * 1.0 * 1.0 / (100000000.0 * 100000000.0);
    assert(f64_abs(dff - dpt) / dpt < e12, "kσπR²/z², no cancellation");

    test_group("test_disk_axis_on_surface_one_sided_limits");
    var dpl: f64 = q6 / (2.0 * BJ_EPSILON_0);
    var tb41, vb41 = bj_electric_field_disk_axis(q6, 1.0, 0.0);
    var tb42, vb42 = bj_electric_field_disk_axis(q6, 1.0, -0.0);
    var dup: f64 = vb41;
    var ddn: f64 = vb42;
    assert(f64_abs(dup - dpl) / dpl < e15 && f64_abs(ddn + dpl) / dpl < e15, "±σ/(2ε₀) by the sign of zero");

    test_group("test_ring_axis_atomic_scale");
    var aq: f64 = -BJ_ELEMENTARY_CHARGE;
    var ar: f64 = 0.0000000000529;
    var az: f64 = 0.00000000001;
    var tb43, vb43 = bj_electric_field_ring_axis(aq, ar, az);
    var ea: f64 = vb43;
    var ab: f64 = az * az + ar * ar;
    var ap: f64 = _bj_powf(ab, 1.5);
    var eax: f64 = BJ_COULOMB_K * aq * az / ap;
    assert(f64_abs(ea - eax) / f64_abs(eax) < e12, "kQz/(z² + R²)^(3/2) at the Bohr radius");

    test_group("test_ring_axis_true_singularity");
    var tb44, vb44 = bj_electric_field_ring_axis(0.000000001, 0.0, 0.0);
    assert(is_err_result(tb44) == 1 && vb44 == BJ_ERR_SINGULARITY, "R = 0 at z = 0 is Singularity");
    var tb45, vb45 = bj_electric_field_ring_axis(0.000000001, nan, 1.0);
    assert(is_err_result(tb45) == 1, "a NaN radius");

    test_group("test_inside_sphere_rejects_outside_domain");
    var tb46, vb46 = bj_electric_field_inside_sphere(q6, 1.0, 2.0);
    var tb47, vb47 = bj_electric_field_inside_sphere(q6, 1.0, -0.5);
    var tb48, vb48 = bj_electric_field_inside_sphere(q6, 1.0, nan);
    var tb49, vb49 = bj_electric_field_inside_sphere(q6, nan, 0.5);
    assert(is_err_result(tb46) == 1 && is_err_result(tb47) == 1 && is_err_result(tb48) == 1
      && is_err_result(tb49) == 1, "outside [0, R], or NaN");
    var tb50, vb50 = bj_electric_field_inside_sphere(q6, 1.0, 1.0);
    var tb51, vb51 = bj_electric_field_charged_sphere(q6, 1.0);
    var at_s: f64 = vb50;
    var outs: f64 = vb51;
    assert(f64_abs(at_s - outs) / outs < e15, "continuous at r = R");

    test_group("test_image_charge_sphere_rejects_bad_radius");
    at3(&q, 0.0, 0.0, 2.0);
    var tb52, vb52 = bj_image_charge_sphere(q6, &q, -1.0, &ip);
    var tb53, vb53 = bj_image_charge_sphere(q6, &q, 0.0, &ip);
    var tb54, vb54 = bj_image_charge_sphere(q6, &q, nan, &ip);
    at3(&b3, nan, 0.0, 2.0);
    var tb55, vb55 = bj_image_charge_sphere(q6, &b3, 1.0, &ip);
    assert(is_err_result(tb52) == 1 && is_err_result(tb53) == 1 && is_err_result(tb54) == 1
      && is_err_result(tb55) == 1, "R ≤ 0, NaN R, NaN position");

    test_group("test_image_charge_sphere_grounded_surface_potential_zero");
    var gq: f64 = 0.000000001;
    var gpos: f64[3];
    at3(&gpos, 0.3, -1.1, 2.0);
    var gr: f64 = 0.7;
    var gi: f64[3];
    var tb56, vb56 = bj_image_charge_sphere(gq, &gpos, gr, &gi);
    var gqi: f64 = vb56;
    var pair: f64[8];
    put4(&pair, 0, gq, gpos[0], gpos[1], gpos[2]);
    put4(&pair, 1, gqi, gi[0], gi[1], gi[2]);
    var gps: f64[9];
    at3(&gps, gr, 0.0, 0.0);
    gps[3] = 0.0;
    gps[4] = 0.0;
    gps[5] = -gr;
    gps[6] = 0.4;
    gps[7] = 0.4;
    gps[8] = gr * 0.5;
    var gbad = 0;
    for (var k = 0; k < 3; k = k + 1) {
        var gp: *f64 = &gps + k * 24;
        var gn: f64 = f64_sqrt(gp[0] * gp[0] + gp[1] * gp[1] + gp[2] * gp[2]);
        var gsp: f64[3];
        at3(&gsp, gp[0] * gr / gn, gp[1] * gr / gn, gp[2] * gr / gn);
        var gv: f64 = direct_potential(&pair, 2, &gsp);
        var gscale: f64 = direct_potential(&pair, 1, &gsp);
        if (!(f64_abs(gv) / gscale < e12)) { gbad = gbad + 1; }
    }
    assert_eq(gbad, 0, "the grounded sphere's surface is at zero potential");

    test_group("test_image_charge_dielectric_rejects_invalid");
    var dbad = 0;
    at3(&q, 0.0, 0.0, 0.0);
    var tc1, vc1 = bj_image_charge_dielectric(q6, &q, 1.0, 4.0, &ip);
    if (is_err_result(tc1) == 0) { dbad = dbad + 1; }
    at3(&q, 0.0, 0.0, nan);
    var tc2, vc2 = bj_image_charge_dielectric(q6, &q, 1.0, 4.0, &ip);
    if (is_err_result(tc2) == 0) { dbad = dbad + 1; }
    at3(&q, 0.0, 0.0, 1.0);
    var tc3, vc3 = bj_image_charge_dielectric(q6, &q, 2.0, -1.0, &ip);
    if (is_err_result(tc3) == 0) { dbad = dbad + 1; }
    var tc4, vc4 = bj_image_charge_dielectric(q6, &q, 0.0, 4.0, &ip);
    if (is_err_result(tc4) == 0) { dbad = dbad + 1; }
    var tc5, vc5 = bj_image_charge_dielectric(q6, &q, 1.0, nan, &ip);
    if (is_err_result(tc5) == 0) { dbad = dbad + 1; }
    assert_eq(dbad, 0, "z ≤ 0, NaN z, ε ≤ 0, NaN ε");

    test_group("test_gauss_law_rejects_negative_distance");
    var gbd = 0;
    var tc6, vc6 = bj_electric_field_charged_sphere(q6, -2.0);
    if (is_err_result(tc6) == 0) { gbd = gbd + 1; }
    var tc7, vc7 = bj_electric_field_infinite_line(q6, -1.0);
    if (is_err_result(tc7) == 0) { gbd = gbd + 1; }
    var tc8, vc8 = bj_electric_field_outside_cylinder(q6, -1.0);
    if (is_err_result(tc8) == 0) { gbd = gbd + 1; }
    var tc9, vc9 = bj_electric_field_charged_sphere(q6, nan);
    if (is_err_result(tc9) == 0) { gbd = gbd + 1; }
    var tc10, vc10 = bj_electric_field_infinite_line(q6, nan);
    if (is_err_result(tc10) == 0) { gbd = gbd + 1; }
    var tc11, vc11 = bj_electric_field_inside_cylinder(q6, nan);
    if (is_err_result(tc11) == 0) { gbd = gbd + 1; }
    assert_eq(gbd, 0, "negative or NaN distances are refused");

    test_group("test_multipole_moment_near_pole_precision");
    var nq: f64 = 0.000000002;
    var nx2: f64 = 0.000000001;
    put4(&cs, 0, nq, nx2, 0.0, 1.0);
    var tc12, vc12 = bj_multipole_moment(1, 1, &cs, 1);
    var m11: f64 = vc12;
    var m11x: f64 = -nq * nx2;
    assert(f64_abs(m11 - m11x) / (nq * nx2) < e12, "M11 = -qx near the pole");

    test_group("test_multipole_moment_documented_definition");
    var dq: f64 = 0.0000000015;
    var dxx: f64 = 0.3;
    var dyy: f64 = -0.7;
    var dzz: f64 = 0.4;
    var dr2: f64 = dxx * dxx + dyy * dyy + dzz * dzz;
    put4(&cs, 0, dq, dxx, dyy, dzz);
    var dexp: f64[8];
    dexp[0] = dq * dzz;
    dexp[1] = -dq * dxx;
    dexp[2] = -dq * dyy;
    dexp[3] = dq * (3.0 * dzz * dzz - dr2) / 2.0;
    dexp[4] = -3.0 * dq * dxx * dzz;
    dexp[5] = -3.0 * dq * dyy * dzz;
    dexp[6] = 3.0 * dq * (dxx * dxx - dyy * dyy);
    dexp[7] = 6.0 * dq * dxx * dyy;
    var dls: i64[8];
    var dms: i64[8];
    dls[0] = 1; dms[0] = 0;
    dls[1] = 1; dms[1] = 1;
    dls[2] = 1; dms[2] = 0 - 1;
    dls[3] = 2; dms[3] = 0;
    dls[4] = 2; dms[4] = 1;
    dls[5] = 2; dms[5] = 0 - 1;
    dls[6] = 2; dms[6] = 2;
    dls[7] = 2; dms[7] = 0 - 2;
    var ddbad = 0;
    for (var k = 0; k < 8; k = k + 1) {
        var tm, vm = bj_multipole_moment(dls[k], dms[k], &cs, 1);
        var gotm: f64 = vm;
        var want: f64 = dexp[k];
        if (!(f64_abs(gotm - want) < e12 * dq)) { ddbad = ddbad + 1; }
    }
    assert_eq(ddbad, 0, "M_lm as documented for l ≤ 2");

    test_group("test_spherical_multipole_moment_jackson_low_orders");
    var jq: f64 = 0.0000000025;
    put4(&cs, 0, jq, dxx, dyy, dzz);
    var xr: f64 = dxx;
    var xi: f64 = -dyy;
    var sq0: f64 = xr * xr - xi * xi;
    var sq1: f64 = 2.0 * xr * xi;
    var jre: f64[8];
    var jim: f64[8];
    jre[0] = jq / f64_sqrt(4.0 * _BJ_PI);
    jim[0] = 0.0;
    jre[1] = f64_sqrt(3.0 / (4.0 * _BJ_PI)) * jq * dzz;
    jim[1] = 0.0;
    var k11: f64 = -f64_sqrt(3.0 / (8.0 * _BJ_PI)) * jq;
    jre[2] = k11 * xr;
    jim[2] = k11 * xi;
    var k1m: f64 = f64_sqrt(3.0 / (8.0 * _BJ_PI)) * jq;
    jre[3] = k1m * xr;
    jim[3] = -k1m * xi;
    jre[4] = 0.5 * f64_sqrt(5.0 / (4.0 * _BJ_PI)) * jq * (3.0 * dzz * dzz - dr2);
    jim[4] = 0.0;
    var k21: f64 = -f64_sqrt(15.0 / (8.0 * _BJ_PI)) * jq * dzz;
    jre[5] = k21 * xr;
    jim[5] = k21 * xi;
    var k22: f64 = 0.25 * f64_sqrt(15.0 / (2.0 * _BJ_PI)) * jq;
    jre[6] = k22 * sq0;
    jim[6] = -k22 * sq1;
    jre[7] = k22 * sq0;
    jim[7] = k22 * sq1;
    dls[0] = 0; dms[0] = 0;
    dls[1] = 1; dms[1] = 0;
    dls[2] = 1; dms[2] = 1;
    dls[3] = 1; dms[3] = 0 - 1;
    dls[4] = 2; dms[4] = 0;
    dls[5] = 2; dms[5] = 1;
    dls[6] = 2; dms[6] = 0 - 2;
    dls[7] = 2; dms[7] = 2;
    var jbad = 0;
    var e14: f64 = 0.00000000000001;
    for (var k = 0; k < 8; k = k + 1) {
        var tj, vj = bj_spherical_multipole_moment(dls[k], dms[k], &cs, 1, &cc);
        var cre: f64 = cc.re;
        var cim: f64 = cc.im;
        var wre: f64 = jre[k];
        var wim: f64 = jim[k];
        if (!(f64_abs(cre - wre) < e14 * jq && f64_abs(cim - wim) < e14 * jq)) { jbad = jbad + 1; }
    }
    assert_eq(jbad, 0, "Jackson's eqs 4.4-4.6");

    test_group("test_spherical_multipole_moment_relation_to_real_moment");
    put4(&cs, 0, 0.000000001, 0.2, 0.5, -0.3);
    put4(&cs, 1, -0.000000003, -0.4, 0.1, 0.6);
    put4(&cs, 2, 0.000000002, 0.0, -0.8, 0.1);
    var rn: f64 = f64_sqrt(11.0 / (4.0 * _BJ_PI) * 2.0 / 40320.0);
    var tr1, vr1 = bj_multipole_moment(5, 3, &cs, 3);
    var tr2, vr2 = bj_multipole_moment(5, 0 - 3, &cs, 3);
    var tr3, vr3 = bj_spherical_multipole_moment(5, 3, &cs, 3, &cc);
    var mc: f64 = vr1;
    var ms3: f64 = vr2;
    var rre: f64 = cc.re;
    var rim: f64 = cc.im;
    var rsc: f64 = _bj_max(f64_abs(mc), f64_abs(ms3)) * rn;
    var e13: f64 = 0.0000000000001;
    assert(f64_abs(rre - rn * mc) < e13 * rsc && f64_abs(rim + rn * ms3) < e13 * rsc, "q_lm = N(M_lm − i M_l,−m)");

    test_group("test_spherical_multipole_moment_high_order_no_overflow");
    put4(&cs, 0, 1.0, 1.0, 0.0, 0.0);
    var th1, vh1 = bj_spherical_multipole_moment(200, 200, &cs, 1, &cc);
    var hre: f64 = cc.re;
    var him: f64 = cc.im;
    assert(f64_abs(hre - 1.1279414857494803) < e12 && f64_abs(him) < e15, "q(200, 200) without overflow");
    var hs: f64 = f64_sqrt(1.0 - 0.09);
    put4(&cs, 0, 1.0, hs, 0.0, 0.3);
    var th2, vh2 = bj_spherical_multipole_moment(200, 0, &cs, 1, &cc);
    var hre2: f64 = cc.re;
    assert(f64_abs(hre2 - -0.05513183897158158) < e12, "q(200, 0)");

    test_group("test_spherical_multipole_moment_invalid_and_origin");
    var ti1, vi1 = bj_spherical_multipole_moment(1, 0 - 2, &cs, 0, &cc);
    assert(is_err_result(ti1) == 1, "|m| > l");
    put4(&cs, 0, 4.0, 0.0, 0.0, 0.0);
    var ti2, vi2 = bj_spherical_multipole_moment(0, 0, &cs, 1, &cc);
    var ore: f64 = cc.re;
    var oim: f64 = cc.im;
    assert(f64_abs(ore - 4.0 / f64_sqrt(4.0 * _BJ_PI)) < e15 && oim == 0.0, "q at the origin: Q/√(4π)");
    var ti3, vi3 = bj_spherical_multipole_moment(2, 1, &cs, 1, &cc);
    var o2r: f64 = cc.re;
    var o2i: f64 = cc.im;
    assert(o2r == 0.0 && o2i == 0.0, "no higher moment from the origin");
    var ti4, vi4 = bj_multipole_moment(0, 0, &cs, 1);
    var om: f64 = vi4;
    assert(f64_abs(om - 4.0) < e15, "M00 = Q");

    test_group("moment_order_types");
    # Cyrius-only: Rust's u32 l and i32 m are types; outside them the port refuses by name.
    var tz1, vz1 = bj_multipole_moment(0 - 1, 0, &cs, 0);
    assert(is_err_result(tz1) == 1, "a negative l");
    assert(text_is(bj_last_error_display(), "invalid parameter: l must be a u32 and m an i32, got l=-1, m=0") == 1,
      "the message names the types");
    var tz2, vz2 = bj_multipole_moment(1, 2, &cs, 0);
    assert(text_is(bj_last_error_display(), "invalid parameter: |m| must be ≤ l, got l=1, m=2") == 1, "Rust's text");

    # ── part 3c: trace_field_line, with closures as the field functions (Rust's `Fn([f64; 3]) -> Result`) ──
    var poly = BjPolyline_new();
    var x_hat = |pos, out| {
        var oo: *BjFieldVector = as_fv(out);
        oo.x = 1.0;
        oo.y = 0.0;
        oo.z = 0.0;
        return 0;
    };

    test_group("test_trace_field_line_uniform");
    var tt1, vt1 = bj_trace_field_line(&o, 0.1, 10, x_hat, &poly);
    assert(is_ok(tt1) == 1, "ok");
    assert_eq(poly.count(), 11, "start and 10 steps");
    var p10: *f64 = poly.at(10);
    var p10x: f64 = p10[0];
    var p10y: f64 = p10[1];
    assert(near(p10x, 1.0, e10) == 1 && near(p10y, 0.0, e10) == 1, "a straight line to (1, 0, 0)");

    test_group("test_trace_field_line_from_charge");
    var cq: f64 = 0.000001;
    var from_charge = |pos, out| {
        var q: f64 = cq;
        var at: f64[3];
        at[0] = 0.0;
        at[1] = 0.0;
        at[2] = 0.0;
        var t, v = bj_electric_field_point_charge(q, &at, as_f64p(pos), as_fv(out));
        if (is_err_result(t) == 1) { return v; }
        return 0;
    };
    at3(&q, 0.1, 0.0, 0.0);
    var tt2, vt2 = bj_trace_field_line(&q, 0.01, 5, from_charge, &poly);
    var pf: *f64 = poly.at(0);
    var pl: *f64 = poly.at(poly.count() - 1);
    var fx0: f64 = pf[0];
    var flx: f64 = pl[0];
    assert(is_ok(tt2) == 1 && flx > fx0, "the line runs outward from a positive charge");

    test_group("test_trace_field_line_invalid_step");
    var tt3, vt3 = bj_trace_field_line(&o, -1.0, 10, x_hat, &poly);
    assert(is_err_result(tt3) == 1, "a negative step");

    test_group("test_trace_field_line_huge_max_steps");
    var zero_field = |pos, out| {
        var oo: *BjFieldVector = as_fv(out);
        oo.x = 0.0;
        oo.y = 0.0;
        oo.z = 0.0;
        return 0;
    };
    var tt4, vt4 = bj_trace_field_line(&o, 0.1, 0 - 1, zero_field, &poly);
    assert(is_ok(tt4) == 1 && poly.count() == 1, "usize::MAX steps, a null point at once: no huge reservation");

    test_group("test_trace_field_line_nan_step_rejected");
    var tt5, vt5 = bj_trace_field_line(&o, nan, 10, x_hat, &poly);
    var tt6, vt6 = bj_trace_field_line(&o, inf, 10, x_hat, &poly);
    at3(&q, nan, 0.0, 0.0);
    var tt7, vt7 = bj_trace_field_line(&q, 0.1, 10, x_hat, &poly);
    assert(is_err_result(tt5) == 1 && is_err_result(tt6) == 1 && is_err_result(tt7) == 1,
      "NaN or infinite step, NaN start");

    test_group("test_trace_field_line_stops_at_sink");
    var sink = |pos, out| {
        var pp: *f64 = as_f64p(pos);
        var x: f64 = pp[0];
        if (x >= 0.25) { return _bj_err_singularity(); }
        var oo: *BjFieldVector = as_fv(out);
        oo.x = 1.0;
        oo.y = 0.0;
        oo.z = 0.0;
        return 0;
    };
    var tt8, vt8 = bj_trace_field_line(&o, 0.1, 100, sink, &poly);
    var p3x: *f64 = poly.at(3);
    var x3: f64 = p3x[0];
    assert(is_ok(tt8) == 1 && poly.count() == 4 && near(x3, 0.3, e12) == 1, "x = 0, 0.1, 0.2, 0.3, then the sink");
    var zc = |pos, out| { return _bj_err_zero_charge(); };
    var tt9, vt9 = bj_trace_field_line(&o, 0.1, 10, zc, &poly);
    assert(is_err_result(tt9) == 1 && vt9 == BJ_ERR_ZERO_CHARGE, "another error propagates");

    test_group("test_trace_field_line_tiny_field_still_traced");
    var tiny_y = |pos, out| {
        var oo: *BjFieldVector = as_fv(out);
        oo.x = 0.0;
        oo.y = 0.00000000000000000000000000000000001;
        oo.z = 0.0;
        return 0;
    };
    var tt10, vt10 = bj_trace_field_line(&o, 0.5, 2, tiny_y, &poly);
    var p2t: *f64 = poly.at(2);
    var y2: f64 = p2t[1];
    assert(is_ok(tt10) == 1 && poly.count() == 3 && near(y2, 1.0, e15) == 1, "a 1e-35 field still has a direction");

    test_group("polyline_growth_and_reuse");
    # Cyrius-only: past the first reservation (4,096 points) the buffer grows; a shorter trace reuses it.
    var tg1, vg1 = bj_trace_field_line(&o, 0.001, 5000, x_hat, &poly);
    assert(is_ok(tg1) == 1 && poly.count() == 5001, "5,001 points");
    var plast: *f64 = poly.at(5000);
    var plx: f64 = plast[0];
    assert(near(plx, 5.0, 0.000001) == 1, "5,000 steps of 0.001");
    var tg2, vg2 = bj_trace_field_line(&o, 0.1, 3, x_hat, &poly);
    assert(is_ok(tg2) == 1 && poly.count() == 4, "the buffer is reused, its length reset");

    test_group("trace_errors_and_the_record");
    # Cyrius-only: an error empties out and records Rust's text; a null point leaves an earlier error recorded.
    var nan_x = |pos, out| {
        var oo: *BjFieldVector = as_fv(out);
        var zz: f64 = 0.0;
        oo.x = zz / zz;
        oo.y = 0.0;
        oo.z = 0.0;
        return 0;
    };
    at3(&q, 0.25, 0.0, 0.0);
    var te1, ve1 = bj_trace_field_line(&q, 0.1, 3, nan_x, &poly);
    assert(is_err_result(te1) == 1 && poly.count() == 0, "out is empty after an error");
    assert(text_is(bj_last_error_display(), "invalid parameter: field function returned NaN at [0.25, 0.0, 0.0]") == 1,
      "Rust's Debug of the position");
    var ce = _bj_err_singularity();
    var te2, ve2 = bj_trace_field_line(&o, 0.1, 10, zero_field, &poly);
    assert(is_ok(te2) == 1 && bj_last_error() == BJ_ERR_SINGULARITY, "a null point records nothing");
    BjPolyline_free(&poly);
    assert(poly.count() == 0, "freed");

    test_group("cyrius_round_once (ADR 0002 row 13)");
    # The single-product fields and energies rounded once; the expected bits are Python's exact rounding.
    var ro_r1m: f64 = fb(0x1EB67E9C127B6E74);
    var ro_r160: f64 = fb(0x6126C2D4256FFCC3);
    var ro_r300: f64 = fb(0x7E37E43C8800759C);
    var ro_r300m: f64 = fb(0x01A56E1FC2F8F359);
    var ro_r30m: f64 = fb(0x39B4484BFEEBC2A0);
    var ro_um: f64 = bj_magnetic_energy_density(ro_r1m);
    var ro_umb = 0;
    store64(&ro_umb, ro_um);
    assert_eq(ro_umb, 0x00000000300067F1, "B²/(2μ₀) at B = 1e-160 on the subnormal grid (Rust's B² lost 15 bits)");
    var ro_ts1, ro_vs1 = bj_electric_field_charged_sphere(1.0, ro_r160);
    assert(ok_bits(ro_ts1, ro_vs1, 0x0000108B6C87E83A) == 1, "kQ/r² at r = 1e160: 8.987551792261e-311 (Rust: 0)");
    var ro_ti1, ro_vi1 = bj_electric_field_inside_sphere(ro_r300, ro_r300, ro_r300);
    assert(ok_bits(ro_ti1, ro_vi1, 0x03B66C11DEF566EF) == 1, "kQr/R³ = 8.987551792261171e-291 (Rust: ∞/∞ = NaN)");
    var ro_tc1, ro_vc1 = bj_electric_field_inside_cylinder(ro_r300m, ro_r30m);
    assert(ok_bits(ro_tc1, ro_vc1, 0x0000000000002CA6) == 1, "ρr/(2ε₀) = 5.647e-320 (Rust: ρ·r underflows to 0)");
    var ro_inf: f64 = 1.0 / 0.0;
    var ro_ue: f64 = bj_electric_energy_density(ro_inf);
    assert(ro_ue == ro_inf, "an infinite E keeps Rust's ∞");

    test_group("cyrius_exact_threshold (ADR 0002 row 17)");
    # The Singularity tests on the exact squared distance against 10^-30 (10^-60 for R); the points are golden rows of
    # the knife-edge grid (scripts/oracle/src/grids.rs), the expected outcomes validate.py's exact ones.
    var xq: f64 = fb(0x3EB0C6F7A0B5ED8D);                    # 1e-6
    var xs0: f64[3];
    var xf0: f64[3];
    xs0[0] = 0.0;
    xs0[1] = 0.0;
    xs0[2] = 0.0;
    xf0[0] = fb(0x3CC59E05F1E26744);
    xf0[1] = fb(0x3CCCD2B297D889C3);
    xf0[2] = 0.0;
    var xt1, xv1 = bj_electric_potential_point_charge(xq, &xs0, &xf0);
    assert(is_err_result(xt1) == 1 && xv1 == BJ_ERR_SINGULARITY,
      "r² rounds to the double 1e-30 but is below 10^-30: Singularity (Rust: Ok)");
    var xs1: f64[3];
    xs1[0] = fb(0x0000000000000010);                         # 16·2^-1074: the difference rounds
    xs1[1] = 0.0;
    xs1[2] = 0.0;
    var xt2, xv2 = bj_electric_potential_point_charge(xq, &xs1, &xf0);
    assert(is_err_result(xt2) == 1 && xv2 == BJ_ERR_SINGULARITY, "the exact difference, not the rounded one, decides");
    var xs2: f64[3];
    var xf2: f64[3];
    xs2[0] = fb(0xB963789AE03E7D66);                         # about −3e-32
    xs2[1] = 0.0;
    xs2[2] = 0.0;
    xf2[0] = fb(0x3CC59E05F1E26748);
    xf2[1] = fb(0x3CCCD2B297D889C0);
    xf2[2] = 0.0;
    var xt3, xv3 = bj_electric_potential_point_charge(xq, &xs2, &xf2);
    assert(ok_bits(xt3, xv3, 0x43DF2E8CAF2A89C3) == 1, "r² rounds below 1e-30 but is above 10^-30: Rust's value");
    var xe3: BjFieldVector;
    var xt4, xv4 = bj_electric_field_point_charge(xq, &xs2, &xf2, &xe3);
    assert(is_ok(xt4) == 1, "the point charge's field agrees");
    var xg_f: f64[3];
    var xg_s: f64[3];
    xg_f[0] = fb(0x39A856C1984E1CB1);
    xg_f[1] = fb(0x39B039D665896885);
    xg_f[2] = 0.0;
    xg_s[0] = fb(0xB645EC2A91CECCDB);
    xg_s[1] = 0.0;
    xg_s[2] = 0.0;
    var xt5, xv5 = bj_greens_function_static(&xg_f, &xg_s);
    assert(ok_bits(xt5, xv5, 0x45F0120F1108D0E0) == 1, "R rounds below 1e-30 but is above 10^-30: Rust's 1/(4πR)");
    var xt6, xv6 = bj_electric_potential_point_charge(xq, &xs0, &xs0);
    assert(is_err_result(xt6) == 1 && xv6 == BJ_ERR_SINGULARITY, "r = 0 stays Singularity (outside the band)");
    var xnan: f64 = 0.0 / 0.0;
    xf2[2] = xnan;
    var xt7, xv7 = bj_electric_potential_point_charge(xq, &xs0, &xf2);
    assert(is_ok(xt7) == 1, "a NaN point keeps Rust's test (NaN < 1e-30 is false)");

    test_group("cyrius_vector_edges (ADR 0002 row 18)");
    # The vector chains at a range edge with an unbounded exponent; the expected bits are validate.py's model (exact
    # values rounded to 53 bits, the last operation once).
    var g600: f64 = fb(0x6570000000000000);                    # 2^600
    var g500: f64 = fb(0x5F30000000000000);                    # 2^500
    var ve18_1 = BjFieldVector_new(3.0 * g600, 4.0 * g600, 12.0 * g600);
    var ve18_1m: f64 = ve18_1.magnitude();
    assert(same_bits(ve18_1m, 0x65AA000000000000) == 1, "|2^600·(3, 4, 12)| = 13·2^600 (Rust: ∞)");
    var g537: f64 = fb(0x1E68000000000000);                    # 1.5·2^-537
    var ve18_2 = BjFieldVector_new(g537, g537, g537);
    var ve18_2s: f64 = ve18_2.magnitude_sq();
    assert(same_bits(ve18_2s, 7) == 1, "three squares of 2.25·2^-1074, summed exactly: 7·2^-1074 (Rust: 6)");
    var ve18_3 = BjFieldVector_new(g600, g600, 0.0);
    var ve18_3w = BjFieldVector_new(g500, g500, 0.0);
    var ve18_3c: BjFieldVector = ve18_3.cross(ve18_3w);
    var ve18_3cz: f64 = ve18_3c.z;
    assert(same_bits(ve18_3cz, 0) == 1, "2^1100 − 2^1100 is 0 with an unbounded exponent (Rust: ∞ − ∞ = NaN)");
    var ve18_3d: f64 = ve18_3.dot(ve18_3w);
    assert(ve18_3d == 1.0 / 0.0, "a dot product past DBL_MAX is still ∞");
    var ve18_4 = BjFieldVector_new(fb(0x8000000000000001), 0.0, fb(0x80000000000000BC));
    var ve18_4n: BjFieldVector;
    var ve18_4t, ve18_4v = ve18_4.normalized(&ve18_4n);
    var ve18_4x: f64 = ve18_4n.x;
    var ve18_4z: f64 = ve18_4n.z;
    var ve18_4ok = 0;
    if (same_bits(ve18_4x, 0xBF75C973F8A9C7EE) == 1 && same_bits(ve18_4z, 0xBFEFFFE255395DA6) == 1) { ve18_4ok = 1; }
    assert(is_ok(ve18_4t) == 1 && ve18_4ok == 1,
      "normalized on the subnormal grid: each part over |v|, rounded once (Rust's rescale: an ulp off)");
    var ve18_4s = BjFieldVector_new(-1.0, 0.0, -188.0);                # the same vector × 2^1074, in range
    var ve18_4sn: BjFieldVector;
    var ve18_4st, ve18_4sv = ve18_4s.normalized(&ve18_4sn);
    var ve18_4sx: f64 = ve18_4sn.x;
    assert(same_bits(ve18_4sx, 0xBF75C973F8A9C7EE) == 1,
      "exactly scale-invariant: Rust's in-range bits at 2^1074 times it");
    var ve18_5p: f64[3];
    ve18_5p[0] = 1.0;
    ve18_5p[1] = -2.0;
    ve18_5p[2] = fb(0x7FEFFFFFFFFFFFFF);
    var ve18_5i: f64[3];
    var ve18_5q: f64 = bj_image_charge_plane(1.0, &ve18_5p, fb(0x7FEFFFFFFFFFFFFF), &ve18_5i);
    var ve18_5z: f64 = ve18_5i[2];
    assert(same_bits(ve18_5z, 0x7FEFFFFFFFFFFFFF) == 1,
      "the plane image at z = DBL_MAX: 2·DBL_MAX − DBL_MAX (Rust: ∞)");
    var ve18_6p: f64[3];
    ve18_6p[0] = 0.5;
    ve18_6p[1] = 0.0;
    ve18_6p[2] = 1.0;
    var ve18_6i: f64[3];
    var ve18_e1: f64 = fb(0x7FE1CCF385EBC8A0);               # 1e308
    var ve18_e2: f64 = fb(0x7FEAB36D48E1ACF0);               # 1.5e308
    var ve18_6t, ve18_6v = bj_image_charge_dielectric(1.0, &ve18_6p, ve18_e1, ve18_e2, &ve18_6i);
    assert(ok_bits(ve18_6t, ve18_6v, 0xBFC999999999999A) == 1, "ε₁ + ε₂ past DBL_MAX: q' = −0.2 (Rust: −q·Δε/∞ = −0)");
    if (ve18_5q == 7.0 || ve18_4sv == 7 || ve18_4v == 7) { println("."); }

    test_group("cyrius_point_charge_edges (ADR 0002 row 18)");
    # The point charges' and Green's functions' chains at a range edge with an unbounded exponent; the expected bits
    # are validate.py's model.
    var pe_o: f64[3];
    at3(&pe_o, 0.0, 0.0, 0.0);
    var pe_f: f64[3];
    at3(&pe_f, fb(0x6974E718D7D7625A), 0.0, 0.0);              # (1e200, 0, 0)
    var pe_e: BjFieldVector;
    var pe_t1, pe_v1 = bj_electric_field_point_charge(fb(0x52A147AEAB7057C7), &pe_o, &pe_f, &pe_e);
    var pe_ex: f64 = pe_e.x;
    assert(is_ok(pe_t1) == 1 && same_bits(pe_ex, 0x01A52FC02B6F88EB) == 1,
      "kq/r² = 9.886306971487286e-301 for q = 1.1e90 at r = 1e200 (Rust's kq/r³ underflowed)");
    var pe_g: f64[3];
    at3(&pe_g, fb(0x4415AF1D78B58C40), 0.0, 0.0);              # (1e20, 0, 0)
    var pe_t2, pe_v2 = bj_electric_potential_point_charge(fb(0x7FEFFFFFFFFFFFFF), &pe_o, &pe_g);
    assert(ok_bits(pe_t2, pe_v2, 0x7DD8B46D656712A9) == 1, "k·DBL_MAX/1e20 = 1.6156860156167408e298 (Rust: ∞)");
    var pe_cs: f64[8];
    at3(&pe_cs, fb(0x7E37E43C8800759C), fb(0x3F50624DD2F1A9FC), 0.0);     # 1e300 at (1e-3, 0, 0)
    pe_cs[3] = 0.0;
    pe_cs[4] = fb(0x7E37E43C8800759C);
    pe_cs[5] = fb(0xBF50624DD2F1A9FC);
    pe_cs[6] = 0.0;
    pe_cs[7] = 0.0;
    var pe_s: BjFieldVector;
    var pe_t3, pe_v3 = bj_electric_field_superposition(&pe_cs, 2, &pe_o, &pe_s);
    var pe_sx: f64 = pe_s.x;
    assert(is_ok(pe_t3) == 1 && same_bits(pe_sx, 0) == 1,
      "two fields past DBL_MAX that cancel sum to 0 (Rust: ∞ − ∞ = NaN)");
    var pe_p1: f64[3];
    at3(&pe_p1, fb(0x54B249AD2594C37D), 0.0, 0.0);             # (1e100, 0, 0)
    var pe_q1: BjPointCharge;
    var pe_tq1, pe_vq1 = BjPointCharge_new(fb(0x6974E718D7D7625A), 1.0, &pe_p1, &pe_o, &pe_q1);   # 1e200 C
    var pe_q2: BjPointCharge;
    var pe_tq2, pe_vq2 = BjPointCharge_new(fb(0x6974E718D7D7625A), 1.0, &pe_o, &pe_o, &pe_q2);
    var pe_fc: BjFieldVector;
    var pe_t4, pe_v4 = bj_coulomb_force(pe_q1, pe_q2, &pe_fc);
    var pe_fx: f64 = pe_fc.x;
    assert(is_ok(pe_t4) == 1 && same_bits(pe_fx, 0x6B85DECAE4BF5B0C) == 1,
      "k·q₁q₂/r² = 8.987551792261174e209 for 1e200·1e200 at 1e100 (Rust: k·q₁·q₂ overflowed)");
    var pe_h: f64[3];
    at3(&pe_h, fb(0x7FE1CCF385EBC8A0), 0.0, 0.0);              # (1e308, 0, 0)
    var pe_t5, pe_v5 = bj_greens_function_static(&pe_h, &pe_o);
    assert(ok_bits(pe_t5, pe_v5, 0x0000927D3D36449E) == 1, "1/(4π·1e308) = 7.95774715459477e-310 (Rust: 1/∞ = 0)");
    var pe_k: f64[3];
    at3(&pe_k, fb(0x7E37E43C8800759C), 0.0, 0.0);              # (1e300, 0, 0)
    var pe_gs: BjComplex;
    var pe_t6, pe_v6 = bj_greens_function_scalar(&pe_k, &pe_o, fb(0x7E37E43C8800759C), &pe_gs);
    var pe_gr: f64 = pe_gs.re;
    var pe_gi: f64 = pe_gs.im;
    assert(is_ok(pe_t6) == 1 && same_bits(pe_gr, 0x816B2151537ED1F0) == 1 && same_bits(pe_gi, 0x8137473EBCD84550) == 1,
      "e^{−jkR}/(4πR) with kR = 1e600, its cosine and sine past DBL_MAX (Rust: kR = ∞, NaN)");
    if (pe_v1 == 7 || pe_v3 == 7 || pe_v4 == 7 || pe_v6 == 7) { println("."); }
    assert(is_ok(pe_tq1) == 1 && is_ok(pe_tq2) == 1 && pe_vq1 == 0 && pe_vq2 == 0, "the two charges are valid");

    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
