# wave.tcyr — src/wave.cyr (M2 part 1b): the plane-wave relations, Snell's law and the Fresnel coefficients (the angle
# forms and the trig-free family), the material-based interface, the waveguides and the antennas.
#
# Every group named test_* is rust-old/src/wave.rs's test of that name, ported assertion for assertion (the ledger
# matches them by name): all 63. test_hertzian_radiation_resistance compares against (2π/3)·η₀·10⁻⁴, ADR 0002 row 22's
# value, where Rust's test has 80π²·10⁻⁴. The cyrius_* groups check what the port adds: the recorded errors and their
# Display texts, Ok(None) and the errors leaving out untouched, ADR 0002 rows 22–25 and the Cyrius-only u32 check of a
# waveguide's mode indices. tests/golden/wave.tsv pins every function over its grid against Rust besides.

include "tests/lib.cyr"

# |a − b| < tol.
fn near(a: f64, b: f64, tol: f64): i64 {
    var d: f64 = a - b;
    var ad: f64 = f64_abs(d);
    if (ad < tol) { return 1; }
    return 0;
}

# 1 when the C strings a and b are equal.
fn text_is(a, b): i64 {
    var n = strlen(a);
    if (n != strlen(b)) { return 0; }
    return memeq(a, b, n);
}

# 1 when the Result (t, v) is an error with code `code` and the record's Display text is `want`.
fn err_is(t, v, code, want): i64 {
    if (is_err_result(t) != 1 || v != code) { return 0; }
    return text_is(bj_last_error_display(), want);
}

# 1 when the Result (t, v) is an error with code `code` and the record's Display text is a followed by b (a literal
# can't continue across lines).
fn err_is2(t, v, code, a, b): i64 {
    if (is_err_result(t) != 1 || v != code) { return 0; }
    var d = bj_last_error_display();
    var la = strlen(a);
    var lb = strlen(b);
    if (strlen(d) != la + lb) { return 0; }
    if (memeq(d, a, la) != 1) { return 0; }
    return memeq(d + la, b, lb);
}

# 1 when the Result (t, v) is an error with code `code` whose Display text starts with `prefix`.
fn err_starts(t, v, code, prefix): i64 {
    if (is_err_result(t) != 1 || v != code) { return 0; }
    var d = bj_last_error_display();
    var n = strlen(prefix);
    if (strlen(d) < n) { return 0; }
    return memeq(d, prefix, n);
}

# 1 when (t, v) is Ok(Some).
fn some_is(t, v): i64 {
    if (is_ok(t) == 1 && v == Some) { return 1; }
    return 0;
}

# 1 when (t, v) is Ok(None).
fn none_is(t, v): i64 {
    if (is_ok(t) == 1 && v == None) { return 1; }
    return 0;
}

# 1 when (t, v) is Ok(x) with 0 ≤ x ≤ 1.
fn unit_is(t, v): i64 {
    if (is_ok(t) != 1) { return 0; }
    var x: f64 = v;
    if (x >= 0.0 && x <= 1.0) { return 1; }
    return 0;
}

# The plane-wave, refraction and waveguide tests.
fn rust_tests_a(): i64 {
    var pi: f64 = _BJ_PI;
    var pi4: f64 = pi / 4.0;
    var e6: f64 = 0.000001;
    var e10: f64 = 0.0000000001;
    var e15: f64 = 0.000000000000001;
    var e30: f64 = 0.000000000000000000000000000001;
    var o: f64[1];

    test_group("test_poynting_vector");
    var ey = BjFieldVector_new(0.0, 1000.0, 0.0);
    var bz = BjFieldVector_new(0.0, 0.0, 0.000001);
    var s: BjFieldVector = bj_poynting_vector(ey, bz);
    var sx: f64 = s.x;
    assert(sx > 0.0, "S = E × B/μ₀ along +x");

    test_group("test_plane_wave_intensity");
    var i1: f64 = bj_plane_wave_intensity(1000.0);
    var i1w: f64 = 0.5 * BJ_SPEED_OF_LIGHT * BJ_EPSILON_0 * 1000000.0;
    var i1d: f64 = i1 - i1w;
    var i1r: f64 = f64_abs(i1d) / i1w;
    assert(i1 > 0.0 && i1r < e6, "I = c·ε₀·E₀²/2");

    test_group("test_radiation_pressure");
    var pa: f64 = bj_radiation_pressure_absorbed(1000.0);
    var pr: f64 = bj_radiation_pressure_reflected(1000.0);
    var pa2: f64 = 2.0 * pa;
    assert(near(pr, pa2, e15) == 1, "reflected = 2 × absorbed");

    test_group("test_e_b_relationship");
    var b0: f64 = bj_b_from_e(1000.0);
    var eb: f64 = bj_e_from_b(b0);
    assert(near(eb, 1000.0, e6) == 1, "E₀ = cB₀ round trip");

    test_group("test_plane_wave");
    var pw: f64 = bj_plane_wave_e(100.0, 1.0, 0.0, 1.0, 0.0, 0.0);
    var pwa: f64 = f64_abs(pw);
    assert(pwa < e10, "sin 0 = 0");

    test_group("test_wave_number");
    var tk, vk = bj_wave_number(500000000000000.0, BJ_SPEED_OF_LIGHT);
    var k: f64 = vk;
    var kd: f64 = k - 10470000.0;
    var kr: f64 = f64_abs(kd) / 10470000.0;
    assert(is_ok(tk) == 1 && kr < 0.01, "visible light: k ≈ 1.047e7 rad/m");

    test_group("test_angular_frequency");
    var w60: f64 = bj_angular_frequency(60.0);
    var w60w: f64 = 120.0 * pi;
    assert(near(w60, w60w, e10) == 1, "ω = 2πf");

    test_group("test_wave_number_zero_velocity_fails");
    var tk0, vk0 = bj_wave_number(500000000000000.0, 0.0);
    assert(err_is(tk0, vk0, BJ_ERR_DIVISION_BY_ZERO,
        "division by zero in EM calculation: velocity cannot be zero for wave number") == 1, "v = 0 refused");

    test_group("test_momentum_density");
    var g: BjFieldVector = bj_momentum_density(ey, bz);
    var gx: f64 = g.x;
    var gy: f64 = f64_abs(g.y);
    var gz: f64 = f64_abs(g.z);
    assert(gx > 0.0 && gy < e30 && gz < e30, "g = S/c² along +x");

    test_group("test_radiation_pressure_absorbed_value");
    var pv: f64 = bj_radiation_pressure_absorbed(1000.0);
    var pvw: f64 = 1000.0 / BJ_SPEED_OF_LIGHT;
    assert(near(pv, pvw, e15) == 1, "P = I/c");

    test_group("test_snell_normal_incidence");
    var ts0, vs0 = bj_snell_refraction_angle(1.0, 1.5, 0.0, &o);
    var th0: f64 = f64_abs(o[0]);
    assert(some_is(ts0, vs0) == 1 && th0 < e10, "normal incidence stays normal");

    test_group("test_snell_air_to_glass");
    var ts1, vs1 = bj_snell_refraction_angle(1.0, 1.5, pi4, &o);
    var sin45: f64 = _bj_sin(pi4);
    var sq: f64 = sin45 / 1.5;
    var th1w: f64 = _bj_asin(sq);
    var th1: f64 = o[0];
    assert(some_is(ts1, vs1) == 1 && near(th1, th1w, e10) == 1, "45° in air → asin(sin 45°/1.5)");

    test_group("test_total_internal_reflection");
    var ts2, vs2 = bj_snell_refraction_angle(1.5, 1.0, 1.0, &o);
    assert(none_is(ts2, vs2) == 1, "glass → air at 57°: total internal reflection");

    test_group("test_critical_angle");
    var tc1, vc1 = bj_critical_angle(1.5, 1.0, &o);
    var r23: f64 = 1.0 / 1.5;
    var tcw: f64 = _bj_asin(r23);
    var tcg: f64 = o[0];
    assert(some_is(tc1, vc1) == 1 && near(tcg, tcw, e10) == 1, "θ_c = asin(1/1.5)");

    test_group("test_critical_angle_none_for_dense_medium");
    var tc2, vc2 = bj_critical_angle(1.0, 1.5, &o);
    assert(none_is(tc2, vc2) == 1, "air → glass: no critical angle");

    test_group("test_brewster_angle");
    var tb, vb = bj_brewster_angle(1.0, 1.5);
    var thb: f64 = vb;
    var thbw: f64 = _bj_atan(1.5);
    assert(is_ok(tb) == 1 && near(thb, thbw, e10) == 1, "θ_B = atan 1.5");

    test_group("test_fresnel_normal_incidence");
    var trs, vrs = bj_fresnel_rs(1.0, 0.0, 1.5, 0.0);
    var trp, vrp = bj_fresnel_rp(1.0, 0.0, 1.5, 0.0);
    var rsn: f64 = vrs;
    var rpn: f64 = vrp;
    var expn: f64 = -0.5 / 2.5;
    var nexpn: f64 = -expn;
    assert(is_ok(trs) == 1 && near(rsn, expn, e10) == 1, "r_s = (n₁ − n₂)/(n₁ + n₂)");
    assert(is_ok(trp) == 1 && near(rpn, nexpn, e10) == 1, "r_p has the opposite sign");

    test_group("test_reflectance_normal");
    var tr1, vr1 = bj_reflectance_normal(1.0, 1.5);
    var rn1: f64 = vr1;
    assert(is_ok(tr1) == 1 && near(rn1, 0.04, e10) == 1, "air → glass: R = 0.04");

    test_group("test_transmittance_complement");
    var tt1, vt1 = bj_transmittance_normal(1.0, 1.5);
    var tn1: f64 = vt1;
    var rt1: f64 = rn1 + tn1;
    assert(is_ok(tt1) == 1 && near(rt1, 1.0, e10) == 1, "R + T = 1");

    test_group("test_rectangular_waveguide_te10");
    var ta, va = bj_rectangular_waveguide_cutoff(0.02286, 0.01016, 1, 0, BJ_SPEED_OF_LIGHT);
    var fc10: f64 = va;
    var fcg: f64 = fc10 / 1000000000.0;
    assert(is_ok(ta) == 1 && near(fcg, 6.56, 0.01) == 1, "WR-90 TE₁₀: f_c ≈ 6.56 GHz");

    test_group("test_rectangular_waveguide_cutoff_wavelength");
    var tl, vl = bj_rectangular_waveguide_cutoff_wavelength(0.02286, 0.01016, 1, 0);
    var lc10: f64 = vl;
    var two_a: f64 = 2.0 * 0.02286;
    assert(is_ok(tl) == 1 && near(lc10, two_a, e10) == 1, "TE₁₀: λ_c = 2a");

    test_group("test_guide_wavelength");
    var tg, vg = bj_guide_wavelength(0.03, two_a);
    var lg: f64 = vg;
    assert(is_ok(tg) == 1 && lg > 0.03, "the guide wavelength is longer");

    test_group("test_guide_wavelength_below_cutoff");
    var tgb, vgb = bj_guide_wavelength(0.05, 0.04);
    assert(err_is(tgb, vgb, BJ_ERR_INVALID_PARAMETER,
        "invalid parameter: frequency below cutoff: λ/λ_c = 1.2500 (must be < 1)") == 1, "λ > λ_c refused");

    test_group("test_cylindrical_waveguide_cutoff");
    var tcy, vcy = bj_cylindrical_waveguide_cutoff(0.01, 1.8412, BJ_SPEED_OF_LIGHT);
    var fc11: f64 = vcy;
    var fc11g: f64 = fc11 / 1000000000.0;
    assert(is_ok(tcy) == 1 && near(fc11g, 8.79, 0.1) == 1, "TE₁₁ at a = 10 mm: f_c ≈ 8.79 GHz");

    if (vs0 == 7 || vs1 == 7 || vs2 == 7 || vc1 == 7 || vc2 == 7) { println("."); }
    return 0;
}

# The antenna and trig-free Fresnel tests.
fn rust_tests_b(): i64 {
    var pi: f64 = _BJ_PI;
    var pi4: f64 = pi / 4.0;
    var pi2: f64 = pi / 2.0;
    var e6: f64 = 0.000001;
    var e10: f64 = 0.0000000001;
    var o: f64[1];
    var o2: f64[1];

    test_group("test_hertzian_dipole_pattern_peak");
    var hp: f64 = bj_hertzian_dipole_pattern(pi2);
    assert(near(hp, 1.0, e10) == 1, "peak 1 at θ = π/2");

    test_group("test_hertzian_dipole_pattern_null");
    var hn: f64 = bj_hertzian_dipole_pattern(0.0);
    var hna: f64 = f64_abs(hn);
    assert(hna < e10, "null on the axis");

    test_group("test_half_wave_dipole_pattern_peak");
    var wp: f64 = bj_half_wave_dipole_pattern(pi2);
    assert(near(wp, 1.0, e10) == 1, "peak 1 at θ = π/2");

    test_group("test_half_wave_dipole_pattern_null");
    var wn: f64 = bj_half_wave_dipole_pattern(0.0);
    var wna: f64 = f64_abs(wn);
    assert(wna < e10, "null on the axis");

    test_group("test_hertzian_radiation_resistance");
    var th, vh = bj_hertzian_dipole_radiation_resistance(0.01, 1.0);
    var rh: f64 = vh;
    var eta0: f64 = bj_free_space_impedance();
    var rhw: f64 = 2.0 * pi / 3.0 * eta0 * 0.0001;
    assert(is_ok(th) == 1 && near(rh, rhw, e6) == 1, "dl/λ = 0.01: R = (2π/3)·η₀·10⁻⁴ ≈ 0.0789 Ω (row 22)");

    test_group("test_effective_aperture");
    var dhw: f64 = bj_half_wave_dipole_directivity();
    var tae, vae = bj_effective_aperture(1.0, dhw);
    var ae: f64 = vae;
    assert(is_ok(tae) == 1 && near(ae, 0.1305, 0.001) == 1, "a half-wave dipole at λ = 1 m: A_e ≈ 0.1305 m²");

    test_group("test_friis_inverse_square");
    var tf1, vf1 = bj_friis_transmission(1.0, 1.0, 1.0, 1.0);
    var tf2, vf2 = bj_friis_transmission(1.0, 1.0, 1.0, 2.0);
    var p1: f64 = vf1;
    var p2: f64 = vf2;
    var p12: f64 = p1 / p2;
    assert(is_ok(tf1) == 1 && is_ok(tf2) == 1 && near(p12, 4.0, e6) == 1, "twice the distance, a quarter the power");

    test_group("test_friis_singularity");
    var tfs, vfs = bj_friis_transmission(1.0, 1.0, 1.0, 0.0);
    assert(err_is(tfs, vfs, BJ_ERR_SINGULARITY, "singularity: field evaluation at source point (distance = 0)") == 1,
      "d = 0 refused");

    test_group("test_snell_cos_theta_t_normal");
    var tn, vn = bj_snell_cos_theta_t(1.0, 1.5, 1.0, &o);
    var ctn: f64 = o[0];
    assert(some_is(tn, vn) == 1 && near(ctn, 1.0, e10) == 1, "cos θ_i = 1 → cos θ_t = 1");

    test_group("test_snell_cos_theta_t_45_deg");
    var c45: f64 = _bj_cos(pi4);
    var t45, v45 = bj_snell_cos_theta_t(1.0, 1.5, c45, &o);
    var s45: f64 = _bj_sin(pi4);
    var st: f64 = s45 / 1.5;
    var q45: f64 = 1.0 - st * st;
    var ct45w: f64 = f64_sqrt(q45);
    var ct45: f64 = o[0];
    assert(some_is(t45, v45) == 1 && near(ct45, ct45w, e10) == 1, "45°: √(1 − sin²θ_t) by trig");

    test_group("test_snell_cos_theta_t_tir");
    var ttir, vtir = bj_snell_cos_theta_t(1.5, 1.0, 0.3, &o);
    assert(none_is(ttir, vtir) == 1, "glass → air, steep: total internal reflection");

    test_group("test_fresnel_rs_direct_normal");
    var tds, vds = bj_fresnel_rs_direct(1.0, 1.5, 1.0, &o);
    var rds: f64 = o[0];
    var exs: f64 = -0.5 / 2.5;
    assert(some_is(tds, vds) == 1 && near(rds, exs, e10) == 1, "r_s = (n₁ − n₂)/(n₁ + n₂)");

    test_group("test_fresnel_rp_direct_normal");
    var tdp, vdp = bj_fresnel_rp_direct(1.0, 1.5, 1.0, &o);
    var rdp: f64 = o[0];
    var exp2: f64 = 0.5 / 2.5;
    assert(some_is(tdp, vdp) == 1 && near(rdp, exp2, e10) == 1, "r_p = (n₂ − n₁)/(n₂ + n₁)");

    test_group("test_fresnel_direct_matches_trig");
    var t30: f64 = pi / 6.0;
    var c30: f64 = _bj_cos(t30);
    var tsn, vsn = bj_snell_refraction_angle(1.0, 1.5, t30, &o2);
    var tt30: f64 = o2[0];
    var tq1, vq1 = bj_fresnel_rs(1.0, t30, 1.5, tt30);
    var tq2, vq2 = bj_fresnel_rs_direct(1.0, 1.5, c30, &o);
    var rs_trig: f64 = vq1;
    var rs_dir: f64 = o[0];
    assert(some_is(tsn, vsn) == 1 && is_ok(tq1) == 1 && some_is(tq2, vq2) == 1 && near(rs_trig, rs_dir, e10) == 1,
      "30°: r_s trig = trig-free");
    var tq3, vq3 = bj_fresnel_rp(1.0, t30, 1.5, tt30);
    var tq4, vq4 = bj_fresnel_rp_direct(1.0, 1.5, c30, &o);
    var rp_trig: f64 = vq3;
    var rp_dir: f64 = o[0];
    assert(is_ok(tq3) == 1 && some_is(tq4, vq4) == 1 && near(rp_trig, rp_dir, e10) == 1, "30°: r_p trig = trig-free");

    test_group("test_fresnel_direct_tir");
    var tx1, vx1 = bj_fresnel_rs_direct(1.5, 1.0, 0.3, &o);
    var tx2, vx2 = bj_fresnel_rp_direct(1.5, 1.0, 0.3, &o);
    assert(none_is(tx1, vx1) == 1 && none_is(tx2, vx2) == 1, "TIR: None for both");

    test_group("test_reflectance_s_direct_tir");
    var tx3, vx3 = bj_reflectance_s_direct(1.5, 1.0, 0.3);
    var rx3: f64 = vx3;
    assert(is_ok(tx3) == 1 && near(rx3, 1.0, e10) == 1, "TIR: R_s = 1");

    test_group("test_reflectance_p_direct_tir");
    var tx4, vx4 = bj_reflectance_p_direct(1.5, 1.0, 0.3);
    var rx4: f64 = vx4;
    assert(is_ok(tx4) == 1 && near(rx4, 1.0, e10) == 1, "TIR: R_p = 1");

    test_group("test_reflectance_unpolarized_normal");
    var tu1, vu1 = bj_reflectance_unpolarized(1.0, 1.5, 1.0);
    var tu2, vu2 = bj_reflectance_normal(1.0, 1.5);
    var ru1: f64 = vu1;
    var ru2: f64 = vu2;
    assert(is_ok(tu1) == 1 && is_ok(tu2) == 1 && near(ru1, ru2, e10) == 1, "normal incidence: unpolarized = normal");

    test_group("test_transmittance_unpolarized_complement");
    var tu3, vu3 = bj_reflectance_unpolarized(1.0, 1.5, c45);
    var tu4, vu4 = bj_transmittance_unpolarized(1.0, 1.5, c45);
    var ru3: f64 = vu3;
    var tu4v: f64 = vu4;
    var rt: f64 = ru3 + tu4v;
    assert(is_ok(tu3) == 1 && is_ok(tu4) == 1 && near(rt, 1.0, e10) == 1, "R + T = 1");

    test_group("test_schlick_normal_matches_exact");
    var tsc1, vsc1 = bj_schlick_reflectance(1.0, 1.5, 1.0);
    var rsc1: f64 = vsc1;
    assert(is_ok(tsc1) == 1 && near(rsc1, ru2, e10) == 1, "normal incidence: Schlick is exact");

    test_group("test_schlick_grazing");
    var tsc2, vsc2 = bj_schlick_reflectance(1.0, 1.5, 0.0);
    var rsc2: f64 = vsc2;
    assert(is_ok(tsc2) == 1 && near(rsc2, 1.0, e10) == 1, "grazing: Schlick → 1");

    test_group("test_schlick_approximates_fresnel");
    var tsc3, vsc3 = bj_schlick_reflectance(1.0, 1.5, c45);
    var rsc3: f64 = vsc3;
    assert(is_ok(tsc3) == 1 && near(rsc3, ru3, 0.02) == 1, "45°: within 0.02 of the exact R");

    test_group("test_snell_cos_theta_t_zero_n2");
    var tz, vz = bj_snell_cos_theta_t(1.0, 0.0, 0.5, &o);
    assert(err_is(tz, vz, BJ_ERR_DIVISION_BY_ZERO,
        "division by zero in EM calculation: refractive index n₂ cannot be zero") == 1, "n₂ = 0 refused");

    if (vn == 7 || v45 == 7 || vtir == 7 || vds == 7 || vdp == 7 || vq2 == 7 || vq4 == 7) { println("."); }
    if (vx1 == 7 || vx2 == 7 || vsn == 7) { println("."); }
    return 0;
}

# The material-based interface and the regression tests.
fn rust_tests_c(): i64 {
    var pi: f64 = _BJ_PI;
    var pi4: f64 = pi / 4.0;
    var zero: f64 = 0.0;
    var nan: f64 = zero / zero;
    var inf: f64 = 1.0 / zero;
    var e6: f64 = 0.000001;
    var e10: f64 = 0.0000000001;
    var e12: f64 = 0.000000000001;
    var e14: f64 = 0.00000000000001;
    var e15: f64 = 0.000000000000001;
    var o: f64[1];
    var air: BjMaterial = BjMaterial_vacuum();
    var glass: BjMaterial = BjMaterial_dielectric(2.25);

    test_group("test_reflectance_at_interface_normal");
    var ti1, vi1 = bj_reflectance_at_interface(air, glass, 1.0);
    var tn1, vn1 = bj_reflectance_normal(1.0, 1.5);
    var ri1: f64 = vi1;
    var rn1: f64 = vn1;
    assert(is_ok(ti1) == 1 && is_ok(tn1) == 1 && near(ri1, rn1, e6) == 1, "air → glass at normal incidence");

    test_group("test_reflectance_normal_materials_air_glass");
    var tm1, vm1 = bj_reflectance_normal_materials(air, glass);
    var rm1: f64 = vm1;
    assert(is_ok(tm1) == 1 && near(rm1, 0.04, e6) == 1, "R = 0.04");

    test_group("test_material_reflection_coefficient");
    var tg1, vg1 = bj_material_reflection_coefficient(air, glass);
    var g1: f64 = vg1;
    assert(is_ok(tg1) == 1 && near(g1, -0.2, e6) == 1, "Γ = (1/1.5 − 1)/(1/1.5 + 1) = −0.2");

    test_group("test_material_reflection_coefficient_same_material");
    var m4: BjMaterial = BjMaterial_dielectric(4.0);
    var tg2, vg2 = bj_material_reflection_coefficient(m4, m4);
    var g2: f64 = vg2;
    var g2a: f64 = f64_abs(g2);
    assert(is_ok(tg2) == 1 && g2a < e10, "the same material: Γ = 0");

    test_group("test_schlick_dense_to_rare_uses_cos_theta_t");
    var ts1, vs1 = bj_schlick_reflectance(1.5, 1.0, 0.76);
    var rs1: f64 = vs1;
    assert(is_ok(ts1) == 1 && near(rs1, 0.30233831088147745, 0.02) == 1, "near the critical angle: R ≈ 0.302");
    var ts2, vs2 = bj_schlick_reflectance(1.5, 1.0, 0.9);
    var rs2: f64 = vs2;
    assert(is_ok(ts2) == 1 && near(rs2, 0.04633264795403766, 0.01) == 1, "cos θ_i = 0.9: R ≈ 0.0463");
    var ts3, vs3 = bj_schlick_reflectance(1.5, 1.0, 0.5);
    var rs3: f64 = vs3;
    assert(is_ok(ts3) == 1 && rs3 == 1.0, "under TIR exactly 1");
    var tr0, vr0 = bj_reflectance_normal(1.0, 1.5);
    var r0: f64 = vr0;
    var h5: f64 = _bj_powi(0.5, 5);
    var w0: f64 = 1.0 - r0;
    var exp0: f64 = r0 + w0 * h5;
    var ts4, vs4 = bj_schlick_reflectance(1.0, 1.5, 0.5);
    var rs4: f64 = vs4;
    assert(is_ok(tr0) == 1 && is_ok(ts4) == 1 && near(rs4, exp0, e15) == 1, "rare → dense: R₀ + (1 − R₀)·0.5⁵");

    test_group("test_cos_theta_i_range_checked");
    var tc1, vc1 = bj_reflectance_unpolarized(1.0, 1.5, -1.0);
    var tc2, vc2 = bj_reflectance_unpolarized(1.0, 1.5, 1.5);
    var tc3, vc3 = bj_reflectance_unpolarized(1.0, 1.5, nan);
    var tc4, vc4 = bj_transmittance_unpolarized(1.0, 1.5, -0.5);
    var tc5, vc5 = bj_schlick_reflectance(1.0, 1.5, -0.2);
    var tc6, vc6 = bj_fresnel_rs_direct(1.0, 1.5, 2.0, &o);
    var tc7, vc7 = bj_snell_cos_theta_t(1.0, 1.5, -0.1, &o);
    assert(is_err_result(tc1) == 1 && is_err_result(tc2) == 1 && is_err_result(tc3) == 1, "−1, 1.5, NaN refused");
    assert(is_err_result(tc4) == 1 && is_err_result(tc5) == 1 && is_err_result(tc6) == 1, "−0.5, −0.2, 2 refused");
    assert(is_err_result(tc7) == 1 && vc7 == BJ_ERR_INVALID_PARAMETER, "−0.1 refused");
    var tc8, vc8 = bj_reflectance_unpolarized(1.0, 1.5, 1.0);
    var up: f64 = 1.0 + 0.000000001;
    var tc9, vc9 = bj_reflectance_unpolarized(1.0, 1.5, up);
    var rnor: f64 = vc8;
    var rup: f64 = vc9;
    assert(is_ok(tc8) == 1 && is_ok(tc9) == 1 && rup == rnor, "1 + 1e-9 clamps to 1");
    var tca, vca = bj_reflectance_unpolarized(1.0, 1.5, 0.0);
    var tcb, vcb = bj_reflectance_unpolarized(1.0, 1.5, -0.000000001);
    var rgr: f64 = vca;
    var rdn: f64 = vcb;
    assert(is_ok(tca) == 1 && is_ok(tcb) == 1 && rdn == rgr && near(rgr, 1.0, e15) == 1, "−1e-9 clamps to 0; R → 1");

    test_group("test_invalid_indices_rejected");
    var tv1, vv1 = bj_reflectance_unpolarized(-1.0, 1.5, 0.5);
    var tv2, vv2 = bj_reflectance_unpolarized(1.0, nan, 0.5);
    var tv3, vv3 = bj_snell_cos_theta_t(inf, 1.5, 0.5, &o);
    assert(is_err_result(tv1) == 1 && is_err_result(tv2) == 1 && is_err_result(tv3) == 1, "−1, NaN, ∞ refused");

    test_group("test_reflectance_and_transmittance_in_unit_interval");
    var pn1: f64[5];
    var pn2: f64[5];
    pn1[0] = 1.0;
    pn2[0] = 1.5;
    pn1[1] = 1.5;
    pn2[1] = 1.0;
    pn1[2] = 1.0;
    pn2[2] = 3.5;
    pn1[3] = 2.4;
    pn2[3] = 1.0;
    pn1[4] = 1.0;
    pn2[4] = 1.0;
    var bad = 0;
    for (var p = 0; p < 5; p = p + 1) {
        var a1: f64 = pn1[p];
        var a2: f64 = pn2[p];
        for (var i = 0; i <= 1000; i = i + 1) {
            var c: f64 = f64_from(i) / 1000.0;
            var tq1, vq1 = bj_reflectance_unpolarized(a1, a2, c);
            var tq2, vq2 = bj_transmittance_unpolarized(a1, a2, c);
            var tq3, vq3 = bj_schlick_reflectance(a1, a2, c);
            if (unit_is(tq1, vq1) != 1 || unit_is(tq2, vq2) != 1 || unit_is(tq3, vq3) != 1) { bad = bad + 1; }
        }
    }
    assert(bad == 0, "R, T and Schlick in [0, 1] over five pairs and 1001 cosines");

    test_group("test_index_matched_grazing_is_zero");
    var tg3, vg3 = bj_fresnel_rs_direct(1.0, 1.0, 0.0, &o);
    var rg3: f64 = o[0];
    assert(some_is(tg3, vg3) == 1 && rg3 == 0.0, "r_s = Some(0)");
    var tg4, vg4 = bj_fresnel_rp_direct(1.0, 1.0, 0.0, &o);
    var rg4: f64 = o[0];
    assert(some_is(tg4, vg4) == 1 && rg4 == 0.0, "r_p = Some(0)");
    var tg5, vg5 = bj_reflectance_unpolarized(1.33, 1.33, 0.0);
    var tg6, vg6 = bj_transmittance_unpolarized(1.33, 1.33, 0.0);
    var rg5: f64 = vg5;
    var rg6: f64 = vg6;
    assert(is_ok(tg5) == 1 && rg5 == 0.0 && is_ok(tg6) == 1 && rg6 == 1.0, "R = 0, T = 1");

    test_group("test_reflectance_unpolarized_single_pass_matches_per_polarization");
    var qn1: f64[4];
    var qn2: f64[4];
    qn1[0] = 1.0;
    qn2[0] = 1.5;
    qn1[1] = 1.5;
    qn2[1] = 1.0;
    qn1[2] = 1.0;
    qn2[2] = 2.42;
    qn1[3] = 1.33;
    qn2[3] = 1.0;
    var off = 0;
    for (var q = 0; q < 4; q = q + 1) {
        var b1: f64 = qn1[q];
        var b2: f64 = qn2[q];
        for (var j = 0; j <= 200; j = j + 1) {
            var cj: f64 = f64_from(j) / 200.0;
            var tw1, vw1 = bj_reflectance_unpolarized(b1, b2, cj);
            var tw2, vw2 = bj_reflectance_s_direct(b1, b2, cj);
            var tw3, vw3 = bj_reflectance_p_direct(b1, b2, cj);
            var ru: f64 = vw1;
            var rss: f64 = vw2;
            var rpp: f64 = vw3;
            var half: f64 = 0.5 * (rss + rpp);
            if (is_ok(tw1) != 1 || is_ok(tw2) != 1 || is_ok(tw3) != 1 || ru != half) { off = off + 1; }
        }
    }
    assert(off == 0, "R = (R_s + R_p)/2 exactly, over four pairs and 201 cosines");

    test_group("test_reflectance_at_interface_magnetic_media");
    var matched: BjMaterial = BjMaterial_new(4.0, 4.0, 0.0);
    var tk1, vk1 = bj_reflectance_at_interface(air, matched, 1.0);
    var rk1: f64 = f64_abs(vk1);
    assert(is_ok(tk1) == 1 && rk1 < e15, "n = 4, η = η₀: matched at normal incidence");
    var tk2, vk2 = bj_reflectance_at_interface(air, matched, 0.8);
    var rk2: f64 = vk2;
    assert(is_ok(tk2) == 1 && near(rk2, 0.011127846503534383, e12) == 1, "cos θ_i = 0.8");
    var tk3, vk3 = bj_reflectance_at_interface(air, matched, 0.3);
    var rk3: f64 = vk3;
    assert(is_ok(tk3) == 1 && near(rk3, 0.2787682331150618, e12) == 1, "cos θ_i = 0.3");
    var tk4, vk4 = bj_reflectance_at_interface(matched, air, 0.99);
    var rk4: f64 = vk4;
    assert(is_ok(tk4) == 1 && near(rk4, 0.008200057075464767, e12) == 1, "matched → vacuum, cos θ_i = 0.99");
    var mag: BjMaterial = BjMaterial_new(1.0, 2.25, 0.0);
    var c45: f64 = _bj_cos(pi4);
    var tk5, vk5 = bj_reflectance_at_interface(air, mag, c45);
    var rk5: f64 = vk5;
    assert(is_ok(tk5) == 1 && near(rk5, 0.05023991101223595, e12) == 1, "ε_r = 1, μ_r = 2.25 at 45°");
    var ma: BjMaterial = BjMaterial_new(4.0, 4.0, 0.0);
    var mb: BjMaterial = BjMaterial_new(16.0, 1.0, 0.0);
    var tk6, vk6 = bj_reflectance_at_interface(ma, mb, 0.0);
    var rk6: f64 = vk6;
    assert(is_ok(tk6) == 1 && near(rk6, 0.36, e15) == 1, "the same index, grazing: R = Γ² (no 0/0)");
    var tk7, vk7 = bj_reflectance_normal_materials(air, matched);
    var rk7: f64 = f64_abs(vk7);
    assert(is_ok(tk7) == 1 && rk7 < e15, "the normal-incidence wrapper agrees");

    test_group("test_reflectance_at_interface_dielectric_matches_index_form");
    var far = 0;
    for (var m = 0; m <= 50; m = m + 1) {
        var cm: f64 = f64_from(m) / 50.0;
        var ta1, va1 = bj_reflectance_at_interface(air, glass, cm);
        var tb1, vb1 = bj_reflectance_unpolarized(1.0, 1.5, cm);
        var ta2, va2 = bj_reflectance_at_interface(glass, air, cm);
        var tb2, vb2 = bj_reflectance_unpolarized(1.5, 1.0, cm);
        var x1: f64 = va1;
        var y1: f64 = vb1;
        var x2: f64 = va2;
        var y2: f64 = vb2;
        if (is_ok(ta1) != 1 || is_ok(tb1) != 1 || near(x1, y1, e14) != 1) { far = far + 1; }
        if (is_ok(ta2) != 1 || is_ok(tb2) != 1 || near(x2, y2, e14) != 1) { far = far + 1; }
    }
    assert(far == 0, "η = 1/n for dielectrics: the index form, both ways, to 1e-14");

    test_group("test_material_fresnel_rejects_conductors_and_invalid");
    var cu: BjMaterial = BjMaterial_conductor(59600000.0);
    var tx1, vx1 = bj_reflectance_at_interface(air, cu, 1.0);
    var tx2, vx2 = bj_reflectance_normal_materials(air, cu);
    var tx3, vx3 = bj_material_reflection_coefficient(air, cu);
    assert(is_err_result(tx1) == 1 && is_err_result(tx2) == 1 && is_err_result(tx3) == 1, "a conductor refused");
    var neg: BjMaterial = BjMaterial_dielectric(-2.0);
    var tx4, vx4 = bj_reflectance_at_interface(air, neg, 1.0);
    var tx5, vx5 = bj_reflectance_normal_materials(air, neg);
    var tx6, vx6 = bj_material_reflection_coefficient(air, neg);
    assert(is_err_result(tx4) == 1 && vx4 == BJ_ERR_INVALID_PERMITTIVITY, "ε_r < 0: InvalidPermittivity");
    assert(is_err_result(tx5) == 1 && vx5 == BJ_ERR_INVALID_PERMITTIVITY, "(normal materials)");
    assert(is_err_result(tx6) == 1 && vx6 == BJ_ERR_INVALID_PERMITTIVITY, "(reflection coefficient)");
    var bad_mu: BjMaterial = BjMaterial_new(1.0, -1.0, 0.0);
    var tx7, vx7 = bj_reflectance_at_interface(air, bad_mu, 1.0);
    assert(is_err_result(tx7) == 1 && vx7 == BJ_ERR_INVALID_PERMEABILITY, "μ_r < 0: InvalidPermeability");
    var tx8, vx8 = bj_reflectance_at_interface(air, glass, -0.5);
    assert(is_err_result(tx8) == 1 && vx8 == BJ_ERR_INVALID_PARAMETER, "cos θ_i = −0.5 refused");

    test_group("test_rectangular_waveguide_cutoff_validation");
    var wa: f64 = 0.02286;
    var wb: f64 = 0.01016;
    var negc: f64 = -BJ_SPEED_OF_LIGHT;
    var tw1, vw1 = bj_rectangular_waveguide_cutoff(wa, wb, 0, 0, BJ_SPEED_OF_LIGHT);
    var tw2, vw2 = bj_rectangular_waveguide_cutoff(wa, wb, 1, 0, 0.0);
    var tw3, vw3 = bj_rectangular_waveguide_cutoff(wa, wb, 1, 0, negc);
    var tw4, vw4 = bj_rectangular_waveguide_cutoff(wa, wb, 1, 0, nan);
    var tw5, vw5 = bj_rectangular_waveguide_cutoff(nan, wb, 1, 0, BJ_SPEED_OF_LIGHT);
    var tw6, vw6 = bj_rectangular_waveguide_cutoff_wavelength(wa, nan, 1, 0);
    assert(is_err_result(tw1) == 1 && is_err_result(tw2) == 1 && is_err_result(tw3) == 1, "m = n = 0, v ≤ 0 refused");
    assert(is_err_result(tw4) == 1 && is_err_result(tw5) == 1 && is_err_result(tw6) == 1, "NaN v, a, b refused");
    var tw7, vw7 = bj_rectangular_waveguide_cutoff(wa, wb, 1, 0, BJ_SPEED_OF_LIGHT);
    var fc: f64 = vw7;
    var fcw: f64 = BJ_SPEED_OF_LIGHT / (2.0 * wa);
    var fcd: f64 = fc - fcw;
    var fcr: f64 = f64_abs(fcd) / fc;
    assert(is_ok(tw7) == 1 && fcr < e15, "TE₁₀: f_c = c/(2a)");

    test_group("test_guide_wavelength_validation");
    var tl1, vl1 = bj_guide_wavelength(nan, 0.05);
    var tl2, vl2 = bj_guide_wavelength(0.03, nan);
    var tl3, vl3 = bj_guide_wavelength(-0.03, 0.05);
    var tl4, vl4 = bj_guide_wavelength(0.03, 0.0);
    assert(is_err_result(tl1) == 1 && is_err_result(tl2) == 1 && is_err_result(tl3) == 1, "NaN λ, NaN λ_c, λ < 0");
    assert(is_err_result(tl4) == 1 && vl4 == BJ_ERR_DIVISION_BY_ZERO, "λ_c = 0");
    var tl5, vl5 = bj_guide_wavelength(0.03, inf);
    var lg5: f64 = vl5;
    assert(is_ok(tl5) == 1 && lg5 == 0.03, "a TEM line (λ_c = ∞): λ_g = λ");

    test_group("test_cylindrical_waveguide_tm01_and_validation");
    var ty1, vy1 = bj_cylindrical_waveguide_cutoff(0.01, 2.4048, BJ_SPEED_OF_LIGHT);
    var f01: f64 = vy1;
    var f01w: f64 = 2.4048 * BJ_SPEED_OF_LIGHT / (2.0 * pi * 0.01);
    var f01d: f64 = f01 - f01w;
    var f01r: f64 = f64_abs(f01d) / f01w;
    var f01g: f64 = f01 / 1000000000.0;
    assert(is_ok(ty1) == 1 && f01r < e15 && near(f01g, 11.474, 0.01) == 1, "TM₀₁: f_c = 2.4048c/(2πa) ≈ 11.474 GHz");
    var ty2, vy2 = bj_cylindrical_waveguide_cutoff(nan, 1.8412, BJ_SPEED_OF_LIGHT);
    var ty3, vy3 = bj_cylindrical_waveguide_cutoff(0.01, -1.8412, BJ_SPEED_OF_LIGHT);
    var ty4, vy4 = bj_cylindrical_waveguide_cutoff(0.01, 1.8412, nan);
    assert(is_err_result(ty2) == 1 && is_err_result(ty3) == 1 && is_err_result(ty4) == 1, "NaN a, x < 0, NaN v");

    if (vc1 == 0 || vc2 == 0 || vc3 == 0 || vc4 == 0 || vc5 == 0 || vc6 == 0 || vv1 == 0 || vv2 == 0) { println("."); }
    if (vv3 == 0 || vx1 == 0 || vx2 == 0 || vx3 == 0 || vw1 == 0 || vw2 == 0 || vw3 == 0 || vw4 == 0) { println("."); }
    if (vw5 == 0 || vw6 == 0 || vl1 == 0 || vl2 == 0 || vl3 == 0 || vy2 == 0 || vy3 == 0 || vy4 == 0) { println("."); }
    if (vg3 == 7 || vg4 == 7) { println("."); }
    return 0;
}

# What the port adds: the error texts, out untouched, ADR 0002 rows 22–25, the u32 mode check.
fn cyrius_tests(): i64 {
    var zero: f64 = 0.0;
    var nan: f64 = zero / zero;
    var pi: f64 = _BJ_PI;
    var o: f64[1];

    test_group("cyrius_wave_errors");
    var te1, ve1 = bj_snell_cos_theta_t(-1.0, 1.5, 0.5, &o);
    assert(err_is(te1, ve1, BJ_ERR_INVALID_PARAMETER,
        "invalid parameter: refractive indices must be positive and finite, got n₁=-1, n₂=1.5") == 1, "the index text");
    var te2, ve2 = bj_schlick_reflectance(1.0, 1.5, 2.0);
    assert(err_is2(te2, ve2, BJ_ERR_INVALID_PARAMETER, "invalid parameter: cos θ_i must lie in [0, 1] ",
        "(measured against the incident-side normal), got 2") == 1, "the cosine text");
    var te3, ve3 = bj_rectangular_waveguide_cutoff(0.0, 1.0, 1, 0, 1.0);
    var w3 = "invalid parameter: waveguide dimensions must be positive and finite, got a=0, b=1";
    assert(err_is(te3, ve3, BJ_ERR_INVALID_PARAMETER, w3) == 1, "the dimension text");
    var te4, ve4 = bj_rectangular_waveguide_cutoff_wavelength(1.0, 1.0, 0, 0);
    assert(err_is(te4, ve4, BJ_ERR_INVALID_PARAMETER,
        "invalid parameter: both m and n cannot be zero (no TE₀₀/TM₀₀ mode)") == 1, "the mode text");
    var big: f64 = _bj_from_bits(0x7FE1CCF385EBC8A0);                    # 1e308
    var te5, ve5 = bj_rectangular_waveguide_cutoff_wavelength(big, big, 1, 0);
    assert(err_starts(te5, ve5, BJ_ERR_INVALID_PARAMETER,
        "invalid parameter: cutoff wavelength not representable for a=1000000000000000000") == 1,
      "10^308 m sides: λ_c = 2·10^308 is past DBL_MAX, refused");
    var te6, ve6 = bj_guide_wavelength(1.03125, 1.0);
    assert(err_is(te6, ve6, BJ_ERR_INVALID_PARAMETER,
        "invalid parameter: frequency below cutoff: λ/λ_c = 1.0312 (must be < 1)") == 1, "{:.4} rounds a tie to even");
    var te7, ve7 = bj_guide_wavelength(0.03, -1.0);
    var w7 = "invalid parameter: cutoff wavelength must be positive, got -1";
    assert(err_is(te7, ve7, BJ_ERR_INVALID_PARAMETER, w7) == 1, "the cutoff text");
    var te8, ve8 = bj_cylindrical_waveguide_cutoff(0.01, 0.0, 1.0);
    var w8 = "invalid parameter: Bessel root must be positive and finite, got 0";
    assert(err_is(te8, ve8, BJ_ERR_INVALID_PARAMETER, w8) == 1, "the root text");
    var te9, ve9 = bj_material_reflection_coefficient(BjMaterial_vacuum(), BjMaterial_new(1.0, nan, 0.0));
    assert(err_is(te9, ve9, BJ_ERR_INVALID_PERMEABILITY, "invalid permeability: NaN (must be > 0)") == 1, "μ_r NaN");

    test_group("cyrius_out_untouched");
    o[0] = 7.0;
    var tu1, vu1 = bj_snell_refraction_angle(1.5, 1.0, 1.0, &o);
    var ou1: f64 = o[0];
    assert(none_is(tu1, vu1) == 1 && ou1 == 7.0, "Ok(None) leaves out as it was");
    var tu2, vu2 = bj_critical_angle(0.0, 1.0, &o);
    var ou2: f64 = o[0];
    assert(is_err_result(tu2) == 1 && vu2 == BJ_ERR_DIVISION_BY_ZERO && ou2 == 7.0, "an error too");
    var tu3, vu3 = bj_fresnel_rp_direct(1.5, 1.0, 0.3, &o);
    var ou3: f64 = o[0];
    assert(none_is(tu3, vu3) == 1 && ou3 == 7.0, "TIR in the direct form");

    test_group("cyrius_adr_rows_22_to_25");
    var d: f64 = bj_half_wave_dipole_directivity();
    var r: f64 = bj_half_wave_dipole_radiation_resistance();
    assert(d == 1.640922376984585 && r == 73.07901028545056, "row 22: 4/Cin(2π) and η₀·Cin(2π)/(4π)");
    var r_d: f64 = r * d;
    var eta0: f64 = bj_free_space_impedance();
    var eta_pi: f64 = eta0 / pi;
    assert(near(r_d, eta_pi, 0.0000000000001) == 1, "R·D = η₀/π: the one Cin(2π) in both");
    var th, vh = bj_hertzian_dipole_radiation_resistance(1.0, 1.0);
    var kh: f64 = vh;
    assert(is_ok(th) == 1 && kh == 789.0221238669274, "row 22: (2π/3)·η₀ for 80π²");
    var ta, va = bj_effective_aperture(nan, 1.5);
    assert(err_is(ta, va, BJ_ERR_INVALID_PARAMETER, "invalid parameter: wavelength must be non-negative, got NaN") == 1,
      "row 23: a NaN wavelength refused");
    var tiny: f64 = 0.0000000000000000000000000000001;
    var tiny2: f64 = 2.0 * tiny;
    var ts, vs = bj_schlick_reflectance(tiny, tiny2, 1.0);
    var rs: f64 = vs;
    var tsw, vsw = bj_schlick_reflectance(1.0, 2.0, 1.0);
    var rsw: f64 = vsw;
    assert(is_ok(ts) == 1 && is_ok(tsw) == 1 && rs == rsw, "row 24: indices below 1e-30 work, scale-free");
    var m1: BjMaterial = BjMaterial_new(2.7, 1.3, 0.0);
    var m2: BjMaterial = BjMaterial_new(11.9, 0.7, 0.0);
    var tg, vg = bj_material_reflection_coefficient(m1, m2);
    var tr, vr = bj_reflectance_normal_materials(m1, m2);
    var gam: f64 = vg;
    var refl: f64 = vr;
    var gam2: f64 = gam * gam;
    assert(is_ok(tg) == 1 && is_ok(tr) == 1 && gam2 == refl, "row 25: Γ² is R bit for bit");
    var mu1: f64 = _bj_from_bits(0x31F0000000000000);                    # 2^-224: η₁ = 2^-112
    var mu2: f64 = _bj_from_bits(0x3230000000000000);                    # 2^-220: η₂ = 2^-110
    var tg3, vg3 = bj_material_reflection_coefficient(BjMaterial_new(1.0, mu1, 0.0), BjMaterial_new(1.0, mu2, 0.0));
    var gam3: f64 = vg3;
    assert(is_ok(tg3) == 1 && gam3 == 0.6,
      "row 25, 2d-1: η₁ + η₂ = 9.6e-34, the guard gone: Γ = 3/5 (Rust: DivisionByZero)");
    # Row 18's rule, M2 part 2d-2a: the ratio chains with an unbounded exponent at a range edge.
    var dmax: f64 = _bj_from_bits(0x7FEFFFFFFFFFFFFF);
    var dhalf: f64 = dmax * 0.5;
    var trn, vrn = bj_reflectance_normal(dmax, dhalf);
    assert(is_ok(trn) == 1 && _bj_bits(vrn) == 0x3FBC71C71C71C71E,
      "row 18, 2d-2a: R of DBL_MAX and DBL_MAX/2 is 1/9, the sum past DBL_MAX run unbounded (Rust: 0)");
    var tfa, vfa = bj_fresnel_rs(dmax, 0.0, dhalf, 0.0);
    assert(is_ok(tfa) == 1 && _bj_bits(vfa) == 0x3FD5555555555556, "and the angle form's r_s, 1/3 (Rust: 0)");
    var rdx: f64[1];
    var tdx, vdx = bj_fresnel_rs_direct(dmax, dhalf, 1.0, &rdx);
    var rd: f64 = rdx[0];
    assert(is_ok(tdx) == 1 && vdx == Some && _bj_bits(rd) == 0x3FD5555555555556, "and the trig-free r_s (Rust: 0)");
    var tsw2, vsw2 = bj_schlick_reflectance(dmax, dhalf, 0.95);
    assert(is_ok(tsw2) == 1 && _bj_bits(vsw2) == 0x3FBC8F1B63B9CADB, "and Schlick's R₀ (Rust: 0, R 0.0005)");
    var sn1: f64 = _bj_from_bits(0x000012688B70E62B);                     # 1e-310
    var sn2: f64 = _bj_from_bits(0x00001B9CD1295941);                     # 1.5e-310
    var rsb: f64[1];
    var tsb, vsb = bj_fresnel_rs_direct(sn1, sn2, 0.5, &rsb);
    var rsv: f64 = rsb[0];
    assert(is_ok(tsb) == 1 && _bj_bits(rsv) == 0xBFDAE49FBFE2C9BC,
      "subnormal indices: both products below 2^-1022, run unbounded (Rust: 227 ulps off)");
    var tub, vub = bj_reflectance_unpolarized(sn1, sn2, 0.5);
    assert(is_ok(tub) == 1 && _bj_bits(vub) == 0x3FB6D4F0BEB927F7, "and R (Rust: 309 ulps off)");
    # M2 part 2d-2b: the plane waves' and Snell's chains at their range edges.
    var e159: f64 = _bj_from_bits(0x60F2357684599702);                    # 1e159
    var e160: f64 = _bj_from_bits(0x6126C2D4256FFCC3);                    # 1e160
    var gm: BjFieldVector = bj_momentum_density(BjFieldVector_new(e159, 0.0, 0.0), BjFieldVector_new(0.0, e160, 0.0));
    assert(_bj_bits(gm.z) == 0x7FDF859ED6DA6B0E && gm.x == 0.0,
      "row 18, 2d-2b: g = (E × B)ε₀ = 8.85e307 with the cross past DBL_MAX (Rust: ∞, its S overflowed)");
    var e200: f64 = _bj_from_bits(0x6974E718D7D7625A);                    # 1e200
    var pw1: f64 = bj_plane_wave_e(1.0, e200, e200, e200, e200, 0.5);
    assert(_bj_bits(pw1) == 0x3FDEAEE8744B05F0, "kx = ωt past DBL_MAX, cancelling: sin 0.5 (Rust: NaN)");
    var pw2: f64 = bj_plane_wave_e(1.0, e200, e200, 0.0, 0.0, 0.0);
    assert(_bj_bits(pw2) == 0x3FC7DF8FBC85F3D5, "kx = 1e400: its sine by Payne–Hanek, 0.18651 (Rust: NaN)");
    var e300: f64 = _bj_from_bits(0x7E37E43C8800759C);                    # 1e300
    var em200: f64 = _bj_from_bits(0x16687E92154EF7AC);                   # 1e-200
    var pw3: f64 = bj_plane_wave_e(e300, em200, em200, 0.0, 0.0, 0.0);
    assert(_bj_bits(pw3) == 0x2B2BFF2EE48E0530, "kx = 1e-400 under E₀ = 1e300: 1e-100 (Rust: 0)");
    var sno: f64[1];
    var em300: f64 = _bj_from_bits(0x01A56E1FC2F8F359);                   # 1e-300
    var em29: f64 = _bj_from_bits(0x39E95A5EFEA6B347);                    # 1e-29
    var em20: f64 = _bj_from_bits(0x3BC79CA10C924223);                    # 1e-20
    var tsn, vsn = bj_snell_refraction_angle(em300, em29, em20, &sno);
    var snv: f64 = sno[0];
    assert(is_ok(tsn) == 1 && vsn == Some && _bj_bits(snv) == 0x0383F559E7BEE6C1,
      "n₁ sin θ_i = 1e-320 over n₂ = 1e-29: θ_t = 1e-291 (Rust: off in the fifth digit)");
    # M2 part 2d-2c: the material interface's roots and Γ, and the waveguides' root, at their range edges.
    var sub1: f64 = _bj_from_bits(1);
    var sub2: f64 = _bj_from_bits(2);
    var hinf1: BjMaterial = BjMaterial_new(sub1, dmax, 0.0);
    var hinf2: BjMaterial = BjMaterial_new(sub2, dmax, 0.0);
    var tg1, vg1 = bj_material_reflection_coefficient(hinf1, hinf2);
    var g1: f64 = vg1;
    assert(is_ok(tg1) == 1 && _bj_bits(g1) == 0xBFC5F619980C4336,
      "row 18, 2d-2c: Γ = −0.1716 between η's past DBL_MAX, on 53-bit roots (Rust: NaN, ∞ − ∞)");
    var hs1: BjMaterial = BjMaterial_new(dmax, sub1, 0.0);
    var hs2: BjMaterial = BjMaterial_new(dmax * 0.5, sub1, 0.0);
    var tg2, vg2 = bj_material_reflection_coefficient(hs1, hs2);
    var g2: f64 = vg2;
    assert(is_ok(tg2) == 1 && _bj_bits(g2) == 0x3FC5F619980C4339,
      "and Γ = 0.1716 between subnormal η's (Rust: refused)");
    var e15: f64 = _bj_from_bits(0x7FD8000000000000);                    # 1.5·2^1022
    var m15: f64 = _bj_from_bits(0x0017FFFFFFFFFFFF);                    # (1.5 − 2^-52)·2^-1022
    var he1: BjMaterial = BjMaterial_new(e15, m15, 0.0);
    var e1022: f64 = _bj_from_bits(0x7FD0000000000000);
    var m1022: f64 = _bj_from_bits(0x0010000000000000);
    var he2: BjMaterial = BjMaterial_new(e1022, m1022, 0.0);
    var tg3, vg3 = bj_material_reflection_coefficient(he1, he2);
    var g3: f64 = vg3;
    assert(is_ok(tg3) == 1 && _bj_bits(g3) == 0x3C90000000000000,
      "η of 2^-1022 rounded up from a root 2^-1075 below it: Γ = 2^-54, not 0 (Rust: refused)");
    var vac: BjMaterial = BjMaterial_new(1.0, 1.0, 0.0);
    var ti1, vi1 = bj_reflectance_at_interface(hinf1, vac, 0.7);
    var ri1: f64 = vi1;
    assert(is_ok(ti1) == 1 && ri1 == 1.0, "R = 1 from an η past DBL_MAX into vacuum at cos θ_i = 0.7 (Rust: NaN)");
    var hn1: BjMaterial = BjMaterial_new(sub1, sub1, 0.0);
    var hn2: BjMaterial = BjMaterial_new(sub1, sub2, 0.0);
    var ti2, vi2 = bj_reflectance_at_interface(hn1, hn2, 0.5);
    var ri2: f64 = vi2;
    assert(is_ok(ti2) == 1 && _bj_bits(ri2) == 0x3FB3128D3DF41D60,
      "subnormal n's 2^-1074 and 2^-1073.5 (one double): R = 0.0745 on 53-bit n's, not Γ² = 0.0294 (Rust: refused)");
    var ek: f64 = _bj_from_bits(0x000FFFFFFD000000);                     # (1 − 1.5·2^-27)·2^-1022
    var mk: f64 = _bj_from_bits(0x0010000003000000);                     # (1 + 1.5·2^-27)·2^-1022
    var hk: BjMaterial = BjMaterial_new(ek, mk, 0.0);
    var hk2: BjMaterial = BjMaterial_new(m1022, m1022, 0.0);
    var ti3, vi3 = bj_reflectance_at_interface(hk, hk2, 0.0);
    var ri3: f64 = vi3;
    assert(is_ok(ti3) == 1 && ri3 == 1.0,
      "n of 2^-1022 rounded up against 2^-1022: distinct, R = 1 at grazing incidence");
    var p600: f64 = _bj_powi(2.0, 600);
    var tw1, vw1 = bj_rectangular_waveguide_cutoff_wavelength(p600, p600, 1, 0);
    var w1: f64 = vw1;
    assert(is_ok(tw1) == 1 && _bj_bits(w1) == 0x6580000000000000,
      "2^600 m sides: λ_c = 2^601, (1/a)² = 2^-1200 run unbounded (Rust: refused, its square underflowed)");
    var e8: f64 = _bj_from_bits(0x7FDC7B1F3CAC7433);                     # 8e307
    var tw2, vw2 = bj_rectangular_waveguide_cutoff_wavelength(e8, e8, 1, 0);
    var w2: f64 = vw2;
    assert(is_ok(tw2) == 1 && _bj_bits(w2) == 0x7FEC7B1F3CAC7432, "8e307 m sides: λ_c = 1.6e308, representable");
    var wa: f64 = _bj_from_bits(0x3F97689CA18BD662);                     # 0.02286
    var em300w: f64 = _bj_from_bits(0x01A56E1FC2F8F359);                 # 1e-300
    var cw: f64 = _bj_from_bits(0x41B1DE784A000000);                     # c
    var tw3, vw3 = bj_rectangular_waveguide_cutoff(wa, em300w, 1, 1, cw);
    var w3c: f64 = vw3;
    assert(is_ok(tw3) == 1 && _bj_bits(w3c) == 0x7FEAAEB2B6A5174D,
      "b = 1e-300: f_c = 1.5e308 with (1/b)² past DBL_MAX run unbounded (Rust: ∞)");

    test_group("cyrius_adr_row_28");
    var u8: f64 = bj_half_wave_dipole_pattern(0.00000001);
    var u12: f64 = bj_half_wave_dipole_pattern(0.000000000001);
    var upi: f64 = bj_half_wave_dipole_pattern(3.1415926535);
    var r8: f64 = (u8 - 0.00000000000000006168502750680849) / 0.00000000000000006168502750680849;
    var r12: f64 = (u12 - 0.0000000000000000000000006168502750680849) / 0.0000000000000000000000006168502750680849;
    var rpi: f64 = (upi - 0.00000000000000000000497355023894436) / 0.00000000000000000000497355023894436;
    var a8: f64 = f64_abs(r8);
    var a12: f64 = f64_abs(r12);
    var api: f64 = f64_abs(rpi);
    assert(a8 < 0.000000000000001 && a12 < 0.000000000000001 && api < 0.000000000000001,
      "near both axes: [cos((π/2)cos θ)/sin θ]² to 1e-15 of 80-digit references (Rust's lost every digit)");

    test_group("cyrius_round_once (ADR 0002 row 13)");
    var r13_max: f64 = _bj_from_bits(0x7FEFFFFFFFFFFFFF);                # DBL_MAX
    var r13_top: BjMaterial = BjMaterial_new(r13_max, r13_max, 0.0);
    var r13_air: BjMaterial = BjMaterial_vacuum();
    var tr13, vr13 = bj_reflectance_at_interface(r13_air, r13_top, 1.0);
    var rr13: f64 = vr13;
    assert(is_ok(tr13) == 1 && rr13 == 0.0,
      "ε_r = μ_r = DBL_MAX: n = DBL_MAX and η = 1 rounded once, R = 0 at normal incidence (Rust: n₂ = ∞, an error)");
    # M2 part 2b-2: wave's products and quotients rounded once, against exact references (Fraction).
    var r13_p308: f64 = _bj_from_bits(0x7FE1CCF385EBC8A0);               # 1e308
    var r13_p200: f64 = _bj_from_bits(0x6974E718D7D7625A);               # 1e200
    var r13_p100: f64 = _bj_from_bits(0x54B249AD2594C37D);               # 1e100
    var r13_m200: f64 = _bj_from_bits(0x16687E92154EF7AC);               # 1e-200
    var r13_m100: f64 = _bj_from_bits(0x2B2BFF2EE48E0530);               # 1e-100
    var w13_i: f64 = bj_plane_wave_intensity(1000.0);
    assert(w13_i == 1327.209363996478, "I = c·ε₀·E₀²/2 at 1 kV/m (Rust: …4783)");
    var w13_p: f64 = bj_radiation_pressure_reflected(r13_max);
    var w13_pw: f64 = _bj_from_bits(0x7E3CA726EB25F9DA);                 # 1.1992917679485557e300
    assert(w13_p == w13_pw, "2I/c at I = DBL_MAX (Rust: 2I overflows, ∞)");
    var tk13, vk13 = bj_wave_number(r13_p308, 10.0);
    var k13: f64 = vk13;
    var k13w: f64 = _bj_from_bits(0x7FD65E6F105A304D);                   # 6.283185307179587e307
    assert(is_ok(tk13) == 1 && k13 == k13w, "k = 2πf/v at f = 1e308 (Rust: 2πf overflows, ∞)");
    var tf13, vf13 = bj_cylindrical_waveguide_cutoff(r13_p100, r13_p200, r13_p200);
    var f13: f64 = vf13;
    var f13w: f64 = _bj_from_bits(0x7E0E6B6F220DD8BD);                   # 1.5915494309189533e299
    assert(is_ok(tf13) == 1 && f13 == f13w, "x·v/(2πa) with x·v = 1e400 (Rust: ∞)");
    var th13, vh13 = bj_hertzian_dipole_radiation_resistance(0.01, 1.0);
    var h13: f64 = vh13;
    assert(is_ok(th13) == 1 && h13 == 0.07890221238669273, "K·(dl/λ)² rounded once on row 22's K (K·r·r: …275)");
    var ta13, va13 = bj_effective_aperture(r13_p200, r13_m200);
    var a13: f64 = va13;
    var a13w: f64 = _bj_from_bits(0x693A9D3A760747A8);                   # 7.957747154594766e198
    assert(is_ok(ta13) == 1 && a13 == a13w, "λ²D/(4π) with λ² = 1e400 (Rust: ∞)");
    var tr213, vr213 = bj_friis_transmission(r13_p200, r13_p200, r13_m100, 1.0);
    var fr13: f64 = vr213;
    var fr13w: f64 = _bj_from_bits(0x6900F16F967A04EE);                  # 6.332573977646111e197
    assert(is_ok(tr213) == 1 && fr13 == fr13w, "G_t·G_r·(λ/(4πd))² with G_t·G_r = 1e400 (Rust: ∞)");

    # ADR 0002 row 17's rule (M2 part 2c-1): |n₁ + n₂| against 10^-30 exactly.
    test_group("cyrius_exact_thresholds (ADR 0002 row 17)");
    var ka17: f64 = _bj_from_bits(0x39A4484BFEEBC29A);
    var kb17: f64 = _bj_from_bits(0x39A4484BFEEBC2A5);
    var tn17, vn17 = bj_reflectance_normal(ka17, kb17);
    assert(is_err_result(tn17) == 1 && vn17 == BJ_ERR_DIVISION_BY_ZERO,
      "n₁ + n₂ below 10^-30 exactly, its rounding 1e-30: refused (Rust: accepted)");
    # The trig-free family's total internal reflection (M2 part 2c-3): n₁²(1 − c²) > n₂² exactly, and cos θ_t =
    # √(n₂² − n₁²(1 − c²))/n₂ rounded once. The inputs are tests/golden/wave.adr.tsv's rows, or exact by construction.
    var oz: f64[1];
    var tz1, vz1 = bj_snell_cos_theta_t(1.0, 1.0, 0.3, &oz);
    var zq1: f64 = oz[0];
    assert(is_ok(tz1) == 1 && vz1 == Some && zq1 == 0.3,
      "n₁ = n₂: cos θ_t = cos θ_i exactly (Rust: 0.29999999999999993)");
    var zden: f64 = _bj_from_bits(1);
    var tz2, vz2 = bj_snell_cos_theta_t(1.0, 1.0, zden, &oz);
    var zq2: f64 = oz[0];
    assert(is_ok(tz2) == 1 && vz2 == Some && zq2 == zden, "n₁ = n₂ at cos θ_i = 2^-1074: the same (Rust: 0)");
    var zc1: f64 = _bj_from_bits(0x3FE7D9F4CF754635);
    var tz3, vz3 = bj_snell_cos_theta_t(1.5, 1.0, zc1, &oz);
    assert(none_is(tz3, vz3) == 1, "just past the critical angle: TIR exactly (Rust: cos θ_t = 0, accepted)");
    var tz4, vz4 = bj_reflectance_unpolarized(1.5, 1.0, zc1);
    var zq4: f64 = vz4;
    assert(is_ok(tz4) == 1 && zq4 == 1.0, "and its R = 1");
    var zn1: f64 = _bj_from_bits(0x405ABB5837EB216A);
    var zn2: f64 = _bj_from_bits(0x3FF661000BB539A8);
    var zc2: f64 = _bj_from_bits(0x3FEFFF4C939390C2);
    var tz5, vz5 = bj_snell_cos_theta_t(zn1, zn2, zc2, &oz);
    var zq5: f64 = oz[0];
    var zw5: f64 = _bj_from_bits(0x3E9D103A96AF2C5C);
    assert(is_ok(tz5) == 1 && vz5 == Some && zq5 == zw5,
      "just short of the critical angle: cos θ_t = 4.3307831870389057e-07 (Rust: TIR)");
    var zbig: f64 = _bj_from_bits(0x7E37E43C8800759C);
    var ztiny: f64 = _bj_from_bits(0x01A56E1FC2F8F359);
    var tz6, vz6 = bj_snell_cos_theta_t(zbig, ztiny, 1.0, &oz);
    var zq6: f64 = oz[0];
    assert(is_ok(tz6) == 1 && vz6 == Some && zq6 == 1.0, "normal incidence with n₁/n₂ past DBL_MAX: 1 (Rust: NaN)");
    var tz7, vz7 = bj_reflectance_unpolarized(1.0, 1.5, 0.375);
    var zq7: f64 = vz7;
    var zw7: f64 = _bj_from_bits(0x3FC2E58805FF1D4F);
    assert(is_ok(tz7) == 1 && zq7 == zw7, "R on the correctly rounded cos θ_t (Rust: 2 ulps above)");

    test_group("cyrius_waveguide_modes_u32");
    var tm1, vm1 = bj_rectangular_waveguide_cutoff(1.0, 1.0, 0 - 1, 0, 1.0);
    assert(err_is(tm1, vm1, BJ_ERR_INVALID_PARAMETER, "invalid parameter: m and n must be u32s, got m=-1, n=0") == 1,
      "m = −1 refused (Rust's u32)");
    var tm2, vm2 = bj_rectangular_waveguide_cutoff_wavelength(1.0, 1.0, 0, 4294967296);
    assert(is_err_result(tm2) == 1 && vm2 == BJ_ERR_INVALID_PARAMETER, "n = 2^32 refused");
    var tm3, vm3 = bj_rectangular_waveguide_cutoff_wavelength(1.0, 1.0, 4294967295, 0);
    var lm3: f64 = vm3;
    var lm3w: f64 = 2.0 / 4294967295.0;
    assert(is_ok(tm3) == 1 && lm3 == lm3w, "m = u32::MAX accepted");

    if (vu1 == 7 || vu3 == 7) { println("."); }
    return 0;
}

# Runs wave.rs's tests, then the Cyrius-only checks.
fn main(): i64 {
    alloc_init();
    rust_tests_a();
    rust_tests_b();
    rust_tests_c();
    cyrius_tests();
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
