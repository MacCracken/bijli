# fdtd3d.tcyr — src/fdtd3d.cyr (M6 part 2a): the 3D grid without its CPML.
#
# Every group named test_* is 1.2.0:src/fdtd.rs's test of that name, ported assertion for assertion (the ledger
# matches them by name): the grid's construction, Courant step, index, sources, energy, propagation, run, time, the
# material regions and all six components stepping. The shared tests that drive both grids (`new_rejects_non_finite_dx`,
# `courant_numbers_are_half_the_limit`, `set_material_validates_before_mutating`, `region_bounds`,
# `lossless_path_unchanged_by_material_api`) and the conductor's uniform decay in 3D land here with their 2D halves.
# `desynced_fields_do_not_panic_3d` is n/a (ADR 0002 row 2: nothing can resize the arrays). M6 part 2b adds the CPML's
# `cpml3d_tests` (`cpml3d_desynced_fields_do_not_panic` n/a, as the grid's) and `Fdtd3d::try_enable_cpml`'s doc test.
# The cyrius_* groups pin the error records' text and order, the regions' edges, the six faces' walls, the lossy
# arrays' lazy mapping, the CPML's records and slabs, and BjFdtd3d_free. tests/golden/fdtd_2d3d.tsv pins every
# operation against the reference model besides.

include "tests/lib.cyr"

var DX: f64 = 0.001;
var DX4: f64 = 0.0001;

# |a − b| < tol.
fn near(a: f64, b: f64, tol: f64): i64 {
    var d: f64 = a - b;
    var ad: f64 = f64_abs(d);
    if (ad < tol) { return 1; }
    return 0;
}

# 1 when the C strings a and b are equal.
fn text_is(a, b): i64 {
    var n = strlen(a);
    if (n != strlen(b)) { return 0; }
    return memeq(a, b, n);
}

# 1 when the C string d is a followed by b.
fn text_is2(d, a, b): i64 {
    var n = strlen(a);
    var m = strlen(b);
    if (strlen(d) != n + m || memeq(d, a, n) != 1) { return 0; }
    return memeq(d + n, b, m);
}

# |a − b| ≤ tol (Rust's `close`).
fn within(a: f64, b: f64, tol: f64): i64 {
    var d: f64 = a - b;
    var ad: f64 = f64_abs(d);
    if (ad <= tol) { return 1; }
    return 0;
}

# A word as a *f64 (the typed return keeps the binding typed).
fn f64p(a): *f64 {
    return a;
}

# Element i of the f64 array at address a.
fn at(a, i): f64 {
    var p: *f64 = f64p(a);
    var x: f64 = p[i];
    return x;
}

# Writes v into the n f64 at address a.
fn fill(a, n, v: f64) {
    var p: *f64 = f64p(a);
    for (var i = 0; i < n; i = i + 1) { p[i] = v; }
    return 0;
}

# 1 when some |f[i]| of the n at address a exceeds tol, index skip aside.
fn any_above(a, n, skip, tol: f64): i64 {
    var p: *f64 = f64p(a);
    for (var i = 0; i < n; i = i + 1) {
        var v: f64 = p[i];
        var av: f64 = f64_abs(v);
        if (i != skip && av > tol) { return 1; }
    }
    return 0;
}

# The largest |f[i]| of the n at address a.
fn max_abs(a, n): f64 {
    var p: *f64 = f64p(a);
    var m: f64 = 0.0;
    for (var i = 0; i < n; i = i + 1) {
        var v: f64 = p[i];
        var av: f64 = f64_abs(v);
        if (av > m) { m = av; }
    }
    return m;
}

# 1 when every f[i] of the n at address a is below lim.
fn all_below(a, n, lim: f64): i64 {
    var p: *f64 = f64p(a);
    for (var i = 0; i < n; i = i + 1) {
        var v: f64 = p[i];
        if (!(v < lim)) { return 0; }
    }
    return 1;
}

# 1 when every value of field a on the nodes where `face` holds is 0: face 0 the x faces, 1 the y faces, 2 the z faces.
fn face_zero(sim: *BjFdtd3d, a, face): i64 {
    var p: *f64 = f64p(a);
    for (var z = 0; z < sim.nz; z = z + 1) {
        for (var y = 0; y < sim.ny; y = y + 1) {
            for (var x = 0; x < sim.nx; x = x + 1) {
                var on = 0;
                if (face == 0 && (x == 0 || x == sim.nx - 1)) { on = 1; }
                if (face == 1 && (y == 0 || y == sim.ny - 1)) { on = 1; }
                if (face == 2 && (z == 0 || z == sim.nz - 1)) { on = 1; }
                var v: f64 = p[sim.idx(x, y, z)];
                if (on == 1 && v != 0.0) { return 0; }
            }
        }
    }
    return 1;
}

# cpml3d_tests' constants: the CPML thickness T, the probe distance P, the test grid N = 2(P + 2 + T) + 1 (the
# source P + 2 cells from the interface), the reference grid N_REF (walls 26 cells from the source) and the window.
var CT = 10;
var CP = 4;
var CN = 33;
var CN_REF = 53;
var CSTEPS = 170;
var PI: f64 = 3.141592653589793;

# A word as a *BjCpml.
fn cpmlp(a): *BjCpml {
    return a;
}

# `cfs`: CFS-CPML parameters exercising the κ and α terms (α_max = 2π·ε₀·1 GHz).
fn cfs(thickness, kappa_max: f64): BjCpmlParams {
    var p: BjCpmlParams = BjCpmlParams_new(thickness);
    p.kappa_max = kappa_max;
    var tp: f64 = 2.0 * PI;
    var tpe: f64 = tp * BJ_EPSILON_0;
    p.alpha_max = tpe * 1000000000.0;
    return p;
}

# `record`: E_z at the eight probes (all six faces' directions P cells from the source, an edge and a corner) over
# CSTEPS steps of an n³ grid with a CPML of params (0: the walls), a soft Gaussian E_z source at the centre; a block of
# 8·CSTEPS f64, probe-major, for the caller to fl_free.
fn record(n, params): i64 {
    var sim: BjFdtd3d;
    var t, v = BjFdtd3d_new(n, n, n, DX, &sim);
    if (params != 0) { var tc, vc = sim.try_enable_cpml_with(params); }
    var c = n / 2;
    var o: i64[24];
    for (var z = 0; z < 24; z = z + 1) { o[z] = 0; }
    o[0] = 0 - CP;
    o[3] = CP;
    o[7] = 0 - CP;
    o[10] = CP;
    o[14] = 0 - CP;
    o[17] = CP;
    o[18] = 0 - CP;
    o[19] = CP;
    o[21] = CP;
    o[22] = 0 - CP;
    o[23] = 0 - CP;
    var pr: i64[8];
    for (var j = 0; j < 8; j = j + 1) { pr[j] = sim.idx(c + o[3 * j], c + o[3 * j + 1], c + o[3 * j + 2]); }
    var tau: f64 = 15.0 * sim.dt;
    var t0: f64 = 4.0 * tau;
    var out = fl_alloc(8 * CSTEPS * 8);
    var q: *f64 = f64p(out);
    for (var k = 0; k < CSTEPS; k = k + 1) {
        var tm: f64 = sim.time();
        var g: f64 = bj_gaussian_pulse(tm, t0, tau);
        sim.add_source_ez(c, c, c, g);
        sim.step_once();
        for (var j2 = 0; j2 < 8; j2 = j2 + 1) {
            var fv: f64 = at(sim.ez, pr[j2]);
            q[j2 * CSTEPS + k] = fv;
        }
    }
    BjFdtd3d_free(&sim);
    return out;
}

# `reflection`: the worst over the probes of max|f − f_ref| / max|f_ref|.
fn reflection(test, refr): f64 {
    var a: *f64 = f64p(test);
    var r: *f64 = f64p(refr);
    var worst: f64 = 0.0;
    for (var j = 0; j < 8; j = j + 1) {
        var peak: f64 = 0.0;
        var err: f64 = 0.0;
        for (var k = 0; k < CSTEPS; k = k + 1) {
            var rv: f64 = r[j * CSTEPS + k];
            var arv: f64 = f64_abs(rv);
            if (arv > peak) { peak = arv; }
            var dv: f64 = a[j * CSTEPS + k] - rv;
            var adv: f64 = f64_abs(dv);
            if (adv > err) { err = adv; }
        }
        var q: f64 = err / peak;
        if (q > worst) { worst = q; }
    }
    return worst;
}

# `energy_history`: the peak (sampled every 5 steps) and final total energy of a 25³ grid, with a 6-cell CPML (cpml 1)
# or the walls, driven at its centre by a zero-DC Ricker pulse for 260 steps.
fn energy_history(cpml): (f64, f64) {
    var sim: BjFdtd3d;
    var t, v = BjFdtd3d_new(25, 25, 25, DX, &sim);
    if (cpml == 1) { var tc, vc = sim.try_enable_cpml(6); }
    var tau: f64 = 15.0 * sim.dt;
    var t0: f64 = 4.0 * tau;
    var peak: f64 = 0.0;
    for (var k = 0; k < 260; k = k + 1) {
        var tm: f64 = sim.time();
        var rw: f64 = bj_ricker_wavelet(tm, t0, tau);
        sim.add_source_ez(12, 12, 12, rw);
        sim.step_once();
        if (k % 5 == 0) {
            var e: f64 = sim.total_energy();
            if (e > peak) { peak = e; }
        }
    }
    var end: f64 = sim.total_energy();
    BjFdtd3d_free(&sim);
    return (peak, end);
}

# `cpml3d_disabled_matches_pec`'s run: E_z of an 11³ grid run 40 steps with a 30 GHz source at the centre, after
# enabling and disabling a 2-cell CPML when toggle is 1; an fl_alloc block of 1331 f64 for the caller to free.
fn pec_run(toggle): i64 {
    var sim: BjFdtd3d;
    var t, v = BjFdtd3d_new(11, 11, 11, DX, &sim);
    if (toggle == 1) {
        var tc, vc = sim.try_enable_cpml(2);
        sim.disable_cpml();
    }
    sim.run(40, 5, 5, 5, 30000000000.0, 1.0);
    var out = fl_alloc(1331 * 8);
    memcpy(out, sim.ez, 1331 * 8);
    BjFdtd3d_free(&sim);
    return out;
}

# Rust's Fdtd3d tests, the shared 2D/3D tests, cpml3d_tests, the doc test and the Cyrius-only groups.
fn main() {
    alloc_init();
    var tiny30: f64 = _bj_from_bits(0x39b4484bfeebc2a0);
    var tiny15: f64 = _bj_from_bits(0x3cd203af9ee75616);
    var nan: f64 = 0.0 / 0.0;
    var inf: f64 = 1.0 / 0.0;

    test_group("test_fdtd3d_creation");
    var s1: BjFdtd3d;
    var t1, v1 = BjFdtd3d_new(10, 10, 10, DX, &s1);
    assert(is_ok(t1) == 1 && s1.nx == 10 && s1.ny == 10 && s1.nz == 10, "10 × 10 × 10 nodes");
    assert(s1.map_bytes >= 1000 * 10 * 8 && s1.dt > 0.0, "nx·ny·nz values a field; dt > 0");
    BjFdtd3d_free(&s1);

    test_group("test_fdtd3d_too_small");
    var s2: BjFdtd3d;
    var t2a, v2a = BjFdtd3d_new(2, 10, 10, DX, &s2);
    var t2b, v2b = BjFdtd3d_new(10, 2, 10, DX, &s2);
    var t2c, v2c = BjFdtd3d_new(10, 10, 2, DX, &s2);
    assert(is_err_result(t2a) == 1 && is_err_result(t2b) == 1 && is_err_result(t2c) == 1, "each axis below 3");

    test_group("test_fdtd3d_invalid_dx");
    var t3a, v3a = BjFdtd3d_new(10, 10, 10, 0.0, &s2);
    var t3b, v3b = BjFdtd3d_new(10, 10, 10, -1.0, &s2);
    assert(is_err_result(t3a) == 1 && is_err_result(t3b) == 1, "dx 0 and −1");

    test_group("test_fdtd3d_courant");
    var s4: BjFdtd3d;
    var t4, v4 = BjFdtd3d_new(10, 10, 10, DX, &s4);
    var sq3: f64 = f64_sqrt(3.0);
    var cs: f64 = BJ_SPEED_OF_LIGHT * sq3;
    var lim4: f64 = s4.dx / cs;
    assert(s4.dt <= lim4, "dt ≤ dx/(c√3)");
    BjFdtd3d_free(&s4);

    test_group("test_fdtd3d_idx");
    var s5: BjFdtd3d;
    var t5, v5 = BjFdtd3d_new(5, 6, 7, DX, &s5);
    assert(s5.idx(0, 0, 0) == 0 && s5.idx(1, 0, 0) == 1 && s5.idx(0, 1, 0) == 5 && s5.idx(0, 0, 1) == 30,
      "z·(nx·ny) + y·nx + x");
    BjFdtd3d_free(&s5);

    test_group("test_fdtd3d_source_injection");
    var s6: BjFdtd3d;
    var t6, v6 = BjFdtd3d_new(10, 10, 10, DX, &s6);
    s6.add_source_ez(5, 5, 5, 1.0);
    var e6: f64 = at(s6.ez, s6.idx(5, 5, 5));
    assert(near(e6, 1.0, tiny15) == 1, "E_z = 1 at the source");

    test_group("test_fdtd3d_source_oob");
    s6.add_source_ez(99, 99, 99, 1.0);
    assert(any_above(s6.ez, 1000, s6.idx(5, 5, 5), 0.0) == 0, "a source outside the grid is ignored");
    BjFdtd3d_free(&s6);

    test_group("test_fdtd3d_energy_after_source");
    var s7: BjFdtd3d;
    var t7, v7 = BjFdtd3d_new(10, 10, 10, DX, &s7);
    var en0: f64 = s7.total_energy();
    var ea0: f64 = f64_abs(en0);
    assert(ea0 < tiny30, "no energy in vacuum at rest");
    s7.add_source_ez(5, 5, 5, 1.0);
    var en1: f64 = s7.total_energy();
    assert(en1 > 0.0, "a source adds energy");
    BjFdtd3d_free(&s7);

    test_group("test_fdtd3d_propagation");
    var s8: BjFdtd3d;
    var t8, v8 = BjFdtd3d_new(20, 20, 20, DX4, &s8);
    s8.add_source_ez(10, 10, 10, 1.0);
    for (var k8 = 0; k8 < 10; k8 = k8 + 1) { s8.step_once(); }
    assert(any_above(s8.ez, 8000, s8.idx(10, 10, 10), tiny15) == 1, "E_z spread from the centre");
    BjFdtd3d_free(&s8);

    test_group("test_fdtd3d_run_with_source");
    var s9: BjFdtd3d;
    var t9, v9 = BjFdtd3d_new(15, 15, 15, DX4, &s9);
    s9.run(20, 7, 7, 7, 1000000000.0, 1.0);
    var m9: f64 = max_abs(s9.ez, 15 * 15 * 15);
    assert(m9 > 0.0, "the source drove E_z");
    BjFdtd3d_free(&s9);

    test_group("test_fdtd3d_time");
    var s10: BjFdtd3d;
    var t10, v10 = BjFdtd3d_new(5, 5, 5, DX, &s10);
    var tm0: f64 = s10.time();
    var ta0: f64 = f64_abs(tm0);
    assert(ta0 < tiny30, "time 0 at the start");
    s10.step_once();
    var tm1: f64 = s10.time();
    var d10: f64 = tm1 - s10.dt;
    var da10: f64 = f64_abs(d10);
    assert(da10 < tiny30, "time dt after one step");
    BjFdtd3d_free(&s10);

    test_group("test_fdtd3d_set_permittivity");
    var s11: BjFdtd3d;
    var t11, v11 = BjFdtd3d_new(10, 10, 10, DX, &s11);
    var r11, r11v = s11.set_permittivity(2, 2, 2, 8, 8, 8, 4.0);
    var c11: f64 = at(s11.permittivity, s11.idx(5, 5, 5));
    var o11: f64 = at(s11.permittivity, s11.idx(0, 0, 0));
    assert(is_ok(r11) == 1 && near(c11, 4.0, tiny15) == 1 && near(o11, 1.0, tiny15) == 1, "ε_r 4 inside, 1 outside");

    test_group("test_fdtd3d_set_permittivity_invalid");
    var r12, r12v = s11.set_permittivity(0, 0, 0, 10, 10, 10, -1.0);
    assert(is_err_result(r12) == 1, "ε_r −1 refused");
    BjFdtd3d_free(&s11);

    test_group("test_fdtd3d_set_material");
    var s13: BjFdtd3d;
    var t13, v13 = BjFdtd3d_new(10, 10, 10, DX, &s13);
    var glass: BjMaterial = BjMaterial_dielectric(2.25);
    var r13, r13v = s13.set_material(2, 2, 2, 8, 8, 8, &glass);
    var c13: f64 = at(s13.permittivity, s13.idx(5, 5, 5));
    assert(is_ok(r13) == 1 && near(c13, 2.25, tiny15) == 1, "glass's ε_r");
    BjFdtd3d_free(&s13);

    test_group("test_fdtd3d_six_components");
    var s14: BjFdtd3d;
    var t14, v14 = BjFdtd3d_new(15, 15, 15, DX4, &s14);
    s14.add_source_ez(7, 7, 7, 1.0);
    for (var k14 = 0; k14 < 5; k14 = k14 + 1) { s14.step_once(); }
    var tiny20: f64 = 0.00000000000000000001;
    var n14 = 15 * 15 * 15;
    assert(any_above(s14.hx, n14, 0 - 1, tiny20) == 1 && any_above(s14.hy, n14, 0 - 1, tiny20) == 1, "H_x, H_y");
    assert(any_above(s14.ex, n14, 0 - 1, tiny20) == 1 && any_above(s14.ey, n14, 0 - 1, tiny20) == 1, "E_x, E_y");
    BjFdtd3d_free(&s14);

    test_group("new_rejects_non_finite_dx");
    var bad_dx: f64[4];
    bad_dx[0] = nan;
    bad_dx[1] = inf;
    bad_dx[2] = -0.001;
    bad_dx[3] = 0.0;
    var g2: BjFdtd2d;
    var g3: BjFdtd3d;
    for (var k15 = 0; k15 < 4; k15 = k15 + 1) {
        var dx15: f64 = bad_dx[k15];
        var a15, a15v = BjFdtd2d_new(10, 10, dx15, BJ_MODE2D_TM, &g2);
        var b15, b15v = BjFdtd3d_new(5, 5, 5, dx15, &g3);
        assert(is_err_result(a15) == 1 && is_err_result(b15) == 1, "2D and 3D refuse the dx");
    }
    var c15, c15v = BjFdtd2d_new(0 - 1, 3, DX, BJ_MODE2D_TM, &g2);
    var d15, d15v = BjFdtd3d_new(0 - 1, 0 - 1, 3, DX, &g3);
    assert(is_err_result(c15) == 1 && is_err_result(d15) == 1, "usize::MAX grids refused");

    test_group("courant_numbers_are_half_the_limit");
    var t16a, v16a = BjFdtd2d_new(10, 10, DX, BJ_MODE2D_TM, &g2);
    var cd2: f64 = BJ_SPEED_OF_LIGHT * g2.dt;
    var courant2: f64 = cd2 / g2.dx;
    var sq2: f64 = f64_sqrt(2.0);
    var want2: f64 = 0.5 / sq2;
    var tol12: f64 = 0.000000000001;
    assert(near(courant2, want2, tol12) == 1, "2D: 1/(2√2)");
    BjFdtd2d_free(&g2);
    var t16b, v16b = BjFdtd3d_new(5, 5, 5, DX, &g3);
    var cd3: f64 = BJ_SPEED_OF_LIGHT * g3.dt;
    var courant3: f64 = cd3 / g3.dx;
    var want3: f64 = 0.5 / sq3;
    assert(near(courant3, want3, tol12) == 1, "3D: 1/(2√3)");
    BjFdtd3d_free(&g3);

    test_group("set_material_validates_before_mutating");
    var be: f64[5];
    var bm: f64[5];
    var bs: f64[5];
    be[0] = 4.0;
    bm[0] = 0.0;
    bs[0] = 0.0;
    be[1] = 4.0;
    bm[1] = nan;
    bs[1] = 0.0;
    be[2] = nan;
    bm[2] = 1.0;
    bs[2] = 0.0;
    be[3] = 4.0;
    bm[3] = 1.0;
    bs[3] = -1.0;
    be[4] = 4.0;
    bm[4] = 1.0;
    bs[4] = inf;
    var t17, v17 = BjFdtd2d_new(20, 20, DX, BJ_MODE2D_TM, &g2);
    var eps17: f64[400];
    var ce17: f64[400];
    var ch17: f64[400];
    memcpy(&eps17, g2.permittivity, 3200);
    memcpy(&ce17, g2.ce, 3200);
    memcpy(&ch17, g2.ch, 3200);
    for (var k17 = 0; k17 < 5; k17 = k17 + 1) {
        var m17: BjMaterial = BjMaterial_new(be[k17], bm[k17], bs[k17]);
        var r17, r17v = g2.set_material(0, 0, 20, 20, &m17);
        assert(is_err_result(r17) == 1, "a bad material refused (2D)");
    }
    var di17: BjMaterial = BjMaterial_dielectric(2.0);
    var r17b, r17bv = g2.set_material(25, 0, 30, 20, &di17);
    assert(is_err_result(r17b) == 1, "a region outside refused");
    assert(memeq(&eps17, g2.permittivity, 3200) == 1 && memeq(&ce17, g2.ce, 3200) == 1
      && memeq(&ch17, g2.ch, 3200) == 1 && g2.ca == 0, "nothing modified (2D)");
    BjFdtd2d_free(&g2);
    var t17c, v17c = BjFdtd3d_new(6, 6, 6, DX, &g3);
    var eps17b: f64[216];
    var ch17b: f64[216];
    memcpy(&eps17b, g3.permittivity, 1728);
    memcpy(&ch17b, g3.ch, 1728);
    for (var k17b = 0; k17b < 5; k17b = k17b + 1) {
        var m17b: BjMaterial = BjMaterial_new(be[k17b], bm[k17b], bs[k17b]);
        var r17c, r17cv = g3.set_material(0, 0, 0, 6, 6, 6, &m17b);
        assert(is_err_result(r17c) == 1, "a bad material refused (3D)");
    }
    assert(memeq(&eps17b, g3.permittivity, 1728) == 1 && memeq(&ch17b, g3.ch, 1728) == 1, "nothing modified (3D)");
    BjFdtd3d_free(&g3);

    test_group("region_bounds");
    var t18, v18 = BjFdtd2d_new(10, 10, DX, BJ_MODE2D_TM, &g2);
    var r18a, r18av = g2.set_permittivity(10, 0, 12, 5, 2.0);
    var r18b, r18bv = g2.set_permittivity(0, 10, 5, 12, 2.0);
    var r18c, r18cv = g2.set_permittivity(5, 0, 4, 5, 2.0);
    var r18d, r18dv = g2.set_conductivity(0, 0, 10, 10, -1.0);
    assert(is_err_result(r18a) == 1 && is_err_result(r18b) == 1 && is_err_result(r18c) == 1
      && is_err_result(r18d) == 1, "starts outside, inverted, σ < 0");
    var r18e, r18ev = g2.set_permittivity(8, 8, 100, 100, 2.0);
    var e18: f64 = at(g2.permittivity, g2.idx(9, 9));
    assert(is_ok(r18e) == 1 && near(e18, 2.0, tiny15) == 1, "the ends clamped");
    var r18f, r18fv = g2.set_permittivity(3, 3, 3, 3, 5.0);
    assert(is_ok(r18f) == 1 && all_below(g2.permittivity, 100, 3.0) == 1, "an empty region is a no-op");
    BjFdtd2d_free(&g2);
    var t18b, v18b = BjFdtd3d_new(5, 5, 5, DX, &g3);
    var r18g, r18gv = g3.set_permittivity(0, 0, 5, 5, 5, 6, 2.0);
    var r18h, r18hv = g3.set_permeability(0, 0, 0, 5, 5, 5, nan);
    assert(is_err_result(r18g) == 1 && is_err_result(r18h) == 1, "z starts outside; μ_r NaN");
    var r18i, r18iv = g3.set_permeability(1, 1, 1, 9, 9, 9, 3.0);
    var m18: f64 = at(g3.permeability, g3.idx(4, 4, 4));
    var m18o: f64 = at(g3.permeability, g3.idx(0, 0, 0));
    assert(is_ok(r18i) == 1 && near(m18, 3.0, tiny15) == 1 && near(m18o, 1.0, tiny15) == 1, "3D ends clamped");
    BjFdtd3d_free(&g3);

    test_group("conductor_uniform_decay_matches_analytic_3d");
    var s19: BjFdtd3d;
    var t19, v19 = BjFdtd3d_new(21, 21, 21, DX, &s19);
    var se19: f64 = 0.1 * BJ_EPSILON_0;
    var sigma19: f64 = se19 / s19.dt;
    var r19, r19v = s19.set_conductivity(0, 0, 0, 21, 21, 21, sigma19);
    fill(s19.ex, 21 * 21 * 21, 1.0);
    fill(s19.ez, 21 * 21 * 21, 1.0);
    for (var k19 = 0; k19 < 9; k19 = k19 + 1) { s19.step_once(); }
    var c19 = s19.idx(10, 10, 10);
    var ns19: f64 = -sigma19;
    var a19: f64 = ns19 * 9.0;
    var b19: f64 = a19 * s19.dt;
    var q19: f64 = b19 / BJ_EPSILON_0;
    var analytic19: f64 = _bj_exp(q19);
    var tol19: f64 = 0.002 * analytic19;
    var ex19: f64 = at(s19.ex, c19);
    var ez19: f64 = at(s19.ez, c19);
    assert(is_ok(r19) == 1 && near(ex19, analytic19, tol19) == 1 && near(ez19, analytic19, tol19) == 1,
      "E decays as exp(−σt/ε₀)");
    BjFdtd3d_free(&s19);

    test_group("lossless_path_unchanged_by_material_api");
    var t20, v20 = BjFdtd2d_new(10, 10, DX, BJ_MODE2D_TE, &g2);
    var di20: BjMaterial = BjMaterial_dielectric(2.0);
    var r20, r20v = g2.set_material(0, 0, 10, 10, &di20);
    assert(is_ok(r20) == 1 && g2.ca == 0 && g2.conductivity == 0, "2D keeps the lossless update");
    BjFdtd2d_free(&g2);
    var t20b, v20b = BjFdtd3d_new(5, 5, 5, DX, &g3);
    var r20b, r20bv = g3.set_material(0, 0, 0, 5, 5, 5, &di20);
    assert(is_ok(r20b) == 1 && g3.ca == 0 && g3.conductivity == 0, "3D keeps the lossless update");
    BjFdtd3d_free(&g3);

    test_group("cpml3d_reflection");
    var refr = record(CN_REF, 0);
    var wall = record(CN, 0);
    var p21: BjCpmlParams = BjCpmlParams_new(CT);
    var cl21 = record(CN, &p21);
    var q21: BjCpmlParams = cfs(CT, 3.0);
    var cf21 = record(CN, &q21);
    var pec21: f64 = reflection(wall, refr);
    var classic21: f64 = reflection(cl21, refr);
    var cfs21: f64 = reflection(cf21, refr);
    assert(pec21 > 0.3, "the walls reflect everything back into the probes");
    assert(classic21 < 0.001, "CPML(10) reflection under −60 dB");
    assert(cfs21 < 0.001, "CFS-CPML(10, κ = 3) reflection under −60 dB");
    fl_free(refr);
    fl_free(wall);
    fl_free(cl21);
    fl_free(cf21);

    test_group("cpml3d_energy_decays");
    var pw, ew = energy_history(0);
    var pc, ec = energy_history(1);
    var rw22: f64 = ew / pw;
    var rc22: f64 = ec / pc;
    assert(rw22 > 0.03, "the PEC walls trap energy");
    assert(rc22 < 0.000001, "the CPML absorbs it");

    test_group("cpml3d_fields_are_mirror_symmetric");
    var sm: BjFdtd3d;
    var tsm, vsm = BjFdtd3d_new(21, 21, 20, DX, &sm);
    var csm: BjCpmlParams = cfs(5, 3.0);
    var rsm, rsmv = sm.try_enable_cpml_with(&csm);
    var tau23: f64 = 8.0 * sm.dt;
    var t023: f64 = 4.0 * tau23;
    for (var k23 = 0; k23 < 120; k23 = k23 + 1) {
        var tm23: f64 = sm.time();
        var g23: f64 = bj_gaussian_pulse(tm23, t023, tau23);
        sm.add_source_ez(10, 10, 9, g23);
        sm.step_once();
    }
    var nsm = 21 * 21 * 20;
    var mez: f64 = max_abs(sm.ez, nsm);
    var mhx: f64 = max_abs(sm.hx, nsm);
    var tol23: f64 = 0.000000001 * mez;
    var tolh23: f64 = 0.000000001 * mhx;
    assert(tol23 > 0.0 && tolh23 > 0.0, "the source drove E_z and H_x");
    var bad23: i64[6];
    for (var b23 = 0; b23 < 6; b23 = b23 + 1) { bad23[b23] = 0; }
    for (var z23 = 0; z23 < 19; z23 = z23 + 1) {
        for (var y23 = 0; y23 < 21; y23 = y23 + 1) {
            for (var x23 = 0; x23 < 21; x23 = x23 + 1) {
                var ez23: f64 = at(sm.ez, sm.idx(x23, y23, z23));
                var mx: f64 = at(sm.ez, sm.idx(20 - x23, y23, z23));
                var my: f64 = at(sm.ez, sm.idx(x23, 20 - y23, z23));
                var mz: f64 = at(sm.ez, sm.idx(x23, y23, 18 - z23));
                var sw: f64 = at(sm.ez, sm.idx(y23, x23, z23));
                var exv: f64 = at(sm.ex, sm.idx(x23, y23, z23));
                var eyv: f64 = at(sm.ey, sm.idx(y23, x23, z23));
                var hxv: f64 = at(sm.hx, sm.idx(x23, y23, z23));
                var hyv: f64 = at(sm.hy, sm.idx(y23, x23, z23));
                if (within(ez23, mx, tol23) == 0) { bad23[0] = bad23[0] + 1; }
                if (within(ez23, my, tol23) == 0) { bad23[1] = bad23[1] + 1; }
                if (within(ez23, mz, tol23) == 0) { bad23[2] = bad23[2] + 1; }
                if (within(ez23, sw, tol23) == 0) { bad23[3] = bad23[3] + 1; }
                if (within(exv, eyv, tol23) == 0) { bad23[4] = bad23[4] + 1; }
                var hs: f64 = hxv + hyv;
                var ahs: f64 = f64_abs(hs);
                if (ahs > tolh23) { bad23[5] = bad23[5] + 1; }
            }
        }
    }
    assert(bad23[0] == 0 && bad23[1] == 0 && bad23[2] == 0, "E_z even under the x, y and z mirrors");
    assert(bad23[3] == 0, "E_z even under x ↔ y");
    assert(bad23[4] == 0 && bad23[5] == 0, "x ↔ y swaps E_x ↔ E_y and H_x ↔ −H_y");
    BjFdtd3d_free(&sm);

    test_group("cpml3d_stable_long_run_with_materials");
    var lr: BjFdtd3d;
    var tlr, vlr = BjFdtd3d_new(19, 19, 19, DX, &lr);
    var clr: BjCpmlParams = cfs(4, 5.0);
    var rlr, rlrv = lr.try_enable_cpml_with(&clr);
    var mlr: BjMaterial = BjMaterial_new(4.0, 2.0, 0.5);
    var slr, slrv = lr.set_material(0, 6, 6, 9, 13, 13, &mlr);
    lr.run(500, 12, 9, 9, 30000000000.0, 1.0);
    var nlr = 19 * 19 * 19;
    var fin = 1;
    var lrf: i64[6];
    lrf[0] = lr.ex;
    lrf[1] = lr.ey;
    lrf[2] = lr.ez;
    lrf[3] = lr.hx;
    lrf[4] = lr.hy;
    lrf[5] = lr.hz;
    for (var f24 = 0; f24 < 6; f24 = f24 + 1) {
        var fp24: *f64 = f64p(lrf[f24]);
        for (var i24 = 0; i24 < nlr; i24 = i24 + 1) {
            var v24: f64 = fp24[i24];
            if (!(v24 == v24 && v24 < inf && v24 > -inf)) { fin = 0; }
        }
    }
    var e24: f64 = lr.total_energy();
    assert(is_ok(rlr) == 1 && is_ok(slr) == 1 && fin == 1 && e24 > 0.0, "every field finite, energy positive");
    BjFdtd3d_free(&lr);

    test_group("cpml3d_enable_validates_and_disables");
    var ev: BjFdtd3d;
    var tev, vev = BjFdtd3d_new(20, 30, 40, DX, &ev);
    var e25a, e25av = ev.try_enable_cpml(0);
    var e25b, e25bv = ev.try_enable_cpml(9);
    assert(is_err_result(e25a) == 1 && is_err_result(e25b) == 1 && ev.cpml() == 0, "0 and 2·9 + 3 > 20 refused");
    var e25c, e25cv = ev.try_enable_cpml(8);
    var cp25: *BjCpml = cpmlp(ev.cpml());
    var eta0: f64 = BJ_MU_0 * BJ_SPEED_OF_LIGHT;
    var sopt: f64 = 0.8 * 4.0 / (eta0 * DX);
    var sm25: f64 = cp25.sigma_max();
    var km25: f64 = cp25.kappa_max();
    var tol25: f64 = 0.000000001 * sopt;
    assert(is_ok(e25c) == 1 && cp25.thickness == 8 && near(sm25, sopt, tol25) == 1 && near(km25, 1.0, tiny15) == 1,
      "thickness 8, σ_max = σ_opt, κ_max = 1");
    var e25d, e25dv = ev.try_enable_cpml(100);
    var bad25: BjCpmlParams = BjCpmlParams_new(4);
    bad25.kappa_max = 0.5;
    var e25e, e25ev = ev.try_enable_cpml_with(&bad25);
    bad25.kappa_max = nan;
    var e25f, e25fv = ev.try_enable_cpml_with(&bad25);
    var cp25b: *BjCpml = cpmlp(ev.cpml());
    assert(is_err_result(e25d) == 1 && is_err_result(e25e) == 1 && is_err_result(e25f) == 1 && cp25b.thickness == 8,
      "invalid requests keep the active layer");
    var c25: BjCpmlParams = cfs(5, 7.0);
    var e25g, e25gv = ev.try_enable_cpml_with(&c25);
    var cp25c: *BjCpml = cpmlp(ev.cpml());
    var km25c: f64 = cp25c.kappa_max();
    assert(is_ok(e25g) == 1 && cp25c.thickness == 5 && near(km25c, 7.0, tiny15) == 1, "re-enabling replaces the layer");
    ev.disable_cpml();
    assert(ev.cpml() == 0, "disabled");
    ev.disable_cpml();
    assert(ev.cpml() == 0 && ev.psi == 0, "disabled again, nothing held");
    BjFdtd3d_free(&ev);

    test_group("cpml3d_disabled_matches_pec");
    var pa = pec_run(0);
    var pb = pec_run(1);
    assert(memeq(pa, pb, 1331 * 8) == 1, "disabling the CPML restores the PEC update exactly");
    fl_free(pa);
    fl_free(pb);

    test_group("doc test at line 4000");
    var dt26: BjFdtd3d;
    var t26, v26 = BjFdtd3d_new(32, 32, 32, DX, &dt26);
    var e26, e26v = dt26.try_enable_cpml(8);
    dt26.run(50, 16, 16, 16, 30000000000.0, 1.0);
    var cp26: *BjCpml = cpmlp(dt26.cpml());
    assert(is_ok(t26) == 1 && is_ok(e26) == 1 && cp26.thickness == 8, "Fdtd3d::try_enable_cpml's example");
    BjFdtd3d_free(&dt26);

    test_group("cyrius_fdtd3d_records");
    var e21: BjFdtd3d;
    e21.nx = 77;
    var t21, v21 = BjFdtd3d_new(4, 1, 9, DX, &e21);
    var w21 = "grid resolution too coarse: 1 cells for domain size 0.001";
    assert(v21 == BJ_ERR_INSUFFICIENT_RESOLUTION && text_is(bj_last_error_display(), w21) == 1 && e21.nx == 0,
      "the smallest axis and its domain, before dx; out empty (2.0.1 H12)");
    var t22, v22 = BjFdtd3d_new(3, 3, 3, nan, &e21);
    assert(v22 == BJ_ERR_INVALID_PARAMETER
      && text_is(bj_last_error_display(), "invalid parameter: dx must be finite and positive, got NaN") == 1, "dx");
    var t23, v23 = BjFdtd3d_new(4294967296, 4294967296, 3, DX, &e21);
    var w23 = "invalid parameter: grid [4294967296, 4294967296, 3] is too large";
    assert(v23 == BJ_ERR_INVALID_PARAMETER && text_is(bj_last_error_display(), w23) == 1, "nx·ny·nz past 2^64");
    var t24, v24 = BjFdtd3d_new(1048576, 1048576, 1048576, DX, &e21);
    var w24 = "invalid parameter: cannot allocate 1152921504606846976 grid values";
    assert(v24 == BJ_ERR_INVALID_PARAMETER && text_is(bj_last_error_display(), w24) == 1, "2^60 cells");
    var g25: BjFdtd3d;
    var t25, v25 = BjFdtd3d_new(5, 6, 7, DX, &g25);
    var r25a, r25av = g25.set_conductivity(0, 6, 0, 1, 1, 1, 1.0);
    var w25a = "invalid parameter: region y range 6..1 is invalid for a grid of 6 cells";
    assert(is_err_result(r25a) == 1 && text_is(bj_last_error_display(), w25a) == 1, "y's range checked after x's");
    var r25b, r25bv = g25.set_conductivity(0, 0, 3, 1, 1, 2, 1.0);
    var w25b = "invalid parameter: region z range 3..2 is invalid for a grid of 7 cells";
    assert(is_err_result(r25b) == 1 && text_is(bj_last_error_display(), w25b) == 1 && g25.ca == 0,
      "z's range; nothing mapped on an error");

    test_group("cyrius_fdtd3d_grid");
    fill(g25.ex, 210, 1.0);
    fill(g25.ey, 210, 1.0);
    fill(g25.ez, 210, 1.0);
    g25.step_once();
    assert(face_zero(&g25, g25.ey, 0) == 1 && face_zero(&g25, g25.ez, 0) == 1, "E_y, E_z zero on the x faces");
    assert(face_zero(&g25, g25.ex, 1) == 1 && face_zero(&g25, g25.ez, 1) == 1, "E_x, E_z zero on the y faces");
    assert(face_zero(&g25, g25.ex, 2) == 1 && face_zero(&g25, g25.ey, 2) == 1, "E_x, E_y zero on the z faces");
    var ex_xface: f64 = at(g25.ex, g25.idx(0, 3, 3));
    var ez_zface: f64 = at(g25.ez, g25.idx(2, 3, 0));
    assert(ex_xface == 1.0 && ez_zface == 1.0, "the normal components on a face are kept (E_x on x, E_z on z)");
    var r26, r26v = g25.set_conductivity(1, 1, 1, 2, 2, 2, 0.5);
    var ca26: f64 = at(g25.ca, g25.idx(1, 1, 1));
    var cb26: f64 = at(g25.ca, g25.idx(3, 3, 3));
    var sg26: f64 = at(g25.conductivity, g25.idx(1, 1, 1));
    assert(is_ok(r26) == 1 && g25.lossy_bytes == 2 * 210 * 8 && ca26 < 1.0 && cb26 == 1.0 && sg26 == 0.5,
      "C_a and σ mapped by the first lossy region");
    g25.run(3, BJ_FDTD3D_NO_SOURCE, 0, 0, 1000000000.0, 1.0);
    var tm25: f64 = g25.time();
    var t4w: f64 = 4.0 * g25.dt;
    assert(g25.step == 4 && tm25 == t4w, "run without a source; time = step·dt");
    g25.add_source_ez(0 - 1, 2, 2, 1.0);
    BjFdtd3d_free(&g25);
    assert(g25.ex == 0 && g25.ca == 0 && g25.map_bytes == 0 && g25.lossy_bytes == 0 && g25.nz == 0,
      "freed and emptied");
    BjFdtd3d_free(&g25);

    test_group("cyrius_fdtd3d_cpml");
    var g27: BjFdtd3d;
    var t27, v27 = BjFdtd3d_new(9, 10, 11, DX, &g27);
    var e27a, e27av = g27.try_enable_cpml(4);
    var w27 = "invalid parameter: CPML thickness 4 is invalid for a 9×10×11 grid ";
    var w27x = "(need thickness ≥ 1 and 2·thickness + 3 ≤ min(nx, ny, nz))";
    assert(is_err_result(e27a) == 1 && text_is2(bj_last_error_display(), w27, w27x) == 1 && g27.cpml() == 0,
      "the thickness's record, the smallest axis named");
    var bad27: BjCpmlParams = BjCpmlParams_new(2);
    bad27.grading_order = 0.5;
    var e27b, e27bv = g27.try_enable_cpml_with(&bad27);
    var w27b = "invalid parameter: CPML grading order must be finite and ≥ 1, got 0.5";
    assert(is_err_result(e27b) == 1 && text_is(bj_last_error_display(), w27b) == 1, "the grading's own record");
    var e27c, e27cv = g27.try_enable_cpml(3);
    assert(is_ok(e27c) == 1 && g27.slab_x == 6 * 10 * 11 && g27.slab_y == 6 * 9 * 11 && g27.slab_z == 6 * 9 * 10
      && g27.psi_bytes == 4 * (660 + 594 + 540) * 8, "the twelve slabs: 2t·ny·nz, 2t·nx·nz, 2t·nx·ny f64 each");
    g27.add_source_ez(4, 5, 5, 1.0);
    for (var k27 = 0; k27 < 6; k27 = k27 + 1) { g27.step_once(); }
    var any27 = 0;
    for (var q27 = 0; q27 < 4 * (660 + 594 + 540); q27 = q27 + 1) {
        var pv27: f64 = at(g27.psi, q27);
        if (pv27 != 0.0) { any27 = 1; }
    }
    var e27d, e27dv = g27.try_enable_cpml(2);
    var zero27 = 1;
    for (var q27b = 0; q27b < 4 * (440 + 396 + 360); q27b = q27b + 1) {
        var pz27: f64 = at(g27.psi, q27b);
        if (pz27 != 0.0) { zero27 = 0; }
    }
    assert(any27 == 1 && is_ok(e27d) == 1 && zero27 == 1 && g27.slab_x == 4 * 10 * 11,
      "the slabs carry Ψ; re-enabling restarts it at zero");
    BjFdtd3d_free(&g27);
    assert(g27.cpml == 0 && g27.psi == 0 && g27.psi_bytes == 0, "BjFdtd3d_free gives the CPML back");

    # ADR 0002 rows 13 and 40 (M6 part 4a): dt, the coefficients and time() rounded once, the lossy C_a and C_b once
    # from their exact rationals. The expectations are validate.py's model of the port.
    test_group("cyrius_round_once");
    var ro1: BjFdtd3d;
    var tro1, vro1 = BjFdtd3d_new(6, 6, 6, 0.05, &ro1);
    var ro1dw: f64 = _bj_from_bits(0x3dca77ec567841e7);
    var ro1e: f64 = at(ro1.ce, 0);
    var ro1ew: f64 = _bj_from_bits(0x405b302bcf95a463);
    var ro1h: f64 = at(ro1.ch, 0);
    var ro1hw: f64 = _bj_from_bits(0x3f491be4e0c5a66b);
    assert(is_ok(tro1) == 1 && ro1.dt == ro1dw && ro1e == ro1ew && ro1h == ro1hw,
      "dx/(2√3·c), dt/(ε₀dx) and dt/(μ₀dx) at dx = 5 cm, each rounded once (Rust's each an ulp above)");
    BjFdtd3d_free(&ro1);
    var ro2: BjFdtd3d;
    var tro2, vro2 = BjFdtd3d_new(6, 6, 6, 0.001, &ro2);
    var ro2s: f64 = _bj_from_bits(0x403263ee22a0d6bb);
    var tro3, vro3 = ro2.set_conductivity(1, 1, 1, 5, 5, 4, ro2s);
    var ro2ap: f64 = _bj_from_bits(0x3d619816ede2c519);
    var ro2aw: f64 = -ro2ap;
    var ro2bw: f64 = _bj_from_bits(0x404b302bcf959571);
    var ro2a: f64 = at(ro2.ca, ro2.idx(2, 2, 2));
    var ro2b: f64 = at(ro2.ce, ro2.idx(2, 2, 2));
    assert(is_ok(tro3) == 1 && ro2a == ro2aw && ro2b == ro2bw,
      "C_a at σΔt/2ε = 1 + 10⁻¹²: the exact −5.000543942645428·10⁻¹³ (Rust's −5.000444502909205·10⁻¹³)");
    ro2.step = 9007199255861437;
    var ro2t: f64 = ro2.time();
    var ro2tw: f64 = _bj_from_bits(0x40c0f097419db1f8);
    assert(ro2t == ro2tw, "a step of 2^53 + 1,120,445: step·dt rounded once (Rust's an ulp below)");
    BjFdtd3d_free(&ro2);

    # ADR 0002 row 18 (M6 part 4d): a cell whose curl update leaves the normal range runs it with an unbounded
    # exponent, in a row's packed part and its scalar tail. The expectations are validate.py's model of the port.
    test_group("cyrius_update_edges");
    var mxv: f64 = _bj_from_bits(0x7fefffffffffffff);
    var nmx: f64 = -mxv;
    var ue1: BjFdtd3d;
    var tue1, vue1 = BjFdtd3d_new(9, 7, 7, 0.001, &ue1);
    ue1.add_source_ez(4, 3, 3, mxv);
    ue1.add_source_ez(5, 3, 3, nmx);
    ue1.add_source_ez(8, 3, 3, mxv);
    ue1.add_source_ez(8, 4, 3, nmx);
    ue1.step_once();
    var ue1y: f64 = at(ue1.hy, ue1.idx(4, 3, 3));
    var ue1yp: f64 = _bj_from_bits(0x7f591be4e0c5a66b);
    var ue1yw: f64 = -ue1yp;
    var ue1x: f64 = at(ue1.hx, ue1.idx(8, 3, 3));
    var ue1z: f64 = at(ue1.ez, ue1.idx(4, 3, 3));
    var ue1zw: f64 = _bj_from_bits(0x7fe2aaaaaaaaaa06);
    assert(is_ok(tue1) == 1 && ue1y == ue1yw && ue1x == ue1yp && ue1z == ue1zw,
      "ΔE_z past DBL_MAX: H_y −2.755·10³⁰⁵ (packed), H_x 2.755·10³⁰⁵ (tail), E_z 1.0487·10³⁰⁸ (Rust's −∞, ∞, −∞)");
    BjFdtd3d_free(&ue1);
    var ue2: BjFdtd3d;
    var tue2, vue2 = BjFdtd3d_new(9, 7, 7, 0.001, &ue2);
    var ue2m: f64 = _bj_from_bits(0x3f54f8b588e368f1);
    var hmx: f64 = _bj_from_bits(0x7fe0000000000000);
    var nhmx: f64 = -hmx;
    var tue2e, vue2e = ue2.set_permittivity(0, 0, 0, 9, 7, 7, 1000.0);
    var tue2m, vue2m = ue2.set_permeability(0, 0, 0, 9, 7, 7, ue2m);
    ue2.add_source_ez(6, 3, 3, hmx);
    ue2.add_source_ez(7, 3, 3, nhmx);
    ue2.step_once();
    var ue2y: f64 = at(ue2.hy, ue2.idx(6, 3, 3));
    var ue2yp: f64 = _bj_from_bits(0x7fe328180ebccb88);
    var ue2yw: f64 = -ue2yp;
    var ue2z: f64 = at(ue2.ez, ue2.idx(7, 3, 3));
    var ue2zp: f64 = _bj_from_bits(0x7fd59555555554d6);
    var ue2zw: f64 = -ue2zp;
    assert(is_ok(tue2) == 1 && is_ok(tue2e) == 1 && is_ok(tue2m) == 1 && ue2y == ue2yw && ue2z == ue2zw,
      "ε_r 1000, μ_r 1.28·10⁻³: H_y −1.0762·10³⁰⁸, then a tail curl past DBL_MAX, E_z −6.0625·10³⁰⁷ (Rust's −∞, ∞)");
    BjFdtd3d_free(&ue2);
    var ue3: BjFdtd3d;
    var tue3, vue3 = BjFdtd3d_new(9, 7, 7, 0.001, &ue3);
    var tn: f64 = _bj_from_bits(1);
    var ntn: f64 = -tn;
    ue3.add_source_ez(4, 3, 3, tn);
    ue3.add_source_ez(5, 3, 3, ntn);
    ue3.step_once();
    var ue3y: f64 = at(ue3.hy, ue3.idx(4, 3, 3));
    var ue3x: f64 = at(ue3.hx, ue3.idx(4, 2, 3));
    var ue3x5: f64 = at(ue3.hx, ue3.idx(5, 3, 3));
    var negz = 0 - 9223372036854775807 - 1;
    assert(is_ok(tue3) == 1 && _bj_k_bits(ue3y) == negz && _bj_k_bits(ue3x) == negz && _bj_k_bits(ue3x5) == negz,
      "products of 2^-1074 differences round to −0: the exact sums' −0 (Rust's +0 + −0 gave +0)");
    BjFdtd3d_free(&ue3);

    # ADR 0002 row 18 (M6 part 4e): each CPML statement runs with an unbounded exponent at its range edges, in the
    # scalar x-slabs and the packed y-slabs. The expectations are validate.py's model of the port.
    test_group("cyrius_cpml_edges");
    var ce1: BjFdtd3d;
    var tce1, vce1 = BjFdtd3d_new(9, 9, 9, 0.001, &ce1);
    var tce1c, vce1c = ce1.try_enable_cpml(2);
    ce1.add_source_ez(1, 4, 4, mxv);
    ce1.add_source_ez(2, 4, 4, nmx);
    ce1.add_source_ez(4, 1, 4, mxv);
    ce1.add_source_ez(4, 2, 4, nmx);
    ce1.step_once();
    var ce1y: f64 = at(ce1.hy, ce1.idx(1, 4, 4));
    var ce1hp: f64 = _bj_from_bits(0x7f58bfc8214c44c2);
    var ce1hw: f64 = -ce1hp;
    var ce1x: f64 = at(ce1.hx, ce1.idx(4, 1, 4));
    var ce1z: f64 = at(ce1.ez, ce1.idx(1, 4, 4));
    var ce1z2: f64 = at(ce1.ez, ce1.idx(4, 1, 4));
    var ce1zw: f64 = _bj_from_bits(0x7fe45fbd70d8442b);
    var ce1e: f64 = at(ce1.ex, ce1.idx(1, 4, 4));
    var ce1e2: f64 = at(ce1.ey, ce1.idx(4, 1, 4));
    var ce1ew: f64 = _bj_from_bits(0x7fc507126a8b8be1);
    assert(is_ok(tce1) == 1 && is_ok(tce1c) == 1 && ce1y == ce1hw && ce1x == ce1hp,
      "Δ past DBL_MAX in the slabs: H_y = −2.716·10³⁰⁵ (x-slab), H_x = 2.716·10³⁰⁵ (y-slab) (Rust's NaN)");
    assert(ce1z == ce1zw && ce1z2 == ce1zw && ce1e == ce1ew && ce1e2 == ce1ew,
      "then E_z = 1.1445678707085323·10³⁰⁸ and E_x, E_y = 2.9532200524477127·10³⁰⁷ (Rust's NaN)");
    BjFdtd3d_free(&ce1);

    # ADR 0002 row 18 (M6 part 4f): total_energy at its range edges, with an unbounded exponent. The expectation is
    # validate.py's model of the port.
    test_group("cyrius_energy_edges");
    var ee1: BjFdtd3d;
    var dxs: f64 = _bj_from_bits(0x20ca2fe76a3f9475);
    var tee1, vee1 = BjFdtd3d_new(6, 6, 6, dxs, &ee1);
    var e160: f64 = _bj_from_bits(0x6126c2d4256ffcc3);
    for (var ez = 0; ez < 6; ez = ez + 1) {
        for (var ey = 0; ey < 6; ey = ey + 1) {
            for (var ex = 0; ex < 6; ex = ex + 1) { ee1.add_source_ez(ex, ey, ez, e160); }
        }
    }
    var ee1e: f64 = ee1.total_energy();
    var ee1w: f64 = _bj_from_bits(0x23123857ac18d04f);
    assert(is_ok(tee1) == 1 && ee1e == ee1w,
      "E_z = 10¹⁶⁰ on dx = 10⁻¹⁵⁰: |E|² past DBL_MAX, dx³ below the range: 9.562522837824012·10⁻¹⁴⁰ (Rust's ∞·0)");
    BjFdtd3d_free(&ee1);

    test_group("cyrius_audit_201_cpml_layout (2.0.1 bite 1b, H13)");
    # A consumer that frees the grid's own layer through cpml(): its profiles are gone, so the step skips.
    var la: BjFdtd3d;
    var tla, vla = BjFdtd3d_new(14, 14, 14, DX4, &la);
    var tlc, vlc = la.try_enable_cpml(2);
    la.step_once();
    BjCpml_free(la.cpml());
    la.step_once();
    la.run(5, 7, 7, 7, 1000000000.0, 1.0);
    assert(is_ok(tla) == 1 && is_ok(tlc) == 1 && la.step == 1, "a layer freed through cpml(): steps and runs skipped");
    BjFdtd3d_free(&la);
    assert(la.cpml() == 0, "and the grid still frees");

    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
