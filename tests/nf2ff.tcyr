# nf2ff.tcyr — src/nf2ff.cyr (M5 part 1e): the phasor NF2FF transform.
#
# Every group named test_* is rust-old/src/fdtd.rs's test of that name, ported assertion for assertion (the ledger
# matches them by name): the four on the phasor transform and its references (the Bessel helpers, the line source, the
# plane wave's extinction, the validation), and the six that drive a BjFdtd2d through bj_nf2ff_2d (M6 part 1c;
# `test_nf2ff_snapshot_validation`'s `fx.truncate(10)` step is n/a, ADR 0002 row 2: the arrays are fixed). Rust's test
# helpers are ported as written: Bessel J_n by the trapezoid rule over 512 points, Y_n by Simpson's rule (DLMF §10.9),
# and `nf2ff_fill`, which writes exact phasors into the accumulators near the contour. The cyrius_* groups pin the error
# records' text, the angles, a zero field's zero pattern, and BjNf2ffResult_free.

include "tests/lib.cyr"

var PI: f64 = 3.141592653589793;

# |a − b| < tol.
fn near(a: f64, b: f64, tol: f64): i64 {
    var d: f64 = a - b;
    var ad: f64 = f64_abs(d);
    if (ad < tol) { return 1; }
    return 0;
}

# 1 when the C strings a and b are equal.
fn text_is(a, b): i64 {
    var n = strlen(a);
    if (n != strlen(b)) { return 0; }
    return memeq(a, b, n);
}

# A word as a *f64.
fn f64p(a): *f64 {
    return a;
}

# Element i of the f64 array at address a.
fn at(a, i): f64 {
    var p: *f64 = f64p(a);
    var x: f64 = p[i];
    return x;
}

# asinh y = ln(y + √(y² + 1)), y > 0.
fn asinh(y: f64): f64 {
    var s: f64 = f64_sqrt(y * y + 1.0);
    var r: f64 = _bj_ln(y + s);
    return r;
}

# Bessel J_n(x) from Bessel's integral (1/2π)∫₀^{2π} cos(nτ − x sin τ) dτ, the periodic trapezoid rule over 512 points
# (summed from −0.0, Rust's `Sum`). Rust's test helper `bessel_j`.
fn bessel_j(n, x: f64): f64 {
    var m = 512;
    var mf: f64 = f64_from(m);
    var h: f64 = 2.0 * PI / mf;
    var nf: f64 = f64_from(n);
    var s: f64 = -0.0;
    for (var i = 0; i < m; i = i + 1) {
        var fi: f64 = f64_from(i);
        var t: f64 = fi * h;
        var st: f64 = _bj_sin(t);
        var c: f64 = _bj_cos(nf * t - x * st);
        s = s + c;
    }
    var r: f64 = s / mf;
    return r;
}

# ∫₀^π sin(x sin τ − nτ) dτ by composite Simpson over 2000 intervals.
fn simpson_a(x: f64, nf: f64): f64 {
    var m = 2000;
    var h: f64 = PI / 2000.0;
    var f0: f64 = _bj_sin(x * _bj_sin(0.0) - nf * 0.0);
    var f1: f64 = _bj_sin(x * _bj_sin(PI) - nf * PI);
    var acc: f64 = f0 + f1;
    for (var i = 1; i < m; i = i + 1) {
        var fi: f64 = f64_from(i);
        var t: f64 = 0.0 + fi * h;
        var st: f64 = _bj_sin(t);
        var v: f64 = _bj_sin(x * st - nf * t);
        var wgt: f64 = 2.0;
        if (i % 2 == 1) { wgt = 4.0; }
        acc = acc + v * wgt;
    }
    var r: f64 = acc * h / 3.0;
    return r;
}

# The integrand (e^{nt} + sign·e^{−nt})·e^{−x sinh t}.
fn y_tail(t: f64, x: f64, nf: f64, sign: f64): f64 {
    var a: f64 = _bj_exp(nf * t);
    var b: f64 = _bj_exp(-nf * t);
    var sh: f64 = _bj_sinh(t);
    var c: f64 = _bj_exp(-x * sh);
    var r: f64 = (a + sign * b) * c;
    return r;
}

# ∫₀^upper of y_tail by composite Simpson over 2000 intervals.
fn simpson_b(x: f64, nf: f64, sign: f64, upper: f64): f64 {
    var m = 2000;
    var h: f64 = upper / 2000.0;
    var acc: f64 = y_tail(0.0, x, nf, sign) + y_tail(upper, x, nf, sign);
    for (var i = 1; i < m; i = i + 1) {
        var fi: f64 = f64_from(i);
        var t: f64 = 0.0 + fi * h;
        var v: f64 = y_tail(t, x, nf, sign);
        var wgt: f64 = 2.0;
        if (i % 2 == 1) { wgt = 4.0; }
        acc = acc + v * wgt;
    }
    var r: f64 = acc * h / 3.0;
    return r;
}

# Bessel Y_n(x), x > 0: (1/π)∫₀^π sin(x sin τ − nτ)dτ − (1/π)∫₀^∞ (e^{nt} + (−1)ⁿe^{−nt})·e^{−x sinh t} dt (DLMF
# §10.9), the second integral cut where e^{−x sinh t} < e^{−60}. Rust's test helper `bessel_y`.
fn bessel_y(n, x: f64): f64 {
    var nf: f64 = f64_from(n);
    var a: f64 = simpson_a(x, nf);
    var sign: f64 = 1.0;
    if (n % 2 != 0) { sign = -1.0; }
    var upper: f64 = asinh(60.0 / x) + 1.0;
    var b: f64 = simpson_b(x, nf, sign, upper);
    var r: f64 = (a - b) / PI;
    return r;
}

# The field's parameters: its kind, k, η and the line source's position.
var g_kind = 0;
var g_k: f64 = 0.0;
var g_eta: f64 = 0.0;
var g_sx: f64 = 0.0;
var g_sy: f64 = 0.0;

# The field the fill writes: kind 0 an off-centre line current E_z = H₀⁽²⁾(kρ), H_x = −(j/η)H₁⁽²⁾ sin φ,
# H_y = (j/η)H₁⁽²⁾ cos φ; kind 1 a plane wave at α = 0.3 (E_z = e^{−jk(x cos α + y sin α)}). Its phasor of component c
# (0 E_z, 1 H_x, 2 H_y) at (x, y) into out[0], out[1].
fn field(x: f64, y: f64, c, out: *f64) {
    var k: f64 = g_k;
    var eta: f64 = g_eta;
    if (g_kind == 1) {
        var sa, ca = _bj_sin_cos(0.3);
        var s, co = _bj_sin_cos(-k * (x * ca + y * sa));
        if (c == 0) {
            out[0] = co;
            out[1] = s;
        } elif (c == 1) {
            out[0] = sa * co / eta;
            out[1] = sa * s / eta;
        } else {
            out[0] = -ca * co / eta;
            out[1] = -ca * s / eta;
        }
        return 0;
    }
    var sx: f64 = g_sx;
    var sy: f64 = g_sy;
    var px: f64 = x - sx;
    var py: f64 = y - sy;
    var r: f64 = _bj_hypot(px, py);
    var kr: f64 = k * r;
    if (c == 0) {
        out[0] = bessel_j(0, kr);
        out[1] = -bessel_y(0, kr);
        return 0;
    }
    var h1r: f64 = bessel_j(1, kr);
    var h1i: f64 = -bessel_y(1, kr);
    if (c == 1) {
        var s1: f64 = py / r;
        out[0] = h1i * s1 / eta;
        out[1] = -h1r * s1 / eta;
    } else {
        var c1: f64 = px / r;
        out[0] = -h1i * c1 / eta;
        out[1] = h1r * c1 / eta;
    }
    return 0;
}

# Rust's test helper `nf2ff_fill`: exact phasors near the contour of an nx × ny grid into the three accumulators (made
# here, size nx·ny), H delayed by dt/2 like FDTD-accumulated H.
fn nf2ff_fill(nx, ny, dx: f64, margin, freq: f64, dt: f64, ez: *BjCwAccumulator, hx: *BjCwAccumulator,
  hy: *BjCwAccumulator) {
    var n = nx * ny;
    var t1, v1 = BjCwAccumulator_new(n, freq, dt, ez);
    var t2, v2 = BjCwAccumulator_new(n, freq, dt, hx);
    var t3, v3 = BjCwAccumulator_new(n, freq, dt, hy);
    var x0 = margin;
    var x1 = nx - 1 - margin;
    var y0 = margin;
    var y1 = ny - 1 - margin;
    var lagarg: f64 = -PI * freq * dt;
    var sl, cl = _bj_sin_cos(lagarg);
    var ph: f64[2];
    var er: *f64 = f64p(ez.real);
    var ei: *f64 = f64p(ez.imag);
    var hxr: *f64 = f64p(hx.real);
    var hxi: *f64 = f64p(hx.imag);
    var hyr: *f64 = f64p(hy.real);
    var hyi: *f64 = f64p(hy.imag);
    for (var y = 0; y < ny; y = y + 1) {
        for (var x = 0; x < nx; x = x + 1) {
            var in_box = 0;
            if (x + 1 >= x0 && x <= x1 && y + 1 >= y0 && y <= y1) { in_box = 1; }
            var near_edge = 0;
            if (x <= x0 || x + 1 >= x1 || y <= y0 || y + 1 >= y1) { near_edge = 1; }
            if (in_box == 0 || near_edge == 0) { continue; }
            var i = y * nx + x;
            var xi: f64 = f64_from(x);
            var yi: f64 = f64_from(y);
            var xf: f64 = xi * dx;
            var yf: f64 = yi * dx;
            field(xf, yf, 0, &ph);
            er[i] = ph[0];
            ei[i] = ph[1];
            field(xf, yf + 0.5 * dx, 1, &ph);
            hxr[i] = ph[0] * cl - ph[1] * sl;
            hxi[i] = ph[0] * sl + ph[1] * cl;
            field(xf + 0.5 * dx, yf, 2, &ph);
            hyr[i] = ph[0] * cl - ph[1] * sl;
            hyi[i] = ph[0] * sl + ph[1] * cl;
        }
    }
    return 0;
}

# A 100-point accumulator at freq and dt filled by the corpus's NF2FF generator `which` (0, 1, 2: part 1e's g1, g2,
# g3): re[i] = a·((i·p + q) mod m) − b, im[i] = c·((i·p + q + 7) mod m) − d.
fn gen_acc(acc: *BjCwAccumulator, freq: f64, dt: f64, which) {
    var t, v = BjCwAccumulator_new(100, freq, dt, acc);
    var p = 3;
    var q = 1;
    var m = 13;
    var a: f64 = 0.25;
    var b: f64 = 1.5;
    var c: f64 = 0.125;
    var d: f64 = 0.75;
    if (which == 1) {
        p = 5;
        q = 2;
        m = 17;
        a = -0.5;
        b = 2.0;
        c = 0.375;
        d = -1.25;
    }
    if (which == 2) {
        p = 7;
        q = 4;
        m = 11;
        a = 1.0;
        b = 5.0;
        c = -0.25;
        d = 1.0;
    }
    var re: *f64 = f64p(acc.real);
    var im: *f64 = f64p(acc.imag);
    for (var i = 0; i < 100; i = i + 1) {
        var x: f64 = f64_from((i * p + q) % m);
        re[i] = a * x - b;
        var y: f64 = f64_from((i * p + q + 7) % m);
        im[i] = c * y - d;
    }
    return 0;
}

# Runs fdtd.rs's phasor NF2FF tests, then the Cyrius-only checks.
fn main() {
    alloc_init();
    var zero: f64 = 0.0;
    var nan: f64 = zero / zero;
    var c0: f64 = BJ_SPEED_OF_LIGHT;
    var eta: f64 = f64_sqrt(BJ_MU_0 / BJ_EPSILON_0);
    var sqrt2: f64 = 1.4142135623730951;

    test_group("test_bessel_reference_helpers");
    var bad1 = 0;
    var xs: f64[2];
    var j0s: f64[2];
    var y0s: f64[2];
    var j1s: f64[2];
    var y1s: f64[2];
    xs[0] = 1.0;
    j0s[0] = 0.7651976866;
    y0s[0] = 0.0882569642;
    j1s[0] = 0.4400505857;
    y1s[0] = -0.7812128213;
    xs[1] = 10.0;
    j0s[1] = -0.2459357645;
    y0s[1] = 0.0556711673;
    j1s[1] = 0.0434727462;
    y1s[1] = 0.2490154242;
    for (var k1 = 0; k1 < 2; k1 = k1 + 1) {
        var x: f64 = xs[k1];
        if (near(bessel_j(0, x), j0s[k1], 0.000000001) != 1) { bad1 = bad1 + 1; }
        if (near(bessel_y(0, x), y0s[k1], 0.000000001) != 1) { bad1 = bad1 + 1; }
        if (near(bessel_j(1, x), j1s[k1], 0.000000001) != 1) { bad1 = bad1 + 1; }
        if (near(bessel_y(1, x), y1s[k1], 0.000000001) != 1) { bad1 = bad1 + 1; }
    }
    assert(bad1 == 0, "J₀, Y₀, J₁, Y₁ at 1 and 10 within 10⁻⁹ of A&S Table 9.1");

    test_group("test_nf2ff_phasor_line_source");
    var freq: f64 = 1000000000.0;
    var lambda: f64 = c0 / freq;
    var dx: f64 = lambda / 30.0;
    var k: f64 = 2.0 * PI / lambda;
    var dt: f64 = dx / (2.0 * sqrt2 * c0);
    g_kind = 0;
    g_k = k;
    g_eta = eta;
    g_sx = 35.5 * dx + 0.37 * lambda;
    g_sy = 35.5 * dx - 0.21 * lambda;
    var ez: BjCwAccumulator;
    var hx: BjCwAccumulator;
    var hy: BjCwAccumulator;
    nf2ff_fill(72, 72, dx, 6, freq, dt, &ez, &hx, &hy);
    var res: BjNf2ffResult;
    var t2, v2 = bj_nf2ff_2d_phasor(&ez, &hx, &hy, 72, 72, dx, 6, 72, &res);
    assert(is_ok(t2) == 1 && res.count == 72, "72 angles");
    var expected: f64 = f64_sqrt(2.0 / (PI * k));
    var worst: f64 = 0.0;
    for (var a = 0; a < res.count; a = a + 1) {
        var p: f64 = at(res.pattern, a);
        var err: f64 = f64_abs(p - expected) / expected;
        if (err > worst) { worst = err; }
    }
    assert(worst < 0.01, "isotropic √(2/(πk)) within 1 % at every angle");
    BjNf2ffResult_free(&res);
    BjCwAccumulator_free(&ez);
    BjCwAccumulator_free(&hx);
    BjCwAccumulator_free(&hy);

    test_group("test_nf2ff_phasor_plane_wave_extinction");
    g_kind = 1;
    nf2ff_fill(72, 72, dx, 6, freq, dt, &ez, &hx, &hy);
    var t3, v3 = bj_nf2ff_2d_phasor(&ez, &hx, &hy, 72, 72, dx, 6, 72, &res);
    var sf: f64 = f64_from(72 - 1 - 2 * 6);
    var side: f64 = sf * dx;
    var scale: f64 = f64_sqrt(k / (8.0 * PI)) * side;
    var mx: f64 = 0.0;
    for (var a3 = 0; a3 < res.count; a3 = a3 + 1) {
        var p3: f64 = at(res.pattern, a3);
        mx = _bj_max(mx, p3);
    }
    assert(is_ok(t3) == 1 && mx < 0.02 * scale, "a plane wave through the contour radiates under 2 % of one side");
    BjNf2ffResult_free(&res);
    BjCwAccumulator_free(&ez);
    BjCwAccumulator_free(&hx);
    BjCwAccumulator_free(&hy);

    test_group("test_nf2ff_phasor_validation");
    var ca: BjCwAccumulator;
    var cb: BjCwAccumulator;
    var cs: BjCwAccumulator;
    var cz: BjCwAccumulator;
    var tca, vca = BjCwAccumulator_new(400, 1000000000.0, 0.000000000001, &ca);
    var tcb, vcb = BjCwAccumulator_new(400, 2000000000.0, 0.000000000001, &cb);
    var tcs, vcs = BjCwAccumulator_new(10, 1000000000.0, 0.000000000001, &cs);
    var tcz, vcz = BjCwAccumulator_new(400, 0.0, 0.000000000001, &cz);
    var r4: BjNf2ffResult;
    var t4a, v4a = bj_nf2ff_2d_phasor(&ca, &ca, &ca, 20, 20, 0.001, 3, 8, &r4);
    assert(is_ok(t4a) == 1, "valid");
    BjNf2ffResult_free(&r4);
    var t4b, v4b = bj_nf2ff_2d_phasor(&ca, &cb, &ca, 20, 20, 0.001, 3, 8, &r4);
    var t4c, v4c = bj_nf2ff_2d_phasor(&ca, &ca, &cs, 20, 20, 0.001, 3, 8, &r4);
    var t4d, v4d = bj_nf2ff_2d_phasor(&cz, &cz, &cz, 20, 20, 0.001, 3, 8, &r4);
    assert(is_err_result(t4b) == 1 && is_err_result(t4c) == 1 && is_err_result(t4d) == 1,
      "mismatched frequencies, a short accumulator and f = 0 refused");
    var t4e, v4e = bj_nf2ff_2d_phasor(&ca, &ca, &ca, 20, 20, nan, 3, 8, &r4);
    var t4f, v4f = bj_nf2ff_2d_phasor(&ca, &ca, &ca, 20, 20, 0.001, 10, 8, &r4);
    var t4g, v4g = bj_nf2ff_2d_phasor(&ca, &ca, &ca, 20, 20, 0.001, 3, 0, &r4);
    assert(is_err_result(t4e) == 1 && is_err_result(t4f) == 1 && is_err_result(t4g) == 1,
      "dx = NaN, margin 10 and no angle refused");

    test_group("test_nf2ff_basic");
    var g1: BjFdtd2d;
    var tg1, vg1 = BjFdtd2d_new(60, 60, 0.0001, BJ_MODE2D_TM, &g1);
    g1.run(100, 30, 30, 3000000000.0, 1.0);
    var rb: BjNf2ffResult;
    var tb, vb = bj_nf2ff_2d(&g1, 5, 36, 3000000000.0, &rb);
    var anyb = 0;
    for (var kb = 0; kb < 36; kb = kb + 1) {
        var pb: f64 = at(rb.pattern, kb);
        var ab: f64 = f64_abs(pb);
        if (ab > 0.0) { anyb = 1; }
    }
    assert(is_ok(tb) == 1 && rb.count == 36 && anyb == 1, "36 angles, a nonzero pattern");
    test_group("test_nf2ff_snapshot_is_magnitude");
    var tm2, vm2 = bj_nf2ff_2d(&g1, 5, 36, 3000000000.0, &rb);
    var allm = 1;
    var anym = 0;
    for (var km = 0; km < 36; km = km + 1) {
        var pm: f64 = at(rb.pattern, km);
        var zm: f64 = pm * 0.0;
        if (!(pm >= 0.0 && zm == 0.0)) { allm = 0; }
        if (pm > 0.0) { anym = 1; }
    }
    assert(is_ok(tm2) == 1 && allm == 1 && anym == 1, "every value ≥ 0 and finite, some > 0");
    BjNf2ffResult_free(&rb);
    BjFdtd2d_free(&g1);

    test_group("test_nf2ff_invalid_margin");
    var g2: BjFdtd2d;
    var tg2, vg2 = BjFdtd2d_new(10, 10, 0.0001, BJ_MODE2D_TM, &g2);
    var ti2, vi2 = bj_nf2ff_2d(&g2, 6, 36, 1000000000.0, &rb);
    assert(is_err_result(ti2) == 1, "margin 6 on 10 × 10");

    test_group("test_nf2ff_zero_angles");
    var tz2, vz2 = bj_nf2ff_2d(&g2, 2, 0, 1000000000.0, &rb);
    assert(is_err_result(tz2) == 1, "no angle");
    BjFdtd2d_free(&g2);

    test_group("test_nf2ff_snapshot_validation");
    var te3: BjFdtd2d;
    var tt3, vt3 = BjFdtd2d_new(30, 30, 0.0001, BJ_MODE2D_TE, &te3);
    var tv1, vv1 = bj_nf2ff_2d(&te3, 3, 8, 1000000000.0, &rb);
    assert(is_err_result(tv1) == 1, "TE refused");
    BjFdtd2d_free(&te3);
    var tm3: BjFdtd2d;
    var tt4, vt4 = BjFdtd2d_new(30, 30, 0.0001, BJ_MODE2D_TM, &tm3);
    var tv2, vv2 = bj_nf2ff_2d(&tm3, 0, 8, 1000000000.0, &rb);
    var tv3, vv3 = bj_nf2ff_2d(&tm3, 3, 8, 0.0, &rb);
    var tv4, vv4 = bj_nf2ff_2d(&tm3, 3, 8, nan, &rb);
    assert(is_err_result(tv2) == 1 && is_err_result(tv3) == 1 && is_err_result(tv4) == 1,
      "margin 0 (the contour on the PEC edge), f = 0, f = NaN");

    test_group("test_nf2ff_angle_coverage");
    var tv5, vv5 = bj_nf2ff_2d(&tm3, 3, 4, 1000000000.0, &rb);
    var an0: f64 = at(rb.angles, 0);
    var an1: f64 = at(rb.angles, 1);
    var hp: f64 = PI / 2.0;
    assert(is_ok(tv5) == 1 && near(an0, 0.0, 0.0000000001) == 1 && near(an1, hp, 0.0000000001) == 1, "0, π/2");
    BjNf2ffResult_free(&rb);
    BjFdtd2d_free(&tm3);

    test_group("cyrius_nf2ff_snapshot_records");
    var te4: BjFdtd2d;
    var tt5, vt5 = BjFdtd2d_new(20, 20, 0.0001, BJ_MODE2D_TE, &te4);
    var tv6, vv6 = bj_nf2ff_2d(&te4, 0, 0, nan, &rb);
    var wte = "invalid parameter: NF2FF requires a TM-mode simulation, got Te";
    assert(text_is(bj_last_error_display(), wte) == 1, "the mode first, Rust's text");
    BjFdtd2d_free(&te4);
    var tm4: BjFdtd2d;
    var tt6, vt6 = BjFdtd2d_new(20, 20, 0.0001, BJ_MODE2D_TM, &tm4);
    var tv7, vv7 = bj_nf2ff_2d(&tm4, 3, 8, -1.0, &rb);
    var wf = "invalid parameter: NF2FF frequency must be finite and positive, got -1";
    assert(text_is(bj_last_error_display(), wf) == 1, "the frequency's text");
    var tv8, vv8 = bj_nf2ff_2d(&tm4, 3, 8, 1000000000.0, &rb);
    var z8: f64 = at(rb.pattern, 0);
    assert(is_ok(tv8) == 1 && z8 == 0.0, "a zero field radiates nothing");
    BjNf2ffResult_free(&rb);
    BjFdtd2d_free(&tm4);

    test_group("cyrius_nf2ff_error_records");
    var t5a, v5a = bj_nf2ff_2d_phasor(&ca, &cb, &ca, 20, 20, 0.001, 3, 8, &r4);
    var w5a = "invalid parameter: NF2FF phasor accumulators must share frequency and dt";
    assert(text_is(bj_last_error_display(), w5a) == 1, "the mismatch");
    var t5b, v5b = bj_nf2ff_2d_phasor(&ca, &ca, &ca, 20, 21, 0.001, 10, 8, &r4);
    var w5b = "invalid parameter: NF2FF box margin must be in 1..min(nx, ny)/2 for a 20x21 grid, got 10";
    assert(text_is(bj_last_error_display(), w5b) == 1, "the margin");
    var t5c, v5c = bj_nf2ff_2d_phasor(&ca, &ca, &cs, 20, 20, 0.001, 3, 8, &r4);
    var w5c = "invalid parameter: NF2FF field `hy` has 10 samples, need 20x20";
    assert(text_is(bj_last_error_display(), w5c) == 1, "the short field named");
    var t5d, v5d = bj_nf2ff_2d_phasor(&cz, &cz, &cz, 20, 20, 0.001, 3, 8, &r4);
    var w5d = "invalid parameter: NF2FF frequency must be finite and positive, got 0";
    assert(text_is(bj_last_error_display(), w5d) == 1, "f = 0");
    var t5e, v5e = bj_nf2ff_2d_phasor(&ca, &ca, &ca, 0 - 1, 20, 0.001, 3, 8, &r4);
    var w5e = "invalid parameter: NF2FF field `ez` has 400 samples, need 18446744073709551615x20";
    assert(text_is(bj_last_error_display(), w5e) == 1, "nx·ny past 2^64 refused as too few samples, as checked_mul");

    test_group("cyrius_nf2ff_angles_and_zero_field");
    var t6, v6 = bj_nf2ff_2d_phasor(&ca, &ca, &ca, 20, 20, 0.001, 3, 4, &r4);
    assert(is_ok(t6) == 1 && r4.count == 4, "4 angles");
    var a0: f64 = at(r4.angles, 0);
    var a1: f64 = at(r4.angles, 1);
    var a2: f64 = at(r4.angles, 2);
    assert(a0 == 0.0 && a1 == PI / 2.0 && a2 == PI, "0, π/2, π: 2π·i/4");
    var p0: f64 = at(r4.pattern, 0);
    var p3: f64 = at(r4.pattern, 3);
    assert(p0 == 0.0 && p3 == 0.0, "an all-zero field radiates nothing");
    BjNf2ffResult_free(&r4);
    assert(r4.count == 0 && r4.pattern == 0, "freed and emptied");
    BjCwAccumulator_free(&ca);
    BjCwAccumulator_free(&cb);
    BjCwAccumulator_free(&cs);
    BjCwAccumulator_free(&cz);

    # ADR 0002 row 17 (M5 part 2c): the accumulators' agreement on the decimal 10⁻¹². With dt = (4504·10¹² − 1)·2^-1042
    # against dt − 4504·2^-1042, 1e-12·dt rounds up on the subnormal grid and Rust took them as equal.
    test_group("cyrius_nf2ff_agreement_exact");
    var qa: BjCwAccumulator;
    var qb: BjCwAccumulator;
    var tqa, vqa = BjCwAccumulator_new(400, 1000000000.0, _bj_from_bits(0x210005d38117fff), &qa);
    var tqb, vqb = BjCwAccumulator_new(400, 1000000000.0, _bj_from_bits(0x210005d38116e67), &qb);
    var r6: BjNf2ffResult;
    var t6, v6 = bj_nf2ff_2d_phasor(&qa, &qb, &qa, 20, 20, 0.001, 3, 8, &r6);
    assert(is_err_result(t6) == 1 && text_is(bj_last_error_display(), w5a) == 1,
      "10⁻¹² apart by a hair more than 10⁻¹²: refused (Rust's rounded test accepted)");
    var t6b, v6b = bj_nf2ff_2d_phasor(&qa, &qa, &qa, 20, 20, 0.001, 3, 8, &r6);
    assert(is_ok(t6b) == 1, "the same dt still agrees");
    BjNf2ffResult_free(&r6);
    BjCwAccumulator_free(&qa);
    BjCwAccumulator_free(&qb);

    # ADR 0002 row 18 (M5 part 2d-6): the transform at its range edges, on a 10 × 10 grid with margin 2 and 8 angles,
    # the fields the corpus's generators (tests/golden/fdtd.tsv's part 2d-6). Each value is validate.py's model, the
    # chain with an unbounded exponent (nf_eval18), by its bits.
    test_group("cyrius_nf2ff_range_edges");
    var ea: BjCwAccumulator;
    var eb: BjCwAccumulator;
    var ec: BjCwAccumulator;
    var r7: BjNf2ffResult;
    var f308: f64 = _bj_from_bits(0x7fe1ccf385ebc8a0);
    var h17: f64 = _bj_from_bits(0x7fee42d130773b76);
    var f106: f64 = _bj_from_bits(0x5614cc4476cf86f3);
    var dx200: f64 = _bj_from_bits(0x16687e92154ef7ac);
    # ω = 2π·10³⁰⁸ past DBL_MAX: Rust's ∞ − ∞ refused the accumulators as disagreeing; ω to 53 bits agrees.
    gen_acc(&ea, f308, 0.000000000001, 0);
    gen_acc(&eb, f308, 0.000000000001, 1);
    gen_acc(&ec, f308, 0.000000000001, 2);
    var t7a, v7a = bj_nf2ff_2d_phasor(&ea, &eb, &ec, 10, 10, 0.001, 2, 8, &r7);
    var p7a: f64 = at(r7.pattern, 0);
    assert(is_ok(t7a) == 1 && _bj_bits(p7a) == 0x5f1af42ba05d81b7, "ω past DBL_MAX transforms");
    BjNf2ffResult_free(&r7);
    BjCwAccumulator_free(&ea);
    BjCwAccumulator_free(&eb);
    BjCwAccumulator_free(&ec);
    # hx's ω past DBL_MAX against ez's 2π·10⁹: Rust's |6.28·10⁹ − ∞| ≤ 10⁻¹²·∞ passed them; they disagree.
    gen_acc(&ea, 1000000000.0, 0.000000000001, 0);
    gen_acc(&eb, f308, 0.000000000001, 1);
    gen_acc(&ec, 1000000000.0, 0.000000000001, 2);
    var t7b, v7b = bj_nf2ff_2d_phasor(&ea, &eb, &ec, 10, 10, 0.001, 2, 8, &r7);
    assert(is_err_result(t7b) == 1 && text_is(bj_last_error_display(), w5a) == 1, "an ω past DBL_MAX disagrees");
    BjCwAccumulator_free(&ea);
    BjCwAccumulator_free(&eb);
    BjCwAccumulator_free(&ec);
    # f = 2^-1074: Rust's k = 2π·f/c underflowed to 0, and the pattern with it; k ≈ 10⁻³³¹ to 53 bits.
    var ftiny: f64 = _bj_from_bits(1);
    gen_acc(&ea, ftiny, 0.000000000001, 0);
    gen_acc(&eb, ftiny, 0.000000000001, 1);
    gen_acc(&ec, ftiny, 0.000000000001, 2);
    var t7c, v7c = bj_nf2ff_2d_phasor(&ea, &eb, &ec, 10, 10, 0.001, 2, 8, &r7);
    var p7c: f64 = at(r7.pattern, 0);
    assert(is_ok(t7c) == 1 && _bj_bits(p7c) == 0x1d56603b13626428, "a subnormal frequency's pattern");
    BjNf2ffResult_free(&r7);
    BjCwAccumulator_free(&ea);
    BjCwAccumulator_free(&eb);
    BjCwAccumulator_free(&ec);
    # dt = DBL_MAX: ω·dt/2 past DBL_MAX, Rust's rotation NaN; its sine and cosine of the 53-bit angle.
    var dtmax: f64 = _bj_from_bits(0x7fefffffffffffff);
    gen_acc(&ea, 1000000000.0, dtmax, 0);
    gen_acc(&eb, 1000000000.0, dtmax, 1);
    gen_acc(&ec, 1000000000.0, dtmax, 2);
    var t7d, v7d = bj_nf2ff_2d_phasor(&ea, &eb, &ec, 10, 10, 0.001, 2, 8, &r7);
    var p7d: f64 = at(r7.pattern, 0);
    assert(is_ok(t7d) == 1 && _bj_bits(p7d) == 0x3fcfa353aae40995, "dt = DBL_MAX: a finite pattern");
    BjNf2ffResult_free(&r7);
    BjCwAccumulator_free(&ea);
    BjCwAccumulator_free(&eb);
    BjCwAccumulator_free(&ec);
    # H_x's two Yee samples 1.7·10³⁰⁸ each: Rust's sum ∞; their mean to 53 bits.
    gen_acc(&ea, 1000000000.0, 0.000000000001, 0);
    gen_acc(&eb, 1000000000.0, 0.000000000001, 1);
    gen_acc(&ec, 1000000000.0, 0.000000000001, 2);
    var hbr: *f64 = f64p(eb.real);
    var hbi: *f64 = f64p(eb.imag);
    hbr[14] = h17;
    hbi[14] = 0.5;
    hbr[24] = h17;
    hbi[24] = 0.5;
    var t7e, v7e = bj_nf2ff_2d_phasor(&ea, &eb, &ec, 10, 10, 0.001, 2, 8, &r7);
    var p7e: f64 = at(r7.pattern, 0);
    assert(is_ok(t7e) == 1 && _bj_bits(p7e) == 0x7fd4d2333ff6547b, "H's samples summing past DBL_MAX");
    BjNf2ffResult_free(&r7);
    BjCwAccumulator_free(&ea);
    BjCwAccumulator_free(&eb);
    BjCwAccumulator_free(&ec);
    # A constant real E = 10⁻¹⁰ and no H at f = 4.77·10¹⁰⁶, dx = 10⁻²⁰⁰: L's real parts cancel exactly, and its
    # imaginary parts are E·sin(k·ρ̂·ρ') products near 2.5·10⁻³¹⁰ with no partner to absorb them. Rust's subnormal
    # products put 300 ulps of noise on the pattern (alternating by angle); the unbounded chain's is one value.
    var t7z, v7z = BjCwAccumulator_new(100, f106, 0.000000000001, &ea);
    var t7y, v7y = BjCwAccumulator_new(100, f106, 0.000000000001, &eb);
    var cer: *f64 = f64p(ea.real);
    for (var k7 = 0; k7 < 100; k7 = k7 + 1) { cer[k7] = 0.0000000001; }
    var t7f, v7f = bj_nf2ff_2d_phasor(&ea, &eb, &eb, 10, 10, dx200, 2, 8, &r7);
    var p7f: f64 = at(r7.pattern, 0);
    var p7g: f64 = at(r7.pattern, 1);
    assert(is_ok(t7f) == 1 && _bj_bits(p7f) == 0x09c8d158dd06dd27 && _bj_bits(p7g) == 0x09c8d158dd06dd27,
      "unabsorbed underflowing products: one value at every angle");
    BjNf2ffResult_free(&r7);
    # The same with a unit imaginary E: each underflowing product beside a partner at least 2^-960, absorbed, so the
    # checked fast path keeps Rust's value.
    var cei: *f64 = f64p(ea.imag);
    for (var k8 = 0; k8 < 100; k8 = k8 + 1) { cei[k8] = 1.0; }
    var t7h, v7h = bj_nf2ff_2d_phasor(&ea, &eb, &eb, 10, 10, dx200, 2, 8, &r7);
    var p7h: f64 = at(r7.pattern, 0);
    assert(is_ok(t7h) == 1 && _bj_bits(p7h) == 0x1d69e46e621ad206, "absorbed underflows keep Rust's value");
    BjNf2ffResult_free(&r7);
    BjCwAccumulator_free(&ea);
    BjCwAccumulator_free(&eb);

    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
