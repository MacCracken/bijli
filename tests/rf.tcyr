# rf.tcyr — src/rf.cyr and src/touchstone.cyr (M4 parts 1a–1c): transmission lines, reflection and the losses, the
# Smith chart, matching, the array factors, (1b) the S-parameter matrices and (1c) Touchstone read and write.
#
# Every group named test_* is 1.2.0:src/rf.rs's test of that name, ported assertion for assertion (the ledger
# matches them by name). rf.rs was already in bijli's one convention, e^{+jωt} (ADR 0002 row 5), so nothing changes
# sign. The three tests of the deprecated input_impedance_lossless are n/a (ADR 0002 row 1):
# cyrius_input_impedance_real_loads checks their values through input_impedance_lossless_complex. The other cyrius_*
# groups pin the reasons' exact text, out left alone on an error, the lines' DC limits, the Smith chart's poles and
# signed zeros, the stub match's sort and its matched branch, and usize::MAX elements; (1b) ADR 0002 row 36 (BjSMatrix's
# shape fixed at construction: test_smatrix_inconsistent_does_not_panic is n/a), row 37 (z0_equal on finite values),
# the S-parameter reasons and the heap; (2a-1) ADR 0002 row 39, the stub match's cancellation-free root; (2a-2) row
# 17, the cascade's star product rounded once and its exact T22 test; (2a-3) row 17, S → Z rounded once; (2b) row
# 13, round once; (2c) row 17, the exact thresholds; (2d-1 to 2d-3a) row 18, the input impedance's, the lossy Z₀'s,
# γ's, the reflection coefficients', the Smith chart's, (2d-3b) the stub match's, (2d-4a, 2d-4b) the Touchstone
# reader's and writer's and (2d-5) the array factors' range edges.
# tests/golden/rf.tsv pins every function over its grid against Rust besides.

include "tests/lib.cyr"

var TOL: f64 = 0.000001;
var NAN: f64 = 0x7FF8000000000000;
var INF: f64 = 0x7FF0000000000000;

# |a − b| ≤ tol.
fn near(a: f64, b: f64, tol: f64): i64 {
    var d: f64 = f64_abs(a - b);
    if (d <= tol) { return 1; }
    return 0;
}

# Both parts of z within tol of (re, im). Mirrors the Rust tests' `close`.
fn close(z: BjComplex, re: f64, im: f64, tol: f64): i64 {
    if (near(z.re, re, tol) == 1 && near(z.im, im, tol) == 1) { return 1; }
    return 0;
}

# The value of an Ok(f64) Result (the caller tests is_ok first).
fn ok_f(t, v): f64 {
    var x: f64 = v;
    return x;
}

# 1 when the last error's Display text is a followed by b (a literal can't continue across lines).
fn reason_is2(a, b): i64 {
    var d = bj_last_error_display();
    var la = strlen(a);
    if (strlen(d) != la + strlen(b)) { return 0; }
    if (memeq(d, a, la) != 1) { return 0; }
    return memeq(d + la, b, strlen(b));
}

# 1 when (t, v) is Err(code) and the Display text is want.
fn err_is(t, v, code, want): i64 {
    if (is_err_result(t) != 1 || v != code) { return 0; }
    return reason_is2(want, "");
}

# 1 when the bits of a and b are equal (signed zeros told apart).
fn same(a: f64, b: f64): i64 {
    if (_bj_bits(a) == _bj_bits(b)) { return 1; }
    return 0;
}

# Z_in of a line into *z: 1 on Ok.
fn zin(z0: f64, re: f64, im: f64, beta: f64, length: f64, z: *BjComplex): i64 {
    var t, v = bj_input_impedance_lossless_complex(z0, BjComplex_new(re, im), beta, length, z);
    if (is_ok(t) == 1) { return 1; }
    return 0;
}

# 1 when bj_input_impedance_lossless_complex refuses.
fn zin_refused(z0: f64, re: f64, im: f64, beta: f64, length: f64): i64 {
    var z: BjComplex;
    var t, v = bj_input_impedance_lossless_complex(z0, BjComplex_new(re, im), beta, length, &z);
    if (is_err_result(t) == 1) { return 1; }
    return 0;
}

# 1 when a one-argument Result fn refuses x (0 vswr, 1 return_loss, 2 insertion_loss, 3 mismatch_loss).
fn loss_refused(which, x: f64): i64 {
    if (which == 0) {
        var t0, v0 = bj_vswr(x);
        if (is_err_result(t0) == 1) { return 1; }
        return 0;
    }
    if (which == 1) {
        var t1, v1 = bj_return_loss(x);
        if (is_err_result(t1) == 1) { return 1; }
        return 0;
    }
    if (which == 2) {
        var t2, v2 = bj_insertion_loss(x);
        if (is_err_result(t2) == 1) { return 1; }
        return 0;
    }
    var t3, v3 = bj_mismatch_loss(x);
    if (is_err_result(t3) == 1) { return 1; }
    return 0;
}

# 1 when bj_characteristic_impedance_lossless(l, c) refuses.
fn z0_refused(l: f64, c: f64): i64 {
    var t, v = bj_characteristic_impedance_lossless(l, c);
    if (is_err_result(t) == 1) { return 1; }
    return 0;
}

# 1 when bj_quarter_wave_transformer(z0, zl) refuses.
fn qw_refused(z0: f64, zl: f64): i64 {
    var t, v = bj_quarter_wave_transformer(z0, zl);
    if (is_err_result(t) == 1) { return 1; }
    return 0;
}

# 1 when bj_single_stub_match(zl, z0) refuses.
fn stub_refused(zl: f64, z0: f64): i64 {
    var w: f64[2];
    var t, v = bj_single_stub_match(zl, z0, &w);
    if (is_err_result(t) == 1) { return 1; }
    return 0;
}

# The Rust tests' Y(d) + Y_stub(ℓ) = Y₀ check with the tan form, for a load (rl, xl) on z0 and one solution (d, ℓ): 1
# when 0 ≤ d < ½, 0 < ℓ < ½ and both parts of Y are within 10⁻⁹ of (Y₀, 0).
fn stub_matches(rl: f64, xl: f64, z0: f64, d: f64, l: f64): i64 {
    if (d < 0.0 || d >= 0.5 || l <= 0.0 || l >= 0.5) { return 0; }
    var y0: f64 = 1.0 / z0;
    var tau: f64 = 2.0 * _BJ_PI;
    var t: f64 = _bj_tan(tau * d);
    var j: BjComplex = BjComplex_new(0.0, 1.0);
    var zl: BjComplex = BjComplex_new(rl, xl);
    var jt: BjComplex = j.scale(z0 * t);
    var num: BjComplex = BjComplex_add(zl, jt);
    var jz: BjComplex = BjComplex_mul(j, zl);
    var jzt: BjComplex = jz.scale(t);
    var den: BjComplex = BjComplex_add(BjComplex_from_real(z0), jzt);
    var q: BjComplex = BjComplex_div(num, den);
    var z_in: BjComplex = q.scale(z0);
    var y_line: BjComplex = BjComplex_div(BjComplex_from_real(1.0), z_in);
    var tl: f64 = _bj_tan(tau * l);
    var y_stub: BjComplex = BjComplex_new(0.0, -y0 / tl);
    var y: BjComplex = BjComplex_add(y_line, y_stub);
    return close(y, y0, 0.0, 0.000000001);
}

# rf.rs's transmission-line tests.
fn rust_tests_a(): i64 {
    var z: BjComplex;
    test_group("test_z0_lossless");
    var t1, v1 = bj_characteristic_impedance_lossless(0.00000025, 0.0000000001);
    var z0: f64 = ok_f(t1, v1);
    assert(is_ok(t1) == 1 && near(z0, 50.0, 0.1) == 1, "coax L' = 250 nH/m, C' = 100 pF/m: Z₀ = 50 Ω");

    test_group("test_z0_invalid");
    assert(z0_refused(-1.0, 0.0000000001) == 1 && z0_refused(0.00000025, 0.0) == 1, "L' < 0, C' = 0");
    var t2, v2 = bj_phase_velocity(NAN, 0.0000000001);
    assert(z0_refused(NAN, 0.0000000001) == 1 && is_err_result(t2) == 1, "NaN L'");

    test_group("test_phase_velocity");
    var t3, v3 = bj_phase_velocity(0.00000025, 0.0000000001);
    var vp: f64 = ok_f(t3, v3);
    assert(is_ok(t3) == 1 && vp > 100000000.0 && vp < 300000000.0, "1/√(L'C') ≈ 2·10⁸ m/s");

    test_group("test_input_impedance_complex_eighth_wave");
    assert(zin(50.0, 100.0, 0.0, 1.0, _BJ_PI / 4.0, &z) == 1 && close(z, 40.0, -30.0, 0.000000001) == 1,
      "Z₀ = 50, Z_L = 100, βl = π/4: 40 − j30");

    test_group("test_input_impedance_complex_load");
    var tau: f64 = 2.0 * _BJ_PI;
    assert(zin(50.0, 30.0, 40.0, tau, 0.3, &z) == 1 && close(z, 20.404995607197357, -22.010650955158418,
        0.000000001) == 1, "Z_L = 30 + j40, βl = 0.6π");

    test_group("test_input_impedance_short_quarter_wave_is_unbounded");
    var t4, v4 = bj_input_impedance_lossless_complex(50.0, bj_complex_zero(), tau, 0.25, &z);
    assert(is_err_result(t4) == 1 && v4 == BJ_ERR_DIVISION_BY_ZERO, "a shorted λ/4 line: DivisionByZero");

    test_group("test_input_impedance_complex_invalid");
    assert(zin_refused(0.0, 50.0, 0.0, 1.0, 1.0) == 1 && zin_refused(NAN, 50.0, 0.0, 1.0, 1.0) == 1, "Z₀ = 0, NaN");
    assert(zin_refused(50.0, NAN, 0.0, 1.0, 1.0) == 1 && zin_refused(50.0, 50.0, 0.0, INF, 1.0) == 1,
      "a NaN load, an infinite β");

    test_group("test_lossy_z0_dc_limits");
    var w1: BjComplex = bj_characteristic_impedance_lossy(0.0, 0.00000025, 0.0, 0.0000000001, 0.0);
    assert(close(w1, 50.0, 0.0, 0.000000001) == 1, "R = G = ω = 0: √(L/C) = 50 Ω");
    var w2: BjComplex = bj_characteristic_impedance_lossy(1.0, 0.00000025, 0.0, 0.0000000001, 0.0);
    var w2r: f64 = w2.re;
    assert(w2r == INF, "R > 0, G = ω = 0: |Z₀| → ∞");
    var w3: BjComplex = bj_characteristic_impedance_lossy(4.0, 0.00000025, 1.0, 0.0000000001, 0.0);
    assert(close(w3, 2.0, 0.0, 0.000000000001) == 1, "G > 0 at DC: √(R/G)");

    test_group("test_propagation_constant_lossless");
    var g: BjComplex = bj_propagation_constant(0.0, 0.00000025, 0.0, 0.0000000001, 2000000000.0 * _BJ_PI);
    var gr: f64 = f64_abs(g.re);
    var gi: f64 = g.im;
    assert(gr < 0.001 && gi > 0.0, "R = G = 0: γ = jω√(LC), α ≈ 0, β > 0");

    test_group("test_characteristic_impedance_lossy_approaches_lossless");
    var omega: f64 = 2000000000.0 * _BJ_PI;
    var zy: BjComplex = bj_characteristic_impedance_lossy(0.001, 0.00000025, 0.000001, 0.0000000001, omega);
    var t5, v5 = bj_characteristic_impedance_lossless(0.00000025, 0.0000000001);
    var zll: f64 = ok_f(t5, v5);
    var dre: f64 = f64_abs(zy.re - zll) / zll;
    var zyi: f64 = f64_abs(zy.im);
    assert(dre < 0.01 && zyi < 1.0, "tiny R and G: Z₀ ≈ √(L/C), a small imaginary part");
    return 0;
}

# rf.rs's reflection, loss and Smith chart tests.
fn rust_tests_b(): i64 {
    var z: BjComplex;
    test_group("test_reflection_matched");
    var t1, v1 = bj_reflection_coefficient(50.0, 50.0);
    var g1: f64 = ok_f(t1, v1);
    assert(is_ok(t1) == 1 && near(g1, 0.0, TOL) == 1, "Γ = 0");

    test_group("test_reflection_open");
    var t2, v2 = bj_reflection_coefficient(1000000000000000.0, 50.0);
    var g2: f64 = ok_f(t2, v2);
    assert(is_ok(t2) == 1 && near(g2, 1.0, 0.001) == 1, "Z_L → ∞: Γ = 1");

    test_group("test_reflection_short");
    var t3, v3 = bj_reflection_coefficient(0.0, 50.0);
    var g3: f64 = ok_f(t3, v3);
    assert(is_ok(t3) == 1 && near(g3, -1.0, TOL) == 1, "Z_L = 0: Γ = −1");

    test_group("test_reflection_nan_rejected");
    var t4, v4 = bj_reflection_coefficient(NAN, 50.0);
    var t5, v5 = bj_reflection_coefficient_complex(BjComplex_new(NAN, 0.0), bj_complex_real(50.0), &z);
    assert(is_err_result(t4) == 1 && is_err_result(t5) == 1, "a NaN load is refused");

    test_group("test_vswr_matched");
    var t6, v6 = bj_vswr(0.0);
    var s6: f64 = ok_f(t6, v6);
    assert(is_ok(t6) == 1 && near(s6, 1.0, TOL) == 1, "|Γ| = 0: VSWR 1");

    test_group("test_vswr_2_to_1");
    var t7, v7 = bj_vswr(1.0 / 3.0);
    var s7: f64 = ok_f(t7, v7);
    assert(is_ok(t7) == 1 && near(s7, 2.0, TOL) == 1, "|Γ| = 1/3: VSWR 2");

    test_group("test_vswr_invalid");
    assert(loss_refused(0, 1.0) == 1 && loss_refused(0, -0.1) == 1 && loss_refused(0, NAN) == 1, "1, −0.1, NaN");

    test_group("test_return_loss");
    var t8, v8 = bj_return_loss(0.1);
    var r8: f64 = ok_f(t8, v8);
    var t9, v9 = bj_return_loss(1.0);
    var r9: f64 = ok_f(t9, v9);
    assert(is_ok(t8) == 1 && near(r8, 20.0, 0.01) == 1 && is_ok(t9) == 1 && near(r9, 0.0, TOL) == 1,
      "|Γ| = 0.1: 20 dB; total reflection: 0 dB");

    test_group("test_return_loss_invalid");
    assert(loss_refused(1, NAN) == 1 && loss_refused(1, 1.5) == 1, "NaN, 1.5");

    test_group("test_insertion_loss_matched");
    var t10, v10 = bj_insertion_loss(0.0);
    var i10: f64 = ok_f(t10, v10);
    assert(is_ok(t10) == 1 && near(i10, 0.0, TOL) == 1, "0 dB for a perfect match");

    test_group("test_insertion_loss_invalid");
    assert(loss_refused(2, NAN) == 1 && loss_refused(2, -0.5) == 1 && loss_refused(3, NAN) == 1, "NaN, −0.5");

    test_group("test_normalize_denormalize");
    var zn: BjComplex = BjComplex_new(100.0, 50.0);
    var t11, v11 = bj_normalize_impedance(zn, 50.0, &z);
    var back: BjComplex = bj_denormalize_impedance(z, 50.0);
    assert(is_ok(t11) == 1 && close(back, 100.0, 50.0, TOL) == 1, "Z/Z₀·Z₀ = Z");

    test_group("test_gamma_z_roundtrip");
    var gz: BjComplex = bj_gamma_from_z(BjComplex_new(2.0, 1.0));
    var zb: BjComplex = bj_z_from_gamma(gz);
    assert(close(zb, 2.0, 1.0, TOL) == 1, "z → Γ → z");

    test_group("test_gamma_matched");
    var gm: BjComplex = bj_gamma_from_z(bj_complex_real(1.0));
    var gmn: f64 = gm.norm();
    assert(gmn < TOL, "z = 1: Γ = 0");

    test_group("test_smith_poles_are_infinite_not_nan");
    var gp: BjComplex = bj_gamma_from_z(bj_complex_real(-1.0));
    var gpr: f64 = gp.re;
    var gpi: f64 = gp.im;
    assert(gpr == INF && gpi == gpi, "z = −1: Γ = +∞, not NaN");
    var zp: BjComplex = bj_z_from_gamma(bj_complex_real(1.0));
    var zpr: f64 = zp.re;
    var zpi: f64 = zp.im;
    assert(zpr == INF && zpi == zpi, "Γ = 1: z = +∞, not NaN");
    var gb: BjComplex = bj_gamma_from_z(zp);
    var zg: BjComplex = bj_z_from_gamma(gp);
    assert(close(gb, 1.0, 0.0, 0.0) == 1 && close(zg, -1.0, 0.0, 0.0) == 1, "z = ∞ ↔ Γ = 1, Γ = ∞ ↔ z = −1");

    test_group("test_normalize_zero_z0");
    var t12, v12 = bj_normalize_impedance(BjComplex_new(50.0, 0.0), 0.0, &z);
    var t13, v13 = bj_normalize_impedance(BjComplex_new(50.0, 0.0), NAN, &z);
    assert(is_err_result(t12) == 1 && is_err_result(t13) == 1, "Z₀ = 0, NaN");

    test_group("test_reflection_coefficient_complex_matched");
    var zz: BjComplex = BjComplex_new(50.0, 0.0);
    var t14, v14 = bj_reflection_coefficient_complex(zz, zz, &z);
    var zm: f64 = z.norm();
    assert(is_ok(t14) == 1 && zm < TOL, "Z_L = Z₀: Γ = 0");

    test_group("test_return_loss_zero_gamma");
    assert(loss_refused(1, 0.0) == 1, "|Γ| = 0: an infinite return loss is refused");

    test_group("test_insertion_loss_total_reflection");
    assert(loss_refused(2, 1.0) == 1, "|Γ| = 1 is refused");

    test_group("test_feature_gate_rf_compiles_alone");
    var t15, v15 = bj_reflection_coefficient(75.0, 50.0);
    assert(is_ok(t15) == 1, "rf's functions link alone");
    return 0;
}

# rf.rs's matching and array tests.
fn rust_tests_c(): i64 {
    var w: f64[4];
    test_group("test_quarter_wave_transformer");
    var t1, v1 = bj_quarter_wave_transformer(50.0, 100.0);
    var zt: f64 = ok_f(t1, v1);
    assert(is_ok(t1) == 1 && near(zt, 70.71, 0.01) == 1, "√(50·100) ≈ 70.71 Ω");

    test_group("test_quarter_wave_both_negative");
    assert(qw_refused(-50.0, -100.0) == 1 && qw_refused(50.0, 0.0) == 1 && qw_refused(NAN, 100.0) == 1,
      "negative, zero, NaN");

    test_group("test_quarter_wave_negative");
    assert(qw_refused(-50.0, 100.0) == 1, "Z₀ < 0");

    test_group("test_single_stub_already_matched");
    var t2, v2 = bj_single_stub_match(50.0, 50.0, &w);
    assert(is_ok(t2) == 1 && near(w[0], 0.0, TOL) == 1 && near(w[1], 0.25, TOL) == 1, "(0, λ/4): no stub");

    test_group("test_single_stub_real_load_reference");
    var t3, v3 = bj_single_stub_match(100.0, 50.0, &w);
    assert(is_ok(t3) == 1 && near(w[0], 0.1520433619923482, 0.000000001) == 1, "100 Ω on 50 Ω: d");
    assert(near(w[1], 0.1520433619923482, 0.000000001) == 1, "100 Ω on 50 Ω: ℓ");
    var t4, v4 = bj_single_stub_match(25.0, 50.0, &w);
    assert(is_ok(t4) == 1 && near(w[0], 0.09795663800765184, 0.000000001) == 1, "25 Ω on 50 Ω: d");
    assert(near(w[1], 0.3479566380076518, 0.000000001) == 1, "25 Ω on 50 Ω: ℓ");

    test_group("test_single_stub_pozar_example");
    var t5, v5 = bj_single_stub_match_complex(BjComplex_new(60.0, -80.0), 50.0, &w);
    assert(is_ok(t5) == 1 && near(w[0], 0.11042321863830029, 0.000000001) == 1, "d₁ = 0.110λ");
    assert(near(w[1], 0.09497462163589147, 0.000000001) == 1, "ℓ₁ = 0.095λ");
    assert(near(w[2], 0.2594445306228258, 0.000000001) == 1, "d₂ = 0.260λ");
    assert(near(w[3], 0.4050253783641085, 0.000000001) == 1, "ℓ₂ = 0.405λ");

    test_group("test_single_stub_admittance_is_matched");
    var loads: f64[10];
    loads[0] = 100.0;
    loads[1] = 0.0;
    loads[2] = 25.0;
    loads[3] = 0.0;
    loads[4] = 60.0;
    loads[5] = -80.0;
    loads[6] = 50.0;
    loads[7] = 50.0;
    loads[8] = 10.0;
    loads[9] = 120.0;
    var good = 0;
    for (var k = 0; k < 5; k = k + 1) {
        var rl: f64 = loads[2 * k];
        var xl: f64 = loads[2 * k + 1];
        var t6, v6 = bj_single_stub_match_complex(BjComplex_new(rl, xl), 50.0, &w);
        if (is_ok(t6) == 1 && stub_matches(rl, xl, 50.0, w[0], w[1]) == 1 && stub_matches(rl, xl, 50.0, w[2],
            w[3]) == 1) {
            good = good + 1;
        }
    }
    assert(good == 5, "Y(d) + Y_stub(ℓ) = Y₀ for both solutions of five loads");

    test_group("test_single_stub_invalid");
    assert(stub_refused(-100.0, 50.0) == 1 && stub_refused(100.0, 0.0) == 1 && stub_refused(NAN, 50.0) == 1,
      "a negative load, Z₀ = 0, a NaN load");
    var t7, v7 = bj_single_stub_match_complex(BjComplex_new(0.0, 30.0), 50.0, &w);
    assert(is_err_result(t7) == 1, "a purely reactive load");

    test_group("test_linear_array_broadside");
    var tau: f64 = 2.0 * _BJ_PI;
    var a1: f64 = bj_linear_array_factor(4, 0.5, tau, 0.0, _BJ_PI / 2.0);
    assert(near(a1, 1.0, TOL) == 1, "β = 0: the peak at θ = 90°");

    test_group("test_linear_array_single_element");
    var a2: f64 = bj_linear_array_factor(1, 0.5, 10.0, 0.0, 0.5);
    assert(near(a2, 1.0, TOL) == 1, "one element: 1");

    test_group("test_linear_array_zero_elements");
    var a3: f64 = bj_linear_array_factor(0, 0.5, 10.0, 0.0, 0.5);
    assert(near(a3, 0.0, TOL) == 1, "no element: 0");

    test_group("test_circular_array_single");
    var c1: f64 = bj_circular_array_factor(1, 0.5, 10.0, 0.5, 0.0, 0.0);
    assert(near(c1, 1.0, TOL) == 1, "one element: 1");

    test_group("test_circular_array_broadside_peak");
    var c2: f64 = bj_circular_array_factor(8, 0.25, tau, 0.0, 0.0, 0.0);
    assert(near(c2, 1.0, TOL) == 1, "β = 0: every element in phase at θ = 0");

    test_group("test_planar_array_nonzero");
    var p1: f64 = bj_planar_array_factor(4, 4, 0.5, 0.5, tau, 0.0, 0.0, 0.3, 0.5);
    assert(p1 > 0.0 && p1 <= 1.0, "a finite value in (0, 1]");

    test_group("test_linear_array_factor_bounded");
    var inside = 0;
    for (var i = 0; i < 100; i = i + 1) {
        var th: f64 = f64_from(i) * _BJ_PI / 100.0;
        var af: f64 = bj_linear_array_factor(8, 0.5, tau, 0.0, th);
        if (af >= -TOL && af <= 1.0 + TOL) { inside = inside + 1; }
    }
    assert(inside == 100, "AF ∈ [0, 1] over θ ∈ [0, π)");
    return 0;
}

# The deprecated input_impedance_lossless's three tests (n/a, ADR 0002 row 1), checked through the complex form.
fn cyrius_deprecated(): i64 {
    var z: BjComplex;
    test_group("cyrius_input_impedance_real_loads (ADR 0002 row 1)");
    var tau: f64 = 2.0 * _BJ_PI;
    assert(zin(50.0, 50.0, 0.0, 10.0, 0.1, &z) == 1 && close(z, 50.0, 0.0, 0.01) == 1,
      "a matched load: Z_in = Z₀ at any length (test_input_impedance_matched)");
    assert(zin(50.0, 100.0, 0.0, tau, 0.25, &z) == 1 && close(z, 25.0, 0.0, 0.1) == 1,
      "a λ/4 transformer: Z₀²/Z_L = 25 Ω (test_input_impedance_quarter_wave)");
    var zi: f64 = f64_abs(z.im);
    assert(zi < 0.0000001, "the λ/4 value is real to rounding");
    assert(zin(50.0, 100.0, 0.0, 1.0, _BJ_PI / 4.0, &z) == 1 && close(z, 40.0, -30.0, 0.000000001) == 1,
      "βl = π/4: 40 − j30, complex (test_input_impedance_real_rejects_complex_result)");
    return 0;
}

# The reasons' exact text and out left alone on an error.
fn cyrius_errors(): i64 {
    var z: BjComplex = BjComplex_new(7.0, 8.0);
    var w: f64[4];
    test_group("cyrius_rf_reasons");
    var t1, v1 = bj_characteristic_impedance_lossless(-1.0, 0.0000000001);
    assert(err_is(t1, v1, BJ_ERR_INVALID_PARAMETER,
        "invalid parameter: L' and C' must be finite and positive, got L'=-1, C'=0.0000000001") == 1, "Z₀'s values");
    var t2, v2 = bj_phase_velocity(0.0, 1.0);
    assert(err_is(t2, v2, BJ_ERR_INVALID_PARAMETER, "invalid parameter: L' and C' must be finite and positive") == 1,
      "v_p's text has no values");
    var t3, v3 = bj_input_impedance_lossless_complex(50.0, BjComplex_new(NAN, -1.0), 1.0, 1.0, &z);
    assert(err_is(t3, v3, BJ_ERR_INVALID_PARAMETER, "invalid parameter: Z_L must be finite, got NaN-1i") == 1,
      "Z_L in Complex's Display form");
    var t4, v4 = bj_input_impedance_lossless_complex(50.0, bj_complex_real(1.0), INF, 0.0, &z);
    assert(err_is(t4, v4, BJ_ERR_INVALID_PARAMETER,
        "invalid parameter: electrical length βl must be finite, got β=inf, l=0") == 1, "∞·0 is NaN");
    var t5, v5 = bj_input_impedance_lossless_complex(-0.0, bj_complex_real(1.0), 1.0, 1.0, &z);
    assert(err_is(t5, v5, BJ_ERR_INVALID_PARAMETER, "invalid parameter: Z₀ must be finite and positive, got -0") == 1,
      "require_positive_finite's text");
    var t6, v6 = bj_input_impedance_lossless_complex(50.0, bj_complex_zero(), 2.0 * _BJ_PI, 0.25, &z);
    assert(reason_is2("division by zero in EM calculation: transmission line input impedance is unbounded ",
        "(Z₀cos βl + jZ_L sin βl = 0)") == 1 && v6 == BJ_ERR_DIVISION_BY_ZERO, "the unbounded Z_in");
    var t7, v7 = bj_reflection_coefficient(5.0, -5.0);
    assert(err_is(t7, v7, BJ_ERR_DIVISION_BY_ZERO, "division by zero in EM calculation: Z_L + Z₀ = 0") == 1,
      "Z_L + Z₀ = 0");
    var t8, v8 = bj_reflection_coefficient_complex(BjComplex_new(1.0, INF), bj_complex_real(50.0), &z);
    assert(err_is(t8, v8, BJ_ERR_INVALID_PARAMETER,
        "invalid parameter: Z_L and Z₀ must be finite, got Z_L=1+infi, Z₀=50+0i") == 1, "both in Display form");
    var t9, v9 = bj_vswr(-0.5);
    assert(err_is(t9, v9, BJ_ERR_INVALID_PARAMETER, "invalid parameter: |Γ| must be ≥ 0, got -0.5") == 1, "vswr");
    var t10, v10 = bj_insertion_loss(1.0);
    assert(err_is(t10, v10, BJ_ERR_INVALID_PARAMETER,
        "invalid parameter: total reflection — infinite insertion loss") == 1, "insertion loss at |Γ| = 1");
    var t11, v11 = bj_mismatch_loss(NAN);
    assert(err_is(t11, v11, BJ_ERR_INVALID_PARAMETER, "invalid parameter: |Γ| must be in [0, 1), got NaN") == 1,
      "mismatch loss is insertion loss");
    var t12, v12 = bj_return_loss(0.0);
    assert(err_is(t12, v12, BJ_ERR_INVALID_PARAMETER,
        "invalid parameter: |Γ| must be in (0, 1] for return loss, got 0") == 1, "return loss");
    var t13, v13 = bj_normalize_impedance(bj_complex_real(1.0), 0.000000000000000000000000000000999, &z);
    assert(err_is(t13, v13, BJ_ERR_DIVISION_BY_ZERO,
        "division by zero in EM calculation: reference impedance Z₀ cannot be zero") == 1, "|Z₀| < 10⁻³⁰");
    var t14, v14 = bj_quarter_wave_transformer(50.0, -0.0);
    assert(err_is(t14, v14, BJ_ERR_INVALID_PARAMETER,
        "invalid parameter: Z₀ and Z_L must be finite and positive for a quarter-wave transformer, got Z₀=50, Z_L=-0")
      == 1, "the transformer");
    var t15, v15 = bj_single_stub_match(INF, 50.0, &w);
    assert(err_is(t15, v15, BJ_ERR_INVALID_PARAMETER, "invalid parameter: Z_L must be finite and positive, got inf")
      == 1, "the real stub checks Z_L first");
    var t16, v16 = bj_single_stub_match_complex(BjComplex_new(-0.0, 30.0), 50.0, &w);
    assert(err_is(t16, v16, BJ_ERR_INVALID_PARAMETER,
        "invalid parameter: load resistance must be positive for a stub match, got -0") == 1, "R_L ≤ 0");
    var zr: f64 = z.re;
    var zi: f64 = z.im;
    assert(zr == 7.0 && zi == 8.0, "out is untouched by every error");
    return 0;
}

# The DC limits, the Smith chart's poles and signed zeros, the stub's matched branch and sort, usize::MAX elements.
fn cyrius_values(): i64 {
    var w: f64[4];
    test_group("cyrius_rf_values");
    var a: BjComplex = bj_characteristic_impedance_lossy(-1.0, 0.00000025, 0.0, 0.0000000001, 0.0);
    var ar: f64 = a.re;
    assert(ar != ar, "R < 0 at DC: NaN parts");
    var b: BjComplex = bj_characteristic_impedance_lossy(1.0, 0.00000025, 0.0, 0.0000000001, 0.0);
    var bi: f64 = b.im;
    assert(bi == -INF, "R > 0 at DC: +∞ − j∞");
    var c: BjComplex = bj_characteristic_impedance_lossy(0.0, 0.00000025, 0.0, 0.0, 0.0);
    var cr: f64 = c.re;
    assert(cr != cr, "C' = 0 at DC: NaN parts");
    var g1: BjComplex = bj_gamma_from_z(BjComplex_new(INF, NAN));
    var g1r: f64 = g1.re;
    assert(g1r != g1r, "a NaN part wins over an infinite one");
    var g2: BjComplex = bj_gamma_from_z(BjComplex_new(5.0, -INF));
    assert(close(g2, 1.0, 0.0, 0.0) == 1, "an infinite part is an open circuit");
    var g3: BjComplex = bj_z_from_gamma(BjComplex_new(1.0, -0.0));
    var g3r: f64 = g3.re;
    var g3i: f64 = g3.im;
    assert(g3r == INF && same(g3i, 0.0) == 1, "Γ = 1 − j0: +∞ + j0 (the pole's im is +0)");
    var g4: BjComplex = bj_gamma_from_z(BjComplex_new(0.0, -0.0));
    var g4r: f64 = g4.re;
    var g4i: f64 = g4.im;
    assert(g4r == -1.0 && same(g4i, 0.0) == 1, "z = 0 − j0: Γ = −1 + j0 (Smith's −0 − (−1)·0 is +0, as Rust's)");
    var dn: BjComplex = bj_denormalize_impedance(BjComplex_new(0.5, -0.25), 50.0);
    assert(close(dn, 25.0, -12.5, 0.0) == 1, "denormalize: z·Z₀");

    var t1, v1 = bj_single_stub_match_complex(BjComplex_new(50.0, 25.0), 50.0, &w);
    var t0: f64 = -25.0 / 100.0;
    var dw: f64 = _bj_atan(t0) / (2.0 * _BJ_PI) + 0.5;
    assert(is_ok(t1) == 1 && w[0] == 0.25 && w[2] == dw, "R_L = Z₀: d = λ/4 and atan(−X/2Z₀)/2π + ½, sorted");
    var t2, v2 = bj_single_stub_match_complex(BjComplex_new(50.0, -25.0), 50.0, &w);
    var dw2: f64 = _bj_atan(0.25) / (2.0 * _BJ_PI);
    assert(is_ok(t2) == 1 && w[0] == dw2 && w[2] == 0.25, "X < 0: the atan solution first");

    var big: f64 = bj_linear_array_factor(0 - 1, 0.5, 2.0 * _BJ_PI, 0.0, 0.7);
    assert(big >= 0.0 && big <= 1.0, "usize::MAX elements: N = 2^64 as an f64");
    return 0;
}

# ADR 0002 row 39 (M4 part 2a-1): the stub match's cancelling root without its cancellation. Rust's
# (X_L ∓ disc)/(R_L − Z₀) lost about 2^-53·Z₀/|R_L − Z₀| of the root as R_L → Z₀; the port's
# N/(Z₀(X_L ± disc)), N = R_L(Z₀ − R_L) − X_L² exact, is within 2 ulps of the exact root on every golden row. The
# values are validate.py's model of the port on MPFR's atan and atan2; Rust's are in the messages.
fn cyrius_stub_root(): i64 {
    test_group("cyrius_stub_root");
    var w: f64[4];
    var t1, v1 = bj_single_stub_match_complex(BjComplex_new(50.0000005, 30.0), 50.0, &w);
    assert(is_ok(t1) == 1 && w[0] == 0.24999999867370884 && w[2] == 0.4536132093538582
      && w[3] == 0.33601043446023826, "X_L > 0, R_L = Z₀(1 + 10⁻⁸): d₂ (Rust's 0.45361320983863496)");
    var t2, v2 = bj_single_stub_match_complex(BjComplex_new(50.0000005, -30.0), 50.0, &w);
    assert(is_ok(t2) == 1 && w[0] == 0.046386790646141804 && w[1] == 0.1639895655397617
      && w[2] == 0.2500000013262912, "X_L < 0: d₁ (Rust's 0.04638679016136505)");
    var t3, v3 = bj_single_stub_match_complex(BjComplex_new(50.000000000075, 30.0), 50.0, &w);
    assert(is_ok(t3) == 1 && w[2] == 0.45361321046096276,
      "R_L = Z₀(1 + 1.5·10⁻¹²), just past the band: the root −0.30000000000113747 (Rust's −0.3)");
    var t4, v4 = bj_single_stub_match_complex(BjComplex_new(25.0, 25.0), 50.0, &w);
    assert(is_ok(t4) == 1 && same(w[0], 0.0) == 1 && w[1] == 0.375,
      "R_L(Z₀ − R_L) = X_L²: N = 0 exactly, d = +0 (the load's conductance is already Y₀)");
    var t5, v5 = bj_single_stub_match_complex(BjComplex_new(50.0, 30.0), 50.0, &w);
    assert(is_ok(t5) == 1 && w[0] == 0.25 && w[2] == 0.45361321046112885, "the band itself is Rust's limit");
    return 0;
}

# ADR 0002 row 17 (M4 part 2a-2): the cascade is Redheffer's star product, each part rounded once from the exact value,
# and its |T22|² < 10⁻⁶⁰ is decided exactly. The values are validate.py's exact model's; Rust's are in the messages.
fn cyrius_cascade_exact(): i64 {
    test_group("cyrius_cascade_exact");
    var a: BjSMatrix;
    var b: BjSMatrix;
    var c: BjSMatrix;
    tp_real(0.1, 0.9, 0.9, 0.1, 50.0, &a);
    var t1, v1 = a.cascade(&a, &c);
    var s11: BjComplex = c.s_at(0, 0);
    var s12: BjComplex = c.s_at(0, 1);
    var s21: BjComplex = c.s_at(1, 0);
    var s22: BjComplex = c.s_at(1, 1);
    assert(is_ok(t1) == 1 && s11.re == 0.18181818181818182 && s12.re == 0.8181818181818182 && s21.re == s12.re
      && s22.re == s11.re, "the bench thru with itself: 2/11, 9/11 rounded once, S12 = S21 (Rust's 2/11 2 ulps high)");
    var mz: f64 = -0.0;
    assert(same(s11.im, 0.0) == 1 && same(s22.im, mz) == 1, "an exact 0 keeps the sign of Rust's zero (S22's −0)");
    BjSMatrix_free(&c);
    BjSMatrix_free(&a);
    # A resonance: A22·B11 = 1 − 2^-40.
    var t21: f64 = 0.04471017781221601;
    tp_real(0.1, 0.7, t21, 0.999, 50.0, &a);
    sset(&a, 1, 1, BjComplex_new(0.1, -0.05));
    sset(&a, 1, 2, BjComplex_new(0.7, 0.2));
    tp_real(1.0010010010000907, 0.5, 0.0, -0.2, 50.0, &b);
    sset(&b, 1, 2, BjComplex_new(0.5, 0.5));
    sset(&b, 2, 1, BjComplex_new(0.0, t21));
    sset(&b, 2, 2, BjComplex_new(-0.2, 0.3));
    var t2, v2 = a.cascade(&b, &c);
    var r11: BjComplex = c.s_at(0, 0);
    var r22: BjComplex = c.s_at(1, 1);
    assert(is_ok(t2) == 1 && r11.re == 34450153110.64889 && r11.im == 9842900888.678255
      && r22.re == -24558062324.851547 && r22.im == 24558062324.95155,
      "D = 1 − A22·B11 ≈ 2^-40: S11 and S22 rounded once (Rust's 34450311015.771614, 4.6·10⁻⁶ off)");
    BjSMatrix_free(&c);
    BjSMatrix_free(&a);
    BjSMatrix_free(&b);
    # The threshold: D = 2^-40 exactly, A21 = 1, B21 = x; refused when x² > 10⁶⁰·2^-80.
    tp_real(0.1, 0.7, 1.0, 1.0, 50.0, &a);
    tp_real(0.9999999999990905, 0.5, 909494701772928100.0, -0.2, 50.0, &b);
    var t3, v3 = a.cascade(&b, &c);
    assert(is_ok(t3) == 1, "x one ulp below 2^-40·10³⁰: |T22|² ≥ 10⁻⁶⁰, accepted (Rust refused it)");
    BjSMatrix_free(&c);
    BjSMatrix_free(&b);
    tp_real(0.9999999999990905, 0.5, 909494701772928300.0, -0.2, 50.0, &b);
    var cc: BjSMatrix;
    cc.ports = 7;
    var t4, v4 = a.cascade(&b, &cc);
    var want4 = "division by zero in EM calculation: T22 = 0, cannot convert to S-parameters";
    assert(err_is(t4, v4, BJ_ERR_DIVISION_BY_ZERO, want4) == 1 && cc.ports == 0,
      "x past 2^-40·10³⁰: refused, out empty (2.0.1 H12)");
    BjSMatrix_free(&b);
    BjSMatrix_free(&a);
    # The exact path (S11 = 3·2^120, past the fast path's box) leaves the heap as it was.
    var fl0 = _fl_arena_pos;
    var bump0 = alloc_used();
    var big: f64 = _bj_from_bits(0x4788000000000000);
    for (var k = 0; k < 20; k = k + 1) {
        tp_real(0.1, 0.9, 0.9, 0.1, 50.0, &a);
        sset(&a, 1, 1, BjComplex_new(big, 0.0));
        var t5, v5 = a.cascade(&a, &c);
        if (is_ok(t5) == 1) { BjSMatrix_free(&c); }
        BjSMatrix_free(&a);
    }
    assert_eq(_fl_arena_pos, fl0, "the freelist's arena did not grow over 20 exact paths");
    assert_eq(alloc_used(), bump0, "nothing on the bump heap");
    return 0;
}

# ADR 0002 row 17 (M4 part 2a-3): S → Z with each part rounded once from the exact value, and |det(I − S)|² < 10⁻⁶⁰
# decided exactly. The values are validate.py's exact model's; Rust's are in the messages.
fn cyrius_s_to_z_exact(): i64 {
    test_group("cyrius_s_to_z_exact");
    var a: BjSMatrix;
    var z: BjComplex[4];
    var zp: *f64 = &z;
    tp_real(0.1, 0.9, 0.9, 0.1, 50.0, &a);
    var t1, v1 = bj_s_to_z(&a, &z);
    var big: f64 = -1801439850948198400.0;
    assert(is_ok(t1) == 1 && zp[0] == big && zp[2] == big && zp[4] == big && zp[6] == big && zp[1] == 0.0,
      "the bench network: its exact det is −5.0·10⁻¹⁷, Z = −1.8·10¹⁸ (Rust's rounded det cancelled to 0: refused)");
    BjSMatrix_free(&a);
    # A near-thru: S11 = −S22 = (2^-31, j2^-32), S12 = 1, S21 = 1 − 2^-31 + j2^-32.
    var e1: f64 = 0.0000000004656612873077392578125;
    var e2: f64 = 0.00000000023283064365386962890625;
    tp_real(0.0, 1.0, 0.9999999995343387126922607421875, 0.0, 50.0, &a);
    sset(&a, 1, 1, BjComplex_new(e1, e2));
    sset(&a, 2, 1, BjComplex_new(0.9999999995343387126922607421875, e2));
    sset(&a, 2, 2, BjComplex_new(-e1, e2));
    var t2, v2 = bj_s_to_z(&a, &z);
    assert(is_ok(t2) == 1 && zp[0] == 66076419927.51479 && zp[1] == 99114629973.9645 && zp[6] == 66076419865.97633,
      "det ≈ 2^-31: Z11 and Z22 rounded once (Rust's Z11 66076419942.3077, 2.2·10⁻¹⁰ off)");
    BjSMatrix_free(&a);
    tp_real(0.0, 1.0, 1.0, 0.0, 50.0, &a);
    zp[0] = 7.0;
    var t3, v3 = bj_s_to_z(&a, &z);
    assert(err_is(t3, v3, BJ_ERR_DIVISION_BY_ZERO, "division by zero in EM calculation: singular S→Z conversion") == 1
      && zp[0] == 7.0, "an ideal thru: det = 0 exactly, refused, out untouched");
    BjSMatrix_free(&a);
    tp_real(0.0, 0.0, 0.0, 0.0, 50.0, &a);
    var t4, v4 = bj_s_to_z(&a, &z);
    assert(is_ok(t4) == 1 && zp[0] == 50.0 && same(zp[1], 0.0) == 1 && same(zp[2], 0.0) == 1 && zp[6] == 50.0,
      "a matched 2-port: Z = Z₀·I, its zeros Rust's +0");
    BjSMatrix_free(&a);
    var fl0 = _fl_arena_pos;
    var bump0 = alloc_used();
    var huge: f64 = _bj_from_bits(0x4788000000000000);
    for (var k = 0; k < 20; k = k + 1) {
        tp_real(0.1, 0.5, 0.5, 0.2, 50.0, &a);
        sset(&a, 1, 2, BjComplex_new(huge, 0.0));
        var t5, v5 = bj_s_to_z(&a, &z);
        BjSMatrix_free(&a);
    }
    assert_eq(_fl_arena_pos, fl0, "the freelist's arena did not grow over 20 exact paths");
    assert_eq(alloc_used(), bump0, "nothing on the bump heap");
    return 0;
}

# ADR 0002 row 13 (M4 part 2b): √(L′/C′), 1/√(L′C′), √(Z₀·Z_L) and Z/Z₀ rounded once. Rust's values in the messages.
fn cyrius_round_once(): i64 {
    test_group("cyrius_round_once");
    var t1, v1 = bj_characteristic_impedance_lossless(0.00000033499999999999997, 0.0000000000715);
    var t2, v2 = bj_phase_velocity(0.00000033499999999999997, 0.0000000000715);
    assert(is_ok(t1) == 1 && ok_f(t1, v1) == 68.4493585456773 && ok_f(t2, v2) == 204326443.41993225,
      "a typical line: Z₀ and v_p correctly rounded (Rust's 68.44935854567728 and 204326443.41993222, an ulp low)");
    var e300: f64 = _bj_from_bits(0x7E37E43C8800759C);
    var em300: f64 = _bj_from_bits(0x01A56E1FC2F8F359);
    var e200: f64 = _bj_from_bits(0x6974E718D7D7625A);
    var em200: f64 = _bj_from_bits(0x16687E92154EF7AC);
    var t3, v3 = bj_characteristic_impedance_lossless(e300, em300);
    assert(ok_f(t3, v3) == e300, "√(10³⁰⁰/10⁻³⁰⁰) = 10³⁰⁰, where Rust's quotient overflowed to ∞");
    var t4, v4 = bj_phase_velocity(e200, e200);
    assert(ok_f(t4, v4) == em200, "1/√(10²⁰⁰·10²⁰⁰) = 10⁻²⁰⁰, where Rust's product overflowed (v_p = 0)");
    var t5, v5 = bj_quarter_wave_transformer(e200, e200);
    assert(ok_f(t5, v5) == e200, "√(10²⁰⁰·10²⁰⁰) = 10²⁰⁰ exactly (Rust's ∞)");
    var w: BjComplex;
    var t6, v6 = bj_normalize_impedance(BjComplex_new(5.0, 7.0), 3.0, &w);
    var wr: f64 = w.re;
    var wi: f64 = w.im;
    assert(is_ok(t6) == 1 && wr == 1.6666666666666667 && wi == 2.3333333333333335,
      "Z/Z₀ one division a part (Rust's 5·(1/3) = 1.6666666666666665 and 2.333333333333333)");
    return 0;
}

# ADR 0002 row 17 (M4 part 2c): rf's tests against 10⁻³⁰, 10⁻⁶⁰ and 10⁻¹² decided exactly. Each case is one where
# Rust's rounded test accepted.
fn cyrius_exact_thresholds(): i64 {
    test_group("cyrius_exact_thresholds");
    var want = "division by zero in EM calculation: Z_L + Z₀ = 0";
    var a: f64 = _bj_from_bits(0x39A4484BFEEBC29A);
    var b: f64 = _bj_from_bits(0x39A4484BFEEBC2A5);
    var t1, v1 = bj_reflection_coefficient(a, b);
    assert(err_is(t1, v1, BJ_ERR_DIVISION_BY_ZERO, want) == 1,
      "the exact Z_L + Z₀ lies below 10⁻³⁰, its rounding at the double 1e-30 (Rust's Γ = −1.2·10⁻¹⁵)");
    var x: f64 = _bj_from_bits(0x39A856C1984E1CAD);
    var y: f64 = _bj_from_bits(0x39B039D665896886);
    var g: BjComplex;
    var mz: f64 = -0.0;
    var t2, v2 = bj_reflection_coefficient_complex(BjComplex_new(x, y), BjComplex_new(mz, mz), &g);
    assert(err_is(t2, v2, BJ_ERR_DIVISION_BY_ZERO, want) == 1,
      "|Z_L + Z₀|² < 10⁻⁶⁰ exactly (Rust's rounded sum isn't: Γ = 1)");
    var m: BjSMatrix;
    var c: BjSMatrix;
    tp_real(0.1, 0.5, 0.0, 0.2, 50.0, &m);
    sset(&m, 2, 1, BjComplex_new(x, y));
    c.ports = 9;
    var t3, v3 = m.cascade(&m, &c);
    var want3 = "division by zero in EM calculation: S21 = 0, cannot convert to T-parameters";
    assert(err_is(t3, v3, BJ_ERR_DIVISION_BY_ZERO, want3) == 1 && c.ports == 0,
      "the same S21: |S21|² < 10⁻⁶⁰ exactly, refused, out empty (2.0.1 H12)");
    BjSMatrix_free(&m);
    var z0: f64 = _bj_from_bits(0x0210005D38117FFF);
    var z1: f64 = _bj_from_bits(0x0210005D38116E67);
    var m2: BjSMatrix;
    tp_real(0.1, 0.5, 0.5, 0.2, z0, &m);
    tp_real(0.1, 0.5, 0.5, 0.2, z1, &m2);
    var t4, v4 = m.cascade(&m2, &c);
    assert(is_err_result(t4) == 1 && v4 == BJ_ERR_INVALID_PARAMETER,
      "|Z₀ − Z₀′| just above 10⁻¹²·Z₀ at Z₀ ≈ 2^-990, where Rust's 1e-12·Z₀ rounds to the subnormal grid and accepted");
    BjSMatrix_free(&m);
    BjSMatrix_free(&m2);
    return 0;
}

# ADR 0002 row 18 (M4 part 2d-1): the input impedance at its range edges, Rust's chain with an unbounded exponent.
# Each case is one Rust refused; the values are validate.py's model's.
fn cyrius_zin_edges(): i64 {
    test_group("cyrius_zin_edges");
    var z: BjComplex;
    var e200: f64 = _bj_from_bits(0x6974E718D7D7625A);
    var em200: f64 = _bj_from_bits(0x16687E92154EF7AC);
    var t1, v1 = bj_input_impedance_lossless_complex(50.0, BjComplex_new(e200, e200), 1.0, 0.7, &z);
    var mz: f64 = -0.0;
    assert(is_ok(t1) == 1 && same(z.re, mz) == 1 && z.im == -59.362091606333976,
      "|Z_L| = 1.4·10²⁰⁰: −jZ₀cot βl (Rust's Z₀ + |Z_L| overflowed and refused it)");
    var t2, v2 = bj_input_impedance_lossless_complex(50.0, BjComplex_new(75.0, 25.0), e200, e200, &z);
    assert(is_ok(t2) == 1 && z.re == 60.708277492890204 && z.im == 29.95225230290311,
      "βl = 10⁴⁰⁰: its sine and cosine past DBL_MAX (Rust refused a non-finite βl)");
    var t3, v3 = bj_input_impedance_lossless_complex(em200, BjComplex_new(em200, em200), 1.0, 0.7, &z);
    var wr: f64 = _bj_from_bits(0x167C82B7492D449A);
    var wi: f64 = _bj_from_bits(0x9662676F1270F381);
    assert(is_ok(t3) == 1 && z.re == wr && z.im == wi, "impedances of 10⁻²⁰⁰, where |den|² underflowed (Rust refused)");
    var w: f64[4];
    var t4, v4 = bj_single_stub_match_complex(BjComplex_new(em200, em200), em200, &w);
    assert(is_ok(t4) == 1 && w[0] >= 0.0 && w[0] < 0.5 && w[2] >= w[0] && w[2] < 0.5,
      "the stub match at 10⁻²⁰⁰ Ω, through the same input impedance");
    var t5, v5 = bj_input_impedance_lossless_complex(50.0, BjComplex_new(75.0, 25.0), INF, 1.0, &z);
    assert(is_err_result(t5) == 1 && v5 == BJ_ERR_INVALID_PARAMETER, "a non-finite β is still refused");
    return 0;
}

# ADR 0002 row 18 (M4 part 2d-2): the lossy Z₀ and γ at their range edges, Rust's chain with an unbounded exponent.
# Rust gave NaN or ∞ in each; the values are validate.py's model's.
fn cyrius_lossy_edges(): i64 {
    test_group("cyrius_lossy_edges");
    var e300: f64 = _bj_from_bits(0x7E37E43C8800759C);
    var em300: f64 = _bj_from_bits(0x01A56E1FC2F8F359);
    var e200: f64 = _bj_from_bits(0x6974E718D7D7625A);
    var em200: f64 = _bj_from_bits(0x16687E92154EF7AC);
    var z1: BjComplex = bj_characteristic_impedance_lossy(0.1, e200, 0.0, 0.0000000001, e200);
    var w1r: f64 = _bj_from_bits(0x55BBE7ABD3781ECA);
    var w1i: f64 = _bj_from_bits(0x826A28EDC580E50E);
    assert(z1.re == w1r && z1.im == w1i, "ωL = 10⁴⁰⁰: Z₀ = 10¹⁰⁵ (Rust's ωL overflowed: NaN)");
    var z2: BjComplex = bj_characteristic_impedance_lossy(0.0, 0.00000025, 0.0, em200, em200);
    var w2r: f64 = _bj_from_bits(0x5402BA095DC7701D);
    assert(z2.re == w2r && same(z2.im, 0.0) == 1,
      "ωC = 10⁻⁴⁰⁰ is not DC: Z₀ = 5·10⁹⁶ (Rust's ωC underflowed to 0: NaN)");
    var z3: BjComplex = bj_characteristic_impedance_lossy(0.0, e300, 0.0, em300, 0.0);
    assert(z3.re == e300 && same(z3.im, 0.0) == 1,
      "DC, L′/C′ = 10⁶⁰⁰: √ = 10³⁰⁰ (Rust's quotient overflowed: ∞ + jNaN)");
    var g4: BjComplex = bj_propagation_constant(e200, e200, e200, e200, 1.0);
    var w4r: f64 = _bj_from_bits(0x6974E718D7D7625B);
    assert(g4.re == w4r && g4.im == e200, "γ = 10²⁰⁰(1 + j) (Rust's product overflowed: NaN)");
    var g5: BjComplex = bj_propagation_constant(0.1, 0.00000025, 0.000001, 0.0000000001, 2000000000.0);
    var g6: BjComplex = BjComplex_sqrt(BjComplex_mul(BjComplex_new(0.1, 500.0), BjComplex_new(0.000001, 0.2)));
    assert(g5.re == g6.re && g5.im == g6.im, "in range Rust's chain stays: hisab's √ of the product");
    return 0;
}

# ADR 0002 row 18 (M4 part 2d-3a): the reflection coefficients and the Smith chart at their range edges. Rust gave 0,
# ∞ or NaN in each; the values are validate.py's model's.
fn cyrius_smith_edges(): i64 {
    test_group("cyrius_smith_edges");
    var a: f64 = _bj_from_bits(0x7FEAB36D48E1ACF0);
    var b: f64 = _bj_from_bits(0x7FE1CCF385EBC8A0);
    var c: f64 = _bj_from_bits(0xFFE005419221015D);
    var t1, v1 = bj_reflection_coefficient(a, b);
    assert(ok_f(t1, v1) == 0.2, "Γ(1.5·10³⁰⁸, 10³⁰⁸) = 0.2 (Rust's Z_L + Z₀ overflowed: 0)");
    var t2, v2 = bj_reflection_coefficient(b, c);
    assert(ok_f(t2, v2) == 19.000000000000007, "Γ(10³⁰⁸, −0.9·10³⁰⁸) = 19 (Rust's Z_L − Z₀ overflowed: ∞)");
    var g: BjComplex;
    var t3, v3 = bj_reflection_coefficient_complex(BjComplex_new(b, b), BjComplex_new(b, -b), &g);
    assert(is_ok(t3) == 1 && same(g.re, 0.0) == 1 && g.im == 1.0, "complex sums past DBL_MAX: Γ = j (Rust's NaN)");
    var mx: f64 = _bj_from_bits(0x7FEFFFFFFFFFFFFF);
    var z: BjComplex = bj_gamma_from_z(BjComplex_new(mx, mx));
    assert(z.re == 1.0 && same(z.im, 0.0) == 1, "Γ of z = DBL_MAX(1 + j) is 1 (Rust's Smith d overflowed: NaN)");
    return 0;
}

# ADR 0002 row 18 (M4 part 2d-5): the array factors with an unbounded exponent where ψ or Nψ/2 passes DBL_MAX, where
# Rust took the sine of ∞. The values are validate.py's model's.
fn cyrius_array_factor_edges(): i64 {
    test_group("cyrius_array_factor_edges");
    var e300: f64 = _bj_from_bits(0x7E37E43C8800759C);
    var e200: f64 = _bj_from_bits(0x6974E718D7D7625A);
    var e20: f64 = 100000000000000000000.0;
    var a1: f64 = bj_linear_array_factor(4, e20, e300, 0.0, 1.5707963267948966);
    var w1: f64 = _bj_from_bits(0x3FD11D489315FC55);
    assert(a1 == w1, "kd = 10³²⁰ past DBL_MAX, ψ = kd·cos(π/2) = 6.1·10³⁰³ (Rust: NaN)");
    var a2: f64 = bj_linear_array_factor(10000000000, 1.0, e300, 0.0, 0.0);
    var w2: f64 = _bj_from_bits(0x3DDEF448CA9C32DF);
    assert(a2 == w2, "N = 10¹⁰, ψ = 10³⁰⁰: Nψ/2 past DBL_MAX (Rust: NaN)");
    var a3: f64 = bj_linear_array_factor(4, e200, e200, 0.0, 0.3);
    var w3: f64 = _bj_from_bits(0x3FE7097F81B21D11);
    assert(a3 == w3, "ψ = 10⁴⁰⁰·cos 0.3 past DBL_MAX, its sine by Payne–Hanek (Rust: NaN)");
    var e308: f64 = _bj_from_bits(0x7FE1CCF385EBC8A0);
    var a4: f64 = bj_circular_array_factor(3, 1.0, 1.0, 1.5707963267948966, 0.0, e308);
    var w4: f64 = _bj_from_bits(0x3FC71C4EB0B58633);
    assert(a4 == w4, "circular, β·2 = 2·10³⁰⁸ past DBL_MAX (Rust: NaN)");
    var inf: f64 = _bj_from_bits(0x7FF0000000000000);
    var a5: f64 = bj_linear_array_factor(4, 1.0, inf, 0.0, 0.3);
    assert(a5 != a5, "an infinite k keeps Rust's NaN");
    return 0;
}

# A 1-port's single entry re + j·im at 1 GHz, R 50, written in the format: 1 when its record line is want (a C
# string), 2 when the writer refuses it, 0 otherwise.
fn ts_write1(re: f64, im: f64, format, want): i64 {
    var d: BjTouchstoneData;
    var code: i64[1];
    if (ts_new(1, 50.0, 1, &d) != 0) { return 0; }
    var r = 0;
    if (ts_setf(&d, 0, 1000000000.0) + sset(d.matrix_at(0), 1, 1, BjComplex_new(re, im)) == 0) {
        var txt = ts_write(&d, format, &code);
        if (txt == 0 && code[0] == BJ_ERR_INVALID_PARAMETER) { r = 2; }
        if (txt != 0 && str_has(txt, want) == 1) { r = 1; }
    }
    BjTouchstoneData_free(&d);
    return r;
}

# ADR 0002 row 18 (M4 part 2d-4b): the Touchstone writer's |S|, its dB and arg S with an unbounded exponent at their
# range edges. The values are validate.py's model's.
fn cyrius_touchstone_write_edges(): i64 {
    test_group("cyrius_touchstone_write_edges");
    var m: f64 = _bj_from_bits(0x7FEFFFFFFFFFFFFF);
    var e160: f64 = _bj_from_bits(0x6126C2D4256FFCC3);
    var em200: f64 = _bj_from_bits(0x16687E92154EF7AC);
    var em300: f64 = _bj_from_bits(0x01A56E1FC2F8F359);
    var e300: f64 = _bj_from_bits(0x7E37E43C8800759C);
    assert(ts_write1(m, m, BJ_TOUCHSTONE_FORMAT_DB_ANGLE, "\n1e0  6.168104611154975e3  4.5e1\n") == 1,
      "DBL_MAX(1 + j) in DB: |S| past DBL_MAX, 6168.1 dB (Rust refused it)");
    assert(ts_write1(m, m, BJ_TOUCHSTONE_FORMAT_MAGNITUDE_ANGLE, "") == 2, "the same in MA: |S| not representable");
    assert(ts_write1(e160, 0.0, BJ_TOUCHSTONE_FORMAT_MAGNITUDE_ANGLE, "\n1e0  1e160  0e0\n") == 1,
      "10¹⁶⁰ in MA: re² past DBL_MAX (Rust refused it)");
    assert(ts_write1(em200, 0.0, BJ_TOUCHSTONE_FORMAT_MAGNITUDE_ANGLE, "\n1e0  1e-200  0e0\n") == 1,
      "10⁻²⁰⁰ in MA: re² below 2^-1074 (Rust wrote 0)");
    assert(ts_write1(em300, em300, BJ_TOUCHSTONE_FORMAT_DB_ANGLE, "\n1e0  -5.99698970004336e3  4.5e1\n") == 1,
      "10⁻³⁰⁰(1 + j) in DB: −5997 dB (Rust clamped |S| to 2^-1022: −6153.05 dB)");
    var w6 = "\n1e0  1e300  5.729577951308234e-309\n";
    var a6 = ts_write1(e300, 0.0000000001, BJ_TOUCHSTONE_FORMAT_MAGNITUDE_ANGLE, w6);
    assert(a6 == 1, "arg S = 10⁻³¹⁰ kept to 53 bits (Rust: 5.729577951308214e-309)");
    return 0;
}

# ADR 0002 row 18 (M4 part 2d-4a): the Touchstone reader's DB power and angles with an unbounded exponent at their
# range edges. The values are validate.py's model's.
fn cyrius_touchstone_read_edges(): i64 {
    test_group("cyrius_touchstone_read_edges");
    var d: BjTouchstoneData;
    var e1 = ts_parse("# GHz S DB R 50\n1.0 6166 45\n", 1, &d);
    var z1: BjComplex = BjComplex_new(0.0, 0.0);
    if (e1 == 0) {
        z1 = ts_s(&d, 0, 1, 1);
        BjTouchstoneData_free(&d);
    }
    var a1: f64 = _bj_from_bits(0x7FE91D3C7C0084CF);
    var b1: f64 = _bj_from_bits(0x7FE91D3C7C0084CD);
    assert(e1 == 0 && z1.re == a1 && z1.im == b1,
      "6166 dB at 45°: |S| = 10^308.3 past DBL_MAX, both parts representable (Rust refused the pair)");
    var e2 = ts_parse("# GHz S MA R 50\n1.0 1e10 1e-310\n", 1, &d);
    var z2: BjComplex = BjComplex_new(0.0, 0.0);
    if (e2 == 0) {
        z2 = ts_s(&d, 0, 1, 1);
        BjTouchstoneData_free(&d);
    }
    var b2: f64 = _bj_from_bits(0x0147F00F350A8DC8);
    assert(e2 == 0 && z2.re == 10000000000.0 && z2.im == b2,
      "10¹⁰ at 10^-310°: θ below 2^-1022 kept to 53 bits (Rust's im 1.7453292519952424e-302)");
    var e3 = ts_parse("# GHz S MA R 50\n1.0 1e300 5e-324\n", 1, &d);
    var z3: BjComplex = BjComplex_new(0.0, 0.0);
    if (e3 == 0) {
        z3 = ts_s(&d, 0, 1, 1);
        BjTouchstoneData_free(&d);
    }
    var b3: f64 = _bj_from_bits(0x3ABAAFE6D51317BB);
    assert(e3 == 0 && z3.im == b3, "10³⁰⁰ at 2^-1074°: im 8.6·10⁻²⁶ (Rust's θ underflowed to 0)");
    var e4 = ts_parse("# GHz S DB R 50\n1.0 -6200 30\n", 1, &d);
    var z4: BjComplex = BjComplex_new(0.0, 0.0);
    if (e4 == 0) {
        z4 = ts_s(&d, 0, 1, 1);
        BjTouchstoneData_free(&d);
    }
    var b4: f64 = _bj_from_bits(0x0000093445B87316);
    assert(e4 == 0 && z4.im == b4, "−6200 dB at 30°: 10^-310 to 53 bits, the product rounded once");
    assert(ts_refused("# GHz S DB R 50\n1.0 6168.2 45\n", 1) == 1, "6168.2 dB at 45°: both parts past DBL_MAX");
    return 0;
}

# ADR 0002 row 18 (M4 part 2d-3b): the stub match end to end with an unbounded exponent at its range edges. The
# values are validate.py's model's.
fn cyrius_stub_edges(): i64 {
    test_group("cyrius_stub_edges");
    var w: f64[4];
    var u: f64[4];
    var t0, v0 = bj_single_stub_match_complex(BjComplex_new(1.0, 1.0), 1.0, &u);
    var e300: f64 = _bj_from_bits(0x7E37E43C8800759C);
    var t1, v1 = bj_single_stub_match_complex(BjComplex_new(e300, e300), e300, &w);
    assert(is_ok(t1) == 1 && w[0] == u[0] && w[1] == u[1] && w[2] == u[2] && w[3] == u[3]
      && w[2] == 0.42620819117478337, "Z_L = 10³⁰⁰(1 + j) on 10³⁰⁰ Ω: the unit case's solutions (Rust refused it)");
    var sub: f64 = _bj_from_bits(0x0000000000000001);
    var t2, v2 = bj_single_stub_match_complex(BjComplex_new(sub, sub), sub, &w);
    assert(is_ok(t2) == 1 && w[0] == u[0] && w[1] == u[1] && w[2] == u[2] && w[3] == u[3],
      "the same at 2^-1074 Ω (1/Z₀ past DBL_MAX; Rust refused it)");
    var r3: f64 = _bj_from_bits(0x5EF7763FD12D819F);
    var x3: f64 = _bj_from_bits(0xDF96E97A52467095);
    var z3: f64 = _bj_from_bits(0x5F138D352E5096AF);
    var t3, v3 = bj_single_stub_match_complex(BjComplex_new(r3, x3), z3, &w);
    var a3: f64 = _bj_from_bits(0x3FCFE5183780D16D);
    var b3: f64 = _bj_from_bits(0x3F330B08F3D7B4EF);
    var c3: f64 = _bj_from_bits(0x3FCFF8233C4BB553);
    var d3: f64 = _bj_from_bits(0x3FDFFB3D3DC30A13);
    assert(is_ok(t3) == 1 && w[0] == a3 && w[1] == b3 && w[2] == c3 && w[3] == d3,
      "X_L = −3·10¹⁵², Z₀ = 10¹⁵⁰: two distinct solutions (Rust's discriminant overflowed: both d = λ/4)");
    return 0;
}

# BjSMatrix_new into *m; its error code (0 on Ok).
fn sm_new(n, z0: f64, m: *BjSMatrix): i64 {
    var t, v = BjSMatrix_new(n, z0, m);
    if (is_ok(t) == 1) { return 0; }
    return v;
}

# m.set_z0(k, value); its error code (0 on Ok).
fn zset(m: *BjSMatrix, k, value: f64): i64 {
    var t, v = m.set_z0(k, value);
    if (is_ok(t) == 1) { return 0; }
    return v;
}

# m.set(i, j, value); its error code (0 on Ok).
fn sset(m: *BjSMatrix, i, j, value: BjComplex): i64 {
    var t, v = m.set(i, j, value);
    if (is_ok(t) == 1) { return 0; }
    return v;
}

# A 2-port [[S11, S12], [S21, S22]] of real entries with both impedances z0 into *m: 1 on Ok.
fn tp_real(s11: f64, s12: f64, s21: f64, s22: f64, z0: f64, m: *BjSMatrix): i64 {
    var t, v = BjSMatrix_two_port(bj_complex_real(s11), bj_complex_real(s12), bj_complex_real(s21),
      bj_complex_real(s22), z0, m);
    if (is_ok(t) == 1) { return 1; }
    return 0;
}

# 2.0.1 bite 1a (port-parity §142): s_at is bounds-checked (H5); a cascade into one of its inputs replaces it (H9).
fn cyrius_audit_201(): i64 {
    test_group("cyrius_audit_201_smatrix (2.0.1 bite 1a)");
    var a: BjSMatrix;
    var b: BjSMatrix;
    var c: BjSMatrix;
    tp_real(0.1, 0.9, 0.9, 0.1, 50.0, &a);
    var e11: BjComplex = a.s_at(1, 1);
    var o1: BjComplex = a.s_at(2, 0);
    var o2: BjComplex = a.s_at(0, 0 - 1);
    var o3: BjComplex = a.s_at(0 - 1, 1);
    var e11r: f64 = e11.re;
    var o1r: f64 = o1.re;
    var o2i: f64 = o2.im;
    var o3r: f64 = o3.re;
    assert(e11r == 0.1 && o1r != o1r && o2i != o2i && o3r != o3r, "s_at: NaN + NaN·j out of range, as z0_at (H5)");
    tp_real(0.2, 0.8, 0.7, 0.3, 50.0, &b);
    var t1, v1 = a.cascade(&b, &c);
    var t2, v2 = a.cascade(&b, &a);
    var same_all = 1;
    for (var i = 0; i < 2; i = i + 1) {
        for (var j = 0; j < 2; j = j + 1) {
            var x: BjComplex = c.s_at(i, j);
            var y: BjComplex = a.s_at(i, j);
            var xr: f64 = x.re;
            var xi: f64 = x.im;
            var yr: f64 = y.re;
            var yi: f64 = y.im;
            if (same(xr, yr) == 0 || same(xi, yi) == 0) { same_all = 0; }
        }
    }
    assert(is_ok(t1) == 1 && is_ok(t2) == 1 && same_all == 1 && a.ports == 2,
      "a cascade into self equals one beside it (H9)");
    var t3, v3 = b.cascade(&c, &c);
    assert(is_ok(t3) == 1 && c.ports == 2, "and into other (H9)");
    BjSMatrix_free(&a);
    BjSMatrix_free(&b);
    BjSMatrix_free(&c);
    return 0;
}

# 1 when a.cascade(b) refuses (nothing is written).
fn cascade_refused(a: *BjSMatrix, b: *BjSMatrix): i64 {
    var c: BjSMatrix;
    var t, v = a.cascade(b, &c);
    if (is_err_result(t) == 1) { return 1; }
    BjSMatrix_free(&c);
    return 0;
}

# 1 when bj_s_to_z refuses.
fn s_to_z_refused(m: *BjSMatrix): i64 {
    var z: f64[8];
    var t, v = bj_s_to_z(m, &z);
    if (is_err_result(t) == 1) { return 1; }
    return 0;
}

# rf.rs's S-parameter tests.
fn rust_tests_d(): i64 {
    var s: BjSMatrix;
    var z: BjComplex;
    test_group("test_smatrix_creation");
    var t1, v1 = BjSMatrix_new(2, 50.0, &s);
    var t2, v2 = s.get(1, 1, &z);
    var zn: f64 = z.norm();
    assert(is_ok(t1) == 1 && s.ports == 2 && is_ok(t2) == 1 && zn < TOL, "a zero 2-port");

    test_group("test_smatrix_get_set");
    var t3, v3 = s.set(1, 2, BjComplex_new(0.5, 0.1));
    var t4, v4 = s.get(1, 2, &z);
    assert(is_ok(t3) == 1 && is_ok(t4) == 1 && near(z.re, 0.5, TOL) == 1, "S12 set and read back");

    test_group("test_smatrix_invalid_index");
    var t5, v5 = s.get(0, 1, &z);
    var t6, v6 = s.get(3, 1, &z);
    assert(is_err_result(t5) == 1 && is_err_result(t6) == 1, "ports 0 and 3 of a 2-port");
    BjSMatrix_free(&s);

    var thru: BjSMatrix;
    var c: BjSMatrix;
    test_group("test_cascade_thru");
    assert(tp_real(0.0, 1.0, 1.0, 0.0, 50.0, &thru) == 1, "the ideal thru");
    var t7, v7 = thru.cascade(&thru, &c);
    var c21: BjComplex = c.s_at(1, 0);
    var c11: BjComplex = c.s_at(0, 0);
    var c11n: f64 = c11.norm();
    assert(is_ok(t7) == 1 && near(c21.re, 1.0, TOL) == 1 && c11n < TOL, "thru · thru = thru");
    BjSMatrix_free(&c);

    test_group("test_cascade_matches_star_product");
    var a: BjSMatrix;
    var b: BjSMatrix;
    var ta, va = BjSMatrix_two_port(BjComplex_new(0.1, 0.2), BjComplex_new(0.3, -0.1), BjComplex_new(0.8, 0.05),
      BjComplex_new(-0.2, 0.1), 50.0, &a);
    var tb, vb = BjSMatrix_two_port(BjComplex_new(-0.15, 0.05), BjComplex_new(0.6, 0.2), BjComplex_new(0.7, -0.3),
      BjComplex_new(0.25, -0.05), 50.0, &b);
    var t8, v8 = a.cascade(&b, &c);
    var tol: f64 = 0.000000000001;
    assert(is_ok(t8) == 1 && close(c.s_at(0, 0), 0.06624178712220763, 0.22342969776609725, tol) == 1, "S11");
    assert(close(c.s_at(0, 1), 0.20499342969776613, -0.005256241787122209, tol) == 1, "S12");
    assert(close(c.s_at(1, 0), 0.5839684625492773, -0.2252299605781866, tol) == 1, "S21");
    assert(close(c.s_at(1, 1), 0.15717477003942182, 0.009816031537450719, tol) == 1, "S22");
    var cz0: f64 = c.z0_at(0);
    var cz1: f64 = c.z0_at(1);
    assert(cz0 == 50.0 && cz1 == 50.0, "z0 = [50, 50]");
    BjSMatrix_free(&c);

    test_group("test_cascade_requires_equal_z0");
    var mixed: BjSMatrix;
    tp_real(0.0, 1.0, 1.0, 0.0, 50.0, &mixed);
    var t9, v9 = mixed.set_z0(1, 75.0);
    assert(is_ok(t9) == 1 && cascade_refused(&mixed, &thru) == 1 && cascade_refused(&thru, &mixed) == 1,
      "z0 = [50, 75] on either side");
    var other: BjSMatrix;
    tp_real(0.0, 1.0, 1.0, 0.0, 75.0, &other);
    assert(cascade_refused(&thru, &other) == 1, "75 Ω against 50 Ω");

    test_group("test_s_to_z_conversion");
    var att: BjSMatrix;
    var h: f64 = _bj_from_bits(0x3FE6A09E667F3BCD);
    tp_real(0.0, h, h, 0.0, 50.0, &att);
    var zz: f64[8];
    var t10, v10 = bj_s_to_z(&att, &zz);
    var z11n: f64 = f64_abs(zz[0]) + f64_abs(zz[1]);
    assert(is_ok(t10) == 1 && z11n > 0.0 && near(zz[2], zz[4], TOL) == 1 && near(zz[3], zz[5], TOL) == 1,
      "a 3 dB attenuator: finite, Z12 = Z21");

    test_group("test_s_to_z_shunt_resistor");
    var sh: BjSMatrix;
    tp_real(-0.2, 0.8, 0.8, -0.2, 50.0, &sh);
    var t11, v11 = bj_s_to_z(&sh, &zz);
    var all = 0;
    for (var k = 0; k < 4; k = k + 1) {
        if (near(zz[2 * k], 100.0, 0.000000001) == 1 && near(zz[2 * k + 1], 0.0, 0.000000001) == 1) { all = all + 1; }
    }
    assert(is_ok(t11) == 1 && all == 4, "a 100 Ω shunt in 50 Ω: every Z-parameter is 100 Ω");

    test_group("test_s_to_z_requires_equal_z0");
    var t12, v12 = sh.set_z0(1, 75.0);
    assert(is_ok(t12) == 1 && s_to_z_refused(&sh) == 1, "z0 = [50, 75]");

    test_group("test_s_to_z_thru_is_singular");
    assert(s_to_z_refused(&thru) == 1, "an ideal thru has no Z-parameters");

    test_group("test_cascade_non_2port");
    var s3: BjSMatrix;
    var s2: BjSMatrix;
    var n3 = sm_new(3, 50.0, &s3) + sm_new(2, 50.0, &s2);
    assert(cascade_refused(&s3, &s2) == 1, "a 3-port");

    test_group("test_s_to_z_non_2port");
    assert(s_to_z_refused(&s3) == 1, "a 3-port");
    var frees = 0;
    frees = frees + BjSMatrix_free(&thru) + BjSMatrix_free(&a) + BjSMatrix_free(&b) + BjSMatrix_free(&mixed);
    frees = frees + BjSMatrix_free(&other) + BjSMatrix_free(&att) + BjSMatrix_free(&sh) + BjSMatrix_free(&s3);
    frees = frees + BjSMatrix_free(&s2);
    if (frees == 7 || v1 == 7 || v2 == 7 || v3 == 7 || v4 == 7 || v5 == 7 || v6 == 7 || v7 == 7 || v8 == 7) {
        println(".");
    }
    if (v9 == 7 || v10 == 7 || v11 == 7 || v12 == 7 || va == 7 || vb == 7 || is_err_result(ta) == 1) { println("."); }
    if (is_err_result(tb) == 1 || n3 == 7) { println("."); }
    return 0;
}

# ADR 0002 rows 36 (the fixed shape) and 37 (z0_equal on finite values), the reasons' text, out untouched, the heap.
fn cyrius_smatrix(): i64 {
    var s: BjSMatrix;
    var c: BjSMatrix;
    c.ports = 0;
    c.s = 0;
    c.z0 = 0;
    var z: BjComplex = BjComplex_new(7.0, 8.0);
    test_group("cyrius_smatrix_fixed_shape (ADR 0002 row 36)");
    var t1, v1 = BjSMatrix_new(3, 50.0, &s);
    var t2, v2 = s.set(2, 3, BjComplex_new(0.25, -0.5));
    var e23: BjComplex = s.s_at(1, 2);
    var raw: f64 = _bj_from_bits(load64(s.s + (1 * 3 + 2) * 16 + 8));
    assert(is_ok(t1) == 1 && is_ok(t2) == 1 && close(e23, 0.25, -0.5, 0.0) == 1 && raw == -0.5,
      "S23 at (i − 1)·ports + j − 1, row-major (re, im)");
    var z2: f64 = s.z0_at(2);
    var z3: f64 = s.z0_at(3);
    var zm: f64 = s.z0_at(0 - 1);
    assert(z2 == 50.0 && z3 != z3 && zm != zm && s.z0 == s.s + 3 * 3 * 16, "z0 after s in one block; NaN outside");
    var t3, v3 = s.set_z0(3, 75.0);
    var w3 = "invalid parameter: reference impedance index must be below 3, got 3";
    assert(err_is(t3, v3, BJ_ERR_INVALID_PARAMETER, w3) == 1, "set_z0 refuses an index past the last");
    BjSMatrix_free(&s);
    assert(s.ports == 0 && s.s == 0 && s.z0 == 0, "freed and emptied");
    var t4, v4 = BjSMatrix_new(0, 50.0, &s);
    assert(is_ok(t4) == 1 && s.s == 0 && s.z0 == 0, "a 0-port holds no block");
    var t5, v5 = s.get(1, 1, &z);
    assert(err_is(t5, v5, BJ_ERR_INVALID_PARAMETER, "invalid parameter: port indices must be 1..=0, got (1, 1)") == 1,
      "no entry to read");
    var big: BjSMatrix;
    big.ports = 5;
    var t6, v6 = BjSMatrix_new(1099511627776, 50.0, &big);
    assert(err_is(t6, v6, BJ_ERR_ALLOCATION, "allocation failed: an S-matrix of 1099511627776 ports") == 1 &&
      big.ports == 0, "2^40 ports: Allocation, out empty (Rust aborts; 2.0.1 H12)");

    test_group("cyrius_z0_equal_finite (ADR 0002 row 37)");
    var a: BjSMatrix;
    var b: BjSMatrix;
    tp_real(0.1, 0.9, 0.9, 0.1, 50.0, &a);
    tp_real(0.1, 0.9, 0.9, 0.1, 50.0, &b);
    zset(&a, 1, _bj_from_bits(0x7FF0000000000000));
    var t7, v7 = a.cascade(&b, &c);
    assert(err_is(t7, v7, BJ_ERR_INVALID_PARAMETER,
        "invalid parameter: all port reference impedances must be equal, got [50.0, inf]") == 1,
      "an infinite second Z₀ is no longer equal to 50 Ω (Rust: ∞ ≤ 10⁻¹²·∞)");
    var zz: f64[8];
    var t8, v8 = bj_s_to_z(&a, &zz);
    assert(is_err_result(t8) == 1 && v8 == BJ_ERR_INVALID_PARAMETER, "s_to_z likewise");
    zset(&a, 1, 50.00000000004);
    var t9, v9 = a.cascade(&b, &c);
    assert(is_ok(t9) == 1, "within 10⁻¹² of the first: equal");
    BjSMatrix_free(&c);
    zset(&a, 1, 50.0000000001);
    var t10, v10 = a.cascade(&b, &c);
    assert(is_err_result(t10) == 1, "2·10⁻¹² off: not equal");

    test_group("cyrius_smatrix_reasons");
    zset(&a, 1, 50.0);
    var s3: BjSMatrix;
    var n4 = sm_new(3, 50.0, &s3);
    var t11, v11 = s3.cascade(&a, &c);
    assert(err_is(t11, v11, BJ_ERR_INVALID_PARAMETER, "invalid parameter: cascade requires two 2-port networks") == 1,
      "cascade of a 3-port");
    var t12, v12 = bj_s_to_z(&s3, &zz);
    assert(err_is(t12, v12, BJ_ERR_INVALID_PARAMETER, "invalid parameter: S→Z conversion requires 2-port network")
      == 1, "s_to_z of a 3-port");
    zset(&a, 0, 0.0);
    var t13, v13 = a.cascade(&b, &c);
    assert(err_is(t13, v13, BJ_ERR_INVALID_PARAMETER,
        "invalid parameter: port reference impedance must be finite and positive, got 0") == 1, "a zero first Z₀");
    zset(&a, 0, 75.0);
    zset(&a, 1, 75.0);
    var t14, v14 = a.cascade(&b, &c);
    assert(err_is(t14, v14, BJ_ERR_INVALID_PARAMETER,
        "invalid parameter: cascade requires equal reference impedances, got 75 Ω and 50 Ω") == 1, "75 against 50");
    zset(&a, 0, 50.0);
    zset(&a, 1, 50.0);
    sset(&a, 2, 1, bj_complex_zero());
    var t15, v15 = a.cascade(&b, &c);
    assert(err_is(t15, v15, BJ_ERR_DIVISION_BY_ZERO,
        "division by zero in EM calculation: S21 = 0, cannot convert to T-parameters") == 1, "S21 = 0");
    var lp: BjSMatrix;
    var lq: BjSMatrix;
    tp_real(0.0, 1.0, 1.0, 1.0, 50.0, &lp);
    tp_real(1.0, 1.0, 1.0, 0.0, 50.0, &lq);
    var t16, v16 = lp.cascade(&lq, &c);
    assert(err_is(t16, v16, BJ_ERR_DIVISION_BY_ZERO,
        "division by zero in EM calculation: T22 = 0, cannot convert to S-parameters") == 1, "S22·S11′ = 1, a loop");
    var thru: BjSMatrix;
    tp_real(0.0, 1.0, 1.0, 0.0, 50.0, &thru);
    var t17, v17 = bj_s_to_z(&thru, &zz);
    assert(err_is(t17, v17, BJ_ERR_DIVISION_BY_ZERO, "division by zero in EM calculation: singular S→Z conversion")
      == 1, "the thru");
    var t18, v18 = thru.set(3, 1, bj_complex_real(1.0));
    assert(err_is(t18, v18, BJ_ERR_INVALID_PARAMETER, "invalid parameter: port indices must be 1..=2, got (3, 1)") == 1,
      "set past the last port");
    var t19, v19 = thru.get(0 - 1, 1, &z);
    assert(err_is(t19, v19, BJ_ERR_INVALID_PARAMETER,
        "invalid parameter: port indices must be 1..=2, got (18446744073709551615, 1)") == 1, "usize::MAX");
    var zr: f64 = z.re;
    var zi: f64 = z.im;
    var s21: BjComplex = thru.s_at(1, 0);
    assert(zr == 7.0 && zi == 8.0 && c.ports == 0 && near(s21.re, 1.0, 0.0) == 1,
      "out and the matrix untouched by every refusal");

    test_group("cyrius_smatrix_heap");
    var fl0 = _fl_arena_pos;
    var bump0 = alloc_used();
    var bad = 0;
    for (var k = 0; k < 2000; k = k + 1) {
        var tk, vk = thru.cascade(&thru, &c);
        if (is_err_result(tk) == 1 || c.ports != 2) { bad = bad + 1; }
        BjSMatrix_free(&c);
    }
    assert(bad == 0, "2000 cascades, each freed");
    assert_eq(_fl_arena_pos, fl0, "the freelist's arena did not grow");
    assert_eq(alloc_used(), bump0, "nothing on the bump heap");
    var frees = BjSMatrix_free(&s) + BjSMatrix_free(&a) + BjSMatrix_free(&b) + BjSMatrix_free(&s3);
    frees = frees + BjSMatrix_free(&lp) + BjSMatrix_free(&lq) + BjSMatrix_free(&thru);
    if (frees == 7 || v1 == 7 || v2 == 7 || v4 == 7 || v9 == 7 || v10 == 7 || is_ok(t8) == 7 || n4 == 7) {
        println(".");
    }
    return 0;
}

# The C strings a and b joined, on the bump heap (test text only).
fn cat(a, b): i64 {
    var la = strlen(a);
    var lb = strlen(b);
    var out = alloc(la + lb + 1);
    memcpy(out, a, la);
    memcpy(out + la, b, lb);
    store8(out + la + lb, 0);
    return out;
}

# bj_parse_touchstone of the C string s into *d; its error code (0 on Ok).
fn ts_parse(s, ports, d: *BjTouchstoneData): i64 {
    var t, v = bj_parse_touchstone(s, strlen(s), ports, d);
    if (is_ok(t) == 1) { return 0; }
    return v;
}

# 1 when bj_parse_touchstone refuses s.
fn ts_refused(s, ports): i64 {
    var d: BjTouchstoneData;
    if (ts_parse(s, ports, &d) != 0) { return 1; }
    BjTouchstoneData_free(&d);
    return 0;
}

# 1 when bj_parse_touchstone refuses s with the Display text want.
fn ts_err(s, ports, want): i64 {
    var d: BjTouchstoneData;
    var e = ts_parse(s, ports, &d);
    if (e == 0) {
        BjTouchstoneData_free(&d);
        return 0;
    }
    return reason_is2(want, "");
}

# Entry (i, j), 1-based, of matrix k of d.
fn ts_s(d: *BjTouchstoneData, k, i, j): BjComplex {
    var m: *BjSMatrix = d.matrix_at(k);
    var z: BjComplex = m.s_at(i - 1, j - 1);
    return z;
}

# rf.rs's Touchstone reader tests.
fn rust_tests_e(): i64 {
    var d: BjTouchstoneData;
    test_group("test_parse_touchstone_ri");
    var e1 = ts_parse("# GHz S RI R 50\n1.0  0.5  0.1\n2.0  0.3  -0.2\n", 1, &d);
    var f0: f64 = d.frequency_at(0);
    var s0: BjComplex = ts_s(&d, 0, 1, 1);
    assert(e1 == 0 && d.points == 2 && near(f0, 1000000000.0, 1.0) == 1 && near(s0.re, 0.5, TOL) == 1, "RI in GHz");
    BjTouchstoneData_free(&d);

    test_group("test_parse_touchstone_empty");
    assert(ts_refused("! comment only\n", 1) == 1, "no data");

    test_group("test_parse_touchstone_two_port_order");
    var e2 = ts_parse("! 2-port\n# GHZ S RI R 50\n1.0  0.1 0.01  0.9 0.09  0.2 0.02  0.3 0.03\n", 2, &d);
    var tol: f64 = 0.000000000000001;
    assert(e2 == 0 && close(ts_s(&d, 0, 1, 1), 0.1, 0.01, tol) == 1 && close(ts_s(&d, 0, 2, 1), 0.9, 0.09, tol) == 1,
      "N11, then N21");
    assert(close(ts_s(&d, 0, 1, 2), 0.2, 0.02, tol) == 1 && close(ts_s(&d, 0, 2, 2), 0.3, 0.03, tol) == 1,
      "then N12, N22");
    BjTouchstoneData_free(&d);

    test_group("test_parse_touchstone_three_port_multiline");
    var c3 = "# GHz S RI R 50\n1.0  0.11 -0.11  0.12 -0.12  0.13 -0.13\n";
    c3 = cat(c3, "     0.21 -0.21  0.22 -0.22  0.23 -0.23\n     0.31 -0.31  0.32 -0.32  0.33 -0.33 ! row 3\n");
    c3 = cat(c3, "2.0  0.11 0 0.12 0 0.13 0\n 0.21 0 0.22 0 0.23 0\n 0.31 0 0.32 0 0.33 0\n");
    var e3 = ts_parse(c3, 3, &d);
    var fa: f64 = d.frequency_at(0);
    var fb: f64 = d.frequency_at(1);
    var all = 0;
    for (var i = 0; i < 3; i = i + 1) {
        for (var j = 0; j < 3; j = j + 1) {
            var x: f64 = 0.1 * f64_from(i + 1) + 0.01 * f64_from(j + 1);
            if (close(ts_s(&d, 0, i + 1, j + 1), x, -x, 0.000000000001) == 1) { all = all + 1; }
        }
    }
    assert(e3 == 0 && fa == 1000000000.0 && fb == 2000000000.0 && all == 9, "one matrix row per line");
    BjTouchstoneData_free(&d);

    test_group("test_parse_touchstone_five_port_wrapped");
    var c5 = "# MHz S MA R 75\n100 0.11 0 0.12 0 0.13 0 0.14 0\n   0.15 0\n";
    c5 = cat(c5, " 0.21 0 0.22 0 0.23 0 0.24 0\n   0.25 0\n 0.31 0 0.32 0 0.33 0 0.34 0\n   0.35 0\n");
    c5 = cat(c5, " 0.41 0 0.42 0 0.43 0 0.44 0\n   0.45 0\n 0.51 0 0.52 0 0.53 0 0.54 0\n   0.55 0\n");
    c5 = cat(c5, "200 0.11 1 0.12 1 0.13 1 0.14 1\n   0.15 1\n 0.21 1 0.22 1 0.23 1 0.24 1\n   0.25 1\n");
    c5 = cat(c5, " 0.31 1 0.32 1 0.33 1 0.34 1\n   0.35 1\n 0.41 1 0.42 1 0.43 1 0.44 1\n   0.45 1\n");
    c5 = cat(c5, " 0.51 1 0.52 1 0.53 1 0.54 1\n   0.55 1\n");
    var e5 = ts_parse(c5, 5, &d);
    var g0: f64 = d.frequency_at(0);
    var g1: f64 = d.frequency_at(1);
    var z5: f64 = d.z0;
    assert(e5 == 0 && g0 == 100000000.0 && g1 == 200000000.0 && near(z5, 75.0, TOL) == 1, "two points at 75 Ω");
    assert(close(ts_s(&d, 0, 3, 5), 0.35, 0.0, 0.000000000001) == 1 &&
      close(ts_s(&d, 0, 5, 1), 0.51, 0.0, 0.000000000001) == 1, "each row wraps after four pairs");
    BjTouchstoneData_free(&d);

    test_group("test_parse_touchstone_inline_comment");
    var e6 = ts_parse("# GHz S RI R 50 ! options\n1.0 0.5 0.1 ! first\n", 1, &d);
    assert(e6 == 0 && close(ts_s(&d, 0, 1, 1), 0.5, 0.1, tol) == 1, "comments after the options and the data");
    BjTouchstoneData_free(&d);

    test_group("test_parse_touchstone_rejects_bad_tokens");
    assert(ts_refused("# GHz S RI R 50\n1.0 0.5 abc 0.1\n", 1) == 1 && ts_refused("# GHz S RI R 50\n1.0 nan 0.1\n", 1)
      == 1, "abc, nan");
    assert(ts_refused("# GHz S RI R 50\n1.0 inf 0.1\n", 1) == 1 && ts_refused("# GHz S RI R 50\n-1.0 0.5 0.1\n", 1)
      == 1, "inf, a negative frequency");
    assert(ts_refused("# GHz S DB R 50\n1.0 7000 0\n", 1) == 1, "7000 dB is not representable");

    test_group("test_parse_touchstone_partial_record");
    assert(ts_refused("# GHz S RI R 50\n1.0 0.5 0.1\n2.0 0.3\n", 1) == 1 &&
      ts_refused("# GHz S RI R 50\n1.0 0.1 0 0.9 0 0.2 0\n", 2) == 1, "a short last record");

    test_group("test_parse_touchstone_option_line_rules");
    var e7 = ts_parse("# GHz S RI R 50\n# MHz S MA R 75\n1.0 0.5 0.1\n", 1, &d);
    var z7: f64 = d.z0;
    var f7: f64 = d.frequency_at(0);
    assert(e7 == 0 && near(z7, 50.0, TOL) == 1 && near(f7, 1000000000.0, 1.0) == 1 &&
      close(ts_s(&d, 0, 1, 1), 0.5, 0.1, tol) == 1, "only the first option line counts");
    BjTouchstoneData_free(&d);
    assert(ts_refused("# GHz Y RI R 50\n1.0 0.5 0.1\n", 1) == 1 && ts_refused("# GHz Z RI R 50\n1.0 0.5 0.1\n", 1) == 1,
      "Y, Z");
    assert(ts_refused("# GHz H RI R 50\n1.0 0.5 0.1\n", 1) == 1 && ts_refused("# GHz G RI R 50\n1.0 0.5 0.1\n", 1) == 1,
      "H, G");
    var rbad = 0;
    rbad = rbad + ts_refused("# GHz S RI R \n1.0 0.5 0.1\n", 1) + ts_refused("# GHz S RI R abc\n1.0 0.5 0.1\n", 1);
    rbad = rbad + ts_refused("# GHz S RI R -50\n1.0 0.5 0.1\n", 1) + ts_refused("# GHz S RI R 0\n1.0 0.5 0.1\n", 1);
    rbad = rbad + ts_refused("# GHz S RI R nan\n1.0 0.5 0.1\n", 1) + ts_refused("# GHz S RI R inf\n1.0 0.5 0.1\n", 1);
    assert(rbad == 6, "R needs a finite positive number");
    assert(ts_refused("# GHz S RI XYZ R 50\n1.0 0.5 0.1\n", 1) == 1, "an unknown option");
    assert(ts_refused("1.0 0.5 0.1\n# GHz S RI R 50\n2.0 0.5 0.1\n", 1) == 1, "an option line after data");
    assert(ts_refused("[Version] 2.0\n# GHz S RI R 50\n1.0 0.5 0.1\n", 1) == 1, "a v2 keyword");
    var e8 = ts_parse("1.0 0.5 90\n", 1, &d);
    var f8: f64 = d.frequency_at(0);
    assert(e8 == 0 && near(f8, 1000000000.0, 1.0) == 1 && close(ts_s(&d, 0, 1, 1), 0.0, 0.5, 0.000000000001) == 1,
      "defaults: GHz S MA R 50");
    BjTouchstoneData_free(&d);

    test_group("test_parse_touchstone_port_limits");
    assert(ts_refused("1.0 0.5 0.1\n", 0) == 1 && ts_refused("1.0 0.5 0.1\n", 100000) == 1 &&
      ts_refused("1.0 0.5 0.1\n", 0 - 1) == 1, "0, 100 000, usize::MAX");

    test_group("test_parse_touchstone_two_port_noise_block_skipped");
    var cn = "# GHZ S MA R 50\n1.0 0.5 10 0.9 -20 0.1 30 0.4 40\n2.0 0.6 11 0.8 -21 0.1 31 0.3 41\n";
    cn = cat(cn, "! noise parameters\n1.0 1.5 0.3 45 0.2\n2.0 1.8 0.35 50 0.25\n");
    var e9 = ts_parse(cn, 2, &d);
    var s21: BjComplex = ts_s(&d, 0, 2, 1);
    var s21n: f64 = s21.norm();
    var s21a: f64 = _bj_to_degrees(s21.arg());
    assert(e9 == 0 && d.points == 2 && near(s21n, 0.9, 0.000000000001) == 1 && near(s21a, -20.0, 0.000000001) == 1,
      "the noise block skipped; S21 = 0.9∠−20°");
    BjTouchstoneData_free(&d);

    test_group("test_touchstone_parse_mhz");
    var e10 = ts_parse("# MHZ S RI R 75\n100.0  0.1  0.2\n", 1, &d);
    var z10: f64 = d.z0;
    var f10: f64 = d.frequency_at(0);
    assert(e10 == 0 && near(z10, 75.0, TOL) == 1 && near(f10, 100000000.0, 1.0) == 1, "MHz at 75 Ω");
    BjTouchstoneData_free(&d);
    return 0;
}

# ADR 0002 row 38 (UTF-8), Rust's text rules, the reasons' text, the layout and the heap.
fn cyrius_touchstone(): i64 {
    var d: BjTouchstoneData;
    d.points = 7;
    test_group("cyrius_touchstone_utf8 (ADR 0002 row 38)");
    var raw[32];
    memcpy(&raw, "1.0 0.5 0.1\n", 12);
    store8(&raw + 4, 192);
    var t1, v1 = bj_parse_touchstone(&raw, 12, 1, &d);
    assert(is_err_result(t1) == 1 && reason_is2("invalid parameter: Touchstone content is not valid UTF-8 ",
        "(an invalid sequence at byte 4)") == 1 && d.points == 0, "a lone lead byte: refused, out empty (H12)");
    var bad = 0;
    store8(&raw + 4, 237);
    store8(&raw + 5, 160);
    store8(&raw + 6, 128);
    var t2, v2 = bj_parse_touchstone(&raw, 12, 1, &d);
    if (is_err_result(t2) == 1) { bad = bad + 1; }
    store8(&raw + 4, 224);
    store8(&raw + 5, 128);
    var t3, v3 = bj_parse_touchstone(&raw, 12, 1, &d);
    if (is_err_result(t3) == 1) { bad = bad + 1; }
    store8(&raw + 4, 244);
    store8(&raw + 5, 144);
    store8(&raw + 6, 128);
    store8(&raw + 7, 128);
    var t4, v4 = bj_parse_touchstone(&raw, 12, 1, &d);
    if (is_err_result(t4) == 1) { bad = bad + 1; }
    var t5, v5 = bj_parse_touchstone("1.0 0.5 0.1\n\xE2\x80", 14, 1, &d);
    if (is_err_result(t5) == 1) { bad = bad + 1; }
    assert(bad == 4, "a surrogate, an overlong form, past U+10FFFF, a truncated sequence");

    test_group("cyrius_touchstone_text");
    var e1 = ts_parse("#\xE3\x80\x80GHz S RI R 50\xC2\xA0\r\n\xE2\x80\xA81.0\xC2\x850.5\t0.1\r\n", 1, &d);
    assert(e1 == 0 && close(ts_s(&d, 0, 1, 1), 0.5, 0.1, 0.0) == 1, "U+3000, U+00A0, U+2028, U+0085 and CRLF split");
    BjTouchstoneData_free(&d);
    assert(ts_err("1.0 \xE2\x80\x8B0.5 0.1\n", 1,
        "invalid parameter: Touchstone line 1: expected a finite number, got \"\\u{200b}0.5\"") == 1,
      "U+200B is no White_Space, and {:?} escapes it");
    assert(ts_err("1.0 1_0 0.1\n", 1, "invalid parameter: Touchstone line 1: expected a finite number, got \"1_0\"")
      == 1, "no '_' in a number");
    var wq = "invalid parameter: Touchstone line 1: expected a finite number, got \"a\\\"b\\\\c\"";
    assert(ts_err("1.0 a\"b\\c 0.1\n", 1, wq) == 1, "quotes, backslash");
    var wx = cat("invalid parameter: Touchstone line 1: expected a finite number, got ",
      "\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx…\"");
    assert(ts_err("1.0 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx 0.1\n", 1, wx) == 1, "33 characters: the first 32 and '…'");
    assert(ts_err("1.0 \xC3\xA9\xCC\x81 0.1\n", 1,
        "invalid parameter: Touchstone line 1: expected a finite number, got \"é\\u{301}\"") == 1,
      "a combining accent is escaped, é is not");
    var e2 = ts_parse("1. .5 +1.e-0\n", 1, &d);
    var f2: f64 = d.frequency_at(0);
    assert(e2 == 0 && f2 == 1000000000.0 && close(ts_s(&d, 0, 1, 1), 0.0, 0.5, 0.0) == 0, "1., .5 and +1.e-0 parse");
    BjTouchstoneData_free(&d);

    test_group("cyrius_touchstone_reasons");
    assert(ts_err("1 0 0\n", 257, "invalid parameter: Touchstone port count must be in 1..=256, got 257") == 1, "257");
    assert(ts_err("1 0 0\n2 0\n", 1, "invalid parameter: Touchstone data ends with an incomplete record: 2 of 3 values")
      == 1, "a partial record");
    assert(ts_err("\n\n", 1, "invalid parameter: no valid data found in Touchstone content") == 1, "nothing");
    var d300 = alloc(302);
    store8(d300, 49);
    for (var z = 1; z <= 300; z = z + 1) { store8(d300 + z, 48); }
    store8(d300 + 301, 0);
    var t300 = ts_parse("# GHz S RI R 50\n1e300 0 0\n", 1, &d);
    var h300 = "invalid parameter: Touchstone line 2: frequency must be finite and non-negative, got ";
    assert(t300 != 0 && reason_is2(h300, d300) == 1, "the frequency overflows through GHz, 1e300 in Display form");
    assert(ts_err("# GHz S DB R 50\n1\n7000\n0\n", 1,
        "invalid parameter: Touchstone record ending at line 4: S11 = (7000, 0) is not representable") == 1,
      "the record's last line");
    assert(ts_err("# GHz Z RI\n1 0 0\n", 1,
        "invalid parameter: Touchstone line 1: only S-parameter data is supported, got parameter type Z") == 1, "Z");
    assert(ts_err("# GHz S R\n1 0 0\n", 1,
        "invalid parameter: Touchstone line 1: option R must be followed by the reference impedance") == 1, "R alone");
    assert(ts_err("# R -0\n1 0 0\n", 1,
        "invalid parameter: Touchstone line 1: reference impedance must be a finite positive number, got \"-0\"") == 1,
      "R −0");
    assert(ts_err("! x\n# GHz S2P\n1 0 0\n", 1, "invalid parameter: Touchstone line 2: unrecognized option \"S2P\"")
      == 1, "an unknown option");
    assert(ts_err("1 0 0\n#\n", 1,
        "invalid parameter: Touchstone line 2: option line must precede the network data") == 1, "# after data");
    var wv = "invalid parameter: Touchstone line 1: Touchstone 2.0 keywords are not supported (v1.1 only)";
    assert(ts_err("  [Ports]\n", 1, wv) == 1, "[ after spaces");

    test_group("cyrius_touchstone_layout (ADR 0002 row 36)");
    var e3 = ts_parse("# Hz S RI R 25\n1 1 2 3 4 5 6 7 8\n3 0 0 0 0 0 0 0 0\n", 2, &d);
    var m1: *BjSMatrix = d.matrix_at(1);
    var m0: *BjSMatrix = d.matrix_at(0);
    var fz: f64 = d.frequency_at(2);
    var zz: f64 = m1.z0_at(1);
    assert(e3 == 0 && d.points == 2 && d.ports == 2 && m1.ports == 2 && zz == 25.0 && fz != fz, "two 2-port matrices");
    assert(d.matrix_at(2) == 0 && d.matrix_at(0 - 1) == 0 && m0.s == d.frequencies + 2 * 32, "headers, then data");
    var s12: BjComplex = m0.s_at(0, 1);
    assert(close(s12, 5.0, 6.0, 0.0) == 1, "N12 is the third pair");
    BjTouchstoneData_free(&d);
    assert(d.points == 0 && d.frequencies == 0, "freed and emptied");

    test_group("cyrius_touchstone_heap");
    var fl0 = _fl_arena_pos;
    var bump0 = alloc_used();
    var fails = 0;
    var hp = "# MHz S MA R 50\n1 0.5 30 0.9 -45 0.9 -45 0.5 30\n2 0.5 30 0.9 -45 0.9 -45 0.5 30\n";
    for (var k = 0; k < 2000; k = k + 1) {
        if (ts_parse(hp, 2, &d) != 0) {
            fails = fails + 1;
        }
        BjTouchstoneData_free(&d);
        if (ts_refused("# MHz S MA R 50\n1 0.5 30 0.9\n", 2) == 0) { fails = fails + 1; }
    }
    assert(fails == 0, "2000 parses freed, 2000 refusals");
    assert_eq(_fl_arena_pos, fl0, "the freelist's arena did not grow");
    assert_eq(alloc_used(), bump0, "nothing on the bump heap");
    if (v1 == 7 || v2 == 7 || v3 == 7 || v4 == 7 || v5 == 7 || is_ok(t1) == 7) { println("."); }
    return 0;
}

# A new BjTouchstoneData into *d; its error code (0 on Ok).
fn ts_new(ports, z0: f64, points, d: *BjTouchstoneData): i64 {
    var t, v = BjTouchstoneData_new(ports, z0, points, d);
    if (is_ok(t) == 1) { return 0; }
    return v;
}

# 1 when the Str s contains the C string needle.
fn str_has(s, needle): i64 {
    var n = strlen(needle);
    for (var k = 0; k + n <= str_len(s); k = k + 1) {
        if (memeq(str_data(s) + k, needle, n) == 1) { return 1; }
    }
    return 0;
}

# A fresh C string of a 1 and z zeros (an integer power of ten in Display form).
fn ten_pow(z): i64 {
    var p = alloc(z + 2);
    store8(p, 49);
    for (var k = 1; k <= z; k = k + 1) { store8(p + k, 48); }
    store8(p + z + 1, 0);
    return p;
}

# The Rust tests' one_port_data into *d: S11 = 0.5 + j0.1 at 1 GHz and 0.3 − j0.2 at 2 GHz, Z₀ = 50 Ω. 1 on Ok.
fn one_port_data(d: *BjTouchstoneData): i64 {
    if (ts_new(1, 50.0, 2, d) != 0) { return 0; }
    var f0 = 0;
    f0 = f0 + ts_setf(d, 0, 1000000000.0) + ts_setf(d, 1, 2000000000.0);
    f0 = f0 + sset(d.matrix_at(0), 1, 1, BjComplex_new(0.5, 0.1));
    f0 = f0 + sset(d.matrix_at(1), 1, 1, BjComplex_new(0.3, -0.2));
    if (f0 == 0) { return 1; }
    return 0;
}

# d.set_frequency(k, f); its error code (0 on Ok).
fn ts_setf(d: *BjTouchstoneData, k, f: f64): i64 {
    var t, v = d.set_frequency(k, f);
    if (is_ok(t) == 1) { return 0; }
    return v;
}

# bj_try_write_touchstone of d in the format into a fresh builder: the text (a Str) on Ok, else 0 with the code at
# *code.
fn ts_write(d: *BjTouchstoneData, format, code: *i64): i64 {
    var sb = str_builder_new();
    var t, v = bj_try_write_touchstone(d, format, sb);
    code[0] = 0;
    if (is_err_result(t) == 1) {
        code[0] = v;
        return 0;
    }
    return str_builder_build(sb);
}

# 1 when the Str s holds exactly the C string want.
fn str_is(s, want): i64 {
    if (s == 0 || str_len(s) != strlen(want)) { return 0; }
    return memeq(str_data(s), want, str_len(s));
}

# rf.rs's Touchstone writer tests.
fn rust_tests_f(): i64 {
    var d: BjTouchstoneData;
    var b: BjTouchstoneData;
    var code: i64[1];
    test_group("test_touchstone_roundtrip");
    assert(one_port_data(&d) == 1, "the data");
    var good = 0;
    for (var f = 0; f < 3; f = f + 1) {
        var txt = ts_write(&d, f, &code);
        var hasopt = str_has(txt, "# GHz S");
        var r50 = str_has(txt, "R 50\n");
        var t1, v1 = bj_parse_touchstone(str_data(txt), str_len(txt), 1, &b);
        var fb0: f64 = b.frequency_at(0);
        var fb1: f64 = b.frequency_at(1);
        var x0: BjComplex = ts_s(&b, 0, 1, 1);
        var x1: BjComplex = ts_s(&b, 1, 1, 1);
        if (v1 == 7) { println("."); }
        if (hasopt == 1 && r50 == 1 && is_ok(t1) == 1 && fb0 == 1000000000.0 && fb1 == 2000000000.0 &&
          close(x0, 0.5, 0.1, 0.000000000001) == 1 && close(x1, 0.3, -0.2, 0.000000000001) == 1) {
            good = good + 1;
        }
        BjTouchstoneData_free(&b);
    }
    assert(good == 3, "RI, MA and DB read back to the data");

    test_group("test_write_touchstone_inconsistent_does_not_panic");
    # Rust's first two cases, a frequency count unlike the matrices' and a matrix of another port count, can't be
    # built here (ADR 0002 row 36), and its deprecated write_touchstone isn't carried (row 1). The rest:
    var m0: *BjSMatrix = d.matrix_at(0);
    zset(m0, 0, 75.0);
    assert(ts_write(&d, BJ_TOUCHSTONE_FORMAT_REAL_IMAG, &code) == 0, "a matrix's Z₀ unlike the file's R");
    zset(m0, 0, 50.0);
    var z0d: BjTouchstoneData;
    ts_new(0, 50.0, 2, &z0d);
    assert(ts_write(&z0d, BJ_TOUCHSTONE_FORMAT_REAL_IMAG, &code) == 0, "ports = 0");
    BjTouchstoneData_free(&z0d);
    sset(m0, 1, 1, BjComplex_new(_bj_from_bits(0x7FF8000000000000), 0.0));
    assert(ts_write(&d, BJ_TOUCHSTONE_FORMAT_REAL_IMAG, &code) == 0, "a NaN entry");
    sset(m0, 1, 1, BjComplex_new(0.5, 0.1));
    ts_setf(&d, 0, 2000000000.0);
    ts_setf(&d, 1, 1000000000.0);
    assert(ts_write(&d, BJ_TOUCHSTONE_FORMAT_REAL_IMAG, &code) == 0, "decreasing frequencies");
    BjTouchstoneData_free(&d);

    test_group("test_write_touchstone_two_port_order");
    ts_new(2, 50.0, 1, &d);
    ts_setf(&d, 0, 1000000000.0);
    var m2: *BjSMatrix = d.matrix_at(0);
    sset(m2, 1, 1, bj_complex_real(0.1));
    sset(m2, 1, 2, bj_complex_real(0.2));
    sset(m2, 2, 1, bj_complex_real(0.9));
    sset(m2, 2, 2, bj_complex_real(0.3));
    var t2 = ts_write(&d, BJ_TOUCHSTONE_FORMAT_REAL_IMAG, &code);
    var want2 = cat("! Touchstone file generated by bijli\n# GHz S RI R 50\n",
      "1e0  1e-1  0e0  9e-1  0e0  2e-1  0e0  3e-1  0e0\n");
    assert(str_is(t2, want2) == 1, "f, N11, N21, N12, N22");
    BjTouchstoneData_free(&d);

    test_group("test_touchstone_multiport_write_layout_and_roundtrip");
    var laid = 0;
    var ns: i64[4];
    ns[0] = 3;
    ns[1] = 4;
    ns[2] = 5;
    ns[3] = 9;
    for (var w = 0; w < 4; w = w + 1) {
        var n = ns[w];
        ts_new(n, 50.0, 1, &d);
        ts_setf(&d, 0, 1500000000.0);
        var mm: *BjSMatrix = d.matrix_at(0);
        for (var i = 0; i < n; i = i + 1) {
            for (var j = 0; j < n; j = j + 1) {
                sset(mm, i + 1, j + 1, BjComplex_new(0.01 * f64_from(i * n + j), -0.003 * f64_from(j)));
            }
        }
        var tx = ts_write(&d, BJ_TOUCHSTONE_FORMAT_REAL_IMAG, &code);
        var lines = 0;
        var maxtok = 0;
        var tok = 0;
        var intok = 0;
        var skip = 2;
        for (var c = 0; c < str_len(tx); c = c + 1) {
            var ch = load8(str_data(tx) + c);
            if (ch == 10) {
                if (skip > 0) { skip = skip - 1; } else {
                    lines = lines + 1;
                    if (tok > maxtok) { maxtok = tok; }
                }
                tok = 0;
                intok = 0;
            } elif (ch == 32) { intok = 0; }
            elif (intok == 0) {
                intok = 1;
                if (skip == 0) { tok = tok + 1; }
            }
        }
        var t3, v3 = bj_parse_touchstone(str_data(tx), str_len(tx), n, &b);
        var back: *BjSMatrix = b.matrix_at(0);
        var same = memeq(back.s, mm.s, n * n * 16);
        if (v3 == 7) { println("."); }
        if (lines == n * ((n + 3) / 4) && maxtok <= 9 && is_ok(t3) == 1 && same == 1) { laid = laid + 1; }
        BjTouchstoneData_free(&b);
        BjTouchstoneData_free(&d);
    }
    assert(laid == 4, "3, 4, 5, 9 ports: ⌈n/4⌉ lines a row, ≤ 9 tokens a line, read back bit for bit");

    test_group("test_touchstone_write_precision");
    ts_new(1, 50.0, 2, &d);
    ts_setf(&d, 0, 1234.5);
    ts_setf(&d, 1, 1000000.25);
    sset(d.matrix_at(0), 1, 1, BjComplex_new(0.000000001, -0.000000000002));
    sset(d.matrix_at(1), 1, 1, BjComplex_new(0.000000001, -0.000000000002));
    var prec = 0;
    for (var f2 = 0; f2 < 3; f2 = f2 + 1) {
        var tp = ts_write(&d, f2, &code);
        var t4, v4 = bj_parse_touchstone(str_data(tp), str_len(tp), 1, &b);
        var p0: f64 = b.frequency_at(0);
        var p1: f64 = b.frequency_at(1);
        var sp: BjComplex = ts_s(&b, 0, 1, 1);
        var e1: f64 = f64_abs(sp.re - 0.000000001);
        var e2: f64 = f64_abs(sp.im + 0.000000000002);
        var tiny: f64 = 0.000000000000000000001;
        if (v4 == 7) { println("."); }
        if (is_ok(t4) == 1 && f64_abs(p0 - 1234.5) <= 0.000000000001 * 1234.5 &&
          f64_abs(p1 - 1000000.25) <= 0.000000000001 * 1000000.25 && e1 <= tiny && e2 <= tiny) {
            prec = prec + 1;
        }
        BjTouchstoneData_free(&b);
    }
    assert(prec == 3, "low frequencies and tiny entries survive in every format");
    BjTouchstoneData_free(&d);

    test_group("test_touchstone_db_zero_magnitude_is_finite");
    ts_new(1, 50.0, 1, &d);
    ts_setf(&d, 0, 1000000000.0);
    var tz = ts_write(&d, BJ_TOUCHSTONE_FORMAT_DB_ANGLE, &code);
    var has_inf = 0;
    for (var c2 = 0; c2 + 2 < str_len(tz); c2 = c2 + 1) {
        if (memeq(str_data(tz) + c2, "inf", 3) == 1) { has_inf = 1; }
    }
    var t5, v5 = bj_parse_touchstone(str_data(tz), str_len(tz), 1, &b);
    var zn: BjComplex = ts_s(&b, 0, 1, 1);
    var zm: f64 = zn.norm();
    assert(tz != 0 && has_inf == 0 && is_ok(t5) == 1 && zm < 0.000000000000000000000000000001, "|S| = 0 writes finite");
    BjTouchstoneData_free(&b);
    BjTouchstoneData_free(&d);
    if (v5 == 7) { println("."); }
    return 0;
}

# The text byte for byte, the reasons, row 37 in the writer, sb untouched by a refusal, and the heap.
fn cyrius_touchstone_write(): i64 {
    var d: BjTouchstoneData;
    var code: i64[1];
    test_group("cyrius_touchstone_write_text");
    one_port_data(&d);
    var ma = ts_write(&d, BJ_TOUCHSTONE_FORMAT_MAGNITUDE_ANGLE, &code);
    var wm = cat("! Touchstone file generated by bijli\n# GHz S MA R 50\n",
      "1e0  5.099019513592785e-1  1.1309932474020215e1\n");
    wm = cat(wm,
      "2e0  3.6055512754639896e-1  -3.369006752597979e1\n");
    assert(str_is(ma, wm) == 1, "MA: |S| and arg S in degrees, in {:e} form");
    var ri = ts_write(&d, BJ_TOUCHSTONE_FORMAT_REAL_IMAG, &code);
    var wr = "! Touchstone file generated by bijli\n# GHz S RI R 50\n1e0  5e-1  1e-1\n2e0  3e-1  -2e-1\n";
    assert(str_is(ri, wr) == 1, "RI");
    BjTouchstoneData_free(&d);
    var e0: BjTouchstoneData;
    ts_new(3, 0.000000000001, 0, &e0);
    var hdr = ts_write(&e0, BJ_TOUCHSTONE_FORMAT_DB_ANGLE, &code);
    assert(str_is(hdr, "! Touchstone file generated by bijli\n# GHz S DB R 0.000000000001\n") == 1,
      "no points: the header alone, R in Display form");
    BjTouchstoneData_free(&e0);

    test_group("cyrius_touchstone_write_reasons");
    ts_new(2, 50.0, 2, &d);
    ts_setf(&d, 0, 1.0);
    ts_setf(&d, 1, 2.0);
    zset(d.matrix_at(1), 1, _bj_from_bits(0x7FF0000000000000));
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "kept");
    var t1, v1 = bj_try_write_touchstone(&d, BJ_TOUCHSTONE_FORMAT_REAL_IMAG, sb);
    var w1 = "invalid parameter: S-matrix #1 reference impedances [50.0, inf] differ from the file's R 50";
    assert(err_is(t1, v1, BJ_ERR_INVALID_PARAMETER, w1) == 1, "an infinite Z₀ is not R's (ADR 0002 row 37)");
    var kept = str_builder_build(sb);
    assert(str_is(kept, "kept") == 1, "the builder untouched by a refusal");
    zset(d.matrix_at(1), 1, 50.0);
    var big: f64 = _bj_from_bits(0x6974E718D7D7625A);
    sset(d.matrix_at(1), 2, 2, BjComplex_new(big, 1.0));
    var sb2 = str_builder_new();
    var t2, v2 = bj_try_write_touchstone(&d, BJ_TOUCHSTONE_FORMAT_DB_ANGLE, sb2);
    var db2 = str_builder_build(sb2);
    assert(is_ok(t2) == 1 && str_has(db2, "  4e3  5.729577951308232e-199\n") == 1,
      "|S|² = 10⁴⁰⁰ past DBL_MAX: 4000 dB in DB (ADR 0002 row 18; Rust refused it)");
    var huge: f64 = _bj_from_bits(0x7FEAB36D48E1ACF0);
    sset(d.matrix_at(1), 2, 2, BjComplex_new(huge, huge));
    var sb2b = str_builder_new();
    var t2b, v2b = bj_try_write_touchstone(&d, BJ_TOUCHSTONE_FORMAT_MAGNITUDE_ANGLE, sb2b);
    var h15 = cat("15", ten_pow(307) + 1);
    var w2 = cat(cat(cat(cat("invalid parameter: S-parameter ", h15), "+"), h15),
      "i cannot be written in MagnitudeAngle format");
    assert(is_err_result(t2b) == 1 && reason_is2(w2, "") == 1, "|S| = 2.1·10³⁰⁸ past DBL_MAX: not writable in MA");
    sset(d.matrix_at(1), 2, 2, BjComplex_new(big, 1.0));
    var sb3 = str_builder_new();
    var t3, v3 = bj_try_write_touchstone(&d, BJ_TOUCHSTONE_FORMAT_REAL_IMAG, sb3);
    assert(is_ok(t3) == 1, "RI writes it");
    ts_setf(&d, 1, 1.0);
    var t4 = ts_write(&d, BJ_TOUCHSTONE_FORMAT_REAL_IMAG, &code);
    var w4 = "invalid parameter: Touchstone frequencies must be strictly increasing (#1: 1)";
    assert(t4 == 0 && reason_is2(w4, "") == 1,
      "equal frequencies");
    ts_setf(&d, 0, -0.5);
    var t5 = ts_write(&d, BJ_TOUCHSTONE_FORMAT_REAL_IMAG, &code);
    assert(t5 == 0 && reason_is2("invalid parameter: frequency #0 must be finite and non-negative, got -0.5", "") == 1,
      "a negative frequency");
    d.z0 = 0.0;
    var t6 = ts_write(&d, BJ_TOUCHSTONE_FORMAT_REAL_IMAG, &code);
    assert(t6 == 0 && reason_is2("invalid parameter: Touchstone reference impedance must be finite and positive, got 0",
        "") == 1, "R = 0");
    var t7, v7 = d.set_frequency(2, 1.0);
    assert(err_is(t7, v7, BJ_ERR_INVALID_PARAMETER, "invalid parameter: frequency index must be below 2, got 2") == 1,
      "set_frequency past the last point");
    BjTouchstoneData_free(&d);

    test_group("cyrius_touchstone_write_heap");
    one_port_data(&d);
    var w0 = ts_write(&d, BJ_TOUCHSTONE_FORMAT_MAGNITUDE_ANGLE, &code);
    var fl0 = _fl_arena_pos;
    var bad = 0;
    var sbh = str_builder_new();
    for (var k = 0; k < 2000; k = k + 1) {
        store64(sbh + 8, 0);
        var th, vh = bj_try_write_touchstone(&d, BJ_TOUCHSTONE_FORMAT_MAGNITUDE_ANGLE, sbh);
        if (is_err_result(th) == 1) { bad = bad + 1; }
    }
    assert(bad == 0 && w0 != 0, "2000 writes into one builder");
    assert_eq(_fl_arena_pos, fl0, "the text's buffer is freed: the freelist's arena did not grow");
    BjTouchstoneData_free(&d);
    if (v2 == 7 || v2b == 7 || v3 == 7) { println("."); }
    return 0;
}

# Runs rf.rs's tests, then the Cyrius-only checks.
fn main(): i64 {
    alloc_init();
    rust_tests_a();
    rust_tests_b();
    rust_tests_c();
    cyrius_deprecated();
    cyrius_errors();
    cyrius_values();
    cyrius_stub_root();
    cyrius_round_once();
    cyrius_zin_edges();
    cyrius_lossy_edges();
    cyrius_smith_edges();
    cyrius_stub_edges();
    cyrius_touchstone_read_edges();
    cyrius_touchstone_write_edges();
    cyrius_array_factor_edges();
    rust_tests_d();
    cyrius_smatrix();
    cyrius_cascade_exact();
    cyrius_s_to_z_exact();
    cyrius_exact_thresholds();
    rust_tests_e();
    cyrius_touchstone();
    rust_tests_f();
    cyrius_touchstone_write();
    cyrius_audit_201();
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
