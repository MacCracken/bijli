# integration.tcyr — 1.2.0:tests/integration.rs (M8 part 1): the crate's cross-module checks, ported assertion for
# assertion (the ledger matches them by name): all 26. Each combines two or more modules the way a consumer would:
# Maxwell's speed against c, Coulomb's inverse square, the wave's equal energy densities, the circuit identities, the
# media's D = ε₀E + P and B = μ₀(H + M), Snell's reciprocity, the 1D FDTD grid's propagation and its slower wave in a
# dielectric, and relativity's invariants. Literals are decimals (the lexer has no exponent).

include "tests/lib.cyr"

# |a − b| < tol.
fn near(a: f64, b: f64, tol: f64): i64 {
    var dd: f64 = a - b;
    var ad: f64 = f64_abs(dd);
    if (ad < tol) { return 1; }
    return 0;
}

# |a − b|/|b| < tol.
fn rel_near(a: f64, b: f64, tol: f64): i64 {
    var dd: f64 = a - b;
    var ad: f64 = f64_abs(dd);
    var ab: f64 = f64_abs(b);
    var r: f64 = ad / ab;
    if (r < tol) { return 1; }
    return 0;
}

# A word as a *f64.
fn f64p(a): *f64 {
    return a;
}

# The rightmost cell of sim with |E| > threshold, or `fallback`: Rust's `rposition(..).unwrap_or(fallback)`.
fn front(sim: *BjFdtd1d, threshold: f64, fallback): i64 {
    var e: *f64 = f64p(sim.e_field);
    var i = sim.num_cells - 1;
    while (i >= 0) {
        var x: f64 = e[i];
        var ax: f64 = f64_abs(x);
        if (ax > threshold) { return i; }
        i = i - 1;
    }
    return fallback;
}

# Runs integration.rs's tests.
fn main() {
    var origin: f64[3];
    origin[0] = 0.0;
    origin[1] = 0.0;
    origin[2] = 0.0;

    test_group("test_maxwell_speed_of_light");
    var t1, v1 = bj_wave_speed(BJ_EPSILON_0, BJ_MU_0);
    var c1: f64 = v1;
    assert(is_ok(t1) == 1 && rel_near(c1, BJ_SPEED_OF_LIGHT, 0.000001) == 1, "1/√(ε₀μ₀) = c");

    test_group("test_coulomb_inverse_square");
    var p1: f64[3];
    p1[0] = 1.0;
    p1[1] = 0.0;
    p1[2] = 0.0;
    var p2: f64[3];
    p2[0] = 2.0;
    p2[1] = 0.0;
    p2[2] = 0.0;
    var e1: BjFieldVector;
    var e2: BjFieldVector;
    var t2a, v2a = bj_electric_field_point_charge(0.000001, &origin, &p1, &e1);
    var t2b, v2b = bj_electric_field_point_charge(0.000001, &origin, &p2, &e2);
    var m1: f64 = e1.magnitude();
    var m2: f64 = e2.magnitude();
    var ratio: f64 = m1 / m2;
    assert(is_ok(t2a) == 1 && is_ok(t2b) == 1 && near(ratio, 4.0, 0.000001) == 1, "E(1 m)/E(2 m) = 4");

    test_group("test_energy_conservation_em_wave");
    var b0: f64 = bj_b_from_e(1000.0);
    var ue: f64 = bj_electric_energy_density(1000.0);
    var ub: f64 = bj_magnetic_energy_density(b0);
    assert(rel_near(ub, ue, 0.000001) == 1, "u_E = u_B in a plane wave");

    test_group("test_lorentz_force_circular_motion");
    var lv: BjFieldVector = BjFieldVector_new(1000000.0, 0.0, 0.0);
    var lb: BjFieldVector = BjFieldVector_new(0.0, 0.0, 1.0);
    var le: BjFieldVector = BjFieldVector_zero();
    var qe: f64 = -BJ_ELEMENTARY_CHARGE;
    var lf: BjFieldVector = bj_lorentz_force(qe, lv, le, lb);
    var fx: f64 = f64_abs(lf.x);
    var fy: f64 = f64_abs(lf.y);
    assert(fx < 0.0000000000000000000000001, "no force along v");
    assert(fy > 0.0, "a force across v: circular motion");

    test_group("test_hydrogen_atom_energy");
    var t5, v5 = bj_coulomb_potential_energy(BJ_ELEMENTARY_CHARGE, qe, 0.0000000000529177);
    var u5: f64 = v5;
    var ev: f64 = u5 / BJ_ELEMENTARY_CHARGE;
    assert(is_ok(t5) == 1 && near(ev, -27.2, 0.5) == 1, "-27.2 eV at the Bohr radius");

    test_group("test_superposition_principle");
    var charges: f64[8];
    charges[0] = 0.000001;
    charges[1] = 0.0;
    charges[2] = 0.0;
    charges[3] = 0.0;
    charges[4] = -0.000001;
    charges[5] = 2.0;
    charges[6] = 0.0;
    charges[7] = 0.0;
    var es: BjFieldVector;
    var t6, v6 = bj_electric_field_superposition(&charges, 2, &p1, &es);
    var esx: f64 = es.x;
    assert(is_ok(t6) == 1 && esx > 0.0, "the dipole's fields add at its midpoint (+x)");

    test_group("test_poynting_vector_direction");
    var pe: BjFieldVector = BjFieldVector_new(0.0, 100.0, 0.0);
    var pb: BjFieldVector = BjFieldVector_new(0.0, 0.0, 0.000001);
    var ps: BjFieldVector = bj_poynting_vector(pe, pb);
    var psx: f64 = ps.x;
    var psy: f64 = f64_abs(ps.y);
    var psz: f64 = f64_abs(ps.z);
    assert(psx > 0.0 && psy < 0.0000000001 && psz < 0.0000000001, "E along y, B along z: S along x");

    test_group("test_refractive_index_snells_law");
    var t8, v8 = bj_refractive_index(2.25, 1.0);
    var n8: f64 = v8;
    assert(is_ok(t8) == 1 && near(n8, 1.5, 0.0000000001) == 1, "ε_r = 2.25: n = 1.5");

    test_group("test_rc_full_charge_cycle");
    var tau: f64 = bj_rc_time_constant(1000.0, 0.000001);
    var t5tau: f64 = 5.0 * tau;
    var vc: f64 = bj_rc_charging_voltage(12.0, 1000.0, 0.000001, t5tau);
    var frac: f64 = vc / 12.0;
    assert(near(frac, 0.9933, 0.001) == 1, "99.3 % charged after 5τ");
    var vd: f64 = bj_rc_discharging_voltage(vc, 1000.0, 0.000001, t5tau);
    var left: f64 = vd / vc;
    assert(left < 0.01, "under 1 % left after 5τ");

    test_group("test_rlc_resonance_matches_components");
    var t10, v10 = bj_resonant_frequency(0.01, 0.0000001);
    var f0: f64 = v10;
    var w0: f64 = 2.0 * _BJ_PI * f0;
    var t10b, v10b = bj_rlc_impedance(50.0, 0.01, 0.0000001, w0);
    var z10: f64 = v10b;
    assert(is_ok(t10) == 1 && is_ok(t10b) == 1 && rel_near(z10, 50.0, 0.000001) == 1, "Z = R at resonance");

    test_group("test_series_parallel_identity");
    var rr: f64[2];
    rr[0] = 100.0;
    rr[1] = 100.0;
    var t11a, v11a = bj_resistance_series(&rr, 2);
    var t11b, v11b = bj_resistance_parallel(&rr, 2);
    var ser: f64 = v11a;
    var par: f64 = v11b;
    var sp: f64 = ser / par;
    assert(is_ok(t11a) == 1 && is_ok(t11b) == 1 && near(sp, 4.0, 0.0000000001) == 1, "series = 4 × parallel");

    test_group("test_capacitor_energy_from_field");
    var eps12: f64 = BJ_EPSILON_0 * 1.0;
    var t12, v12 = bj_parallel_plate_capacitance(eps12, 0.01, 0.001);
    var cap: f64 = v12;
    var uc: f64 = bj_capacitor_energy(cap, 100.0);
    var ef: f64 = 100.0 / 0.001;
    var ud: f64 = bj_dielectric_energy_density(1.0, ef);
    var udv: f64 = ud * 0.01;
    var uf: f64 = udv * 0.001;
    assert(is_ok(t12) == 1 && rel_near(uf, uc, 0.000001) == 1, "CV²/2 = (ε₀E²/2)·A·d");

    test_group("test_d_field_equals_eps_e");
    var de: BjFieldVector = BjFieldVector_new(500.0, 0.0, 0.0);
    var dd: BjFieldVector = bj_displacement_field(4.7, de);
    var dp: BjFieldVector = bj_polarization(4.7, de);
    var e0e: BjFieldVector = de.scale(BJ_EPSILON_0);
    var dchk: BjFieldVector = BjFieldVector_add(e0e, dp);
    var ddx: f64 = dd.x;
    var dcx: f64 = dchk.x;
    assert(near(ddx, dcx, 0.00000000000000000001) == 1, "D = ε₀E + P");

    test_group("test_b_h_m_consistency");
    var hh: BjFieldVector = BjFieldVector_new(100.0, 0.0, 0.0);
    var hb: BjFieldVector = bj_b_field_from_h(5000.0, hh);
    var hm: BjFieldVector = bj_magnetization(5000.0, hh);
    var hhm: BjFieldVector = BjFieldVector_add(hh, hm);
    var bchk: BjFieldVector = hhm.scale(BJ_MU_0);
    var hbx: f64 = hb.x;
    var bcx: f64 = bchk.x;
    assert(rel_near(bcx, hbx, 0.0000000001) == 1, "B = μ₀(H + M) = μ₀μ_r H");

    test_group("test_magnetic_energy_in_material");
    var bm0: f64 = 1000.0 * BJ_MU_0;
    var bmag: f64 = bm0 * 100.0;
    var t15, v15 = bj_magnetic_energy_density_material(1000.0, bmag);
    var u1: f64 = v15;
    var u2a: f64 = 0.5 * 1000.0;
    var u2b: f64 = u2a * BJ_MU_0;
    var u2c: f64 = u2b * 100.0;
    var u2: f64 = u2c * 100.0;
    assert(is_ok(t15) == 1 && rel_near(u2, u1, 0.000001) == 1, "B²/(2μ) = μH²/2");

    test_group("test_snell_law_reciprocity");
    var th: f64[1];
    var t16a, v16a = bj_snell_refraction_angle(1.0, 1.5, 0.5, &th);
    var tt: f64 = th[0];
    var th2: f64[1];
    var t16b, v16b = bj_snell_refraction_angle(1.5, 1.0, tt, &th2);
    var tb: f64 = th2[0];
    assert(is_ok(t16a) == 1 && v16a == Some && is_ok(t16b) == 1 && v16b == Some, "refracted both ways");
    assert(near(tb, 0.5, 0.0000000001) == 1, "air → glass → air returns to θ_i");

    test_group("test_fresnel_energy_conservation");
    var t17a, v17a = bj_reflectance_normal(1.0, 1.5);
    var t17b, v17b = bj_transmittance_normal(1.0, 1.5);
    var rn: f64 = v17a;
    var tn: f64 = v17b;
    var rt: f64 = rn + tn;
    assert(is_ok(t17a) == 1 && is_ok(t17b) == 1 && near(rt, 1.0, 0.0000000001) == 1, "R + T = 1");

    test_group("test_waveguide_cutoff_vs_wavelength");
    var t18a, v18a = bj_rectangular_waveguide_cutoff(0.02286, 0.01016, 1, 0, BJ_SPEED_OF_LIGHT);
    var t18b, v18b = bj_rectangular_waveguide_cutoff_wavelength(0.02286, 0.01016, 1, 0);
    var fc: f64 = v18a;
    var lc: f64 = v18b;
    var fl: f64 = fc * lc;
    assert(is_ok(t18a) == 1 && is_ok(t18b) == 1 && rel_near(fl, BJ_SPEED_OF_LIGHT, 0.000001) == 1, "f_c·λ_c = c");

    test_group("test_antenna_aperture_directivity_relation");
    var dir: f64 = bj_half_wave_dipole_directivity();
    var t19, v19 = bj_effective_aperture(0.1, dir);
    var ae: f64 = v19;
    var a4: f64 = ae * 4.0;
    var a4p: f64 = a4 * _BJ_PI;
    var lam2: f64 = 0.1 * 0.1;
    var dback: f64 = a4p / lam2;
    assert(is_ok(t19) == 1 && near(dback, dir, 0.000001) == 1, "A_e·4π/λ² = D");

    test_group("test_fdtd_wave_propagation");
    var sim: BjFdtd1d;
    var t20, v20 = BjFdtd1d_new(200, 0.0001, &sim);
    sim.add_source(100, 1.0);
    for (var k = 0; k < 50; k = k + 1) { sim.step_once(); }
    var ef20: *f64 = f64p(sim.e_field);
    var spread = 0;
    for (var i = 0; i < sim.num_cells; i = i + 1) {
        var x20: f64 = ef20[i];
        var a20: f64 = f64_abs(x20);
        if (i != 100 && a20 > 0.0000000001) { spread = 1; }
    }
    assert(is_ok(t20) == 1 && spread == 1, "the pulse leaves its source cell");
    BjFdtd1d_free(&sim);

    test_group("test_fdtd_dielectric_slows_wave");
    var vac: BjFdtd1d;
    var die: BjFdtd1d;
    var t21a, v21a = BjFdtd1d_new(400, 0.0001, &vac);
    var t21b, v21b = BjFdtd1d_new(400, 0.0001, &die);
    var t21c, v21c = die.set_permittivity(0, 400, 4.0);
    var w9: f64 = 2.0 * _BJ_PI;
    var w9f: f64 = w9 * 1000000000.0;
    for (var s = 0; s < 100; s = s + 1) {
        var sv: f64 = f64_from(vac.step);
        var tv: f64 = sv * vac.dt;
        var sd: f64 = f64_from(die.step);
        var td: f64 = sd * die.dt;
        var av: f64 = w9f * tv;
        var ad: f64 = w9f * td;
        var gv: f64 = _bj_sin(av);
        var gd: f64 = _bj_sin(ad);
        vac.add_source(50, gv);
        die.add_source(50, gd);
        vac.step_once();
        die.step_once();
    }
    var vf = front(&vac, 0.001, 50);
    var df = front(&die, 0.001, 50);
    assert(is_ok(t21a) == 1 && is_ok(t21b) == 1 && is_ok(t21c) == 1 && df <= vf,
      "the dielectric's wave travels slower");
    BjFdtd1d_free(&vac);
    BjFdtd1d_free(&die);

    test_group("test_lorentz_transform_preserves_both_invariants");
    var re: BjFieldVector = BjFieldVector_new(1000.0, 2000.0, -500.0);
    var rb: BjFieldVector = BjFieldVector_new(0.00001, -0.00003, 0.00002);
    var f1: BjEmTensor = BjEmTensor_from_fields(re, rb);
    var ep: BjFieldVector;
    var bp: BjFieldVector;
    var v07: f64 = 0.7 * BJ_SPEED_OF_LIGHT;
    var t22, v22 = bj_lorentz_transform_x(re, rb, v07, &ep, &bp);
    var f2: BjEmTensor = BjEmTensor_from_fields(ep, bp);
    var i1a: f64 = f1.first_invariant();
    var i1b: f64 = f2.first_invariant();
    var i2a: f64 = f1.second_invariant();
    var i2b: f64 = f2.second_invariant();
    var d1: f64 = i1a - i1b;
    var ad1: f64 = f64_abs(d1);
    var s1: f64 = f64_abs(i1a);
    var s1p: f64 = s1 + 0.000000000000000000000000000001;
    var r1: f64 = ad1 / s1p;
    var d2: f64 = i2a - i2b;
    var ad2: f64 = f64_abs(d2);
    var s2: f64 = f64_abs(i2a);
    var s2p: f64 = s2 + 0.000000000000000000000000000001;
    var r2: f64 = ad2 / s2p;
    assert(is_ok(t22) == 1 && r1 < 0.000001, "E² − c²B² is invariant");
    assert(r2 < 0.000001, "E·B is invariant");

    test_group("test_lw_velocity_field_matches_coulomb_at_rest");
    var rv: BjFieldVector = BjFieldVector_new(0.0, 2.0, 0.0);
    var zv: BjFieldVector = BjFieldVector_zero();
    var elw: BjFieldVector;
    var t23, v23 = bj_lienard_wiechert_e(0.000001, rv, zv, zv, &elw);
    var py: f64[3];
    py[0] = 0.0;
    py[1] = 2.0;
    py[2] = 0.0;
    var ecl: BjFieldVector;
    var t23b, v23b = bj_electric_field_point_charge(0.000001, &origin, &py, &ecl);
    var lwx: f64 = elw.x;
    var lwy: f64 = elw.y;
    var lwz: f64 = elw.z;
    var clx: f64 = ecl.x;
    var cly: f64 = ecl.y;
    var clz: f64 = ecl.z;
    assert(is_ok(t23) == 1 && is_ok(t23b) == 1 && near(lwx, clx, 0.001) == 1 && near(lwz, clz, 0.001) == 1,
      "no field across r");
    assert(rel_near(lwy, cly, 0.000001) == 1, "the Liénard–Wiechert field at rest is Coulomb's");

    test_group("test_four_vector_interval_lorentz_invariant");
    var pos: f64[3];
    pos[0] = 0.3;
    pos[1] = 0.0;
    pos[2] = 0.0;
    var ev4: BjFourVector = BjFourVector_from_time_position(0.000000001, &pos);
    var s2lab: f64 = ev4.interval_sq();
    var bst: BjFourVector;
    var v09: f64 = 0.9 * BJ_SPEED_OF_LIGHT;
    var t24, v24 = ev4.boost_x(v09, &bst);
    var s2b: f64 = bst.interval_sq();
    assert(is_ok(t24) == 1 && rel_near(s2b, s2lab, 0.000001) == 1, "the interval survives a 0.9c boost");

    test_group("test_relativistic_larmor_matches_nonrelativistic_at_low_v");
    var lvv: BjFieldVector = BjFieldVector_new(1000.0, 0.0, 0.0);
    var lac: BjFieldVector = BjFieldVector_new(0.0, 1000000000000000.0, 0.0);
    var t25, v25 = bj_relativistic_larmor_power(BJ_ELEMENTARY_CHARGE, lvv, lac);
    var prel: f64 = v25;
    var pnr: f64 = bj_larmor_power(BJ_ELEMENTARY_CHARGE, 1000000000000000.0);
    assert(is_ok(t25) == 1 && rel_near(prel, pnr, 0.01) == 1, "Liénard's power is Larmor's at v ≪ c");

    test_group("test_pure_magnetic_field_transforms_to_electric");
    var me: BjFieldVector = BjFieldVector_zero();
    var mb: BjFieldVector = BjFieldVector_new(0.0, 0.0, 1.0);
    var v05: f64 = 0.5 * BJ_SPEED_OF_LIGHT;
    var mep: BjFieldVector;
    var mbp: BjFieldVector;
    var t26, v26 = bj_lorentz_transform_x(me, mb, v05, &mep, &mbp);
    var t26b, v26b = bj_lorentz_factor(v05);
    var gm: f64 = v26b;
    var gv5: f64 = gm * v05;
    var mbz: f64 = mb.z;
    var gvb: f64 = gv5 * mbz;
    var want: f64 = -gvb;
    var mey: f64 = mep.y;
    assert(is_ok(t26) == 1 && is_ok(t26b) == 1 && rel_near(mey, want, 0.000001) == 1, "E′_y = −γvB_z");

    test_group("cyrius_audit_201_failed_constructors (2.0.1 bite 1b, H12)");
    # Each struct is filled with garbage (struct locals aren't zeroed), its constructor fails, and its _free runs, as a
    # defer would: an owning constructor leaves out empty on Err, so the free has nothing to give back.
    var fcg1: BjFdtd1d;
    memset(&fcg1, 171, sizeof(BjFdtd1d));
    var fca1, fcb1 = BjFdtd1d_new(1, 0.001, &fcg1);
    var fce1 = is_err_result(fca1) == 1 && fcg1.map_bytes == 0 && fcg1.e_field == 0;
    BjFdtd1d_free(&fcg1);
    var fcg2: BjFdtd2d;
    memset(&fcg2, 171, sizeof(BjFdtd2d));
    var fca2, fcb2 = BjFdtd2d_new(2, 50, 0.001, BJ_MODE2D_TM, &fcg2);
    var fce2 = is_err_result(fca2) == 1 && fcg2.map_bytes == 0 && fcg2.cpml == 0 && fcg2.lossy_bytes == 0;
    BjFdtd2d_free(&fcg2);
    var fcg3: BjFdtd3d;
    memset(&fcg3, 171, sizeof(BjFdtd3d));
    var fca3, fcb3 = BjFdtd3d_new(4, 1, 9, 0.001, &fcg3);
    var fce3 = is_err_result(fca3) == 1 && fcg3.cpml == 0 && fcg3.psi_bytes == 0;
    BjFdtd3d_free(&fcg3);
    var fcg4: BjCpml;
    memset(&fcg4, 171, sizeof(BjCpml));
    var fca4, fcb4 = BjCpml_new(8, -1.0, 0.000000000001, &fcg4);
    var fce4 = is_err_result(fca4) == 1 && fcg4.prof_block == 0 && fcg4.psi_bytes == 0;
    BjCpml_free(&fcg4);
    var fcg5: BjTfsfSource;
    memset(&fcg5, 171, sizeof(BjTfsfSource));
    var fca5, fcb5 = BjTfsfSource_try_new(2, 1, 0.0001, 0.0000000000001, &fcg5);
    var fce5 = is_err_result(fca5) == 1 && fcg5.map_bytes == 0;
    BjTfsfSource_free(&fcg5);
    var fcg6: BjSMatrix;
    memset(&fcg6, 171, sizeof(BjSMatrix));
    var fca6, fcb6 = BjSMatrix_new(1099511627776, 50.0, &fcg6);
    var fce6 = is_err_result(fca6) == 1 && fcg6.s == 0 && fcg6.ports == 0;
    BjSMatrix_free(&fcg6);
    var fcg7: BjTouchstoneData;
    memset(&fcg7, 171, sizeof(BjTouchstoneData));
    var fcraw[16];
    memcpy(&fcraw, "1.0 0.5 0.1\n", 12);
    store8(&fcraw + 4, 192);
    var fca7, fcb7 = bj_parse_touchstone(&fcraw, 12, 1, &fcg7);
    var fce7 = is_err_result(fca7) == 1 && fcg7.frequencies == 0 && fcg7.points == 0;
    BjTouchstoneData_free(&fcg7);
    var fcg8: BjEigenmodeResult;
    memset(&fcg8, 171, sizeof(BjEigenmodeResult));
    var fcd8 = "{\"frequencies\":[1],\"quality_factors\":[1],\"amplitudes\":[null]}";
    var fca8, fcb8 = BjEigenmodeResult_from_json(fcd8, strlen(fcd8), &fcg8);
    var fce8 = is_err_result(fca8) == 1 && fcg8.frequencies == 0 && fcg8.count == 0;
    BjEigenmodeResult_free(&fcg8);
    var fcg9: BjMieResult;
    memset(&fcg9, 171, sizeof(BjMieResult));
    var fca9, fcb9 = bj_mie(0.0 - 1.0, BjComplex_new(1.5, 0.0), &fcg9);
    var fce9 = is_err_result(fca9) == 1 && fcg9.a == 0 && fcg9.b == 0;
    BjMieResult_free(&fcg9);
    var fcg10: BjFieldSlice2D;
    memset(&fcg10, 171, sizeof(BjFieldSlice2D));
    var fca10, fcb10 = BjFieldSlice2D_from_json("{}", 2, &fcg10);
    var fce10 = is_err_result(fca10) == 1 && fcg10.values == 0 && fcg10.component == 0;
    BjFieldSlice2D_free(&fcg10);
    assert(fce1 && fce2 && fce3 && fce4 && fce5,
      "the grids, the CPML and the TF/SF source: empty after a failure, freed");
    assert(fce6 && fce7 && fce8 && fce9 && fce10,
      "the S-matrix, Touchstone, eigenmodes, Mie and a slice: empty, freed");

    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
