# bijli fuzz harness

include "tests/lib.cyr"

# Fuzz entry: feeds one input buffer (`data`, `len` bytes) to the code under test.
fn fuzz_main(data, len) {
    if (len == 0) { return 0; }
    return 0;
}

# Runs the fuzz harness once on a fixed input.
fn main() {
    alloc_init();
    fuzz_main("test", 4);
    println("fuzz: ok");
    return 0;
}

var r = main();
sys_exit_group(r);
