# bijli benchmarks
# Stdlib auto-included via cyrius.cyml; the library through tests/lib.cyr
#
# Pattern: bench_new -> bench_batch_start -> tight loop -> bench_batch_stop -> bench_report.
# For sub-1us ops use batch_size >= 1000 to amortize clock_gettime overhead
# (~240 ns per start/stop pair on x86_64 Linux). See lib/bench.cyr header for
# the full overhead-vs-batching guidance.

include "lib/alloc.cyr"    # a capturing closure's heap environment (the compiler asks for it by name)
include "tests/lib.cyr"

# A closure's untyped parameter as a *f64 (a typed return binds it without a warning).
fn bench_f64p(p): *f64 { return p; }

# A closure's untyped parameter as a *BjFieldVector.
fn bench_fv(p): *BjFieldVector { return p; }

# A no-op body that measures the harness's own per-iteration overhead.
fn bench_noop(): i64 { return 0; }

# Runs the bijli benchmarks and reports each. Beside the Rust twins (as their modules land), the Cyrius-only costs
# of the port's own machinery: a log site with the gate off (Rust's tracing with no subscriber), making an error
# (the last-error record, on the main thread's static record, with no syscall until a thread exists), the same with
# an f64 field (Rust's Display through src/fmtf.cyr), one Display, a complex multiply-and-divide (src/complex.cyr,
# by value), a complex exp (three correctly rounded calls), a sinh and a cosh over [0, 70) (src/crmath.cyr's bijli
# section), a complex sin (four calls), a complex exp and powf at the range edge (src/crmath_ux.cyr's slow paths), and
# the JSON writer and readers (src/json.cyr).
fn main(): i64 {
    alloc_init();
    var b = bench_new("noop");
    bench_batch_start(b);
    var i = 0;
    while (i < 1000000) { bench_noop(); i = i + 1; }
    bench_batch_stop(b, 1000000);
    bench_report(b);

    var bl = bench_new("log_gate_off");
    bench_batch_start(bl);
    for (var k = 0; k < 1000000; k = k + 1) { _bj_debug("bijli: a debug event nobody listens to"); }
    bench_batch_stop(bl, 1000000);
    bench_report(bl);

    var be = bench_new("error_record");
    var keep = 0;
    bench_batch_start(be);
    for (var k = 0; k < 100000; k = k + 1) {
        var c = _bj_err_invalid_parameter("negative frequency");
        keep = keep + c;
    }
    bench_batch_stop(be, 100000);
    bench_report(be);

    var bf = bench_new("error_record_f64");
    var v: f64 = -1.2345678901234567;
    bench_batch_start(bf);
    for (var k = 0; k < 100000; k = k + 1) {
        var c2 = _bj_err_invalid_permittivity(v);
        keep = keep + c2;
    }
    bench_batch_stop(bf, 100000);
    bench_report(bf);

    var bd = bench_new("fmt_f64_display");
    var buf[400];
    var tx[24];
    var w: f64 = 0.000123456789;
    bench_batch_start(bd);
    for (var k = 0; k < 100000; k = k + 1) {
        _bj_tx_init(&tx, &buf, 400);
        _bj_fmt_f64_display(&tx, w);
        keep = keep + _bj_tx_len(&tx);
    }
    bench_batch_stop(bd, 100000);
    bench_report(bd);
    var bc = bench_new("complex_mul_div");
    var ca = BjComplex_new(1.25, -0.5);
    var cb = BjComplex_new(0.75, 2.0);
    var acc = BjComplex_new(0.0, 0.0);
    bench_batch_start(bc);
    for (var k = 0; k < 1000000; k = k + 1) {
        var r = ca * cb / cb;
        acc = acc + r;
    }
    bench_batch_stop(bc, 1000000);
    bench_report(bc);

    var bx = bench_new("complex_exp");
    bench_batch_start(bx);
    for (var k = 0; k < 100000; k = k + 1) {
        var ex = ca.exp();
        acc = acc + ex;
    }
    bench_batch_stop(bx, 100000);
    bench_report(bx);
    var bh = bench_new("sinh_cosh");
    var hx: f64 = 0.0;
    var hsum: f64 = 0.0;
    bench_batch_start(bh);
    for (var k = 0; k < 100000; k = k + 1) {
        var s1: f64 = _bj_sinh(hx);
        var c1: f64 = _bj_cosh(hx);
        hsum = hsum + s1 + c1;
        hx = hx + 0.0007;
    }
    bench_batch_stop(bh, 100000);
    bench_report(bh);

    var bs = bench_new("complex_sin");
    bench_batch_start(bs);
    for (var k = 0; k < 100000; k = k + 1) {
        var zs = ca.sin();
        acc = acc + zs;
    }
    bench_batch_stop(bs, 100000);
    bench_report(bs);
    # The range edges' slow paths (ADR 0002 row 16, src/crmath_ux.cyr): e^1000 with an unbounded exponent, and a
    # power past DBL_MAX (|z|^2.5 for |z| ≈ 1e200) on the fixed point.
    var ce = BjComplex_new(1000.0, 0.5);
    var bxe = bench_new("complex_exp_edge");
    bench_batch_start(bxe);
    for (var k = 0; k < 2000; k = k + 1) {
        var ee = ce.exp();
        acc = acc + ee;
    }
    bench_batch_stop(bxe, 2000);
    bench_report(bxe);
    var cp = BjComplex_new(_bj_from_bits(0x6974E718D7D7625A), _bj_from_bits(0x693A9C2B1E8B2B7A));
    var bpe = bench_new("complex_powf_edge");
    bench_batch_start(bpe);
    for (var k = 0; k < 2000; k = k + 1) {
        var pe = cp.powf(2.5);
        acc = acc + pe;
    }
    bench_batch_stop(bpe, 2000);
    bench_report(bpe);
    if (hsum == 7.0) { println("."); }
    # ── Rust twins (rust-old/benches/benchmarks.rs, the same inputs) ──
    var fo: f64[3];
    var fx: f64[3];
    var fy: f64[3];
    var fz: f64[3];
    var fv: f64[3];
    fo[0] = 0.0;
    fo[1] = 0.0;
    fo[2] = 0.0;
    fx[0] = 1.0;
    fx[1] = 0.0;
    fx[2] = 0.0;
    fy[0] = 0.0;
    fy[1] = 1.0;
    fy[2] = 0.0;
    fz[0] = 0.0;
    fz[1] = 0.0;
    fz[2] = 1.0;
    fv[0] = 1000000.0;
    fv[1] = 0.0;
    fv[2] = 0.0;
    var fq: f64 = 0.000001;
    var fe: BjFieldVector;
    var fsum: f64 = 0.0;

    var b1 = bench_new("field/electric_field_point");
    bench_batch_start(b1);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t1, v1 = bj_electric_field_point_charge(fq, &fo, &fx, &fe);
        fsum = fsum + fe.x;
    }
    bench_batch_stop(b1, 1000000);
    bench_report(b1);

    var b2 = bench_new("field/electric_potential_point");
    bench_batch_start(b2);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t2, v2 = bj_electric_potential_point_charge(fq, &fo, &fx);
        keep = keep + v2;
    }
    bench_batch_stop(b2, 1000000);
    bench_report(b2);

    var b3 = bench_new("field/magnetic_field_moving");
    bench_batch_start(b3);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t3, v3 = bj_magnetic_field_moving_charge(fq, &fo, &fv, &fy, &fe);
        fsum = fsum + fe.z;
    }
    bench_batch_stop(b3, 1000000);
    bench_report(b3);

    var fcs: f64[40];
    for (var i = 0; i < 10; i = i + 1) {
        fcs[i * 4] = fq;
        fcs[i * 4 + 1] = f64_from(i);
        fcs[i * 4 + 2] = 0.0;
        fcs[i * 4 + 3] = 0.0;
    }
    var fat: f64[3];
    fat[0] = 5.0;
    fat[1] = 1.0;
    fat[2] = 0.0;
    var b4 = bench_new("field/superposition_10");
    bench_batch_start(b4);
    for (var k = 0; k < 100000; k = k + 1) {
        var t4, v4 = bj_electric_field_superposition(&fcs, 10, &fat, &fe);
        fsum = fsum + fe.x;
    }
    bench_batch_stop(b4, 100000);
    bench_report(b4);

    var vm = BjFieldVector_new(3.0, 4.0, 5.0);
    var b5 = bench_new("field/vector_magnitude");
    bench_batch_start(b5);
    for (var k = 0; k < 1000000; k = k + 1) {
        var mg: f64 = vm.magnitude();
        fsum = fsum + mg;
    }
    bench_batch_stop(b5, 1000000);
    bench_report(b5);

    var va = BjFieldVector_new(1.0, 2.0, 3.0);
    var vb = BjFieldVector_new(4.0, 5.0, 6.0);
    var b6 = bench_new("field/vector_cross");
    bench_batch_start(b6);
    for (var k = 0; k < 1000000; k = k + 1) {
        var cr = va.cross(vb);
        fsum = fsum + cr.z;
    }
    bench_batch_stop(b6, 1000000);
    bench_report(b6);

    var p30: f64 = _bj_from_bits(0x39B4484BFEEBC2A0);       # 1e-30
    var dip = BjFieldVector_new(0.0, 0.0, p30);
    var b7 = bench_new("field/electric_dipole_field");
    bench_batch_start(b7);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t7, v7 = bj_electric_dipole_field(dip, &fz, &fe);
        fsum = fsum + fe.z;
    }
    bench_batch_stop(b7, 1000000);
    bench_report(b7);

    var mdip = BjFieldVector_new(0.0, 0.0, 1.0);
    var b8 = bench_new("field/magnetic_dipole_field");
    bench_batch_start(b8);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t8, v8 = bj_magnetic_dipole_field(mdip, &fz, &fe);
        fsum = fsum + fe.z;
    }
    bench_batch_stop(b8, 1000000);
    bench_report(b8);
    var b9 = bench_new("field/charged_sphere");
    bench_batch_start(b9);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t9, v9 = bj_electric_field_charged_sphere(fq, 2.0);
        keep = keep + v9;
    }
    bench_batch_stop(b9, 1000000);
    bench_report(b9);

    var b10 = bench_new("field/ring_axis");
    bench_batch_start(b10);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t10, v10 = bj_electric_field_ring_axis(fq, 1.0, 0.5);
        keep = keep + v10;
    }
    bench_batch_stop(b10, 1000000);
    bench_report(b10);

    var b11 = bench_new("field/disk_axis");
    bench_batch_start(b11);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t11, v11 = bj_electric_field_disk_axis(fq, 1.0, 0.5);
        keep = keep + v11;
    }
    bench_batch_stop(b11, 1000000);
    bench_report(b11);
    var tq: f64 = 0.000001;
    var tfn = |pos, out| {
        var q: f64 = tq;
        var at: f64[3];
        at[0] = 0.0;
        at[1] = 0.0;
        at[2] = 0.0;
        var t, v = bj_electric_field_point_charge(q, &at, bench_f64p(pos), bench_fv(out));
        if (is_err_result(t) == 1) { return v; }
        return 0;
    };
    var tstart: f64[3];
    tstart[0] = 0.1;
    tstart[1] = 0.0;
    tstart[2] = 0.0;
    var tpoly = BjPolyline_new();
    var b12 = bench_new("field/trace_field_line_10");
    bench_batch_start(b12);
    for (var k = 0; k < 100000; k = k + 1) {
        var t12, v12 = bj_trace_field_line(&tstart, 0.01, 10, tfn, &tpoly);
        keep = keep + tpoly.count();
    }
    bench_batch_stop(b12, 100000);
    bench_report(b12);
    BjPolyline_free(&tpoly);

    # maxwell/* and charge/* (M1 part 3d): rust-old/benches/benchmarks.rs's maxwell_benchmarks and charge_benchmarks.
    var b13 = bench_new("maxwell/wave_speed");
    bench_batch_start(b13);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t13, v13 = bj_wave_speed(BJ_EPSILON_0, BJ_MU_0);
        keep = keep + v13;
    }
    bench_batch_stop(b13, 1000000);
    bench_report(b13);

    var b14 = bench_new("maxwell/impedance");
    bench_batch_start(b14);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t14, v14 = bj_impedance(BJ_EPSILON_0, BJ_MU_0);
        keep = keep + v14;
    }
    bench_batch_stop(b14, 1000000);
    bench_report(b14);

    var mw60: f64 = 2.0 * _BJ_PI * 60.0;
    var b15 = bench_new("maxwell/skin_depth");
    bench_batch_start(b15);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t15, v15 = bj_skin_depth(mw60, BJ_MU_0, 59600000.0);
        keep = keep + v15;
    }
    bench_batch_stop(b15, 1000000);
    bench_report(b15);

    var cq1: BjPointCharge;
    var cq2: BjPointCharge;
    var tc1, vc1 = BjPointCharge_new(fq, 1.0, &fo, &fo, &cq1);
    var tc2, vc2 = BjPointCharge_new(fq, 1.0, &fx, &fo, &cq2);
    var b16 = bench_new("charge/coulomb_force");
    bench_batch_start(b16);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t16, v16 = bj_coulomb_force(cq1, cq2, &fe);
        fsum = fsum + fe.x;
    }
    bench_batch_stop(b16, 1000000);
    bench_report(b16);

    var lv = BjFieldVector_new(1000000.0, 0.0, 0.0);
    var le = BjFieldVector_new(1000.0, 0.0, 0.0);
    var lb = BjFieldVector_new(0.0, 0.0, 1.0);
    var b17 = bench_new("charge/lorentz_force");
    bench_batch_start(b17);
    for (var k = 0; k < 1000000; k = k + 1) {
        var lf = bj_lorentz_force(BJ_ELEMENTARY_CHARGE, lv, le, lb);
        fsum = fsum + lf.y;
    }
    bench_batch_stop(b17, 1000000);
    bench_report(b17);
    if (fsum == 7.0) { println("."); }

    # material/* (M2 part 1a): rust-old/benches/benchmarks.rs's material_benchmarks.
    var me = BjFieldVector_new(1000.0, 0.0, 0.0);
    var msum: f64 = 0.0;
    var b21 = bench_new("material/polarization");
    bench_batch_start(b21);
    for (var k = 0; k < 1000000; k = k + 1) {
        var mp = bj_polarization(4.0, me);
        msum = msum + mp.x;
    }
    bench_batch_stop(b21, 1000000);
    bench_report(b21);

    var b22 = bench_new("material/displacement_field");
    bench_batch_start(b22);
    for (var k = 0; k < 1000000; k = k + 1) {
        var md = bj_displacement_field(4.0, me);
        msum = msum + md.x;
    }
    bench_batch_stop(b22, 1000000);
    bench_report(b22);

    var mbf = BjFieldVector_new(0.0, 0.0, 1.0);
    var mh: BjFieldVector;
    var b23 = bench_new("material/h_field_from_b");
    bench_batch_start(b23);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t23, v23 = bj_h_field_from_b(1000.0, mbf, &mh);
        msum = msum + mh.z;
    }
    bench_batch_stop(b23, 1000000);
    bench_report(b23);

    var cma: f64 = 0.0000000000000000000000000000000000000001;
    var cmn: f64 = 10000000000000000000000000000.0;
    var b24 = bench_new("material/clausius_mossotti");
    bench_batch_start(b24);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t24, v24 = bj_clausius_mossotti(cma, cmn);
        keep = keep + v24;
    }
    bench_batch_stop(b24, 1000000);
    bench_report(b24);

    var b25 = bench_new("material/curie_weiss");
    bench_batch_start(b25);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t25, v25 = bj_curie_weiss(1.0, 1000.0, 770.0);
        keep = keep + v25;
    }
    bench_batch_stop(b25, 1000000);
    bench_report(b25);
    if (msum == 7.0) { println("."); }

    # wave/* (M2 part 1b): rust-old/benches/benchmarks.rs's wave_benchmarks, with its arguments.
    var we = BjFieldVector_new(0.0, 1000.0, 0.0);
    var wb = BjFieldVector_new(0.0, 0.0, 0.000001);
    var wsum: f64 = 0.0;
    var wo: f64[1];
    var b26 = bench_new("wave/poynting_vector");
    bench_batch_start(b26);
    for (var k = 0; k < 1000000; k = k + 1) {
        var ws = bj_poynting_vector(we, wb);
        wsum = wsum + ws.x;
    }
    bench_batch_stop(b26, 1000000);
    bench_report(b26);

    var b27 = bench_new("wave/plane_wave_intensity");
    bench_batch_start(b27);
    for (var k = 0; k < 1000000; k = k + 1) {
        var wi: f64 = bj_plane_wave_intensity(1000.0);
        wsum = wsum + wi;
    }
    bench_batch_stop(b27, 1000000);
    bench_report(b27);

    var b28 = bench_new("wave/plane_wave_e");
    bench_batch_start(b28);
    for (var k = 0; k < 1000000; k = k + 1) {
        var wpe: f64 = bj_plane_wave_e(100.0, 10000000.0, 0.5, 3000000000000000.0, 0.000000000000001, 0.0);
        wsum = wsum + wpe;
    }
    bench_batch_stop(b28, 1000000);
    bench_report(b28);

    var b29 = bench_new("wave/fresnel_rs");
    bench_batch_start(b29);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t29, v29 = bj_fresnel_rs(1.0, 0.5, 1.5, 0.33);
        keep = keep + v29;
    }
    bench_batch_stop(b29, 1000000);
    bench_report(b29);

    var b30 = bench_new("wave/snell_refraction");
    bench_batch_start(b30);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t30, v30 = bj_snell_refraction_angle(1.0, 1.5, 0.5, &wo);
        wsum = wsum + wo[0];
    }
    bench_batch_stop(b30, 1000000);
    bench_report(b30);

    var b31 = bench_new("wave/fresnel_rs_direct");
    bench_batch_start(b31);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t31, v31 = bj_fresnel_rs_direct(1.0, 1.5, 0.707, &wo);
        wsum = wsum + wo[0];
    }
    bench_batch_stop(b31, 1000000);
    bench_report(b31);

    var b32 = bench_new("wave/reflectance_unpolarized");
    bench_batch_start(b32);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t32, v32 = bj_reflectance_unpolarized(1.0, 1.5, 0.707);
        keep = keep + v32;
    }
    bench_batch_stop(b32, 1000000);
    bench_report(b32);

    var wair: BjMaterial = BjMaterial_vacuum();
    var wglass: BjMaterial = BjMaterial_dielectric(2.25);
    var b33 = bench_new("wave/reflectance_at_interface");
    bench_batch_start(b33);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t33, v33 = bj_reflectance_at_interface(wair, wglass, 0.707);
        keep = keep + v33;
    }
    bench_batch_stop(b33, 1000000);
    bench_report(b33);

    var b34 = bench_new("wave/schlick_reflectance");
    bench_batch_start(b34);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t34, v34 = bj_schlick_reflectance(1.0, 1.5, 0.707);
        keep = keep + v34;
    }
    bench_batch_stop(b34, 1000000);
    bench_report(b34);

    var b35 = bench_new("wave/half_wave_dipole_pattern");
    bench_batch_start(b35);
    for (var k = 0; k < 1000000; k = k + 1) {
        var whp: f64 = bj_half_wave_dipole_pattern(1.0);
        wsum = wsum + whp;
    }
    bench_batch_stop(b35, 1000000);
    bench_report(b35);

    var b36 = bench_new("wave/rect_waveguide_cutoff");
    bench_batch_start(b36);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t36, v36 = bj_rectangular_waveguide_cutoff(0.02286, 0.01016, 1, 0, BJ_SPEED_OF_LIGHT);
        keep = keep + v36;
    }
    bench_batch_stop(b36, 1000000);
    bench_report(b36);
    if (wsum == 7.0) { println("."); }

    # circuit/* (M2 part 1c): rust-old/benches/benchmarks.rs's circuit_benchmarks, with its arguments.
    var csum: f64 = 0.0;
    var b37 = bench_new("circuit/rc_charging");
    bench_batch_start(b37);
    for (var k = 0; k < 1000000; k = k + 1) {
        var cv: f64 = bj_rc_charging_voltage(10.0, 1000.0, 0.000001, 0.0005);
        csum = csum + cv;
    }
    bench_batch_stop(b37, 1000000);
    bench_report(b37);

    var b38 = bench_new("circuit/rl_current_rise");
    bench_batch_start(b38);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t38, v38 = bj_rl_current_rise(10.0, 1.0, 0.001, 0.0005);
        keep = keep + v38;
    }
    bench_batch_stop(b38, 1000000);
    bench_report(b38);

    var b39 = bench_new("circuit/rlc_impedance");
    bench_batch_start(b39);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t39, v39 = bj_rlc_impedance(10.0, 0.001, 0.000001, 31416.0);
        keep = keep + v39;
    }
    bench_batch_stop(b39, 1000000);
    bench_report(b39);

    var b40 = bench_new("circuit/resonant_frequency");
    bench_batch_start(b40);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t40, v40 = bj_resonant_frequency(0.001, 0.000001);
        keep = keep + v40;
    }
    bench_batch_stop(b40, 1000000);
    bench_report(b40);

    var cr: f64[5];
    cr[0] = 10.0;
    cr[1] = 20.0;
    cr[2] = 30.0;
    cr[3] = 40.0;
    cr[4] = 50.0;
    var b41 = bench_new("circuit/resistance_parallel");
    bench_batch_start(b41);
    for (var k = 0; k < 1000000; k = k + 1) {
        var t41, v41 = bj_resistance_parallel(&cr, 5);
        keep = keep + v41;
    }
    bench_batch_stop(b41, 1000000);
    bench_report(b41);
    if (csum == 7.0) { println("."); }

    # The JSON (src/json.cyr): a FieldVector written into one builder, emptied each time through its length word
    # (lib/str.cyr's layout: buf, len, cap), and serde_json's documents read back.
    var jv = BjFieldVector_new(1.5, -0.25, BJ_SPEED_OF_LIGHT);
    var jsb = str_builder_new();
    var b18 = bench_new("json/field_vector_to_json");
    bench_batch_start(b18);
    for (var k = 0; k < 1000000; k = k + 1) {
        store64(jsb + 8, 0);
        var t18, v18 = BjFieldVector_to_json(&jv, jsb);
        keep = keep + v18;
    }
    bench_batch_stop(b18, 1000000);
    bench_report(b18);

    var jdoc = "{\"x\":1.5,\"y\":-0.25,\"z\":299792458.0}";
    var jlen = strlen(jdoc);
    var jout: BjFieldVector;
    var b19 = bench_new("json/field_vector_from_json");
    bench_batch_start(b19);
    for (var k = 0; k < 200000; k = k + 1) {
        var t19, v19 = BjFieldVector_from_json(jdoc, jlen, &jout);
        fsum = fsum + jout.z;
    }
    bench_batch_stop(b19, 200000);
    bench_report(b19);

    var pdoc = "{\"charge\":-1.6e-19,\"mass\":9.1093837015e-31,\"position\":[0,1e-10,0],\"velocity\":[2.2e6,0,0]}";
    var plen = strlen(pdoc);
    var pout: BjPointCharge;
    var b20 = bench_new("json/point_charge_from_json");
    bench_batch_start(b20);
    for (var k = 0; k < 200000; k = k + 1) {
        var t20, v20 = BjPointCharge_from_json(pdoc, plen, &pout);
        fsum = fsum + pout.mass;
    }
    bench_batch_stop(b20, 200000);
    bench_report(b20);
    if (fsum == 7.0) { println("."); }

    var ar: f64 = acc.re;
    if (ar == 7.0) { println("."); }
    if (keep == 7) { println("."); }
    return 0;
}

var r = main();
sys_exit_group(r);
