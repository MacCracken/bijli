# beam.tcyr — src/beam.cyr (M3 part 1c-1): Gaussian beams, ABCD matrices, resonators and the HG/LG modes.
#
# Every group named test_* is rust-old/src/beam.rs's test of that name, ported assertion for assertion (the ledger
# matches them by name). bijli's one convention is e^{+jωt} (ADR 0002 row 5): the Hermite–Gaussian field is the
# conjugate of Rust's e^{−iωt} field, so `test_hermite_gaussian_field_closed_form` reads its imaginary parts with the
# opposite sign, and says so; every other test reads real values that the convention leaves alone. The cyrius_*
# groups pin the field's propagation sense, the reasons' exact text, out left alone on an error, and ADR 0002 row 32
# (the LG power at l = i32::MIN), (M3 part 1c-2) the three structs' JSON: serde's text, round trips, both forms,
# the bool's two literals, the reasons and the heap, (M3 part 2a-2) ADR 0002 row 34: the resonators' exact
# stability and their waist without cancellation, and (M3 part 2a-3) ADR 0002 row 35: transform_beam on the exact
# determinant. tests/golden/beam.tsv pins every function over its grid against
# Rust besides, and tests/golden/json.tsv the JSON.

include "tests/lib.cyr"

var TOL: f64 = 0.000001;

# |a − b| < tol.
fn near(a: f64, b: f64, tol: f64): i64 {
    var d: f64 = f64_abs(a - b);
    if (d < tol) { return 1; }
    return 0;
}

# |(a − b)/b|.
fn rel(a: f64, b: f64): f64 {
    var r: f64 = f64_abs((a - b) / b);
    return r;
}

# The value of an Ok(f64) Result (the caller tests is_ok first).
fn ok_f(t, v): f64 {
    var x: f64 = v;
    return x;
}

# 1 when the last error's Display text is a followed by b (a literal can't continue across lines).
fn reason_is2(a, b): i64 {
    var d = bj_last_error_display();
    var la = strlen(a);
    if (strlen(d) != la + strlen(b)) { return 0; }
    if (memeq(d, a, la) != 1) { return 0; }
    return memeq(d + la, b, strlen(b));
}

# The test beams' λ = 1064 nm, w₀ = 100 µm into *g: 1 on Ok.
fn lab_beam(g: *BjGaussianBeam): i64 {
    var t, v = BjGaussianBeam_new(0.000001064, 0.0001, g);
    if (is_ok(t) == 1) { return 1; }
    return 0;
}

# 1 when BjGaussianBeam_new(λ, w₀) is refused.
fn beam_refused(lam: f64, w0: f64): i64 {
    var g: BjGaussianBeam;
    var t, v = BjGaussianBeam_new(lam, w0, &g);
    if (is_err_result(t) == 1) { return 1; }
    return 0;
}

# 1 when bj_resonator_stability(L, R₁, R₂) is refused.
fn stab_refused(l: f64, r1: f64, r2: f64): i64 {
    var st: BjResonatorStability;
    var t, v = bj_resonator_stability(l, r1, r2, &st);
    if (is_err_result(t) == 1) { return 1; }
    return 0;
}

# 1 when bj_resonator_beam_waist(L, R₁, R₂, λ) is refused.
fn waist_refused(l: f64, r1: f64, r2: f64, lam: f64): i64 {
    var t, v = bj_resonator_beam_waist(l, r1, r2, lam);
    if (is_err_result(t) == 1) { return 1; }
    return 0;
}

# 1 when the builder sb holds exactly the C string want.
fn built_is(sb, want): i64 {
    var s = str_builder_build(sb);
    if (str_len(s) != strlen(want)) { return 0; }
    return memeq(str_data(s), want, str_len(s));
}

# 1 when the Result (t, v) is an error with code `code` and the record's Display text is `want`.
fn err_is(t, v, code, want): i64 {
    if (is_err_result(t) != 1 || v != code) { return 0; }
    return reason_is2(want, "");
}

# beam.rs's Gaussian beam and ABCD tests.
fn rust_tests_a(): i64 {
    var g: BjGaussianBeam;
    test_group("test_beam_creation");
    assert(lab_beam(&g) == 1, "Ok");
    var w2: f64 = _bj_powi(0.0001, 2);
    var expected_zr: f64 = _BJ_PI * w2 / 0.000001064;
    var dz: f64 = f64_abs(g.rayleigh_range - expected_zr) / expected_zr;
    assert(dz < TOL, "z_R = πw₀²/λ ≈ 0.0295 m");

    test_group("test_beam_invalid");
    assert(beam_refused(0.0, 0.0001) == 1 && beam_refused(0.000001064, -1.0) == 1, "λ = 0, w₀ < 0");

    test_group("test_spot_size_at_waist");
    var w0: f64 = g.spot_size(0.0);
    assert(near(w0, g.waist, 0.00000000000000000001) == 1, "w(0) = w₀");

    test_group("test_spot_size_at_rayleigh");
    var sqrt2: f64 = _bj_from_bits(0x3FF6A09E667F3BCD);
    var wzr: f64 = g.spot_size(g.rayleigh_range);
    assert(near(wzr / g.waist, sqrt2, TOL) == 1, "w(z_R) = w₀√2");

    test_group("test_spot_size_symmetric");
    var wp: f64 = g.spot_size(0.01);
    var wm: f64 = g.spot_size(-0.01);
    assert(near(wp, wm, 0.00000000000000000001) == 1, "w(z) = w(−z)");

    test_group("test_radius_of_curvature_far_field");
    var zf: f64 = 100.0 * g.rayleigh_range;
    var t1, v1 = g.radius_of_curvature(zf);
    var rf: f64 = ok_f(t1, v1);
    assert(is_ok(t1) == 1 && near(rf / zf, 1.0, 0.01) == 1, "R(z) ≈ z for z ≫ z_R");

    test_group("test_radius_of_curvature_at_waist_fails");
    var t2, v2 = g.radius_of_curvature(0.0);
    assert(is_err_result(t2) == 1, "R is infinite at the waist");

    test_group("test_gouy_phase_at_rayleigh");
    var gz: f64 = g.gouy_phase(g.rayleigh_range);
    assert(near(gz, _BJ_PI / 4.0, TOL) == 1, "ζ(z_R) = π/4");

    test_group("test_divergence");
    var th: f64 = g.divergence();
    var ex: f64 = 0.000001064 / (_BJ_PI * 0.0001);
    assert(f64_abs(th - ex) / ex < TOL, "θ = λ/(πw₀)");

    test_group("test_confocal_equals_dof");
    var cp: f64 = g.confocal_parameter();
    var dof: f64 = g.depth_of_focus();
    assert(near(cp, dof, 0.000000000000000000000000000001) == 1, "b = DOF = 2z_R");

    test_group("test_identity_ray");
    var id: BjAbcdMatrix = BjAbcdMatrix_identity();
    var y1, a1 = id.apply_ray(1.0, 0.1);
    assert(near(y1, 1.0, TOL) == 1 && near(a1, 0.1, TOL) == 1, "unchanged");

    test_group("test_free_space_propagation");
    var fs: BjAbcdMatrix = BjAbcdMatrix_free_space(1.0);
    var y2, a2 = fs.apply_ray(0.0, 0.1);
    assert(near(y2, 0.1, TOL) == 1 && near(a2, 0.1, TOL) == 1, "y = 0 + 1.0·0.1, θ unchanged");

    test_group("test_thin_lens_focuses");
    var lens: BjAbcdMatrix;
    var t3, v3 = BjAbcdMatrix_thin_lens(0.1, &lens);
    var y3, a3 = lens.apply_ray(1.0, 0.0);
    assert(is_ok(t3) == 1 && near(y3, 1.0, TOL) == 1 && near(a3, -10.0, TOL) == 1, "(1, 0) → (1, −10)");

    test_group("test_thin_lens_zero_focal");
    var o: BjAbcdMatrix;
    var t4, v4 = BjAbcdMatrix_thin_lens(0.0, &o);
    assert(is_err_result(t4) == 1, "f = 0");

    test_group("test_curved_mirror_equiv_lens");
    var l5: BjAbcdMatrix;
    var m5: BjAbcdMatrix;
    var t5, v5 = BjAbcdMatrix_thin_lens(0.5, &l5);
    var t6, v6 = BjAbcdMatrix_curved_mirror(1.0, &m5);
    assert(near(l5.c, m5.c, TOL) == 1, "R = 2f is the lens of f");

    test_group("test_flat_interface");
    var fi: BjAbcdMatrix;
    var t7, v7 = BjAbcdMatrix_flat_interface(1.0, 1.5, &fi);
    var y7, a7 = fi.apply_ray(0.0, 0.3);
    assert(f64_abs(y7) < TOL && near(a7, 0.3 / 1.5, TOL) == 1, "θ₂ = (n₁/n₂)θ₁");

    test_group("test_compose_free_space");
    var m1: BjAbcdMatrix = BjAbcdMatrix_free_space(1.0);
    var m2: BjAbcdMatrix = BjAbcdMatrix_free_space(2.0);
    var comp: BjAbcdMatrix = m2.compose(&m1);
    var direct: BjAbcdMatrix = BjAbcdMatrix_free_space(3.0);
    assert(near(comp.b, direct.b, TOL) == 1, "two propagations are one");

    test_group("test_determinant_free_space");
    var d1: f64 = m1.determinant();
    assert(near(d1, 1.0, TOL) == 1, "det = 1");

    test_group("test_determinant_interface");
    var d2: f64 = fi.determinant();
    assert(near(d2, 1.0 / 1.5, TOL) == 1, "det = n₁/n₂");

    test_group("test_beam_propagation_free_space");
    var fs2: BjAbcdMatrix = BjAbcdMatrix_free_space(0.01);
    var q0, q1 = g.q(0.0);
    var qo: f64[2];
    var t8, v8 = fs2.propagate_beam(q0, q1, &qo);
    var qr: f64 = qo[0];
    var qi: f64 = qo[1];
    assert(is_ok(t8) == 1 && f64_abs(qi - g.rayleigh_range) / g.rayleigh_range < TOL, "Im q = z_R unchanged");
    assert(near(qr, 0.01, TOL) == 1, "Re q = 0.01");

    test_group("test_beam_transform_through_lens");
    var nb: BjGaussianBeam;
    var t9, v9 = lens.transform_beam(&g, &nb);
    var nw: f64 = nb.waist;
    var nl: f64 = nb.wavelength;
    var gl: f64 = g.wavelength;
    assert(is_ok(t9) == 1 && nw > 0.0 && nl == gl, "a positive waist, the wavelength kept");
    if (v1 == 7 || v2 == 7 || v3 == 7 || v4 == 7 || v5 == 7 || v6 == 7 || v7 == 7 || v8 == 7 || v9 == 7) {
        println(".");
    }
    if (t5 == 7 || t6 == 7 || t7 == 7) { println("."); }
    return 0;
}

# beam.rs's resonator and mode tests.
fn rust_tests_b(): i64 {
    var st: BjResonatorStability;
    test_group("test_symmetric_confocal");
    var t1, v1 = bj_resonator_stability(0.5, 0.5, 0.5, &st);
    var g1: f64 = st.g1;
    assert(is_ok(t1) == 1 && f64_abs(g1) < TOL && st.is_stable == 1, "g₁ = g₂ = 0, marginally stable");

    test_group("test_planar_cavity");
    var t2, v2 = bj_resonator_stability(0.1, 10000000000.0, 10000000000.0, &st);
    var gp2: f64 = st.g_product;
    assert(is_ok(t2) == 1 && near(gp2, 1.0, TOL) == 1 && st.is_stable == 1, "g₁g₂ = 1, marginally stable");

    test_group("test_concentric_unstable");
    var t3, v3 = bj_resonator_stability(1.0, 0.4, 0.4, &st);
    assert(is_ok(t3) == 1 && st.is_stable == 0, "just past concentric");

    test_group("test_stable_cavity");
    var t4, v4 = bj_resonator_stability(0.1, 0.2, 0.2, &st);
    var gp4: f64 = st.g_product;
    assert(is_ok(t4) == 1 && near(gp4, 0.25, TOL) == 1 && st.is_stable == 1, "g₁ = g₂ = 0.5");

    test_group("test_resonator_beam_waist");
    var t5, v5 = bj_resonator_beam_waist(0.1, 0.2, 0.2, 0.000001064);
    var w5: f64 = ok_f(t5, v5);
    assert(is_ok(t5) == 1 && w5 > 0.0 && w5 < 0.001, "sub-millimetre");

    test_group("test_resonator_beam_waist_unstable_fails");
    assert(waist_refused(1.0, 0.4, 0.4, 0.000001064) == 1, "unstable");

    test_group("test_transverse_mode_spacing");
    var fsr: f64 = 1500000000.0;
    var t6, v6 = bj_transverse_mode_spacing(fsr, 0.5, 0.5);
    var s6: f64 = ok_f(t6, v6);
    assert(is_ok(t6) == 1 && f64_abs(s6 - fsr / 3.0) / fsr < TOL, "arccos(0.5) = π/3: FSR/3");

    test_group("test_transverse_mode_spacing_unstable_fails");
    var t7, v7 = bj_transverse_mode_spacing(fsr, -2.0, -2.0);
    assert(is_err_result(t7) == 1, "g₁g₂ = 4");

    test_group("test_resonator_invalid_length");
    assert(stab_refused(0.0, 1.0, 1.0) == 1 && stab_refused(-1.0, 1.0, 1.0) == 1, "L ≤ 0");

    test_group("test_hermite_polynomial_values");
    var h0: f64 = _bj_hermite_polynomial(0, 1.0);
    var h1: f64 = _bj_hermite_polynomial(1, 1.0);
    var h2: f64 = _bj_hermite_polynomial(2, 1.0);
    var h3: f64 = _bj_hermite_polynomial(3, 1.0);
    assert(near(h0, 1.0, TOL) == 1 && near(h1, 2.0, TOL) == 1, "H₀ = 1, H₁(1) = 2");
    assert(near(h2, 2.0, TOL) == 1 && near(h3, -4.0, TOL) == 1, "H₂(1) = 4 − 2, H₃(1) = 8 − 12");

    test_group("test_laguerre_polynomial_values");
    var l0: f64 = _bj_laguerre_polynomial(0, 0, 1.0);
    var l1: f64 = _bj_laguerre_polynomial(1, 0, 0.5);
    var l2: f64 = _bj_laguerre_polynomial(2, 0, 1.0);
    var l3: f64 = _bj_laguerre_polynomial(1, 1, 1.0);
    assert(near(l0, 1.0, TOL) == 1 && near(l1, 0.5, TOL) == 1, "L₀⁰ = 1, L₁⁰(0.5) = 0.5");
    assert(near(l2, -0.5, TOL) == 1 && near(l3, 1.0, TOL) == 1, "L₂⁰(1) = −0.5, L₁¹(1) = 1");

    var g: BjGaussianBeam;
    lab_beam(&g);
    test_group("test_hg00_is_gaussian");
    var peak: f64 = bj_hermite_gaussian(&g, 0, 0, 0.0, 0.0, 0.0);
    var off: f64 = bj_hermite_gaussian(&g, 0, 0, 0.00005, 0.0, 0.0);
    assert(near(peak, 1.0, TOL) == 1 && off < peak && off > 0.0, "1 at the centre of the waist, less off axis");

    test_group("test_hg10_has_node_at_center");
    var c10: f64 = bj_hermite_gaussian(&g, 1, 0, 0.0, 0.0, 0.0);
    assert(f64_abs(c10) < TOL, "a node at x = 0");

    test_group("test_lg00_is_gaussian");
    var lg0: f64 = bj_laguerre_gaussian_intensity(&g, 0, 0, 0.0, 0.0);
    assert(near(lg0, 1.0, TOL) == 1, "LG₀₀(0, 0) = 1");

    test_group("test_lg_donut_mode");
    var on: f64 = bj_laguerre_gaussian_intensity(&g, 0, 1, 0.0, 0.0);
    var ring: f64 = bj_laguerre_gaussian_intensity(&g, 0, 1, 0.00007, 0.0);
    assert(f64_abs(on) < TOL && ring > 0.0, "zero on axis, nonzero on the ring");

    test_group("test_abcd_default_is_identity");
    var dm: BjAbcdMatrix = BjAbcdMatrix_default();
    var da: f64 = dm.a;
    var dd: f64 = dm.d;
    var db: f64 = dm.b;
    var dc: f64 = dm.c;
    assert(near(da, 1.0, TOL) == 1 && near(dd, 1.0, TOL) == 1 && f64_abs(db) < TOL && f64_abs(dc) < TOL, "I");
    if (v1 == 7 || v2 == 7 || v3 == 7 || v4 == 7 || v7 == 7) { println("."); }
    return 0;
}

# beam.rs's audit-driven edge cases.
fn rust_tests_c(): i64 {
    var g: BjGaussianBeam;
    lab_beam(&g);
    var o: BjAbcdMatrix;
    test_group("test_curved_interface");
    var t1, v1 = BjAbcdMatrix_curved_interface(1.0, 1.5, 0.1, &o);
    var d1: f64 = o.determinant();
    var c1: f64 = o.c;
    assert(is_ok(t1) == 1 && near(d1, 1.0 / 1.5, TOL) == 1 && near(c1, -10.0 / 3.0, TOL) == 1,
      "det = n₁/n₂, C = (n₁ − n₂)/(n₂R)");

    test_group("test_curved_interface_zero_n2");
    var t2, v2 = BjAbcdMatrix_curved_interface(1.0, 0.0, 0.1, &o);
    assert(is_err_result(t2) == 1, "n₂ = 0");

    test_group("test_curved_interface_zero_radius");
    var t3, v3 = BjAbcdMatrix_curved_interface(1.0, 1.5, 0.0, &o);
    assert(is_err_result(t3) == 1, "R = 0");

    test_group("test_curved_mirror_zero_radius");
    var t4, v4 = BjAbcdMatrix_curved_mirror(0.0, &o);
    assert(is_err_result(t4) == 1, "R = 0");

    test_group("test_flat_interface_zero_n2");
    var t5, v5 = BjAbcdMatrix_flat_interface(1.0, 0.0, &o);
    assert(is_err_result(t5) == 1, "n₂ = 0");

    test_group("test_peak_intensity_at_waist_vs_far");
    var iw: f64 = g.peak_intensity_factor(0.0);
    var ifar: f64 = g.peak_intensity_factor(10.0 * g.rayleigh_range);
    assert(iw > ifar, "the peak falls away from the waist");

    test_group("test_gouy_phase_limits");
    var big: f64 = 10000000000.0 * g.rayleigh_range;
    var far: f64 = g.gouy_phase(big);
    var nfar: f64 = g.gouy_phase(-big);
    assert(near(far, _BJ_PI / 2.0, 0.0001) == 1 && near(nfar, -_BJ_PI / 2.0, 0.0001) == 1, "ζ → ±π/2");

    test_group("test_radius_of_curvature_at_rayleigh");
    var t6, v6 = g.radius_of_curvature(g.rayleigh_range);
    var r6: f64 = ok_f(t6, v6);
    assert(is_ok(t6) == 1 && f64_abs(r6 - 2.0 * g.rayleigh_range) / r6 < TOL, "R(z_R) = 2z_R");

    test_group("test_lens_imaging_condition");
    var lens: BjAbcdMatrix;
    var t7, v7 = BjAbcdMatrix_thin_lens(0.1, &lens);
    var fa: BjAbcdMatrix = BjAbcdMatrix_free_space(0.2);
    var s1: BjAbcdMatrix = fa.compose(&lens);
    var sys: BjAbcdMatrix = s1.compose(&fa);
    var sa: f64 = sys.a;
    var sb: f64 = sys.b;
    assert(near(sa, -1.0, TOL) == 1 && f64_abs(sb) < TOL, "2f–2f imaging: A = −1, B = 0");

    test_group("test_resonator_beam_waist_invalid_wavelength");
    assert(waist_refused(0.1, 0.2, 0.2, 0.0) == 1 && waist_refused(0.1, 0.2, 0.2, -1.0) == 1, "λ ≤ 0");

    test_group("test_hg_higher_order_symmetry");
    var pos: f64 = bj_hermite_gaussian(&g, 2, 0, 0.00005, 0.0, 0.0);
    var neg: f64 = bj_hermite_gaussian(&g, 2, 0, -0.00005, 0.0, 0.0);
    assert(near(pos, neg, 0.000000000000001) == 1, "HG₂₀(x) = HG₂₀(−x)");

    test_group("test_lg_radial_symmetry");
    var i1: f64 = bj_laguerre_gaussian_intensity(&g, 1, 0, 0.00005, 0.0);
    var i2: f64 = bj_laguerre_gaussian_intensity(&g, 1, 0, 0.00005, 0.01);
    assert(i1 > 0.0 && i2 > 0.0, "positive at both z");
    if (v1 == 7 || v2 == 7 || v3 == 7 || v4 == 7 || v5 == 7 || v7 == 7 || t7 == 7) { println("."); }
    return 0;
}

# beam.rs's closed-form regression tests.
fn rust_tests_d(): i64 {
    var lam: f64 = 0.000001064;
    test_group("test_resonator_beam_waist_symmetric_confocal");
    var t1, v1 = bj_resonator_beam_waist(0.5, 0.5, 0.5, lam);
    var w1: f64 = ok_f(t1, v1);
    var e1: f64 = f64_sqrt(0.5 * lam / (2.0 * _BJ_PI));
    assert(is_ok(t1) == 1 && rel(w1, e1) < 0.000000000001, "w₀ = √(Lλ/2π) (Siegman; the old code refused it)");

    test_group("test_resonator_beam_waist_symmetric_closed_form");
    var t2, v2 = bj_resonator_beam_waist(0.1, 0.2, 0.2, lam);
    var w2: f64 = ok_f(t2, v2);
    var s3: f64 = f64_sqrt(3.0);
    var e2: f64 = f64_sqrt(0.1 * lam / (2.0 * _BJ_PI) * s3);
    assert(is_ok(t2) == 1 && rel(w2, e2) < 0.000000000001, "w₀² = (Lλ/2π)·√((1 + g)/(1 − g)), g = 0.5");
    var rn: f64 = 0.5 * (1.0 + 0.000000001);
    var t3, v3 = bj_resonator_beam_waist(0.5, rn, rn, lam);
    var near_c: f64 = ok_f(t3, v3);
    var t4, v4 = bj_resonator_beam_waist(0.5, 0.5, 0.5, lam);
    var conf: f64 = ok_f(t4, v4);
    assert(is_ok(t3) == 1 && rel(near_c, conf) < 0.000001, "near-confocal continuous with the confocal limit");

    test_group("test_resonator_beam_waist_planar_errs");
    var inf: f64 = 1.0 / 0.0;
    assert(waist_refused(0.1, inf, inf, lam) == 1, "flat–flat: no confined mode");
    var st: BjResonatorStability;
    var t5, v5 = bj_resonator_stability(0.1, inf, inf, &st);
    var gp: f64 = st.g_product;
    assert(is_ok(t5) == 1 && near(gp, 1.0, 0.000000000000001) == 1, "g = 1");

    test_group("test_transverse_mode_spacing_negative_g");
    var fsr: f64 = 1500000000.0;
    var t6, v6 = bj_transverse_mode_spacing(fsr, -0.5, -0.5);
    var s6: f64 = ok_f(t6, v6);
    assert(is_ok(t6) == 1 && f64_abs(s6 - 2.0 * fsr / 3.0) / fsr < 0.000000000001, "arccos(−0.5) = 2π/3");
    var t7, v7 = bj_transverse_mode_spacing(fsr, -1.0, -1.0);
    var s7: f64 = ok_f(t7, v7);
    var t8, v8 = bj_transverse_mode_spacing(fsr, 1.0, 1.0);
    var s8: f64 = ok_f(t8, v8);
    var t9, v9 = bj_transverse_mode_spacing(fsr, 0.0, 0.0);
    var s9: f64 = ok_f(t9, v9);
    assert(f64_abs(s7 - fsr) / fsr < 0.000000000001 && f64_abs(s8) < 0.001, "near-concentric → FSR, near-planar → 0");
    assert(f64_abs(s9 - fsr / 2.0) / fsr < 0.000000000001, "confocal: FSR/2");

    test_group("test_transverse_mode_spacing_invalid");
    var nan: f64 = 0.0 / 0.0;
    var ta, va = bj_transverse_mode_spacing(nan, 0.5, 0.5);
    var tb, vb = bj_transverse_mode_spacing(0.0, 0.5, 0.5);
    var tc, vc = bj_transverse_mode_spacing(-1.0, 0.5, 0.5);
    var td, vd = bj_transverse_mode_spacing(1000000000.0, nan, 0.5);
    assert(is_err_result(ta) == 1 && is_err_result(tb) == 1 && is_err_result(tc) == 1 && is_err_result(td) == 1,
      "fsr NaN, 0, −1; a NaN g");

    var g: BjGaussianBeam;
    lab_beam(&g);
    var sqrt2: f64 = _bj_from_bits(0x3FF6A09E667F3BCD);
    var inv_sqrt2: f64 = _bj_from_bits(0x3FE6A09E667F3BCD);
    test_group("test_hg_envelope_at_rayleigh_range");
    var zr: f64 = g.rayleigh_range;
    var hv: f64 = bj_hermite_gaussian(&g, 1, 0, g.waist, 0.0, zr);
    var eh: f64 = _bj_exp(-0.5);
    var he: f64 = sqrt2 * eh;
    assert(near(hv, he, 0.000000000001) == 1, "HG₁₀ at x = w₀: √2·e^{−1/2} (the old cos factor gave 0)");
    var h0: f64 = bj_hermite_gaussian(&g, 0, 0, 0.0, 0.0, zr);
    assert(near(h0, inv_sqrt2, 0.000000000001) == 1, "HG₀₀ on axis: w₀/w = 1/√2");

    test_group("test_hermite_gaussian_field_closed_form");
    # λ = 1, w₀ = 1: z_R = π, k = 2π; at z = z_R, w² = 2, R = 2z_R, ζ = π/4. bijli's field is e^{+jωt}, the conjugate
    # of Rust's: each imaginary part below is Rust's with its sign flipped (ADR 0002 row 5).
    var u: BjGaussianBeam;
    var tu, vu = BjGaussianBeam_new(1.0, 1.0, &u);
    var pi: f64 = _BJ_PI;
    var e: BjComplex = bj_hermite_gaussian_field(&u, 0, 0, 0.5, 0.0, pi);
    var ea: f64 = _bj_exp(-0.125);
    var amp: f64 = inv_sqrt2 * ea;
    var ph: f64 = 2.0 * pi * pi + 0.125 - pi / 4.0;
    var cp: f64 = _bj_cos(ph);
    var sp: f64 = _bj_sin(ph);
    var er: f64 = e.re;
    var ei: f64 = e.im;
    assert(is_ok(tu) == 1 && near(er, amp * cp, 0.000000000001) == 1 && near(ei, -(amp * sp), 0.000000000001) == 1,
      "HG₀₀ at x = 0.5: u·e^{−jφ}, φ = kz + kx²/(2R) − ζ");
    var ef2: BjComplex = bj_hermite_gaussian_field(&u, 2, 0, 0.0, 0.0, pi);
    var ph2: f64 = 2.0 * pi * pi - 3.0 * pi / 4.0;
    var c2: f64 = _bj_cos(ph2);
    var s2: f64 = _bj_sin(ph2);
    var e2r: f64 = ef2.re;
    var e2i: f64 = ef2.im;
    assert(near(e2r + sqrt2 * c2, 0.0, 0.000000000001) == 1 && near(e2i - sqrt2 * s2, 0.0, 0.000000000001) == 1,
      "HG₂₀ on axis: amplitude −√2, Gouy factor 3ζ");
    var e3: BjComplex = bj_hermite_gaussian_field(&u, 1, 1, 0.3, -0.2, 0.0);
    var u3: f64 = bj_hermite_gaussian(&u, 1, 1, 0.3, -0.2, 0.0);
    var e3r: f64 = e3.re;
    var e3i: f64 = e3.im;
    assert(near(e3r, u3, 0.000000000000001) == 1 && f64_abs(e3i) < 0.000000000000001, "real at the waist");
    var e4: BjComplex = bj_hermite_gaussian_field(&u, 3, 1, 0.4, 0.7, 2.3);
    var u4: f64 = bj_hermite_gaussian(&u, 3, 1, 0.4, 0.7, 2.3);
    var e4a: f64 = e4.abs();
    assert(near(e4a, f64_abs(u4), 0.000000000001) == 1, "|E| = |u| everywhere");

    test_group("test_transform_beam_flat_interface");
    var fi: BjAbcdMatrix;
    var tf, vf = BjAbcdMatrix_flat_interface(1.0, 1.5, &fi);
    var ob: BjGaussianBeam;
    var to, vo = fi.transform_beam(&g, &ob);
    var ow: f64 = ob.waist;
    var ol: f64 = ob.wavelength;
    var oz: f64 = ob.rayleigh_range;
    assert(is_ok(to) == 1 && rel(ow, g.waist) < 0.000000000001, "w₀ continuous (the old code gave √1.5·w₀)");
    assert(f64_abs(ol - lam / 1.5) / ol < 0.000000000001 && f64_abs(oz - 1.5 * zr) / oz < 0.000000000001,
      "λ′ = λ/1.5, z_R′ = 1.5z_R");

    test_group("test_transform_beam_lens_waist_position");
    var f: f64 = 0.1;
    var lens: BjAbcdMatrix;
    var tl, vl = BjAbcdMatrix_thin_lens(f, &lens);
    var lb: BjGaussianBeam;
    var dpos: f64[1];
    var tw, vw = lens.transform_beam_with_waist_position(&g, &lb, &dpos);
    var d: f64 = dpos[0];
    var d_exp: f64 = f * zr * zr / (zr * zr + f * f);
    var w_exp: f64 = g.waist * f / f64_sqrt(f * f + zr * zr);
    var lw: f64 = lb.waist;
    var ll: f64 = lb.wavelength;
    var gl: f64 = g.wavelength;
    assert(is_ok(tw) == 1 && rel(d, d_exp) < 0.000000000001 && rel(lw, w_exp) < 0.000000000001 && ll == gl,
      "Self (1983): d = f z_R²/(z_R² + f²), w₀′ = w₀ f/√(f² + z_R²), λ kept");
    var fs: BjAbcdMatrix = BjAbcdMatrix_free_space(0.25);
    var tg, vg = fs.transform_beam_with_waist_position(&g, &lb, &dpos);
    var d2: f64 = dpos[0];
    var lw2: f64 = lb.waist;
    assert(is_ok(tg) == 1 && f64_abs(d2 + 0.25) < 0.000000000000001 && rel(lw2, g.waist) < 0.000000000001,
      "free space: the waist 0.25 behind the output plane");

    test_group("test_transform_beam_invalid_determinant");
    var bad1: BjAbcdMatrix = BjAbcdMatrix_new(1.0, 0.0, 0.0, -1.0);
    var bad2: BjAbcdMatrix = BjAbcdMatrix_new(1.0, 0.0, 0.0, nan);
    var t10, v10 = bad1.transform_beam(&g, &ob);
    var t11, v11 = bad2.transform_beam(&g, &ob);
    assert(is_err_result(t10) == 1 && is_err_result(t11) == 1, "det ≤ 0 and NaN");

    test_group("test_nan_inputs_rejected");
    var tiny: f64 = _bj_from_bits(0x16687E92154EF7AC);
    assert(beam_refused(nan, 0.0001) == 1 && beam_refused(lam, nan) == 1 && beam_refused(inf, 0.0001) == 1,
      "a NaN or ∞ beam");
    assert(beam_refused(lam, tiny) == 1, "w₀ = 1e-200: z_R underflows to 0");
    assert(stab_refused(nan, 1.0, 1.0) == 1 && stab_refused(0.1, nan, 1.0) == 1 && stab_refused(inf, 1.0, 1.0) == 1,
      "a NaN or ∞ cavity");
    assert(waist_refused(0.1, 0.2, 0.2, nan) == 1, "a NaN wavelength");
    var o: BjAbcdMatrix;
    var tn1, vn1 = BjAbcdMatrix_thin_lens(nan, &o);
    var tn2, vn2 = BjAbcdMatrix_curved_mirror(nan, &o);
    var tn3, vn3 = BjAbcdMatrix_flat_interface(nan, 1.0, &o);
    var tn4, vn4 = BjAbcdMatrix_curved_interface(1.0, 1.5, nan, &o);
    assert(is_err_result(tn1) == 1 && is_err_result(tn2) == 1 && is_err_result(tn3) == 1 && is_err_result(tn4) == 1,
      "NaN elements");
    if (v1 == 7 || v2 == 7 || v3 == 7 || v4 == 7 || v5 == 7 || v6 == 7 || v7 == 7 || v8 == 7 || v9 == 7) {
        println(".");
    }
    if (va == 7 || vb == 7 || vc == 7 || vd == 7 || vu == 7 || vf == 7 || vo == 7 || vl == 7 || vw == 7) {
        println(".");
    }
    if (vg == 7 || v10 == 7 || v11 == 7 || vn1 == 7 || vn2 == 7 || vn3 == 7 || vn4 == 7 || tf == 7 || tl == 7) {
        println(".");
    }
    if (t4 == 7 || t8 == 7 || t9 == 7) { println("."); }
    return 0;
}

# The Cyrius-only checks.
fn cyrius_tests(): i64 {
    test_group("cyrius_beam_convention (ADR 0002 row 5)");
    # e^{+jωt}: the field is ∝ e^{−jkz}, so its phase falls along +z. HG₀₀ on axis just past the waist of a unit beam
    # (k = 2π, z_R = π): φ = kz − ζ > 0 at z = 1/8, and the field is u·e^{−jφ}, below the real axis.
    var u: BjGaussianBeam;
    var tu, vu = BjGaussianBeam_new(1.0, 1.0, &u);
    var e: BjComplex = bj_hermite_gaussian_field(&u, 0, 0, 0.0, 0.0, 0.125);
    var er: f64 = e.re;
    var ei: f64 = e.im;
    var a: f64 = e.arg();
    var gz: f64 = u.gouy_phase(0.125);
    var want: f64 = -(2.0 * _BJ_PI * 0.125 - gz);
    assert(is_ok(tu) == 1 && er > 0.0 && ei < 0.0 && near(a, want, 0.000000000001) == 1,
      "arg E = −(kz − ζ): the phase falls along +z");
    var q0, q1 = u.q(0.5);
    var qi: f64 = q1;
    assert(qi > 0.0 && q0 == 0.5, "q = z + j·z_R: Siegman's e^{+jωt} form, as Rust's numbers");

    test_group("cyrius_beam_reasons");
    var g: BjGaussianBeam;
    var tiny: f64 = _bj_from_bits(0x16687E92154EF7AC);
    var t1, v1 = BjGaussianBeam_new(0.000001064, tiny, &g);
    var d = bj_last_error_display();
    var head = "invalid parameter: Rayleigh range πw₀²/λ = 0 is not representable (w₀ = 0.0000";
    var tail = "1, λ = 0.000001064)";
    assert(memeq(d, head, strlen(head)) == 1 && memeq(d + strlen(d) - strlen(tail), tail, strlen(tail)) == 1,
      "z_R underflowed, in Rust's Display form");
    var st: BjResonatorStability;
    var t2, v2 = bj_resonator_beam_waist(1.0, 0.4, 0.4, 0.000001064);
    assert(reason_is2("invalid parameter: cavity is unstable (g₁g₂ = 2.2500), no confined mode exists", "") == 1,
      "Rust's {:.4}");
    var t3, v3 = bj_transverse_mode_spacing(1.0, -2.0, -2.0);
    assert(reason_is2("invalid parameter: cavity is unstable (g₁g₂ = 4.0000)", "") == 1, "the same, without the tail");
    var m: BjAbcdMatrix = BjAbcdMatrix_new(1.0, 0.0, 0.0, -1.0);
    var t4, v4 = m.transform_beam(&u, &g);
    assert(reason_is2("invalid parameter: ABCD determinant must be positive and finite (det = n_in/n_out), got -1", "")
      == 1, "the determinant");
    var t5, v5 = bj_resonator_beam_waist(0.1, 1.0 / 0.0, 1.0 / 0.0, 0.000001064);
    assert(is_err_result(t5) == 1 && v5 == BJ_ERR_DIVISION_BY_ZERO
      && reason_is2("division by zero in EM calculation: planar cavity (g₁ = g₂ = 1) has no confined mode", "") == 1,
      "the planar cavity");
    var z: BjAbcdMatrix = BjAbcdMatrix_new(1.0, 0.0, 0.0, 0.0);
    var qo: f64[2];
    var t6, v6 = z.propagate_beam(0.0, 1.0, &qo);
    assert(reason_is2("division by zero in EM calculation: ABCD beam propagation denominator is zero", "") == 1,
      "C·q + D = 0");

    test_group("cyrius_beam_out_untouched");
    var keep: BjAbcdMatrix = BjAbcdMatrix_new(5.0, 6.0, 7.0, 8.0);
    var t7, v7 = BjAbcdMatrix_thin_lens(0.0, &keep);
    var kc: f64 = keep.c;
    assert(is_err_result(t7) == 1 && kc == 7.0, "a refused element leaves out as it was");
    var kb: BjGaussianBeam;
    kb.wavelength = 9.0;
    kb.waist = 9.0;
    kb.rayleigh_range = 9.0;
    var dd: f64[1];
    dd[0] = 9.0;
    var t8, v8 = m.transform_beam_with_waist_position(&u, &kb, &dd);
    var kw: f64 = kb.waist;
    var kd: f64 = dd[0];
    assert(is_err_result(t8) == 1 && kw == 9.0 && kd == 9.0, "a refused transform leaves both outs as they were");

    test_group("cyrius_lg_i32_min (ADR 0002 row 32)");
    # (2r²/w²)^|l| with |l| = 2³¹ for l = i32::MIN: Rust's `l.unsigned_abs() as i32` wraps to −2³¹ and returned the
    # reciprocal (∞ where the power underflows to 0).
    var lab: BjGaussianBeam;
    lab_beam(&lab);
    var r: f64 = 0.5 * lab.waist;
    var i_min: f64 = bj_laguerre_gaussian_intensity(&lab, 0, 0 - 2147483648, r, 0.0);
    var i_max: f64 = bj_laguerre_gaussian_intensity(&lab, 0, 2147483647, r, 0.0);
    var big: f64 = 2.0 * lab.waist;
    var i_big: f64 = bj_laguerre_gaussian_intensity(&lab, 0, 0 - 2147483648, big, 0.0);
    assert(i_min == 0.0 && i_max == 0.0, "2r²/w² = 0.5: 0.5^{2³¹} underflows to 0, as 0.5^{2³¹−1} does");
    var top: f64 = _bj_from_bits(0x7FEFFFFFFFFFFFFF);
    assert(i_big > top, "2r²/w² = 8: 8^{2³¹} = ∞, times e^{−8} (Rust: 8^{−2³¹} = 0)");
    if (vu == 7 || v1 == 7 || v2 == 7 || v3 == 7 || v4 == 7 || v5 == 7 || v6 == 7 || v7 == 7 || v8 == 7) {
        println(".");
    }
    if (t1 == 7 || t2 == 7 || t3 == 7 || t4 == 7 || t6 == 7) { println("."); }
    return 0;
}

# ADR 0002 row 34 (M3 part 2a-2, the user's answer of 2026-11-14): stability on the exact (1 − L/R₁)(1 − L/R₂) and the
# exact g₁·g₂, and w₀ from the inputs' own sums, its bits from validate.py's model (within an ulp of the exact value).
fn cyrius_row34(): i64 {
    test_group("cyrius_resonator_row34 (ADR 0002 row 34)");
    # Two convex mirrors are never stable: with L = 5e-324 and R = −0.5, g = 1 + 1e-323 exactly, which Rust rounds to 1
    # (and calls stable). The rounded fields stay Rust's.
    var st: BjResonatorStability;
    var tiny: f64 = _bj_from_bits(1);
    var t1, v1 = bj_resonator_stability(tiny, -0.5, -0.5, &st);
    var sg: f64 = st.g_product;
    assert(is_ok(t1) == 1 && st.is_stable == 0 && sg == 1.0, "convex–convex: unstable, g₁g₂ still Rust's 1.0");
    # A near-planar cavity of finite radii has its finite waist: Rust's g rounded to 1 and reported the planar cavity.
    var t2, v2 = bj_resonator_beam_waist(0.1, 100000000000000000.0, 100000000000000000.0, 0.000001064);
    assert(is_ok(t2) == 1 && v2 == 0x40139329279B8BDC, "R = 1e17, L = 0.1: w₀ = 4.8937… m, correctly rounded");
    # Where Rust was right the port agrees, and where its chain lost an ulp the port has the exact value's rounding.
    var t3, v3 = bj_resonator_beam_waist(0.1, 0.2, 0.2, 0.000001064);
    assert(is_ok(t3) == 1 && v3 == 0x3F267299FEAD59C2, "R = 2L: Rust's bits");
    var big: f64 = _bj_from_bits(0x7FE1CCF385EBC8A0);
    var t4, v4 = bj_resonator_beam_waist(_bj_from_bits(0x7FAC7B1F3CAC7433), big, big, 0.000001064);
    assert(is_ok(t4) == 1 && v4 == 0x5F2A8F4187AD0389,
      "L = 1e307, R = 1e308: scaled, w₀ rounded once (Rust: an ulp up)");
    # The planar cavity (two flat mirrors) is still refused; the confocal one keeps Rust's limit.
    var inf: f64 = 1.0 / 0.0;
    var t5, v5 = bj_resonator_beam_waist(0.1, inf, inf, 0.000001064);
    assert(is_err_result(t5) == 1 && v5 == BJ_ERR_DIVISION_BY_ZERO, "two flat mirrors: planar");
    var t6, v6 = bj_resonator_beam_waist(0.5, 0.5, 0.5, 0.000001064);
    var cf: f64 = f64_sqrt(0.5 * 0.000001064 / (2.0 * _BJ_PI));
    assert(is_ok(t6) == 1 && v6 == _bj_bits(cf), "confocal: √(Lλ/2π)");
    # The mode spacing decides on the exact g₁·g₂: (1 + 2^-52)(1 − 2^-53) rounds to 1 but exceeds it, and a negative
    # product that underflows to −0 is still negative.
    var t7, v7 = bj_transverse_mode_spacing(1500000000.0, _bj_from_bits(0x3FF0000000000001),
      _bj_from_bits(0x3FEFFFFFFFFFFFFF));
    assert(is_err_result(t7) == 1 && reason_is2("invalid parameter: cavity is unstable (g₁g₂ = 1.0000)", "") == 1,
      "g₁g₂ = 1 + 2^-53 − 2^-105: unstable (Rust: 0 Hz)");
    var t8, v8 = bj_transverse_mode_spacing(1500000000.0, _bj_from_bits(0x16687E92154EF7AC),
      _bj_from_bits(0x96687E92154EF7AC));
    assert(is_err_result(t8) == 1 && reason_is2("invalid parameter: cavity is unstable (g₁g₂ = -0.0000)", "") == 1,
      "g₁g₂ = −1e-400: unstable (Rust: FSR/2)");
    if (v1 == 99 || v5 == 99 || v7 == 99 || v8 == 99) { println("."); }
    return 0;
}

# ADR 0002 row 35 (M3 part 2a-3, the user's answer of 2026-11-14): transform_beam decides on the exact AD − BC, keeps λ
# only when it is exactly 1 and otherwise takes λ·det rounded once; bits from validate.py's model (Fractions).
fn cyrius_row35(): i64 {
    test_group("cyrius_abcd_row35 (ADR 0002 row 35)");
    var g: BjGaussianBeam;
    lab_beam(&g);
    var o: BjGaussianBeam;
    # det = 1 + 1e-13 (two media within 10⁻¹² of each other): λ′ = λ·det, where Rust kept λ.
    var m1: BjAbcdMatrix = BjAbcdMatrix_new(1.0, 0.0, 0.0, 1.0000000000001);
    var t1, v1 = m1.transform_beam(&g, &o);
    var l1: f64 = o.wavelength;
    var w1: f64 = o.waist;
    assert(is_ok(t1) == 1 && _bj_bits(l1) == 0x3EB1D9D85F385CED && _bj_bits(w1) == 0x3F1A36E2EB1C432C,
      "det = 1 + 1e-13: λ′ = 1.0640000000001064e-6, rounded once (Rust: λ)");
    # det exactly 1 from integers (2·2 − 3·1): λ kept bit for bit.
    var m2: BjAbcdMatrix = BjAbcdMatrix_new(2.0, 3.0, 1.0, 2.0);
    var t2, v2 = m2.transform_beam(&g, &o);
    var l2: f64 = o.wavelength;
    var gl: f64 = g.wavelength;
    assert(is_ok(t2) == 1 && l2 == gl, "det = 1 exactly: λ kept");
    # AD − BC = −2^-104 exactly, its rounded value 0: refused, the reason quoting the rounded det.
    var m3: BjAbcdMatrix = BjAbcdMatrix_new(1.0, _bj_from_bits(0x3FF0000000000001), _bj_from_bits(0x3FF0000000000001),
      _bj_from_bits(0x3FF0000000000002));
    var t3, v3 = m3.transform_beam(&g, &o);
    assert(is_err_result(t3) == 1
      && reason_is2("invalid parameter: ABCD determinant must be positive and finite (det = n_in/n_out), got 0", "")
      == 1, "det = −2^-104: refused, as Rust refused its rounded 0");
    # AD − BC = +2^-104 exactly: the determinant passes, and z_R′ (propagate_beam's chain, which cancels in
    # z·(AD − BC)) is refused instead.
    var m4: BjAbcdMatrix = BjAbcdMatrix_new(_bj_from_bits(0x3FF0000000000001), _bj_from_bits(0x3FF0000000000002), 1.0,
      _bj_from_bits(0x3FF0000000000001));
    var keep: BjGaussianBeam = g;
    var t4, v4 = m4.transform_beam(&g, &keep);
    var kw: f64 = keep.waist;
    var gw: f64 = g.waist;
    assert(is_err_result(t4) == 1
      && reason_is2("invalid parameter: transformed beam has non-physical Rayleigh range", "") == 1 && kw == gw,
      "det = +2^-104: past the determinant, refused at z_R′; out untouched");
    if (v1 == 99 || v2 == 99 || v3 == 99 || v4 == 99) { println("."); }
    return 0;
}

# The three structs' JSON (M3 part 1c-2), as serde_json writes and reads them.
fn cyrius_json(): i64 {
    test_group("cyrius_beam_json");
    # serde's exact text.
    var u: BjGaussianBeam;
    var tu, vu = BjGaussianBeam_new(1.0, 1.0, &u);
    var sb1 = str_builder_new();
    var t1, v1 = BjGaussianBeam_to_json(&u, sb1);
    assert(is_ok(tu) == 1 && is_ok(t1) == 1
      && built_is(sb1, "{\"wavelength\":1.0,\"waist\":1.0,\"rayleigh_range\":3.141592653589793}") == 1,
      "a Gaussian beam: its three fields, z_R = π");
    var lens: BjAbcdMatrix;
    var tl, vl = BjAbcdMatrix_thin_lens(0.5, &lens);
    var sb2 = str_builder_new();
    var t2, v2 = BjAbcdMatrix_to_json(&lens, sb2);
    assert(is_ok(t2) == 1 && built_is(sb2, "{\"a\":1.0,\"b\":0.0,\"c\":-2.0,\"d\":1.0}") == 1,
      "an ABCD matrix: a thin lens, f = 0.5");
    var st: BjResonatorStability;
    var ts, vs = bj_resonator_stability(0.1, 0.2, 0.2, &st);
    var sb3 = str_builder_new();
    var t3, v3 = BjResonatorStability_to_json(&st, sb3);
    assert(is_ok(ts) == 1 && is_ok(t3) == 1
      && built_is(sb3, "{\"g1\":0.5,\"g2\":0.5,\"g_product\":0.25,\"is_stable\":true}") == 1,
      "a stable cavity: is_stable as the literal true");
    var un: BjResonatorStability;
    var tn, vn = bj_resonator_stability(1.0, 0.4, 0.4, &un);
    var sb4 = str_builder_new();
    var t4, v4 = BjResonatorStability_to_json(&un, sb4);
    assert(is_ok(tn) == 1 && is_ok(t4) == 1
      && built_is(sb4, "{\"g1\":-1.5,\"g2\":-1.5,\"g_product\":2.25,\"is_stable\":false}") == 1,
      "an unstable one: false");
    var odd: BjResonatorStability = st;
    odd.is_stable = 5;
    var sb5 = str_builder_new();
    var t5, v5 = BjResonatorStability_to_json(&odd, sb5);
    assert(is_ok(t5) == 1
      && built_is(sb5, "{\"g1\":0.5,\"g2\":0.5,\"g_product\":0.25,\"is_stable\":true}") == 1,
      "any is_stable but 0 is written true, as bj_resonator_beam_waist reads it");

    # Round trips, bit for bit, with the longest number bayan writes (25 bytes) in every slot.
    var lg = 0xBEB4B6231ABFD271;
    var words: i64[4];
    for (var k = 0; k < 4; k = k + 1) { words[k] = lg; }
    var lb: BjGaussianBeam;
    memcpy(&lb, &words, 24);
    var sb6 = str_builder_new();
    var t6, v6 = BjGaussianBeam_to_json(&lb, sb6);
    var s6 = str_builder_build(sb6);
    var lbb: BjGaussianBeam;
    var t7, v7 = BjGaussianBeam_from_json(str_data(s6), str_len(s6), &lbb);
    assert(is_ok(t6) == 1 && is_ok(t7) == 1 && memeq(&lbb, &lb, 24) == 1, "three of the longest numbers in a beam's");
    var lm: BjAbcdMatrix;
    memcpy(&lm, &words, 32);
    var sb7 = str_builder_new();
    var t8, v8 = BjAbcdMatrix_to_json(&lm, sb7);
    var s7 = str_builder_build(sb7);
    var lmb: BjAbcdMatrix;
    var t9, v9 = BjAbcdMatrix_from_json(str_data(s7), str_len(s7), &lmb);
    assert(is_ok(t8) == 1 && is_ok(t9) == 1 && memeq(&lmb, &lm, 32) == 1, "four in an ABCD matrix's");
    var ls: BjResonatorStability;
    memcpy(&ls, &words, 24);
    ls.is_stable = 0;
    var sb8 = str_builder_new();
    var t10, v10 = BjResonatorStability_to_json(&ls, sb8);
    var s8 = str_builder_build(sb8);
    var lsb: BjResonatorStability;
    lsb.is_stable = 9;
    var t11, v11 = BjResonatorStability_from_json(str_data(s8), str_len(s8), &lsb);
    assert(is_ok(t10) == 1 && is_ok(t11) == 1 && memeq(&lsb, &ls, 32) == 1 && lsb.is_stable == 0,
      "three and false in a ResonatorStability's, read back as 0");
    var lens2: BjAbcdMatrix;
    var sb9 = str_builder_new();
    var t12, v12 = BjAbcdMatrix_to_json(&lens, sb9);
    var s9 = str_builder_build(sb9);
    var t13, v13 = BjAbcdMatrix_from_json(str_data(s9), str_len(s9), &lens2);
    var st2: BjResonatorStability;
    var s3 = str_builder_build(sb3);
    var t14, v14 = BjResonatorStability_from_json(str_data(s3), str_len(s3), &st2);
    assert(is_ok(t13) == 1 && memeq(&lens2, &lens, 32) == 1 && is_ok(t14) == 1 && memeq(&st2, &st, 32) == 1,
      "a thin lens and a stable cavity come back as they were, true as 1");

    # Reading: both of serde's forms, fields in any order, any values as written.
    var rb: BjGaussianBeam;
    var d1 = "[0.000001064,0,7.5]";
    var t15, v15 = BjGaussianBeam_from_json(d1, strlen(d1), &rb);
    var rw: f64 = rb.waist;
    var rz: f64 = rb.rayleigh_range;
    assert(is_ok(t15) == 1 && rw == 0.0 && rz == 7.5,
      "by position; a zero waist and a z_R that isn't πw₀²/λ read as written (serde calls no constructor)");
    var rm: BjAbcdMatrix;
    var d2 = "{\"d\":4,\"c\":3,\"note\":[true,null],\"b\":2,\"a\":1}";
    var t16, v16 = BjAbcdMatrix_from_json(d2, strlen(d2), &rm);
    var ra: f64 = rm.a;
    var rd: f64 = rm.d;
    assert(is_ok(t16) == 1 && ra == 1.0 && rd == 4.0, "fields in any order, an unknown key skipped");
    var rs: BjResonatorStability;
    var d3 = "[0.5,0.5,0.25,false]";
    var t17, v17 = BjResonatorStability_from_json(d3, strlen(d3), &rs);
    var rgp: f64 = rs.g_product;
    assert(is_ok(t17) == 1 && rgp == 0.25 && rs.is_stable == 0,
      "by position; an is_stable that disagrees with g₁g₂ is kept, as Rust's public field is");
    var d4 = "{\"is_stable\" : true , \"g_product\":9,\"g2\":-3,\"g1\":-3}";
    var t18, v18 = BjResonatorStability_from_json(d4, strlen(d4), &rs);
    assert(is_ok(t18) == 1 && rs.is_stable == 1, "true reads as 1");

    # The reasons, and out untouched: a bool is only JSON's true or false.
    var keep: BjResonatorStability = st;
    var d5 = "{\"g1\":0.5,\"g2\":0.5,\"g_product\":0.25,\"is_stable\":1}";
    var t19, v19 = BjResonatorStability_from_json(d5, strlen(d5), &keep);
    var kg: f64 = keep.g1;
    var w19 = "deserialization failed: invalid type: integer, expected a boolean";
    assert(err_is(t19, v19, BJ_ERR_DESERIALIZE, w19) == 1 && kg == 0.5 && keep.is_stable == 1,
      "1 is not true; out untouched");
    var d6 = "[0.5,0.5,0.25,\"true\"]";
    var t20, v20 = BjResonatorStability_from_json(d6, strlen(d6), &keep);
    var w20 = "deserialization failed: invalid type: string, expected a boolean";
    assert(err_is(t20, v20, BJ_ERR_DESERIALIZE, w20) == 1, "nor is the string \"true\"");
    var d7 = "[0.5,0.5,0.25,null]";
    var t21, v21 = BjResonatorStability_from_json(d7, strlen(d7), &keep);
    var w21 = "deserialization failed: invalid type: null, expected a boolean";
    assert(err_is(t21, v21, BJ_ERR_DESERIALIZE, w21) == 1, "nor null");
    var d8 = "[0.5,0.5,0.25,True]";
    var t22, v22 = BjResonatorStability_from_json(d8, strlen(d8), &keep);
    assert(is_err_result(t22) == 1 && v22 == BJ_ERR_DESERIALIZE && keep.is_stable == 1, "nor True (not JSON)");
    var d9 = "{\"g1\":0.5,\"g2\":0.5,\"g_product\":0.25}";
    var t23, v23 = BjResonatorStability_from_json(d9, strlen(d9), &keep);
    var w23 = "deserialization failed: missing field `is_stable`";
    assert(err_is(t23, v23, BJ_ERR_DESERIALIZE, w23) == 1, "is_stable is required");
    var kb: BjGaussianBeam = u;
    var d10 = "{\"wavelength\":1,\"waist\":1}";
    var t24, v24 = BjGaussianBeam_from_json(d10, strlen(d10), &kb);
    var kz: f64 = kb.rayleigh_range;
    var w24 = "deserialization failed: missing field `rayleigh_range`";
    assert(err_is(t24, v24, BJ_ERR_DESERIALIZE, w24) == 1 && kz == u.rayleigh_range,
      "z_R is required, not recomputed; out untouched");
    var km: BjAbcdMatrix = lens;
    var d11 = "[1,0,-2]";
    var t25, v25 = BjAbcdMatrix_from_json(d11, strlen(d11), &km);
    var w25 = "deserialization failed: invalid length 3, expected struct AbcdMatrix with 4 elements";
    var kc: f64 = km.c;
    assert(err_is(t25, v25, BJ_ERR_DESERIALIZE, w25) == 1 && kc == -2.0, "a short sequence; out untouched");
    var d12 = "{\"a\":1,\"b\":0,\"c\":0,\"d\":false}";
    var t26, v26 = BjAbcdMatrix_from_json(d12, strlen(d12), &km);
    var w26 = "deserialization failed: invalid type: boolean, expected f64";
    assert(err_is(t26, v26, BJ_ERR_DESERIALIZE, w26) == 1, "a bool is not a number either");

    # The heap: 2,000 reads, half refused, leave the freelist's arena and the bump heap as they were.
    var fl0 = _fl_arena_pos;
    var bump0 = alloc_used();
    for (var j = 0; j < 500; j = j + 1) {
        var ta, va = BjResonatorStability_from_json(d4, strlen(d4), &rs);
        var tb, vb = BjResonatorStability_from_json(d5, strlen(d5), &keep);
        var tc, vc = BjGaussianBeam_from_json(d1, strlen(d1), &rb);
        var td, vd = BjAbcdMatrix_from_json(d11, strlen(d11), &km);
        if (va == 7 || vb == 7 || vc == 7 || vd == 7) { println("."); }
    }
    assert_eq(_fl_arena_pos, fl0, "the freelist's arena did not grow");
    assert_eq(alloc_used(), bump0, "nothing on the bump heap");
    if (vu == 7 || v1 == 7 || v2 == 7 || v3 == 7 || v4 == 7 || v5 == 7 || v6 == 7 || v7 == 7 || v8 == 7) {
        println(".");
    }
    if (v9 == 7 || v10 == 7 || v11 == 7 || v12 == 7 || v13 == 7 || v14 == 7 || v15 == 7 || v16 == 7 || v17 == 7) {
        println(".");
    }
    if (v18 == 7 || vl == 7 || vs == 7 || vn == 7 || tl == 7 || t12 == 7) { println("."); }
    return 0;
}

# Runs beam.rs's tests, then the Cyrius-only checks.
fn main(): i64 {
    alloc_init();
    rust_tests_a();
    rust_tests_b();
    rust_tests_c();
    rust_tests_d();
    cyrius_tests();
    cyrius_row34();
    cyrius_row35();
    cyrius_json();
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
