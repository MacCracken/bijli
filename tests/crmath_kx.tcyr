fn _t_mono_values() {
    test_group("cr_mono_values (ADR 0002 #27, #28)");
    var bad = 0;
    var bad_fast = 0;
    var k = 0;
    while (k < 36) {
        var row = &_T_MONO + 104 * k;
        var nn = load64(row);
        var nd = load64(row + 8);
        var want = load64(row + 96);
        var r: f64 = _bj_k_cr_mono(row + 16, nn, row + 64, nd);
        var a: f64 = _bj_k_cr_mono_acc(row + 16, nn, row + 64, nd);
        if (ulp_bits_match(_bj_k_bits(r), want) != 1 || ulp_bits_match(_bj_k_bits(a), want) != 1) {
            bad = bad + 1;
            ulp_print_pair(_bj_k_bits(r), want);
        }
        var f, ok = _bj_k_cr_mono_fast(row + 16, nn, row + 64, nd);
        if (ok == 1 && ulp_bits_match(_bj_k_bits(f), want) != 1) { bad_fast = bad_fast + 1; }
        k = k + 1;
    }
    assert_eq(bad, 0, "the monomial and its exact path: every case correctly rounded");
    assert_eq(bad_fast, 0, "the fast path, where it answers, agrees");
    # the shapes the modules call are the general monomial
    var y: f64 = 3002399751580331.0;        # 3y = 2^53 + 1
    var m3: f64 = _bj_k_cr_mul3(3.0, y, 1.0);
    assert_eq(_bj_k_bits(m3), 0x4340000000000000, "_bj_k_cr_mul3(3, y, 1) = 2^53: the tie to even");
    var md: f64 = _bj_k_cr_mul_div(y, 3.0, 2.0);
    assert_eq(_bj_k_bits(md), 0x4330000000000000, "_bj_k_cr_mul_div(y, 3, 2) = 2^52: the tie to even");
    var dmax: f64 = 0x7FEFFFFFFFFFFFFF;
    var d2: f64 = _bj_k_cr_div2(4184.0, 1000.0, dmax);
    assert_eq(_bj_k_bits(d2), 0x0010BC6A7EF9DB23, "_bj_k_cr_div2(4184, 1000, DBL_MAX) = 2.33·10⁻³⁰⁸ (Rust's 0)");
    var big: f64 = 0x7E37E43C8800759C;      # 1e300
    var zp: f64 = _bj_k_cr_mul3_div(big, big, 0.0, 1.0);
    assert_eq(_bj_k_bits(zp), 0, "_bj_k_cr_mul3_div(1e300, 1e300, 0, 1) = +0 (Rust's ∞·0 = NaN)");
    var nz: f64 = -0.0;
    var zn: f64 = _bj_k_cr_mul3_div(big, big, nz, 1.0);
    assert_eq(_bj_k_bits(zn), 0x8000000000000000, "… with −0: −0");
    var r5: f64 = _bj_k_cr_mul5(2.0, 0.1, 8.314462618, 1000.0, 298.15);
    var w5: f64 = 0x411E42BD9FA738EA;
    assert_eq(_bj_k_bits(r5), _bj_k_bits(w5), "_bj_k_cr_mul5: osmotic_pressure(2, 0.1, 298.15)'s i·M·R·1000·T");
    # the exact path's capacity: six factors of 53-bit odd significands (318 bits) are outside it (NaN)
    var cap: f64[6];
    var j = 0;
    while (j < 6) {
        store64(&cap + 8 * j, 0x3FFFFFFFFFFFFFFF);  # (2^53 − 1)·2^-52
        j = j + 1;
    }
    var cn: f64 = _bj_k_cr_mono_acc(&cap, 6, 0, 0);
    assert_eq(_bj_k_is_nan(cn), 1, "past the exact path's 253-bit capacity: NaN");
    var cf, cfo = _bj_k_cr_mono_fast(&cap, 6, 0, 0);
    var cw: f64 = 0x404FFFFFFFFFFFFA;       # RN(((2^53 − 1)/2^52)^6)
    assert(cfo == 1 && _bj_k_bits(cf) == _bj_k_bits(cw), "the fast path answers six factors (its test passes)");
    var many: f64[7];
    var mn, mno = _bj_k_cr_mono_fast(&many, 7, 0, 0);
    assert(mno == 1 && _bj_k_is_nan(mn) == 1, "more than six numerator factors: NaN");
}

# The exact sign of a sum of doubles (Shewchuk's Grow-Expansion) and the tie resolution on hand-made cases.
fn _t_mono_sign_and_tie() {
    test_group("cr_mono_sign_and_tie (ADR 0002 #27, #28)");
    var t: f64[4];
    var e100: f64 = 0x39B0000000000000;     # 2^-100
    var sub1: f64 = from_bits(1);           # 2^-1074
    var mone: f64 = -1.0;
    store64(&t, 1.0);
    store64(&t + 8, mone);
    assert_eq(_bj_k_exp_sign(&t, 2), 0, "1 − 1 = 0");
    store64(&t + 16, e100);
    assert_eq(_bj_k_exp_sign(&t, 3), 1, "1 − 1 + 2^-100 > 0");
    var me: f64 = -e100;
    store64(&t + 16, me);
    assert_eq(_bj_k_exp_sign(&t, 3), 0 - 1, "1 − 1 − 2^-100 < 0");
    store64(&t, e100);
    store64(&t + 8, 1.0);
    store64(&t + 16, mone);
    store64(&t + 24, sub1);
    assert_eq(_bj_k_exp_sign(&t, 4), 1, "2^-100 + 1 − 1 + 2^-1074 > 0");
    var nsub: f64 = -sub1;
    store64(&t, nsub);
    store64(&t + 8, 1.0);
    store64(&t + 16, mone);
    assert_eq(_bj_k_exp_sign(&t, 3), 0 - 1, "−2^-1074 + 1 − 1 < 0");
    assert_eq(_bj_k_exp_sign(&t, 0), 0, "the empty sum");
    # F = 1.5·s_y = 3y·2^-52 = 2 + 2^-52 with 3y = 2^53 + 1 (s_y = y·2^-51): exactly the midpoint of 2 and its successor
    var sn: f64[3];
    var sd: f64[2];
    var sy: f64 = 0x3FF5555555555556;       # y·2^-51 = 1.3333333333333335
    store64(&sn, 1.5);
    store64(&sn + 8, sy);
    var z1: f64 = 2.0;
    var zb = _bj_k_bits(z1) + 1;
    var z2: f64 = zb;
    var tie: f64 = _bj_k_mono_tie(&sn, 2, &sd, 0, z1, z2);
    assert_eq(_bj_k_bits(tie), _bj_k_bits(z1), "F = 2 + 2^-52, the midpoint of 2 and its successor: the even one, 2");
    var one: f64 = 1.0;
    var ob = _bj_k_bits(one) - 1;
    var zl: f64 = ob;
    var t2: f64 = _bj_k_mono_tie(&sn, 0, &sd, 0, zl, one);
    assert_eq(_bj_k_bits(t2), _bj_k_bits(one), "N = 1 against pred(1) and 1: above their midpoint, 1");
    # (a_h + a_l)·b: exact here
    var h, l = _bj_k_dd_mul_d(3.0, 0.0, 1.5);
    assert(h == 4.5 && l == 0.0, "_bj_k_dd_mul_d(3, 0, 1.5) = 4.5");
}

# The monomial against its exact path on 20,000 seeded shapes and factors (at most four of 53 bits a side, so inside the
# exact path's capacity), both signs, subnormals and the range ends included; and the fast path wherever it answers.
fn _t_mono_agrees() {
    test_group("cr_mono_agrees (ADR 0002 #27, #28)");
    var st = 0x2545F4914F6CDD1D;
    var bad = 0;
    var answered = 0;
    var nb: f64[4];
    var db: f64[4];
    var k = 0;
    while (k < 20000) {
        st = st ^ (st << 13);
        st = st ^ (st >> 7);
        st = st ^ (st << 17);
        var nn = (st >> 3) % 5;
        var nd = (st >> 9) % 5;
        var j = 0;
        while (j < nn + nd) {
            st = st ^ (st << 13);
            st = st ^ (st >> 7);
            st = st ^ (st << 17);
            var x: f64 = ux_rand(st, k % 3);
            if (x != x || x - x != 0.0 || x == 0.0) { x = 1.25; }
            if (j < nn) { store64(&nb + 8 * j, x); } else { store64(&db + 8 * (j - nn), x); }
            j = j + 1;
        }
        var r: f64 = _bj_k_cr_mono(&nb, nn, &db, nd);
        var a: f64 = _bj_k_cr_mono_acc(&nb, nn, &db, nd);
        if (_bj_k_bits(r) != _bj_k_bits(a)) { bad = bad + 1; }
        var f, ok = _bj_k_cr_mono_fast(&nb, nn, &db, nd);
        if (ok == 1) {
            answered = answered + 1;
            if (_bj_k_bits(f) != _bj_k_bits(a)) { bad = bad + 1; }
        }
        k = k + 1;
    }
    assert_eq(bad, 0, "the monomial, its fast path and its exact path agree on 20,000 seeded arguments");
    assert(answered > 10000, "the fast path answers most of them");
}

# The overflow audit's B2 (ADR 0002 #29, #30): the four new monomial shapes and the correctly rounded √ of a quotient on
# hand cases — exact roots, Rust's ∞ and 0 where the value is representable, a subnormal result, the overflow end, the
# domain, roots within 2⁻¹⁰⁷ of a 53-bit midpoint (the fast path's test fails), the shapes' midpoints — each against
# MPFR's / Fraction's correctly rounded value, by the public helper and its exact path.
fn _t_b2_values() {
    test_group("b2_values (ADR 0002 #29, #30)");
    var dmax: f64 = from_bits(0x7FEFFFFFFFFFFFFF);
    var nmin: f64 = from_bits(0x0010000000000000);
    var sub1: f64 = from_bits(1);
    var e300: f64 = from_bits(0x01A56E1FC2F8F359);      # 1e-300
    var a: f64 = _bj_k_cr_sqrt_div(4.0, 1.0);
    assert_eq(_bj_k_bits(a), 0x4000000000000000, "√(4/1) = 2, exact");
    var b: f64 = _bj_k_cr_sqrt_div(2.0, 1.0);
    assert_eq(_bj_k_bits(b), 0x3FF6A09E667F3BCD, "√2");
    var c: f64 = _bj_k_cr_sqrt_div(9.0, 0.25);
    assert_eq(_bj_k_bits(c), 0x4018000000000000, "√(9/0.25) = 6, exact");
    var d: f64 = _bj_k_cr_sqrt_div(500.0, nmin);
    assert_eq(_bj_k_bits(d), 0x60265C55827DF1D2, "√(500/2^-1022) = 1.50·10¹⁵⁵ (Rust's (k/μ).sqrt(): ∞)");
    var e30: f64 = from_bits(0x46293E5939A08CEA);       # 1e30
    var e: f64 = _bj_k_cr_sqrt_div(e300, e30);
    assert_eq(_bj_k_bits(e), 0x1DAD7BECC2F23AC2, "√(10⁻³⁰⁰/10³⁰) = 10⁻¹⁶⁵ (Rust's 0)");
    var f: f64 = _bj_k_cr_sqrt_div(dmax, nmin);
    assert_eq(_bj_k_bits(f), 0x7FDFFFFFFFFFFFFF, "√(DBL_MAX/2^-1022) = 2^1023·√(2 − 2^-52) (Rust's ∞)");
    var g: f64 = _bj_k_cr_sqrt_div(e300, sub1);
    assert_eq(_bj_k_bits(g), 0x425A2FE76A3F9475, "a subnormal μ: the exact path");
    var h: f64 = _bj_k_cr_sqrt_div(sub1, dmax);
    assert_eq(_bj_k_bits(h), 0x0000000002000000, "√(2^-1074/DBL_MAX): a subnormal result, 2^-1049 (Rust's 0)");
    var i: f64 = _bj_k_cr_sqrt_div(dmax, sub1);
    assert_eq(_bj_k_bits(i), 0x7FF0000000000000, "√(DBL_MAX/2^-1074) past DBL_MAX: +∞");
    var hk: f64 = 516.0;
    var hm: f64 = from_bits(0x3A601BEBC23E3327);        # 1.6266e-27 kg: HCl
    var j: f64 = _bj_k_cr_sqrt_div(hk, hm);
    assert_eq(_bj_k_bits(j), 0x43000206751AA800, "HCl's ω = √(516/1.6266·10⁻²⁷) (Rust's one ulp below)");
    var nk: f64 = from_bits(0x3E57E3046A1F3250);
    var nm: f64 = from_bits(0x3DD3D9DC063D8070);
    var k1: f64 = _bj_k_cr_sqrt_div(nk, nm);
    var k2: f64 = _bj_k_sqrt_div_acc(nk, nm);
    var kf, ko = _bj_k_sqrt_div_fast(nk, nm);
    assert(_bj_k_bits(k1) == 0x40318D1D41DCE77F && _bj_k_bits(k2) == 0x40318D1D41DCE77F && ko == 0,
      "√(k/μ) 10⁻³² from a midpoint: the fast test fails, the exact root rounds down (Rust's up)");
    var nk2: f64 = from_bits(0x2A6C395DF951EF97);
    var nm2: f64 = from_bits(0x29418CDED749A2CF);
    var l: f64 = _bj_k_cr_sqrt_div(nk2, nm2);
    assert_eq(_bj_k_bits(l), 0x40844A4FA43E7741, "… and one just above a midpoint rounds up (Rust's down)");
    var m0: f64 = _bj_k_cr_sqrt_div(0.0, 1.0);
    var m1: f64 = _bj_k_cr_sqrt_div(1.0, 0.0);
    var mn: f64 = -1.0;
    var m2: f64 = _bj_k_cr_sqrt_div(mn, 1.0);
    var inf: f64 = 1.0 / 0.0;
    var m3: f64 = _bj_k_cr_sqrt_div(inf, 1.0);
    var m4: f64 = _bj_k_sqrt_div_acc(1.0, inf);
    var nans = _bj_k_is_nan(m0) + _bj_k_is_nan(m1) + _bj_k_is_nan(m2) + _bj_k_is_nan(m3) + _bj_k_is_nan(m4);
    assert_eq(nans, 5, "outside the positive finite domain: NaN");
    # the shapes: midpoints resolved to even, Rust's out-of-range partial products
    var y: f64 = 3002399751580331.0;                    # 3y = 2^53 + 1
    var fc: f64 = from_bits(0x40F78E555060882C);        # FARADAY = 96485.33212331001
    var f3: f64 = fc * 3.0;
    var p1: f64 = _bj_k_cr_mul2_div2(f3, y, 1.0, fc);
    assert_eq(_bj_k_bits(p1), 0x4340000000000000, "3F·y/(1·F) = 2^53 + 1, a tie: 2^53 (Rust's (3F·y)/F 2^53 + 2)");
    var p2: f64 = _bj_k_cr_mul3_div2(y, 14.0, 3.0, 2.0, 7.0);
    assert_eq(_bj_k_bits(p2), 0x4340000000000000, "y·14·3/(2·7) = 3y, a tie: 2^53");
    var hc: f64 = from_bits(0x390B860BDE023111);        # PLANCK = 6.62607015e-34
    var jm: f64 = 4294967295.0;
    var j1: f64 = 4294967296.0;
    var p3: f64 = _bj_k_cr_mul4(hc, e300, jm, j1);
    assert_eq(_bj_k_bits(p3), 0x0000000093757F20, "h·10⁻³⁰⁰·(2³² − 1)·2³² = 1.22·10⁻³¹⁴, subnormal (Rust's 0)");
    var pi: f64 = from_bits(0x400921FB54442D18);
    var e320: f64 = from_bits(0x00000000000007E8);      # 1e-320
    var h8: f64 = hc * 0.125;
    var p4: f64 = _bj_k_cr_div3(h8, pi, pi, e320);
    assert_eq(_bj_k_bits(p4), 0x7B16930879281B34, "h/(8π²·10⁻³²⁰) = 8.392109·10²⁸⁴ (Rust's 8.392090·10²⁸⁴)");
    var p5: f64 = _bj_k_cr_mul2_div2(dmax, 63.546, 2.0, fc);
    assert_eq(_bj_k_bits(p5), 0x7F3594CDA6DEAC17, "DBL_MAX·63.546/(2F) = 5.92·10³⁰⁴ (Rust's ∞)");
    var p6: f64 = _bj_k_cr_mul3_div2(1.0, e300, 3.0, 1.0, sub1);
    assert_eq(_bj_k_bits(p6), 0x44E01297D23AB683, "1·10⁻³⁰⁰·3/(1·2^-1074) = 6.07·10²³ (Rust's ∞)");
    var mz: f64 = -0.0;
    var p7: f64 = _bj_k_cr_mul4(hc, mz, 1.0, 2.0);
    assert_eq(_bj_k_bits(p7), 0x8000000000000000, "a zero factor: its signed zero");
}

# The four new shapes against the general monomial's exact path, and _bj_k_cr_sqrt_div against _bj_k_sqrt_div_acc, on
# 20,000 seeded arguments each (both signs for the shapes, positive for the root; subnormals and the range ends
# included), and every fast path wherever it answers.
fn _t_b2_agrees() {
    test_group("b2_agrees (ADR 0002 #29, #30)");
    var st = 0x2545F4914F6CDD1D;
    var bad = 0;
    var answered = 0;
    var w: f64[5];
    var k = 0;
    while (k < 20000) {
        var j = 0;
        while (j < 5) {
            st = st ^ (st << 13);
            st = st ^ (st >> 7);
            st = st ^ (st << 17);
            var x: f64 = ux_rand(st, k % 3);
            if (x != x || x - x != 0.0 || x == 0.0) { x = 1.25; }
            store64(&w + 8 * j, x);
            j = j + 1;
        }
        var a: f64 = load64(&w);
        var b: f64 = load64(&w + 8);
        var c: f64 = load64(&w + 16);
        var d: f64 = load64(&w + 24);
        var e: f64 = load64(&w + 32);
        var r1: f64 = _bj_k_cr_mul2_div2(a, b, c, d);
        var x1: f64 = _bj_k_cr_mono_acc(&w, 2, &w + 16, 2);
        if (_bj_k_bits(r1) != _bj_k_bits(x1)) { bad = bad + 1; }
        var r2: f64 = _bj_k_cr_mul3_div2(a, b, c, d, e);
        var x2: f64 = _bj_k_cr_mono_acc(&w, 3, &w + 24, 2);
        if (_bj_k_bits(r2) != _bj_k_bits(x2)) { bad = bad + 1; }
        var r3: f64 = _bj_k_cr_mul4(a, b, c, d);
        var x3: f64 = _bj_k_cr_mono_acc(&w, 4, 0, 0);
        if (_bj_k_bits(r3) != _bj_k_bits(x3)) { bad = bad + 1; }
        var r4: f64 = _bj_k_cr_div3(a, b, c, d);
        var x4: f64 = _bj_k_cr_mono_acc(&w, 1, &w + 8, 3);
        if (_bj_k_bits(r4) != _bj_k_bits(x4)) { bad = bad + 1; }
        var aa: f64 = f64_abs(a);
        var ab: f64 = f64_abs(b);
        var r5: f64 = _bj_k_cr_sqrt_div(aa, ab);
        var x5: f64 = _bj_k_sqrt_div_acc(aa, ab);
        if (_bj_k_bits(r5) != _bj_k_bits(x5)) { bad = bad + 1; }
        var f5, o5 = _bj_k_sqrt_div_fast(aa, ab);
        if (o5 == 1) {
            answered = answered + 1;
            if (_bj_k_bits(f5) != _bj_k_bits(x5)) { bad = bad + 1; }
        }
        k = k + 1;
    }
    assert_eq(bad, 0, "the shapes and the root agree with their exact paths on 20,000 seeded arguments");
    assert(answered > 10000, "the root's fast path answers most of them");
}

# The overflow audit's B3 (ADR 0002 #32): _bj_k_cr_mul_sqrt_ratio on hand cases — its midpoints (ties to even, at the
# 53-bit and the subnormal grid), the Morse width's edges (μ/(2·D_e) past either end, a subnormal result, the overflow
# end), the domain — each against Fraction's correctly rounded value, by the public helper and its exact path; and
# _bj_k_ux_normal at its edges (2⁻¹⁰²² itself is out: its exact value may lie below at 53 bits).
fn _t_b3_values() {
    test_group("b3_values (ADR 0002 #31, #32)");
    var dmax: f64 = from_bits(0x7FEFFFFFFFFFFFFF);
    var sub1: f64 = from_bits(1);
    var y: f64 = 3002399751580331.0;                    # 3y = 2⁵³ + 1
    var a: f64 = _bj_k_cr_mul_sqrt_ratio(y, 9.0, 0.5, 0 - 1);
    var a2: f64 = _bj_k_mul_sqrt_ratio_acc(y, 9.0, 0.5, 0 - 1);
    var af, ao = _bj_k_mul_sqrt_ratio_fast(y, 9.0, 0.5, 0 - 1);
    assert(_bj_k_bits(a) == 0x4340000000000000 && _bj_k_bits(a2) == 0x4340000000000000 && ao == 0,
      "y·√(9/1) = 2⁵³ + 1, a midpoint: the fast test fails, the exact root ties to even (2⁵³)");
    var y7: f64 = 3002399751580333.0;                   # 3y = 2⁵³ + 7
    var b: f64 = _bj_k_cr_mul_sqrt_ratio(y7, 9.0, 1.0, 0);
    assert_eq(_bj_k_bits(b), 0x4340000000000004, "y·√9 = 2⁵³ + 7, a midpoint: to even (2⁵³ + 8)");
    var w975: f64 = from_bits(0x0300000000000000);      # 2⁻⁹⁷⁵
    var p200: f64 = from_bits(0x4C70000000000000);      # 2²⁰⁰
    var c: f64 = _bj_k_cr_mul_sqrt_ratio(w975, 1.0, p200, 0);
    assert_eq(_bj_k_bits(c), 0, "2⁻⁹⁷⁵·√(2⁻²⁰⁰) = 2⁻¹⁰⁷⁵, half the smallest subnormal: a tie, to +0");
    var w3: f64 = w975 * 3.0;
    var d: f64 = _bj_k_cr_mul_sqrt_ratio(w3, 1.0, p200, 0);
    assert_eq(_bj_k_bits(d), 2, "3·2⁻¹⁰⁷⁵, a tie of the subnormal grid: to even (2·2⁻¹⁰⁷⁴)");
    var hw: f64 = 563400000000000.0;
    var hm: f64 = from_bits(0x3A601C2CA997C94D);        # 1.6267e-27 kg
    var hd: f64 = from_bits(0x3C2B4C286D889BBE);        # 7.399e-19 J
    var e: f64 = _bj_k_cr_mul_sqrt_ratio(hw, hm, hd, 0 - 1);
    assert_eq(_bj_k_bits(e), 0x4211659438F30432, "HCl's Morse width a = ω·√(μ/(2·D_e))");
    var f: f64 = _bj_k_cr_mul_sqrt_ratio(hw, dmax, hd, 0 - 1);
    assert_eq(_bj_k_bits(f), 0x64D884C2E88F61B2, "μ = DBL_MAX: 6.21·10¹⁷⁷ (Rust's μ/(2·D_e) = ∞)");
    var d23: f64 = from_bits(0x7FE0000000000000);       # 2¹⁰²³
    var g: f64 = _bj_k_cr_mul_sqrt_ratio(1.0, sub1, d23, 0 - 1);
    assert_eq(_bj_k_bits(g), 0x0000000002000000, "√(2⁻¹⁰⁷⁴/2¹⁰²⁴) = 2⁻¹⁰⁴⁹, subnormal (Rust 0)");
    var h: f64 = _bj_k_cr_mul_sqrt_ratio(dmax, 4.0, 0.5, 0 - 1);
    assert_eq(_bj_k_bits(h), 0x7FF0000000000000, "DBL_MAX·2: past DBL_MAX, +∞");
    var i: f64 = _bj_k_cr_mul_sqrt_ratio(sub1, sub1, dmax, 0 - 1);
    assert_eq(_bj_k_bits(i), 0, "2⁻¹⁰⁷⁴·√(2⁻¹⁰⁷⁴/(2·DBL_MAX)): below half of 2⁻¹⁰⁷⁴, +0");
    var j: f64 = _bj_k_cr_mul_sqrt_ratio(1.0, 1.0, dmax, 0 - 1);
    assert_eq(_bj_k_bits(j), 0x1FE6A09E667F3BCD, "√(½/DBL_MAX) = 5.27·10⁻¹⁵⁵");
    var k1: f64 = _bj_k_cr_mul_sqrt_ratio(5.0, 4.0, 1.0, 2);
    assert_eq(_bj_k_bits(k1), 0x4034000000000000, "5·√(4·2²) = 20, exact (e = 2)");
    var mn: f64 = -1.0;
    var inf: f64 = 1.0 / 0.0;
    var m0: f64 = _bj_k_cr_mul_sqrt_ratio(0.0, 1.0, 1.0, 0);
    var m1: f64 = _bj_k_cr_mul_sqrt_ratio(1.0, mn, 1.0, 0);
    var m2: f64 = _bj_k_cr_mul_sqrt_ratio(1.0, 1.0, inf, 0);
    var m3: f64 = _bj_k_mul_sqrt_ratio_acc(inf, 1.0, 1.0, 0);
    var nans = _bj_k_is_nan(m0) + _bj_k_is_nan(m1) + _bj_k_is_nan(m2) + _bj_k_is_nan(m3);
    assert_eq(nans, 4, "outside the positive finite domain: NaN");
    var n1: f64 = from_bits(0x0010000000000000);
    var n2: f64 = from_bits(0x0010000000000001);
    var n3: f64 = from_bits(0x0020000000000000);
    var nn = _bj_k_ux_normal(n1) * 100 + _bj_k_ux_normal(n2) * 10 + _bj_k_ux_normal(n3);
    assert_eq(nn, 1, "_bj_k_ux_normal: 2⁻¹⁰²² and its successor are out, 2⁻¹⁰²¹ in");
    var nd = _bj_k_ux_normal(dmax) + _bj_k_ux_normal(inf) + _bj_k_ux_normal(-dmax) + _bj_k_ux_normal(0.0) +
    _bj_k_ux_normal(sub1);
    assert_eq(nd, 2, "… ±DBL_MAX in, ∞, 0 and a subnormal out");
}

# _bj_k_cr_mul_sqrt_ratio against _bj_k_mul_sqrt_ratio_acc on 20,000 seeded positive arguments (subnormals and the range
# ends included, e in [−3, 3]), and the fast path wherever it answers.
fn _t_b3_agrees() {
    test_group("b3_agrees (ADR 0002 #32)");
    var st = 0x2545F4914F6CDD1D;
    var bad = 0;
    var answered = 0;
    var w: f64[3];
    var k = 0;
    while (k < 20000) {
        var j = 0;
        while (j < 3) {
            st = st ^ (st << 13);
            st = st ^ (st >> 7);
            st = st ^ (st << 17);
            var x: f64 = ux_rand(st, k % 3);
            if (x != x || x - x != 0.0 || x == 0.0) { x = 1.25; }
            var ax: f64 = f64_abs(x);
            store64(&w + 8 * j, ax);
            j = j + 1;
        }
        var a: f64 = load64(&w);
        var b: f64 = load64(&w + 8);
        var c: f64 = load64(&w + 16);
        var e = (st >> 5) % 7 - 3;
        var r: f64 = _bj_k_cr_mul_sqrt_ratio(a, b, c, e);
        var x2: f64 = _bj_k_mul_sqrt_ratio_acc(a, b, c, e);
        if (_bj_k_bits(r) != _bj_k_bits(x2)) { bad = bad + 1; }
        var f, o = _bj_k_mul_sqrt_ratio_fast(a, b, c, e);
        if (o == 1) {
            answered = answered + 1;
            if (_bj_k_bits(f) != _bj_k_bits(x2)) { bad = bad + 1; }
        }
        k = k + 1;
    }
    assert_eq(bad, 0, "the root agrees with its exact path on 20,000 seeded arguments");
    assert(answered > 10000, "the fast path answers most of them");
}

# Runs every copied group; returns the failure count from assert_summary().
fn main() {
    _t_ux_values();
    _t_ux_ieee();
    _t_bn_ratio_values();
    _t_bn_ratio_agrees();
    _t_mono_values();
    _t_mono_sign_and_tie();
    _t_mono_agrees();
    _t_b2_values();
    _t_b2_agrees();
    _t_b3_values();
    _t_b3_agrees();
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
