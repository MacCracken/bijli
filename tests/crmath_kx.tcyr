# crmath_kx.tcyr — kimiya's tests of src/crmath_kx.cyr (bijli M1 part 5).
#
# GENERATED by scripts/port/kimiya_closure.py from kimiya's tests/mathx.tcyr: its ux, multi-word integer, RN(p/q·2^e),
# monomial, B2 and B3 groups with the same renames, their ux atan2 checks dropped (bijli copies no unbounded atan2).
# Every expected bit pattern is kimiya's (MPFR 4.2.2, or Python's Fraction). Do not edit: re-run the script.

include "tests/lib.cyr"

include "tests/ulp.cyr"

# The f64 with bit pattern b.
#must_use
fn from_bits(b): f64 {
    var x: f64 = 0.0;
    store64(&x, b);
    return x;
}

# ── binary64 with an unbounded exponent (M4e-2): ADR 0002 #20 ───────────────────────────────────────────────

# The final operation `op` (0 √ of the first, 1 ×, 2 ÷, 3 +, 4 atan2(first, second)) of s1·2^e1 and s2·2^e2.
#must_use
fn uxf(op, s1b, e1, s2b, e2): f64 {
    var s1: f64 = from_bits(s1b);
    var s2: f64 = from_bits(s2b);
    if (op == 0) { var a: f64 = _bj_k_ux_sqrt_f64(s1, e1); return a; }
    if (op == 1) { var b: f64 = _bj_k_ux_mul_f64(s1, e1, s2, e2); return b; }
    if (op == 2) { var c: f64 = _bj_k_ux_div_f64(s1, e1, s2, e2); return c; }
    if (op == 3) { var d: f64 = _bj_k_ux_add_f64(s1, e1, s2, e2); return d; }
    var f: f64 = 0.0 / 0.0;                        # bijli: op 4 (atan2) is not copied
    return f;
}

# (op, s1 bits, e1 + 8192, s2 bits, e2 + 8192, expected bits): MPFR 4.2.2's exact operation on values far outside
# binary64's range, rounded once into binary64 (scripts/oracle/mpfr_ref.py's UX at MPFR's widest exponent range, then
# mpfr_check_range and mpfr_subnormalize): subnormal results and their ties (2^-1075 to 0; a sticky term above it to
# 2^-1074), overflow, a sum whose smaller term only breaks a tie, atan2 of exponent differences past 2^±2000.
var _T_UX: i64[288] = {
    0, 0x3FF0000000000000, 6042, 0x0000000000000000, 8192, 0x0000000000000000,     # sqrt: 0.0
    0, 0x3FF0000000000004, 6042, 0x0000000000000000, 8192, 0x0000000000000001,     # sqrt: 5e-324
    0, 0x3FF0000000000000, 6044, 0x0000000000000000, 8192, 0x0000000000000001,     # sqrt: 5e-324
    0, 0x3FF8000000000000, 6043, 0x0000000000000000, 8192, 0x0000000000000001,     # sqrt: 5e-324
    0, 0x3FF0000000000000, 10240, 0x0000000000000000, 8192, 0x7FF0000000000000,     # sqrt: inf
    0, 0x3FFFFFFFFFFFFFFF, 10239, 0x0000000000000000, 8192, 0x7FEFFFFFFFFFFFFF,     # sqrt: 1.7976931348623157e+308
    0, 0x3FF0000000000000, 10238, 0x0000000000000000, 8192, 0x7FE0000000000000,     # sqrt: 8.98846567431158e+307
    0, 0x3FF4000000000000, 6092, 0x0000000000000000, 8192, 0x00000000011E377A,     # sqrt: 9.2674354e-317
    0, 0x3FF0000000000000, 5992, 0x0000000000000000, 8192, 0x0000000000000000,     # sqrt: 0.0
    0, 0x3FF0000000000000, 7192, 0x0000000000000000, 8192, 0x20B0000000000000,     # sqrt: 3.054936363499605e-151
    0, 0x3FFC000000000000, 8293, 0x0000000000000000, 8192, 0x431DEEEA11683F49,     # sqrt: 2106365851602898.2
    1, 0x3FF8000000000000, 7118, 0x3FF0000000000000, 8191, 0x0000000000000001,     # mul: 5e-324
    1, 0x3FF0000000000000, 7117, 0x3FF0000000000000, 8192, 0x0000000000000000,     # mul: 0.0
    1, 0x3FF8000000000000, 7116, 0x3FF0000000000000, 8192, 0x0000000000000000,     # mul: 0.0
    1, 0x3FF4000000000000, 7116, 0x3FF0000000000000, 8192, 0x0000000000000000,     # mul: 0.0
    1, 0x3FF0000000000001, 7654, 0x3FF0000000000000, 7654, 0x0000000000000000,     # mul: 0.0
    1, 0x3FFFFFFFFFFFFFFF, 8792, 0x3FFFFFFFFFFFFFFF, 8615, 0x7FF0000000000000,     # mul: inf
    1, 0x3FF0000000000000, 10192, 0x3FF0000000000000, 7192, 0x7E70000000000000,     # mul: 1.0715086071862673e+301
    1, 0x3FF0000000000000, 6192, 0x3FF0000000000000, 9692, 0x20B0000000000000,     # mul: 3.054936363499605e-151
    1, 0x3FF8000000000000, 9215, 0x3FF8000000000000, 8192, 0x7FF0000000000000,     # mul: inf
    1, 0x3FF4CCCCCCCCCCCD, 7592, 0x3FFB333333333333, 7692, 0x0000000000000000,     # mul: 0.0
    1, 0xBFF199999999999A, 7492, 0x3FFE666666666666, 7819, 0x8000000000000004,     # mul: -2e-323
    2, 0x3FF0000000000000, 7192, 0x3FF8000000000000, 8266, 0x0000000000000001,     # div: 5e-324
    2, 0x3FF0000000000000, 7192, 0x3FF8000000000000, 8268, 0x0000000000000000,     # div: 0.0
    2, 0x3FF0000000000000, 10192, 0x3FF0000000000000, 9169, 0x7FE0000000000000,     # div: 8.98846567431158e+307
    2, 0x3FF0000000000000, 11192, 0x3FF0000000000000, 10169, 0x7FE0000000000000,     # div: 8.98846567431158e+307
    2, 0x3FFB333333333333, 8182, 0x3FF4CCCCCCCCCCCD, 9292, 0x0000000000000000,     # div: 0.0
    2, 0xBFF4000000000000, 7118, 0x3FF0000000000000, 8193, 0x8000000000000001,     # div: -5e-324
    3, 0x3FF0000000000000, 7117, 0x3FF0000000000000, 6992, 0x0000000000000001,     # add: 5e-324
    3, 0x3FF0000000000000, 7117, 0xBFF0000000000000, 6992, 0x0000000000000000,     # add: 0.0
    3, 0x3FF0000000000000, 7117, 0x3FF0000000000000, 7117, 0x0000000000000001,     # add: 5e-324
    3, 0x3FF8000000000000, 7117, 0x3FF0000000000000, 7116, 0x0000000000000001,     # add: 5e-324
    3, 0x3FF0000000000000, 9215, 0x3FF0000000000000, 9215, 0x7FF0000000000000,     # add: inf
    3, 0x3FFFFFFFFFFFFFFF, 9215, 0x3FF0000000000000, 9162, 0x7FF0000000000000,     # add: inf
    3, 0x3FFFFFFFFFFFFFFF, 9215, 0x3FF0000000000000, 9161, 0x7FEFFFFFFFFFFFFF,     # add: 1.7976931348623157e+308
    3, 0x3FF0000000000000, 8192, 0xBFF0000000000000, 8192, 0x0000000000000000,     # add: 0.0
    3, 0x3FF0000000000000, 13192, 0xBFF0000000000000, 13192, 0x0000000000000000,     # add: 0.0
    3, 0x3FF0000000000000, 5192, 0x3FF0000000000000, 5192, 0x0000000000000000,     # add: 0.0
    4, 0x3FF8000000000000, 7418, 0x3FF0000000000000, 8492, 0x0000000000000001,     # atan2: 5e-324
    4, 0x3FF0000000000000, 8192, 0x3FF0000000000000, 6192, 0x3FF921FB54442D18,     # atan2: 1.5707963267948966
    4, 0x3FF0000000000000, 6192, 0x3FF0000000000000, 8192, 0x0000000000000000,     # atan2: 0.0
    4, 0x3FF0000000000000, 6192, 0xBFF0000000000000, 8192, 0x400921FB54442D18,     # atan2: 3.141592653589793
    4, 0xBFF0000000000000, 13192, 0xBFF0000000000000, 13192, 0xC002D97C7F3321D2,     # atan2: -2.356194490192345
    4, 0x3FF0000000000000, 13192, 0x3FF8000000000000, 13192, 0x3FE2D0EAD6066395,     # atan2: 0.5880026035475675
    4, 0x3FF0000000000000, 7192, 0x3FF0000000000000, 8252, 0x0000000000004000,     # atan2: 8.095e-320
    4, 0x3FF4CCCCCCCCCCCD, 7057, 0x3FF199999999999A, 8132, 0x0000000000000001,     # atan2: 5e-324
    4, 0x3FF0000000000000, 11192, 0xBFF0000000000000, 5192, 0x3FF921FB54442D18,     # atan2: 1.5707963267948966
    4, 0xBFFB333333333333, 4192, 0x3FF3333333333333, 4191, 0xBFF3B43D3C96813B     # atan2: -1.2315037123408519
};

fn _t_ux_values() {
    test_group("ux_values (ADR 0002 #20)");
    var k = 0;
    while (k < 48) {
        var at = &_T_UX + 48 * k;
        if (load64(at) != 4) {                          # bijli: the atan2 rows (op 4) are not copied
            var r: f64 = uxf(load64(at), load64(at + 8), load64(at + 16) - 8192, load64(at + 24),
              load64(at + 32) - 8192);
            assert_bits_eq(r, load64(at + 40), "an unbounded-exponent final operation against MPFR");
        }
        k = k + 1;
    }
    # _bj_k_ux_from: a subnormal's exact pair, zeros and specials as they are; _bj_k_ux_round back to the double.
    var sub: f64 = from_bits(0x0000000000000003);
    var ss, se = _bj_k_ux_from(sub);
    assert_bits_eq(ss, 0x3FF8000000000000, "3·2^-1074 = 1.5·2^-1073: the significand");
    assert_eq(se, 0 - 1073, "3·2^-1074 = 1.5·2^-1073: the exponent");
    var back: f64 = _bj_k_ux_round(ss, se, 0.0);
    assert_bits_eq(back, 0x0000000000000003, "the subnormal round-trips");
    var nz: f64 = from_bits(0x8000000000000000);
    var zs, ze = _bj_k_ux_from(nz);
    assert(_bj_k_bits(zs) == 0x8000000000000000 && ze == 0, "−0 is (−0, 0)");
    var inf: f64 = from_bits(0x7FF0000000000000);
    var is, ie = _bj_k_ux_from(inf);
    assert(_bj_k_bits(is) == 0x7FF0000000000000 && ie == 0, "+∞ is (+∞, 0)");
    # signed zeros: x − x = +0, (−0)·x = −0, √−0 = −0, (−0) + (−0) = −0
    var one: f64 = 1.0;
    var cs, ce = _bj_k_ux_sub(one, 3000, one, 3000);
    assert(_bj_k_bits(cs) == 0 && ce == 0, "x − x = +0 at 2^3000");
    var ms, me = _bj_k_ux_mul(nz, 0, one, 5000);
    assert(_bj_k_bits(ms) == 0x8000000000000000, "(−0)·2^5000 = −0");
    var qs, qe = _bj_k_ux_sqrt(nz, 0);
    assert(_bj_k_bits(qs) == 0x8000000000000000, "√−0 = −0");
    var as2, ae2 = _bj_k_ux_add(nz, 0, nz, 0);
    assert(_bj_k_bits(as2) == 0x8000000000000000, "(−0) + (−0) = −0");
    # comparisons and max past binary64's range, and Rust's max on equal values (the second)
    var m15: f64 = 1.5;
    var m11: f64 = -1.1;
    assert(_bj_k_ux_cmp(one, 3000, m15, 2999) == 1, "2^3000 > 1.5·2^2999");
    assert(_bj_k_ux_cmp(m11, 0 - 3000, one, 0 - 5000) == 0 - 1, "−1.1·2^-3000 < 2^-5000");
    assert(_bj_k_ux_cmp(m11, 3000, m11, 2999) == 0 - 1, "−1.1·2^3000 < −1.1·2^2999");
    assert(_bj_k_ux_cmp(nz, 0, one, 0 - 9000) == 0 - 1, "−0 < 2^-9000");
    var pz: f64 = 0.0;
    assert(_bj_k_ux_cmp(nz, 0, pz, 0) == 0, "−0 = +0");
    assert(_bj_k_ux_le(m15, 4000, m15, 4000) == 1 && _bj_k_ux_le(m15, 4001, m15, 4000) == 0, "≤ at 2^4000");
    var xs, xe = _bj_k_ux_max(m15, 0 - 2000, one, 0 - 1999);
    assert(_bj_k_bits(xs) == 0x3FF0000000000000 && xe == 0 - 1999, "max picks 2^-1999 over 1.5·2^-2000");
    var ps, pe = _bj_k_ux_max(pz, 0, nz, 0);
    assert(_bj_k_bits(ps) == 0x8000000000000000, "max(+0, −0) is the second, as Rust's");
    assert(_bj_k_ux_is_positive(one, 0 - 9000) == 1 && _bj_k_ux_is_positive(pz, 0) == 0, "is_positive");
    # IEEE's specials through the significands: ∞ and NaN propagate, x/0, 0·∞, ∞ − ∞, √ of a negative
    var ninf: f64 = -inf;
    var f1: f64 = _bj_k_ux_mul_f64(inf, 0, m15, 7000);
    assert(f1 == inf, "∞·1.5·2^7000 = ∞");
    var f2: f64 = _bj_k_ux_mul_f64(pz, 0, inf, 0);
    assert(f2 != f2, "0·∞ = NaN");
    var f3: f64 = _bj_k_ux_div_f64(m11, 0 - 7000, nz, 0);
    assert(f3 == inf, "−1.1·2^-7000 / −0 = +∞");
    var f4: f64 = _bj_k_ux_div_f64(pz, 0, pz, 0);
    assert(f4 != f4, "0/0 = NaN");
    var f5: f64 = _bj_k_ux_add_f64(inf, 0, ninf, 0);
    assert(f5 != f5, "∞ − ∞ = NaN");
    var f6: f64 = _bj_k_ux_sqrt_f64(m11, 3);
    assert(f6 != f6, "√ of a negative = NaN");
    var f7: f64 = _bj_k_ux_sqrt_f64(nz, 0);
    assert_bits_eq(f7, 0x8000000000000000, "√−0 = −0");
    var f10: f64 = _bj_k_ux_add_f64(m15, 0 - 1100, nz, 0);
    assert_bits_eq(f10, 0, "1.5·2^-1100 + (−0) rounds once to +0");
    var us, ue = _bj_k_ux_mul(inf, 0, m11, 5);
    assert(_bj_k_bits(us) == 0xFFF0000000000000 && ue == 0, "∞·(−1.1·2^5) = (−∞, 0)");
}

# A seeded double of a random class: every bit pattern (both signs, subnormals, a few specials), or a moderate one.
#must_use
fn ux_rand(st, wide): f64 {
    var b = (st >> 1) % 0x7FF0000000000000;
    if (wide == 0) { b = 0x3000000000000000 + ((st >> 3) % 0x1C00000000000000); }
    b = b | (st & 0x8000000000000000);
    var x: f64 = from_bits(b);
    return x;
}

# The unbounded-exponent operations against IEEE's own on 20,000 seeded pairs of doubles: the final ×, ÷, +, −, √
# are IEEE's (one rounding, subnormal results and overflow included) at the doubles' own exponents and after shifting
# them by opposite or equal amounts past binary64's range; the 53-bit +, ×, ÷, √ round back to IEEE's wherever that is
# normal; cmp, ≤ and max agree with f64's; atan2 is _bj_k_cr_atan2 at any common shift.
fn _t_ux_ieee() {
    test_group("ux_ieee (ADR 0002 #20)");
    var st = 0x2545F4914F6CDD1D;
    var bad_f = 0;
    var bad_s = 0;
    var bad_c = 0;
    var k = 0;
    while (k < 20000) {
        st = st ^ (st << 13);
        st = st ^ (st >> 7);
        st = st ^ (st << 17);
        var x: f64 = ux_rand(st, k % 2);
        st = st ^ (st << 13);
        st = st ^ (st >> 7);
        st = st ^ (st << 17);
        var y: f64 = ux_rand(st, k % 2);
        var sh = (st >> 11) % 6001;
        sh = sh - 3000;
        var xs, xe = _bj_k_ux_from(x);
        var ys, ye = _bj_k_ux_from(y);
        var p: f64 = x * y;
        var q: f64 = x / y;
        var s: f64 = x + y;
        var d: f64 = x - y;
        var ax: f64 = x;
        if (x < 0.0) { ax = -x; }
        var r: f64 = f64_sqrt(ax);
        var ux1: f64 = _bj_k_ux_mul_f64(xs, xe, ys, ye);
        var ux2: f64 = _bj_k_ux_mul_f64(xs, xe + sh, ys, ye - sh);
        var ux3: f64 = _bj_k_ux_div_f64(xs, xe + sh, ys, ye + sh);
        var ux4: f64 = _bj_k_ux_add_f64(xs, xe, ys, ye);
        var ux5: f64 = _bj_k_ux_sub_f64(xs, xe, ys, ye);
        var axs, axe = _bj_k_ux_from(ax);
        var ux6: f64 = _bj_k_ux_sqrt_f64(axs, axe);
        if (ulp_bits_match(_bj_k_bits(ux1), _bj_k_bits(p)) != 1) { bad_f = bad_f + 1; }
        if (ulp_bits_match(_bj_k_bits(ux2), _bj_k_bits(p)) != 1) { bad_f = bad_f + 1; }
        if (ulp_bits_match(_bj_k_bits(ux3), _bj_k_bits(q)) != 1) { bad_f = bad_f + 1; }
        if (ulp_bits_match(_bj_k_bits(ux4), _bj_k_bits(s)) != 1) { bad_f = bad_f + 1; }
        if (ulp_bits_match(_bj_k_bits(ux5), _bj_k_bits(d)) != 1) { bad_f = bad_f + 1; }
        if (ulp_bits_match(_bj_k_bits(ux6), _bj_k_bits(r)) != 1) { bad_f = bad_f + 1; }
        # the 53-bit operations, shifted and shifted back
        var as1, ae1 = _bj_k_ux_add(xs, xe + sh, ys, ye + sh);
        var a1: f64 = _bj_k_ux_round(as1, ae1 - sh, 0.0);
        if (ulp_bits_match(_bj_k_bits(a1), _bj_k_bits(s)) != 1) { bad_s = bad_s + 1; }
        var abs_p = _bj_k_bits(p) & 0x7FFFFFFFFFFFFFFF;
        if (abs_p >= 0x0010000000000000) {
            var mps, mpe = _bj_k_ux_mul(xs, xe + sh, ys, ye - sh);
            var m1: f64 = _bj_k_ux_round(mps, mpe, 0.0);
            if (ulp_bits_match(_bj_k_bits(m1), _bj_k_bits(p)) != 1) { bad_s = bad_s + 1; }
        }
        var abs_q = _bj_k_bits(q) & 0x7FFFFFFFFFFFFFFF;
        if (abs_q >= 0x0010000000000000) {
            var dqs, dqe = _bj_k_ux_div(xs, xe - sh, ys, ye - sh);
            var d1: f64 = _bj_k_ux_round(dqs, dqe, 0.0);
            if (ulp_bits_match(_bj_k_bits(d1), _bj_k_bits(q)) != 1) { bad_s = bad_s + 1; }
        }
        var rts, rte = _bj_k_ux_sqrt(axs, axe + 2 * sh);
        var r1: f64 = _bj_k_ux_round(rts, rte - sh, 0.0);
        if (ulp_bits_match(_bj_k_bits(r1), _bj_k_bits(r)) != 1) { bad_s = bad_s + 1; }
        # order, ≤ and Rust's max, at the doubles' exponents and shifted together
        var want = 0;
        if (x < y) { want = 0 - 1; }
        if (x > y) { want = 1; }
        if (x != x || y != y) { want = 2; }
        if (_bj_k_ux_cmp(xs, xe, ys, ye) != want || _bj_k_ux_cmp(xs, xe + sh, ys,
            ye + sh) != want) { bad_c = bad_c + 1; }
        var le = 0;
        if (x <= y) { le = 1; }
        if (_bj_k_ux_le(xs, xe - sh, ys, ye - sh) != le) { bad_c = bad_c + 1; }
        var mx: f64 = _bj_k_max(x, y);
        var uxs, uxe = _bj_k_ux_max(xs, xe, ys, ye);
        var mr: f64 = _bj_k_ux_round(uxs, uxe, 0.0);
        if (ulp_bits_match(_bj_k_bits(mr), _bj_k_bits(mx)) != 1) { bad_c = bad_c + 1; }
        k = k + 1;
    }
    assert_eq(bad_f, 0, "final ×, ÷, +, −, √ = IEEE's on 20,000 seeded pairs, at their exponents and shifted");
    assert_eq(bad_s, 0, "53-bit +, ×, ÷, √ shifted past binary64's range and back = IEEE's where normal");
    assert_eq(bad_c, 0, "cmp, ≤ and max = f64's, at the doubles' exponents and shifted");
}

# Runs every test group; returns the failure count from assert_summary().
# ── multi-word integers, RN(p/q·2^e) and the double-double quotient (M4e-3, ADR 0002 #21, #22) ──
# Expected values: Python's Fraction (exact), rounded by CPython's correctly rounded int division.

# a = hi·2⁶⁴ + lo (two 64-bit words, unsigned).
fn bn_of(a, hi, lo) {
    var t[64];
    _bj_k_bn_set(a, hi);
    _bj_k_bn_shl(a, 64);
    _bj_k_bn_set(&t, lo);
    _bj_k_bn_add(a, a, &t);
    return 0;
}

# The limbs of a as two words: (limbs 1 and 0, limbs 3 and 2) → checked against (lo, hi).
#must_use
fn bn_is(a, hi, lo): i64 {
    var l = load64(a) | (load64(a + 8) << 32);
    var h = load64(a + 16) | (load64(a + 24) << 32);
    var k = 4;
    while (k < _BJ_K_BN_LIMBS) {
        if (load64(a + 8 * k) != 0) { return 0; }
        k = k + 1;
    }
    if (l == lo && h == hi) { return 1; }
    return 0;
}

fn _t_bn_ratio_values() {
    test_group("cr_ratio_values");
    var a[64];
    var b[64];
    var c[64];
    _bj_k_bn_set(&a, 0xFFFFFFFFFFFFFFFF);
    assert_eq(_bj_k_bn_bitlen(&a), 64, "bitlen(2⁶⁴ − 1)");
    _bj_k_bn_mul(&c, &a, &a);
    assert(bn_is(&c, 0xFFFFFFFFFFFFFFFE, 1) == 1, "(2⁶⁴ − 1)² = 2¹²⁸ − 2⁶⁵ + 1");
    _bj_k_bn_set(&b, 0xFFFFFFFFFFFFFFFF);
    _bj_k_bn_mul_small(&b, 0xFFFFFFFF);
    assert(bn_is(&b, 0xFFFFFFFE, 0xFFFFFFFF00000001) == 1, "(2⁶⁴ − 1)·(2³² − 1)");
    _bj_k_bn_add(&b, &c, &a);
    assert(bn_is(&b, 0xFFFFFFFFFFFFFFFF, 0) == 1, "(2⁶⁴ − 1)² + (2⁶⁴ − 1) = 2¹²⁸ − 2⁶⁴");
    _bj_k_bn_sub(&b, &b, &a);
    assert(_bj_k_bn_cmp(&b, &c) == 0, "… − (2⁶⁴ − 1) is (2⁶⁴ − 1)² again");
    _bj_k_bn_set(&a, 1);
    _bj_k_bn_shl(&a, 200);
    assert_eq(_bj_k_bn_bitlen(&a), 201, "bitlen(2²⁰⁰)");
    assert(_bj_k_bn_cmp(&a, &c) == 1 && _bj_k_bn_cmp(&c, &a) == 0 - 1, "2²⁰⁰ > 2¹²⁸ − 2⁶⁵ + 1");
    _bj_k_bn_shl(&c, 37);
    assert(load64(&c) == 0 && load64(&c + 8) == 32 && _bj_k_bn_bitlen(&c) == 165, "(2¹²⁸ − 2⁶⁵ + 1)·2³⁷: limbs");
    # RN(p/q·2^e) against Fraction: ties to even, subnormal results and ties, the overflow threshold, p = 0
    var p[64];
    var q[64];
    var ws: i64[9];
    var ps: i64[9];
    var qs: i64[9];
    var es: i64[9];
    ws[0] = 0x3FD5555555555555; ps[0] = 1; qs[0] = 3; es[0] = 0;
    ws[1] = 0; ps[1] = 1; qs[1] = 1; es[1] = 0 - 1075;
    ws[2] = 2; ps[2] = 3; qs[2] = 1; es[2] = 0 - 1075;
    ws[3] = 0x4340000000000000; ps[3] = 0x20000000000001; qs[3] = 1; es[3] = 0;
    ws[4] = 0x4340000000000002; ps[4] = 0x20000000000003; qs[4] = 1; es[4] = 0;
    ws[5] = 0x7FEFFFFFFFFFFFFF; ps[5] = 0x1FFFFFFFFFFFFF; qs[5] = 0x20000000000000; es[5] = 1024;
    ws[6] = 0x7FF0000000000000; ps[6] = 0x3FFFFFFFFFFFFF; qs[6] = 0x40000000000000; es[6] = 1024;
    ws[7] = 0x7FF0000000000000; ps[7] = 1; qs[7] = 1; es[7] = 1024;
    ws[8] = 5; ps[8] = 1; qs[8] = 3; es[8] = 0 - 1070;
    var bad = 0;
    var k = 0;
    while (k < 9) {
        _bj_k_bn_set(&p, ps[k]);
        _bj_k_bn_set(&q, qs[k]);
        var r: f64 = _bj_k_cr_ratio(&p, &q, es[k]);
        if (load64(&r) != ws[k]) { bad = bad + 1; }
        k = k + 1;
    }
    assert_eq(bad, 0, "nine ratios: 1/3, the ties 2⁻¹⁰⁷⁵, 1.5·2⁻¹⁰⁷⁴, 2⁵³ + 1, 2⁵³ + 3, DBL_MAX, the overflow tie");
    _bj_k_bn_set(&p, 0);
    var z0: f64 = _bj_k_cr_ratio(&p, &q, 5);
    assert_eq(load64(&z0), 0, "p = 0: +0");
    _bj_k_bn_set(&a, 0xFFFFFFFFFFFFFFFF);
    _bj_k_bn_mul(&p, &a, &a);
    _bj_k_bn_set(&q, 3);
    _bj_k_bn_shl(&q, 100);
    var r1: f64 = _bj_k_cr_ratio(&p, &q, 7);
    assert_eq(load64(&r1), 0x4205555555555555, "(2⁶⁴ − 1)²/(3·2¹⁰⁰)·2⁷");
    _bj_k_bn_set(&p, 1);
    _bj_k_bn_shl(&p, 200);
    _bj_k_bn_set(&a, 1);
    _bj_k_bn_add(&p, &p, &a);
    _bj_k_bn_set(&a, 0xFFFFFFFFFFFFFFFF);
    _bj_k_bn_set(&b, 0x1000000000000003);
    _bj_k_bn_mul(&q, &a, &b);
    var r2: f64 = _bj_k_cr_ratio(&p, &q, 0 - 300);
    assert_eq(load64(&r2), 0x31F0000000000000, "(2²⁰⁰ + 1)/((2⁶⁴ − 1)(2⁶⁰ + 3))·2⁻³⁰⁰");
    _bj_k_bn_set(&p, 5);
    _bj_k_bn_set(&q, 1);
    _bj_k_bn_shl(&q, 200);
    var r3: f64 = _bj_k_cr_ratio(&p, &q, 0);
    assert_eq(load64(&r3), 0x3394000000000000, "5/2²⁰⁰");
    bn_of(&a, 0x8000000000000000, 1);
    _bj_k_bn_set(&b, 1);
    _bj_k_bn_shl(&b, 100);
    _bj_k_bn_set(&c, 1);
    _bj_k_bn_sub(&b, &b, &c);
    _bj_k_bn_mul(&p, &a, &b);
    _bj_k_bn_set(&q, 1);
    _bj_k_bn_shl(&q, 150);
    _bj_k_bn_set(&c, 7);
    _bj_k_bn_add(&q, &q, &c);
    var r4: f64 = _bj_k_cr_ratio(&p, &q, 0 - 500);
    assert_eq(load64(&r4), 0x2580000000000000, "(2¹²⁷ + 1)(2¹⁰⁰ − 1)/(2¹⁵⁰ + 7)·2⁻⁵⁰⁰");
    # _bj_k_dd_mul and _bj_k_dd_div_cr
    var one: f64 = 1.0;
    var u52: f64 = 0x3CB0000000000000;
    var x1: f64 = one + u52;
    var zero: f64 = 0.0;
    var mh, ml = _bj_k_dd_mul(x1, zero, x1, zero);
    assert(load64(&mh) == 0x3FF0000000000002 && load64(&ml) == 0x3970000000000000, "(1 + 2⁻⁵²)² = 1 + 2⁻⁵¹ + 2⁻¹⁰⁴");
    var y1, o1 = _bj_k_dd_div_cr(6.0, zero, 3.0, zero);
    assert(o1 == 1 && y1 == 2.0, "6/3: an exact quotient passes the test");
    var two53: f64 = 0x4340000000000000;
    var y2, o2 = _bj_k_dd_div_cr(two53, one, one, zero);
    assert(o2 == 0, "(2⁵³ + 1)/1, a midpoint: the test fails");
    var y3, o3 = _bj_k_dd_div_cr(one, zero, 3.0, zero);
    assert(o3 == 1 && load64(&y3) == 0x3FD5555555555555, "1/3");
}

# RN(p/q) by _bj_k_cr_ratio against _bj_k_dd_div_cr's result wherever its test passes: p and q products of two seeded
# 53-bit integers (exact double-doubles by TwoProduct).
fn _t_bn_ratio_agrees() {
    test_group("cr_ratio_agrees");
    var seed = 0x2545F4914F6CDD1D;
    var bad = 0;
    var passed = 0;
    var a[64];
    var b[64];
    var p[64];
    var q[64];
    var k = 0;
    while (k < 10000) {
        var w: i64[4];
        var j = 0;
        while (j < 4) {
            seed = seed ^ (seed << 13);
            seed = seed ^ (seed >> 7);
            seed = seed ^ (seed << 17);
            w[j] = 1 + (seed >> (11 + (seed & 31)));
            j = j + 1;
        }
        _bj_k_bn_set(&a, w[0]);
        _bj_k_bn_set(&b, w[1]);
        _bj_k_bn_mul(&p, &a, &b);
        _bj_k_bn_set(&a, w[2]);
        _bj_k_bn_set(&b, w[3]);
        _bj_k_bn_mul(&q, &a, &b);
        var r: f64 = _bj_k_cr_ratio(&p, &q, 0);
        var f0: f64 = f64_from(w[0]);
        var f1: f64 = f64_from(w[1]);
        var f2: f64 = f64_from(w[2]);
        var f3: f64 = f64_from(w[3]);
        var nh, nl = _bj_k_two_prod(f0, f1);
        var dh, dl = _bj_k_two_prod(f2, f3);
        var y, ok = _bj_k_dd_div_cr(nh, nl, dh, dl);
        if (ok == 1) {
            passed = passed + 1;
            if (load64(&y) != load64(&r)) { bad = bad + 1; }
        }
        k = k + 1;
    }
    assert_eq(bad, 0, "the exact ratio and the double-double quotient agree on 10,000 seeded p/q");
    assert(passed > 9900, "the double-double test passes almost always");
}

# ── the correctly rounded monomial (the overflow audit's B1, ADR 0002 #27, #28) ──
# RN(Π num / Π den), rounded once, for 36 cases: signs, zeros (Rust's NaN at 1e300·1e300·0 is the exact 0), overflow
# and underflow to ±∞ and ±0, partial products past both ends, the subnormal grid's ties, 53-bit midpoints of the 3/0,
# 2/1 and 2/2 shapes (the fast path's exact tie resolution), osmotic_pressure's five factors, the empty product, and the
# domain's NaNs. Each row: n_num, n_den, six numerator and four denominator words (unused ones 1.0), the expected bits
# (Fraction, rounded by CPython's correctly rounded int division).
var _T_MONO: i64[468] = {
