    3, 0, 0xC000000000000000, 0x4008000000000000, 0x4014000000000000, 0x3FF0000000000000, 0x3FF0000000000000,
    0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FF0000000000000,
    0xC03E000000000000,
