# parity.tcyr — replays the golden corpus (tests/golden/*.tsv) against the port.
#
# Port plan §6 step 7, adapted from impetus's tests/parity_2d.tcyr at its M0 (itself kimiya's
# tests/parity.tcyr and tanmatra's). Format and comparison rules: scripts/oracle/README.md. The
# module list is tests/golden/modules.txt, which the generator writes. The replay machinery is
# tests/parity_core.cyr; this file holds the dispatchers. The library modules come from
# cyrius.cyml's [test] modules, prepended to every test unit.
#
# Every row of every module is one of:
# - ok: every output matched within its class;
# - FAILED: an output differs; the first 10 per module are printed with the row's note and both
#   bit patterns;
# - measured: class C, with no bound set yet for its function. The ulp distance is recorded but
#   not gated. bijli's class-C rows gate at 0 ulp once src/crmath.cyr dispatches them (M1); until
#   then the stdlib/ganita counterparts are measured, which is the M0 step 8 baseline;
# - accepted: a divergence an ADR accepts, listed by row in _par_accepted;
# - pending: its function isn't ported yet (no dispatcher entry).
#
# Per function it prints the row counts and the ulp histogram. Shadow lines (`fn ~ candidate`)
# compare the same rows against another Cyrius candidate and are never gated. The exit code is
# the number of modules with a failure.

include "tests/lib.cyr"

include "tests/ulp.cyr"

include "tests/parity_core.cyr"

# ── hooks ───────────────────────────────────────────────────────────────────────────

# The Rust variant name of an error code: src/error.cyr's.
#must_use
public fn _par_error_name(code): i64 {
    return bj_error_name(code);
}

# ── cross-target digests (M0 step 8) ────────────────────────────────────────────────
# A 64-bit FNV-1a fold of every output word the port returns, per function, in row order. Run on
# x86_64 ELF, x86_64 PE and aarch64: equal digests mean bit-identical results on every row, which
# is what ADR 0002 row 6 promises. Histograms alone can't show that. One slot per golden function
# (_PAR_DG_NAMES, in order), then one per shadow.
var _PAR_DG_N = 64;
var _par_dg: i64[64];
var _par_dg_used = 0;
var _PAR_DG_NAMES = 0;

fn _par_dg_init() {
    for (var k = 0; k < _PAR_DG_N; k = k + 1) { _par_dg[k] = 0xcbf29ce484222325; }
    _par_dg_used = 0;
    return 0;
}

# The digest slot of (function), registered on first sight in a module's row order; -1 when the
# table is full.
var _par_dg_fp: i64[64];
var _par_dg_fl: i64[64];
fn _par_dg_slot(fp, fl): i64 {
    for (var k = 0; k < _par_dg_used; k = k + 1) {
        if (_par_dg_fl[k] == fl && memeq(_par_dg_fp[k], fp, fl) == 1) { return k; }
    }
    if (_par_dg_used >= _PAR_DG_N) { return 0 - 1; }
    _par_dg_fp[_par_dg_used] = fp;
    _par_dg_fl[_par_dg_used] = fl;
    _par_dg_used = _par_dg_used + 1;
    return _par_dg_used - 1;
}

# One digest step: FNV-1a's xor and multiply, then a right-shift mix. The multiply alone carries a difference only
# upward, so a difference in a word's bit 63 (an f64's sign) reached only the digest's own bit 63, and two of them
# cancelled; the shift brings every bit down (port-parity.md §9, digest v2).
#must_use
fn _par_dg_step(h, v): i64 {
    var x = (h ^ v) * 0x100000001b3;
    return x ^ (x >>> 29);
}

# Folds the got list into digest `slot`: a word for f, i, v and n tokens, every NaN as the one quiet NaN (IEEE 754
# leaves a generated NaN's sign and payload to the hardware: x86 makes 0xFFF8…, ARM 0x7FF8…, and the class rules
# match any NaN with any NaN), and the bytes of the text for s, e and E tokens (whose word is an address).
fn _par_dg_fold(slot) {
    if (slot < 0) { return 0; }
    var h = _par_dg[slot];
    for (var k = 0; k < _par_got_n; k = k + 1) {
        var kind = load64(_par_got_k + k * 8);
        var v = load64(_par_got_v + k * 8);
        if (kind == 115 || kind == 101 || kind == 69) {
            var len = load64(_par_got_l + k * 8);
            for (var j = 0; j < len; j = j + 1) { h = _par_dg_step(h, load8(v + j)); }
            h = _par_dg_step(h, 0xff);
        } else {
            if (kind == 102 && (v & 0x7FFFFFFFFFFFFFFF) > 0x7FF0000000000000) { v = 0x7FF8000000000000; }
            h = _par_dg_step(h, v);
        }
    }
    _par_dg[slot] = h;
    return 0;
}

# Prints every registered digest.
fn _par_dg_print_all() {
    for (var k = 0; k < _par_dg_used; k = k + 1) {
        print("  digest ", 9);
        _par_print_pad(_par_dg_fp[k], _par_dg_fl[k], 34);
        print(" 0x", 3);
        fmt_hex(_par_dg[k]);
        println("");
    }
    return 0;
}

# ── dispatch ────────────────────────────────────────────────────────────────────────
# Each module's dispatcher fills the got list for one row. It returns 1 when it handled the
# function, 0 when the function is pending (not ported), or -1 when the inputs are unusable (a
# defect, counted as a failure). Add a function the moment it's ported.

# `const` rows (input `s:<path>`): src/constants.cyr's BJ_ consts. Any other name is a defect.
fn _par_constants(fp, fl): i64 {
    if (_par_eq(fp, fl, "const") != 1 || _par_in_n != 1) { return 0 - 1; }
    var np = load64(_par_in_v);
    var nl = load64(_par_in_l);
    if (_par_eq(np, nl, "charge::ELEMENTARY_CHARGE") == 1) { _par_got_f(BJ_ELEMENTARY_CHARGE); return 1; }
    if (_par_eq(np, nl, "charge::ELECTRON_MASS") == 1) { _par_got_f(BJ_ELECTRON_MASS); return 1; }
    if (_par_eq(np, nl, "charge::PROTON_MASS") == 1) { _par_got_f(BJ_PROTON_MASS); return 1; }
    if (_par_eq(np, nl, "fdtd::FOURTH_ORDER_C1") == 1) { _par_got_f(BJ_FOURTH_ORDER_C1); return 1; }
    if (_par_eq(np, nl, "fdtd::FOURTH_ORDER_C2") == 1) { _par_got_f(BJ_FOURTH_ORDER_C2); return 1; }
    if (_par_eq(np, nl, "field::EPSILON_0") == 1) { _par_got_f(BJ_EPSILON_0); return 1; }
    if (_par_eq(np, nl, "field::MU_0") == 1) { _par_got_f(BJ_MU_0); return 1; }
    if (_par_eq(np, nl, "field::SPEED_OF_LIGHT") == 1) { _par_got_f(BJ_SPEED_OF_LIGHT); return 1; }
    if (_par_eq(np, nl, "field::COULOMB_K") == 1) { _par_got_f(BJ_COULOMB_K); return 1; }
    if (_par_eq(np, nl, "field::SPEED_OF_LIGHT_SQ") == 1) { _par_got_f(BJ_SPEED_OF_LIGHT_SQ); return 1; }
    if (_par_eq(np, nl, "scattering::MIE_MAX_SIZE_PARAMETER") == 1) {
        _par_got_f(BJ_MIE_MAX_SIZE_PARAMETER);
        return 1;
    }
    if (_par_eq(np, nl, "scattering::MIE_MAX_MX") == 1) { _par_got_f(BJ_MIE_MAX_MX); return 1; }
    return 0 - 1;
}

# `f64::*` rows: the Rust std reference values (port plan §9.1).
# - Classes A and B: the builtins (sqrt, abs, ceil) and src/mathx.cyr, gated.
# - Class C: src/crmath.cyr's correctly rounded exp, sin, cos, sin_cos, hypot, pow, atan2 and atan (M1 part 1a),
#   gated at 0 ulp against the corrected oracle (tests/golden/math.cr.tsv where glibc misrounds), and
#   src/crmath_k.cyr's acos, log10 (kimiya's) and asin (M1 part 1b), tan (bijli's, M1 part 1c), and sinh and cosh
#   (bijli's, M1 part 2d, which hisab's complex sin and cos reach); cbrt is ganita's
#   correctly rounded one, against the oracle's correctly rounded one (compiler-builtins).
fn _par_math(fp, fl): i64 {
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "f64::sqrt") == 1) { var r: f64 = f64_sqrt(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::abs") == 1) { var r: f64 = f64_abs(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::ceil") == 1) { var r: f64 = f64_ceil(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::is_nan") == 1) { _par_got_i(_bj_is_nan(x)); return 1; }
    if (_par_eq(fp, fl, "f64::is_finite") == 1) { _par_got_i(_bj_is_finite(x)); return 1; }
    if (_par_eq(fp, fl, "f64::to_radians") == 1) { var r: f64 = _bj_to_radians(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::to_degrees") == 1) { var r: f64 = _bj_to_degrees(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::sin_cos") == 1) {
        var s, c = _bj_sin_cos(x);
        var sv: f64 = s;
        var cv: f64 = c;
        _par_got_f(sv);
        _par_got_f(cv);
        return 1;
    }
    if (_par_eq(fp, fl, "f64::sin") == 1) { var r: f64 = _bj_sin(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::cos") == 1) { var r: f64 = _bj_cos(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::tan") == 1) { var r: f64 = _bj_tan(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::exp") == 1) { var r: f64 = _bj_exp(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::atan") == 1) { var r: f64 = _bj_atan(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::asin") == 1) { var r: f64 = _bj_asin(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::acos") == 1) { var r: f64 = _bj_acos(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::cbrt") == 1) { var r: f64 = ganita_f64_cbrt(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::log10") == 1) { var r: f64 = _bj_log10(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::sinh") == 1) { var r: f64 = _bj_sinh(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::cosh") == 1) { var r: f64 = _bj_cosh(x); _par_got_f(r); return 1; }
    if (_par_in_n < 2) { return 0; }
    if (_par_eq(fp, fl, "f64::powi") == 1) {
        var n = _par_in(1);
        var r: f64 = _bj_powi(x, n);
        _par_got_f(r);
        return 1;
    }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "f64::min") == 1) { var r: f64 = _bj_min(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::max") == 1) { var r: f64 = _bj_max(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::copysign") == 1) { var r: f64 = _bj_copysign(x, y); _par_got_f(r); return 1; }
    # Rust's y.atan2(x) is the golden f64::atan2(y, x): inputs in C order.
    if (_par_eq(fp, fl, "f64::atan2") == 1) { var r: f64 = _bj_atan2(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::hypot") == 1) { var r: f64 = _bj_hypot(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powf") == 1) { var r: f64 = _bj_powf(x, y); _par_got_f(r); return 1; }
    if (_par_in_n < 3) { return 0; }
    if (_par_eq(fp, fl, "f64::clamp") == 1) {
        var hi: f64 = _par_in(2);
        var r: f64 = _bj_clamp(x, y, hi);
        _par_got_f(r);
        return 1;
    }
    return 0;
}

# `BijliError::*` rows: src/error.cyr's constructors, then the calling thread's record read back: the code (the
# `E:` token, which must be the code the constructor returned), the variant's fields through bj_last_error_*,
# and Rust's Display text.
fn _par_error(fp, fl): i64 {
    var code = 0 - 1;
    if (_par_eq(fp, fl, "BijliError::DimensionMismatch") == 1) {
        code = _bj_err_dimension_mismatch(_par_in(0), _par_in(1));
        _par_got_err(bj_last_error());
        _par_got_i(bj_last_error_expected());
        _par_got_i(bj_last_error_got());
    } elif (_par_eq(fp, fl, "BijliError::ZeroCharge") == 1) {
        code = _bj_err_zero_charge();
        _par_got_err(bj_last_error());
    } elif (_par_eq(fp, fl, "BijliError::Singularity") == 1) {
        code = _bj_err_singularity();
        _par_got_err(bj_last_error());
    } elif (_par_eq(fp, fl, "BijliError::InsufficientResolution") == 1) {
        var d: f64 = _par_in(1);
        code = _bj_err_insufficient_resolution(_par_in(0), d);
        _par_got_err(bj_last_error());
        _par_got_i(bj_last_error_cells());
        var ds: f64 = bj_last_error_domain_size();
        _par_got_f(ds);
    } elif (_par_eq(fp, fl, "BijliError::InvalidPermittivity") == 1) {
        var v1: f64 = _par_in(0);
        code = _bj_err_invalid_permittivity(v1);
        _par_got_err(bj_last_error());
        var r1: f64 = bj_last_error_value();
        _par_got_f(r1);
    } elif (_par_eq(fp, fl, "BijliError::InvalidPermeability") == 1) {
        var v2: f64 = _par_in(0);
        code = _bj_err_invalid_permeability(v2);
        _par_got_err(bj_last_error());
        var r2: f64 = bj_last_error_value();
        _par_got_f(r2);
    } elif (_par_eq(fp, fl, "BijliError::DivisionByZero") == 1) {
        var c1 = _par_in_cstr(0);
        if (c1 == 0) { return 0 - 1; }
        code = _bj_err_division_by_zero(c1);
        _par_got_err(bj_last_error());
        var d1 = bj_last_error_detail();
        _par_got_text(d1, strlen(d1));
    } elif (_par_eq(fp, fl, "BijliError::InvalidParameter") == 1) {
        var c2 = _par_in_cstr(0);
        if (c2 == 0) { return 0 - 1; }
        code = _bj_err_invalid_parameter(c2);
        _par_got_err(bj_last_error());
        var d2 = bj_last_error_detail();
        _par_got_text(d2, strlen(d2));
    } elif (_par_eq(fp, fl, "BijliError::InvalidParameter/f64") == 1) {
        var pre = _par_in_cstr(0);
        if (pre == 0) { return 0 - 1; }
        var x: f64 = _par_in(1);
        var tx = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(tx, pre);
        _bj_fmt_f64_display(tx, x);
        code = BJ_ERR_INVALID_PARAMETER;
        _par_got_err(bj_last_error());
        var d3 = bj_last_error_detail();
        _par_got_text(d3, strlen(d3));
    } else {
        return 0;
    }
    if (code != bj_last_error()) { return 0 - 1; }
    var txt = bj_last_error_display();
    _par_got_text(txt, strlen(txt));
    return 1;
}

# A complex result to the got list: its two parts, the real first (format 1).
fn _par_got_c(z: BjComplex) {
    var re: f64 = z.re;
    var im: f64 = z.im;
    _par_got_f(re);
    _par_got_f(im);
    return 0;
}

# `Complex::*` and polarization's complex rows: src/complex.cyr's BjComplex. Inputs are complex values as two f64
# tokens each; an f64 operand follows them (before them for `f64::mul_complex`, Rust's `x * z`).
public fn _par_complex(fp, fl): i64 {
    if (_par_eq(fp, fl, "Complex::default") == 1) { _par_got_c(BjComplex_default()); return 1; }
    if (_par_eq(fp, fl, "polarization::complex_zero") == 1) { _par_got_c(bj_complex_zero()); return 1; }
    if (_par_in_n < 1) { return 0; }
    var x0: f64 = _par_in(0);
    if (_par_eq(fp, fl, "Complex::from_real") == 1) { _par_got_c(BjComplex_from_real(x0)); return 1; }
    if (_par_eq(fp, fl, "polarization::complex_real") == 1) { _par_got_c(bj_complex_real(x0)); return 1; }
    if (_par_in_n < 2) { return 0; }
    var x1: f64 = _par_in(1);
    if (_par_eq(fp, fl, "Complex::from_polar") == 1) { _par_got_c(BjComplex_from_polar(x0, x1)); return 1; }
    if (_par_eq(fp, fl, "polarization::complex_from_polar") == 1) {
        _par_got_c(bj_complex_from_polar(x0, x1));
        return 1;
    }
    var z = BjComplex_new(x0, x1);
    if (_par_eq(fp, fl, "Complex::new") == 1) { _par_got_c(z); return 1; }
    if (_par_eq(fp, fl, "Complex::abs") == 1) { var a: f64 = z.abs(); _par_got_f(a); return 1; }
    if (_par_eq(fp, fl, "ComplexExt::norm") == 1) { var nm: f64 = z.norm(); _par_got_f(nm); return 1; }
    if (_par_eq(fp, fl, "Complex::norm_sq") == 1) { var ns: f64 = z.norm_sq(); _par_got_f(ns); return 1; }
    if (_par_eq(fp, fl, "Complex::arg") == 1) { var g: f64 = z.arg(); _par_got_f(g); return 1; }
    if (_par_eq(fp, fl, "Complex::conj") == 1) { _par_got_c(z.conj()); return 1; }
    if (_par_eq(fp, fl, "Complex::neg") == 1) { _par_got_c(BjComplex_neg(z)); return 1; }
    if (_par_eq(fp, fl, "Complex::inv") == 1) { _par_got_c(z.inv()); return 1; }
    if (_par_eq(fp, fl, "Complex::exp") == 1) { _par_got_c(z.exp()); return 1; }
    if (_par_eq(fp, fl, "Complex::ln") == 1) { _par_got_c(z.ln()); return 1; }
    if (_par_eq(fp, fl, "Complex::sqrt") == 1) { _par_got_c(z.sqrt()); return 1; }
    if (_par_eq(fp, fl, "Complex::sin") == 1) { _par_got_c(z.sin()); return 1; }
    if (_par_eq(fp, fl, "Complex::cos") == 1) { _par_got_c(z.cos()); return 1; }
    if (_par_eq(fp, fl, "Complex::fmt") == 1) {
        var buf[800];
        var tx[24];
        _bj_tx_init(&tx, &buf, 800);
        z.display(&tx);
        if (_bj_tx_overflowed(&tx) == 1) { return 0 - 1; }
        _par_got_text(_bj_tx_ptr(&tx), _bj_tx_len(&tx));
        return 1;
    }
    if (_par_in_n < 3) { return 0; }
    var x2: f64 = _par_in(2);
    if (_par_eq(fp, fl, "Complex::mul_f64") == 1) { _par_got_c(z.scale(x2)); return 1; }
    if (_par_eq(fp, fl, "Complex::div_f64") == 1) { _par_got_c(z.div_f64(x2)); return 1; }
    if (_par_eq(fp, fl, "Complex::is_zero") == 1) { _par_got_i(z.is_zero(x2)); return 1; }
    if (_par_eq(fp, fl, "Complex::powf") == 1) { _par_got_c(z.powf(x2)); return 1; }
    if (_par_eq(fp, fl, "f64::mul_complex") == 1) {
        var zr = BjComplex_new(x1, x2);
        _par_got_c(zr.scale(x0));
        return 1;
    }
    if (_par_in_n < 4) { return 0; }
    var x3: f64 = _par_in(3);
    var w = BjComplex_new(x2, x3);
    if (_par_eq(fp, fl, "Complex::add") == 1) { _par_got_c(z + w); return 1; }
    if (_par_eq(fp, fl, "Complex::sub") == 1) { _par_got_c(z - w); return 1; }
    if (_par_eq(fp, fl, "Complex::mul") == 1) { _par_got_c(z * w); return 1; }
    if (_par_eq(fp, fl, "Complex::div") == 1) { _par_got_c(z / w); return 1; }
    return 0;
}

# A BjFieldVector to the got list: x, y, z.
fn _par_got_fv(v: BjFieldVector) {
    var x: f64 = v.x;
    var y: f64 = v.y;
    var z: f64 = v.z;
    _par_got_f(x);
    _par_got_f(y);
    _par_got_f(z);
    return 0;
}

# An error to the got list as the golden rows hold it: the `E:` token, then the record's Display text.
fn _par_got_error(code) {
    _par_got_err(code);
    var d = bj_last_error_display();
    _par_got_text(d, strlen(d));
    return 0;
}

# A Result<FieldVector> (its two halves, and the vector written on Ok) to the got list.
fn _par_got_res_v(t, v, e: BjFieldVector) {
    if (is_err_result(t) == 1) { return _par_got_error(v); }
    return _par_got_fv(e);
}

# A Result<f64> (its two halves) to the got list.
fn _par_got_res_f(t, v) {
    if (is_err_result(t) == 1) { return _par_got_error(v); }
    _par_got_f(v);
    return 0;
}

# Input tokens k, k + 1, k + 2 into the three f64 at p.
fn _par_in3(k, p: *f64) {
    p[0] = _par_in(k);
    p[1] = _par_in(k + 1);
    p[2] = _par_in(k + 2);
    return 0;
}

# The vector of input tokens k … k + 2.
fn _par_in_fv(k): BjFieldVector {
    var x: f64 = _par_in(k);
    var y: f64 = _par_in(k + 1);
    var z: f64 = _par_in(k + 2);
    var v: BjFieldVector = BjFieldVector_new(x, y, z);
    return v;
}

# ADR 0002 row 5 rows compared through their mapping: the port's complex value, conjugated back, against the oracle's
# (exact: a sign flip). Counted per module run and reported after the module.
var _par_map5_greens = 0;

# An image charge result to the got list: Ok(q') then the position written to p, or the error.
fn _par_got_res_image(t, v, p: *f64) {
    if (is_err_result(t) == 1) { return _par_got_error(v); }
    _par_got_f(v);
    var x: f64 = p[0];
    var y: f64 = p[1];
    var z: f64 = p[2];
    _par_got_f(x);
    _par_got_f(y);
    _par_got_f(z);
    return 0;
}

# A complex result written to `c` on Ok (with its Result's two halves t, v) to the got list, or the error.
fn _par_got_res_c(t, v, c: BjComplex) {
    if (is_err_result(t) == 1) { return _par_got_error(v); }
    var re: f64 = c.re;
    var im: f64 = c.im;
    _par_got_f(re);
    _par_got_f(im);
    return 0;
}

# ── trace_field_line's scenarios (M1 part 3c) ──
# The field functions scripts/oracle/src/m_field.rs's field_fn numbers, as plain fns called through callptr, reading
# the row's parameters from _par_tf (the harness is single-threaded).
var _par_tf: f64[8];

# out = (x, y, z); status BJ_ERR_NONE.
fn _par_tf_put(out: *BjFieldVector, x: f64, y: f64, z: f64): i64 {
    out.x = x;
    out.y = y;
    out.z = z;
    return BJ_ERR_NONE;
}

# The status of a field function's Result: BJ_ERR_NONE, or its code.
fn _par_tf_status(t, v): i64 {
    if (is_err_result(t) == 1) { return v; }
    return BJ_ERR_NONE;
}

# 0: uniform (fx, fy, fz).
fn _par_tf_uniform(pos: *f64, out: *BjFieldVector): i64 {
    return _par_tf_put(out, _par_tf[0], _par_tf[1], _par_tf[2]);
}

# 1: a point charge q at (x, y, z).
fn _par_tf_point(pos: *f64, out: *BjFieldVector): i64 {
    var c: f64[3];
    c[0] = _par_tf[1];
    c[1] = _par_tf[2];
    c[2] = _par_tf[3];
    var q: f64 = _par_tf[0];
    var t, v = bj_electric_field_point_charge(q, &c, pos, out);
    return _par_tf_status(t, v);
}

# 2: an electric dipole p at the origin.
fn _par_tf_dipole(pos: *f64, out: *BjFieldVector): i64 {
    var p: BjFieldVector = BjFieldVector_new(_par_tf[0], _par_tf[1], _par_tf[2]);
    var t, v = bj_electric_dipole_field(p, pos, out);
    return _par_tf_status(t, v);
}

# 3: a linear quadrupole, +q at ±d ẑ and −2q at the origin.
fn _par_tf_quadrupole(pos: *f64, out: *BjFieldVector): i64 {
    var cs: f64[12];
    var q: f64 = _par_tf[0];
    var d: f64 = _par_tf[1];
    cs[0] = q;
    cs[1] = 0.0;
    cs[2] = 0.0;
    cs[3] = d;
    cs[4] = q;
    cs[5] = 0.0;
    cs[6] = 0.0;
    cs[7] = -d;
    cs[8] = -2.0 * q;
    cs[9] = 0.0;
    cs[10] = 0.0;
    cs[11] = 0.0;
    var t, v = bj_electric_field_superposition(&cs, 3, pos, out);
    return _par_tf_status(t, v);
}

# 4: a sink, Singularity once x ≥ a, else x̂.
fn _par_tf_sink(pos: *f64, out: *BjFieldVector): i64 {
    var x: f64 = pos[0];
    var a: f64 = _par_tf[0];
    if (x >= a) { return _bj_err_singularity(); }
    return _par_tf_put(out, 1.0, 0.0, 0.0);
}

# 5: always ZeroCharge.
fn _par_tf_error(pos: *f64, out: *BjFieldVector): i64 {
    return _bj_err_zero_charge();
}

# 6: a NaN field once x ≥ a, else x̂.
fn _par_tf_nan(pos: *f64, out: *BjFieldVector): i64 {
    var x: f64 = pos[0];
    var a: f64 = _par_tf[0];
    var zero: f64 = 0.0;
    var nan: f64 = zero / zero;
    if (x >= a) { return _par_tf_put(out, nan, 0.0, 0.0); }
    return _par_tf_put(out, 1.0, 0.0, 0.0);
}

# 7: an infinite field once x ≥ a, else x̂.
fn _par_tf_inf(pos: *f64, out: *BjFieldVector): i64 {
    var x: f64 = pos[0];
    var a: f64 = _par_tf[0];
    var inf: f64 = 1.0 / 0.0;
    if (x >= a) { return _par_tf_put(out, inf, 0.0, 0.0); }
    return _par_tf_put(out, 1.0, 0.0, 0.0);
}

# 8: a magnetic dipole m at the origin.
fn _par_tf_mdipole(pos: *f64, out: *BjFieldVector): i64 {
    var m: BjFieldVector = BjFieldVector_new(_par_tf[0], _par_tf[1], _par_tf[2]);
    var t, v = bj_magnetic_dipole_field(m, pos, out);
    return _par_tf_status(t, v);
}

# A `field::trace_field_line` row: the scenario's field function, the trace, and its points or error.
fn _par_trace(): i64 {
    var a: f64[3];
    var id = _par_in(0);
    _par_in3(1, &a);
    var step: f64 = _par_in(4);
    var max = _par_in(5);
    var np = _par_in_f64s(6, &_par_tf);
    var fp = &_par_tf_uniform;
    if (id == 1) { fp = &_par_tf_point; }
    elif (id == 2) { fp = &_par_tf_dipole; }
    elif (id == 3) { fp = &_par_tf_quadrupole; }
    elif (id == 4) { fp = &_par_tf_sink; }
    elif (id == 5) { fp = &_par_tf_error; }
    elif (id == 6) { fp = &_par_tf_nan; }
    elif (id == 7) { fp = &_par_tf_inf; }
    elif (id == 8) { fp = &_par_tf_mdipole; }
    var poly = BjPolyline_new();
    var t, v = bj_trace_field_line(&a, step, max, fp, &poly);
    if (is_err_result(t) == 1) {
        _par_got_error(v);
    } else {
        var n = poly.count();
        _par_got_seq(3 * n);
        for (var k = 0; k < n; k = k + 1) {
            var p: *f64 = poly.at(k);
            var x: f64 = p[0];
            var y: f64 = p[1];
            var z: f64 = p[2];
            _par_got_f(x);
            _par_got_f(y);
            _par_got_f(z);
        }
    }
    BjPolyline_free(&poly);
    if (np < 0) { return 0 - 1; }
    return 1;
}

# Part 3b's `field::*` rows, by name; −2 for a name that is not one of them.
fn _par_field_3b(fp, fl): i64 {
    var a: f64[3];
    var b: f64[3];
    var tq: f64[9];
    var cs: f64[24];
    var c: BjComplex;
    if (_par_eq(fp, fl, "field::trace_field_line") == 1) { return _par_trace(); }
    if (_par_eq(fp, fl, "field::electric_field_infinite_plane") == 1) {
        var x0: f64 = _par_in(0);
        var e0: f64 = bj_electric_field_infinite_plane(x0);
        _par_got_f(e0);
        return 1;
    }
    if (_par_eq(fp, fl, "field::multipole_moment") == 1) {
        var n4 = _par_in_f64s(2, &cs);
        var t1, v1 = bj_multipole_moment(_par_in(0), _par_in(1), &cs, n4 / 4);
        _par_got_res_f(t1, v1);
        return 1;
    }
    if (_par_eq(fp, fl, "field::spherical_multipole_moment") == 1) {
        var n4b = _par_in_f64s(2, &cs);
        var t2, v2 = bj_spherical_multipole_moment(_par_in(0), _par_in(1), &cs, n4b / 4, &c);
        _par_got_res_c(t2, v2, c);
        return 1;
    }
    if (_par_eq(fp, fl, "field::poynting_flux_surface") == 1) {
        var sm: f64[50];
        var n10 = _par_in_f64s(0, &sm);
        var pf: f64 = bj_poynting_flux_surface(&sm, n10 / 10);
        _par_got_f(pf);
        return 1;
    }
    if (_par_eq(fp, fl, "field::maxwell_stress_tensor") == 1) {
        var e1: BjFieldVector = _par_in_fv(0);
        var b1: BjFieldVector = _par_in_fv(3);
        bj_maxwell_stress_tensor(e1, b1, &tq);
        for (var k = 0; k < 9; k = k + 1) {
            var w: f64 = tq[k];
            _par_got_f(w);
        }
        return 1;
    }
    if (_par_eq(fp, fl, "field::stress_tensor_force") == 1) {
        for (var k2 = 0; k2 < 9; k2 = k2 + 1) { tq[k2] = _par_in(k2); }
        var nv: BjFieldVector = _par_in_fv(9);
        _par_got_fv(bj_stress_tensor_force(&tq, nv));
        return 1;
    }
    if (_par_eq(fp, fl, "field::electric_quadrupole_potential") == 1) {
        for (var k3 = 0; k3 < 9; k3 = k3 + 1) { tq[k3] = _par_in(k3); }
        _par_in3(9, &a);
        var t3, v3 = bj_electric_quadrupole_potential(&tq, &a);
        _par_got_res_f(t3, v3);
        return 1;
    }
    if (_par_eq(fp, fl, "field::greens_function_scalar") == 1) {
        _par_in3(0, &a);
        _par_in3(3, &b);
        var k6: f64 = _par_in(6);
        var t4, v4 = bj_greens_function_scalar(&a, &b, k6, &c);
        if (is_ok(t4) == 1) {
            # ADR 0002 row 5: the port's e^{−jkR} is the oracle's e^{+ikR} conjugated; compare it conjugated back.
            c = c.conj();
            _par_map5_greens = _par_map5_greens + 1;
        }
        _par_got_res_c(t4, v4, c);
        return 1;
    }
    if (_par_eq(fp, fl, "field::greens_function_static") == 1) {
        _par_in3(0, &a);
        _par_in3(3, &b);
        var t5, v5 = bj_greens_function_static(&a, &b);
        _par_got_res_f(t5, v5);
        return 1;
    }
    if (_par_eq(fp, fl, "field::image_charge_plane") == 1) {
        var q1: f64 = _par_in(0);
        _par_in3(1, &a);
        var z1: f64 = _par_in(4);
        var qi: f64 = bj_image_charge_plane(q1, &a, z1, &b);
        _par_got_f(qi);
        var bx: f64 = b[0];
        var by: f64 = b[1];
        var bz: f64 = b[2];
        _par_got_f(bx);
        _par_got_f(by);
        _par_got_f(bz);
        return 1;
    }
    if (_par_eq(fp, fl, "field::image_charge_sphere") == 1) {
        var q2: f64 = _par_in(0);
        _par_in3(1, &a);
        var r2: f64 = _par_in(4);
        var t6, v6 = bj_image_charge_sphere(q2, &a, r2, &b);
        _par_got_res_image(t6, v6, &b);
        return 1;
    }
    if (_par_eq(fp, fl, "field::image_charge_dielectric") == 1) {
        var q3: f64 = _par_in(0);
        _par_in3(1, &a);
        var ea: f64 = _par_in(4);
        var eb: f64 = _par_in(5);
        var t7, v7 = bj_image_charge_dielectric(q3, &a, ea, eb, &b);
        _par_got_res_image(t7, v7, &b);
        return 1;
    }
    if (_par_in_n < 2) { return 0 - 2; }
    var p0: f64 = _par_in(0);
    var p1: f64 = _par_in(1);
    if (_par_eq(fp, fl, "field::electric_field_charged_sphere") == 1) {
        var t8, v8 = bj_electric_field_charged_sphere(p0, p1);
        _par_got_res_f(t8, v8);
        return 1;
    }
    if (_par_eq(fp, fl, "field::electric_field_infinite_line") == 1) {
        var t9, v9 = bj_electric_field_infinite_line(p0, p1);
        _par_got_res_f(t9, v9);
        return 1;
    }
    if (_par_eq(fp, fl, "field::electric_field_outside_cylinder") == 1) {
        var t10, v10 = bj_electric_field_outside_cylinder(p0, p1);
        _par_got_res_f(t10, v10);
        return 1;
    }
    if (_par_eq(fp, fl, "field::electric_field_inside_cylinder") == 1) {
        var t11, v11 = bj_electric_field_inside_cylinder(p0, p1);
        _par_got_res_f(t11, v11);
        return 1;
    }
    if (_par_in_n < 3) { return 0 - 2; }
    var p2: f64 = _par_in(2);
    if (_par_eq(fp, fl, "field::electric_field_inside_sphere") == 1) {
        var t12, v12 = bj_electric_field_inside_sphere(p0, p1, p2);
        _par_got_res_f(t12, v12);
        return 1;
    }
    if (_par_eq(fp, fl, "field::electric_field_ring_axis") == 1) {
        var t13, v13 = bj_electric_field_ring_axis(p0, p1, p2);
        _par_got_res_f(t13, v13);
        return 1;
    }
    if (_par_eq(fp, fl, "field::electric_field_disk_axis") == 1) {
        var t14, v14 = bj_electric_field_disk_axis(p0, p1, p2);
        _par_got_res_f(t14, v14);
        return 1;
    }
    return 0 - 2;
}

# `FieldVector::*` and `field::*` rows: src/field.cyr (M1 parts 3a and 3b).
public fn _par_field(fp, fl): i64 {
    var r3b = _par_field_3b(fp, fl);
    if (r3b != 0 - 2) { return r3b; }
    if (_par_eq(fp, fl, "FieldVector::zero") == 1) { _par_got_fv(BjFieldVector_zero()); return 1; }
    if (_par_eq(fp, fl, "FieldVector::default") == 1) { _par_got_fv(BjFieldVector_default()); return 1; }
    var a: f64[3];
    var b: f64[3];
    var c: f64[3];
    var e: BjFieldVector;
    if (_par_eq(fp, fl, "field::electric_energy_density") == 1) {
        var x0: f64 = _par_in(0);
        var u0: f64 = bj_electric_energy_density(x0);
        _par_got_f(u0);
        return 1;
    }
    if (_par_eq(fp, fl, "field::magnetic_energy_density") == 1) {
        var x1: f64 = _par_in(0);
        var u1: f64 = bj_magnetic_energy_density(x1);
        _par_got_f(u1);
        return 1;
    }
    if (_par_eq(fp, fl, "field::electric_field_superposition") == 1) {
        var cs: f64[24];
        var n4 = _par_in_f64s(0, &cs);
        _par_in3(n4 + 1, &a);
        var ts, vs = bj_electric_field_superposition(&cs, n4 / 4, &a, &e);
        _par_got_res_v(ts, vs, e);
        return 1;
    }
    if (_par_eq(fp, fl, "f64::mul_field_vector") == 1) {
        var s0: f64 = _par_in(0);
        var w0: BjFieldVector = _par_in_fv(1);
        _par_got_fv(BjFieldVector_scale_left(s0, w0));
        return 1;
    }
    var v: BjFieldVector = _par_in_fv(0);
    if (_par_eq(fp, fl, "FieldVector::new") == 1) { _par_got_fv(v); return 1; }
    if (_par_eq(fp, fl, "FieldVector::magnitude") == 1) { var mg: f64 = v.magnitude(); _par_got_f(mg); return 1; }
    if (_par_eq(fp, fl, "FieldVector::magnitude_sq") == 1) {
        var m2: f64 = v.magnitude_sq();
        _par_got_f(m2);
        return 1;
    }
    if (_par_eq(fp, fl, "FieldVector::normalized") == 1) {
        var tn, vn = v.normalized(&e);
        _par_got_res_v(tn, vn, e);
        return 1;
    }
    if (_par_eq(fp, fl, "FieldVector::neg") == 1) { _par_got_fv(BjFieldVector_neg(v)); return 1; }
    if (_par_eq(fp, fl, "FieldVector::fmt") == 1) {
        var buf[1100];
        var tx[24];
        _bj_tx_init(&tx, &buf, 1100);
        v.display(&tx);
        if (_bj_tx_overflowed(&tx) == 1) { return 0 - 1; }
        _par_got_text(_bj_tx_ptr(&tx), _bj_tx_len(&tx));
        return 1;
    }
    if (_par_eq(fp, fl, "FieldVector::from_array") == 1) {
        _par_in3(0, &a);
        _par_got_fv(BjFieldVector_from_array(&a));
        return 1;
    }
    if (_par_eq(fp, fl, "FieldVector::into_array") == 1) {
        v.to_array(&a);
        var a0: f64 = a[0];
        var a1: f64 = a[1];
        var a2: f64 = a[2];
        _par_got_f(a0);
        _par_got_f(a1);
        _par_got_f(a2);
        return 1;
    }
    if (_par_in_n == 4) {
        var x4: f64 = _par_in(3);
        if (_par_eq(fp, fl, "FieldVector::scale") == 1) { _par_got_fv(v.scale(x4)); return 1; }
        if (_par_eq(fp, fl, "FieldVector::mul") == 1) { _par_got_fv(v * x4); return 1; }
        return 0;
    }
    if (_par_in_n == 6) {
        var w: BjFieldVector = _par_in_fv(3);
        if (_par_eq(fp, fl, "FieldVector::dot") == 1) { var d: f64 = v.dot(w); _par_got_f(d); return 1; }
        if (_par_eq(fp, fl, "FieldVector::cross") == 1) { _par_got_fv(v.cross(w)); return 1; }
        if (_par_eq(fp, fl, "FieldVector::add") == 1) { _par_got_fv(v + w); return 1; }
        if (_par_eq(fp, fl, "FieldVector::sub") == 1) { _par_got_fv(v - w); return 1; }
        _par_in3(3, &b);
        if (_par_eq(fp, fl, "field::electric_dipole_field") == 1) {
            var t1, v1 = bj_electric_dipole_field(v, &b, &e);
            _par_got_res_v(t1, v1, e);
            return 1;
        }
        if (_par_eq(fp, fl, "field::electric_dipole_potential") == 1) {
            var t2, v2 = bj_electric_dipole_potential(v, &b);
            _par_got_res_f(t2, v2);
            return 1;
        }
        if (_par_eq(fp, fl, "field::magnetic_dipole_field") == 1) {
            var t3, v3 = bj_magnetic_dipole_field(v, &b, &e);
            _par_got_res_v(t3, v3, e);
            return 1;
        }
        return 0;
    }
    var q: f64 = _par_in(0);
    _par_in3(1, &a);
    if (_par_in_n == 7) {
        _par_in3(4, &b);
        if (_par_eq(fp, fl, "field::electric_field_point_charge") == 1) {
            var t4, v4 = bj_electric_field_point_charge(q, &a, &b, &e);
            _par_got_res_v(t4, v4, e);
            return 1;
        }
        if (_par_eq(fp, fl, "field::electric_potential_point_charge") == 1) {
            var t5, v5 = bj_electric_potential_point_charge(q, &a, &b);
            _par_got_res_f(t5, v5);
            return 1;
        }
        return 0;
    }
    if (_par_in_n == 10 && _par_eq(fp, fl, "field::magnetic_field_moving_charge") == 1) {
        _par_in3(4, &b);
        _par_in3(7, &c);
        var t6, v6 = bj_magnetic_field_moving_charge(q, &a, &b, &c, &e);
        _par_got_res_v(t6, v6, e);
        return 1;
    }
    return 0;
}

# `f64::fmt_display` and `serde_json::f64` rows: src/fmtf.cyr's two layouts, into a bounded BjText.
fn _par_fmtf(fp, fl): i64 {
    var x: f64 = _par_in(0);
    var buf[400];
    var t[24];
    _bj_tx_init(&t, &buf, 400);
    if (_par_eq(fp, fl, "f64::fmt_display") == 1) {
        _bj_fmt_f64_display(&t, x);
    } elif (_par_eq(fp, fl, "f64::fmt_debug") == 1) {
        _bj_fmt_f64_debug(&t, x);
    } elif (_par_eq(fp, fl, "serde_json::f64") == 1) {
        _bj_fmt_f64_json(&t, x);
    } else {
        return 0;
    }
    if (_bj_tx_overflowed(&t) == 1) { return 0 - 1; }
    _par_got_text(_bj_tx_ptr(&t), _bj_tx_len(&t));
    return 1;
}

public fn _par_dispatch(mp, ml, fp, fl): i64 {
    _par_got_n = 0;
    if (_par_eq(mp, ml, "complex") == 1) { return _par_complex(fp, fl); }
    if (_par_eq(mp, ml, "constants") == 1) { return _par_constants(fp, fl); }
    if (_par_eq(mp, ml, "error") == 1) { return _par_error(fp, fl); }
    if (_par_eq(mp, ml, "field") == 1) { return _par_field(fp, fl); }
    if (_par_eq(mp, ml, "fmtf") == 1) { return _par_fmtf(fp, fl); }
    if (_par_eq(mp, ml, "math") == 1) { return _par_math(fp, fl); }
    return 0;
}

# Shadow comparisons, never gated: the same golden rows through another Cyrius candidate.
# - the exp and atan polyfills, the cross-target fallback before src/crmath.cyr (1 ulp from the corrected
#   oracle on a few percent of rows);
# - the stdlib min / max, to show where their NaN semantics differ from Rust's.
public fn _par_shadows(mp, ml, fp, fl, cls) {
    # The port's own outputs, still in the got list after dispatch: fold them first.
    if (_par_got_n > 0) { _par_dg_fold(_par_dg_slot(fp, fl)); }
    if (_par_eq(mp, ml, "math") != 1) { return 0; }
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "f64::exp") == 1) {
        _par_got_n = 0;
        var r: f64 = _f64_exp_polyfill(x);
        _par_got_f(r);
        _par_shadow_record("f64::exp ~ _f64_exp_polyfill", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::atan") == 1) {
        _par_got_n = 0;
        var r: f64 = _f64_atan_polyfill(x);
        _par_got_f(r);
        _par_shadow_record("f64::atan ~ _f64_atan_polyfill", cls);
        return 0;
    }
    if (_par_in_n < 2) { return 0; }
    if (_par_eq(fp, fl, "f64::powi") == 1) { return 0; }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "f64::max") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_max(x, y);
        _par_got_f(r);
        _par_shadow_record("f64::max ~ f64_max", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::min") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_min(x, y);
        _par_got_f(r);
        _par_shadow_record("f64::min ~ f64_min", cls);
        return 0;
    }
    return 0;
}

# The class-C bound for a function, in ulps; -1 when none is set yet (the rows are measured). bijli's bound is 0
# against the corrected oracle (ADR 0001), set per function as its correctly rounded form is dispatched.
#must_use
public fn _par_c_bound(fp, fl): i64 {
    if (_par_eq(fp, fl, "f64::cbrt") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::exp") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::sin") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::cos") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::sin_cos") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::hypot") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::powf") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::atan2") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::atan") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::asin") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::acos") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::log10") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::tan") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::sinh") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::cosh") == 1) { return 0; }
    if (_par_eq(fp, fl, "Complex::arg") == 1) { return 0; }
    if (_par_eq(fp, fl, "Complex::sin") == 1) { return 0; }
    if (_par_eq(fp, fl, "Complex::cos") == 1) { return 0; }
    if (_par_eq(fp, fl, "Complex::exp") == 1) { return 0; }
    if (_par_eq(fp, fl, "Complex::ln") == 1) { return 0; }
    if (_par_eq(fp, fl, "Complex::sqrt") == 1) { return 0; }
    if (_par_eq(fp, fl, "Complex::powf") == 1) { return 0; }
    if (_par_eq(fp, fl, "Complex::from_polar") == 1) { return 0; }
    if (_par_eq(fp, fl, "polarization::complex_from_polar") == 1) { return 0; }
    if (_par_eq(fp, fl, "field::multipole_moment") == 1) { return 0; }
    if (_par_eq(fp, fl, "field::spherical_multipole_moment") == 1) { return 0; }
    if (_par_eq(fp, fl, "field::greens_function_scalar") == 1) { return 0; }
    return 0 - 1;
}

# The ADR accepting a divergent row (function and raw input field), or 0. None yet: the ADR 0002
# mappings arrive with their modules.
#must_use
public fn _par_accepted(fp, fl, ip, il): i64 {
    return 0;
}

# 1 for an ADR whose accepted rows are counted but not printed row by row. None yet.
#must_use
public fn _par_accepted_quiet(adr): i64 {
    return 0;
}

# Module-specific summary lines after a module's report: each function's cross-target digest.
public fn _par_module_done(mp, ml) {
    if (_par_eq(mp, ml, "field") == 1) {
        print("  ADR 0002 row 5 (e^{+jωt}): ", 30);
        fmt_int(_par_map5_greens);
        println(" field::greens_function_scalar rows compared as port = conj(oracle)");
    }
    _par_dg_print_all();
    _par_dg_init();
    return 0;
}

# Every module is replayed here: bijli has one profile.
#must_use
public fn _par_skip(mp, ml): i64 {
    return 0;
}

# The first top-level statement: every `public` hook above must precede it, since the library modules prepended
# to this unit are `private` (src/error.cyr) and parity_core.cyr calls the hooks from its own file.
alloc_init();
_par_dg_init();
var exit_code = _par_main();
sys_exit_group(exit_code);
