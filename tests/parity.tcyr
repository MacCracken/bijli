# parity.tcyr — replays the golden corpus (tests/golden/*.tsv) against the port.
#
# Port plan §6 step 7, adapted from impetus's tests/parity_2d.tcyr at its M0 (itself kimiya's
# tests/parity.tcyr and tanmatra's). Format and comparison rules: scripts/oracle/README.md. The
# module list is tests/golden/modules.txt, which the generator writes. The replay machinery is
# tests/parity_core.cyr; this file holds the dispatchers. The library modules come from
# cyrius.cyml's [test] modules, prepended to every test unit.
#
# Every row of every module is one of:
# - ok: every output matched within its class;
# - FAILED: an output differs; the first 10 per module are printed with the row's note and both
#   bit patterns;
# - measured: class C, with no bound set yet for its function. The ulp distance is recorded but
#   not gated. bijli's class-C rows gate at 0 ulp once src/crmath.cyr dispatches them (M1); until
#   then the stdlib/ganita counterparts are measured, which is the M0 step 8 baseline;
# - accepted: a divergence an ADR accepts, listed by row in _par_accepted;
# - pending: its function isn't ported yet (no dispatcher entry).
#
# Per function it prints the row counts and the ulp histogram. Shadow lines (`fn ~ candidate`)
# compare the same rows against another Cyrius candidate and are never gated. The exit code is
# the number of modules with a failure.

include "tests/lib.cyr"

include "tests/ulp.cyr"

include "tests/parity_core.cyr"

# ── hooks ───────────────────────────────────────────────────────────────────────────

# The Rust variant name of an error code: src/error.cyr's.
#must_use
public fn _par_error_name(code): i64 {
    return bj_error_name(code);
}

# ── cross-target digests (M0 step 8) ────────────────────────────────────────────────
# A 64-bit FNV-1a fold of every output word the port returns, per function, in row order. Run on
# x86_64 ELF, x86_64 PE and aarch64: equal digests mean bit-identical results on every row, which
# is what ADR 0002 row 6 promises. Histograms alone can't show that. One slot per golden function
# (_PAR_DG_NAMES, in order), then one per shadow.
var _PAR_DG_N = 64;
var _par_dg: i64[64];
var _par_dg_used = 0;
var _PAR_DG_NAMES = 0;

fn _par_dg_init() {
    for (var k = 0; k < _PAR_DG_N; k = k + 1) { _par_dg[k] = 0xcbf29ce484222325; }
    _par_dg_used = 0;
    return 0;
}

# The digest slot of (function), registered on first sight in a module's row order; -1 when the
# table is full.
var _par_dg_fp: i64[64];
var _par_dg_fl: i64[64];
fn _par_dg_slot(fp, fl): i64 {
    for (var k = 0; k < _par_dg_used; k = k + 1) {
        if (_par_dg_fl[k] == fl && memeq(_par_dg_fp[k], fp, fl) == 1) { return k; }
    }
    if (_par_dg_used >= _PAR_DG_N) { return 0 - 1; }
    _par_dg_fp[_par_dg_used] = fp;
    _par_dg_fl[_par_dg_used] = fl;
    _par_dg_used = _par_dg_used + 1;
    return _par_dg_used - 1;
}

# One digest step: FNV-1a's xor and multiply, then a right-shift mix. The multiply alone carries a difference only
# upward, so a difference in a word's bit 63 (an f64's sign) reached only the digest's own bit 63, and two of them
# cancelled; the shift brings every bit down (port-parity.md §9, digest v2).
#must_use
fn _par_dg_step(h, v): i64 {
    var x = (h ^ v) * 0x100000001b3;
    return x ^ (x >>> 29);
}

# Folds the got list into digest `slot`: a word for f, i, v and n tokens, every NaN as the one quiet NaN (IEEE 754
# leaves a generated NaN's sign and payload to the hardware: x86 makes 0xFFF8…, ARM 0x7FF8…, and the class rules
# match any NaN with any NaN), and the bytes of the text for s, e and E tokens (whose word is an address).
fn _par_dg_fold(slot) {
    if (slot < 0) { return 0; }
    var h = _par_dg[slot];
    for (var k = 0; k < _par_got_n; k = k + 1) {
        var kind = load64(_par_got_k + k * 8);
        var v = load64(_par_got_v + k * 8);
        if (kind == 115 || kind == 101 || kind == 69) {
            var len = load64(_par_got_l + k * 8);
            for (var j = 0; j < len; j = j + 1) { h = _par_dg_step(h, load8(v + j)); }
            h = _par_dg_step(h, 0xff);
        } else {
            if (kind == 102 && (v & 0x7FFFFFFFFFFFFFFF) > 0x7FF0000000000000) { v = 0x7FF8000000000000; }
            h = _par_dg_step(h, v);
        }
    }
    _par_dg[slot] = h;
    return 0;
}

# Prints every registered digest.
fn _par_dg_print_all() {
    for (var k = 0; k < _par_dg_used; k = k + 1) {
        print("  digest ", 9);
        _par_print_pad(_par_dg_fp[k], _par_dg_fl[k], 34);
        print(" 0x", 3);
        fmt_hex(_par_dg[k]);
        println("");
    }
    return 0;
}

# ── dispatch ────────────────────────────────────────────────────────────────────────
# Each module's dispatcher fills the got list for one row. It returns 1 when it handled the
# function, 0 when the function is pending (not ported), or -1 when the inputs are unusable (a
# defect, counted as a failure). Add a function the moment it's ported.

# `const` rows (input `s:<path>`): src/constants.cyr's BJ_ consts. Any other name is a defect.
fn _par_constants(fp, fl): i64 {
    if (_par_eq(fp, fl, "const") != 1 || _par_in_n != 1) { return 0 - 1; }
    var np = load64(_par_in_v);
    var nl = load64(_par_in_l);
    if (_par_eq(np, nl, "charge::ELEMENTARY_CHARGE") == 1) { _par_got_f(BJ_ELEMENTARY_CHARGE); return 1; }
    if (_par_eq(np, nl, "charge::ELECTRON_MASS") == 1) { _par_got_f(BJ_ELECTRON_MASS); return 1; }
    if (_par_eq(np, nl, "charge::PROTON_MASS") == 1) { _par_got_f(BJ_PROTON_MASS); return 1; }
    if (_par_eq(np, nl, "fdtd::FOURTH_ORDER_C1") == 1) { _par_got_f(BJ_FOURTH_ORDER_C1); return 1; }
    if (_par_eq(np, nl, "fdtd::FOURTH_ORDER_C2") == 1) { _par_got_f(BJ_FOURTH_ORDER_C2); return 1; }
    if (_par_eq(np, nl, "field::EPSILON_0") == 1) { _par_got_f(BJ_EPSILON_0); return 1; }
    if (_par_eq(np, nl, "field::MU_0") == 1) { _par_got_f(BJ_MU_0); return 1; }
    if (_par_eq(np, nl, "field::SPEED_OF_LIGHT") == 1) { _par_got_f(BJ_SPEED_OF_LIGHT); return 1; }
    if (_par_eq(np, nl, "field::COULOMB_K") == 1) { _par_got_f(BJ_COULOMB_K); return 1; }
    if (_par_eq(np, nl, "field::SPEED_OF_LIGHT_SQ") == 1) { _par_got_f(BJ_SPEED_OF_LIGHT_SQ); return 1; }
    if (_par_eq(np, nl, "scattering::MIE_MAX_SIZE_PARAMETER") == 1) {
        _par_got_f(BJ_MIE_MAX_SIZE_PARAMETER);
        return 1;
    }
    if (_par_eq(np, nl, "scattering::MIE_MAX_MX") == 1) { _par_got_f(BJ_MIE_MAX_MX); return 1; }
    return 0 - 1;
}

# `f64::*` rows: the Rust std reference values (port plan §9.1).
# - Classes A and B: the builtins (sqrt, abs, ceil) and src/mathx.cyr, gated.
# - Class C: src/crmath.cyr's correctly rounded exp, sin, cos, sin_cos, hypot, pow, atan2 and atan (M1 part 1a),
#   gated at 0 ulp against the corrected oracle (tests/golden/math.cr.tsv where glibc misrounds), and
#   src/crmath_k.cyr's acos, log10 (kimiya's) and asin (M1 part 1b), tan (bijli's, M1 part 1c), and sinh and cosh
#   (bijli's, M1 part 2d, which hisab's complex sin and cos reach); cbrt is ganita's
#   correctly rounded one, against the oracle's correctly rounded one (compiler-builtins).
fn _par_math(fp, fl): i64 {
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "f64::sqrt") == 1) { var r: f64 = f64_sqrt(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::abs") == 1) { var r: f64 = f64_abs(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::ceil") == 1) { var r: f64 = f64_ceil(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::is_nan") == 1) { _par_got_i(_bj_is_nan(x)); return 1; }
    if (_par_eq(fp, fl, "f64::is_finite") == 1) { _par_got_i(_bj_is_finite(x)); return 1; }
    if (_par_eq(fp, fl, "f64::to_radians") == 1) { var r: f64 = _bj_to_radians(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::to_degrees") == 1) { var r: f64 = _bj_to_degrees(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::sin_cos") == 1) {
        var s, c = _bj_sin_cos(x);
        var sv: f64 = s;
        var cv: f64 = c;
        _par_got_f(sv);
        _par_got_f(cv);
        return 1;
    }
    if (_par_eq(fp, fl, "f64::sin") == 1) { var r: f64 = _bj_sin(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::cos") == 1) { var r: f64 = _bj_cos(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::tan") == 1) { var r: f64 = _bj_tan(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::exp") == 1) { var r: f64 = _bj_exp(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::atan") == 1) { var r: f64 = _bj_atan(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::asin") == 1) { var r: f64 = _bj_asin(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::acos") == 1) { var r: f64 = _bj_acos(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::cbrt") == 1) { var r: f64 = ganita_f64_cbrt(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::log10") == 1) { var r: f64 = _bj_log10(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::sinh") == 1) { var r: f64 = _bj_sinh(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::cosh") == 1) { var r: f64 = _bj_cosh(x); _par_got_f(r); return 1; }
    if (_par_in_n < 2) { return 0; }
    if (_par_eq(fp, fl, "f64::powi") == 1) {
        var n = _par_in(1);
        var r: f64 = _bj_powi(x, n);
        _par_got_f(r);
        return 1;
    }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "f64::min") == 1) { var r: f64 = _bj_min(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::max") == 1) { var r: f64 = _bj_max(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::copysign") == 1) { var r: f64 = _bj_copysign(x, y); _par_got_f(r); return 1; }
    # Rust's y.atan2(x) is the golden f64::atan2(y, x): inputs in C order.
    if (_par_eq(fp, fl, "f64::atan2") == 1) { var r: f64 = _bj_atan2(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::hypot") == 1) { var r: f64 = _bj_hypot(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powf") == 1) { var r: f64 = _bj_powf(x, y); _par_got_f(r); return 1; }
    if (_par_in_n < 3) { return 0; }
    if (_par_eq(fp, fl, "f64::clamp") == 1) {
        var hi: f64 = _par_in(2);
        var r: f64 = _bj_clamp(x, y, hi);
        _par_got_f(r);
        return 1;
    }
    return 0;
}

# `BijliError::*` rows: src/error.cyr's constructors, then the calling thread's record read back: the code (the
# `E:` token, which must be the code the constructor returned), the variant's fields through bj_last_error_*,
# and Rust's Display text.
fn _par_error(fp, fl): i64 {
    var code = 0 - 1;
    if (_par_eq(fp, fl, "BijliError::DimensionMismatch") == 1) {
        code = _bj_err_dimension_mismatch(_par_in(0), _par_in(1));
        _par_got_err(bj_last_error());
        _par_got_i(bj_last_error_expected());
        _par_got_i(bj_last_error_got());
    } elif (_par_eq(fp, fl, "BijliError::ZeroCharge") == 1) {
        code = _bj_err_zero_charge();
        _par_got_err(bj_last_error());
    } elif (_par_eq(fp, fl, "BijliError::Singularity") == 1) {
        code = _bj_err_singularity();
        _par_got_err(bj_last_error());
    } elif (_par_eq(fp, fl, "BijliError::InsufficientResolution") == 1) {
        var d: f64 = _par_in(1);
        code = _bj_err_insufficient_resolution(_par_in(0), d);
        _par_got_err(bj_last_error());
        _par_got_i(bj_last_error_cells());
        var ds: f64 = bj_last_error_domain_size();
        _par_got_f(ds);
    } elif (_par_eq(fp, fl, "BijliError::InvalidPermittivity") == 1) {
        var v1: f64 = _par_in(0);
        code = _bj_err_invalid_permittivity(v1);
        _par_got_err(bj_last_error());
        var r1: f64 = bj_last_error_value();
        _par_got_f(r1);
    } elif (_par_eq(fp, fl, "BijliError::InvalidPermeability") == 1) {
        var v2: f64 = _par_in(0);
        code = _bj_err_invalid_permeability(v2);
        _par_got_err(bj_last_error());
        var r2: f64 = bj_last_error_value();
        _par_got_f(r2);
    } elif (_par_eq(fp, fl, "BijliError::DivisionByZero") == 1) {
        var c1 = _par_in_cstr(0);
        if (c1 == 0) { return 0 - 1; }
        code = _bj_err_division_by_zero(c1);
        _par_got_err(bj_last_error());
        var d1 = bj_last_error_detail();
        _par_got_text(d1, strlen(d1));
    } elif (_par_eq(fp, fl, "BijliError::InvalidParameter") == 1) {
        var c2 = _par_in_cstr(0);
        if (c2 == 0) { return 0 - 1; }
        code = _bj_err_invalid_parameter(c2);
        _par_got_err(bj_last_error());
        var d2 = bj_last_error_detail();
        _par_got_text(d2, strlen(d2));
    } elif (_par_eq(fp, fl, "BijliError::InvalidParameter/f64") == 1) {
        var pre = _par_in_cstr(0);
        if (pre == 0) { return 0 - 1; }
        var x: f64 = _par_in(1);
        var tx = _bj_err_reason(BJ_ERR_INVALID_PARAMETER);
        _bj_tx_cstr(tx, pre);
        _bj_fmt_f64_display(tx, x);
        code = BJ_ERR_INVALID_PARAMETER;
        _par_got_err(bj_last_error());
        var d3 = bj_last_error_detail();
        _par_got_text(d3, strlen(d3));
    } else {
        return 0;
    }
    if (code != bj_last_error()) { return 0 - 1; }
    var txt = bj_last_error_display();
    _par_got_text(txt, strlen(txt));
    return 1;
}

# A complex result to the got list: its two parts, the real first (format 1).
fn _par_got_c(z: BjComplex) {
    var re: f64 = z.re;
    var im: f64 = z.im;
    _par_got_f(re);
    _par_got_f(im);
    return 0;
}

# `Complex::*` and polarization's complex rows: src/complex.cyr's BjComplex. Inputs are complex values as two f64
# tokens each; an f64 operand follows them (before them for `f64::mul_complex`, Rust's `x * z`).
public fn _par_complex(fp, fl): i64 {
    if (_par_eq(fp, fl, "Complex::default") == 1) { _par_got_c(BjComplex_default()); return 1; }
    if (_par_eq(fp, fl, "polarization::complex_zero") == 1) { _par_got_c(bj_complex_zero()); return 1; }
    if (_par_in_n < 1) { return 0; }
    var x0: f64 = _par_in(0);
    if (_par_eq(fp, fl, "Complex::from_real") == 1) { _par_got_c(BjComplex_from_real(x0)); return 1; }
    if (_par_eq(fp, fl, "polarization::complex_real") == 1) { _par_got_c(bj_complex_real(x0)); return 1; }
    if (_par_in_n < 2) { return 0; }
    var x1: f64 = _par_in(1);
    if (_par_eq(fp, fl, "Complex::from_polar") == 1) { _par_got_c(BjComplex_from_polar(x0, x1)); return 1; }
    if (_par_eq(fp, fl, "polarization::complex_from_polar") == 1) {
        _par_got_c(bj_complex_from_polar(x0, x1));
        return 1;
    }
    var z = BjComplex_new(x0, x1);
    if (_par_eq(fp, fl, "Complex::new") == 1) { _par_got_c(z); return 1; }
    if (_par_eq(fp, fl, "Complex::abs") == 1) { var a: f64 = z.abs(); _par_got_f(a); return 1; }
    if (_par_eq(fp, fl, "ComplexExt::norm") == 1) { var nm: f64 = z.norm(); _par_got_f(nm); return 1; }
    if (_par_eq(fp, fl, "Complex::norm_sq") == 1) { var ns: f64 = z.norm_sq(); _par_got_f(ns); return 1; }
    if (_par_eq(fp, fl, "Complex::arg") == 1) { var g: f64 = z.arg(); _par_got_f(g); return 1; }
    if (_par_eq(fp, fl, "Complex::conj") == 1) { _par_got_c(z.conj()); return 1; }
    if (_par_eq(fp, fl, "Complex::neg") == 1) { _par_got_c(BjComplex_neg(z)); return 1; }
    if (_par_eq(fp, fl, "Complex::inv") == 1) { _par_got_c(z.inv()); return 1; }
    if (_par_eq(fp, fl, "Complex::exp") == 1) { _par_got_c(z.exp()); return 1; }
    if (_par_eq(fp, fl, "Complex::ln") == 1) { _par_got_c(z.ln()); return 1; }
    if (_par_eq(fp, fl, "Complex::sqrt") == 1) { _par_got_c(z.sqrt()); return 1; }
    if (_par_eq(fp, fl, "Complex::sin") == 1) { _par_got_c(z.sin()); return 1; }
    if (_par_eq(fp, fl, "Complex::cos") == 1) { _par_got_c(z.cos()); return 1; }
    if (_par_eq(fp, fl, "Complex::fmt") == 1) {
        var buf[800];
        var tx[24];
        _bj_tx_init(&tx, &buf, 800);
        z.display(&tx);
        if (_bj_tx_overflowed(&tx) == 1) { return 0 - 1; }
        _par_got_text(_bj_tx_ptr(&tx), _bj_tx_len(&tx));
        return 1;
    }
    if (_par_in_n < 3) { return 0; }
    var x2: f64 = _par_in(2);
    if (_par_eq(fp, fl, "Complex::mul_f64") == 1) { _par_got_c(z.scale(x2)); return 1; }
    if (_par_eq(fp, fl, "Complex::div_f64") == 1) { _par_got_c(z.div_f64(x2)); return 1; }
    if (_par_eq(fp, fl, "Complex::is_zero") == 1) { _par_got_i(z.is_zero(x2)); return 1; }
    if (_par_eq(fp, fl, "Complex::powf") == 1) { _par_got_c(z.powf(x2)); return 1; }
    if (_par_eq(fp, fl, "f64::mul_complex") == 1) {
        var zr = BjComplex_new(x1, x2);
        _par_got_c(zr.scale(x0));
        return 1;
    }
    if (_par_in_n < 4) { return 0; }
    var x3: f64 = _par_in(3);
    var w = BjComplex_new(x2, x3);
    if (_par_eq(fp, fl, "Complex::add") == 1) { _par_got_c(z + w); return 1; }
    if (_par_eq(fp, fl, "Complex::sub") == 1) { _par_got_c(z - w); return 1; }
    if (_par_eq(fp, fl, "Complex::mul") == 1) { _par_got_c(z * w); return 1; }
    if (_par_eq(fp, fl, "Complex::div") == 1) { _par_got_c(z / w); return 1; }
    return 0;
}

# A BjFieldVector to the got list: x, y, z.
fn _par_got_fv(v: BjFieldVector) {
    var x: f64 = v.x;
    var y: f64 = v.y;
    var z: f64 = v.z;
    _par_got_f(x);
    _par_got_f(y);
    _par_got_f(z);
    return 0;
}

# An error to the got list as the golden rows hold it: the `E:` token, then the record's Display text.
fn _par_got_error(code) {
    _par_got_err(code);
    var d = bj_last_error_display();
    _par_got_text(d, strlen(d));
    return 0;
}

# A Result<FieldVector> (its two halves, and the vector written on Ok) to the got list.
fn _par_got_res_v(t, v, e: BjFieldVector) {
    if (is_err_result(t) == 1) { return _par_got_error(v); }
    return _par_got_fv(e);
}

# A Result<f64> (its two halves) to the got list.
fn _par_got_res_f(t, v) {
    if (is_err_result(t) == 1) { return _par_got_error(v); }
    _par_got_f(v);
    return 0;
}

# Input tokens k, k + 1, k + 2 into the three f64 at p.
fn _par_in3(k, p: *f64) {
    p[0] = _par_in(k);
    p[1] = _par_in(k + 1);
    p[2] = _par_in(k + 2);
    return 0;
}

# The vector of input tokens k … k + 2.
fn _par_in_fv(k): BjFieldVector {
    var x: f64 = _par_in(k);
    var y: f64 = _par_in(k + 1);
    var z: f64 = _par_in(k + 2);
    var v: BjFieldVector = BjFieldVector_new(x, y, z);
    return v;
}

# ADR 0002 row 5 rows compared through their mapping: the port's complex value, conjugated back, against the oracle's
# (exact: a sign flip). Counted per module run and reported after the module.
var _par_map5_greens = 0;

# An image charge result to the got list: Ok(q') then the position written to p, or the error.
fn _par_got_res_image(t, v, p: *f64) {
    if (is_err_result(t) == 1) { return _par_got_error(v); }
    _par_got_f(v);
    var x: f64 = p[0];
    var y: f64 = p[1];
    var z: f64 = p[2];
    _par_got_f(x);
    _par_got_f(y);
    _par_got_f(z);
    return 0;
}

# A complex result written to `c` on Ok (with its Result's two halves t, v) to the got list, or the error.
fn _par_got_res_c(t, v, c: BjComplex) {
    if (is_err_result(t) == 1) { return _par_got_error(v); }
    var re: f64 = c.re;
    var im: f64 = c.im;
    _par_got_f(re);
    _par_got_f(im);
    return 0;
}

# ── trace_field_line's scenarios (M1 part 3c) ──
# The field functions scripts/oracle/src/m_field.rs's field_fn numbers, as plain fns called through callptr, reading
# the row's parameters from _par_tf (the harness is single-threaded).
var _par_tf: f64[8];

# out = (x, y, z); status BJ_ERR_NONE.
fn _par_tf_put(out: *BjFieldVector, x: f64, y: f64, z: f64): i64 {
    out.x = x;
    out.y = y;
    out.z = z;
    return BJ_ERR_NONE;
}

# The status of a field function's Result: BJ_ERR_NONE, or its code.
fn _par_tf_status(t, v): i64 {
    if (is_err_result(t) == 1) { return v; }
    return BJ_ERR_NONE;
}

# 0: uniform (fx, fy, fz).
fn _par_tf_uniform(pos: *f64, out: *BjFieldVector): i64 {
    return _par_tf_put(out, _par_tf[0], _par_tf[1], _par_tf[2]);
}

# 1: a point charge q at (x, y, z).
fn _par_tf_point(pos: *f64, out: *BjFieldVector): i64 {
    var c: f64[3];
    c[0] = _par_tf[1];
    c[1] = _par_tf[2];
    c[2] = _par_tf[3];
    var q: f64 = _par_tf[0];
    var t, v = bj_electric_field_point_charge(q, &c, pos, out);
    return _par_tf_status(t, v);
}

# 2: an electric dipole p at the origin.
fn _par_tf_dipole(pos: *f64, out: *BjFieldVector): i64 {
    var p: BjFieldVector = BjFieldVector_new(_par_tf[0], _par_tf[1], _par_tf[2]);
    var t, v = bj_electric_dipole_field(p, pos, out);
    return _par_tf_status(t, v);
}

# 3: a linear quadrupole, +q at ±d ẑ and −2q at the origin.
fn _par_tf_quadrupole(pos: *f64, out: *BjFieldVector): i64 {
    var cs: f64[12];
    var q: f64 = _par_tf[0];
    var d: f64 = _par_tf[1];
    cs[0] = q;
    cs[1] = 0.0;
    cs[2] = 0.0;
    cs[3] = d;
    cs[4] = q;
    cs[5] = 0.0;
    cs[6] = 0.0;
    cs[7] = -d;
    cs[8] = -2.0 * q;
    cs[9] = 0.0;
    cs[10] = 0.0;
    cs[11] = 0.0;
    var t, v = bj_electric_field_superposition(&cs, 3, pos, out);
    return _par_tf_status(t, v);
}

# 4: a sink, Singularity once x ≥ a, else x̂.
fn _par_tf_sink(pos: *f64, out: *BjFieldVector): i64 {
    var x: f64 = pos[0];
    var a: f64 = _par_tf[0];
    if (x >= a) { return _bj_err_singularity(); }
    return _par_tf_put(out, 1.0, 0.0, 0.0);
}

# 5: always ZeroCharge.
fn _par_tf_error(pos: *f64, out: *BjFieldVector): i64 {
    return _bj_err_zero_charge();
}

# 6: a NaN field once x ≥ a, else x̂.
fn _par_tf_nan(pos: *f64, out: *BjFieldVector): i64 {
    var x: f64 = pos[0];
    var a: f64 = _par_tf[0];
    var zero: f64 = 0.0;
    var nan: f64 = zero / zero;
    if (x >= a) { return _par_tf_put(out, nan, 0.0, 0.0); }
    return _par_tf_put(out, 1.0, 0.0, 0.0);
}

# 7: an infinite field once x ≥ a, else x̂.
fn _par_tf_inf(pos: *f64, out: *BjFieldVector): i64 {
    var x: f64 = pos[0];
    var a: f64 = _par_tf[0];
    var inf: f64 = 1.0 / 0.0;
    if (x >= a) { return _par_tf_put(out, inf, 0.0, 0.0); }
    return _par_tf_put(out, 1.0, 0.0, 0.0);
}

# 8: a magnetic dipole m at the origin.
fn _par_tf_mdipole(pos: *f64, out: *BjFieldVector): i64 {
    var m: BjFieldVector = BjFieldVector_new(_par_tf[0], _par_tf[1], _par_tf[2]);
    var t, v = bj_magnetic_dipole_field(m, pos, out);
    return _par_tf_status(t, v);
}

# A `field::trace_field_line` row: the scenario's field function, the trace, and its points or error.
fn _par_trace(): i64 {
    var a: f64[3];
    var id = _par_in(0);
    _par_in3(1, &a);
    var step: f64 = _par_in(4);
    var max = _par_in(5);
    var np = _par_in_f64s(6, &_par_tf);
    var fp = &_par_tf_uniform;
    if (id == 1) { fp = &_par_tf_point; }
    elif (id == 2) { fp = &_par_tf_dipole; }
    elif (id == 3) { fp = &_par_tf_quadrupole; }
    elif (id == 4) { fp = &_par_tf_sink; }
    elif (id == 5) { fp = &_par_tf_error; }
    elif (id == 6) { fp = &_par_tf_nan; }
    elif (id == 7) { fp = &_par_tf_inf; }
    elif (id == 8) { fp = &_par_tf_mdipole; }
    var poly = BjPolyline_new();
    var t, v = bj_trace_field_line(&a, step, max, fp, &poly);
    if (is_err_result(t) == 1) {
        _par_got_error(v);
    } else {
        var n = poly.count();
        _par_got_seq(3 * n);
        for (var k = 0; k < n; k = k + 1) {
            var p: *f64 = poly.at(k);
            var x: f64 = p[0];
            var y: f64 = p[1];
            var z: f64 = p[2];
            _par_got_f(x);
            _par_got_f(y);
            _par_got_f(z);
        }
    }
    BjPolyline_free(&poly);
    if (np < 0) { return 0 - 1; }
    return 1;
}

# Part 3b's `field::*` rows, by name; −2 for a name that is not one of them.
fn _par_field_3b(fp, fl): i64 {
    var a: f64[3];
    var b: f64[3];
    var tq: f64[9];
    var cs: f64[24];
    var c: BjComplex;
    if (_par_eq(fp, fl, "field::trace_field_line") == 1) { return _par_trace(); }
    if (_par_eq(fp, fl, "field::electric_field_infinite_plane") == 1) {
        var x0: f64 = _par_in(0);
        var e0: f64 = bj_electric_field_infinite_plane(x0);
        _par_got_f(e0);
        return 1;
    }
    if (_par_eq(fp, fl, "field::multipole_moment") == 1) {
        var n4 = _par_in_f64s(2, &cs);
        var t1, v1 = bj_multipole_moment(_par_in(0), _par_in(1), &cs, n4 / 4);
        _par_got_res_f(t1, v1);
        return 1;
    }
    if (_par_eq(fp, fl, "field::spherical_multipole_moment") == 1) {
        var n4b = _par_in_f64s(2, &cs);
        var t2, v2 = bj_spherical_multipole_moment(_par_in(0), _par_in(1), &cs, n4b / 4, &c);
        _par_got_res_c(t2, v2, c);
        return 1;
    }
    if (_par_eq(fp, fl, "field::poynting_flux_surface") == 1) {
        var sm: f64[50];
        var n10 = _par_in_f64s(0, &sm);
        var pf: f64 = bj_poynting_flux_surface(&sm, n10 / 10);
        _par_got_f(pf);
        return 1;
    }
    if (_par_eq(fp, fl, "field::maxwell_stress_tensor") == 1) {
        var e1: BjFieldVector = _par_in_fv(0);
        var b1: BjFieldVector = _par_in_fv(3);
        bj_maxwell_stress_tensor(e1, b1, &tq);
        for (var k = 0; k < 9; k = k + 1) {
            var w: f64 = tq[k];
            _par_got_f(w);
        }
        return 1;
    }
    if (_par_eq(fp, fl, "field::stress_tensor_force") == 1) {
        for (var k2 = 0; k2 < 9; k2 = k2 + 1) { tq[k2] = _par_in(k2); }
        var nv: BjFieldVector = _par_in_fv(9);
        _par_got_fv(bj_stress_tensor_force(&tq, nv));
        return 1;
    }
    if (_par_eq(fp, fl, "field::electric_quadrupole_potential") == 1) {
        for (var k3 = 0; k3 < 9; k3 = k3 + 1) { tq[k3] = _par_in(k3); }
        _par_in3(9, &a);
        var t3, v3 = bj_electric_quadrupole_potential(&tq, &a);
        _par_got_res_f(t3, v3);
        return 1;
    }
    if (_par_eq(fp, fl, "field::greens_function_scalar") == 1) {
        _par_in3(0, &a);
        _par_in3(3, &b);
        var k6: f64 = _par_in(6);
        var t4, v4 = bj_greens_function_scalar(&a, &b, k6, &c);
        if (is_ok(t4) == 1) {
            # ADR 0002 row 5: the port's e^{−jkR} is the oracle's e^{+ikR} conjugated; compare it conjugated back.
            c = c.conj();
            _par_map5_greens = _par_map5_greens + 1;
        }
        _par_got_res_c(t4, v4, c);
        return 1;
    }
    if (_par_eq(fp, fl, "field::greens_function_static") == 1) {
        _par_in3(0, &a);
        _par_in3(3, &b);
        var t5, v5 = bj_greens_function_static(&a, &b);
        _par_got_res_f(t5, v5);
        return 1;
    }
    if (_par_eq(fp, fl, "field::image_charge_plane") == 1) {
        var q1: f64 = _par_in(0);
        _par_in3(1, &a);
        var z1: f64 = _par_in(4);
        var qi: f64 = bj_image_charge_plane(q1, &a, z1, &b);
        _par_got_f(qi);
        var bx: f64 = b[0];
        var by: f64 = b[1];
        var bz: f64 = b[2];
        _par_got_f(bx);
        _par_got_f(by);
        _par_got_f(bz);
        return 1;
    }
    if (_par_eq(fp, fl, "field::image_charge_sphere") == 1) {
        var q2: f64 = _par_in(0);
        _par_in3(1, &a);
        var r2: f64 = _par_in(4);
        var t6, v6 = bj_image_charge_sphere(q2, &a, r2, &b);
        _par_got_res_image(t6, v6, &b);
        return 1;
    }
    if (_par_eq(fp, fl, "field::image_charge_dielectric") == 1) {
        var q3: f64 = _par_in(0);
        _par_in3(1, &a);
        var ea: f64 = _par_in(4);
        var eb: f64 = _par_in(5);
        var t7, v7 = bj_image_charge_dielectric(q3, &a, ea, eb, &b);
        _par_got_res_image(t7, v7, &b);
        return 1;
    }
    if (_par_in_n < 2) { return 0 - 2; }
    var p0: f64 = _par_in(0);
    var p1: f64 = _par_in(1);
    if (_par_eq(fp, fl, "field::electric_field_charged_sphere") == 1) {
        var t8, v8 = bj_electric_field_charged_sphere(p0, p1);
        _par_got_res_f(t8, v8);
        return 1;
    }
    if (_par_eq(fp, fl, "field::electric_field_infinite_line") == 1) {
        var t9, v9 = bj_electric_field_infinite_line(p0, p1);
        _par_got_res_f(t9, v9);
        return 1;
    }
    if (_par_eq(fp, fl, "field::electric_field_outside_cylinder") == 1) {
        var t10, v10 = bj_electric_field_outside_cylinder(p0, p1);
        _par_got_res_f(t10, v10);
        return 1;
    }
    if (_par_eq(fp, fl, "field::electric_field_inside_cylinder") == 1) {
        var t11, v11 = bj_electric_field_inside_cylinder(p0, p1);
        _par_got_res_f(t11, v11);
        return 1;
    }
    if (_par_in_n < 3) { return 0 - 2; }
    var p2: f64 = _par_in(2);
    if (_par_eq(fp, fl, "field::electric_field_inside_sphere") == 1) {
        var t12, v12 = bj_electric_field_inside_sphere(p0, p1, p2);
        _par_got_res_f(t12, v12);
        return 1;
    }
    if (_par_eq(fp, fl, "field::electric_field_ring_axis") == 1) {
        var t13, v13 = bj_electric_field_ring_axis(p0, p1, p2);
        _par_got_res_f(t13, v13);
        return 1;
    }
    if (_par_eq(fp, fl, "field::electric_field_disk_axis") == 1) {
        var t14, v14 = bj_electric_field_disk_axis(p0, p1, p2);
        _par_got_res_f(t14, v14);
        return 1;
    }
    return 0 - 2;
}

# `FieldVector::*` and `field::*` rows: src/field.cyr (M1 parts 3a and 3b).
public fn _par_field(fp, fl): i64 {
    var r3b = _par_field_3b(fp, fl);
    if (r3b != 0 - 2) { return r3b; }
    if (_par_eq(fp, fl, "FieldVector::zero") == 1) { _par_got_fv(BjFieldVector_zero()); return 1; }
    if (_par_eq(fp, fl, "FieldVector::default") == 1) { _par_got_fv(BjFieldVector_default()); return 1; }
    var a: f64[3];
    var b: f64[3];
    var c: f64[3];
    var e: BjFieldVector;
    if (_par_eq(fp, fl, "field::electric_energy_density") == 1) {
        var x0: f64 = _par_in(0);
        var u0: f64 = bj_electric_energy_density(x0);
        _par_got_f(u0);
        return 1;
    }
    if (_par_eq(fp, fl, "field::magnetic_energy_density") == 1) {
        var x1: f64 = _par_in(0);
        var u1: f64 = bj_magnetic_energy_density(x1);
        _par_got_f(u1);
        return 1;
    }
    if (_par_eq(fp, fl, "field::electric_field_superposition") == 1) {
        var cs: f64[24];
        var n4 = _par_in_f64s(0, &cs);
        _par_in3(n4 + 1, &a);
        var ts, vs = bj_electric_field_superposition(&cs, n4 / 4, &a, &e);
        _par_got_res_v(ts, vs, e);
        return 1;
    }
    if (_par_eq(fp, fl, "f64::mul_field_vector") == 1) {
        var s0: f64 = _par_in(0);
        var w0: BjFieldVector = _par_in_fv(1);
        _par_got_fv(BjFieldVector_scale_left(s0, w0));
        return 1;
    }
    var v: BjFieldVector = _par_in_fv(0);
    if (_par_eq(fp, fl, "FieldVector::new") == 1) { _par_got_fv(v); return 1; }
    if (_par_eq(fp, fl, "FieldVector::magnitude") == 1) { var mg: f64 = v.magnitude(); _par_got_f(mg); return 1; }
    if (_par_eq(fp, fl, "FieldVector::magnitude_sq") == 1) {
        var m2: f64 = v.magnitude_sq();
        _par_got_f(m2);
        return 1;
    }
    if (_par_eq(fp, fl, "FieldVector::normalized") == 1) {
        var tn, vn = v.normalized(&e);
        _par_got_res_v(tn, vn, e);
        return 1;
    }
    if (_par_eq(fp, fl, "FieldVector::neg") == 1) { _par_got_fv(BjFieldVector_neg(v)); return 1; }
    if (_par_eq(fp, fl, "FieldVector::fmt") == 1) {
        var buf[1100];
        var tx[24];
        _bj_tx_init(&tx, &buf, 1100);
        v.display(&tx);
        if (_bj_tx_overflowed(&tx) == 1) { return 0 - 1; }
        _par_got_text(_bj_tx_ptr(&tx), _bj_tx_len(&tx));
        return 1;
    }
    if (_par_eq(fp, fl, "FieldVector::from_array") == 1) {
        _par_in3(0, &a);
        _par_got_fv(BjFieldVector_from_array(&a));
        return 1;
    }
    if (_par_eq(fp, fl, "FieldVector::into_array") == 1) {
        v.to_array(&a);
        var a0: f64 = a[0];
        var a1: f64 = a[1];
        var a2: f64 = a[2];
        _par_got_f(a0);
        _par_got_f(a1);
        _par_got_f(a2);
        return 1;
    }
    if (_par_in_n == 4) {
        var x4: f64 = _par_in(3);
        if (_par_eq(fp, fl, "FieldVector::scale") == 1) { _par_got_fv(v.scale(x4)); return 1; }
        if (_par_eq(fp, fl, "FieldVector::mul") == 1) { _par_got_fv(v * x4); return 1; }
        return 0;
    }
    if (_par_in_n == 6) {
        var w: BjFieldVector = _par_in_fv(3);
        if (_par_eq(fp, fl, "FieldVector::dot") == 1) { var d: f64 = v.dot(w); _par_got_f(d); return 1; }
        if (_par_eq(fp, fl, "FieldVector::cross") == 1) { _par_got_fv(v.cross(w)); return 1; }
        if (_par_eq(fp, fl, "FieldVector::add") == 1) { _par_got_fv(v + w); return 1; }
        if (_par_eq(fp, fl, "FieldVector::sub") == 1) { _par_got_fv(v - w); return 1; }
        _par_in3(3, &b);
        if (_par_eq(fp, fl, "field::electric_dipole_field") == 1) {
            var t1, v1 = bj_electric_dipole_field(v, &b, &e);
            _par_got_res_v(t1, v1, e);
            return 1;
        }
        if (_par_eq(fp, fl, "field::electric_dipole_potential") == 1) {
            var t2, v2 = bj_electric_dipole_potential(v, &b);
            _par_got_res_f(t2, v2);
            return 1;
        }
        if (_par_eq(fp, fl, "field::magnetic_dipole_field") == 1) {
            var t3, v3 = bj_magnetic_dipole_field(v, &b, &e);
            _par_got_res_v(t3, v3, e);
            return 1;
        }
        return 0;
    }
    var q: f64 = _par_in(0);
    _par_in3(1, &a);
    if (_par_in_n == 7) {
        _par_in3(4, &b);
        if (_par_eq(fp, fl, "field::electric_field_point_charge") == 1) {
            var t4, v4 = bj_electric_field_point_charge(q, &a, &b, &e);
            _par_got_res_v(t4, v4, e);
            return 1;
        }
        if (_par_eq(fp, fl, "field::electric_potential_point_charge") == 1) {
            var t5, v5 = bj_electric_potential_point_charge(q, &a, &b);
            _par_got_res_f(t5, v5);
            return 1;
        }
        return 0;
    }
    if (_par_in_n == 10 && _par_eq(fp, fl, "field::magnetic_field_moving_charge") == 1) {
        _par_in3(4, &b);
        _par_in3(7, &c);
        var t6, v6 = bj_magnetic_field_moving_charge(q, &a, &b, &c, &e);
        _par_got_res_v(t6, v6, e);
        return 1;
    }
    return 0;
}

# `maxwell::*` rows: src/maxwell.cyr (M1 part 3d). Inputs are f64 tokens; a vector is three.
public fn _par_maxwell(fp, fl): i64 {
    if (_par_eq(fp, fl, "maxwell::gauss_magnetic_divergence") == 1) {
        var g0: f64 = bj_gauss_magnetic_divergence();
        _par_got_f(g0);
        return 1;
    }
    if (_par_eq(fp, fl, "maxwell::free_space_impedance") == 1) {
        var z0: f64 = bj_free_space_impedance();
        _par_got_f(z0);
        return 1;
    }
    if (_par_eq(fp, fl, "maxwell::displacement_current") == 1) {
        var dv: BjFieldVector = _par_in_fv(0);
        _par_got_fv(bj_displacement_current(dv));
        return 1;
    }
    var a: f64 = _par_in(0);
    if (_par_eq(fp, fl, "maxwell::gauss_electric_divergence") == 1) {
        var g1: f64 = bj_gauss_electric_divergence(a);
        _par_got_f(g1);
        return 1;
    }
    var b: f64 = _par_in(1);
    if (_par_eq(fp, fl, "maxwell::wave_speed") == 1) {
        var tw, vw = bj_wave_speed(a, b);
        _par_got_res_f(tw, vw);
        return 1;
    }
    if (_par_eq(fp, fl, "maxwell::refractive_index") == 1) {
        var tr, vr = bj_refractive_index(a, b);
        _par_got_res_f(tr, vr);
        return 1;
    }
    if (_par_eq(fp, fl, "maxwell::impedance") == 1) {
        var ti, vi = bj_impedance(a, b);
        _par_got_res_f(ti, vi);
        return 1;
    }
    if (_par_eq(fp, fl, "maxwell::wavelength") == 1) {
        var tl, vl = bj_wavelength(a, b);
        _par_got_res_f(tl, vl);
        return 1;
    }
    if (_par_eq(fp, fl, "maxwell::frequency") == 1) {
        var tf, vf = bj_frequency(a, b);
        _par_got_res_f(tf, vf);
        return 1;
    }
    if (_par_eq(fp, fl, "maxwell::skin_depth") == 1) {
        var c: f64 = _par_in(2);
        var ts, vs = bj_skin_depth(a, b, c);
        _par_got_res_f(ts, vs);
        return 1;
    }
    return 0;
}

# A BjPointCharge to the got list: charge, mass, the position's three, the velocity's three.
fn _par_got_pc(p: BjPointCharge) {
    var q: f64 = p.charge;
    var m: f64 = p.mass;
    _par_got_f(q);
    _par_got_f(m);
    var x: f64 = p.position.0;
    var y: f64 = p.position.1;
    var z: f64 = p.position.2;
    _par_got_f(x);
    _par_got_f(y);
    _par_got_f(z);
    var vx: f64 = p.velocity.0;
    var vy: f64 = p.velocity.1;
    var vz: f64 = p.velocity.2;
    _par_got_f(vx);
    _par_got_f(vy);
    _par_got_f(vz);
    return 0;
}

# The point charge of input tokens k … k + 7, built field by field (Rust's struct literal; no mass check).
fn _par_in_pc(k): BjPointCharge {
    var p: BjPointCharge;
    var q: f64 = _par_in(k);
    var m: f64 = _par_in(k + 1);
    var x: f64 = _par_in(k + 2);
    var y: f64 = _par_in(k + 3);
    var z: f64 = _par_in(k + 4);
    var vx: f64 = _par_in(k + 5);
    var vy: f64 = _par_in(k + 6);
    var vz: f64 = _par_in(k + 7);
    p.charge = q;
    p.mass = m;
    p.position = (x, y, z);
    p.velocity = (vx, vy, vz);
    return p;
}

# `PointCharge::*` and `charge::*` rows: src/charge.cyr (M1 part 3d). A point charge is eight tokens.
public fn _par_charge(fp, fl): i64 {
    var a: f64[3];
    var b: f64[3];
    var e: BjFieldVector;
    if (_par_eq(fp, fl, "PointCharge::new") == 1) {
        var q0: f64 = _par_in(0);
        var m0: f64 = _par_in(1);
        _par_in3(2, &a);
        _par_in3(5, &b);
        var np: BjPointCharge;
        var tn, vn = BjPointCharge_new(q0, m0, &a, &b, &np);
        if (is_err_result(tn) == 1) {
            _par_got_error(vn);
            return 1;
        }
        _par_got_pc(np);
        return 1;
    }
    if (_par_eq(fp, fl, "PointCharge::electron") == 1) {
        _par_in3(0, &a);
        _par_got_pc(BjPointCharge_electron(&a));
        return 1;
    }
    if (_par_eq(fp, fl, "PointCharge::proton") == 1) {
        _par_in3(0, &a);
        _par_got_pc(BjPointCharge_proton(&a));
        return 1;
    }
    if (_par_eq(fp, fl, "PointCharge::electric_field_at") == 1) {
        var p1: BjPointCharge = _par_in_pc(0);
        _par_in3(8, &a);
        var te, ve = p1.electric_field_at(&a, &e);
        _par_got_res_v(te, ve, e);
        return 1;
    }
    if (_par_eq(fp, fl, "PointCharge::electric_potential_at") == 1) {
        var p2: BjPointCharge = _par_in_pc(0);
        _par_in3(8, &a);
        var tp, vp = p2.electric_potential_at(&a);
        _par_got_res_f(tp, vp);
        return 1;
    }
    if (_par_eq(fp, fl, "PointCharge::magnetic_field_at") == 1) {
        var p3: BjPointCharge = _par_in_pc(0);
        _par_in3(8, &a);
        var tb, vb = p3.magnetic_field_at(&a, &e);
        _par_got_res_v(tb, vb, e);
        return 1;
    }
    if (_par_eq(fp, fl, "PointCharge::lorentz_force_in") == 1) {
        var p4: BjPointCharge = _par_in_pc(0);
        var e4: BjFieldVector = _par_in_fv(8);
        var b4: BjFieldVector = _par_in_fv(11);
        _par_got_fv(p4.lorentz_force_in(e4, b4));
        return 1;
    }
    if (_par_eq(fp, fl, "charge::coulomb_force") == 1) {
        var c1: BjPointCharge = _par_in_pc(0);
        var c2: BjPointCharge = _par_in_pc(8);
        var tc, vc = bj_coulomb_force(c1, c2, &e);
        _par_got_res_v(tc, vc, e);
        return 1;
    }
    if (_par_eq(fp, fl, "charge::lorentz_force") == 1) {
        var q5: f64 = _par_in(0);
        var v5: BjFieldVector = _par_in_fv(1);
        var e5: BjFieldVector = _par_in_fv(4);
        var b5: BjFieldVector = _par_in_fv(7);
        _par_got_fv(bj_lorentz_force(q5, v5, e5, b5));
        return 1;
    }
    var x0: f64 = _par_in(0);
    var x1: f64 = _par_in(1);
    if (_par_eq(fp, fl, "charge::dipole_moment") == 1) {
        var dm: f64 = bj_dipole_moment(x0, x1);
        _par_got_f(dm);
        return 1;
    }
    if (_par_eq(fp, fl, "charge::potential_energy") == 1) {
        var pe: f64 = bj_potential_energy(x0, x1);
        _par_got_f(pe);
        return 1;
    }
    var x2: f64 = _par_in(2);
    if (_par_eq(fp, fl, "charge::coulomb_potential_energy") == 1) {
        var tu, vu = bj_coulomb_potential_energy(x0, x1, x2);
        _par_got_res_f(tu, vu);
        return 1;
    }
    if (_par_eq(fp, fl, "charge::cyclotron_frequency") == 1) {
        var tw, vw = bj_cyclotron_frequency(x0, x1, x2);
        _par_got_res_f(tw, vw);
        return 1;
    }
    if (_par_eq(fp, fl, "charge::larmor_radius") == 1) {
        var x3: f64 = _par_in(3);
        var tl, vl = bj_larmor_radius(x0, x1, x2, x3);
        _par_got_res_f(tl, vl);
        return 1;
    }
    return 0;
}

# `f64::fmt_display`, `f64::fmt_debug`, `serde_json::f64` and `f64::fmt_fixed` rows: src/fmtf.cyr's layouts, into a
# bounded BjText.
fn _par_fmtf(fp, fl): i64 {
    var x: f64 = _par_in(0);
    var buf[400];
    var t[24];
    _bj_tx_init(&t, &buf, 400);
    if (_par_eq(fp, fl, "f64::fmt_display") == 1) {
        _bj_fmt_f64_display(&t, x);
    } elif (_par_eq(fp, fl, "f64::fmt_debug") == 1) {
        _bj_fmt_f64_debug(&t, x);
    } elif (_par_eq(fp, fl, "serde_json::f64") == 1) {
        _bj_fmt_f64_json(&t, x);
    } elif (_par_eq(fp, fl, "f64::fmt_fixed") == 1) {
        _bj_fmt_f64_fixed(&t, x, _par_in(1));
    } else {
        return 0;
    }
    if (_bj_tx_overflowed(&t) == 1) { return 0 - 1; }
    _par_got_text(_bj_tx_ptr(&t), _bj_tx_len(&t));
    return 1;
}

# `json::<Type>::*` rows: src/json.cyr (M1 part 4; M2 part 1a, Material; M3 part 1a-2, polarization's four structs).
# - `to_string`: the port's document, tokenized as the oracle tokenizes serde_json's (scripts/oracle/src/m_json.rs):
#   each number outside strings (a maximal run of `-0123456789.eE+`) an f: token, its correctly rounded parse, and
#   every run between numbers an s: token. Equal tokens are the same text but for each number's notation (D5).
# - `from_str`: the document read, its fields on Ok or E:Deserialize; a row whose document repeats a key (its `i:1`)
#   and that serde_json reads is ADR 0002 row 12's, which the port refuses (_par_accepted).

# The JSON text [p, p + n) to the got list as the oracle's tokens.
fn _par_got_json(p, n) {
    var run = 0;
    var k = 0;
    while (k < n) {
        var c = load8(p + k);
        if (c == 34) {
            k = k + 1;
            while (k < n && load8(p + k) != 34) {
                if (load8(p + k) == 92) { k = k + 2; } else { k = k + 1; }
            }
            if (k < n) { k = k + 1; }
        } elif (c == 45 || (c >= 48 && c <= 57)) {
            if (k > run) { _par_got_text(p + run, k - run); }
            var st = k;
            while (k < n) {
                var d = load8(p + k);
                if ((d >= 48 && d <= 57) || d == 46 || d == 101 || d == 69 || d == 43 || d == 45) { k = k + 1; }
                else { break; }
            }
            _par_got_f(f64_parse_n(p + st, k - st));
            run = k;
        } else {
            k = k + 1;
        }
    }
    if (n > run) { _par_got_text(p + run, n - run); }
    return 0;
}

# The builder's document to the got list as tokens, or the error.
fn _par_got_json_res(t, v, sb) {
    if (is_err_result(t) == 1) { return _par_got_error(v); }
    var js = str_builder_build(sb);
    return _par_got_json(str_data(js), str_len(js));
}

# n f64 words at w to the got list.
fn _par_got_words(w: *f64, n) {
    for (var k = 0; k < n; k = k + 1) {
        var x: f64 = w[k];
        _par_got_f(x);
    }
    return 0;
}

# A BjMaterial from the input tokens k, k + 1, k + 2 (eps_r, mu_r, conductivity).
fn _par_in_mat(k): BjMaterial {
    var e: f64 = _par_in(k);
    var u: f64 = _par_in(k + 1);
    var s: f64 = _par_in(k + 2);
    var m: BjMaterial = BjMaterial_new(e, u, s);
    return m;
}

# A BjMaterial to the got list: its three fields.
fn _par_got_mat(m: BjMaterial) {
    var e: f64 = m.eps_r;
    var u: f64 = m.mu_r;
    var s: f64 = m.conductivity;
    _par_got_f(e);
    _par_got_f(u);
    _par_got_f(s);
    return 0;
}

# A BjMagneticType's golden text.
fn _par_magnetic_name(t): i64 {
    if (t == BJ_MAGNETIC_TYPE_DIAMAGNETIC) { return "MagneticType.Diamagnetic"; }
    if (t == BJ_MAGNETIC_TYPE_FERROMAGNETIC) { return "MagneticType.Ferromagnetic"; }
    return "MagneticType.Paramagnetic";
}

# `material::*` and `Material::*` rows: src/material.cyr (M2 part 1a). Inputs are f64 tokens; a vector is three, a
# material three (eps_r, mu_r, conductivity).
public fn _par_material(fp, fl): i64 {
    if (_par_eq(fp, fl, "Material::vacuum") == 1) {
        _par_got_mat(BjMaterial_vacuum());
        return 1;
    }
    if (_par_eq(fp, fl, "Material::default") == 1) {
        _par_got_mat(BjMaterial_default());
        return 1;
    }
    var a: f64 = _par_in(0);
    if (_par_in_n == 1) {
        if (_par_eq(fp, fl, "material::electric_susceptibility") == 1) {
            var r1: f64 = bj_electric_susceptibility(a);
            _par_got_f(r1);
            return 1;
        }
        if (_par_eq(fp, fl, "material::relative_permittivity") == 1) {
            var r2: f64 = bj_relative_permittivity(a);
            _par_got_f(r2);
            return 1;
        }
        if (_par_eq(fp, fl, "material::absolute_permittivity") == 1) {
            var r3: f64 = bj_absolute_permittivity(a);
            _par_got_f(r3);
            return 1;
        }
        if (_par_eq(fp, fl, "material::magnetic_susceptibility") == 1) {
            var r4: f64 = bj_magnetic_susceptibility(a);
            _par_got_f(r4);
            return 1;
        }
        if (_par_eq(fp, fl, "material::relative_permeability") == 1) {
            var r5: f64 = bj_relative_permeability(a);
            _par_got_f(r5);
            return 1;
        }
        if (_par_eq(fp, fl, "material::absolute_permeability") == 1) {
            var r6: f64 = bj_absolute_permeability(a);
            _par_got_f(r6);
            return 1;
        }
        if (_par_eq(fp, fl, "material::classify_magnetic") == 1) {
            var tc, vc = bj_classify_magnetic(a);
            if (is_err_result(tc) == 1) { _par_got_error(vc); return 1; }
            _par_got_e(_par_magnetic_name(vc));
            return 1;
        }
        if (_par_eq(fp, fl, "Material::dielectric") == 1) {
            _par_got_mat(BjMaterial_dielectric(a));
            return 1;
        }
        if (_par_eq(fp, fl, "Material::conductor") == 1) {
            _par_got_mat(BjMaterial_conductor(a));
            return 1;
        }
        return 0;
    }
    if (_par_in_n == 2) {
        var b: f64 = _par_in(1);
        if (_par_eq(fp, fl, "material::dielectric_energy_density") == 1) {
            var u1: f64 = bj_dielectric_energy_density(a, b);
            _par_got_f(u1);
            return 1;
        }
        if (_par_eq(fp, fl, "material::clausius_mossotti") == 1) {
            var t1, v1 = bj_clausius_mossotti(a, b);
            _par_got_res_f(t1, v1);
            return 1;
        }
        if (_par_eq(fp, fl, "material::magnetic_energy_density_material") == 1) {
            var t2, v2 = bj_magnetic_energy_density_material(a, b);
            _par_got_res_f(t2, v2);
            return 1;
        }
        if (_par_eq(fp, fl, "material::curie_law") == 1) {
            var t3, v3 = bj_curie_law(a, b);
            _par_got_res_f(t3, v3);
            return 1;
        }
        return 0;
    }
    if (_par_in_n == 4) {
        var w: BjFieldVector = _par_in_fv(1);
        if (_par_eq(fp, fl, "material::polarization") == 1) {
            _par_got_fv(bj_polarization(a, w));
            return 1;
        }
        if (_par_eq(fp, fl, "material::displacement_field") == 1) {
            _par_got_fv(bj_displacement_field(a, w));
            return 1;
        }
        if (_par_eq(fp, fl, "material::magnetization") == 1) {
            _par_got_fv(bj_magnetization(a, w));
            return 1;
        }
        if (_par_eq(fp, fl, "material::b_field_from_h") == 1) {
            _par_got_fv(bj_b_field_from_h(a, w));
            return 1;
        }
        if (_par_eq(fp, fl, "material::h_field_from_b") == 1) {
            var h: BjFieldVector;
            var t4, v4 = bj_h_field_from_b(a, w, &h);
            _par_got_res_v(t4, v4, h);
            return 1;
        }
        return 0;
    }
    if (_par_in_n == 6 && _par_eq(fp, fl, "Material::try_reflectance_at") == 0) {
        var p: BjFieldVector = _par_in_fv(0);
        var q: BjFieldVector = _par_in_fv(3);
        if (_par_eq(fp, fl, "material::bound_surface_charge") == 1) {
            var sc: f64 = bj_bound_surface_charge(p, q);
            _par_got_f(sc);
            return 1;
        }
        if (_par_eq(fp, fl, "material::bound_surface_current") == 1) {
            _par_got_fv(bj_bound_surface_current(p, q));
            return 1;
        }
        return 0;
    }
    if (_par_in_n == 6) {
        var m1: BjMaterial = _par_in_mat(0);
        var m2: BjMaterial = _par_in_mat(3);
        var t5, v5 = m1.try_reflectance_at(m2);
        _par_got_res_f(t5, v5);
        return 1;
    }
    var b2: f64 = _par_in(1);
    var c2: f64 = _par_in(2);
    if (_par_eq(fp, fl, "material::curie_weiss") == 1) {
        var t6, v6 = bj_curie_weiss(a, b2, c2);
        _par_got_res_f(t6, v6);
        return 1;
    }
    if (_par_eq(fp, fl, "material::bound_volume_charge") == 1) {
        var bv: f64 = bj_bound_volume_charge(a, b2, c2);
        _par_got_f(bv);
        return 1;
    }
    var m: BjMaterial = _par_in_mat(0);
    if (_par_eq(fp, fl, "Material::new") == 1) {
        _par_got_mat(BjMaterial_new(a, b2, c2));
        return 1;
    }
    if (_par_eq(fp, fl, "Material::refractive_index") == 1) {
        var n1: f64 = m.refractive_index();
        _par_got_f(n1);
        return 1;
    }
    if (_par_eq(fp, fl, "Material::permittivity") == 1) {
        var e1: f64 = m.permittivity();
        _par_got_f(e1);
        return 1;
    }
    if (_par_eq(fp, fl, "Material::permeability") == 1) {
        var u2: f64 = m.permeability();
        _par_got_f(u2);
        return 1;
    }
    if (_par_eq(fp, fl, "Material::impedance") == 1) {
        var t7, v7 = m.impedance();
        _par_got_res_f(t7, v7);
        return 1;
    }
    if (_par_eq(fp, fl, "Material::wave_speed") == 1) {
        var t8, v8 = m.wave_speed();
        _par_got_res_f(t8, v8);
        return 1;
    }
    if (_par_eq(fp, fl, "Material::is_lossy") == 1) {
        _par_got_i(m.is_lossy());
        return 1;
    }
    return 0;
}

# `circuit::*` rows: src/circuit.cyr (M2 part 1c). A combination's slice is `v:n` then its values, up to 512 of them
# (a longer one is left pending rather than read past the buffer).
fn _par_circuit_slice(fp, fl): i64 {
    var xs: f64[512];
    if (_par_in(0) > 512) { return 0; }
    var n = _par_in_f64s(0, &xs);
    if (_par_eq(fp, fl, "circuit::resistance_series") == 1) {
        var t1, v1 = bj_resistance_series(&xs, n);
        _par_got_res_f(t1, v1);
        return 1;
    }
    if (_par_eq(fp, fl, "circuit::resistance_parallel") == 1) {
        var t2, v2 = bj_resistance_parallel(&xs, n);
        _par_got_res_f(t2, v2);
        return 1;
    }
    if (_par_eq(fp, fl, "circuit::capacitance_series") == 1) {
        var t3, v3 = bj_capacitance_series(&xs, n);
        _par_got_res_f(t3, v3);
        return 1;
    }
    if (_par_eq(fp, fl, "circuit::capacitance_parallel") == 1) {
        var t4, v4 = bj_capacitance_parallel(&xs, n);
        _par_got_res_f(t4, v4);
        return 1;
    }
    if (_par_eq(fp, fl, "circuit::inductance_series") == 1) {
        var t5, v5 = bj_inductance_series(&xs, n);
        _par_got_res_f(t5, v5);
        return 1;
    }
    if (_par_eq(fp, fl, "circuit::inductance_parallel") == 1) {
        var t6, v6 = bj_inductance_parallel(&xs, n);
        _par_got_res_f(t6, v6);
        return 1;
    }
    return 0;
}

# The two-argument circuit rows.
fn _par_circuit2(fp, fl): i64 {
    var a: f64 = _par_in(0);
    var b: f64 = _par_in(1);
    if (_par_eq(fp, fl, "circuit::voltage") == 1) {
        var r1: f64 = bj_voltage(a, b);
        _par_got_f(r1);
        return 1;
    }
    if (_par_eq(fp, fl, "circuit::power") == 1) {
        var r2: f64 = bj_power(a, b);
        _par_got_f(r2);
        return 1;
    }
    if (_par_eq(fp, fl, "circuit::capacitor_energy") == 1) {
        var r3: f64 = bj_capacitor_energy(a, b);
        _par_got_f(r3);
        return 1;
    }
    if (_par_eq(fp, fl, "circuit::capacitor_charge") == 1) {
        var r4: f64 = bj_capacitor_charge(a, b);
        _par_got_f(r4);
        return 1;
    }
    if (_par_eq(fp, fl, "circuit::inductor_energy") == 1) {
        var r5: f64 = bj_inductor_energy(a, b);
        _par_got_f(r5);
        return 1;
    }
    if (_par_eq(fp, fl, "circuit::rc_time_constant") == 1) {
        var r6: f64 = bj_rc_time_constant(a, b);
        _par_got_f(r6);
        return 1;
    }
    if (_par_eq(fp, fl, "circuit::current") == 1) {
        var t1, v1 = bj_current(a, b);
        _par_got_res_f(t1, v1);
        return 1;
    }
    if (_par_eq(fp, fl, "circuit::resistance") == 1) {
        var t2, v2 = bj_resistance(a, b);
        _par_got_res_f(t2, v2);
        return 1;
    }
    if (_par_eq(fp, fl, "circuit::rl_time_constant") == 1) {
        var t3, v3 = bj_rl_time_constant(a, b);
        _par_got_res_f(t3, v3);
        return 1;
    }
    if (_par_eq(fp, fl, "circuit::resonant_frequency") == 1) {
        var t4, v4 = bj_resonant_frequency(a, b);
        _par_got_res_f(t4, v4);
        return 1;
    }
    if (_par_eq(fp, fl, "circuit::resonant_angular_frequency") == 1) {
        var t5, v5 = bj_resonant_angular_frequency(a, b);
        _par_got_res_f(t5, v5);
        return 1;
    }
    return 0;
}

# A `circuit::*` row: a slice, then by arity: pairs, the triples (geometry, the plate, Q, ζ), the quadruples (the
# solenoid, the impedance and the four transients).
public fn _par_circuit(fp, fl): i64 {
    if (_par_in_n >= 1 && load64(_par_in_k) == 118) { return _par_circuit_slice(fp, fl); }
    if (_par_in_n == 2) { return _par_circuit2(fp, fl); }
    var a: f64 = _par_in(0);
    var b: f64 = _par_in(1);
    var c: f64 = _par_in(2);
    if (_par_in_n == 3) {
        if (_par_eq(fp, fl, "circuit::resistance_from_geometry") == 1) {
            var t1, v1 = bj_resistance_from_geometry(a, b, c);
            _par_got_res_f(t1, v1);
            return 1;
        }
        if (_par_eq(fp, fl, "circuit::parallel_plate_capacitance") == 1) {
            var t2, v2 = bj_parallel_plate_capacitance(a, b, c);
            _par_got_res_f(t2, v2);
            return 1;
        }
        if (_par_eq(fp, fl, "circuit::quality_factor") == 1) {
            var t3, v3 = bj_quality_factor(a, b, c);
            _par_got_res_f(t3, v3);
            return 1;
        }
        if (_par_eq(fp, fl, "circuit::damping_ratio") == 1) {
            var t4, v4 = bj_damping_ratio(a, b, c);
            _par_got_res_f(t4, v4);
            return 1;
        }
        return 0;
    }
    if (_par_in_n != 4) { return 0; }
    var d: f64 = _par_in(3);
    if (_par_eq(fp, fl, "circuit::solenoid_inductance") == 1) {
        var r1: f64 = bj_solenoid_inductance(a, b, c, d);
        _par_got_f(r1);
        return 1;
    }
    if (_par_eq(fp, fl, "circuit::rc_charging_voltage") == 1) {
        var r2: f64 = bj_rc_charging_voltage(a, b, c, d);
        _par_got_f(r2);
        return 1;
    }
    if (_par_eq(fp, fl, "circuit::rc_discharging_voltage") == 1) {
        var r3: f64 = bj_rc_discharging_voltage(a, b, c, d);
        _par_got_f(r3);
        return 1;
    }
    if (_par_eq(fp, fl, "circuit::rl_current_rise") == 1) {
        var t5, v5 = bj_rl_current_rise(a, b, c, d);
        _par_got_res_f(t5, v5);
        return 1;
    }
    if (_par_eq(fp, fl, "circuit::rl_current_decay") == 1) {
        var t6, v6 = bj_rl_current_decay(a, b, c, d);
        _par_got_res_f(t6, v6);
        return 1;
    }
    if (_par_eq(fp, fl, "circuit::rlc_impedance") == 1) {
        var t7, v7 = bj_rlc_impedance(a, b, c, d);
        _par_got_res_f(t7, v7);
        return 1;
    }
    return 0;
}

# `relativity::*`, `EmTensor::*` and `FourVector::*` rows: src/relativity.cyr (M2 part 1d-1). A tensor is its sixteen
# components row-major, a four-vector (ct, x, y, z). An address as a *f64.
fn _par_rel_f64p(p): *f64 {
    return p;
}

# A BjEmTensor to the got list: its sixteen components, row-major.
fn _par_got_tensor(m: BjEmTensor) {
    var t: BjEmTensor = m;
    var p: *f64 = _par_rel_f64p(&t);
    for (var k = 0; k < 16; k = k + 1) { _par_got_f(p[k]); }
    return 0;
}

fn _par_got_fv4(v: BjFourVector) {
    var t: f64 = v.t;
    var x: f64 = v.x;
    var y: f64 = v.y;
    var z: f64 = v.z;
    _par_got_f(t);
    _par_got_f(x);
    _par_got_f(y);
    _par_got_f(z);
    return 0;
}

fn _par_in_fv4(k): BjFourVector {
    var t: f64 = _par_in(k);
    var x: f64 = _par_in(k + 1);
    var y: f64 = _par_in(k + 2);
    var z: f64 = _par_in(k + 3);
    var v: BjFourVector = BjFourVector_new(t, x, y, z);
    return v;
}

fn _par_in_tensor(k): BjEmTensor {
    var c: f64[16];
    for (var j = 0; j < 16; j = j + 1) { c[j] = _par_in(k + j); }
    var m: BjEmTensor = BjEmTensor_from_components(&c);
    return m;
}

# The EmTensor rows.
fn _par_tensor(fp, fl): i64 {
    if (_par_eq(fp, fl, "EmTensor::from_fields") == 1) {
        _par_got_tensor(BjEmTensor_from_fields(_par_in_fv(0), _par_in_fv(3)));
        return 1;
    }
    var m: BjEmTensor = _par_in_tensor(0);
    if (_par_eq(fp, fl, "EmTensor::electric_field") == 1) {
        _par_got_fv(m.electric_field());
        return 1;
    }
    if (_par_eq(fp, fl, "EmTensor::magnetic_field") == 1) {
        _par_got_fv(m.magnetic_field());
        return 1;
    }
    if (_par_eq(fp, fl, "EmTensor::first_invariant") == 1) {
        var i1: f64 = m.first_invariant();
        _par_got_f(i1);
        return 1;
    }
    if (_par_eq(fp, fl, "EmTensor::second_invariant") == 1) {
        var i2: f64 = m.second_invariant();
        _par_got_f(i2);
        return 1;
    }
    if (_par_eq(fp, fl, "EmTensor::dual") == 1) {
        _par_got_tensor(m.dual());
        return 1;
    }
    if (_par_eq(fp, fl, "EmTensor::four_force") == 1) {
        var q: f64 = _par_in(16);
        _par_got_fv4(m.four_force(q, _par_in_fv4(17)));
        return 1;
    }
    return 0;
}

# The FourVector rows.
fn _par_four_vector(fp, fl): i64 {
    var a: BjFourVector = _par_in_fv4(0);
    if (_par_eq(fp, fl, "FourVector::new") == 1) {
        _par_got_fv4(a);
        return 1;
    }
    if (_par_eq(fp, fl, "FourVector::from_time_position") == 1) {
        var pos: f64[3];
        pos[0] = _par_in(1);
        pos[1] = _par_in(2);
        pos[2] = _par_in(3);
        var tm: f64 = _par_in(0);
        _par_got_fv4(BjFourVector_from_time_position(tm, &pos));
        return 1;
    }
    if (_par_eq(fp, fl, "FourVector::interval_sq") == 1) {
        var s: f64 = a.interval_sq();
        _par_got_f(s);
        return 1;
    }
    if (_par_eq(fp, fl, "FourVector::spatial_magnitude") == 1) {
        var r: f64 = a.spatial_magnitude();
        _par_got_f(r);
        return 1;
    }
    if (_par_eq(fp, fl, "FourVector::dot") == 1) {
        var d: f64 = a.dot(_par_in_fv4(4));
        _par_got_f(d);
        return 1;
    }
    if (_par_eq(fp, fl, "FourVector::boost_x") == 1) {
        var out: BjFourVector;
        var u: f64 = _par_in(4);
        var tb, vb = a.boost_x(u, &out);
        if (is_err_result(tb) == 1) { return _par_got_error(vb) + 1; }
        _par_got_fv4(out);
        return 1;
    }
    return 0;
}

# The solver's trajectories (m_relativity.rs's `trajectory`, by number), as closures over the row's parameters at pp:
# they write position, velocity and acceleration (nine f64) at out.
fn _par_traj(id, pp): i64 {
    return |t, out| {
        var tt: f64 = t;
        var p: *f64 = _par_rel_f64p(pp);
        var o: *f64 = _par_rel_f64p(out);
        for (var k = 0; k < 9; k = k + 1) { o[k] = 0.0; }
        if (id == 1) {
            var dt: f64 = tt - p[6];
            o[0] = p[0] + p[3] * dt;
            o[1] = p[1] + p[4] * dt;
            o[2] = p[2] + p[5] * dt;
            o[3] = p[3];
            o[4] = p[4];
            o[5] = p[5];
        } elif (id == 2) {
            var r: f64 = p[0];
            var w: f64 = p[1];
            var wt: f64 = w * tt;
            var s: f64 = _bj_sin(wt);
            var c: f64 = _bj_cos(wt);
            var nr: f64 = -r;
            var a2: f64 = r * w * w;
            var na2: f64 = -a2;
            o[0] = r * c;
            o[1] = r * s;
            o[3] = nr * w * s;
            o[4] = r * w * c;
            o[6] = na2 * c;
            o[7] = na2 * s;
        } elif (id == 3) {
            var a: f64 = p[0];
            var at: f64 = a * tt;
            var u: f64 = at / BJ_SPEED_OF_LIGHT;
            var q: f64 = 1.0 + u * u;
            var g: f64 = f64_sqrt(q);
            var cc: f64 = BJ_SPEED_OF_LIGHT * BJ_SPEED_OF_LIGHT;
            var ca: f64 = cc / a;
            var gm: f64 = g - 1.0;
            o[0] = ca * gm;
            o[3] = at / g;
            var g3: f64 = g * g * g;
            o[6] = a / g3;
        } elif (id == 4) {
            var amp: f64 = p[0];
            var w4: f64 = p[1];
            var wt4: f64 = w4 * tt;
            var s4: f64 = _bj_sin(wt4);
            var c4: f64 = _bj_cos(wt4);
            var aw: f64 = amp * w4;
            var aww: f64 = aw * w4;
            var naww: f64 = -aww;
            o[2] = amp * s4;
            o[5] = aw * c4;
            o[8] = naww * s4;
        } else {
            o[0] = p[0];
            o[1] = p[1];
            o[2] = p[2];
            if (id == 5) {
                o[6] = p[3];
                o[7] = p[4];
                o[8] = p[5];
            }
        }
        return 0;
    };
}

# The solver's and the fields' rows: the trajectory from its number and parameters (`v:k` at token 6).
fn _par_solver(fp, fl): i64 {
    var ps: f64[8];
    var k = _par_in(6);
    for (var j = 0; j < k; j = j + 1) { ps[j] = _par_in(7 + j); }
    var obs: f64[3];
    if (_par_eq(fp, fl, "relativity::solve_retarded_time") == 1) {
        var f = _par_traj(_par_in(0), &ps);
        obs[0] = _par_in(1);
        obs[1] = _par_in(2);
        obs[2] = _par_in(3);
        var t: f64 = _par_in(4);
        var ts, vs = bj_solve_retarded_time(&obs, t, f, _par_in(5));
        _par_got_res_f(ts, vs);
        return 1;
    }
    var g = _par_traj(_par_in(1), &ps);
    obs[0] = _par_in(2);
    obs[1] = _par_in(3);
    obs[2] = _par_in(4);
    var q: f64 = _par_in(0);
    var t2: f64 = _par_in(5);
    var ev: BjFieldVector;
    var bv: BjFieldVector;
    var tf, vf = bj_lienard_wiechert_fields(q, &obs, t2, g, &ev, &bv);
    if (is_err_result(tf) == 1) { return _par_got_error(vf) + 1; }
    _par_got_fv(ev);
    _par_got_fv(bv);
    return 1;
}

# A `relativity::*` row by its function.
public fn _par_relativity(fp, fl): i64 {
    if (_par_eq(fp, fl, "relativity::solve_retarded_time") == 1) { return _par_solver(fp, fl); }
    if (_par_eq(fp, fl, "relativity::lienard_wiechert_fields") == 1) { return _par_solver(fp, fl); }
    if (memeq(fp, "EmTensor::", 10) == 1) { return _par_tensor(fp, fl); }
    if (memeq(fp, "FourVector::", 12) == 1) { return _par_four_vector(fp, fl); }
    var a: f64 = _par_in(0);
    var ev: BjFieldVector;
    var bv: BjFieldVector;
    if (_par_eq(fp, fl, "relativity::lorentz_factor") == 1) {
        var t1, v1 = bj_lorentz_factor(a);
        _par_got_res_f(t1, v1);
        return 1;
    }
    if (_par_eq(fp, fl, "relativity::beta") == 1) {
        var r1: f64 = bj_beta(a);
        _par_got_f(r1);
        return 1;
    }
    if (_par_eq(fp, fl, "relativity::lorentz_transform_fields") == 1) {
        var t2, v2 = bj_lorentz_transform_fields(_par_in_fv(0), _par_in_fv(3), _par_in_fv(6), &ev, &bv);
        if (is_err_result(t2) == 1) { return _par_got_error(v2) + 1; }
        _par_got_fv(ev);
        _par_got_fv(bv);
        return 1;
    }
    if (_par_eq(fp, fl, "relativity::lorentz_transform_x") == 1) {
        var sx: f64 = _par_in(6);
        var t3, v3 = bj_lorentz_transform_x(_par_in_fv(0), _par_in_fv(3), sx, &ev, &bv);
        if (is_err_result(t3) == 1) { return _par_got_error(v3) + 1; }
        _par_got_fv(ev);
        _par_got_fv(bv);
        return 1;
    }
    if (_par_eq(fp, fl, "relativity::retarded_scalar_potential") == 1) {
        var d4: f64 = _par_in(1);
        var t4, v4 = bj_retarded_scalar_potential(a, d4);
        _par_got_res_f(t4, v4);
        return 1;
    }
    if (_par_eq(fp, fl, "relativity::retarded_vector_potential") == 1) {
        var d5: f64 = _par_in(4);
        var t5, v5 = bj_retarded_vector_potential(a, _par_in_fv(1), d5, &ev);
        _par_got_res_v(t5, v5, ev);
        return 1;
    }
    if (_par_eq(fp, fl, "relativity::lienard_wiechert_scalar_potential") == 1) {
        var t6, v6 = bj_lienard_wiechert_scalar_potential(a, _par_in_fv(1), _par_in_fv(4));
        _par_got_res_f(t6, v6);
        return 1;
    }
    if (_par_eq(fp, fl, "relativity::lienard_wiechert_vector_potential") == 1) {
        var t7, v7 = bj_lienard_wiechert_vector_potential(a, _par_in_fv(1), _par_in_fv(4), &ev);
        _par_got_res_v(t7, v7, ev);
        return 1;
    }
    if (_par_eq(fp, fl, "relativity::lienard_wiechert_e") == 1) {
        var t8, v8 = bj_lienard_wiechert_e(a, _par_in_fv(1), _par_in_fv(4), _par_in_fv(7), &ev);
        _par_got_res_v(t8, v8, ev);
        return 1;
    }
    if (_par_eq(fp, fl, "relativity::lienard_wiechert_b") == 1) {
        _par_got_fv(bj_lienard_wiechert_b(_par_in_fv(0), _par_in_fv(3)));
        return 1;
    }
    if (_par_eq(fp, fl, "relativity::larmor_power") == 1) {
        var ac: f64 = _par_in(1);
        var r2: f64 = bj_larmor_power(a, ac);
        _par_got_f(r2);
        return 1;
    }
    if (_par_eq(fp, fl, "relativity::relativistic_larmor_power") == 1) {
        var t9, v9 = bj_relativistic_larmor_power(a, _par_in_fv(1), _par_in_fv(4));
        _par_got_res_f(t9, v9);
        return 1;
    }
    return 0;
}

# `wave::*` rows: src/wave.cyr (M2 part 1b). A `Result<Option<f64>>` is the error, `n:` for Ok(None), or the value.
fn _par_got_res_o(t, v, x: f64) {
    if (is_err_result(t) == 1) { return _par_got_error(v); }
    if (v == None) { return _par_got_none(); }
    _par_got_f(x);
    return 0;
}

# The one-argument and argument-free wave rows.
fn _par_wave1(fp, fl): i64 {
    if (_par_eq(fp, fl, "wave::hertzian_dipole_directivity") == 1) {
        var d1: f64 = bj_hertzian_dipole_directivity();
        _par_got_f(d1);
        return 1;
    }
    if (_par_eq(fp, fl, "wave::half_wave_dipole_directivity") == 1) {
        var d2: f64 = bj_half_wave_dipole_directivity();
        _par_got_f(d2);
        return 1;
    }
    if (_par_eq(fp, fl, "wave::half_wave_dipole_radiation_resistance") == 1) {
        var d3: f64 = bj_half_wave_dipole_radiation_resistance();
        _par_got_f(d3);
        return 1;
    }
    var a: f64 = _par_in(0);
    if (_par_eq(fp, fl, "wave::plane_wave_intensity") == 1) {
        var r1: f64 = bj_plane_wave_intensity(a);
        _par_got_f(r1);
        return 1;
    }
    if (_par_eq(fp, fl, "wave::radiation_pressure_absorbed") == 1) {
        var r2: f64 = bj_radiation_pressure_absorbed(a);
        _par_got_f(r2);
        return 1;
    }
    if (_par_eq(fp, fl, "wave::radiation_pressure_reflected") == 1) {
        var r3: f64 = bj_radiation_pressure_reflected(a);
        _par_got_f(r3);
        return 1;
    }
    if (_par_eq(fp, fl, "wave::e_from_b") == 1) {
        var r4: f64 = bj_e_from_b(a);
        _par_got_f(r4);
        return 1;
    }
    if (_par_eq(fp, fl, "wave::b_from_e") == 1) {
        var r5: f64 = bj_b_from_e(a);
        _par_got_f(r5);
        return 1;
    }
    if (_par_eq(fp, fl, "wave::angular_frequency") == 1) {
        var r6: f64 = bj_angular_frequency(a);
        _par_got_f(r6);
        return 1;
    }
    if (_par_eq(fp, fl, "wave::hertzian_dipole_pattern") == 1) {
        var r7: f64 = bj_hertzian_dipole_pattern(a);
        _par_got_f(r7);
        return 1;
    }
    if (_par_eq(fp, fl, "wave::half_wave_dipole_pattern") == 1) {
        var r8: f64 = bj_half_wave_dipole_pattern(a);
        _par_got_f(r8);
        return 1;
    }
    return 0;
}

# The two-argument wave rows.
fn _par_wave2(fp, fl): i64 {
    var a: f64 = _par_in(0);
    var b: f64 = _par_in(1);
    var o: f64[1];
    if (_par_eq(fp, fl, "wave::wave_number") == 1) {
        var t1, v1 = bj_wave_number(a, b);
        _par_got_res_f(t1, v1);
        return 1;
    }
    if (_par_eq(fp, fl, "wave::critical_angle") == 1) {
        var t2, v2 = bj_critical_angle(a, b, &o);
        _par_got_res_o(t2, v2, o[0]);
        return 1;
    }
    if (_par_eq(fp, fl, "wave::brewster_angle") == 1) {
        var t3, v3 = bj_brewster_angle(a, b);
        _par_got_res_f(t3, v3);
        return 1;
    }
    if (_par_eq(fp, fl, "wave::reflectance_normal") == 1) {
        var t4, v4 = bj_reflectance_normal(a, b);
        _par_got_res_f(t4, v4);
        return 1;
    }
    if (_par_eq(fp, fl, "wave::transmittance_normal") == 1) {
        var t5, v5 = bj_transmittance_normal(a, b);
        _par_got_res_f(t5, v5);
        return 1;
    }
    if (_par_eq(fp, fl, "wave::hertzian_dipole_radiation_resistance") == 1) {
        var t6, v6 = bj_hertzian_dipole_radiation_resistance(a, b);
        _par_got_res_f(t6, v6);
        return 1;
    }
    if (_par_eq(fp, fl, "wave::effective_aperture") == 1) {
        var t7, v7 = bj_effective_aperture(a, b);
        _par_got_res_f(t7, v7);
        return 1;
    }
    if (_par_eq(fp, fl, "wave::guide_wavelength") == 1) {
        var t8, v8 = bj_guide_wavelength(a, b);
        _par_got_res_f(t8, v8);
        return 1;
    }
    return 0;
}

# The trig-free family's rows, (n₁, n₂, cos θ_i).
fn _par_wave_direct(fp, fl): i64 {
    var n1: f64 = _par_in(0);
    var n2: f64 = _par_in(1);
    var c: f64 = _par_in(2);
    var o: f64[1];
    if (_par_eq(fp, fl, "wave::snell_cos_theta_t") == 1) {
        var t1, v1 = bj_snell_cos_theta_t(n1, n2, c, &o);
        _par_got_res_o(t1, v1, o[0]);
        return 1;
    }
    if (_par_eq(fp, fl, "wave::fresnel_rs_direct") == 1) {
        var t2, v2 = bj_fresnel_rs_direct(n1, n2, c, &o);
        _par_got_res_o(t2, v2, o[0]);
        return 1;
    }
    if (_par_eq(fp, fl, "wave::fresnel_rp_direct") == 1) {
        var t3, v3 = bj_fresnel_rp_direct(n1, n2, c, &o);
        _par_got_res_o(t3, v3, o[0]);
        return 1;
    }
    if (_par_eq(fp, fl, "wave::reflectance_s_direct") == 1) {
        var t4, v4 = bj_reflectance_s_direct(n1, n2, c);
        _par_got_res_f(t4, v4);
        return 1;
    }
    if (_par_eq(fp, fl, "wave::reflectance_p_direct") == 1) {
        var t5, v5 = bj_reflectance_p_direct(n1, n2, c);
        _par_got_res_f(t5, v5);
        return 1;
    }
    if (_par_eq(fp, fl, "wave::reflectance_unpolarized") == 1) {
        var t6, v6 = bj_reflectance_unpolarized(n1, n2, c);
        _par_got_res_f(t6, v6);
        return 1;
    }
    if (_par_eq(fp, fl, "wave::transmittance_unpolarized") == 1) {
        var t7, v7 = bj_transmittance_unpolarized(n1, n2, c);
        _par_got_res_f(t7, v7);
        return 1;
    }
    if (_par_eq(fp, fl, "wave::schlick_reflectance") == 1) {
        var t8, v8 = bj_schlick_reflectance(n1, n2, c);
        _par_got_res_f(t8, v8);
        return 1;
    }
    if (_par_eq(fp, fl, "wave::snell_refraction_angle") == 1) {
        var t9, v9 = bj_snell_refraction_angle(n1, n2, c, &o);
        _par_got_res_o(t9, v9, o[0]);
        return 1;
    }
    if (_par_eq(fp, fl, "wave::cylindrical_waveguide_cutoff") == 1) {
        var ta, va = bj_cylindrical_waveguide_cutoff(n1, n2, c);
        _par_got_res_f(ta, va);
        return 1;
    }
    return 0;
}

# A `wave::*` row by its arity: 0 or 1 inputs, 2, the (n₁, n₂, cos θ_i) triples and the circular waveguide, the
# angle-form Fresnel quadruples, Friis and the waveguide wavelength, the waveguide cutoff, then the vector, plane-wave
# and material pairs, and the material interface.
public fn _par_wave(fp, fl): i64 {
    if (_par_in_n <= 1) { return _par_wave1(fp, fl); }
    if (_par_in_n == 2) { return _par_wave2(fp, fl); }
    if (_par_in_n == 3) { return _par_wave_direct(fp, fl); }
    if (_par_in_n == 4) {
        var a: f64 = _par_in(0);
        var b: f64 = _par_in(1);
        var c: f64 = _par_in(2);
        var d: f64 = _par_in(3);
        if (_par_eq(fp, fl, "wave::fresnel_rs") == 1) {
            var t1, v1 = bj_fresnel_rs(a, b, c, d);
            _par_got_res_f(t1, v1);
            return 1;
        }
        if (_par_eq(fp, fl, "wave::fresnel_rp") == 1) {
            var t2, v2 = bj_fresnel_rp(a, b, c, d);
            _par_got_res_f(t2, v2);
            return 1;
        }
        if (_par_eq(fp, fl, "wave::reflectance_s") == 1) {
            var t3, v3 = bj_reflectance_s(a, b, c, d);
            _par_got_res_f(t3, v3);
            return 1;
        }
        if (_par_eq(fp, fl, "wave::reflectance_p") == 1) {
            var t4, v4 = bj_reflectance_p(a, b, c, d);
            _par_got_res_f(t4, v4);
            return 1;
        }
        if (_par_eq(fp, fl, "wave::friis_transmission") == 1) {
            var t5, v5 = bj_friis_transmission(a, b, c, d);
            _par_got_res_f(t5, v5);
            return 1;
        }
        if (_par_eq(fp, fl, "wave::rectangular_waveguide_cutoff_wavelength") == 1) {
            var t6, v6 = bj_rectangular_waveguide_cutoff_wavelength(a, b, _par_in(2), _par_in(3));
            _par_got_res_f(t6, v6);
            return 1;
        }
        return 0;
    }
    if (_par_in_n == 5) {
        if (_par_eq(fp, fl, "wave::rectangular_waveguide_cutoff") == 1) {
            var a5: f64 = _par_in(0);
            var b5: f64 = _par_in(1);
            var v5: f64 = _par_in(4);
            var t7, w7 = bj_rectangular_waveguide_cutoff(a5, b5, _par_in(2), _par_in(3), v5);
            _par_got_res_f(t7, w7);
            return 1;
        }
        return 0;
    }
    if (_par_in_n == 6) {
        if (_par_eq(fp, fl, "wave::poynting_vector") == 1) {
            _par_got_fv(bj_poynting_vector(_par_in_fv(0), _par_in_fv(3)));
            return 1;
        }
        if (_par_eq(fp, fl, "wave::momentum_density") == 1) {
            _par_got_fv(bj_momentum_density(_par_in_fv(0), _par_in_fv(3)));
            return 1;
        }
        if (_par_eq(fp, fl, "wave::plane_wave_e") == 1) {
            var e0: f64 = _par_in(0);
            var k: f64 = _par_in(1);
            var x: f64 = _par_in(2);
            var w: f64 = _par_in(3);
            var tt: f64 = _par_in(4);
            var ph: f64 = _par_in(5);
            var e: f64 = bj_plane_wave_e(e0, k, x, w, tt, ph);
            _par_got_f(e);
            return 1;
        }
        var m1: BjMaterial = _par_in_mat(0);
        var m2: BjMaterial = _par_in_mat(3);
        if (_par_eq(fp, fl, "wave::reflectance_normal_materials") == 1) {
            var t8, v8 = bj_reflectance_normal_materials(m1, m2);
            _par_got_res_f(t8, v8);
            return 1;
        }
        if (_par_eq(fp, fl, "wave::material_reflection_coefficient") == 1) {
            var t9, v9 = bj_material_reflection_coefficient(m1, m2);
            _par_got_res_f(t9, v9);
            return 1;
        }
        return 0;
    }
    if (_par_in_n == 7 && _par_eq(fp, fl, "wave::reflectance_at_interface") == 1) {
        var c7: f64 = _par_in(6);
        var t0, v0 = bj_reflectance_at_interface(_par_in_mat(0), _par_in_mat(3), c7);
        _par_got_res_f(t0, v0);
        return 1;
    }
    return 0;
}

# `json::<Type>::to_string` / `from_str` rows (the module's rules above): the port's document as tokens, or its reading.
public fn _par_json(fp, fl): i64 {
    if (_par_eq(fp, fl, "json::Complex::to_string") == 1) {
        var cr: f64 = _par_in(0);
        var ci: f64 = _par_in(1);
        var c: BjComplex = BjComplex_new(cr, ci);
        var sb = str_builder_new();
        var t, v = BjComplex_to_json(&c, sb);
        _par_got_json_res(t, v, sb);
        return 1;
    }
    if (_par_eq(fp, fl, "json::FieldVector::to_string") == 1) {
        var fx: f64 = _par_in(0);
        var fy: f64 = _par_in(1);
        var fz: f64 = _par_in(2);
        var fv: BjFieldVector = BjFieldVector_new(fx, fy, fz);
        var sb2 = str_builder_new();
        var t2, v2 = BjFieldVector_to_json(&fv, sb2);
        _par_got_json_res(t2, v2, sb2);
        return 1;
    }
    if (_par_eq(fp, fl, "json::PointCharge::to_string") == 1) {
        var pc: BjPointCharge = _par_in_pc(0);
        var sb3 = str_builder_new();
        var t3, v3 = BjPointCharge_to_json(&pc, sb3);
        _par_got_json_res(t3, v3, sb3);
        return 1;
    }
    if (_par_eq(fp, fl, "json::Material::to_string") == 1) {
        var mt: BjMaterial = _par_in_mat(0);
        var sb4 = str_builder_new();
        var t7, v7 = BjMaterial_to_json(&mt, sb4);
        _par_got_json_res(t7, v7, sb4);
        return 1;
    }
    # polarization's four structs (M3 part 1a-2): the fields as stored, compared directly (ADR 0002 row 5 changes no
    # field's meaning in a document).
    if (_par_eq(fp, fl, "json::JonesVector::to_string") == 1) {
        var jv: BjJonesVector = _par_in_jv(0);
        var sb5 = str_builder_new();
        var t9, v9 = BjJonesVector_to_json(&jv, sb5);
        _par_got_json_res(t9, v9, sb5);
        return 1;
    }
    if (_par_eq(fp, fl, "json::JonesMatrix::to_string") == 1) {
        var jm: BjJonesMatrix = _par_in_jm(0);
        var sb6 = str_builder_new();
        var t10, v10 = BjJonesMatrix_to_json(&jm, sb6);
        _par_got_json_res(t10, v10, sb6);
        return 1;
    }
    if (_par_eq(fp, fl, "json::StokesVector::to_string") == 1) {
        var sv: BjStokesVector = _par_in_sv(0);
        var sb7 = str_builder_new();
        var t11, v11 = BjStokesVector_to_json(&sv, sb7);
        _par_got_json_res(t11, v11, sb7);
        return 1;
    }
    if (_par_eq(fp, fl, "json::MuellerMatrix::to_string") == 1) {
        var mm: BjMuellerMatrix = _par_in_mm(0);
        var sb8 = str_builder_new();
        var t12, v12 = BjMuellerMatrix_to_json(&mm, sb8);
        _par_got_json_res(t12, v12, sb8);
        return 1;
    }
    var lenw[8];
    var doc = _par_in_bytes(0, &lenw);
    if (doc == 0) { return 0 - 1; }
    var len = load64(&lenw);
    if (_par_eq(fp, fl, "json::Complex::from_str") == 1) {
        var rc: BjComplex;
        var t4, v4 = BjComplex_from_json(doc, len, &rc);
        if (is_err_result(t4) == 1) { _par_got_err(v4); return 1; }
        var re: f64 = rc.re;
        var im: f64 = rc.im;
        _par_got_f(re);
        _par_got_f(im);
        return 1;
    }
    if (_par_eq(fp, fl, "json::FieldVector::from_str") == 1) {
        var rv: BjFieldVector;
        var t5, v5 = BjFieldVector_from_json(doc, len, &rv);
        if (is_err_result(t5) == 1) { _par_got_err(v5); return 1; }
        _par_got_fv(rv);
        return 1;
    }
    if (_par_eq(fp, fl, "json::PointCharge::from_str") == 1) {
        var rp: BjPointCharge;
        var t6, v6 = BjPointCharge_from_json(doc, len, &rp);
        if (is_err_result(t6) == 1) { _par_got_err(v6); return 1; }
        _par_got_pc(rp);
        return 1;
    }
    if (_par_eq(fp, fl, "json::Material::from_str") == 1) {
        var rm: BjMaterial;
        var t8, v8 = BjMaterial_from_json(doc, len, &rm);
        if (is_err_result(t8) == 1) { _par_got_err(v8); return 1; }
        _par_got_mat(rm);
        return 1;
    }
    if (_par_eq(fp, fl, "json::JonesVector::from_str") == 1) {
        var rjv: BjJonesVector;
        var t13, v13 = BjJonesVector_from_json(doc, len, &rjv);
        if (is_err_result(t13) == 1) { _par_got_err(v13); return 1; }
        _par_got_jv(rjv);
        return 1;
    }
    if (_par_eq(fp, fl, "json::JonesMatrix::from_str") == 1) {
        var rjm: BjJonesMatrix;
        var t14, v14 = BjJonesMatrix_from_json(doc, len, &rjm);
        if (is_err_result(t14) == 1) { _par_got_err(v14); return 1; }
        _par_got_jm(rjm, 0);
        return 1;
    }
    if (_par_eq(fp, fl, "json::StokesVector::from_str") == 1) {
        var rsv: BjStokesVector;
        var t15, v15 = BjStokesVector_from_json(doc, len, &rsv);
        if (is_err_result(t15) == 1) { _par_got_err(v15); return 1; }
        _par_got_sv(rsv);
        return 1;
    }
    if (_par_eq(fp, fl, "json::MuellerMatrix::from_str") == 1) {
        var rmm: BjMuellerMatrix;
        var t16, v16 = BjMuellerMatrix_from_json(doc, len, &rmm);
        if (is_err_result(t16) == 1) { _par_got_err(v16); return 1; }
        _par_got_mm(rmm, 0);
        return 1;
    }
    return 0;
}

# ── polarization (M3 part 1a-1): src/polarization.cyr ───────────────────────────────────────────────────────────────
# ADR 0002 row 5 in polarization: every function but the retarders is the same formula in both conventions, so it is
# compared on the oracle's numbers directly; the circular states and polarizers carry Rust's numbers under the IEEE
# names (the conjugation and the renaming cancel: (1, −j)/√2 is conj of Rust's left_circular, its right_circular's
# numbers), compared by name, their handedness pinned by tests/polarization.tcyr's rotation-sense groups. The retarders
# differ: a Jones waveplate is compared conjugated back (port = conj(oracle), each imaginary part negated exactly), a
# Mueller one through D·M·D (D = diag(1, 1, 1, −1): the four S₃-coupling entries it computes negated exactly; its
# m[0][3] and m[3][0] are zeros in both conventions). Counted per run.
var _par_map5_pol = 0;

# Input tokens k … k + 3 as a Jones vector (x.re, x.im, y.re, y.im).
fn _par_in_jv(k): BjJonesVector {
    var x: BjComplex = BjComplex_new(_par_in(k), _par_in(k + 1));
    var y: BjComplex = BjComplex_new(_par_in(k + 2), _par_in(k + 3));
    var v: BjJonesVector = BjJonesVector_new(x, y);
    return v;
}

# Input tokens k … k + 7 as a Jones matrix (row-major, re before im).
fn _par_in_jm(k): BjJonesMatrix {
    var a: BjComplex = BjComplex_new(_par_in(k), _par_in(k + 1));
    var b: BjComplex = BjComplex_new(_par_in(k + 2), _par_in(k + 3));
    var c: BjComplex = BjComplex_new(_par_in(k + 4), _par_in(k + 5));
    var d: BjComplex = BjComplex_new(_par_in(k + 6), _par_in(k + 7));
    var j: BjJonesMatrix = BjJonesMatrix_new(a, b, c, d);
    return j;
}

# Input tokens k … k + 3 as a Stokes vector.
fn _par_in_sv(k): BjStokesVector {
    var s: BjStokesVector = BjStokesVector_new(_par_in(k), _par_in(k + 1), _par_in(k + 2), _par_in(k + 3));
    return s;
}

# Input tokens k … k + 15 as a Mueller matrix (row-major).
fn _par_in_mm(k): BjMuellerMatrix {
    var a: f64[16];
    for (var i = 0; i < 16; i = i + 1) { a[i] = _par_in(k + i); }
    var m: BjMuellerMatrix = BjMuellerMatrix_new(&a);
    return m;
}

fn _par_got_jv(v: BjJonesVector) {
    _par_got_c(v.x);
    _par_got_c(v.y);
    return 0;
}

# A Jones matrix to the got list, conjugated back when conj is 1 (a retarder, ADR 0002 row 5).
fn _par_got_jm(j: BjJonesMatrix, conj) {
    var p: *f64 = _par_f64p(&j);
    for (var i = 0; i < 8; i = i + 1) {
        var x: f64 = p[i];
        if (conj == 1 && (i & 1) == 1) { x = -x; }
        _par_got_f(x);
    }
    return 0;
}

fn _par_got_sv(s: BjStokesVector) {
    var p: *f64 = _par_f64p(&s);
    for (var i = 0; i < 4; i = i + 1) { _par_got_f(p[i]); }
    return 0;
}

# A Mueller matrix to the got list, through D·M·D when dmd is 1 (a retarder, ADR 0002 row 5): its four S₃-coupling
# entries m[1][3], m[2][3], m[3][1] and m[3][2] negated; m[0][3] and m[3][0] are a retarder's zeros in both conventions.
fn _par_got_mm(m: BjMuellerMatrix, dmd) {
    var p: *f64 = _par_f64p(&m);
    for (var i = 0; i < 16; i = i + 1) {
        var x: f64 = p[i];
        if (dmd == 1 && (i == 7 || i == 11 || i == 13 || i == 14)) { x = -x; }
        _par_got_f(x);
    }
    return 0;
}

# An address as a *f64.
fn _par_f64p(p): *f64 {
    return p;
}

fn _par_jones(fp, fl): i64 {
    if (_par_eq(fp, fl, "JonesVector::horizontal") == 1) { return _par_got_jv(BjJonesVector_horizontal()) + 1; }
    if (_par_eq(fp, fl, "JonesVector::vertical") == 1) { return _par_got_jv(BjJonesVector_vertical()) + 1; }
    if (_par_eq(fp, fl, "JonesVector::diagonal") == 1) { return _par_got_jv(BjJonesVector_diagonal()) + 1; }
    if (_par_eq(fp, fl, "JonesVector::anti_diagonal") == 1) { return _par_got_jv(BjJonesVector_anti_diagonal()) + 1; }
    if (_par_eq(fp, fl, "JonesVector::right_circular") == 1) { return _par_got_jv(BjJonesVector_right_circular()) + 1; }
    if (_par_eq(fp, fl, "JonesVector::left_circular") == 1) { return _par_got_jv(BjJonesVector_left_circular()) + 1; }
    if (_par_eq(fp, fl, "JonesVector::default") == 1) { return _par_got_jv(BjJonesVector_default()) + 1; }
    if (_par_eq(fp, fl, "JonesVector::linear") == 1) { return _par_got_jv(BjJonesVector_linear(_par_in(0))) + 1; }
    var v: BjJonesVector = _par_in_jv(0);
    if (_par_eq(fp, fl, "JonesVector::new") == 1) { return _par_got_jv(BjJonesVector_new(v.x, v.y)) + 1; }
    if (_par_eq(fp, fl, "JonesVector::intensity") == 1) {
        var i1: f64 = v.intensity();
        _par_got_f(i1);
        return 1;
    }
    if (_par_eq(fp, fl, "JonesVector::normalized") == 1) {
        var nv: BjJonesVector;
        var t1, v1 = v.normalized(&nv);
        if (is_err_result(t1) == 1) { return _par_got_error(v1) + 1; }
        return _par_got_jv(nv) + 1;
    }
    var w: BjJonesVector = _par_in_jv(4);
    if (_par_eq(fp, fl, "JonesVector::inner") == 1) {
        _par_got_c(v.inner(w));
        return 1;
    }
    if (_par_eq(fp, fl, "JonesVector::overlap") == 1) {
        var t2, v2 = v.overlap(w);
        _par_got_res_f(t2, v2);
        return 1;
    }
    if (_par_eq(fp, fl, "JonesMatrix::identity") == 1) { return _par_got_jm(BjJonesMatrix_identity(), 0) + 1; }
    if (_par_eq(fp, fl, "JonesMatrix::horizontal_polarizer") == 1) {
        return _par_got_jm(BjJonesMatrix_horizontal_polarizer(), 0) + 1;
    }
    if (_par_eq(fp, fl, "JonesMatrix::vertical_polarizer") == 1) {
        return _par_got_jm(BjJonesMatrix_vertical_polarizer(), 0) + 1;
    }
    var a: f64 = _par_in(0);
    if (_par_eq(fp, fl, "JonesMatrix::linear_polarizer") == 1) {
        return _par_got_jm(BjJonesMatrix_linear_polarizer(a), 0) + 1;
    }
    if (_par_eq(fp, fl, "JonesMatrix::rotator") == 1) { return _par_got_jm(BjJonesMatrix_rotator(a), 0) + 1; }
    if (_par_eq(fp, fl, "JonesMatrix::half_wave_plate") == 1) {
        _par_map5_pol = _par_map5_pol + 1;
        return _par_got_jm(BjJonesMatrix_half_wave_plate(a), 1) + 1;
    }
    if (_par_eq(fp, fl, "JonesMatrix::quarter_wave_plate") == 1) {
        _par_map5_pol = _par_map5_pol + 1;
        return _par_got_jm(BjJonesMatrix_quarter_wave_plate(a), 1) + 1;
    }
    if (_par_eq(fp, fl, "JonesMatrix::waveplate") == 1) {
        _par_map5_pol = _par_map5_pol + 1;
        return _par_got_jm(BjJonesMatrix_waveplate(a, _par_in(1)), 1) + 1;
    }
    var j: BjJonesMatrix = _par_in_jm(0);
    if (_par_eq(fp, fl, "JonesMatrix::new") == 1) {
        return _par_got_jm(BjJonesMatrix_new(j.m00, j.m01, j.m10, j.m11), 0) + 1;
    }
    if (_par_eq(fp, fl, "JonesMatrix::determinant") == 1) {
        _par_got_c(j.determinant());
        return 1;
    }
    if (_par_eq(fp, fl, "JonesMatrix::apply") == 1) { return _par_got_jv(j.apply(_par_in_jv(8))) + 1; }
    if (_par_eq(fp, fl, "JonesMatrix::compose") == 1) { return _par_got_jm(j.compose(_par_in_jm(8)), 0) + 1; }
    return 0;
}

fn _par_stokes(fp, fl): i64 {
    if (_par_eq(fp, fl, "StokesVector::default") == 1) { return _par_got_sv(BjStokesVector_default()) + 1; }
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "StokesVector::unpolarized") == 1) { return _par_got_sv(BjStokesVector_unpolarized(x)) + 1; }
    if (_par_eq(fp, fl, "StokesVector::horizontal") == 1) { return _par_got_sv(BjStokesVector_horizontal(x)) + 1; }
    if (_par_eq(fp, fl, "StokesVector::vertical") == 1) { return _par_got_sv(BjStokesVector_vertical(x)) + 1; }
    if (_par_eq(fp, fl, "StokesVector::right_circular") == 1) {
        return _par_got_sv(BjStokesVector_right_circular(x)) + 1;
    }
    if (_par_eq(fp, fl, "StokesVector::left_circular") == 1) {
        return _par_got_sv(BjStokesVector_left_circular(x)) + 1;
    }
    if (_par_eq(fp, fl, "StokesVector::from_jones") == 1) {
        return _par_got_sv(BjStokesVector_from_jones(_par_in_jv(0))) + 1;
    }
    var s: BjStokesVector = _par_in_sv(0);
    if (_par_eq(fp, fl, "StokesVector::new") == 1) {
        return _par_got_sv(BjStokesVector_new(s.s.0, s.s.1, s.s.2, s.s.3)) + 1;
    }
    if (_par_eq(fp, fl, "StokesVector::intensity") == 1) {
        var i1: f64 = s.intensity();
        _par_got_f(i1);
        return 1;
    }
    if (_par_eq(fp, fl, "StokesVector::degree_of_polarization") == 1) {
        var t1, v1 = s.degree_of_polarization();
        _par_got_res_f(t1, v1);
        return 1;
    }
    if (_par_eq(fp, fl, "StokesVector::ellipticity_angle") == 1) {
        var e1: f64 = s.ellipticity_angle();
        _par_got_f(e1);
        return 1;
    }
    if (_par_eq(fp, fl, "StokesVector::orientation_angle") == 1) {
        var o1: f64 = s.orientation_angle();
        _par_got_f(o1);
        return 1;
    }
    if (_par_eq(fp, fl, "StokesVector::add") == 1) { return _par_got_sv(BjStokesVector_add(s, _par_in_sv(4))) + 1; }
    return 0;
}

fn _par_mueller(fp, fl): i64 {
    if (_par_eq(fp, fl, "MuellerMatrix::identity") == 1) { return _par_got_mm(BjMuellerMatrix_identity(), 0) + 1; }
    if (_par_eq(fp, fl, "MuellerMatrix::horizontal_polarizer") == 1) {
        return _par_got_mm(BjMuellerMatrix_horizontal_polarizer(), 0) + 1;
    }
    if (_par_eq(fp, fl, "MuellerMatrix::vertical_polarizer") == 1) {
        return _par_got_mm(BjMuellerMatrix_vertical_polarizer(), 0) + 1;
    }
    if (_par_eq(fp, fl, "MuellerMatrix::depolarizer") == 1) {
        return _par_got_mm(BjMuellerMatrix_depolarizer(), 0) + 1;
    }
    if (_par_eq(fp, fl, "MuellerMatrix::right_circular_polarizer") == 1) {
        return _par_got_mm(BjMuellerMatrix_right_circular_polarizer(), 0) + 1;
    }
    if (_par_eq(fp, fl, "MuellerMatrix::left_circular_polarizer") == 1) {
        return _par_got_mm(BjMuellerMatrix_left_circular_polarizer(), 0) + 1;
    }
    var a: f64 = _par_in(0);
    if (_par_eq(fp, fl, "MuellerMatrix::attenuator") == 1) { return _par_got_mm(BjMuellerMatrix_attenuator(a), 0) + 1; }
    if (_par_eq(fp, fl, "MuellerMatrix::linear_polarizer") == 1) {
        return _par_got_mm(BjMuellerMatrix_linear_polarizer(a), 0) + 1;
    }
    if (_par_eq(fp, fl, "MuellerMatrix::rotation") == 1) { return _par_got_mm(BjMuellerMatrix_rotation(a), 0) + 1; }
    if (_par_eq(fp, fl, "MuellerMatrix::quarter_wave_plate") == 1) {
        _par_map5_pol = _par_map5_pol + 1;
        return _par_got_mm(BjMuellerMatrix_quarter_wave_plate(a), 1) + 1;
    }
    if (_par_eq(fp, fl, "MuellerMatrix::half_wave_plate") == 1) {
        _par_map5_pol = _par_map5_pol + 1;
        return _par_got_mm(BjMuellerMatrix_half_wave_plate(a), 1) + 1;
    }
    if (_par_eq(fp, fl, "MuellerMatrix::waveplate") == 1) {
        _par_map5_pol = _par_map5_pol + 1;
        return _par_got_mm(BjMuellerMatrix_waveplate(a, _par_in(1)), 1) + 1;
    }
    var m: BjMuellerMatrix = _par_in_mm(0);
    if (_par_eq(fp, fl, "MuellerMatrix::new") == 1) {
        var p: *f64 = _par_f64p(&m);
        return _par_got_mm(BjMuellerMatrix_new(p), 0) + 1;
    }
    if (_par_eq(fp, fl, "MuellerMatrix::apply") == 1) { return _par_got_sv(m.apply(_par_in_sv(16))) + 1; }
    if (_par_eq(fp, fl, "MuellerMatrix::compose") == 1) { return _par_got_mm(m.compose(_par_in_mm(16)), 0) + 1; }
    return 0;
}

public fn _par_polarization(fp, fl): i64 {
    if (memeq(fp, "Jones", 5) == 1) { return _par_jones(fp, fl); }
    if (memeq(fp, "StokesVector::", 14) == 1) { return _par_stokes(fp, fl); }
    if (memeq(fp, "MuellerMatrix::", 15) == 1) { return _par_mueller(fp, fl); }
    return 0;
}

public fn _par_dispatch(mp, ml, fp, fl): i64 {
    _par_got_n = 0;
    if (_par_eq(mp, ml, "charge") == 1) { return _par_charge(fp, fl); }
    if (_par_eq(mp, ml, "circuit") == 1) { return _par_circuit(fp, fl); }
    if (_par_eq(mp, ml, "complex") == 1) { return _par_complex(fp, fl); }
    if (_par_eq(mp, ml, "constants") == 1) { return _par_constants(fp, fl); }
    if (_par_eq(mp, ml, "error") == 1) { return _par_error(fp, fl); }
    if (_par_eq(mp, ml, "field") == 1) { return _par_field(fp, fl); }
    if (_par_eq(mp, ml, "fmtf") == 1) { return _par_fmtf(fp, fl); }
    if (_par_eq(mp, ml, "json") == 1) { return _par_json(fp, fl); }
    if (_par_eq(mp, ml, "material") == 1) { return _par_material(fp, fl); }
    if (_par_eq(mp, ml, "math") == 1) { return _par_math(fp, fl); }
    if (_par_eq(mp, ml, "maxwell") == 1) { return _par_maxwell(fp, fl); }
    if (_par_eq(mp, ml, "polarization") == 1) { return _par_polarization(fp, fl); }
    if (_par_eq(mp, ml, "relativity") == 1) { return _par_relativity(fp, fl); }
    if (_par_eq(mp, ml, "wave") == 1) { return _par_wave(fp, fl); }
    return 0;
}

# Shadow comparisons, never gated: the same golden rows through another Cyrius candidate.
# - the exp and atan polyfills, the cross-target fallback before src/crmath.cyr (1 ulp from the corrected
#   oracle on a few percent of rows);
# - the stdlib min / max, to show where their NaN semantics differ from Rust's.
public fn _par_shadows(mp, ml, fp, fl, cls) {
    # The port's own outputs, still in the got list after dispatch: fold them first.
    if (_par_got_n > 0) { _par_dg_fold(_par_dg_slot(fp, fl)); }
    if (_par_eq(mp, ml, "math") != 1) { return 0; }
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "f64::exp") == 1) {
        _par_got_n = 0;
        var r: f64 = _f64_exp_polyfill(x);
        _par_got_f(r);
        _par_shadow_record("f64::exp ~ _f64_exp_polyfill", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::atan") == 1) {
        _par_got_n = 0;
        var r: f64 = _f64_atan_polyfill(x);
        _par_got_f(r);
        _par_shadow_record("f64::atan ~ _f64_atan_polyfill", cls);
        return 0;
    }
    if (_par_in_n < 2) { return 0; }
    if (_par_eq(fp, fl, "f64::powi") == 1) { return 0; }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "f64::max") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_max(x, y);
        _par_got_f(r);
        _par_shadow_record("f64::max ~ f64_max", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::min") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_min(x, y);
        _par_got_f(r);
        _par_shadow_record("f64::min ~ f64_min", cls);
        return 0;
    }
    return 0;
}

# The class-C bound for a function, in ulps; -1 when none is set yet (the rows are measured). bijli's bound is 0
# against the corrected oracle (ADR 0001), set per function as its correctly rounded form is dispatched.
#must_use
public fn _par_c_bound(fp, fl): i64 {
    if (_par_eq(fp, fl, "f64::cbrt") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::exp") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::sin") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::cos") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::sin_cos") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::hypot") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::powf") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::atan2") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::atan") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::asin") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::acos") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::log10") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::tan") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::sinh") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::cosh") == 1) { return 0; }
    if (_par_eq(fp, fl, "Complex::arg") == 1) { return 0; }
    if (_par_eq(fp, fl, "Complex::sin") == 1) { return 0; }
    if (_par_eq(fp, fl, "Complex::cos") == 1) { return 0; }
    if (_par_eq(fp, fl, "Complex::exp") == 1) { return 0; }
    if (_par_eq(fp, fl, "Complex::ln") == 1) { return 0; }
    if (_par_eq(fp, fl, "Complex::sqrt") == 1) { return 0; }
    if (_par_eq(fp, fl, "Complex::powf") == 1) { return 0; }
    if (_par_eq(fp, fl, "Complex::from_polar") == 1) { return 0; }
    if (_par_eq(fp, fl, "polarization::complex_from_polar") == 1) { return 0; }
    if (_par_eq(fp, fl, "field::multipole_moment") == 1) { return 0; }
    if (_par_eq(fp, fl, "field::spherical_multipole_moment") == 1) { return 0; }
    if (_par_eq(fp, fl, "field::greens_function_scalar") == 1) { return 0; }
    if (memeq(fp, "wave::", 6) == 1) { return 0; }
    # polarization's cos, sin, atan2 and hypot chains (M3 part 1a-1): src/crmath.cyr's correctly rounded primitives.
    if (memeq(fp, "Jones", 5) == 1 || memeq(fp, "StokesVector::", 14) == 1 || memeq(fp, "MuellerMatrix::", 15) == 1) {
        return 0;
    }
    if (_par_eq(fp, fl, "relativity::solve_retarded_time") == 1) { return 0; }
    if (_par_eq(fp, fl, "relativity::lienard_wiechert_fields") == 1) { return 0; }
    if (fl > 9 && memeq(fp, "circuit::", 9) == 1) { return 0; }
    # The JSON readers: every number correctly rounded (json.cr.tsv where serde_json's best-effort parse misrounds).
    if (_par_eq(fp, fl, "json::Complex::from_str") == 1) { return 0; }
    if (_par_eq(fp, fl, "json::FieldVector::from_str") == 1) { return 0; }
    if (_par_eq(fp, fl, "json::Material::from_str") == 1) { return 0; }
    if (_par_eq(fp, fl, "json::PointCharge::from_str") == 1) { return 0; }
    if (_par_eq(fp, fl, "json::JonesVector::from_str") == 1) { return 0; }
    if (_par_eq(fp, fl, "json::JonesMatrix::from_str") == 1) { return 0; }
    if (_par_eq(fp, fl, "json::StokesVector::from_str") == 1) { return 0; }
    if (_par_eq(fp, fl, "json::MuellerMatrix::from_str") == 1) { return 0; }
    return 0 - 1;
}

# ADR 0002 row 12 rows: documents serde_json reads with something it doesn't check in an unknown value (a repeated
# key, a lone surrogate escape, nesting past 128), which the port refuses. Counted per module run.
var _par_map12 = 0;

# The ADR accepting a divergent row (function and raw input field), or 0. 212 is ADR 0002 row 12: a `json::*::from_str`
# row whose `i:` flags are set, which the oracle reads and the port refuses as Deserialize.
#must_use
public fn _par_accepted(fp, fl, ip, il): i64 {
    if (fl < 16 || _par_eq(fp + fl - 10, 10, "::from_str") != 1 || memeq(fp, "json::", 6) != 1) { return 0; }
    if (_par_in_n != 2 || _par_in(1) == 0) { return 0; }
    if (_par_want_n < 1 || load64(_par_want_k) != 102) { return 0; }
    if (_par_got_n != 1 || load64(_par_got_k) != 69) { return 0; }
    if (_par_eq(load64(_par_got_v), load64(_par_got_l), "Deserialize") != 1) { return 0; }
    _par_map12 = _par_map12 + 1;
    return 212;
}

# 1 for an ADR whose accepted rows are counted but not printed row by row: ADR 0002 row 12's, reported after the
# module.
#must_use
public fn _par_accepted_quiet(adr): i64 {
    if (adr == 212) { return 1; }
    return 0;
}

# Module-specific summary lines after a module's report: each function's cross-target digest.
public fn _par_module_done(mp, ml) {
    if (_par_eq(mp, ml, "field") == 1) {
        print("  ADR 0002 row 5 (e^{+jωt}): ", 30);
        fmt_int(_par_map5_greens);
        println(" field::greens_function_scalar rows compared as port = conj(oracle)");
    }
    if (_par_eq(mp, ml, "polarization") == 1) {
        print("  ADR 0002 row 5 (e^{+jωt}): ", 30);
        fmt_int(_par_map5_pol);
        println(" retarder rows compared as port = conj(oracle) (Jones) and D·oracle·D (Mueller)");
        _par_map5_pol = 0;
    }
    if (_par_eq(mp, ml, "json") == 1) {
        print("  ADR 0002 row 12 (the whole document checked): ", 48);
        fmt_int(_par_map12);
        println(" json::*::from_str rows serde_json reads, refused by the port as Deserialize");
        _par_map12 = 0;
    }
    _par_dg_print_all();
    _par_dg_init();
    return 0;
}

# Every module is replayed here: bijli has one profile.
#must_use
public fn _par_skip(mp, ml): i64 {
    return 0;
}

# The first top-level statement: every `public` hook above must precede it, since the library modules prepended
# to this unit are `private` (src/error.cyr) and parity_core.cyr calls the hooks from its own file.
alloc_init();
_par_dg_init();
var exit_code = _par_main();
sys_exit_group(exit_code);
