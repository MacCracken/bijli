# bridge.tcyr — src/bridge.cyr (M7 parts 1a and 2a): the eight cross-crate bridges (ushma, prakash, tanmatra, dravya).
#
# Every group not named cyrius_* is 1.2.0:src/bridge.rs's test of that name, ported assertion for assertion (the ledger
# matches them by name): all 18. tests/golden/bridge.tsv pins every function over its grid besides, as the port
# computes it (part 2a: round once, ADR 0002 row 13; the Sellmeier index's range edge, row 18).

include "tests/lib.cyr"

# |a − b| < tol.
fn near(a: f64, b: f64, tol: f64): i64 {
    var dd: f64 = a - b;
    var ad: f64 = f64_abs(dd);
    if (ad < tol) { return 1; }
    return 0;
}

# The f64 with bit pattern b.
fn fb(b): f64 {
    var x: f64 = 0.0;
    store64(&x, b);
    return x;
}

# Runs bridge.rs's tests, then the Cyrius-only check.
fn main() {
    test_group("joule_heating_basic");
    var p: f64 = bj_joule_heating_power_density(1.0, 0.0000001);
    assert(near(p, 0.0000001, 0.000000000001) == 1, "1 A/m² in 10⁻⁷ Ω·m: 10⁻⁷ W/m³");

    test_group("heating_rate_basic");
    var rate: f64 = bj_em_energy_to_heating_rate(1000.0, 1000.0, 4186.0);
    var want: f64 = 1000.0 / (1000.0 * 4186.0);
    assert(near(rate, want, 0.0000000001) == 1, "dT/dt = p/(ρ·c_p)");

    test_group("heating_rate_zero_density");
    var nan: f64 = fb(0x7ff8000000000000);
    var r0: f64 = bj_em_energy_to_heating_rate(1000.0, 0.0, 4186.0);
    var r1: f64 = bj_em_energy_to_heating_rate(1000.0, nan, 4186.0);
    assert(r0 == 0.0 && r1 == 0.0, "ρ·c_p not positive (NaN included): 0.0");

    test_group("joule_heating_chain_copper");
    var p2: f64 = bj_joule_heating_power_density(1000000.0, 0.0000000168);
    assert(near(p2, 16800.0, 0.000000001) == 1, "10⁶ A/m² in copper: 1.68·10⁴ W/m³");
    var rate2: f64 = bj_em_energy_to_heating_rate(p2, 8960.0, 385.0);
    assert(near(rate2, 0.00487012987012987, 0.000000000000001) == 1, "then 4.87013·10⁻³ K/s");

    test_group("bk7_visible_range");
    var n: f64 = bj_wavelength_to_refractive_index_bk7(550.0);
    assert(n > 1.5 && n < 1.55, "BK7 at 550 nm");

    test_group("bk7_dispersion");
    var nb: f64 = bj_wavelength_to_refractive_index_bk7(450.0);
    var nr: f64 = bj_wavelength_to_refractive_index_bk7(650.0);
    assert(nb > nr, "blue has the higher index");

    test_group("bk7_zero_wavelength");
    var nan2: f64 = fb(0x7ff8000000000000);
    var z0: f64 = bj_wavelength_to_refractive_index_bk7(0.0);
    var z1: f64 = bj_wavelength_to_refractive_index_bk7(nan2);
    assert(z0 == 1.0 && z1 == 1.0, "λ not positive (NaN included): the sentinel 1.0");

    test_group("bk7_d_line");
    var nd: f64 = bj_wavelength_to_refractive_index_bk7(587.5618);
    assert(near(nd, 1.5168, 0.00001) == 1, "n_d = 1.5168 at 587.5618 nm");

    test_group("e_field_intensity_roundtrip");
    var i: f64 = bj_e_field_to_optical_intensity(100.0);
    assert(i > 0.0 && near(i, 13.28, 0.1) == 1, "I = ε₀cE²/2 ≈ 13.28 W/m² at 100 V/m");

    test_group("hydrogen_lyman_alpha");
    var nm: f64 = bj_energy_level_to_wavelength_nm(10.2);
    assert(near(nm, 121.6, 1.0) == 1, "Lyman-α: 10.2 eV ≈ 121.5 nm");

    test_group("energy_zero");
    var nan3: f64 = fb(0x7ff8000000000000);
    var e0: f64 = bj_energy_level_to_wavelength_nm(0.0);
    var e1: f64 = bj_energy_level_to_wavelength_nm(nan3);
    assert(e0 == 0.0 && e1 == 0.0, "E not positive (NaN included): 0.0");

    test_group("energy_one_ev_is_hc");
    var hc: f64 = bj_energy_level_to_wavelength_nm(1.0);
    assert(near(hc, 1239.8419843320025, 0.000000001) == 1, "1 eV: hc = 1239.8419843320025 nm");

    test_group("nuclear_potential_hydrogen");
    var v: f64 = bj_nuclear_charge_potential(1, 0.0000000000529);
    assert(near(v, 27.2, 0.5) == 1, "Z = 1 at one Bohr radius ≈ 27.2 V");

    test_group("nuclear_potential_zero_distance");
    var v0: f64 = bj_nuclear_charge_potential(1, 0.0);
    assert(v0 == 0.0, "r = 0: 0.0");

    test_group("piezo_stress_basic");
    var s: f64 = bj_e_field_to_piezo_stress(1000.0, 15.0);
    assert(near(s, 15000.0, 0.1) == 1, "PZT, e = 15 C/m², E = 1000 V/m: 15000 Pa");

    test_group("magnetostriction_iron");
    var ls: f64 = -0.000007;
    var st: f64 = bj_magnetic_flux_to_magnetostrictive_strain(1.0, ls, 2.15);
    assert(near(st, -0.0000022714981070849106, 0.000000000000000001) == 1, "iron at 1 T: −2.2714981·10⁻⁶");

    test_group("magnetostriction_saturates_beyond_bsat");
    var ls2: f64 = -0.000007;
    var at_sat: f64 = 1.5 * ls2;
    var bs: f64[4];
    bs[0] = 2.15;
    bs[1] = 3.0;
    bs[2] = 10.0;
    bs[3] = -3.0;
    for (var k = 0; k < 4; k = k + 1) {
        var sk: f64 = bj_magnetic_flux_to_magnetostrictive_strain(bs[k], ls2, 2.15);
        assert(near(sk, at_sat, 0.000000000000000001) == 1, "past B_sat the strain stays (3/2)λ_s");
    }

    test_group("magnetostriction_zero_saturation");
    var sz: f64 = bj_magnetic_flux_to_magnetostrictive_strain(1.0, 0.000035, 0.0);
    assert(sz == 0.0, "B_sat = 0: 0.0");

    test_group("cyrius_bridge_u32");
    # Z is Rust's u32: the Cyrius-only words outside it take the sentinel 0.0, as a distance that isn't positive.
    var vn: f64 = bj_nuclear_charge_potential(0 - 1, 1.0);
    var vb: f64 = bj_nuclear_charge_potential(4294967296, 1.0);
    var vt: f64 = bj_nuclear_charge_potential(4294967295, 1.0);
    assert(vn == 0.0 && vb == 0.0 && vt > 0.0, "Z = −1 and 2³² give 0.0; 2³² − 1 is a u32");

    # Part 2a's edges: each value Rust's chain gave otherwise, as bits (a literal has no exponent).
    test_group("cyrius_bridge_edges");
    var j1: f64 = bj_joule_heating_power_density(_bj_from_bits(0x601DD55745CBB7ED), _bj_from_bits(0x3DDB7CDFD9D7BDBB));
    assert(_bj_k_bits(j1) == 0x7E37E43C8800759C, "J = 1e155, ρ = 1e-10: 1e300 (Rust's J·J overflowed)");
    var e1p: f64 = _bj_from_bits(0x01A56E1FC2F8F359);
    var e1r: f64 = _bj_from_bits(0x16687E92154EF7AC);
    var h1: f64 = bj_em_energy_to_heating_rate(e1p, e1r, e1r);
    assert(_bj_k_bits(h1) == 0x54B249AD2594C37D, "ρ = c_p = 1e-200: p/(ρc_p) = 1e100 (Rust's sentinel 0)");
    var e2r: f64 = -e1r;
    var h2: f64 = bj_em_energy_to_heating_rate(1.0, e2r, e2r);
    assert(_bj_k_bits(h2) == 0x7FF0000000000000, "both negative, the exact product positive: 1/1e-400 overflows");
    var h3: f64 = bj_em_energy_to_heating_rate(1.0, e2r, e1r);
    assert(h3 == 0.0, "opposite signs: the sentinel");
    var i1: f64 = bj_e_field_to_optical_intensity(100.0);
    assert(_bj_k_bits(i1) == 0x402A8B4FDB8A3258, "E = 100 V/m: 13.27209363996478 (Rust's ulp high)");
    var v1: f64 = bj_nuclear_charge_potential(26, _bj_from_bits(0x3CD203AF9EE75616));
    assert(_bj_k_bits(v1) == 0x4181DA3331F38560, "Fe at 1 fm: 37439078.24390674 (Rust's ulp high)");
    var m1: f64 = bj_magnetic_flux_to_magnetostrictive_strain(1.0, _bj_from_bits(0xBEDD5C31593E5FB7),
      _bj_from_bits(0x4001333333333333));
    assert(_bj_k_bits(m1) == 0xBEC30E014A651F86, "iron at 1 T: -2.271498107084911e-6 (Rust's ulp off)");
    var below: f64 = _bj_from_bits(0x4001333333333332);
    var m2: f64 = bj_magnetic_flux_to_magnetostrictive_strain(below, -1.0, _bj_from_bits(0x4001333333333333));
    assert(m2 > -1.5, "a hair below B_sat: under (3/2)·λ_s, where Rust's rounded ratio reached 1");
    var n1: f64 = bj_wavelength_to_refractive_index_bk7(_bj_from_bits(0x6974E718D7D7625A));
    assert(_bj_k_bits(n1) == 0x3FFCFC4A4E77A7C9, "λ = 1e200 nm: n = 1.8116 (Rust's λ² overflowed to the sentinel)");
    var n2: f64 = bj_wavelength_to_refractive_index_bk7(_bj_from_bits(0x606BF801D16EFC6E));
    assert(_bj_k_bits(n2) == 0x3FFCFC4A4E77A7C9, "λ = 3e156 nm, in range: Rust's own bits");
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
