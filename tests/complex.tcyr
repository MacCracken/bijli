# complex.tcyr — src/complex.cyr: BjComplex by value.
#
# tests/golden/complex.tsv pins every operation against Rust hisab 1.4.0's Complex over its grids (class A bit for
# bit, class C at 0 ulp against the corrected oracle). These check what the corpus doesn't say directly: a
# BjComplex is a value (copies are independent, operators equal their fns inside chained expressions), hisab's
# formulas keep their IEEE behaviour at the specials (no hypot rescue, the textbook division), and the Display
# text's edge cases. Every expected word is Python's IEEE arithmetic on hisab's formula.

include "tests/lib.cyr"

# 1 when a and b have the same bits.
fn same(a: f64, b: f64): i64 {
    if (_bj_bits(a) == _bj_bits(b)) { return 1; }
    return 0;
}

# 1 when z has exactly the parts (re, im).
fn is_c(z: BjComplex, re: f64, im: f64): i64 {
    var zr: f64 = z.re;
    var zi: f64 = z.im;
    if (same(zr, re) == 1 && same(zi, im) == 1) { return 1; }
    return 0;
}

# 1 when z's Display text is the C string want.
fn shows(z: BjComplex, want): i64 {
    var buf[800];
    var tx[24];
    _bj_tx_init(&tx, &buf, 800);
    z.display(&tx);
    var n = strlen(want);
    if (_bj_tx_len(&tx) != n) { return 0; }
    return memeq(_bj_tx_ptr(&tx), want, n);
}

# Runs the complex tests.
fn main() {
    alloc_init();
    var zero: f64 = 0.0;
    var nan: f64 = zero / zero;
    var inf: f64 = 1.0 / zero;
    var nzero: f64 = -zero;

    test_group("value_semantics");
    var a = BjComplex_new(1.5, -2.25);
    var b = a;
    b.re = 9.0;
    var are: f64 = a.re;
    assert(are == 1.5, "a copy is independent of its source");
    var c = a.conj();
    assert(is_c(a, 1.5, -2.25) == 1, "a method leaves its receiver alone");
    assert(is_c(c, 1.5, 2.25) == 1, "conj");

    test_group("operators_equal_their_fns");
    var p = BjComplex_new(0.5, 4.0);
    var q = BjComplex_new(-3.0, 0.125);
    var chain = a * p + q / p - BjComplex_neg(a);
    var step = BjComplex_sub(BjComplex_add(BjComplex_mul(a, p), BjComplex_div(q, p)), BjComplex_neg(a));
    var cr: f64 = chain.re;
    var ci: f64 = chain.im;
    assert(is_c(step, cr, ci) == 1, "a * p + q / p - (-a) is the fns composed, precedence included");
    var m = a * p;
    assert(is_c(m, 0.75 + 9.0, 6.0 - 1.125) == 1, "a * p by hand: (1.5*0.5 - (-2.25)*4, 1.5*4 + (-2.25)*0.5)");
    var s = a.scale(2.0);
    assert(is_c(s, 3.0, -4.5) == 1, "scale, Rust's z * 2.0 and 2.0 * z");
    var dv = a.div_f64(2.0);
    assert(is_c(dv, 0.75, -1.125) == 1, "div_f64");

    test_group("specials_keep_hisab_formulas");
    var o = BjComplex_new(1.0, 0.0);
    var z0 = BjComplex_default();
    var dz = o / z0;
    var dzr: f64 = dz.re;
    var dzi: f64 = dz.im;
    assert(dzr != dzr, "1 / 0 by the textbook division: (1·0 + 0·0)/0 = 0/0 is NaN, not inf");
    assert(dzi != dzi, "and (0·0 − 1·0)/0 is NaN too");
    var ninf = BjComplex_new(inf, nan);
    var an: f64 = ninf.abs();
    assert(an != an, "abs(inf + j NaN) is NaN: sqrt(re² + im²), no hypot rescue");
    var e160: f64 = _bj_from_bits(0x6126C2D4256FFCC3);        # 1e160
    var big = BjComplex_new(e160, 0.0);
    var ab: f64 = big.abs();
    assert(same(ab, e160) == 1, "abs(1e160) = 1e160: re² with an unbounded exponent (ADR 0002 row 14; hisab: ∞)");
    var em160: f64 = _bj_from_bits(0x1EB67E9C127B6E74);       # 1e-160
    var tiny = BjComplex_new(em160, 0.0);
    var tp = tiny.powf(2.0);
    var e320: f64 = _bj_from_bits(0x00000000000007E8);       # 1e-320, RN((1e-160)²) on the subnormal grid
    assert(is_c(tp, e320, 0.0) == 1, "(1e-160)² = 1e-320: no cutoff below |z|² = 1e-300 (ADR 0002 row 15; hisab: 0)");
    var nz = BjComplex_new(0.0, 0.0);
    assert_eq(nz.is_zero(0.0), 0, "0 is not below a zero tolerance");
    var zn = BjComplex_new(nan, 0.0);
    assert_eq(zn.is_zero(1.0), 0, "NaN is never near zero");
    var ln0 = z0.ln();
    var l0: f64 = ln0.re;
    assert(same(l0, -inf) == 1, "ln 0 = -inf + j0");

    test_group("display");
    assert(shows(BjComplex_new(1.0, nzero), "1+-0i") == 1, "-0 imaginary: hisab's `im >= 0.0` holds for -0");
    assert(shows(BjComplex_new(1.0, nan), "1NaNi") == 1, "a NaN imaginary part takes no sign");
    assert(shows(BjComplex_new(-1.5, -2.25), "-1.5-2.25i") == 1, "negative parts");
    assert(shows(BjComplex_new(inf, inf), "inf+infi") == 1, "infinities");
    assert(shows(BjComplex_new(0.1, 100.0), "0.1+100i") == 1, "Rust's shortest Display digits");

    test_group("sin_cos");
    # On the real axis sin z is (sin x, cos x·sinh 0) = (sin x, +0); on the imaginary axis cos z is
    # (cosh y, (−sin 0)·sinh y) = (cosh y, −0): the sign of zero from hisab's (−sin re)·sinh im.
    var s1 = BjComplex_new(1.0, 0.0);
    var sz = s1.sin();
    var sin1: f64 = _bj_sin(1.0);
    assert(is_c(sz, sin1, 0.0) == 1, "sin(1 + j0) = (sin 1, +0)");
    var c1 = BjComplex_new(0.0, 1.0);
    var cz = c1.cos();
    var cosh1: f64 = _bj_cosh(1.0);
    assert(is_c(cz, cosh1, nzero) == 1, "cos(0 + j1) = (cosh 1, -0)");
    var sj = c1.sin();
    var sinh1: f64 = _bj_sinh(1.0);
    assert(is_c(sj, 0.0, sinh1) == 1, "sin(0 + j1) = (0, sinh 1)");

    test_group("polarization_helpers");
    assert(is_c(bj_complex_real(2.5), 2.5, 0.0) == 1, "complex_real");
    assert(is_c(bj_complex_zero(), 0.0, 0.0) == 1, "complex_zero");
    var fp = bj_complex_from_polar(2.0, 0.0);
    assert(is_c(fp, 2.0, 0.0) == 1, "complex_from_polar(2, 0)");

    test_group("cyrius_range_edges (ADR 0002 rows 14 and 15)");
    # At a range edge hisab's chain runs with an unbounded exponent, its last step rounded once; the expected bits are
    # scripts/oracle/validate.py's model (exact values, MPFR's correctly rounded primitives).
    var x160: f64 = _bj_from_bits(0x6126C2D4256FFCC3);       # 1e160
    var x200: f64 = _bj_from_bits(0x6974E718D7D7625A);       # 1e200
    var x201: f64 = _bj_from_bits(0x69AA20DF0DCD3AF1);       # 1e201
    var x300: f64 = _bj_from_bits(0x7E37E43C8800759C);       # 1e300
    var x160m: f64 = _bj_from_bits(0x1EB67E9C127B6E74);      # 1e-160
    var x151m: f64 = _bj_from_bits(0x2094F31F8832DD2A);      # 1e-151
    var e1 = BjComplex_new(x160, x160);
    var a1: f64 = e1.abs();
    assert(same(a1, _bj_from_bits(0x61301830A9572A89)) == 1, "|1e160 + j1e160| = 1.414213562373095e160 (hisab: ∞)");
    var e2 = BjComplex_new(x200, x200);
    var p2 = e2 * e2;
    assert(is_c(p2, 0.0, _BJ_K_INF) == 1, "(1e200 + j1e200)²: re exactly 0 (hisab: ∞ − ∞ = NaN), im ∞");
    var e3 = BjComplex_new(x160, 0.0);
    var i3 = e3.inv();
    assert(is_c(i3, _bj_from_bits(0x1EB67E9C127B6E75), -0.0) == 1, "1/1e160 rounded once (hisab: 0)");
    var re_one = BjComplex_new(1.0, 0.0);
    var q4 = re_one / e2;
    assert(is_c(q4, _bj_from_bits(0x16587E92154EF7AC), _bj_from_bits(0x96587E92154EF7AC)) == 1,
      "1/(1e200 + j1e200) = 5e-201 − j5e-201 (hisab: 0)");
    var e5 = BjComplex_new(x200, 0.0);
    assert_eq(e5.is_zero(x201), 1, "|1e200| < 1e201, compared unbounded (hisab: ∞ < ∞ is false)");
    var e6 = BjComplex_new(x300, x300);
    var s6 = e6.sqrt();
    assert(is_c(s6, _bj_from_bits(0x5F157B2468F15C93), _bj_from_bits(0x5F01CBA37A2EACF6)) == 1,
      "√(1e300 + j1e300) finite (hisab: ∞ + j∞)");
    var l7 = e2.ln();
    var l7r: f64 = l7.re;
    assert(same(l7r, _bj_from_bits(0x407CCDD1460B1380)) == 1, "ln|1e200 + j1e200| = 460.8635921890891 (hisab: ∞)");
    var e8 = BjComplex_new(x160m, 0.0);
    var p8 = e8.powf(-1.0);
    assert(is_c(p8, x160, -0.0) == 1, "(1e-160)⁻¹ = 1e160 (row 15; hisab's cutoff gave 0)");
    var re_zero = BjComplex_new(0.0, 0.0);
    var p9 = re_zero.powf(0.0);
    assert(is_c(p9, 1.0, 0.0) == 1, "0⁰ = 1 (row 15; hisab: 0)");
    var p10 = re_zero.powf(-1.0);
    assert(is_c(p10, _BJ_K_INF, 0.0) == 1, "0⁻¹ = +∞ (row 15)");
    var p11 = re_zero.powf(2.0);
    assert(is_c(p11, 0.0, 0.0) == 1, "0² = 0, as hisab's");
    var e12 = BjComplex_new(x151m, 0.0);
    var p12 = e12.powf(2.0);
    assert(is_c(p12, _bj_from_bits(0x013B6E3D22865633), 0.0) == 1, "(1e-151)² = 9.999999999999998e-303 (hisab: 0)");
    var re_inf = _BJ_K_INF;
    var e13 = BjComplex_new(re_inf, x200);
    var p13 = e13 * e2;
    var p13i: f64 = p13.im;
    assert(p13i == re_inf, "a non-finite part keeps hisab's chain");

    test_group("cyrius_transcendental_edges (ADR 0002 row 16)");
    # The chain's transcendental operations with an unbounded exponent too (src/crmath_ux.cyr); the expected bits are
    # scripts/oracle/validate.py's model (MPFR at 53 bits with its widest exponent range).
    var t1074: f64 = _bj_from_bits(1);                          # 2^-1074
    var dmax: f64 = _bj_from_bits(0x7FEFFFFFFFFFFFFF);          # DBL_MAX
    var x5 = BjComplex_new(710.0, 0.0);
    var y5 = x5.exp();
    assert(is_c(y5, _BJ_K_INF, 0.0) == 1, "e^710·(1, 0): im +0 (hisab: ∞·0 = NaN)");
    var x6 = BjComplex_new(1000.0, t1074);
    var y6 = x6.exp();
    assert(is_c(y6, _BJ_K_INF, _bj_from_bits(0x56F9E72379AED73B)) == 1,
      "e^1000·sin 2^-1074 = 9.733444573000164e110 (hisab: ∞)");
    var x7 = BjComplex_new(-740.0, _bj_from_bits(0x400921FB54442D18));
    var y7 = x7.exp();
    assert(is_c(y7, _bj_from_bits(0x8000000000000055), 0.0) == 1, "e^-740·cos π on the subnormal grid, rounded once");
    var x8 = BjComplex_new(0.0, 800.0);
    var y8 = x8.sin();
    assert(is_c(y8, 0.0, _BJ_K_INF) == 1, "sin(j800) = (0, ∞) (hisab: 0·∞ = NaN)");
    var x9 = BjComplex_new(-0.0, 100000.0);
    var y9 = x9.sin();
    assert(is_c(y9, -0.0, _BJ_K_INF) == 1, "sin(−0 + j1e5) = (−0, ∞): past 1500 the stand-in keeps the zero's sign");
    var x10 = BjComplex_new(_bj_from_bits(0x3FF921FB54442D18), 720.0);
    var y10 = x10.cos();
    assert(is_c(y10, _bj_from_bits(0x7D6D7C59A708141D), -_BJ_K_INF) == 1,
      "cos(π/2 + j720): cos(π/2)·cosh 720 = 1.5065301609522464e296 (hisab: ∞)");
    var x11 = BjComplex_new(dmax, dmax);
    var y11 = x11.ln();
    var y11r: f64 = y11.re;
    assert(same(y11r, _bj_from_bits(0x40863108C75A1936)) == 1, "ln|DBL_MAX·(1 + j)| = 710.1292864836639 (hisab: ∞)");
    var x12 = BjComplex_new(t1074, t1074);
    var y12 = x12.ln();
    var y12r: f64 = y12.re;
    assert(same(y12r, _bj_from_bits(0xC08740BF7C0D927C)) == 1, "ln|2^-1074·(1 + j)| = −744.0934983311013 (hisab: −∞)");
    var x13 = BjComplex_new(dmax, 1.0);
    var y13 = x13.sqrt();
    assert(is_c(y13, _bj_from_bits(0x5FEFFFFFFFFFFFFF), _bj_from_bits(0x1FE0000000000000)) == 1,
      "√(DBL_MAX + j): im 2^-513, the angle arg/2 below 2^-1022 kept to 53 bits");
    var x14 = BjComplex_new(_bj_from_bits(0x6974E718D7D7625A), 0.0);
    var y14 = x14.powf(2.0);
    assert(is_c(y14, _BJ_K_INF, 0.0) == 1, "(1e200)²: (∞, +0) (hisab: ∞·0 = NaN)");
    var a3: f64 = 68718952449.0 * _bj_from_bits(0x6BB0000000000000);   # (2^18 − 1)²·2^700
    var x15 = BjComplex_new(a3, _bj_from_bits(0x0170000000000000));       # im 2^-1000
    var y15 = x15.powf(1.5);
    assert(is_c(y15, _BJ_K_INF, _bj_from_bits(0x1877FFFA00000001)) == 1,
      "|z|^1.5 = (2^18 − 1)³·2^1050, a 53-bit midpoint, broken to even exactly");
    var x16 = BjComplex_new(-1.0, 0.0);
    var y16 = x16.powf(_bj_from_bits(0x7FE1CCF385EBC8A0));               # 1e308
    assert(is_c(y16, _bj_from_bits(0xBFE2586F820417F1), _bj_from_bits(0xBFEA381AF18E8762)) == 1,
      "(−1)^1e308: n·π past DBL_MAX, its cosine and sine (hisab: NaN)");
    var x17 = BjComplex_new(3.0 * t1074, 4.0 * t1074);
    var y17 = x17.powf(0.5);
    assert(is_c(y17, _bj_from_bits(0x1E70000000000000), _bj_from_bits(0x1E60000000000000)) == 1,
      "(2^-1074·(3 + j4))^0.5 = 2^-536 + j2^-537");

    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
