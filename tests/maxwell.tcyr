# maxwell.tcyr — src/maxwell.cyr (M1 part 3d): the divergences, the displacement current, wave speed, refractive
# index, impedance, wavelength and frequency, skin depth.
#
# Every group named test_* is rust-old/src/maxwell.rs's test of that name, ported assertion for assertion (the ledger
# matches them by name): all 18. tests/golden/maxwell.tsv pins every function over its grid against Rust besides.

include "tests/lib.cyr"

# |a − b| < tol.
fn near(a: f64, b: f64, tol: f64): i64 {
    var d: f64 = a - b;
    var ad: f64 = f64_abs(d);
    if (ad < tol) { return 1; }
    return 0;
}

# |a − b|/|b| < tol.
fn rel_near(a: f64, b: f64, tol: f64): i64 {
    var d: f64 = a - b;
    var ad: f64 = f64_abs(d);
    var ab: f64 = f64_abs(b);
    var r: f64 = ad / ab;
    if (r < tol) { return 1; }
    return 0;
}

# 1 when the C strings a and b are equal.
fn text_is(a, b): i64 {
    var n = strlen(a);
    if (n != strlen(b)) { return 0; }
    return memeq(a, b, n);
}

# The f64 with bit pattern b.
fn fb(b): f64 {
    var x: f64 = 0.0;
    store64(&x, b);
    return x;
}

# 1 when the Ok Result (t, v) holds the f64 with bit pattern b.
fn ok_bits(t, v, b): i64 {
    if (is_ok(t) != 1) { return 0; }
    if (v != b) { return 0; }
    return 1;
}

# Runs maxwell.rs's tests, then the Cyrius-only checks.
fn main() {
    alloc_init();
    var e10: f64 = 0.0000000001;
    var zero: f64 = 0.0;
    var nan: f64 = zero / zero;
    var c0: f64 = BJ_SPEED_OF_LIGHT;

    test_group("test_gauss_electric");
    var div: f64 = bj_gauss_electric_divergence(0.000001);
    assert(div > 10000.0, "1 µC/m³ gives ∇·E > 1e4");

    test_group("test_gauss_magnetic");
    var gm: f64 = bj_gauss_magnetic_divergence();
    assert(gm == 0.0, "∇·B = 0");

    test_group("test_wave_speed_vacuum");
    var t1, v1 = bj_wave_speed(BJ_EPSILON_0, BJ_MU_0);
    assert(is_ok(t1) == 1, "ok");
    var w1: f64 = v1;
    assert(rel_near(w1, c0, 0.000001) == 1, "1/√(ε₀μ₀) = c");

    test_group("test_refractive_index_vacuum");
    var t2, v2 = bj_refractive_index(1.0, 1.0);
    assert(is_ok(t2) == 1, "ok");
    var n2: f64 = v2;
    assert(near(n2, 1.0, e10) == 1, "n = 1");

    test_group("test_refractive_index_glass");
    var t3, v3 = bj_refractive_index(2.25, 1.0);
    assert(is_ok(t3) == 1, "ok");
    var n3: f64 = v3;
    assert(near(n3, 1.5, e10) == 1, "ε_r 2.25 gives n 1.5");

    test_group("test_refractive_index_negative_permittivity");
    var t4, v4 = bj_refractive_index(-1.0, 1.0);
    assert(is_err_result(t4) == 1, "ε_r < 0 refused");

    test_group("test_wavelength_zero_velocity");
    var t5, v5 = bj_wavelength(500000000000000.0, 0.0);
    assert(is_err_result(t5) == 1, "v = 0 refused");

    test_group("test_frequency_zero_velocity");
    var t6, v6 = bj_frequency(0.00000053, 0.0);
    assert(is_err_result(t6) == 1, "v = 0 refused");

    test_group("test_free_space_impedance");
    var z0: f64 = bj_free_space_impedance();
    assert(near(z0, 376.73, 0.1) == 1, "η₀ ≈ 376.73 Ω");

    test_group("test_wavelength_visible_light");
    var t7, v7 = bj_wavelength(566000000000000.0, c0);
    assert(is_ok(t7) == 1, "ok");
    var l7: f64 = v7;
    var nm7: f64 = l7 * 1000000000.0;
    assert(near(nm7, 530.0, 1.0) == 1, "5.66e14 Hz is about 530 nm");

    test_group("test_frequency_from_wavelength");
    var t8, v8 = bj_frequency(0.00000053, c0);
    assert(is_ok(t8) == 1, "ok");
    var f8: f64 = v8;
    assert(rel_near(f8, 566000000000000.0, 0.01) == 1, "530 nm is about 5.66e14 Hz");

    test_group("test_skin_depth");
    var w60: f64 = 2.0 * _BJ_PI * 60.0;
    var t9, v9 = bj_skin_depth(w60, BJ_MU_0, 59600000.0);
    assert(is_ok(t9) == 1, "ok");
    var d9: f64 = v9;
    var mm9: f64 = d9 * 1000.0;
    assert(near(mm9, 8.5, 1.0) == 1, "copper at 60 Hz: about 8.5 mm");

    test_group("test_displacement_current");
    var de_dt = BjFieldVector_new(1000000.0, 0.0, 0.0);
    var jd = bj_displacement_current(de_dt);
    var jx: f64 = jd.x;
    var want_jx: f64 = BJ_EPSILON_0 * 1000000.0;
    assert(near(jx, want_jx, e10) == 1, "J_d = ε₀ ∂E/∂t");

    test_group("test_invalid_permittivity");
    var t10, v10 = bj_wave_speed(-1.0, BJ_MU_0);
    assert(is_err_result(t10) == 1, "ε < 0 refused");

    test_group("test_invalid_permeability");
    var t11, v11 = bj_impedance(BJ_EPSILON_0, -1.0);
    assert(is_err_result(t11) == 1, "μ < 0 refused");

    test_group("test_skin_depth_rejects_paired_negatives");
    var mmu: f64 = -BJ_MU_0;
    var t12, v12 = bj_skin_depth(-1.0, mmu, 59600000.0);
    assert(is_err_result(t12) == 1, "ω < 0 and μ < 0");
    var t13, v13 = bj_skin_depth(-1.0, BJ_MU_0, -59600000.0);
    assert(is_err_result(t13) == 1, "ω < 0 and σ < 0");
    var t14, v14 = bj_skin_depth(1.0, mmu, -59600000.0);
    assert(is_err_result(t14) == 1, "μ < 0 and σ < 0");
    var t15, v15 = bj_skin_depth(nan, BJ_MU_0, 59600000.0);
    assert(is_err_result(t15) == 1, "ω NaN");

    test_group("test_skin_depth_copper_reference");
    var w1m: f64 = 2.0 * _BJ_PI * 1000000.0;
    var t16, v16 = bj_skin_depth(w1m, BJ_MU_0, 59600000.0);
    assert(is_ok(t16) == 1, "ok");
    var d16: f64 = v16;
    var ref16: f64 = 0.00006519240483;
    var a16: f64 = f64_abs(d16 - ref16);
    var r16: f64 = a16 / d16;
    assert(r16 < 0.000000001, "copper at 1 MHz: 6.519240483e-5 m");

    test_group("test_nan_material_parameters_rejected");
    var t17, v17 = bj_wave_speed(nan, BJ_MU_0);
    assert(is_err_result(t17) == 1, "ε NaN");
    var t18, v18 = bj_wave_speed(BJ_EPSILON_0, nan);
    assert(is_err_result(t18) == 1, "μ NaN");
    var t19, v19 = bj_impedance(nan, BJ_MU_0);
    assert(is_err_result(t19) == 1, "impedance, ε NaN");
    var t20, v20 = bj_refractive_index(nan, 1.0);
    assert(is_err_result(t20) == 1, "refractive index, ε_r NaN");
    var t21, v21 = bj_wavelength(nan, c0);
    assert(is_err_result(t21) == 1, "wavelength, f NaN");
    var t22, v22 = bj_frequency(0.00000053, nan);
    assert(is_err_result(t22) == 1, "frequency, v NaN");

    # ── Cyrius-only: the error each check records (the golden rows pin every text over the grid) ──
    test_group("cyrius_round_once (ADR 0002 row 13)");
    # Each root is correctly rounded: Rust's 1/√(ε·μ) is 3.6·10¹⁰ ulp off at 1e-160 and 0 at 1e160, its products and
    # quotients overflow at 1e200, its skin depth underflows; the expected bits are Python's exact rounding.
    var e160m: f64 = fb(0x1EB67E9C127B6E74);
    var e160: f64 = fb(0x6126C2D4256FFCC3);
    var e200: f64 = fb(0x6974E718D7D7625A);
    var e200m: f64 = fb(0x16687E92154EF7AC);
    var tw1, vw1 = bj_wave_speed(e160m, e160m);
    assert(ok_bits(tw1, vw1, 0x6126C2D4256FFCC3) == 1, "1/√(1e-160·1e-160) = 1e160 (Rust: 1.0000055664551363e160)");
    var tw2, vw2 = bj_wave_speed(e160, e160);
    assert(ok_bits(tw2, vw2, 0x1EB67E9C127B6E74) == 1, "1/√(1e160·1e160) = 1e-160 (Rust: 0)");
    var tw3, vw3 = bj_wave_speed(BJ_EPSILON_0, BJ_MU_0);
    assert(ok_bits(tw3, vw3, 0x41B1DE784A00006D) == 1, "c from ε₀ and μ₀: 299792458.0000065");
    var inf: f64 = 1.0 / 0.0;
    var tw4, vw4 = bj_wave_speed(inf, 2.0);
    assert(ok_bits(tw4, vw4, 0) == 1, "an infinite ε keeps Rust's 1/√∞ = 0");
    var tn1, vn1 = bj_refractive_index(e200, e200);
    assert(ok_bits(tn1, vn1, 0x6974E718D7D7625A) == 1, "√(1e200·1e200) = 1e200 (Rust: ∞)");
    var ti1, vi1 = bj_impedance(e200m, e200);
    assert(ok_bits(ti1, vi1, 0x6974E718D7D7625A) == 1, "√(1e200/1e-200) = 1e200 (Rust: ∞)");
    var ti2, vi2 = bj_impedance(inf, inf);
    var ni2: f64 = vi2;
    assert(is_ok(ti2) == 1 && ni2 != ni2, "both infinite keep Rust's √(∞/∞) = NaN");
    var ts1, vs1 = bj_skin_depth(e200, e200, e200);
    assert(ok_bits(ts1, vs1, 0x01AE4E8D12762226) == 1, "√(2/1e600) = 1.4142135623730952e-300 (Rust: 0)");
    var ts2, vs2 = bj_skin_depth(1.0, inf, 1.0);
    assert(ok_bits(ts2, vs2, 0) == 1, "an infinite μ keeps Rust's √(2/∞) = 0");

    test_group("cyrius_maxwell_error_records");
    var t23, v23 = bj_wave_speed(BJ_EPSILON_0, -2.0);
    assert(is_err_result(t23) == 1 && v23 == BJ_ERR_INVALID_PERMEABILITY, "μ refused as InvalidPermeability");
    var mu23: f64 = bj_last_error_value();
    assert(mu23 == -2.0, "the record holds the value");
    assert(text_is(bj_last_error_display(), "invalid permeability: -2 (must be > 0)") == 1, "its Display");
    var t24, v24 = bj_skin_depth(1.0, BJ_MU_0, 0.0);
    assert(is_err_result(t24) == 1 && v24 == BJ_ERR_INVALID_PARAMETER, "σ = 0 refused");
    assert(text_is(bj_last_error_display(),
        "invalid parameter: conductivity must be positive for skin depth, got 0") == 1, "names σ");
    var t25, v25 = bj_frequency(nan, 1.0);
    assert(text_is(bj_last_error_display(), "invalid parameter: wavelength must be positive, got NaN") == 1,
      "names λ");

    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
